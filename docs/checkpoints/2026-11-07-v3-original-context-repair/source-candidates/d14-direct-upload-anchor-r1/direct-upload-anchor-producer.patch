+def attachment_display_metadata(event, presentations):
+    """Carry direct native upload proof separately from legacy presentation."""
+    if presentations is None:
+        return {}
+    display = {ATTACHMENT_PRESENTATIONS_KEY: presentations}
+    if (event is None or getattr(event, "internal", True)
+            or getattr(event, "_ingress_merged", True)):
+        return display
+
+    from hermes_cli.friday_user_scope import ScopeDenied, _same_scope, ordinary_file_scope
+    try:
+        cap = ordinary_file_scope()
+    except ScopeDenied:
+        return display
+    source = getattr(event, "source", None)
+    owned = getattr(event, "_friday_owned_attachment_paths", None)
+    message_id = getattr(event, "message_id", None)
+    receipts = getattr(event, "_telegram_media_receipts", None)
+    if (cap is None or cap.principal[0] != "telegram"
+            or not _same_scope(getattr(source, "_friday_user_scope", None), cap)
+            or not isinstance(owned, tuple) or len(owned) != 2
+            or not _same_scope(owned[0], cap) or not isinstance(owned[1], frozenset)
+            or not isinstance(message_id, str) or re.fullmatch(r"[1-9][0-9]{0,31}", message_id) is None
+            or message_id != getattr(source, "message_id", None)
+            or not isinstance(receipts, dict)):
+        return display
+
+    files = _metadata_files(presentations, cap)
+    if not files or files != presentations["files"]:
+        return display
+    direct = []
+    for record in files:
+        absolute = str(cap.home / "workspace" / record["path"])
+        receipt = receipts.get(absolute)
+        if absolute not in owned[1] or not isinstance(receipt, dict):
+            return display
+        origin, presentation = receipt.get("origin"), receipt.get("presentation")
+        if (not isinstance(origin, dict) or origin.get("bot_id") != cap.principal[2]
+                or origin.get("chat_id") != source.chat_id or not isinstance(presentation, dict)
+                or _file_record(record["path"], receipt.get("content"),
+                                presentation.get("original_filename")) != record):
+            return display
+        if origin.get("message_id") == message_id:
+            direct.append(record)
+
+    if len(direct) == 1:
+        display[DIRECT_UPLOAD_KEY] = {
+            "schema": "friday.ordinary-direct-upload.v1",
+            "scope": _scope(cap),
+            "source_message_id": message_id,
+            "file": direct[0],
+        }
+    return display
 
 
