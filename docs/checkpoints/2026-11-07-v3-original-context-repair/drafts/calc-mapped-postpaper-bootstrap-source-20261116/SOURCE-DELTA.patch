+    def install_after_paper(self):
+        """Prove the exact getter at the existing CLOSED paper dispatch stop.
+
+        The original Root release already exists in this LOAD_OPEN window.
+        This is an observer breakpoint, outside all GDB callbacks; it neither
+        executes the getter nor supplies an initialization/continuation grant.
+        Global symbol lookup and debug-symbol availability are irrelevant here.
+        """
+        need(self.n['STATE']['error'] is None and not self.installed
+             and not self.init_active and not self.finished_initialization
+             and self.c is None and self.g.selected_inferior().num == 1,
