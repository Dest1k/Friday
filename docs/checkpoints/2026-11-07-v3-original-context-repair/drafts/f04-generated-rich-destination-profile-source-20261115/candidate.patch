+        identity.set('val', '__AXIS_%s__' % index)
+        cross.set('val', '__AXIS_%s__' % (1-index))
+        ref.set('val', '__AXIS_%s__' % index)
+    ytitle = _title(_one(axes[1], CH, 'title'))
+    if _digest(root) != _CHART_SCAFFOLD:
+        _fail('scaffold_unsupported')
+    return title, ytitle, category, ((label, values),), checks
+
+
+def _drawing(root):
+    r = _rich()
+    root = deepcopy(root)
+    if len(root) != 1 or root[0].tag != q(XDR, 'twoCellAnchor'):
+        _fail('anchor_unsupported')
+    node = root[0]
+    markers = []
+    for name in ('from', 'to'):
+        marker = _one(node, XDR, name)
+        values = tuple(_uint(_plain(_one(marker, XDR, n)), 0, high)
+                       for n, high in (('col', r.MAX_COLS-1),
+                                       ('colOff', 360000000),
+                                       ('row', r.MAX_ROWS-1),
+                                       ('rowOff', 360000000)))
+        markers.append(values)
+    gf = _one(node, XDR, 'graphicFrame')
+    nv = _one(gf, XDR, 'nvGraphicFramePr')
+    pr = _one(nv, XDR, 'cNvPr')
+    if set(pr.attrib) != {'id', 'name'} or len(pr):
+        _fail('frame_identity')
+    _uint(pr.get('id'), 1)
+    name = pr.get('name')
+    if not name or len(name) > 128 or any(ord(c) < 32 for c in name):
+        _fail('frame_identity')
+    xf = _one(gf, XDR, 'xfrm')
+    off, ext = _one(xf, A, 'off'), _one(xf, A, 'ext')
+    if (set(off.attrib) != {'x', 'y'} or len(off) or
+            set(ext.attrib) != {'cx', 'cy'} or len(ext)):
+        _fail('transform_unsupported')
+    offset = tuple(_uint(off.get(n), 0, 360000000) for n in ('x', 'y'))
+    size = tuple(_uint(ext.get(n), 1, 360000000) for n in ('cx', 'cy'))
+    geometry = (node.get('editAs'), markers[0], markers[1], offset, size)
+    if geometry != _GEOMETRY:
+        _fail('geometry_unsupported')
+    graphic = _one(gf, A, 'graphic')
+    gd = _one(graphic, A, 'graphicData')
+    link = _one(gd, CH, 'chart')
+    if set(link.attrib) != {q(R, 'id')} or len(link) or not link.get(q(R, 'id')):
+        _fail('chart_linkage')
+    rid = link.get(q(R, 'id'))
+    if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_.-]{0,127}', rid):
+        _fail('chart_linkage')
+    # All removed identity/link fields were captured and independently checked.
+    pr.set('id', '__FRAME_ID__')
+    pr.set('name', '__FRAME_NAME__')
+    link.set(q(R, 'id'), '__CHART_REL__')
+    if _digest(root) != _DRAWING_SCAFFOLD:
+        _fail('drawing_scaffold_unsupported')
+    return rid, (markers[0][2]+1, markers[0][0]+1), size, geometry
+
+
+def _relpart(owner):
+    folder, _, leaf = owner.rpartition('/')
+    return (folder+'/' if folder else '') + '_rels/' + leaf + '.rels'
+
+
+def _relationships(book, owner):
+    part = _relpart(owner)
+    root = book.xml.get(part)
+    if (root is None or root.tag != q(PKG, 'Relationships') or root.attrib or
+            (root.text or '').strip() or (root.tail or '').strip()):
+        _fail('relationship_structure')
+    _original_xml(book.parts[part])
+    for rel in root:
+        if (rel.tag != q(PKG, 'Relationship') or
+                set(rel.attrib) != {'Id', 'Type', 'Target'} or len(rel) or
+                (rel.text or '').strip() or (rel.tail or '').strip()):
+            _fail('relationship_structure')
+    return book.relationships.get(owner, {})
+
+
+def _type(book, part, expected):
+    root = book.xml['[Content_Types].xml']
+    found = [n for n in root if n.tag == q(CT, 'Override') and
+             n.get('PartName') == '/'+part]
+    if (len(found) != 1 or found[0].attrib != {
+            'PartName': '/'+part, 'ContentType': expected} or len(found[0]) or
+            (found[0].text or '').strip() or (found[0].tail or '').strip()):
+        _fail('content_type')
+
+
+def _hidden_rows(book, sheet, supplied):
+    r = _rich()
+    names = _one(book.xml['xl/workbook.xml'], S, 'sheets')
+    matches = [n for n in names if n.get('name') == sheet]
+    if len(matches) != 1:
+        _fail('sheet_identity')
+    part = book.target('xl/workbook.xml', matches[0].get(q(R, 'id')), 'worksheet')
+    # prepare_xlsx may already have captured/removed hidden and cols attributes.
+    # Read these unchanged, previously package-validated original bytes instead.
+    root = ET.fromstring(book.parts[part])
+    formats = root.findall(q(S, 'sheetFormatPr'))
+    if len(formats) != 1 or r.boolean(formats[0].get('zeroHeight')):
+        _fail('hidden_default_rows')
+    if any(r.boolean(col.get('hidden')) for col in root.iter(q(S, 'col'))):
+        _fail('hidden_columns')
+    actual = set()
+    seen = set()
+    for row in _one(root, S, 'sheetData'):
+        if row.tag != q(S, 'row'):
+            _fail('row_structure')
+        index = _uint(row.get('r'), 1, r.MAX_ROWS)
+        if index in seen:
+            _fail('row_identity')
+        seen.add(index)
+        if r.boolean(row.get('hidden')):
+            actual.add(index)
+    declared = set()
+    for item in supplied:
+        if isinstance(item, tuple) and len(item) == 2:
+            scope, index = item
+            if not isinstance(scope, str) or type(index) is not int or not 1 <= index <= r.MAX_ROWS:
+                _fail('hidden_rows_unsupported')
+            if scope == sheet:
+                declared.add(index)
+        elif type(item) is int and 1 <= item <= r.MAX_ROWS:
+            declared.add(item)
+        else:
+            _fail('hidden_rows_unsupported')
+    if declared != actual:
+        _fail('hidden_rows_mismatch')
+    return part, actual
+
+
+def generated_drawing(book, part, sheet, checks, hidden_rows):
+    """Return chart, chartpart, EMU size, owned parts/edges, raw geometry.
+
+    ``checks`` receives per-coordinate caches only after complete success.
+    ``hidden_rows`` contains row integers or (sheet-name, row) pairs captured
+    from original worksheets. The caller must run validate_references against
+    the actual independent scalar inventory and compare the full source-bound
+    rich signature. No whole-workbook acceptance is asserted by this helper.
+    """
+    r = _rich()
+    if book.external or book.unsupported or book.macro_parts:
+        _fail('active_or_external')
+    sheetpart, hidden = _hidden_rows(book, sheet, hidden_rows)
+    rid, anchor, emu, geometry = _drawing(book.root(part, q(XDR, 'wsDr')))
+    drawing_rows = _relationships(book, part)
+    if set(drawing_rows) != {rid} or drawing_rows[rid][0] != R+'/chart':
+        _fail('drawing_graph')
+    chartpart = book.target(part, rid, 'chart')
+    chart_rows = _relationships(book, chartpart)
+    if len(chart_rows) != 2:
+        _fail('chart_graph')
+    by_kind = {}
+    for chart_rid, (kind, target) in chart_rows.items():
+        if kind not in (STYLE_REL, COLOR_REL) or kind in by_kind or target is None:
+            _fail('chart_graph')
+        by_kind[kind] = (chart_rid, target)
+    if set(by_kind) != {STYLE_REL, COLOR_REL}:
+        _fail('chart_graph')
+    stylepart, colorpart = by_kind[STYLE_REL][1], by_kind[COLOR_REL][1]
+    core = {part, chartpart, stylepart, colorpart}
+    if len(core) != 4:
+        _fail('shared_or_cyclic_graph')
+    for target, mime in ((part, r.DRAWING_MIME), (chartpart, r.CHART_MIME),
+                         (stylepart, STYLE_MIME), (colorpart, COLOR_MIME)):
+        _type(book, target, mime)
+        _original_xml(book.parts[target])
+    for auxiliary in (stylepart, colorpart):
+        if book.relationships.get(auxiliary) or _relpart(auxiliary) in book.parts:
+            _fail('auxiliary_graph')
+    if (_digest(book.root(stylepart, q(CS, 'chartStyle'))) != _STYLE_SCAFFOLD or
+            _digest(book.root(colorpart, q(CS, 'colorStyle'))) != _COLOR_SCAFFOLD):
+        _fail('auxiliary_scaffold_unsupported')
+    incoming = [(owner, key, kind, target)
+                for owner, rows in book.relationships.items()
+                for key, (kind, target) in rows.items() if target == part]
+    if len(incoming) != 1 or incoming[0][0] != sheetpart or incoming[0][2] != R+'/drawing':
+        _fail('drawing_owner')
+    sheetlink = incoming[0]
+    # Validate the exact consumed worksheet relation, including attributes that
+    # the broad package loader does not interpret.
+    relroot = book.xml.get(_relpart(sheetpart))
+    links = [] if relroot is None else [n for n in relroot if n.get('Id') == sheetlink[1]]
+    if (len(links) != 1 or links[0].tag != q(PKG, 'Relationship') or
+            set(links[0].attrib) != {'Id', 'Type', 'Target'} or len(links[0]) or
+            (links[0].text or '').strip()):
+        _fail('drawing_owner')
+    edges = {sheetlink, (part, rid, R+'/chart', chartpart)}
+    edges.update((chartpart, key, kind, target) for key, (kind, target) in chart_rows.items())
+    owned = core | {_relpart(part), _relpart(chartpart)}
+    for owner, rows in book.relationships.items():
+        for key, (kind, target) in rows.items():
+            edge = owner, key, kind, target
+            if (owner in owned or target in owned) and edge not in edges:
+                _fail('shared_or_cyclic_graph')
+    title, ytitle, category, series, pending = _chart(
+        book.root(chartpart, q(CH, 'chartSpace')), sheet, hidden)
+    size = tuple((Decimal(value)/360000).quantize(Decimal('.001')) for value in emu)
+    chart = ('column', title, ytitle, 'right', True, category, series, anchor, size)
+    checks.extend(pending)
+    return chart, chartpart, emu, owned, edges, geometry
