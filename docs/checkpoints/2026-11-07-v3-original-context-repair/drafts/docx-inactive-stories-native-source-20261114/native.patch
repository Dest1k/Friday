+    @staticmethod
+    def _inactive_story_signature(root):
+        # These newly accepted parts must not hide unsupported attributes behind
+        # the paragraph model, which intentionally omits visual formatting.
+        # Property subtrees still pass the shared property verifier. Retain their
+        # entire structure/attributes in the duplicate signature, even though
+        # formatting fidelity is otherwise outside the conversion contract.
+        for node in root.iter():
+            if node.tag in {q(W, n) for n in ('p', 'r', 'pPr', 'rPr')} and node.attrib:
+                _fail('unsupported_word_story')
+            if node.tag == q(W, 'proofErr') and set(node.attrib) != {q(W, 'type')}:
+                _fail('unsupported_word_story')
+            # The new redundant-copy profile is deliberately narrower than
+            # active stories: only simple w:val visual-property attributes.
+            # Do not inherit the visual verifier's permissive attribute policy
+            # for parts omitted from the returned inventory, even if identical.
+            if (node is not root and node.tag not in {q(W, n) for n in ('t', 'br', 'proofErr')}
+                    and set(node.attrib) - {q(W, 'val')}):
+                _fail('unsupported_word_story')
+
+        def signature(node):
+            # XML prefix/attribute order and structural indentation are inert;
+            # native text, run/paragraph boundaries and all properties are not.
+            return (node.tag, tuple(sorted(node.attrib.items())),
+                    (node.text or '') if node.tag == q(W, 't') else '',
+                    tuple(signature(child) for child in node))
+        return signature(root)
+
+    @staticmethod
+    def _empty_inactive_even(root, kind):
+        # The generated blank even-page part has one plain empty paragraph.
+        # Admit only its passive role-style skeleton, not an arbitrary empty
+        # model carrying distinct properties, fields or hidden structure.
+        if len(root) != 1 or root[0].tag != q(W, 'p') or root[0].attrib:
+            return False
+        paragraph = root[0]
+        properties = paragraph.find(q(W, 'pPr'))
+        for child in paragraph:
+            if child is properties:
+                if child.attrib:
+                    return False
+                for prop in child:
+                    if len(prop):
+                        return False
+                    if prop.tag == q(W, 'pStyle'):
+                        if prop.attrib != {q(W, 'val'): {'header': 'Header', 'footer': 'Footer'}[kind]}:
+                            return False
+                    elif prop.tag == q(W, 'bidi'):
+                        if set(prop.attrib) != {q(W, 'val')} or prop.get(q(W, 'val')) not in ('0', 'false', 'off'):
+                            return False
+                    elif prop.tag == q(W, 'jc'):
+                        if prop.attrib != {q(W, 'val'): 'left'}:
+                            return False
+                    elif prop.tag != q(W, 'rPr') or prop.attrib:
+                        return False
+            elif child.tag != q(W, 'r') or child.attrib or any(
+                    part.tag != q(W, 'rPr') or part.attrib or len(part) for part in child):
+                return False
+        return sum(child.tag == q(W, 'r') for child in paragraph) <= 1
