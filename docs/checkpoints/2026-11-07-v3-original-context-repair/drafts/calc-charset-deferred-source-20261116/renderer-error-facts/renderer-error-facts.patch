+            if type(facts[key]) is not str or facts[key] != expected:
+                return None
+        returncode = facts['returncode']
+        if returncode is not None and (type(returncode) is not int
+                or not -(1 << 31) <= returncode < (1 << 31) or returncode == 0):
+            return None
+        digest = facts['argv_shape_sha256']
+        if digest is not None and (type(digest) is not str or len(digest) != 64
+                or any(char not in '0123456789abcdef' for char in digest)):
+            return None
+        return {key: facts[key] for key in keys}
+    except Exception:
+        # Optional diagnostic data must never replace the original failure.
+        return None
