+def _renderer_failure_facts(argv, returncode):
+    # Correlation of bounded SUPPLIED argv lengths only: neither argv contents,
+    # unique invocation/actual exec/custody proof, nor a completion/permission receipt.
+    correlation = None
+    if type(argv) in (list, tuple) and 0 < len(argv) <= 256:
+        if all(type(part) is str and len(part) <= 4096 for part in argv):
+            lengths = [len(part) for part in argv]
+            if sum(lengths) <= 32768:
+                metadata = json.dumps(lengths, separators=(',', ':')).encode('ascii')
+                correlation = hashlib.sha256(b'supplied-argv-lengths-v1:' + metadata).hexdigest()
+    return {'exception_class': 'ExportRefused', 'phase': 'child_exit',
+            'place': 'friday_workspace_pdf._run',
+            'returncode': returncode if (type(returncode) is int
+                and -(1 << 31) <= returncode < (1 << 31) and returncode != 0) else None,
+            'argv_shape_sha256': correlation}
+
