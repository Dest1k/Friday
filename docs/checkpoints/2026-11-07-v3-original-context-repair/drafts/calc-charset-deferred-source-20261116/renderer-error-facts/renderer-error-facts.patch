+        facts = error.__dict__.get('_friday_renderer_error_facts')
+        keys = ('exception_class', 'phase', 'place', 'returncode', 'argv_shape_sha256')
+        if (type(facts) is not dict or len(facts) != len(keys)
+                or any(type(key) is not str for key in facts) or set(facts) != set(keys)):
+            return None
+        for key, expected in (('exception_class', 'ExportRefused'), ('phase', 'child_exit'),
