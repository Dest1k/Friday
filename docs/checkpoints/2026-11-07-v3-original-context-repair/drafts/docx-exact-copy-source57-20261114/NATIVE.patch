+def create_copy(cap, fd, leaf, path, content):
+    """Copy an inert, hash-bound DOCX snapshot verbatim into a new owned name.
+
+    Package validation grants no rendering or edit fidelity claim. No XML,
+    extracted text or ZIP member is rewritten; the existing publisher verifies
+    both the source identity and the exact destination bytes around publication.
+    """
+    from hermes_cli.friday_user_scope import current, workspace_document
+    from tools.scoped_word_profiles import _Package, WordProfileError
+    check(cap)
+    _check_parent(cap, fd, path)
+    if (current(required=True) is not cap or Path(path).name != leaf
+            or Path(path).suffix.lower() != '.docx'
+            or type(content) is not str or len(content) > 8192
+            or len(content.encode('utf-8')) > 8192):
+        raise ScopeDenied()
+    def pairs(items):
+        value = {}
+        for key, item in items:
+            if key in value: raise ScopeDenied()
+            value[key] = item
+        return value
+    try:
+        spec = json.loads(content, object_pairs_hook=pairs)
+        if type(spec) is not dict or set(spec) != {'source', 'source_sha256'}:
+            raise ScopeDenied()
+        raw, expected = spec['source'], spec['source_sha256']
+        if (type(raw) is not str or not 1 <= len(raw) <= 4096 or '\x00' in raw
+                or type(expected) is not str or re.fullmatch('[0-9a-f]{64}', expected) is None):
+            raise ScopeDenied()
+        root = cap.home / 'workspace'
+        source = Path(raw)
+        if not source.is_absolute(): source = root / source
+        relative = source.relative_to(root)
+        if (not relative.parts or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+                or source.suffix.lower() != '.docx' or relative.as_posix() == path):
+            raise ScopeDenied()
+        data, _, identity = workspace_document(str(source), with_identity=True)
+        digest = hashlib.sha256(data).hexdigest()
+        if digest != expected:
+            return json.dumps({'success': False, 'error': 'document_copy_refused',
+                               'reason': 'source_hash_mismatch', 'effect_disposition': 'none'})
+        package = _Package(data, 'docx', lambda: check(cap))
+        if package.active or package.macro:
+            raise WordProfileError('active_content_unsupported')
+        def verify():
+            check(cap)
+            actual, _, version = workspace_document(str(source), with_identity=True)
+            if actual != data or version != identity: raise ScopeDenied()
+        result = json.loads(_create_bytes(cap, fd, leaf, path, data, verify_source=verify))
+        if result.get('success'):
+            result.update(source=relative.as_posix(), source_sha256=digest,
+                          source_unchanged=True, copy_mode='byte_exact', byte_identical=True)
+        return json.dumps(result)
+    except WordProfileError as error:
+        return json.dumps({'success': False, 'error': 'document_copy_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
+    except (ValueError, TypeError, RecursionError):
+        raise ScopeDenied() from None
