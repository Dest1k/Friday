+    return {
+        "schema": "frw.calc.runtime-font-recipe.observation.v1",
+        "source_commit": SOURCE_COMMIT, "version": VERSION,
+        "source_nominal_font": nominal,
+        "recipe": {"Name": export_name, "Height": 220, "Family": 5,
