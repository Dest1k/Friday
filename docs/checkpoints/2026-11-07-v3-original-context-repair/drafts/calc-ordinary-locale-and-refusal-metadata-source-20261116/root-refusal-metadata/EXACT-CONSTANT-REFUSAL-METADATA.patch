+def failure_record(exc, phase, modules):
+    """Keep generic API refusal; add only a trusted constant resolver code.
+
+    Never serialize arbitrary exception messages, configuration/font values,
+    traceback text or an exception class that merely shares a trusted name.
+    This is observational metadata only; every error remains REFUSED/Mnull.
+    """
+    record = dict(exception_class=type(exc).__name__, phase=phase,
+                  reason=str(exc) if isinstance(exc, Refused) else 'API_OR_QUALIFIER_REFUSAL')
+    resolver = modules.get('resolver') if type(modules) is dict else None
+    trusted_class = resolver.get('FontResolutionRefused') if type(resolver) is dict else None
+    if type(trusted_class) is type and type(exc) is trusted_class:
+        code = getattr(exc, 'code', None)
+        record['qualified_refusal'] = dict(
+            source='PINNED_RUNTIME_FONT_RESOLVER',
+            code=code if type(code) is str and code in FONT_REFUSAL_CODES
+                 else 'UNRECOGNIZED_PINNED_REFUSAL_CODE')
+    return record
 
 
