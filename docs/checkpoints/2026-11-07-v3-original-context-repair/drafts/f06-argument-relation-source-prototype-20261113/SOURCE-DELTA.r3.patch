+"""Opt-in, enum-only argument relations for one correlated direct read call.
+
+No activation from model arguments, environment, config, logs or natural language.
+The trusted caller supplies a protected sink and optionally an explicit structured
+reference. Default operation is inert. This observer never authorizes a tool.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from threading import RLock
+
+PHASES = ("MODEL_OUTPUT", "RELAY_RETURN", "REQUEST_RETURN", "EXECUTION_RETURN",
+          "PRE_TOOL_RETURN", "DISPATCH_ENTRY", "FILE_ADAPTER", "FILE_SCALAR", "OOXML_CODEC")
+_KEYS = ("task_id", "session_id", "tool_call_id", "turn_id", "api_request_id")
+_MISSING = object()
+_armed = ContextVar("friday_argument_relation_armed", default=None)
+_active = ContextVar("friday_argument_relation_active", default=None)
+
+
+def _identity(value):
+    if type(value) is not dict or set(value) != set(_KEYS):
+        return None
+    fields = tuple(value[k] for k in _KEYS)
+    if any(type(x) is not str or len(x) > 256 for x in fields):
+        return None
+    if not fields[1] or not fields[2]:
+        return None
+    return fields
+
+
+def _kind(value):
+    if value is _MISSING:
+        return "ABSENT"
+    if value is None:
+        return "NULL"
+    if type(value) is str:
+        return "STRING" if value else "EMPTY_STRING"
+    return "OTHER"
+
+
+def _relation(left, right):
+    if type(left) is not str or type(right) is not str:
+        return "NOT_COMPARABLE"
+    return "EQUAL" if left == right else "DIFFERENT"
+
+
+class _Arm:
+    __slots__ = ("identity", "reference", "sink", "used", "lock", "delivery", "closed", "call")
+
+    def __init__(self, identity, reference, sink):
+        self.identity, self.reference, self.sink = identity, reference, sink
+        self.used, self.lock, self.delivery, self.closed = False, RLock(), "NOT_OBSERVED", False
+        self.call = None
+
+    def __repr__(self):
+        return "<argument-relation authorization>"
+
+
+class _Call:
+    __slots__ = ("arm", "baseline", "rows", "last", "valid", "closed", "lock")
+
+    def __init__(self, arm):
+        self.arm, self.baseline, self.rows = arm, _MISSING, {}
+        self.last, self.valid, self.closed, self.lock = -1, True, False, RLock()
+
+    def __repr__(self):
+        return "<argument-relation observation>"
+
+    def mark(self, phase, value):
+        with self.arm.lock, self.lock:
+            if self.closed or self.arm.closed or phase not in PHASES:
+                return
+            index = PHASES.index(phase)
+            if index != self.last + 1:
+                self.valid = False
+            if phase in self.rows:
+                return
+            self.last = index
+            if phase == "MODEL_OUTPUT":
+                # Retain only an exact immutable built-in string, never arguments.
+                self.baseline = value if type(value) is str else _MISSING
+            reference = self.arm.reference
+            self.rows[phase] = {
+                "phase": phase, "observed": "OBSERVED", "type": _kind(value),
+                "model_relation": _relation(self.baseline, value),
+                "reference_relation": ("NO_REFERENCE" if reference is _MISSING
+                                       else _relation(reference, value)),
+            }
+
+    def expire(self):
+        with self.arm.lock, self.lock:
+            self.closed = True
+            self.baseline, self.rows = _MISSING, {}
+            self.arm.call = None
+            self.arm.delivery = "AUTHORITY_EXPIRED"
+
+    def close(self):
+        with self.arm.lock, self.lock:
+            if self.closed:
+                return
+            self.closed = True
+            rows = [self.rows.get(p, {"phase": p, "observed": "NOT_OBSERVED",
+                     "type": "UNKNOWN", "model_relation": "UNKNOWN",
+                     "reference_relation": "UNKNOWN"}) for p in PHASES]
+            report = {"schema": "ARGUMENT_RELATION_V1",
+                      "baseline": "MODEL_JSON_DIRECT_READ_FILE",
+                      "reference": ("NOT_SUPPLIED" if self.arm.reference is _MISSING
+                                    else "EXPLICIT_STRUCTURED_REFERENCE"),
+                      "phase_order": "VALID" if self.valid else "INVALID",
+                      "coverage": "COMPLETE" if self.valid and len(self.rows) == len(PHASES)
+                                  else "PARTIAL", "phases": rows}
+            if not self.valid:
+                for row in rows:
+                    row["model_relation"] = row["reference_relation"] = "UNKNOWN"
+            self.baseline = _MISSING
+            self.rows = {}
+            # Copies of context share this capsule; late workers cannot update it.
+            self.arm.reference = _MISSING
+            self.arm.call = None
+            sink, self.arm.sink = self.arm.sink, None
+        if sink is not None:
+            try:
+                sink(report)  # Protected correlation belongs to the trusted sink.
+                self.arm.delivery = "DELIVERED"
+            except Exception:
+                # Never log/format an observer exception or change tool semantics.
+                self.arm.delivery = "SINK_FAILED"
+
+
+@contextmanager
+def diagnostic_scope(correlation, sink, *, structured_reference=_MISSING):
+    """Trusted, one-call activation. Not a public tool or automatic request parser.
+
+    The sink MUST already belong to the protected correlation supplied here.
+    This scope does not persist anything itself. Strings are released, not wiped.
+    """
+    identity = _identity(correlation)
+    if identity is None or not callable(sink):
+        raise ValueError("argument_relation_authority_invalid")
+    if structured_reference is not _MISSING and type(structured_reference) is not str:
+        raise ValueError("argument_relation_reference_invalid")
+    arm = _Arm(identity, structured_reference, sink)
+    token = _armed.set(arm)
+    try:
+        yield arm
+    finally:
+        _armed.reset(token)
+        with arm.lock:
+            arm.closed = True
+            if arm.call is not None:
+                arm.call.expire()
+            arm.reference, arm.sink = _MISSING, None
+
+
+@contextmanager
+def call_scope(correlation, raw_name):
+    arm, call = _armed.get(), None
+    if arm is not None and type(raw_name) is str and raw_name == "read_file":
+        with arm.lock:
+            if not arm.closed and not arm.used and _identity(correlation) == arm.identity:
+                arm.used = True
+                call = _Call(arm)
+                arm.call = call
+    # Every nested/foreign/unsupported caller masks a parent observation.
+    token = _active.set(call)
+    try:
+        yield
+    finally:
+        _active.reset(token)
+        if call is not None:
+            call.close()
+
+
+def observe_args(phase, args):
+    call = _active.get()
+    if call is not None:
+        call.mark(phase, args.get("password", _MISSING) if type(args) is dict else _MISSING)
+
+
+def observe_scalar(phase, password):
+    call = _active.get()
+    if call is not None:
+        call.mark(phase, password)
+
+
+def observe_dispatch(name, args, correlation):
+    call = _active.get()
+    if call is not None:
+        with call.lock:
+            if (type(name) is not str or name != "read_file"
+                    or _identity(correlation) != call.arm.identity):
+                call.valid = False
+                return
+        observe_args("DISPATCH_ENTRY", args)
