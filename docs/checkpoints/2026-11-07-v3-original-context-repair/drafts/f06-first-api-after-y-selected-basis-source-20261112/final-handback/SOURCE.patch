+              and recovery['Qwen'] == 'OWNER_REPORT_LOADING_NO_LIVE_INFERENCE_ADMISSION'
+              and delta['Qwen'] == 'OWNER_REPORT_LOADING_NO_INFERENCE_ADMISSION',
+              'ROOT_REPEAT_NOT_ADMISSION_QWEN_LOADING')
