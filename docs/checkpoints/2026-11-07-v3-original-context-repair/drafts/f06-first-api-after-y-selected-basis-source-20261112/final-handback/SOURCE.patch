+        'all3_full_database_metadata_unchanged': strict['all3_full_database_metadata_unchanged'],
+        'new_proof_must_always_contain_actual_new_observed': True,
+        'CFB_and_unrelated_checks_must_remain_in_root_caller': True,
+    }
