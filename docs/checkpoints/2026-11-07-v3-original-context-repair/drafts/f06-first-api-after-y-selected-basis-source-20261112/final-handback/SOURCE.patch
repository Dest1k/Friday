+    _need(type(boundary) is dict and type(boundary.get('B')) is dict, 'BOUNDARY_SHAPE')
+    _need(_same(boundary.get('gateway'), gateway), 'ACTUAL_BOUNDARY_GATEWAY_BINDING')
+    for key in ('session_id', 'session_key'):
