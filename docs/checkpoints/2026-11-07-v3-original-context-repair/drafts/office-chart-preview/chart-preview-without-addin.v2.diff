+// A running chart with its own data can render its preview without updating links.
+// Keep disabled active content, linked objects and unloaded objects excluded.
+static bool CanRenderRunningInternalChart(
+    const uno::Reference<embed::XEmbeddedObject>& xObj)
+{
+    if (officecfg::Office::Common::Security::Scripting::DisableActiveContent::get())
+        return false;
+
+    try
+    {
+        if (!xObj.is()
+            || xObj->getClassID() != MimeConfigurationHelper::GetSequenceClassID(SO3_SCH_CLASSID)
+            || xObj->getCurrentState() != embed::EmbedStates::RUNNING)
+            return false;
+
+        const uno::Reference<embed::XLinkageSupport> xLink(xObj, uno::UNO_QUERY);
+        if (!xLink.is() || xLink->isLink())
+            return false;
+
+        const uno::Reference<chart2::XChartDocument> xChart(xObj->getComponent(), uno::UNO_QUERY);
+        if (!xChart.is() || !xChart->hasInternalDataProvider())
+            return false;
+
+        // ChartView may refresh an AddIn while rendering even when link updates
+        // are forbidden. Only a known empty AddIn is eligible for this exception.
+        const uno::Reference<beans::XPropertySet> xProps(xObj->getComponent(), uno::UNO_QUERY);
+        if (!xProps.is())
+            return false;
+        const uno::Reference<beans::XPropertySetInfo> xInfo = xProps->getPropertySetInfo();
+        if (!xInfo.is() || !xInfo->hasPropertyByName(u"AddIn"_ustr))
+            return false;
+        const uno::Any aAddIn = xProps->getPropertyValue(u"AddIn"_ustr);
+        uno::Reference<util::XRefreshable> xAddIn;
+        if (aAddIn.hasValue() && !(aAddIn >>= xAddIn))
+            return false;
+        return !xAddIn.is();
+    }
+    catch (const uno::Exception&)
+    {
+        return false;
+    }
+}
