+def uid_projection_diagnostic(value):
+    """Sanitized optional diagnostic; never runtime authority or a new verdict."""
+    flags = {'raw_is_bytes', 'overflow_is_int', 'witness_is_dict', 'namespace_is_dict',
+        'cross_view_raw_digest_equal', 'host_digest_matches_pin', 'self_map_matches_baseline',
+        'inside_domains_equal', 'namespace_matches', 'overflow_matches'}
+    digests = {'self_map_sha256', 'actual_host_map_sha256', 'root_host_map_sha256', 'self_baseline_sha256'}
+    numbers = {'self_map_bytes': 32768, 'self_map_rows': 340, 'host_map_rows': 340,
+               'actual_overflowuid': 2 ** 32 - 1, 'expected_overflowuid': 2 ** 32 - 1}
+    namespaces = {'current_userns', 'collector_userns', 'host_userns'}
+    need(type(value) is dict and set(value) == flags | digests | set(numbers) | namespaces |
+         {'schema', 'phase', 'exception_class', 'post_read_cas'}, 'ownc_uid_diagnostic_schema')
+    need(value['schema'] == 'frw.calc.uid-projection-refusal-metadata.v1'
+         and value['phase'] == 'UID_PROJECTION' and type(value['exception_class']) is str
+         and re.fullmatch('[A-Za-z_][A-Za-z0-9_]{0,63}', value['exception_class']),
+         'ownc_uid_diagnostic_version_or_class')
+    def sha(v):
+        return v is None or (type(v) is str and re.fullmatch('[0-9a-f]{64}', v))
+    def number(v, maximum):
+        return v is None or (type(v) is int and 0 <= v <= maximum)
+    def namespace(v):
+        return type(v) is dict and set(v) == {'dev', 'ino'} and all(
+            x is None or (type(x) is int and 0 < x < 2 ** 64) for x in v.values())
+    need(all(type(value[k]) is bool for k in flags) and all(sha(value[k]) for k in digests)
+         and all(number(value[k], maximum) for k, maximum in numbers.items())
+         and all(namespace(value[k]) for k in namespaces), 'ownc_uid_diagnostic_types')
+    post = value['post_read_cas']
+    if post is not None:
+        need(type(post) is dict and set(post) == {'self_map_sha256', 'current_userns', 'overflow_sha256',
+            'self_map_equal', 'overflow_equal', 'namespace_equal'}
+            and sha(post['self_map_sha256']) and sha(post['overflow_sha256'])
+            and namespace(post['current_userns'])
+            and all(type(post[k]) is bool for k in ('self_map_equal', 'overflow_equal', 'namespace_equal')),
+            'ownc_uid_diagnostic_post_cas')
+    return value
 
 
