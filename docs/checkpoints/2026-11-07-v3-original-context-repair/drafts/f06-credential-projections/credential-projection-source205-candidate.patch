+def redact_protected_file_tool_calls_for_persistence(tool_calls: Any) -> Any:
+    """Copy durable tool calls, removing only recognized file-tool credential fields.
+
+    Execution arguments, user/document text, tool results and call IDs are untouched.
+    Known file calls with malformed arguments/options keep their envelope but mask
+    that unparseable credential-bearing field; no raw invalid JSON is logged. This
+    is not a promise to erase passwords intentionally supplied in user chat.
+    """
+    if not isinstance(tool_calls, list):
+        return tool_calls
+    import copy
+    result = copy.deepcopy(tool_calls)
+
+    def pairs(items):
+        parsed = {}
+        for key, value in items:
+            if key in parsed:
+                raise ValueError("duplicate protected-file argument key")
+            parsed[key] = value
+        return parsed
+
+    def parsed_object(value):
+        parsed = json.loads(value, object_pairs_hook=pairs) if isinstance(value, str) else value
+        if not isinstance(parsed, dict):
+            raise ValueError("protected-file arguments must be an object")
+        return parsed
+
+    for call in result:
+        if not isinstance(call, dict):
+            continue
+        function = call.get("function")
+        if not isinstance(function, dict) or function.get("name") not in ("read_file", "write_file"):
+            continue
+        raw = function.get("arguments")
+        try:
+            args = parsed_object(raw)
+        except (ValueError, TypeError, RecursionError):
+            function["arguments"] = json.dumps({"_protected_file_arguments": "[redacted invalid arguments]"})
+            continue
+        changed = False
+        if function["name"] == "read_file":
+            for key in args:
+                if isinstance(key, str) and key.casefold() == "password" and args[key] is not None:
+                    args[key] = "[redacted]"
+                    changed = True
+        elif isinstance(args.get("format"), str) and args["format"].strip().lower() in _PROTECTED_FILE_PASSWORD_FORMATS:
+            content = args.get("content")
+            try:
+                options = parsed_object(content)
+            except (ValueError, TypeError, RecursionError):
+                args["content"] = "[redacted invalid protected options]"
+                changed = True
+            else:
+                options_changed = False
+                for key in options:
+                    if isinstance(key, str) and key.casefold() == "password" and options[key] is not None:
+                        options[key] = "[redacted]"
+                        options_changed = True
+                if options_changed:
+                    args["content"] = json.dumps(options, ensure_ascii=False) if isinstance(content, str) else options
+                    changed = True
+        if changed:
+            function["arguments"] = json.dumps(args, ensure_ascii=False) if isinstance(raw, str) else args
+    return result
