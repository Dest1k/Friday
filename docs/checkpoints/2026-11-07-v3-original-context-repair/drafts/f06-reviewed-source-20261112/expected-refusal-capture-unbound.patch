+def ordinary_f06_wrong_read_factual_capture(plan, run, message):
+    """Keep one exact admitted negative as facts, never grant rights or PASS.
+
+    Caller continuation_receipt and verify_capture_context authenticate admission,
+    source, once lineage and outbound custody before this predicate is reached.
+    The canonical whole-plan digest also pins request/input/scenario/current tuple
+    and original clock. Correct-read/edit and wrong-edit need separate admissions;
+    this fresh-upload, text-only exception grants none of them.
+    """
+    binding = F06_WRONG_READ_PLAN_SHA256
+    if (not isinstance(binding, str) or re.fullmatch('[a-f0-9]{64}', binding) is None
+            or not isinstance(plan, dict) or not isinstance(run, dict)
+            or not isinstance(message, dict)):
+        return False
+    try:
+        if digest(encoded(plan)) != binding:
+            return False
+    except (TypeError, ValueError, OverflowError):
+        return False
+    spec, scenario = plan.get('new_task'), plan.get('new_scenario')
+    if (not isinstance(spec, dict) or spec.get('kind') != 'ordinary-document-task'
+            or set(spec) != {'kind', 'nonce', 'request', 'source_reference', 'output'}
+            or spec['output'] is not None or spec['source_reference'] is not None
+            or not isinstance(spec['request'], str) or not spec['request'].strip()
+            or not isinstance(scenario, dict) or run.get('scenario') != scenario
+            or run.get('id') != plan.get('new_run_id')
+            or type(run.get('step')) is not int or run['step'] != 0):
+        return False
+    steps = scenario.get('steps')
+    if (not isinstance(steps, list) or len(steps) != 1
+            or not isinstance(steps[0], dict) or set(steps[0]) != {'input', 'observe'}):
+        return False
+    step = steps[0]; upload, expected = step['input'], step['observe']
+    if (not isinstance(upload, dict) or upload.get('kind') != 'document'
+            or upload.get('caption') != spec['request']
+            or not reply_capture(expected) or expected.get('window_seconds') != 180
+            or type(expected.get('max_documents')) is not int or expected['max_documents'] != 0):
+        return False
+    try:
+        validate_document_input(upload)
+        validate_reply_capture(expected)
+    except Refused:
+        return False
+    chat, sender, replied = (message.get(key) for key in ('chat', 'from', 'reply_to_message'))
+    text = message.get('text')
+    return (all(isinstance(value, dict) for value in (chat, sender, replied))
+            and type(chat.get('id')) is int and chat['id'] == PEER and chat.get('type') == 'private'
