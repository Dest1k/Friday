+            and type(run.get('sent_message_id')) is int and run['sent_message_id'] > 0
+            and type(replied.get('message_id')) is int and replied['message_id'] == run['sent_message_id']
+            and message.get('message_thread_id') is None and 'document' not in message
+            and isinstance(text, str) and bool(text.strip())
+            and explicit_task_refusal(text))
 
 
