+"""Bounded string-leaf JSON copies; only the selected token is serialized."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+import re
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check, _baseline
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _archive_spec, _path, _source, _verify, _inline_budget, _fits, _encode
+
+MAX_BYTES = 1000000
+MAX_DEPTH = 32
+MAX_NODES = 32768
+_NUMBER = re.compile(r'-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?')
+
+GUIDANCE = (
+    'For one explicitly requested string-value correction in an existing UTF-8 JSON, '
+    'use format=json_string_edit into a NEW .json path; keep the original. '
+    'Content is JSON exactly {source,source_sha256,pointer,expected,value}; '
+    'source_sha256 comes from a current complete read_file, including every partial page. '
+    'pointer is a nonempty RFC6901 JSON Pointer (for example /date_display or /rows/0/date; '
+    '~0 means ~ and ~1 means /); expected and value are explicit decoded strings. '
+    'The selected existing string must equal expected. Only that string token is rewritten; '
+    'all other source bytes, escapes, key order, number spelling, BOM and line endings remain. '
+    'Strict JSON only: duplicate keys, missing selections, unchanged edits, nonstring targets, '
+    'key/structure edits and root replacement refuse. Maximum 1MB input/output, depth32, '
+    '32768 values and 4096 UTF-8 pointer bytes. Numbers, booleans and null are preserved '
+    'but cannot be selected for editing. Never reconstruct the complete JSON from displayed text. '
+)
+
+
+class JsonEditRefused(ValueError):
+    """Fixed reason codes only; no source content or parser diagnostics."""
+
+
+def _pointer(pointer):
+    if type(pointer) is not str or not pointer.startswith('/'):
+        raise JsonEditRefused('pointer_required')
+    try:
+        if len(pointer.encode('utf-8')) > 4096:
+            raise JsonEditRefused('pointer_capacity')
+    except UnicodeError:
+        raise JsonEditRefused('pointer_invalid') from None
+    pieces = pointer[1:].split('/')
+    if len(pieces) > MAX_DEPTH or any(re.search(r'~(?![01])', part) for part in pieces):
+        raise JsonEditRefused('pointer_invalid')
+    return tuple(part.replace('~1', '/').replace('~0', '~') for part in pieces)
+
+
+def _string_span(text, selected):
+    """Validate the entire bounded JSON and locate one decoded string value.
+
+    No objects/numbers are reserialized. Array positions use canonical decimal
+    indexes; object keys are exact decoded strings, including escaped keys.
+    """
+    position = 1 if text.startswith('\ufeff') else 0
+    nodes = 0
+    target = None
+
+    def space():
+        nonlocal position
+        while position < len(text) and text[position] in ' \t\r\n':
+            position += 1
+
+    def string():
+        nonlocal position
+        start = position
+        if position >= len(text) or text[position] != '"':
+            raise JsonEditRefused('json_invalid')
+        try:
+            value, position = json.decoder.scanstring(text, position + 1, True)
+            value.encode('utf-8')  # Refuse unpaired surrogate escapes everywhere.
+        except (ValueError, UnicodeError):
+            raise JsonEditRefused('json_invalid') from None
+        return value, start, position
+
+    def value(path, depth):
+        nonlocal position, nodes, target
+        nodes += 1
+        if depth > MAX_DEPTH or nodes > MAX_NODES:
+            raise JsonEditRefused('json_capacity')
+        space()
+        if position >= len(text):
+            raise JsonEditRefused('json_invalid')
+        start = position
+        token = text[position]
+        if token == '"':
+            decoded, start, end = string()
+            if path == selected:
+                target = (start, end, decoded)
+            return
+        if path == selected:
+            raise JsonEditRefused('target_not_string')
+        if token == '{':
+            position += 1
+            space()
+            keys = set()
+            if position < len(text) and text[position] == '}':
+                position += 1
+                return
+            while True:
+                key, _, _ = string()
+                if key in keys:
+                    raise JsonEditRefused('duplicate_key')
+                keys.add(key)
+                space()
+                if position >= len(text) or text[position] != ':':
+                    raise JsonEditRefused('json_invalid')
+                position += 1
+                value(path + (key,), depth + 1)
+                space()
+                if position < len(text) and text[position] == '}':
+                    position += 1
+                    return
+                if position >= len(text) or text[position] != ',':
+                    raise JsonEditRefused('json_invalid')
+                position += 1
+                space()
+        elif token == '[':
+            position += 1
+            space()
+            if position < len(text) and text[position] == ']':
+                position += 1
+                return
+            index = 0
+            while True:
+                value(path + (str(index),), depth + 1)
+                index += 1
+                space()
+                if position < len(text) and text[position] == ']':
+                    position += 1
+                    return
+                if position >= len(text) or text[position] != ',':
+                    raise JsonEditRefused('json_invalid')
+                position += 1
+        else:
+            for literal in ('true', 'false', 'null'):
+                if text.startswith(literal, position):
+                    position += len(literal)
+                    return
+            number = _NUMBER.match(text, position)
+            if number is None:
+                raise JsonEditRefused('json_invalid')
+            position = number.end()
+
+    value((), 0)
+    space()
+    if position != len(text):
+        raise JsonEditRefused('json_invalid')
+    if target is None:
+        raise JsonEditRefused('pointer_not_found')
+    return target
+
+
+def replace_string(original, expected_sha256, pointer, expected, value):
+    """Replace one existing string token, retaining every unselected byte."""
+    if (type(original) is not bytes or len(original) > MAX_BYTES
+            or type(expected_sha256) is not str
+            or re.fullmatch(r'[0-9a-f]{64}', expected_sha256) is None):
+        raise JsonEditRefused('source_identity_required')
+    if hashlib.sha256(original).hexdigest() != expected_sha256:
+        raise JsonEditRefused('source_hash_mismatch')
+    selected = _pointer(pointer)
+    if type(expected) is not str or type(value) is not str:
+        raise JsonEditRefused('string_values_required')
+    if expected == value:
+        raise JsonEditRefused('edit_is_unchanged')
+    try:
+        text = original.decode('utf-8')
+        expected.encode('utf-8')
+        replacement = json.dumps(value, ensure_ascii=False).encode('utf-8')
+    except UnicodeError:
+        raise JsonEditRefused('utf8_required') from None
+    start, end, actual = _string_span(text, selected)
+    if actual != expected:
+        raise JsonEditRefused('expected_mismatch')
+    before = text[:start].encode('utf-8')
+    after = text[end:].encode('utf-8')
+    result = before + replacement + after
+    if len(result) > MAX_BYTES:
+        raise JsonEditRefused('output_capacity')
+    return result
+
+
+def create_edit(cap, fd, leaf, relative, content, *, task_id='default'):
+    """Current full-read source, retained custody/CAS, existing atomic publisher."""
+    _check_parent(cap, fd, relative)
+    relative = _path(relative)
+    if PurePosixPath(relative).suffix.lower() != '.json' or leaf != PurePosixPath(relative).name:
+        raise ScopeDenied()
+    spec = _archive_spec(content, {'source', 'source_sha256', 'pointer', 'expected', 'value'})
+    source = _path(spec['source'])
+    if PurePosixPath(source).suffix != PurePosixPath(relative).suffix or source == relative:
+        raise ScopeDenied()
+    check(cap)
+    original, identity = _source(cap, source)
+    # Exactly the version recorded by native read_file delivery, not a caller
+    # supplied hash alone. workspace_document identity includes trailing gid.
+    version = (*identity[:8], hashlib.sha256(original).digest())
+    if _baseline(cap, task_id, source) != version:
+        return _encode(dict(success=False, error='json_edit_requires_current_full_read',
+                            effect_disposition='none', hint='Read the complete current source with read_file and continue every partial page.'))
+    try:
+        data = replace_string(original, spec['source_sha256'], spec['pointer'], spec['expected'], spec['value'])
+    except JsonEditRefused as error:
+        return _encode(dict(success=False, error='json_edit_refused', reason=str(error),
+                            effect_disposition='none'))
+    sources = [(source, original, identity)]
+    receipt = dict(operation='json_string_edit', source=source,
+                   source_sha256=hashlib.sha256(original).hexdigest(), source_unchanged=True,
+                   unselected_bytes_preserved=True, replacements=1)
+    estimate = dict(receipt, success=True, path=relative, format='json',
+                    scope='own_user_workspace', create_only=True, verified=True,
+                    bytes_written=len(data), sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate, _inline_budget()):
+        return _encode(dict(success=False, error='json_edit_result_capacity', effect_disposition='none'))
+    _verify(cap, sources)
+    result = json.loads(_create_bytes(cap, fd, leaf, relative, data, output_format='json',
+                                    verify_source=lambda: _verify(cap, sources)))
+    if result.get('success'):
+        result.update(receipt)
+    return _encode(result)
