--- /dev/null
+++ b/patches/hermes/r02-telegram-text-uncertain-recovery-after-source210.patch
@@ -0,0 +1,611 @@
+diff --git a/gateway/delivery_ledger.py b/gateway/delivery_ledger.py
+index 5633890ac935..e23e14be70e9 100644
+--- a/gateway/delivery_ledger.py
++++ b/gateway/delivery_ledger.py
+@@ -1,18 +1,22 @@
+-"""Durable delivery-obligation ledger for gateway final responses (rows in the shared ``state.db``;
+-WAL, owner pid + process-start liveness, bounded retention) so a crash between finalize and
+-platform ACK cannot lose a response silently. Checkpoints: record_obligation() 'pending' before
+-any send | mark_attempting() 'attempting' right before the await | mark_delivered() 'delivered'
+-only on SendResult.success | mark_failed() 'failed' on a definitive rejection. Crash semantics
+-(never silently resend an ambiguous send): pending = never started, redeliver plainly; attempting
+-= crashed mid-await, platform MAY have it, redeliver WITH a visible recovered marker; failed =
+-rejected once, restart is a retry boundary, also marked; delivered = prune. Attempts are capped
+-and stale rows expire, both -> 'abandoned' (kept briefly, then pruned). Everything is
+-best-effort: ledger failures must never block a send; callers wrap every call in try/except.
++"""Durable final-response delivery obligations in the shared state.db.
++
++Ordinary Telegram text: pending was never attempted; attempting/legacy failed
++without zero-effect proof becomes explicit uncertain and MUST NOT automatically
++send again. A parsed positive ACK followed by durable delivered finalization is
++terminal. failed_unsent preserves a bounded retry for a proven wholly unsent
++payload. No remote receipt lookup or exactly-once guarantee is implied.
++
++Other channels retain their existing marked at-least-once recovery policy.
++Telegram uncertainty is not evicted or silently expired; ownership/profile and
++attempt guards remain in force. Ordinary Telegram recording fails closed; other
++callers keep their historical best-effort ledger behavior.
+ """
+ 
+ from __future__ import annotations
+ 
+ import hashlib
++from contextlib import contextmanager
++from contextvars import ContextVar
+ import logging
+ import os
+ import re
+@@ -27,6 +31,49 @@
+ 
+ logger = logging.getLogger(__name__)
+ _DB_LOCK = threading.Lock()
++
++# Only the ordinary Telegram final/recovery caller enters this lexical scope.
++# ContextVar keeps concurrent channels and sends independent; no global activation.
++_TELEGRAM_TEXT_SEND = ContextVar("ordinary_telegram_text_send", default=False)
++
++
++@contextmanager
++def telegram_text_send_scope(enabled: bool):
++    token = _TELEGRAM_TEXT_SEND.set(enabled)
++    try:
++        yield
++    finally:
++        _TELEGRAM_TEXT_SEND.reset(token)
++
++
++def telegram_text_send_fenced() -> bool:
++    return _TELEGRAM_TEXT_SEND.get()
++
++
++def telegram_text_no_effect(result: Any) -> bool:
++    raw = getattr(result, "raw_response", None)
++    return (not getattr(result, "success", False) and isinstance(raw, dict)
++            and raw.get("telegram_text_no_effect") is True and not raw.get("partial_overflow"))
++
++
++def delivery_acknowledged(platform: str, result: Any) -> bool:
++    if not getattr(result, "success", False):
++        return False
++    if platform != "telegram":
++        return True
++    # A success flag without a parsed positive Telegram message ID is not an ACK.
++    def positive(value):
++        return not isinstance(value, bool) and str(value).isascii() and str(value).isdigit() and int(value) > 0
++    if not positive(getattr(result, "message_id", None)):
++        return False
++    raw = getattr(result, "raw_response", None)
++    if isinstance(raw, dict):
++        if raw.get("partial_overflow"):
++            return False
++        ids = raw.get("message_ids")
++        if ids is not None and (not isinstance(ids, list) or not ids or not all(positive(v) for v in ids)):
++            return False
++    return True
+ 
+ # Redelivery policy knobs (deliberately not config — the ledger is gated by
+ # ``gateway.delivery_ledger`` and these only matter in the rare recovery path).
+@@ -268,12 +315,12 @@
+ 
+ 
+ def record_obligation(*, obligation_id: str, session_key: str, platform: str, chat_id: str,
+-                      thread_id: Optional[str], content: str, adapter_profile: Optional[str] = None) -> None:
+-    """Record a final response as owed to the platform (state='pending')."""
++                      thread_id: Optional[str], content: str, adapter_profile: Optional[str] = None) -> bool:
++    """Record a final response. Telegram never replaces a prior delivery fence."""
+     now, (pid, started) = time.time(), _owner_stamp()
