{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "assignment",
    "native567_authorized",
    "manifest_sha256",
    "intent",
    "automatic_retry",
    "old_grant_reused_as_authority",
    "issued_unix",
    "expires_unix"
  ],
  "properties": {
    "schema": {
      "const": "friday.f06.unstarted567-root-grant.v1"
    },
    "assignment": {
      "const": "ASTRA-CHILD-F06-UNSTARTED-ODF-NATIVE-SCOPE-20261112#1"
    },
    "native567_authorized": {
      "const": true
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent": {
      "$ref": "BINDING.schema.json"
    },
    "automatic_retry": {
      "const": false
    },
    "old_grant_reused_as_authority": {
      "const": false
    },
    "issued_unix": {
      "type": "number"
    },
    "expires_unix": {
      "type": "number"
    }
  },
  "additionalProperties": false,
  "$comment": "Consumer additionally requires issued<=now<=expires and 0<expires-issued<=300, current CPU set membership and all source/ref/identity CAS."
}
