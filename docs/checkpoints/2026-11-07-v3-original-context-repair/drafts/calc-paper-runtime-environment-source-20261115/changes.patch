+        regions = []
+        for line in self.bounded(Path('/proc') / str(pid) / 'maps', 512 * 1024).decode('ascii').splitlines():
+            f = line.split(None, 5)
+            start, end = (int(v, 16) for v in f[0].split('-'))
+            regions.append((start, end, f[1], f[5] if len(f) == 6 else ''))
