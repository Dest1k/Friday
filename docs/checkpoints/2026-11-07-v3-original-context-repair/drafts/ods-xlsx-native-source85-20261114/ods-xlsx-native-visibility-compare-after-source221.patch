+def _a4_physical_paper(paper,orientation):
+    # This is exactly the pre-existing forward native A4 recognition boundary,
+    # after _cm's Decimal .001cm quantization. Reuse it in the reverse direction
+    # without widening the bound or claiming raw physical page equivalence.
+    if not isinstance(paper,tuple) or len(paper)!=2 or paper[0]!='physical_cm':refuse('print_layout_unsupported')
+    dims=paper[1];expected=(Decimal('29.700'),Decimal('21.000')) if orientation=='landscape' else (Decimal('21.000'),Decimal('29.700'))
+    if (not isinstance(dims,tuple) or len(dims)!=2 or any(not isinstance(v,Decimal) or not v.is_finite() for v in dims)
+            or any(abs(actual-want)>Decimal('.001') for actual,want in zip(dims,expected))):refuse('print_layout_unsupported')
+
