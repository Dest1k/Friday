+def _native_reverse_projection(source,destination):
+    """Compare bounded native ODF state with recognized XLSX representation.
+
+    The ODF-only hidden diagnostic never replaces exact current hidden rows.
+    Column interval partitions may differ only at exactly equal per-column
+    Decimal widths; this establishes no physical width mapping or tolerance.
+    Native physical page dimensions may represent A4 only within the exact
+    existing forward recognition boundary. Orientation and fit remain exact;
+    raw geometry and physical pagination remain explicitly unassessed. Other
+    records and every same-format comparison keep their strict equality.
+    """
+    if (not isinstance(source,RichSignature) or not isinstance(destination,RichSignature)
+            or getattr(source,'source_kind','')!='ods'
+            or getattr(destination,'source_kind','')!='xlsx'
+            or getattr(source,'native_calc_profile',False) is not True
+            or getattr(destination,'native_calc_profile',False) is not False):
+        refuse('native_reverse_visibility_profile_unsupported')
+    names=getattr(source,'sheet_names',())
+    if (not isinstance(names,tuple) or not names or len(names)!=len(set(names))
+            or getattr(destination,'sheet_names',())!=names):
+        refuse('native_reverse_visibility_profile_unsupported')
+    def hidden_rows(signature):
+        hidden=[]
+        for feature,scope,payload in signature:
+            if feature!='hidden_row':continue
+            if scope not in names or type(payload) is not int or not 1<=payload<=MAX_ROWS:
+                refuse('hidden_row_semantics_mismatch')
+            hidden.append((scope,payload))
+        if len(hidden)!=len(set(hidden)):refuse('hidden_row_semantics_mismatch')
+        return set(hidden)
+    source_hidden=hidden_rows(source);target_hidden=hidden_rows(destination)
+    if source_hidden!=target_hidden:refuse('hidden_row_semantics_mismatch')
+    modes=[]
+    for feature,scope,payload in source:
+        if feature!='native_hidden_mode':continue
+        if (not isinstance(payload,tuple) or len(payload)!=2
+                or type(payload[0]) is not int or payload[1] not in ('filter','collapse')
+                or (scope,payload[0]) not in source_hidden):
+            refuse('hidden_row_semantics_mismatch')
+        modes.append((scope,payload[0]))
+    # Missing, duplicate, changed or unbound modes cannot authorize projection.
+    if len(modes)!=len(set(modes)) or set(modes)!=source_hidden:
+        refuse('hidden_row_semantics_mismatch')
+    if any(row[0]=='native_hidden_mode' for row in destination):
+        refuse('hidden_row_semantics_mismatch')
+    def columns(signature):
+        points={}
+        for feature,scope,payload in signature:
+            if feature!='column_width':continue
+            if (scope not in names or not isinstance(payload,tuple) or len(payload)!=3
+                    or type(payload[0]) is not int or type(payload[1]) is not int
+                    or not 1<=payload[0]<=payload[1]<=MAX_COLS
+                    or not isinstance(payload[2],Decimal) or not payload[2].is_finite()
+                    or not Decimal(0)<payload[2]<=Decimal(1000)):
+                refuse('column_unsupported')
+            for column in range(payload[0],payload[1]+1):
+                key=scope,column
+                if key in points:refuse('column_unsupported')
+                points[key]=payload[2]
+        return points
+    source_columns=columns(source);target_columns=columns(destination)
+    if source_columns.keys()!=target_columns.keys():refuse('column_coverage_mismatch')
+    if source_columns!=target_columns:refuse('column_width_semantics_mismatch')
+    losses=[]
+    def print_setups(signature,target=False):
+        setups={}
+        for feature,scope,payload in signature:
+            if feature!='print_setup':continue
+            if (scope not in names or scope in setups or not isinstance(payload,tuple) or len(payload)!=4
+                    or payload[0] not in ('landscape','portrait')
+                    or any(type(v) is not int or not 0<=v<=100 for v in payload[2:])):
+                refuse('print_layout_unsupported')
+            if payload[1]!='A4':
+                if target:refuse('print_layout_unsupported')
+                _a4_physical_paper(payload[1],payload[0])
+                losses.extend(('physical_geometry_quantized_0.001cm','a4_page_dimension_serialization_discrepancy_ods_to_xlsx'))
+            setups[scope]=('print_setup',scope,(payload[0],'A4',payload[2],payload[3]))
+        return setups
+    source_print=print_setups(source);target_print=print_setups(destination,True)
+    if source_print.keys()!=target_print.keys():refuse('print_setup_semantics_mismatch')
+    def projected(signature):
+        rows=[row for row in signature if row[0] not in ('native_hidden_mode','column_width','print_setup')]
+        rows.extend(('column_width',scope,(column,column,width))
+                    for (scope,column),width in source_columns.items())
+        rows.extend((source_print if signature is source else target_print).values())
+        return tuple(sorted(rows,key=repr))
+    unassessed=[]
+    if modes:unassessed.append('hidden_row_provenance_and_filter_clear_behavior_unassessed')
+    if source_columns:unassessed.append('column_width_physical_mapping_unassessed')
+    if source_print:unassessed.append('physical_pagination_unassessed')
+    return projected(source),projected(destination),tuple(dict.fromkeys(losses)),tuple(unassessed)
+
