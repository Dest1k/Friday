{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formula_values": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cell": {
            "enum": [
              "G2",
              "G3",
              "G4",
              "G5",
              "B2"
            ]
          },
          "sheet_index": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "value": {
            "maxLength": 128,
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$",
            "type": "string"
          }
        },
        "required": [
          "sheet_index",
          "cell",
          "value"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "independence_verified": {
      "const": false
    },
    "method": {
      "const": "independent_Decimal_source_literals_fixed_formula_graph"
    },
    "schema": {
      "const": "friday.ods-xlsx.source-literal-oracle.v1"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "method",
    "source_sha256",
    "formula_values",
    "independence_verified"
  ],
  "type": "object"
}
