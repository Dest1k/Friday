{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "direction": {
      "const": "ods_to_xlsx"
    },
    "fidelity_history": {
      "additionalProperties": false,
      "properties": {
        "dimension_history_observations": {
          "const": 19
        },
        "known_cross_format_losses": {
          "const": 4
        },
        "restoration_claimed": {
          "const": false
        },
        "unassessed_features": {
          "const": 4
        }
      },
      "required": [
        "known_cross_format_losses",
        "unassessed_features",
        "dimension_history_observations",
        "restoration_claimed"
      ],
      "type": "object"
    },
    "profile": {
      "const": "selected-original-three-sheet-rich-required-formulas.v1"
    },
    "schema": {
      "const": "friday.ods-xlsx.selected-request.v1"
    },
    "source_numeric_delta": {
      "additionalProperties": false,
      "properties": {
        "authority_value": {
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$",
          "type": "string"
        },
        "cell": {
          "const": "C2"
        },
        "sheet_index": {
          "const": 1
        },
        "source_value": {
          "maxLength": 128,
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?$",
          "type": "string"
        }
      },
      "required": [
        "sheet_index",
        "cell",
        "authority_value",
        "source_value"
      ],
      "type": "object"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "profile",
    "direction",
    "source_sha256",
    "authority_sha256",
    "source_numeric_delta",
    "fidelity_history"
  ],
  "type": "object"
}
