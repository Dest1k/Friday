+    def _settlement_state(self):
+        adapter = self.adapter
+        runner = adapter.gateway_runner
+        if runner is None or runner.adapters.get(adapter.platform) is not adapter:
+            return "UNKNOWN"
+        wire = self._wire()
+        if wire is None:
+            return "UNKNOWN"
+        if wire["state"] != "LOCAL_WIRE_CLOSED":
+            return None
+        updates = wire["target_update_ids"]
+        if not updates:
+            return "EMPTY"
+        if any(update in self._held for update in updates):
+            return "HELD"
+        if self._admissions is None or any(
+                update not in self._commits or self._built[update].handoff != "returned"
+                or not self._built[update].settled for update in updates):
+            return None
+        key = self.scope["session_key"]
+        if (key in adapter._pending_messages or key in adapter._text_debounce
+                or key in adapter._active_sessions or key in adapter._session_tasks):
+            return None
+        return "SETTLED"
+
+    async def wait_for_settlement(self, deadline):
+        """Wait on native changes within the already authenticated caller's deadline."""
+        cutoff = self.window._cutoff
+        if cutoff is None or type(deadline) not in (int, float) or not 0 <= deadline < 2**63:
+            return "UNKNOWN"
+        deadline = min(deadline, self.claim.expires_monotonic)
+        try:
+            async with asyncio.timeout(max(0, deadline - time.monotonic())):
+                while time.monotonic() < deadline:
+                    # The clear and read run on the owning loop without yielding.
+                    self._changed.clear()
+                    if self.window._cutoff != cutoff:
+                        return "UNKNOWN"
+                    state = self._settlement_state()
+                    if time.monotonic() >= deadline:
+                        break
+                    if state is not None:
+                        return state
+                    await self._changed.wait()
+        except TimeoutError:
+            pass
+        return "EXPIRED"
+
 
