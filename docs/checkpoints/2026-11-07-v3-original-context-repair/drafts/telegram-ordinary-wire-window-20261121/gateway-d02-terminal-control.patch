+        with os.fdopen(fd, "wb") as stream:
+            stream.write(raw)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+    return {"path": str(work / name), "bytes": len(raw), "sha256": sha256(raw).hexdigest()}
