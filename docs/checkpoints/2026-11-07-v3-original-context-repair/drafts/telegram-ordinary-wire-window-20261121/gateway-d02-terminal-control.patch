+def _write_private(work, name, value, identity):
+    raw = _encode(value)
+    require(len(raw) <= _RUN_JSON_LIMIT, "d02_control_terminal_receipt_too_large")
+    directory = os.open(work, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
