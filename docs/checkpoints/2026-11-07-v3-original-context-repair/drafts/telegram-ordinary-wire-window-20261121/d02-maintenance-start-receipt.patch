+                observer.remaining(stop)
+                return raw
+
+            io = SimpleNamespace(checked_read=read_checked, decode=actor.parse)
+            code_sha, _roles, receiver, overlay = current.installed_roles(io, H, binding, projection)
+            require(receiver, 'd02_owner_observation_needs_installed_receiver')
+            return dict(code_sha=code_sha, receipt_sha256=EXPECTED['receipt'], overlay_sha256=overlay)
