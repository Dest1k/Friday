+    def _ordinary_dm_wire_native_parameters(self, request, generation, kwargs):
+        """Match the actual current PTB long-poll action, transport, filter and cursor."""
+        url = kwargs.get("url")
+        if type(url) is not str or not url.endswith("/getUpdates") or kwargs.get("method") != "POST":
+            return None
+        parameters = kwargs["request_data"].parameters
+        timeout = parameters.get("timeout")
+        offset = parameters.get("offset")
+        allowed = parameters.get("allowed_updates")
+        updater = self._ordinary_dm_wire_updater(generation)
+        if (updater is None or type(timeout) is not int or not 0 < timeout < 2**63
+                or type(offset) is not int or not 0 <= offset < 2**63
+                or type(allowed) is not list or allowed != Update.ALL_TYPES
+                or updater.bot._request[0] is not request
+                or type(updater._last_update_id) is not int or updater._last_update_id != offset):
+            return None
+        # PTB 22.8 awaits getUpdates in this native child's coroutine. A caller
+        # sharing the request and ContextVar still cannot present that child.
+        coroutine = asyncio.current_task().get_coro()
+        action = getattr(coroutine, "cr_code", None)
+        frame = getattr(coroutine, "cr_frame", None)
+        if (action is not None and action.co_name == "polling_action_cb" and frame is not None
+                and any(action is constant for constant in updater._start_polling.__code__.co_consts)
+                and frame.f_locals.get("self") is updater):
+            return parameters
+        return None
+
+    def _arm_ordinary_dm_wire_window(self, request, generation, kwargs, *, overlapping):
+        """Consume pending once at the native transport boundary without changing the request."""
+        claim = self._ordinary_dm_wire_pending
+        selected = True
+        try:
+            url = kwargs.get("url")
+            if type(url) is not str or not url.endswith("/getUpdates") or kwargs.get("method") != "POST":
+                selected = False
+                return None
+            parameters = kwargs["request_data"].parameters
+            timeout = parameters.get("timeout")
+            if type(timeout) is int and timeout == 0:
+                selected = False
+                return None  # PTB's stop cleanup is outside the claim boundary.
+            if (overlapping or generation != claim.generation
+                    or self._ordinary_dm_wire_updater(generation) is not claim.updater
+                    or self._ordinary_dm_wire_native_parameters(request, generation, kwargs) is None
+                    or time.monotonic() >= claim.expires_monotonic
+                    or claim.owner_is_current() is not True):
+                return None
+            from .telegram_receive_window import DirectMessageWireWindow
+
+            armed_at = time.monotonic()
+            if armed_at >= claim.expires_monotonic:
+                return None
+            offset = parameters["offset"]
+            window = DirectMessageWireWindow(
+                generation=generation, user_id=claim.user_id, first_offset=offset,
+                armed_at=armed_at, expires=claim.expires_monotonic, max_updates=claim.max_updates,
+            )
+            self._ordinary_dm_wire_arm = _OrdinaryDMWireArm(claim, window, offset, armed_at)
+            self._ordinary_dm_wire_window = window
+            return armed_at
+        except (Exception, asyncio.CancelledError):
+            return None
+        finally:
+            if selected:
+                self._ordinary_dm_wire_pending = None
+
+    def _ordinary_dm_wire_arm_readback(self, claim_sha256):
+        """Read only a matching, still usable native arm on the gateway loop."""
+        arm = getattr(self, "_ordinary_dm_wire_arm", None)
+        if arm is None or type(claim_sha256) is not str or arm.claim.claim_sha256 != claim_sha256:
+            return None
+        claim, window = arm.claim, arm.window
+        try:
+            if asyncio.get_running_loop() is not claim.loop:
+                return None
+        except RuntimeError:
+            return None
+        try:
+            if (self._ordinary_dm_wire_updater(claim.generation) is not claim.updater
+                    or getattr(self, "_ordinary_dm_wire_window", None) is not window
+                    or claim.owner_is_current() is not True):
+                window.lost("wire_arm_owner_or_updater_changed")
+                return None
+            now = time.monotonic()
+            if window.snapshot(now, current_generation=claim.generation, accepting=True)["state"] != "OPEN":
+                return None
+            last_progress = self._polling_last_progress_monotonic
+            if last_progress is not None and not 0 <= now - last_progress <= _POLLING_STALL_TIMEOUT:
+                window.lost("wire_arm_polling_progress_stale")
+                return None
+            if last_progress is None or not self._polling_progress_event.is_set() or self._send_path_degraded:
+                return None
+        except (Exception, asyncio.CancelledError):
+            window.lost("wire_arm_readback_failed")
+            return None
+        return {
+            "claim_sha256": claim.claim_sha256,
+            "generation": claim.generation,
+            "first_offset": arm.first_offset,
+            "armed_monotonic": arm.armed_monotonic,
+            "expires_monotonic": claim.expires_monotonic,
+        }
+
+    def _retire_ordinary_dm_wire_window(self, claim_sha256):
+        """Release only an exact terminal arm after the protected caller retains its evidence."""
+        arm = getattr(self, "_ordinary_dm_wire_arm", None)
+        if arm is None or type(claim_sha256) is not str or arm.claim.claim_sha256 != claim_sha256:
+            return False
+        claim, window = arm.claim, arm.window
+        try:
+            if (asyncio.get_running_loop() is not claim.loop
+                    or getattr(self, "_ordinary_dm_wire_window", None) is not window):
+                return False
+            accepting = self._ordinary_dm_wire_updater(claim.generation) is claim.updater
+            state = window.snapshot(time.monotonic(), current_generation=self._polling_generation,
+                                    accepting=accepting)["state"]
+            if state not in ("UNKNOWN", "LOCAL_WIRE_CLOSED"):
+                return False
+        except Exception:
+            return False
+        self._ordinary_dm_wire_window = self._ordinary_dm_wire_arm = None
+        return True
