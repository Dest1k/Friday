+    def _ordinary_dm_wire_updater(self, generation):
+        """Identify the current PTB poller on its owning event loop."""
+        if (type(generation) is not int or not 0 < generation < 2**63
+                or generation != self._polling_generation or self._teardown_started
+                or not self._polling_progress_accepting):
+            return None
+        updater = getattr(getattr(self, "_app", None), "updater", None)
+        task = getattr(updater, "_Updater__polling_task", None)
+        if (isinstance(task, asyncio.Task) and not task.done() and updater.running
+                and updater.bot is getattr(self, "_bot", None)
+                and task.get_loop() is asyncio.get_running_loop()):
+            return updater
+        return None
+
+    def _reserve_ordinary_dm_wire_window(self, *, claim_sha256, user_id, generation,
+                                        expires_monotonic, max_updates, owner_is_current):
+        """Queue an already authorized claim on the gateway loop. None means pending only."""
+        now = time.monotonic()
+        updater = self._ordinary_dm_wire_updater(generation)
+        if (updater is None or type(claim_sha256) is not str
+                or re.fullmatch(r"[0-9a-f]{64}", claim_sha256) is None
+                or type(user_id) is not int or not 0 < user_id < 2**63
+                or type(expires_monotonic) not in (int, float) or not now < expires_monotonic <= now + 600
+                or type(max_updates) is not int or not 1 <= max_updates <= 200
+                or not callable(owner_is_current) or owner_is_current() is not True):
+            raise ValueError("Invalid authorized Telegram wire claim")
+        pending = getattr(self, "_ordinary_dm_wire_pending", None)
+        if (pending is not None and (pending.updater is not updater or pending.generation != generation
+                                    or now >= pending.expires_monotonic)):
+            self._ordinary_dm_wire_pending = pending = None
+        claimed = getattr(self, "_ordinary_dm_wire_claimed", None)
+        if claimed is None:
+            self._ordinary_dm_wire_claimed = claimed = set()
+        if (pending is not None or getattr(self, "_ordinary_dm_wire_arm", None) is not None
+                or getattr(self, "_ordinary_dm_wire_window", None) is not None or claim_sha256 in claimed):
+            raise ValueError("Telegram wire claim already reserved or another claim still held")
+        claimed.add(claim_sha256)
+        self._ordinary_dm_wire_pending = _OrdinaryDMWireClaim(
+            claim_sha256, user_id, generation, expires_monotonic, max_updates,
+            owner_is_current, updater, asyncio.get_running_loop(),
+        )
