diff --git a/gateway/ordinary_dm_ingress.py b/gateway/ordinary_dm_ingress.py
new file mode 100644
--- /dev/null
+++ b/gateway/ordinary_dm_ingress.py
@@ -0,0 +1,307 @@
+"""Bounded, process-local evidence for an already armed Telegram wire window."""
+from __future__ import annotations
+
+import asyncio
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+from dataclasses import dataclass
+from functools import wraps
+from pathlib import PurePosixPath
+import time
+from types import MappingProxyType
+
+from gateway.session_identity import identity_of
+
+_ROUTE = frozenset(("session_key", "source_profile", "transport_profile", "runtime_profile"))
+_SCOPE = _ROUTE | {"bot_id", "authorization_home", "runtime_home"}
+_DELIVERY = ContextVar("ordinary_dm_routed_writer", default=None)
+
+
+def ingress_scope(value):
+    """Pin the private caller's route. This function grants no authorization."""
+    if (type(value) is not dict or set(value) != _SCOPE or type(value["bot_id"]) is not int
+            or not 0 < value["bot_id"] < 2**63
+            or any(type(value[key]) is not str or "\x00" in value[key] or len(value[key]) > 512
+                   for key in _SCOPE - {"bot_id"})
+            or not all(value[key].strip() for key in _ROUTE - {"source_profile"})):
+        raise ValueError("Exact ordinary DM ingress scope required")
+    for key in ("authorization_home", "runtime_home"):
+        path = PurePosixPath(value[key])
+        if not path.is_absolute() or str(path) != value[key] or ".." in path.parts or path.anchor != "/":
+            raise ValueError("Exact ordinary DM home required")
+    return MappingProxyType(dict(value))
+
+
+@dataclass
+class _RoutedWrite:
+    evidence: OrdinaryDMIngressOutcomes
+    update: int
+    proof: dict
+    expected_proof: dict
+    payload: dict
+    task: asyncio.Task
+    active: bool = True
+    invoked: bool = False
+
+
+class OrdinaryDMIngressOutcomes:
+    def __init__(self, adapter, claim, window, armed):
+        self.adapter = adapter
+        self.claim = claim
+        self.window = window
+        self.armed = armed
+        self.scope = claim.ingress_scope
+        self.bot = claim.updater.bot
+        if type(self.bot.id) is not int or self.bot.id != self.scope["bot_id"]:
+            raise ValueError("Selected Telegram receiving bot changed")
+        self._seal = object()
+        self._built = set()
+        self._held = set()
+        self._commits = {}
+        self._admissions = None
+        self._unknown = None
+        self._revision = 0
+
+    def lost(self, reason):
+        if self._unknown is None:
+            self._unknown = reason
+            self._revision += 1
+
+    def _wire(self):
+        claim, adapter = self.claim, self.adapter
+        arm = getattr(adapter, "_ordinary_dm_wire_arm", None)
+        now = time.monotonic()
+        try:
+            if (self._unknown is not None or arm is None or arm.ingress is not self
+                    or arm.window is not self.window
+                    or getattr(adapter, "_ordinary_dm_wire_window", None) is not self.window
+                    or asyncio.get_running_loop() is not claim.loop
+                    or adapter._ordinary_dm_wire_updater(claim.generation) is not claim.updater
+                    or getattr(adapter, "_bot", None) is not self.bot
+                    or not self.armed <= now < claim.expires_monotonic
+                    or claim.owner_is_current() is not True):
+                self.lost("ingress_owner_generation_or_window_lost")
+                return None
+            wire = self.window.snapshot(now, current_generation=claim.generation, accepting=True)
+            if wire["state"] == "UNKNOWN":
+                self.lost("ingress_wire_coverage_lost")
+                return None
+            return wire
+        except (Exception, asyncio.CancelledError):
+            self.lost("ingress_observation_failed")
+            return None
+
+    def _selected_source(self, source):
+        user = str(self.claim.user_id)
+        return (getattr(getattr(source, "platform", None), "value", None) == "telegram"
+                and (source.chat_type, source.user_id, source.chat_id, source.thread_id or "")
+                == ("dm", user, user, ""))
+
+    def built(self, event):
+        if not self._selected_source(event.source):
+            return
+        wire = self._wire()
+        update = event.platform_update_id
+        if wire is None or type(update) is not int or update not in wire["target_update_ids"]:
+            return
+        if (event.internal or event.raw_message is None or event._ingress_update_id != update
+                or update in self._built or len(self._built) >= self.claim.max_updates):
+            self.lost("ingress_duplicate_or_unbound_native_event")
+            return
+        self._built.add(update)
+        event._ordinary_dm_ingress_stamp = (self._seal, update)
+        self._revision += 1
+
+    def _stamp(self, event):
+        stamp = getattr(event, "_ordinary_dm_ingress_stamp", None)
+        if type(stamp) is tuple and len(stamp) == 2 and stamp[0] is self._seal:
+            return stamp[1]
+        return None
+
+    def held(self, event, *, dropped=False):
+        update = self._stamp(event)
+        if update is None:
+            if self._selected_source(event.source):
+                wire = self._wire()
+                claimed = getattr(event, "_ingress_update_id", None)
+                if wire is not None and (claimed in wire["target_update_ids"]
+                        or event._ingress_merged and claimed is None):
+                    self.lost("ingress_unbound_held_event")
+            return
+        if dropped:
+            self.lost("ingress_selected_held_queue_overflow")
+        if update not in self._held:
+            self._held.add(update)
+            self._revision += 1
+        if event._ingress_merged:
+            self.lost("ingress_held_event_was_merged")
+
+    def select(self, event, source, identity, session_key):
+        update = self._stamp(event)
+        if update is None or not self._wire():
+            return None
+        if (event.internal or event._ingress_merged or event.source is not source
+                or type(event.platform_update_id) is not int or event.platform_update_id != update
+                or type(event._ingress_update_id) is not int or event._ingress_update_id != update
+                or not self._selected_source(source)
+                or session_key != self.scope["session_key"]
+                or (source.profile or "") != self.scope["source_profile"]
+                or identity.adapter() is not self.adapter or identity.transport_inferred
+                or str(identity.authorization_home) != self.scope["authorization_home"]
+                or str(identity.runtime_home) != self.scope["runtime_home"]
+                or identity.transport_profile != self.scope["transport_profile"]
+                or identity.runtime_profile != self.scope["runtime_profile"]
+                or event.raw_message is None or event.raw_message.get_bot() is not self.bot):
+            self.lost("ingress_selected_route_or_event_changed")
+            return None
+        return update
+
+    def attempt(self, update, proof, payload):
+        if update is None or payload is None or proof is None or not self._wire():
+            return None
+        message = proof["message"]
+        user = str(self.claim.user_id)
+        if (proof["platform"] != "telegram" or any(proof[key] != self.scope[key] for key in _ROUTE)
+                or (message["bot_id"], message["user_id"], message["chat_id"], message["thread_id"],
+                    message["platform_update_id"]) != (str(self.scope["bot_id"]), user, user, "", str(update))):
+            self.lost("ingress_native_receipt_route_changed")
+            return None
+        return _RoutedWrite(self, update, proof, deepcopy(proof), payload, asyncio.current_task())
+
+    def readback(self):
+        wire = self._wire()
+        if wire is None:
+            return {"state": "UNKNOWN", "reason": self._unknown}
+        ids = wire["target_update_ids"]
+        missing = tuple(update for update in ids if update not in self._commits and update not in self._held)
+        if wire["state"] != "LOCAL_WIRE_CLOSED" or missing:
+            return {"state": "UNKNOWN", "reason": "ingress_window_or_dispositions_incomplete",
+                    "missing_update_ids": missing}
+        return {
+            "state": "OBSERVED_PENDING_CALLER_CLOSURE",
+            "claim_sha256": self.claim.claim_sha256,
+            "generation": self.claim.generation,
+            "armed_monotonic": self.armed,
+            "expires_monotonic": self.claim.expires_monotonic,
+            "revision": self._revision,
+            "wire": wire,
+            "held_update_ids": tuple(update for update in ids if update in self._held),
+            "committed_pairs": tuple(self._commits[update] for update in ids if update in self._commits),
+            "admissions": self._admissions,
+        }
+
+
+def _ingress(adapter):
+    arm = getattr(adapter, "_ordinary_dm_wire_arm", None)
+    return getattr(arm, "ingress", None)
+
+
+def built_event(adapter, event):
+    evidence = _ingress(adapter)
+    if evidence is not None:
+        try:
+            evidence.built(event)
+        except (Exception, asyncio.CancelledError):
+            evidence.lost("ingress_event_observation_failed")
+
+
+def held_event(adapter, event, *, dropped=False):
+    evidence = _ingress(adapter)
+    if evidence is not None:
+        try:
+            evidence.held(event, dropped=dropped)
+        except (Exception, asyncio.CancelledError):
+            evidence.lost("ingress_hold_observation_failed")
+
+
+def lost_ingress(adapter, reason):
+    evidence = _ingress(adapter)
+    if evidence is not None:
+        evidence.lost(reason)
+
+
+def routed_event(event, source, session_key):
+    evidence = None
+    try:
+        identity = identity_of(source)
+        if identity is not None:
+            evidence = _ingress(identity.adapter())
+        if evidence is not None:
+            update = evidence.select(event, source, identity, session_key)
+            if update is not None:
+                return evidence, update
+    except (Exception, asyncio.CancelledError):
+        if evidence is not None:
+            evidence.lost("ingress_routed_selection_failed")
+    return None
+
+
+@contextmanager
+def routed_write(selected, proof, payload):
+    attempt = None
+    if selected is not None:
+        evidence, update = selected
+        try:
+            attempt = evidence.attempt(update, proof, payload)
+        except (Exception, asyncio.CancelledError):
+            evidence.lost("ingress_routed_receipt_observation_failed")
+    token = _DELIVERY.set(attempt)
+    try:
+        yield
+    finally:
+        if attempt is not None:
+            attempt.active = False
+        _DELIVERY.reset(token)
+
+
+def routed_admission_callback(admissions):
+    """Keep the registered callback's signature and ordinary None return."""
+    ordinary = admissions.record
+
+    @wraps(ordinary)
+    def callback(**kwargs):
+        attempt = _DELIVERY.get()
+        if (attempt is None or not attempt.active
+                or kwargs.get("admitted_ingress") is not attempt.proof):
+            return ordinary(**kwargs)
+        evidence = attempt.evidence
+        from hermes_constants import get_hermes_home
+
+        def current_store():
+            return (attempt.active and asyncio.current_task() is attempt.task
+                    and evidence._wire() is not None
+                    and str(get_hermes_home()) == evidence.scope["runtime_home"]
+                    and (evidence._admissions is None or evidence._admissions is admissions))
+
+        try:
+            eligible = (current_store() and not attempt.invoked and attempt.update not in evidence._commits
+                        and attempt.proof == attempt.expected_proof)
+        except (RuntimeError, ValueError):
+            eligible = False
+        if not eligible:
+            evidence.lost("ingress_routed_store_or_callback_changed")
+            return ordinary(**kwargs)
+        attempt.invoked = True
+        try:
+            committed = admissions.record_payload_commit(
+                admitted_ingress=attempt.expected_proof, session_key=kwargs["session_key"],
+                message_id=kwargs["message_id"], source=kwargs["source"],
+                platform=kwargs["platform"], telegram_payload_v1=attempt.payload,
+            )
+        except BaseException:
+            evidence.lost("ingress_writer_return_unknown")
+            raise
+        try:
+            if (committed is None or not current_store()
+                    or committed.durable.state is not admissions.state or committed.update_id != str(attempt.update)):
+                evidence.lost("ingress_missing_foreign_or_late_writer_return")
+            else:
+                evidence._admissions = admissions
+                evidence._commits[attempt.update] = committed
+                evidence._revision += 1
+        except (Exception, asyncio.CancelledError):
+            evidence.lost("ingress_writer_return_unproved")
+        return None
+
+    return callback
