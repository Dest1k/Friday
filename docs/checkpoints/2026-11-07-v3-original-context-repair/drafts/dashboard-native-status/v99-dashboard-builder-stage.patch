+def staged_project_snapshot(project, files):
+    root_pin = parent_pin(project)
+    require(stat.S_IMODE(root_pin["st_mode"]) == 0o700, "v99_builder_private_staged_project_required")
+    paths = {path.relative_to(project).as_posix() for path in project.rglob("*")
+             if path.is_symlink() or not path.is_dir()}
+    require(paths == files.keys(), "v99_builder_staged_project_files_changed")
+    rows = {relative: capture(project / relative, sha=sha)[1] for relative, sha in files.items()}
+    require(parent_pin(project) == root_pin, "v99_builder_staged_project_identity_changed")
+    return {"root": root_pin, "files": rows}
+
+
+def staged_inputs(project, input_ref, *, original, legacy_input, legacy_project):
+    project = canonical(project)
+    home = Path(original["home"])
+    require(all(not project.is_relative_to(root) and not root.is_relative_to(project)
+                for root in (home, legacy_project)), "v99_builder_separate_staged_project_required")
+    raw, input_pin = capture_reference(input_ref, mode=0o600)
+    require(stat.S_IMODE(input_pin["parent_identity"]["st_mode"]) == 0o700
+            and not Path(input_pin["path"]).is_relative_to(home)
+            and not Path(input_pin["path"]).is_relative_to(project),
+            "v99_builder_private_staged_baseline_required")
+    staged_input = exact_object(raw)
+    inventory = staged_input.get("project_files")
+    require(type(inventory) is dict, "v99_builder_staged_baseline_inventory_required")
+    old_files = legacy_input["project_files"]
+    helper_sha = inventory.get(HELPER)
+    require(type(helper_sha) is str and re.fullmatch("[0-9a-f]{64}", helper_sha)
+            and helper_sha != old_files[HELPER], "v99_builder_staged_helper_delta_required")
+    expected_files = dict(old_files)
+    expected_files[HELPER] = helper_sha
+    require(raw == encoded(dict(legacy_input, project_files=expected_files)),
+            "v99_builder_staged_baseline_delta_changed")
+    request = dict(original, candidate_project=str(project), project_inventory=expected_files,
+                   project_inventory_sha256=digest(encoded(expected_files)))
+    return request, staged_input, input_pin, staged_project_snapshot(project, expected_files)
 
 
