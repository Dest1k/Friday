+def primary_http_failure(error: Exception) -> dict | None:
+    """Record a typed HTTP failure without exposing provider text, bodies or IDs."""
+    try:
+        status = getattr(error, "status_code", None)
+        response = getattr(error, "response", None)
+        response_status = getattr(response, "status_code", None)
+    except Exception:
+        return None
+    if (type(status) is not int or not 400 <= status <= 599
+            or type(response_status) is not int or response_status != status):
+        return None
+    failure = {"http_status": status}
+    try:
+        body = getattr(error, "body", None)
+        fields = body.get("error", body) if type(body) is dict else None
+        labels = [getattr(error, "type", None), getattr(error, "code", None)]
+        if type(fields) is dict:
+            labels.extend((fields.get("type"), fields.get("code")))
+        if status == 503 and any(type(label) is str and label == "pearl_guard" for label in labels):
+            failure["provider_code"] = "pearl_guard"
+        witness = response.request.extensions.get(_EXTENSION)
+        if type(witness) is tuple and len(witness) == 2 and isinstance(witness[0], AttemptCollector):
+            failure.update(witness[0].failure_reference(witness[1]))
+    except Exception:
+        # Missing adapter metadata must not replace the original failure.
+        pass
+    return failure
 
 
