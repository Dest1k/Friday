+def private_exception_origin(exc, source_roles):
+    """Python origin metadata only; never exception text, locals or payload."""
+    frames=[];tb=exc.__traceback__
+    while tb is not None:
+        code=tb.tb_frame.f_code
+        name=code.co_name
+        frames.append(dict(source_role=source_roles.get(code.co_filename,'OTHER_SOURCE'),
+            function=name if re.fullmatch(r'[A-Za-z0-9_<>]{1,80}',name) else 'OTHER_FUNCTION',
+            line=tb.tb_lineno))
+        if len(frames)>16:frames.pop(0)
+        tb=tb.tb_next
+    name=type(exc).__name__
+    return dict(schema='frw.ownc.private-exception-origin.v1',
+        exception_class=name if re.fullmatch(r'[A-Za-z0-9_]{1,80}',name) else 'OTHER_EXCEPTION',
+        frames=frames,scope='PYTHON_ORIGIN_ONLY_NO_MESSAGE_LOCALS_OR_GDB_INTERNAL_CALLSITE')
