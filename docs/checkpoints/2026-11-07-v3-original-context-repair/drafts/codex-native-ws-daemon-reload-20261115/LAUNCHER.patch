     return [*command, thread]
+
+
+def daemon_verb(state, *, reload_requested, binary=BIN, proc_root=Path('/proc')):
+    """Refresh a stale daemon at the existing owner-exited reconnect boundary."""
+    if reload_requested:
+        return 'restart'
+    backends = state['backend_pids']
+    if not backends:
+        return 'start'
+    if len(backends) != 1:
+        raise SystemExit('Expected at most one designated daemon before reconnect.')
+    try:
+        running = (proc_root / str(backends[0]) / 'exe').resolve(strict=True)
+    except OSError:
+        raise SystemExit('Daemon identity changed; inspect it before reconnecting.') from None
+    return 'start' if running == binary else 'restart'
 
 
