+    def cleanup_order(self, inferiors):
+        """Retire accepted live descendants before their accepted parents.
+
+        Sorting confers no ownership: each kill still needs cleanup_identity's
+        current exact birth/PPID CAS. Unknown entries remain in the traversal
+        and fail that gate. Do not kill a parent first and create PPID drift.
+        """
+        values = list(inferiors)
+        live = [i for i in values if i.pid]
+        need(len({i.pid for i in live}) == len(live)
+             and len({i.num for i in values}) == len(values),
+             'gpgme_cleanup_duplicate_inferior_or_pid')
+        identities = {}
+        for inf in live:
+            if inf.num == 1:
+                native = self.paper.n['STATE']['process']
+                if native is not None and inf.pid == native['pid']:
+                    identities[inf.pid] = dict(pid=inf.pid, ppid=native['gdb_pid'],
+                                               start_ticks=native['start_ticks'])
+            elif inf.pid in self.paper.known:
+                identities[inf.pid] = self.paper.known[inf.pid]
+            else:
+                known = self.gpgme.known.get(inf.pid)
+                if known is not None and known['inferior'] == inf.num:
+                    identities[inf.pid] = known['identity']
+        def depth(pid, seen=()):
+            need(pid not in seen, 'gpgme_cleanup_known_parent_cycle')
+            item = identities.get(pid)
+            if item is None or item['ppid'] not in identities:
+                return 0
+            return 1 + depth(item['ppid'], seen + (pid,))
+        return sorted(values, key=lambda i: (i.num == 1, -depth(i.pid), -i.num))
+
+    def cleanup_select(self, inferior):
