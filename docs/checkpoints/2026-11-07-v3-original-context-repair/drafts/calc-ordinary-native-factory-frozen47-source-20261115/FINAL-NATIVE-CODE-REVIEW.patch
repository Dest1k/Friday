+         'ordinary_observer_font_exact15')
+    for row in rows:
+        expected=sha(env[row['key']].encode()) if env[row['key']] is not None else None
+        need(set(row)=={'key','value_sha256'} and row['value_sha256']==expected,'ordinary_observer_font_environment_drift')
+    return env
