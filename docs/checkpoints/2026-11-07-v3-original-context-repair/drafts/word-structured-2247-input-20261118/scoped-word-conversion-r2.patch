+    def _numbering_root(self, root):
+        marker = q('http://schemas.openxmlformats.org/markup-compatibility/2006', 'Ignorable')
+        if root.attrib != {marker: 'w14 wp14'}:
+            self._root_attributes(root)
+            return False
+        # ElementTree discards prefix declarations, but compatibility values
+        # use their original bindings. The package XML has passed preflight.
+        namespaces = {}
+        for event, value in iterparse(BytesIO(self.pkg.parts['word/numbering.xml']),
+                                      events=('start-ns', 'start')):
+            if event == 'start':
+                break
+            prefix, uri = value
+            namespaces[prefix] = uri
+        if (namespaces.get('w14') != 'http://schemas.microsoft.com/office/word/2010/wordml'
+                or namespaces.get('wp14') != 'http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing'):
+            _fail('unsupported_word_content')
+        _white(root)
+        return True
+
