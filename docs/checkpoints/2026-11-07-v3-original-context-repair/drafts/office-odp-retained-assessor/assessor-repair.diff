+  shapes=[r for r in rows if r[0]=='SHAPE' and r[1]==path]
+  need(len(shapes)==1 and unhex(shapes[0][2])=='com.sun.star.presentation.SlideNumberShape','FIELD_NATIVE_SHAPE_JOIN')
+  texts=[r for r in rows if r[0]=='TEXT' and r[1]==path]
+  paragraphs=[r for r in rows if r[0]=='PARAGRAPH' and r[1]==path]
+  portions=[r for r in rows if r[0]=='PORTION' and r[1]==path]
+  need(len(texts)==len(paragraphs)==len(portions)==1 and paragraphs[0][2]=='0' and portions[0][2:4]==('0','0'),'FIELD_NATIVE_SINGLE_PORTION_JOIN')
+  need(texts[0][-1]==paragraphs[0][-1]==portions[0][-1],'FIELD_NATIVE_PAYLOAD_JOIN')
+  prop_path=path+'/paragraph/0/portion/0'
+  kinds=[r for r in rows if r[0]=='PROPERTY' and r[1]==prop_path and r[2]=='TextPortionType']
+  need(len(kinds)==1 and unhex(kinds[0][-1])=='TextField','FIELD_NATIVE_TEXTFIELD_JOIN')
+  results[path]=unhex(texts[0][-1])
+ return results
