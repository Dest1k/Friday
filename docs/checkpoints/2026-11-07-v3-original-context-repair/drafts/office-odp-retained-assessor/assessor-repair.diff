+def page_number_definitions(raw):
+ """Derive eligible fields structurally, never from a document/hash allowlist."""
+ with zipfile.ZipFile(io.BytesIO(raw)) as z:
+  need(len(z.infolist())<=1024 and sum(x.file_size for x in z.infolist())<=16*1024**2 and all(x.file_size<=4*1024**2 for x in z.infolist()),'FIELD_PACKAGE_BOUNDARY')
+  root=ET.fromstring(z.read('content.xml'))
+ def canonical(node):
+  return (node.tag,tuple(sorted(node.attrib.items())),node.text or '',tuple(canonical(x) for x in node),node.tail or '')
+ result={}
+ for i,page in enumerate(root.findall('.//d:page',NS)):
+  notes=page.find('p:notes',NS)
+  if notes is None:continue
+  for j,shape in enumerate(notes):
+   if shape.get('{'+NS['p']+'}class')!='page-number':continue
+   path=f'notes/{i}/{j}';paras=shape.findall('./d:text-box/t:p',NS)
+   need(len(paras)==1,'FIELD_SINGLE_SOURCE_PARAGRAPH')
+   para=paras[0];fields=para.findall('.//t:page-number',NS)
+   allowed={'{'+NS['t']+'}p','{'+NS['t']+'}span','{'+NS['t']+'}page-number'}
+   need(len(fields)==1 and len(fields[0])==0 and all(x.tag in allowed for x in para.iter()) and text(para)==text(fields[0]),'FIELD_EXACT_PAGE_NUMBER_LEAF')
+   result[path]=canonical(fields[0])
+ return result
