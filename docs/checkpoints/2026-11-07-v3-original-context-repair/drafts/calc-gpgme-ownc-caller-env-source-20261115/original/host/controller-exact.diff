+        print(json.dumps({'status': 'SOURCE_SCHEMA_JOINS_ONLY', 'runtime_admitted': False, 'actual_M': None}))
+    else:
+        print(json.dumps({'status': 'SOURCE_ONLY_NO_EXECUTION', 'runtime_admitted': False, 'actual_M': None}))
+    return 0
+
+
+if __name__ == '__main__':
