+def exit_profile_environment(environment):
+    """Selectors for the exact pinned helpers' C.UTF-8 initialization path.
+
+    The caller first validates the complete ENV structurally. Pinned helper
+    initialization uses LC_ALL, then pinned glibc's C/C.* gettext path ignores
+    LANGUAGE before reading it. This is a fixed helper/source contract, not
+    an observation of the original's or helper's current locale category.
+    LOCPATH may only be absent/empty; GCONV_PATH must be absent, since even
+    its empty form disables the cache. Complete frozen ENV equality and the
+    exact mapped locale-data profile remain independently mandatory.
+    """
+    return (environment.get('LC_ALL') == environment.get('LANG') == 'C.UTF-8'
+            and environment.get('LOCPATH', '') == ''
+            and 'GCONV_PATH' not in environment)
+
