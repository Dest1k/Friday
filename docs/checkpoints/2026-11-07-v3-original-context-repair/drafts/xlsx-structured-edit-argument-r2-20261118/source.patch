+def _xlsx_edit_sheet_hidden(sheet):
+    visibility = (
+        ('row', ('hidden', 'collapsed'), ('ht',)),
+        ('col', ('hidden', 'collapsed'), ('width',)),
+        ('sheetFormatPr', ('zeroHeight',), ('defaultRowHeight', 'defaultColWidth')),
+    )
+    for kind, flags, dimensions in visibility:
+        for node in sheet.iter(q(S, kind)):
+            if any(node.get(flag, 'false') not in ('0', 'false') for flag in flags):
+                return True
+            try:
+                values = (node.attrib[name] for name in dimensions if name in node.attrib)
+                if any(not value.isascii() or '_' in value or not 0 < float(value) < float('inf')
+                       for value in values):
+                    return True
+            except ValueError:
+                return True
+    return False
+
+
+def _validate_xlsx_edit_package(data, checkpoint):
+    book = ooxml(data, 'xlsx', writing=True, checkpoint=checkpoint, allow_empty_workbook_protection=True)
+    # The common parser discards comments and PIs. Preserve them for the edit-only
+    # empty-marker exception, and track namespace declarations on the marker itself.
+    parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True, insert_pis=True))
+    events = ET.iterparse(BytesIO(book.parts['xl/workbook.xml']), events=('start', 'start-ns'), parser=parser)
+    markers = []
+    declares_namespace = False
+    sharing = False
+    for event, item in events:
+        if event == 'start-ns':
+            declares_namespace = True
+            continue
+        local = item.tag.rsplit('}', 1)[-1]
+        if local == 'workbookProtection':
+            markers.append((item, declares_namespace))
+        if local == 'fileSharing':
+            sharing = True
+        declares_namespace = False
+    if not markers:
+        return
+    if len(markers) != 1 or sharing:
+        fail('protected_workbook')
+    marker, declares_namespace = markers[0]
+    workbook = events.root
+    if (marker.tag != q(S, 'workbookProtection') or marker not in workbook
+            or declares_namespace or marker.attrib or len(marker)
+            or (marker.text or '').strip(' \t\r\n')):
+        fail('protected_workbook')
+
+    # The exception is for ordinary visible workbooks only. Leave the existing
+    # no-marker profile unchanged.
+    if any(view.get('visibility', 'visible') != 'visible' for view in workbook.iter(q(S, 'workbookView'))):
+        fail('hidden_workbook_mutation_unsupported')
+    if any(sheet.get('state', 'visible') != 'visible' for sheet in workbook.iter(q(S, 'sheet'))):
+        fail('hidden_sheet_mutation_unsupported')
+    for part in book.sheet_parts.values():
+        tick(checkpoint)
+        sheet = book.xml[part]
+        if any(node.tag.rsplit('}', 1)[-1] in ('sheetProtection', 'protectedRanges') for node in sheet.iter()):
+            fail('protected_sheet')
+        if _xlsx_edit_sheet_hidden(sheet):
+            fail('hidden_sheet_structure_mutation_unsupported')
+
+
