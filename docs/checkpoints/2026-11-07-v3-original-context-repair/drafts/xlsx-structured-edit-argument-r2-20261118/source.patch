+_XLSX_EDIT_FIELDS = frozenset({"source", "sheet", "cell", "expected", "value"})
+
+
+def _structured_xlsx_edit(args: Dict[str, Any]) -> str | None:
+    """Encode the native XLSX edit object for the existing string-based writer."""
+    content, path = args.get("content"), args.get("path")
+    if (args.get("format") != "spreadsheet_edit" or not isinstance(content, dict)
+            or content.keys() != _XLSX_EDIT_FIELDS or not isinstance(path, str)):
+        return None
+    if (any(not isinstance(content[key], str) for key in ("source", "sheet", "cell"))
+            or any(type(content[key]) not in (int, float) for key in ("expected", "value"))):
+        return None
+    if any(PurePath(name).suffix.lower() != ".xlsx" for name in (path, content["source"])):
+        return None
+    try:
+        encoded = json.dumps(content, ensure_ascii=False, allow_nan=False)
+        encoded.encode("utf-8")
+    except ValueError:
+        return None
+    return encoded
+
