+def restore_docx_odt_output(source, output, *, checkpoint=None):
+    """Remove two narrowly source-bound native default-opacity extras.
+
+    Raw native opacity remains unsupported, including on named/used styles.
+    Only 0% on paragraph/graphic default text properties is eligible, and only
+    for an admitted source with no hidden/transparency extension path. This
+    is not a general visibility, theme, rendering or formatting-fidelity claim.
+    Every other byte in the XML and every other package member is retained;
+    the complete derived native inventory must still equal the source.
+    """
+    try:
+        inventory(source, 'docx', checkpoint=checkpoint)
+    except WordConversionError as error:
+        raise WordConversionError(error.code, 'source_inventory') from None
+
+    opacity = q('urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0', 'opacity')
+    try:
+        package = _editable_package(output, 'odt', checkpoint)
+    except (ODFProfileError, ODTError, PresentationError) as error:
+        raise WordConversionError(str(error), 'output_inventory') from None
+    targets = []
+    for name, root in package.xml.items():
+        parents = {child: parent for parent in root.iter() for child in parent}
+        for node in root.iter():
+            _tick(checkpoint)
+            if opacity not in node.attrib:
+                continue
+            parent = parents.get(node)
+            container = parents.get(parent)
+            if (name != 'styles.xml' or root.tag != q(O, 'document-styles')
+                    or node.tag != q(S, 'text-properties') or node.get(opacity) != '0%'
+                    or parent is None or parent.tag != q(S, 'default-style')
+                    or parent.attrib not in ({q(S, 'family'): 'paragraph'}, {q(S, 'family'): 'graphic'})
+                    or container is None or container.tag != q(O, 'styles')
+                    or parents.get(container) is not root):
+                raise WordConversionError('unsupported_output_restoration', 'output_inventory')
+            targets.append((name, node))
+    if not targets:
+        validate_conversion(source, 'docx', output, 'odt', checkpoint=checkpoint)
+        return output, {}
+    if len(targets) > 2:
+        raise WordConversionError('unsupported_output_restoration', 'output_inventory')
+
+    try:
+        word = _Word(source, _Inventory(checkpoint))
+        # An implicit/unused character style can affect native rendering even
+        # though it is not in the semantic paragraph-style chain. Validate all
+        # run-property containers, not just those selected by the inventory.
+        # This extra source restriction is needed only when deriving new bytes;
+        # an already valid native package keeps the existing conversion path.
+        for name, root in word.pkg.xml.items():
+            if not name.startswith('word/') or not name.endswith('.xml'):
+                continue
+            if name.startswith('word/theme/'):
+                _fail('unsupported_output_restoration')
+            for node in root.iter():
+                _tick(checkpoint)
+                if not node.tag.startswith(q(W, '')):
+                    _fail('unsupported_output_restoration')
+                for attr in node.attrib:
+                    inert_marker = (node is root and attr == q(
+                        'http://schemas.openxmlformats.org/markup-compatibility/2006', 'Ignorable'))
+                    if not inert_marker and not any(attr.startswith(q(ns, '')) for ns in (
+                            W, R, 'http://www.w3.org/XML/1998/namespace')):
+                        _fail('unsupported_output_restoration')
+                if node.tag in {q(W, n) for n in ('vanish', 'webHidden', 'specVanish')}:
+                    _fail('unsupported_output_restoration')
+                if node.tag == q(W, 'rPr'):
+                    if node.attrib:
+                        _fail('unsupported_output_restoration')
+                    _word_properties(node, _RUN_PROPERTIES)
+    except WordConversionError as error:
+        raise WordConversionError(error.code, 'source_inventory') from None
+    except WordProfileError as error:
+        raise WordConversionError(str(error), 'source_inventory') from None
+
+    ranges = _native_xml_ranges(package.parts['styles.xml'], package.xml['styles.xml'], checkpoint)
+    edits = []
+    for name, node in targets:
+        start, opening_end, _, _ = ranges[id(node)]
+        opening = package.parts[name][start:opening_end]
+        # Deliberately limited native UTF-8 spelling. Unsupported prefixes or
+        # escaped/ambiguous values fail closed rather than reserialize XML.
+        pattern = rb'''\s+[A-Za-z_][A-Za-z0-9_.-]*:opacity\s*=\s*(["'])0%\1'''
+        matches = list(re.finditer(pattern, opening))
