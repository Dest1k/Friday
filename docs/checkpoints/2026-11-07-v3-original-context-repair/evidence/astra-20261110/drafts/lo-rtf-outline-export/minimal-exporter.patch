+void RtfAttributeOutput::ParaOutlineLevel(const SfxUInt16Item& rItem)
+{
+    sal_uInt16 nOutLvl = std::min(rItem.GetValue(), sal_uInt16(WW8ListManager::nMaxLevel));
+    // Writer uses 0 for body text and 1..9 for headings; RTF uses 9 and 0..8.
+    nOutLvl = nOutLvl ? nOutLvl - 1 : 9;
+    m_aParaFormatting.append(OOO_STRING_SVTOOLS_RTF_OUTLINELEVEL);
+    m_aParaFormatting.append(static_cast<sal_Int32>(nOutLvl));
+}
 
