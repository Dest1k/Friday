+        nonlocal depth, nodes
+        depth += 1
+        nodes += 1
+        if depth > MAX_DEPTH or nodes > MAX_NODES or len(attrs) > 64:
+            _fail('xml_structure_limit')
+        if nodes % 64 == 0:
+            _tick(checkpoint)
+        if name == odt.M + '}file-entry':
+            entries.append((attrs.get(odt.M + '}full-path'),
+                            attrs.get(odt.M + '}media-type', '')))
+
+    def end(name):
+        nonlocal depth
+        depth -= 1
+
+    def declaration(version, encoding, standalone):
+        if encoding is not None and encoding.lower() != 'utf-8':
+            _fail('unsupported_xml_encoding')
+
+    def refuse(*args):
+        _fail('xml_dtd_forbidden')
+
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.XmlDeclHandler = declaration
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ExternalEntityRefHandler = refuse
+    try:
+        for offset in range(0, len(raw), 16_384):
+            _tick(checkpoint)
+            parser.Parse(raw[offset:offset + 16_384], False)
+        parser.Parse(b'', True)
+    except expat.ExpatError:
+        _fail('malformed_xml')
+    _tick(checkpoint)
+    return entries
