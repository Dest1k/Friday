+"""Bounded, inert native Word packages and exact text-copy edits.
+
+DOCX/DOTX are genuine OPC profiles. DOCM/DOTM are read-only: VBA is opaque,
+never imported, evaluated or removed. No Office, converters, extraction to disk,
+link resolution, field updates or network calls are used by this module.
+"""
+from __future__ import annotations
+
+from io import BytesIO
+import json
+import posixpath
+import re
+import stat
+import zipfile
+import zlib
+from xml.etree import ElementTree as ET
+from xml.parsers import expat
+
+MAX_BYTES = 1_000_000
+MAX_MEMBERS = 256
+MAX_NODES = 100_000
+MAX_PARAGRAPHS = 8_192
+W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'
+R = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships'
+PKG = 'http://schemas.openxmlformats.org/package/2006/relationships'
+CT = 'http://schemas.openxmlformats.org/package/2006/content-types'
+MAIN_TYPES = {
+    'docx': 'application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml',
+    'dotx': 'application/vnd.openxmlformats-officedocument.wordprocessingml.template.main+xml',
+    'docm': 'application/vnd.ms-word.document.macroEnabled.main+xml',
+    'dotm': 'application/vnd.ms-word.template.macroEnabledTemplate.main+xml',
+}
+MACRO_FORMATS = frozenset(('docm', 'dotm'))
+VBA_TYPE = 'application/vnd.ms-office.vbaProject'
+VBA_REL = 'http://schemas.microsoft.com/office/2006/relationships/vbaProject'
+
+
+class WordProfileError(ValueError):
+    """A finite, content-free refusal code; never a parser or document message."""
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+class DocumentText(str):
+    def __new__(cls, value, metadata):
+        result = super().__new__(cls, value)
+        result.extraction_metadata = metadata
+        result.scoped_metadata = metadata
+        return result
+
+
+def _fail(code):
+    raise WordProfileError(code)
+
+
+def _tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+def _format(format):
+    if not isinstance(format, str) or format not in MAIN_TYPES:
+        _fail('unsupported_format')
+    return format
+
+
+def _q(ns, name):
+    return '{' + ns + '}' + name
+
+
+def _xml(raw, checkpoint):
+    """Reject declarations/expansion and bound structure before building a tree."""
+    try:
+        raw.decode('utf-8-sig')
+    except UnicodeError:
+        _fail('unsupported_xml_encoding')
+    if b'\x00' in raw:
+        _fail('unsupported_xml_encoding')
+    parser = expat.ParserCreate(encoding='UTF-8', namespace_separator='}')
+    depth = count = 0
+
+    def start(name, attrs):
+        nonlocal depth, count
+        depth += 1
+        count += 1
+        if depth > 128 or count > MAX_NODES or len(attrs) > 64:
+            _fail('xml_structure_limit')
+        if count % 256 == 0:
+            _tick(checkpoint)
+
+    def end(name):
+        nonlocal depth
+        depth -= 1
+
+    def refuse(*args):
+        _fail('xml_active_declaration')
+
+    def declaration(version, encoding, standalone):
+        if encoding and encoding.upper() not in ('UTF-8', 'UTF8', 'US-ASCII'):
+            _fail('unsupported_xml_encoding')
+
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ExternalEntityRefHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    parser.XmlDeclHandler = declaration
+    parser.Parse(raw, True)
+    _tick(checkpoint)
+    return ET.fromstring(raw), count
+
+
+def _part_name(name, *, absolute=False):
+    if not isinstance(name, str):
+        _fail('unsafe_part_name')
+    if absolute:
+        if not name.startswith('/') or name.startswith('//'):
+            _fail('unsafe_part_name')
+        name = name[1:]
+    if (not name or name.startswith('/') or any(c in name for c in '\\:%?#')
+            or any(ord(c) < 32 or ord(c) == 127 for c in name)
+            or any(part in ('', '.', '..') for part in name.split('/'))):
+        _fail('unsafe_part_name')
+    return name
+
+
+def _target(owner, target):
+    if (not isinstance(target, str) or not target or target.startswith('//')
+            or any(c in target for c in '\\:%?#')
+            or any(ord(c) < 32 or ord(c) == 127 for c in target)):
+        _fail('unsafe_relationship_target')
+    name = (posixpath.normpath(target[1:]) if target.startswith('/')
+            else posixpath.normpath(posixpath.join(posixpath.dirname(owner), target)))
+    return _part_name(name)
+
+
+def _metadata(info):
+    # CRC, compressed size and offset are derived by ZIP serialization. All
+    # descriptive member metadata and the original payload remain authoritative.
+    return (info.filename, info.date_time, info.compress_type, info.comment,
+            info.extra, info.create_system, info.create_version,
+            info.extract_version, info.reserved, info.volume,
+            info.internal_attr, info.external_attr, info.flag_bits)
+
+
+class _Package:
+    def __init__(self, data, format, checkpoint=None):
+        self.format = _format(format)
+        if not isinstance(data, bytes) or not data or len(data) > MAX_BYTES:
+            _fail('input_limit')
+        self.parts = {}
+        self.xml = {}
+        self.relationships = {}
+        self.limitations = {'page_layout_images_styles_and_rendering_not_evaluated'}
+        self.active = False
+        self.macro = False
+        self.vba_parts = set()
+        _tick(checkpoint)
+        try:
+            self._load(data, checkpoint)
+            self._profiles(checkpoint)
+        except (zipfile.BadZipFile, ET.ParseError, expat.ExpatError, UnicodeError,
+                KeyError, NotImplementedError, EOFError, zlib.error):
+            _fail('malformed_package')
+        _tick(checkpoint)
+
+    def _load(self, data, checkpoint):
+        with zipfile.ZipFile(BytesIO(data)) as archive:
+            self.infos = archive.infolist()
+            self.comment = archive.comment
+            if not 1 <= len(self.infos) <= MAX_MEMBERS:
+                _fail('package_member_limit')
+            seen = {}
+            total = nodes = 0
+            for info in self.infos:
+                _tick(checkpoint)
+                raw_name = info.filename
+                name = raw_name[:-1] if info.is_dir() else raw_name
+                _part_name(name)
+                if (info.orig_filename != raw_name or name.casefold() in seen
+                        or (info.is_dir() and info.file_size)):
+                    _fail('duplicate_or_conflicting_member')
+                seen[name.casefold()] = info.is_dir()
+                mode = info.external_attr >> 16
+                if (stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFDIR)
+                        or (stat.S_IFMT(mode) == stat.S_IFDIR and not info.is_dir())
+                        or (stat.S_IFMT(mode) == stat.S_IFREG and info.is_dir())
+                        or info.flag_bits & ~0x0808):
+                    _fail('encrypted_or_special_member')
+                if info.compress_type not in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED):
+                    _fail('unsupported_compression')
+                total += info.file_size
+                if (info.file_size > MAX_BYTES or total > MAX_BYTES
+                        or info.file_size > max(4096, info.compress_size * 200)):
+                    _fail('package_expansion_limit')
+                if info.is_dir():
+                    continue
+                from tools.scoped_zip import read_zip_member, ZipMemberLimitError
+                try:
+                    raw = read_zip_member(archive, data, info, MAX_BYTES)
+                except ZipMemberLimitError:
+                    _fail('package_expansion_limit')
+                if len(raw) != info.file_size:
+                    _fail('malformed_package')
+                self.parts[name] = raw
+                if name.lower().endswith(('.xml', '.rels')):
+                    root, count = _xml(raw, checkpoint)
+                    nodes += count
+                    if nodes > MAX_NODES:
+                        _fail('xml_structure_limit')
+                    self.xml[name] = root
+            for name in seen:
+                components = name.split('/')
+                for end in range(1, len(components)):
+                    if seen.get('/'.join(components[:end])) is False:
+                        _fail('duplicate_or_conflicting_member')
+
+    def _profiles(self, checkpoint):
+        types = self.xml.get('[Content_Types].xml')
+        if types is None or types.tag != _q(CT, 'Types'):
+            _fail('content_types_missing_or_namespace')
+        defaults = {}
+        overrides = {}
+        for node in types:
+            kind = node.get('ContentType')
+            if (not kind or len(kind) > 256 or any(ord(c) < 33 for c in kind)
+                    or len(node)):
+                _fail('invalid_content_type')
+            if node.tag == _q(CT, 'Default'):
+                extension = node.get('Extension')
+                if (not extension or not re.fullmatch(r'[A-Za-z0-9_-]{1,32}', extension)
+                        or extension.casefold() in defaults):
+                    _fail('duplicate_or_invalid_content_type')
+                defaults[extension.casefold()] = kind
+            elif node.tag == _q(CT, 'Override'):
+                name = _part_name(node.get('PartName'), absolute=True)
+                if name.casefold() in overrides or name not in self.parts:
+                    _fail('duplicate_or_invalid_content_type')
+                overrides[name.casefold()] = (name, kind)
+            else:
+                _fail('invalid_content_type')
+        self.types = {}
+        for name in self.parts:
+            if name == '[Content_Types].xml':
+                continue
+            override = overrides.get(name.casefold())
+            if override is not None and override[0] != name:
+                _fail('content_type_case_conflict')
+            kind = override[1] if override else defaults.get(name.rsplit('.', 1)[-1].casefold())
+            if not kind:
+                _fail('content_type_missing')
+            self.types[name] = kind
+            lowered = (name + ' ' + kind).lower()
+            if any(marker in lowered for marker in ('macroenabled', 'vbaproject', 'vbadata')):
+                self.macro = True
+            if kind == VBA_TYPE:
+                self.vba_parts.add(name)
+            if any(marker in lowered for marker in ('activex', 'embedding', 'oleobject', 'vba',
+                                                     'signature', 'customui', 'afchunk')):
+                self.active = True
+                self.limitations.add('active_embedded_content_and_signatures_not_evaluated')
+        if self.types.get('word/document.xml') != MAIN_TYPES[self.format]:
+            _fail('profile_content_type_mismatch')
+        document = self.xml.get('word/document.xml')
+        if document is None or document.tag != _q(W, 'document'):
+            _fail('main_part_missing_or_namespace')
+        bodies = document.findall(_q(W, 'body'))
+        if len(bodies) != 1:
+            _fail('main_body_missing_or_duplicate')
+        self.body = bodies[0]
+        for name, root in self.xml.items():
+            _tick(checkpoint)
+            if not name.lower().endswith('.rels'):
+                continue
+            if (not name.endswith('.rels') or root.tag != _q(PKG, 'Relationships')
+                    or self.types.get(name) != 'application/vnd.openxmlformats-package.relationships+xml'):
+                _fail('relationship_namespace_or_content_type')
+            if name == '_rels/.rels':
+                owner = ''
+            else:
+                folder, leaf = posixpath.split(name)
+                if posixpath.basename(folder) != '_rels':
+                    _fail('relationship_location')
+                owner = posixpath.join(posixpath.dirname(folder), leaf[:-5])
+                if owner not in self.parts:
+                    _fail('relationship_owner_missing')
+            rows = {}
+            for relation in root:
+                if relation.tag != _q(PKG, 'Relationship') or len(relation):
+                    _fail('relationship_structure')
+                rid, kind, target = (relation.get(key) for key in ('Id', 'Type', 'Target'))
+                if (not rid or rid in rows or not kind or len(kind) > 512
+                        or any(ord(c) < 33 for c in rid + kind)):
+                    _fail('duplicate_or_invalid_relationship')
+                mode = relation.get('TargetMode')
+                if mode == 'External':
+                    _fail('external_relationship')
+                if mode not in (None, 'Internal'):
+                    _fail('relationship_mode')
+                resolved = _target(owner, target)
+                if resolved not in self.parts:
+                    _fail('relationship_target_missing')
+                rows[rid] = (kind, resolved)
+                lowered = kind.lower()
+                if any(marker in lowered for marker in ('vbaproject', 'vbadata')):
+                    self.macro = True
+                if any(marker in lowered for marker in ('oleobject', 'control', 'activex', 'vba',
+                                                        'digital-signature', 'afchunk', 'customui')):
+                    self.active = True
+                    self.limitations.add('active_embedded_content_and_signatures_not_evaluated')
+            self.relationships[owner] = rows
+        office = [target for kind, target in self.relationships.get('', {}).values()
+                  if kind == R + '/officeDocument']
+        if office != ['word/document.xml']:
+            _fail('main_root_relationship')
+        if self.format not in MACRO_FORMATS and self.macro:
+            _fail('macro_profile_mismatch')
+        vba_links = [(owner, target) for owner, rows in self.relationships.items()
+                     for kind, target in rows.values() if kind == VBA_REL]
+        if (self.vba_parts or vba_links) and (
+                len(self.vba_parts) != 1 or len(vba_links) != 1
+                or vba_links[0][0] != 'word/document.xml'
+                or vba_links[0][1] not in self.vba_parts):
+            _fail('macro_project_relationship_mismatch')
+        if self.format in MACRO_FORMATS:
+            self.limitations.add('vba_macros_opaque_never_executed_read_only')
+        for name, root in self.xml.items():
+            for node in root.iter():
+                if node.tag in {_q(W, n) for n in ('fldChar', 'instrText', 'fldSimple')}:
+                    self.limitations.add('cached_field_results_inert_not_evaluated')
+                if node.tag in {_q(W, n) for n in ('altChunk', 'object', 'control')}:
+                    self.active = True
+                    self.limitations.add('active_embedded_content_and_signatures_not_evaluated')
+            if name != 'word/document.xml' and name.startswith('word/') and name.endswith('.xml'):
+                if posixpath.basename(name).startswith(('header', 'footer', 'footnote', 'endnote', 'comment')):
+                    self.limitations.add('headers_footers_notes_and_comments_not_read')
+
+
+def _rewrite(data, changes):
+    output = BytesIO()
+    with zipfile.ZipFile(BytesIO(data)) as source, zipfile.ZipFile(output, 'w') as target:
+        target.comment = source.comment
+        for info in source.infolist():
+            target.writestr(info, changes.get(info.filename, source.read(info)))
+    result = output.getvalue()
+    if len(result) > MAX_BYTES:
+        _fail('output_limit')
+    return result
+
+
+def _switch_main(raw, original, target):
+    # The validated exact attribute value is ASCII. Change only that value; all
+    # namespace prefixes, comments, whitespace and unselected CT bytes survive.
+    pattern = re.compile(rb'(\bContentType\s*=\s*)([\x22\x27])' + re.escape(original.encode('ascii')) + rb'\2')
+    changed, count = pattern.subn(lambda m: m[1] + m[2] + target.encode('ascii') + m[2], raw)
+    if count != 1:
+        _fail('unsupported_content_type_lexical_form')
+    return changed
+
+
+def _preserved(original, rendered, selected):
+    with zipfile.ZipFile(BytesIO(original)) as before, zipfile.ZipFile(BytesIO(rendered)) as after:
+        left, right = before.infolist(), after.infolist()
+        if (before.comment != after.comment or len(left) != len(right)
+                or any(_metadata(a) != _metadata(b) for a, b in zip(left, right))):
+            _fail('unsupported_zip_metadata')
+        for info in left:
+            if info.filename not in selected and before.read(info) != after.read(info.filename):
+                _fail('unselected_part_changed')
+
+
+def render(content, format, *, structured=False, checkpoint=None):
+    """Create a genuine native plain/structured DOCX or DOTX OPC package."""
+    _format(format)
+    if format in MACRO_FORMATS:
+        _fail('unsupported_macro_create')
+    from hermes_cli.friday_workspace_docx import render as render_docx
+    _tick(checkpoint)
+    data = render_docx(content, structured=structured)
+    _tick(checkpoint)
+    if format == 'dotx':
+        with zipfile.ZipFile(BytesIO(data)) as source:
+            types = source.read('[Content_Types].xml')
+        changed = _switch_main(types, MAIN_TYPES['docx'], MAIN_TYPES['dotx'])
+        result = _rewrite(data, {'[Content_Types].xml': changed})
+        _preserved(data, result, {'[Content_Types].xml'})
+        data = result
+    _Package(data, format, checkpoint)
+    return data
+
+
+def render_edit(data, old, new, format, *, checkpoint=None):
+    """One unique literal body/table paragraph edit into a preserving new copy."""
+    _format(format)
+    if format in MACRO_FORMATS:
+        _fail('unsupported_macro_edit')
+    package = _Package(data, format, checkpoint)
+    if package.active:
+        _fail('unsupported_active_or_signed_edit')
+    from hermes_cli.friday_workspace_docx import render_edit as edit_docx, _EditRefused
+    temporary = data
+    if format == 'dotx':
+        changed = _switch_main(package.parts['[Content_Types].xml'], MAIN_TYPES['dotx'], MAIN_TYPES['docx'])
+        temporary = _rewrite(data, {'[Content_Types].xml': changed})
+    _tick(checkpoint)
+    try:
+        rendered = edit_docx(temporary, old, new)
+    except _EditRefused as error:
+        _fail(str(error))
+    _tick(checkpoint)
+    if format == 'dotx':
+        rendered = _rewrite(rendered, {'[Content_Types].xml': package.parts['[Content_Types].xml']})
+    _Package(rendered, format, checkpoint)
+    _preserved(data, rendered, {'word/document.xml'})
+    _tick(checkpoint)
+    return rendered
+
+
+def _encoded(value):
+    return (json.dumps(value, ensure_ascii=False, separators=(',', ':'))
+            .replace('\u0085', r'\u0085').replace('\u2028', r'\u2028').replace('\u2029', r'\u2029'))
+
+
+def extract(data, format, *, checkpoint=None):
+    """Return only inert stored text plus explicit trusted coverage metadata."""
+    package = _Package(data, format, checkpoint)
+    rows = []
+    output_bytes = 0
+    paragraphs = tables = 0
+    parents = {child: parent for parent in package.body.iter() for child in parent}
+    for node in package.body.iter():
+        _tick(checkpoint)
+        if node.tag == _q(W, 'tbl'):
+            tables += 1
+        if node.tag != _q(W, 'p'):
+            continue
+        paragraphs += 1
+        if paragraphs > MAX_PARAGRAPHS:
+            _fail('paragraph_count_limit')
+        guide = {child for ruby in node.iter(_q(W, 'rt')) for child in ruby.iter()}
+        value = ''.join((item.text or '') if item.tag == _q(W, 't')
+                        else '\t' if item.tag == _q(W, 'tab')
+                        else '\n' if item.tag in (_q(W, 'br'), _q(W, 'cr')) else ''
+                        for item in node.iter() if item not in guide)
+        # Nested paragraphs (e.g. text boxes) do not become text in their outer
+        # paragraph as well. Their distinct placement is not a rendered view.
+        nested = any(child is not node and child.tag == _q(W, 'p') for child in node.iter())
+        if nested:
+            _fail('unsupported_nested_paragraph')
+        parent = parents.get(node)
+        record = {'number': paragraphs, 'role': 'table_cell' if parent is not None
+                  and parent.tag == _q(W, 'tc') else 'body', 'text': value}
+        line = '[PARAGRAPH ' + _encoded(record) + ']'
+        output_bytes += len(line.encode('utf-8')) + 1
+        if output_bytes > 900_000:
+            _fail('extracted_text_limit')
+        rows.append(line)
+    metadata = {'format': format, 'native_container': True,
+                'view': 'inert_stored_word_text', 'paragraphs': paragraphs, 'tables': tables,
+                'macro_enabled_profile': format in MACRO_FORMATS,
+                'macro_project_present': bool(package.vba_parts),
+                'macros_executed': False, 'fields_evaluated': False,
+                'coverage': 'stored_body_table_text_only; macros_fields_images_layout_and_external_content_not_evaluated',
+                'limitations': sorted(package.limitations)}
+    result = '[DOCUMENT ' + _encoded(metadata) + ']'
+    if rows:
+        result += '\n' + '\n'.join(rows)
+    if len(result.encode('utf-8')) > MAX_BYTES:
+        _fail('extracted_text_limit')
+    _tick(checkpoint)
+    return DocumentText(result, metadata)
