+MAX_INPUT = 1_000_000
+MAX_DIRECTORY = 256
+MAX_PIECES = 4096
+MAX_CP = 400_000
+MAX_TEXT = 1_000_000
+FREE = 0xFFFFFFFF
+END = 0xFFFFFFFE
+FAT = 0xFFFFFFFD
+DIF = 0xFFFFFFFC
+WORD_CLSID = bytes.fromhex('0609020000000000c000000000000046')
+STREAMS = frozenset(('WordDocument', '0Table', '1Table', 'Data', '\x01CompObj', '\x05SummaryInformation',
+                     '\x05DocumentSummaryInformation'))
