+    return dict(cell=f'{letters}{row+1}',row=row+1,column=column+1,
+                type=kind,value=value,xf_index=xf,**extra)
+
+
+def _boolerr(value,iserr):
+    if iserr == 0 and value in (0,1): return 'boolean',bool(value)
+    if iserr == 1 and value in _ERROR_VALUES: return 'error',_ERROR_VALUES[value]
+    _fail('xls_boolean_or_error')
+
