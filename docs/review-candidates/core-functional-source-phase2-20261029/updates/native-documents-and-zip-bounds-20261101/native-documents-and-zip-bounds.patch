+"""Own-workspace ODF profiles, create-only writes and exact source CAS."""
+import hashlib
+import json
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_odt import _spec
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_odf_profiles import ODFProfileError, render, render_edit
+
+
+def _destination(leaf, path, format):
+    if (not isinstance(format, str) or format not in ('odt', 'ott', 'fodt')
+            or not isinstance(path, str) or Path(path).suffix.lower() != '.' + format
+            or Path(path).name != leaf):
+        raise ScopeDenied()
+
+
+def create(cap, fd, leaf, path, content, *, format, structured=False):
+    _check_parent(cap, fd, path)
+    _destination(leaf, path, format)
+    try:
+        data = render(content, format, structured=structured, checkpoint=lambda: check(cap))
+    except ODFProfileError as error:
+        return json.dumps({'success': False, 'error': 'document_create_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
+    return _create_bytes(cap, fd, leaf, path, data, output_format=format)
+
+
+def create_edit(cap, fd, leaf, path, content, *, format):
+    from hermes_cli.friday_user_scope import workspace_document
+
+    _check_parent(cap, fd, path)
+    _destination(leaf, path, format)
+    spec = _spec(content)
+    raw = spec['source']
+    if not isinstance(raw, str) or not raw or '\x00' in raw:
+        raise ScopeDenied()
+    root = cap.home / 'workspace'
+    source = Path(raw)
+    if not source.is_absolute():
+        source = root / source
+    try:
+        relative = source.relative_to(root)
+    except ValueError:
+        raise ScopeDenied() from None
+    if (not relative.parts or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+            or source.suffix.lower() != '.' + format or relative.as_posix() == path):
+        raise ScopeDenied()
+    data, _, identity = workspace_document(str(source), with_identity=True)
+    try:
+        rendered = render_edit(data, spec['old_text'], spec['new_text'], format,
+                               checkpoint=lambda: check(cap))
+    except ODFProfileError as error:
+        return json.dumps({'success': False, 'error': 'document_edit_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
+
+    def verify():
+        check(cap)
+        current, _, version = workspace_document(str(source), with_identity=True)
+        if current != data or version != identity:
+            raise ScopeDenied()
+
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                     output_format=format, verify_source=verify))
+    if result.get('success'):
+        result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(data).hexdigest(),
+                      replacements=1, source_unchanged=True, unchanged_parts_preserved=True,
+                      edit_mode='exact_text')
+        if format == 'fodt':
+            result['unselected_source_bytes_preserved'] = True
+    return json.dumps(result, ensure_ascii=False)
