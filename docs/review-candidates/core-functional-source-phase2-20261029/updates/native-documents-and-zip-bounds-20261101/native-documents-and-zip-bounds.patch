+    """Read bounded immutable members, then guard ALL XML before base parsers.
+
+    This first phase performs no XML tree construction. Manifest-declared XML
+    resources are covered even without an XML suffix; suffix checks ignore case.
+    Native package semantic validation remains owned by DocumentPackage.
+    """
+    if not isinstance(data, bytes) or len(data) > MAX_BYTES:
+        _fail('input_limit')
+    _tick(checkpoint)
+    parts = {}
+    seen = set()
+    total = 0
+    try:
+        with zipfile.ZipFile(io.BytesIO(data)) as archive:
+            infos = archive.infolist()
+            if not infos or len(infos) > 512:
+                _fail('package_member_limit')
+            for info in infos:
+                _tick(checkpoint)
+                name = info.filename
+                key = name.rstrip('/')
+                if (info.orig_filename != name or not key or '\\' in name
+                        or name.startswith('/') or '\x00' in name
+                        or any(ord(c) < 32 for c in name) or ':' in name or '%' in name
+                        or any(part in ('', '.', '..') for part in key.split('/'))
+                        or key.casefold() in seen):
+                    _fail('unsafe_or_duplicate_member')
+                seen.add(key.casefold())
+                mode = info.external_attr >> 16
+                if stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFDIR) or info.flag_bits & 1:
+                    _fail('encrypted_or_special_member')
+                if info.compress_type not in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED):
+                    _fail('unsupported_compression')
+                total += info.file_size
+                if (info.file_size > 2_000_000 or total > 8_000_000
+                        or info.file_size > max(1, info.compress_size) * 200):
+                    _fail('package_expansion_limit')
+                if info.is_dir():
+                    if info.file_size:
+                        _fail('nonempty_directory_member')
+                    continue
+                from tools.scoped_zip import read_zip_member, ZipMemberLimitError
+                try:
+                    value = read_zip_member(archive, data, info, 2_000_000)
+                except ZipMemberLimitError:
+                    _fail('package_member_limit')
+                if len(value) != info.file_size or len(value) > 2_000_000:
+                    _fail('package_member_limit')
+                parts[name] = value
+    except (zipfile.BadZipFile, UnicodeError, zlib.error, NotImplementedError, EOFError):
+        _fail('malformed_package')
+    xml_names = {name for name in parts if name.lower().endswith(('.xml', '.rels'))}
+    manifest_name = 'META-INF/manifest.xml'
+    checked = set()
+    if manifest_name in parts:
+        entries = _preflight_xml(parts[manifest_name], checkpoint)
+        checked.add(manifest_name)
+        for name, media in entries:
+            media = media.split(';', 1)[0].strip().lower()
+            if media in ('text/xml', 'application/xml') or media.endswith('+xml'):
+                if name in parts:
+                    xml_names.add(name)
+    if sum(len(parts[name]) for name in xml_names) > 4_000_000:
+        _fail('xml_size_limit')
+    for name in sorted(xml_names - checked):
+        _preflight_xml(parts[name], checkpoint)
+    return parts, xml_names
+
+
+def _document_package(data, format, checkpoint=None):
+    _preflight_package(data, checkpoint)
+    return odt.DocumentPackage(data, format, checkpoint)
+
+
+def _editable_package(data, format, checkpoint):
+    pkg = _document_package(data, format, checkpoint)
+    manifest = pkg.xml['META-INF/manifest.xml']
+    xml_names = {name for name in pkg.parts if name.lower().endswith(('.xml', '.rels'))}
+    for entry in manifest:
+        media = entry.get(q(odt.M, 'media-type'), '').split(';', 1)[0].strip().lower()
+        if media in ('text/xml', 'application/xml') or media.endswith('+xml'):
+            name = entry.get(q(odt.M, 'full-path'))
+            if name in pkg.parts:
+                xml_names.add(name)
+    total = sum(len(pkg.parts[name]) for name in pkg.xml)
+    for name in sorted(xml_names - set(pkg.xml)):
+        total += len(pkg.parts[name])
+        if total > 4_000_000:
+            _fail('xml_size_limit')
+        pkg.xml[name] = _root(pkg.parts[name], checkpoint)
+    for root in pkg.xml.values():
+        _static_xml(root, checkpoint)
+    odt._editable_package(pkg)
+    return pkg
+
+
+def _static_xml(root, checkpoint):
+    """Reject active resources and URI bases in every parsed XML container."""
+    for index, node in enumerate(root.iter()):
+        if index % 64 == 0:
+            _tick(checkpoint)
+        local = node.tag.rsplit('}', 1)[-1]
+        if local in {'applet', 'floating-frame'}:
+            _fail('active_or_embedded_content')
+        for attr, value in node.attrib.items():
+            if attr == '{http://www.w3.org/XML/1998/namespace}base':
+                _fail('external_or_unresolved_link')
+            if attr.rsplit('}', 1)[-1] == 'may-script' and value not in ('false', '0'):
+                _fail('active_or_embedded_content')
+
+
+def _root(raw, checkpoint=None):
+    if not isinstance(raw, bytes) or len(raw) > MAX_BYTES:
+        _fail('input_limit')
+    _tick(checkpoint)
+    _preflight_xml(raw, checkpoint)
+    try:
+        root = xml_root(raw)
+    except PresentationError as error:
+        _fail(str(error))
+    except (ET.ParseError, UnicodeError, ValueError):
+        _fail('malformed_xml')
+    stack = [(root, 1)]
+    count = 0
+    while stack:
+        node, depth = stack.pop()
+        count += 1
+        if count % 64 == 0:
+            _tick(checkpoint)
+        if count > MAX_NODES or depth > MAX_DEPTH or len(node.attrib) > 64:
+            _fail('xml_structure_limit')
+        stack.extend((child, depth + 1) for child in node)
+    return root
+
+
+def _sections(raw, checkpoint=None):
+    """Lexical immediate children plus complete root namespace bindings."""
+    parser = expat.ParserCreate(namespace_separator='}')
+    frames = []
+    namespaces = {}
+    sections = []
+    root_info = []
+    nodes = 0
+
+    def namespace(prefix, uri):
+        if not frames:
+            namespaces[prefix or ''] = uri
+
+    def start(name, attrs):
+        nonlocal nodes
+        nodes += 1
+        if nodes % 64 == 0:
+            _tick(checkpoint)
+        if nodes > MAX_NODES or len(frames) >= MAX_DEPTH or len(attrs) > 64:
+            _fail('xml_structure_limit')
+        begin = parser.CurrentByteIndex
+        end = odt._tag_end(raw, begin)
+        frames.append((name, begin, end, raw[begin:end].rstrip().endswith(b'/>')))
+        if len(frames) == 1:
+            root_info.append((name, attrs))
+
+    def end(name):
+        tag, begin, edge, empty = frames[-1]
+        finish = edge if empty else odt._tag_end(raw, parser.CurrentByteIndex)
+        if len(frames) == 2:
+            sections.append((tag, raw[begin:finish]))
+        frames.pop()
+
+    def refuse(*args):
+        _fail('unsupported_xml_construct')
+
+    parser.StartNamespaceDeclHandler = namespace
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    try:
+        parser.Parse(raw, True)
+    except (expat.ExpatError, odt.ODTError):
+        _fail('malformed_xml')
+    return root_info[0], namespaces, sections
+
+
+def _rewrite_zip(data, replacements, checkpoint=None):
+    out = io.BytesIO()
+    with zipfile.ZipFile(io.BytesIO(data)) as source, zipfile.ZipFile(out, 'w') as target:
+        target.comment = source.comment
+        for info in source.infolist():
+            _tick(checkpoint)
+            value = replacements.get(info.filename)
+            if value is None:
+                value = source.read(info)
+            target.writestr(copy.copy(info), value)
+            if out.tell() > MAX_BYTES:
+                _fail('output_limit')
+    result = out.getvalue()
+    if len(result) > MAX_BYTES:
+        _fail('output_limit')
+    _tick(checkpoint)
+    return result
+
+
+def _template(data, checkpoint):
+    pkg = _document_package(data, 'odt', checkpoint)
+    raw = pkg.parts['META-INF/manifest.xml']
+    # The native creator emits exactly one document MIME in the root entry.
+    # Refuse an unexpected creator shape instead of changing unrelated values.
+    before = odt.MIMES['odt'].encode('ascii')
+    if raw.count(before) != 1:
+        _fail('unsupported_manifest_profile_switch')
+    changed = raw.replace(before, odt.MIMES['ott'].encode('ascii'), 1)
+    result = _rewrite_zip(data, {'mimetype': odt.MIMES['ott'].encode('ascii'),
+                                'META-INF/manifest.xml': changed}, checkpoint)
+    _document_package(result, 'ott', checkpoint)
+    return result
+
+
+def _flatten_created(data, checkpoint):
+    """Only creator output is merged; arbitrary package conversion is absent."""
+    pkg = _document_package(data, 'odt', checkpoint)
+    allowed_parts = {'mimetype', 'content.xml', 'styles.xml', 'meta.xml',
+                     'settings.xml', 'META-INF/manifest.xml'}
+    if set(pkg.parts) - allowed_parts:
+        _fail('flat_resources_unsupported')
+    order = ['meta', 'settings', 'scripts', 'font-face-decls', 'styles',
+             'automatic-styles', 'master-styles', 'body']
+    sections = {}
+    namespaces = {}
+    version = None
+    for part in ('meta.xml', 'settings.xml', 'styles.xml', 'content.xml'):
+        if part not in pkg.parts:
+            continue
+        _tick(checkpoint)
+        (name, attrs), bindings, children = _sections(pkg.parts[part], checkpoint)
+        expected = odt.O + '}document-' + part[:-4]
+        if name != expected or set(attrs) != {odt.O + '}version'}:
+            _fail('unsupported_flat_merge')
+        if version is not None and attrs[odt.O + '}version'] != version:
+            _fail('conflicting_flat_version')
+        version = attrs[odt.O + '}version']
+        for prefix, uri in bindings.items():
+            if prefix in namespaces and namespaces[prefix] != uri:
+                _fail('conflicting_flat_namespace')
+            namespaces[prefix] = uri
+        for tag, lexical in children:
+            if tag not in {odt.O + '}' + item for item in order} or tag in sections:
+                _fail('conflicting_flat_section')
+            sections[tag] = lexical
+    if namespaces.get('office') != odt.O or odt.O + '}body' not in sections:
+        _fail('unsupported_flat_merge')
+    declarations = ''.join(' xmlns' + (':' + prefix if prefix else '') + '=' + quoteattr(uri)
+                           for prefix, uri in sorted(namespaces.items()))
+    opening = ('<?xml version="1.0" encoding="utf-8"?>\n<office:document' + declarations
+               + ' office:version=' + quoteattr(version)
+               + ' office:mimetype=' + quoteattr(MIMES['fodt']) + '>').encode('utf-8')
+    result = opening + b''.join(sections[odt.O + '}' + name] for name in order
+                               if odt.O + '}' + name in sections) + b'</office:document>'
+    if len(result) > MAX_BYTES:
+        _fail('output_limit')
+    _flat_package(result, checkpoint)
+    return result
+
+
+class _Flat:
+    pass
+
+
+def _flat_package(data, checkpoint=None):
+    root = _root(data, checkpoint)
+    if (root.tag != q(odt.O, 'document') or root.get(q(odt.O, 'mimetype')) != MIMES['fodt']
+            or root.get(q(odt.O, 'version')) not in ('1.0', '1.1', '1.2', '1.3')):
+        _fail('not_native_fodt')
+    bodies = root.findall(q(odt.O, 'body'))
+    if len(bodies) != 1 or len(bodies[0]) != 1 or bodies[0][0].tag != q(odt.O, 'text'):
+        _fail('not_native_fodt')
+    singletons = {'meta', 'settings', 'scripts', 'font-face-decls', 'styles',
+                  'automatic-styles', 'master-styles', 'body'}
+    for local in singletons:
+        if len(root.findall(q(odt.O, local))) > 1:
+            _fail('conflicting_flat_section')
+    pkg = _Flat()
+    pkg.parts = {'document.xml': data}
+    pkg.xml = {'document.xml': root}
+    pkg.body = bodies[0][0]
+    pkg.unsupported = set()
+    pkg.checkpoint = checkpoint
+    _static_xml(root, checkpoint)
+    # Preserve opaque static namespaces/attributes; refuse resources or active
+    # constructs instead of dropping, evaluating or fetching them.
+    for index, node in enumerate(root.iter()):
+        if index % 64 == 0:
+            _tick(checkpoint)
+        local = node.tag.rsplit('}', 1)[-1]
+        if local in {'binary-data', 'object', 'object-ole', 'plugin', 'script',
+                     'event-listener', 'event-listeners', 'execute-macro'}:
+            _fail('active_or_embedded_flat_content')
+        for attr, value in node.attrib.items():
+            if attr == '{http://www.w3.org/XML/1998/namespace}base':
+                _fail('external_or_unresolved_link')
+            if attr.rsplit('}', 1)[-1] in {'href', 'src'} and value and not value.startswith('#'):
+                _fail('external_or_unresolved_link')
+    try:
+        odt._editable_package(pkg)
+        _sections(data, checkpoint)  # Also refuses processing instructions.
+    except odt.ODTError as error:
+        _fail(str(error))
+    return pkg
+
+
+def _lexical_text(piece, start, checkpoint):
+    """Decoded text plus source-byte boundaries for every XML character."""
+    source = piece.decode('utf-8')
+    chars = []
+    spans = []
+    index = byte = 0
+    while index < len(source):
+        if len(chars) % 1024 == 0:
+            _tick(checkpoint)
+        char = source[index]
+        if char == '&':
+            edge = source.find(';', index + 1)
+            if edge < 0 or edge - index > 32:
+                _fail('malformed_xml')
+            token = source[index:edge + 1]
+            value = ET.fromstring(('<r>' + token + '</r>').encode('utf-8')).text
+            size = len(token.encode('utf-8'))
+            index = edge + 1
+        elif char == '\r':
+            size = 2 if source[index:index + 2] == '\r\n' else 1
+            index += size
+            value = '\n'
+        else:
+            value = char
+            size = len(char.encode('utf-8'))
+            index += 1
+        chars.append(value)
+        spans.append((start + byte, start + byte + size))
+        byte += size
+    return ''.join(chars), spans
+
+
+def _flat_slots(raw, checkpoint):
+    """The existing literal-edit shape, extended to office:document."""
+    parser = expat.ParserCreate(namespace_separator='}')
+    stack = []
+    contexts = []
+    records = []
+    cursor = 0
+    in_body = False
+    characters = slots = nodes = 0
+    text_tags = {odt.T + '}' + name for name in ('p', 'h')}
+    space_tags = {odt.T + '}' + name for name in ('s', 'tab', 'line-break')}
+    parents = {odt.O + '}' + name for name in ('document', 'document-content', 'body', 'text')}
+    parents.update(odt.T + '}' + name for name in ('section', 'list', 'list-item', 'list-header'))
+    parents.update(odt.TB + '}' + name for name in ('table', 'table-row', 'table-cell',
+                   'table-header-rows', 'table-rows', 'table-row-group'))
+
+    def add(start, end, value, boundaries=None):
+        nonlocal characters, slots
+        if not value:
+            return
+        characters += len(value)
+        slots += 1
+        if characters > 900_000 or slots > 50_000:
+            _fail('document_text_limit')
+        record = contexts[-1]
+        record['chars'] += len(value)
+        if record['chars'] > odt.MAX_TEXT:
+            _fail('paragraph_text_limit')
+        profile = tuple(frame['attrs'] for frame in stack if frame['name'] == odt.T + '}span')
+        record['slots'].append((start, end, value, profile, boundaries))
+
+    def flush(end):
+        nonlocal cursor
+        if contexts and end > cursor:
+            piece = raw[cursor:end]
+            if b'<' in piece:
+                contexts[-1]['supported'] = False
+            else:
+                value, boundaries = _lexical_text(piece, cursor, checkpoint)
+                add(cursor, end, value, boundaries)
+        cursor = end
+
+    def start(name, attrs):
+        nonlocal cursor, in_body, nodes
+        nodes += 1
+        if nodes % 64 == 0:
+            _tick(checkpoint)
+        begin = parser.CurrentByteIndex
+        flush(begin)
+        end = odt._tag_end(raw, begin)
+        frame = {'name': name, 'attrs': tuple(sorted(attrs.items())),
+                 'empty': raw[begin:end].rstrip().endswith(b'/>')}
+        if name == odt.O + '}text':
+            in_body = True
+        if name in text_tags and in_body:
+            if len(records) >= odt.MAX_RECORDS:
+                _fail('record_count_limit')
+            if contexts:
+                contexts[-1]['supported'] = False
+            record = {'slots': [], 'chars': 0,
+                      'supported': all(p['name'] in parents for p in stack)}
+            contexts.append(record)
+            records.append(record)
+            frame['paragraph'] = True
+        elif contexts and name != odt.T + '}span' and name not in space_tags:
+            contexts[-1]['supported'] = False
+        if contexts and name in space_tags:
+            if not frame['empty']:
+                contexts[-1]['supported'] = False
+            if name == odt.T + '}s':
+                value = ' ' * odt._count(attrs.get(odt.T + '}c', '1'), odt.MAX_TEXT)
+                if set(attrs) - {odt.T + '}c'}:
+                    contexts[-1]['supported'] = False
+            else:
+                value = '\t' if name == odt.T + '}tab' else '\n'
+                if attrs:
+                    contexts[-1]['supported'] = False
+            add(begin, end, value)
+        stack.append(frame)
+        cursor = end
+
+    def end(name):
+        nonlocal cursor, in_body
+        frame = stack[-1]
+        if not frame['empty']:
+            flush(parser.CurrentByteIndex)
+            cursor = odt._tag_end(raw, parser.CurrentByteIndex)
+        if frame.get('paragraph'):
+            contexts.pop()
+        stack.pop()
+        if name == odt.O + '}text':
+            in_body = False
+
+    def refuse(*args):
+        _fail('unsupported_xml_construct')
+
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    parser.CommentHandler = lambda *args: contexts[-1].update(supported=False) if contexts else None
+    parser.StartCdataSectionHandler = lambda: contexts[-1].update(supported=False) if contexts else None
+    try:
+        parser.Parse(raw, True)
+    except (expat.ExpatError, ET.ParseError, UnicodeError):
+        _fail('malformed_xml')
+    for record in records:
+        record['text'] = ''.join(slot[2] for slot in record['slots'])
+    return records
+
+
+def _edit_xml(data, old, new, checkpoint):
+    old, new = odt._plain(old), odt._plain(new)
+    if not old or old == new:
+        _fail('invalid_replacement')
+    records = _flat_slots(data, checkpoint)
+    matches = []
+    for record in records:
+        _tick(checkpoint)
+        begin = record['text'].find(old)
+        while begin >= 0:
+            matches.append((record, begin))
+            if len(matches) > 1:
+                _fail('ambiguous_match')
+            begin = record['text'].find(old, begin + 1)
+    if not matches:
+        _fail('match_missing')
+    record, begin = matches[0]
+    if not record['supported']:
+        _fail('unsupported_paragraph_structure')
+    finish = begin + len(old)
+    selected = []
+    cursor = 0
+    for start, end, value, profile, boundaries in record['slots']:
+        edge = cursor + len(value)
+        if cursor < finish and edge > begin:
+            lo, hi = max(0, begin - cursor), min(len(value), finish - cursor)
+            if boundaries is not None:
+                start, end = boundaries[lo][0], boundaries[hi - 1][1]
+            elif lo != 0 or hi != len(value):
+                _fail('partial_whitespace_element')
+            selected.append((start, end, profile))
+        cursor = edge
+    if not selected or len({item[2] for item in selected}) != 1:
+        _fail('mixed_span_format')
+    result = data
+    for index in reversed(range(len(selected))):
+        start, end, _ = selected[index]
+        result = result[:start] + (odt._literal_xml(new) if index == 0 else b'') + result[end:]
+    if len(result) > MAX_BYTES:
+        _fail('output_limit')
+    expected = [item['text'] for item in records]
+    expected[records.index(record)] = record['text'][:begin] + new + record['text'][finish:]
+    if [item['text'] for item in _flat_slots(result, checkpoint)] != expected:
+        _fail('invalid_edit')
+    return result
+
+
+def render(content, format, structured=False, checkpoint=None):
+    _format(format)
+    _tick(checkpoint)
+    try:
+        data = create_odt(content, structured=structured, checkpoint=checkpoint)
+        if format == 'ott':
+            return _template(data, checkpoint)
+        if format == 'fodt':
+            return _flatten_created(data, checkpoint)
+        _document_package(data, 'odt', checkpoint)
+        return data
+    except (odt.ODTError, ODTCreateError) as error:
+        raise ODFProfileError(str(error)) from None
+
+
+def render_edit(data, old, new, format, checkpoint=None):
+    _format(format)
+    _tick(checkpoint)
+    try:
+        if format == 'fodt':
+            _flat_package(data, checkpoint)
+            result = _edit_xml(data, old, new, checkpoint)
+            _flat_package(result, checkpoint)
+            return result
+        pkg = _editable_package(data, format, checkpoint)
+        # One lexical splice engine for flat and ZIP profiles. No MIME/manifest
+        # normalization or unselected text/entity serialization is necessary.
+        content = _edit_xml(pkg.parts['content.xml'], old, new, checkpoint)
+        result = _rewrite_zip(data, {'content.xml': content}, checkpoint)
+        _document_package(result, format, checkpoint)
+        return result
+    except odt.ODTError as error:
+        raise ODFProfileError(str(error)) from None
+
+
+def extract(data, format, checkpoint=None):
+    _format(format)
+    _tick(checkpoint)
+    try:
+        if format != 'fodt':
+            _preflight_package(data, checkpoint)
+            return odt.extract_document(data, format, checkpoint=checkpoint)
+        pkg = _flat_package(data, checkpoint)
+        # The existing bounded semantic reader accepts a DocumentPackage. Build
+        # a safe ephemeral ODT view, retaining original flat XML on disk.
+        root_info, namespaces, sections = _sections(data, checkpoint)
+        body = [raw for name, raw in sections if name == odt.O + '}body']
+        if len(body) != 1:
+            _fail('not_native_fodt')
+        prefix = 'frwodfo'
+        while prefix in namespaces:
+            prefix += 'x'
+        declarations = ''.join(' xmlns' + (':' + p if p else '') + '=' + quoteattr(uri)
+                               for p, uri in sorted(namespaces.items()))
+        opening = ('<' + prefix + ':document-content xmlns:' + prefix + '=' + quoteattr(odt.O)
+                   + declarations + ' ' + prefix + ':version="1.3">').encode('utf-8')
+        content = opening + body[0] + ('</' + prefix + ':document-content>').encode('utf-8')
+        from tools.scoped_odt_create import _zip, _State, _noop
+        manifest = ('<manifest:manifest xmlns:manifest="' + odt.M + '">'
+                    '<manifest:file-entry manifest:full-path="/" manifest:media-type="' + MIMES['odt'] + '"/>'
+                    '<manifest:file-entry manifest:full-path="content.xml" manifest:media-type="text/xml"/>'
+                    '</manifest:manifest>').encode('utf-8')
+        view = _zip([('mimetype', MIMES['odt'].encode('ascii')), ('content.xml', content),
+                     ('META-INF/manifest.xml', manifest)], _State(checkpoint or _noop))
+        _preflight_package(view, checkpoint)
+        result = odt.extract_document(view, 'odt', checkpoint=checkpoint)
+        metadata = dict(result.extraction_metadata, format='fodt',
+                        native_container=True, source_representation='flat_xml',
+                        preserved_source_sections=True)
+        lines = str(result).split('\n')
+        lines[0] = '[DOCUMENT ' + odt.encoded(metadata) + ']'
+        return odt.DocumentText('\n'.join(lines), metadata)
+    except (odt.ODTError, ODTCreateError) as error:
+        raise ODFProfileError(str(error)) from None
