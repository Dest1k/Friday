+class XLSExtractionError(BinarySpreadsheetError):
+    """Fixed code refusal for the public XLS extractor."""
+
+
+class _Text(str):
+    def __new__(cls, value, metadata):
+        obj = super().__new__(cls, value)
+        obj.extraction_metadata = metadata
+        return obj
+
+
+def _records(data):
+    out=[]; at=0
+    while at < len(data):
+        if len(out) >= MAX_RECORDS:
+            _fail('biff_record_limit')
+        if len(data)-at < 4:
+            _fail('biff_truncated_record')
+        kind,size=struct.unpack_from('<HH',data,at)
+        # A Workbook stream may end in zero-filled unused bytes after its EOF.
+        if kind == size == 0:
+            if any(data[at:]): _fail('biff_nonzero_tail')
+            break
+        if size > 8224 or at+4+size > len(data):
+            _fail('biff_record_size')
+        payload=data[at+4:at+4+size]
+        if kind == 0x002F: _fail('xls_encrypted')
+        if kind in _ACTIVE: _fail('xls_active_or_external_record')
+        if kind == 0x003C: _fail('xls_continuation_unsupported')
+        out.append((at,kind,payload)); at += 4+size
+    if not out: _fail('biff_empty')
+    return out
+
+
+def _bof(kind,payload,doctype):
+    if (kind != 0x0809 or len(payload) != 16
+            or _u16(payload,0) != 0x0600 or _u16(payload,2) != doctype):
+        _fail('xls_biff8_substream_required')
+
+
+def _unicode(data, at=0, *, short=False, rich=False):
+    width=1 if short else 2
+    if len(data)-at < width+1: _fail('xls_string_header')
+    count=data[at] if short else _u16(data,at)
+    flags=data[at+width]; at += width+1
+    if flags & ~(0x0D if rich else 0x01): _fail('xls_string_flags')
+    runs=ext=0
+    if flags & 8:
+        if len(data)-at < 2: _fail('xls_string_header')
+        runs=_u16(data,at); at+=2
+    if flags & 4:
+        if len(data)-at < 4: _fail('xls_string_header')
+        ext=_u32(data,at); at+=4
+    size=count*(2 if flags&1 else 1)
+    if count>MAX_STRING or size+runs*4+ext>len(data)-at:
+        _fail('xls_string_size')
+    try:
+        value=data[at:at+size].decode('utf-16le' if flags&1 else 'latin-1')
+    except UnicodeError:
+        _fail('xls_string_encoding')
+    # NUL/surrogate text is not a valid XLS cell string. Compressed BIFF8
+    # characters are Unicode low bytes, not a locale/codepage decoding.
+    if '\0' in value: _fail('xls_string_nul')
+    at += size
+    if runs:
+        last=-1
+        for pos in range(at,at+runs*4,4):
+            index=_u16(data,pos)
+            if index <= last or index > count: _fail('xls_rich_run_bounds')
+            last=index
+    return value,at+runs*4+ext
+
+
+def _number(data):
+    value=struct.unpack('<d',data)[0]
+    if not math.isfinite(value): _fail('xls_nonfinite_number')
+    return value
+
+
+def _rk(data):
+    value=_u32(data,0)
+    if value & 2:
+        result=struct.unpack('<i',struct.pack('<I',value))[0] >> 2
+    else:
+        result=_number(b'\0'*4+struct.pack('<I',value & 0xFFFFFFFC))
+    return result/100 if value&1 else result
+
+
+def _cell(row,column,xf,kind,value,**extra):
+    if not 0<=row<65536 or not 0<=column<256: _fail('xls_cell_bounds')
+    col=column+1; letters=''
