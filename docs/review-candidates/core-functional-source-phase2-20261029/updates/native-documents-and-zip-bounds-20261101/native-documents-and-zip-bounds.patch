+    parsers auto-detect the wide encoding. Reject that ambiguity explicitly.
+    The parser stops at a DOCTYPE event before processing its internal subset.
+    """
+    if not isinstance(raw, bytes) or len(raw) > MAX_BYTES:
+        _fail('xml_size_limit')
+    _tick(checkpoint)
+    if b'\x00' in raw:
+        _fail('unsupported_xml_encoding')
