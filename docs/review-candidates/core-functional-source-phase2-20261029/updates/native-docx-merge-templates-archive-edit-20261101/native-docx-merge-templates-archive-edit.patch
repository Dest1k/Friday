+"""Pure bounded OPC merge for compatible inert DOCX body content.
+
+Both sources must have byte-identical shared parts and non-image relationships.
+This includes styles, numbering definitions, settings, metadata and theme. Only
+paragraphs/tables, ordinary run formatting and DrawingML inline PNG/JPEG pictures
+are supported. Numbering *use*, section breaks, headers/footers, notes, bookmarks,
+fields, revisions, unknown markup and namespace-sensitive main markup refuse.
+The final section properties must match exactly. This continuous-body merge does
+not introduce a page break. Source one is authoritative for shared package bytes;
+only its main XML, main relationships and content types may be reserialized.
+All source-two body nodes are copied once in order; image relationships, media
+names and picture IDs are remapped. No document library roundtrip or disk I/O.
+"""
+from __future__ import annotations
+
+from copy import copy, deepcopy
+from io import BytesIO
+import posixpath
+import re
+import struct
+import zipfile
+import zlib
+from xml.etree import ElementTree as ET
