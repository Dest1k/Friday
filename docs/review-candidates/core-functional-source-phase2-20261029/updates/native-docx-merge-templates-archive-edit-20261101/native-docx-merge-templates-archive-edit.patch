+def _style_numbering(styles, used):
+    used = {sid:set(kinds) for sid,kinds in used.items()}
+    rows = {}
+    defaults_by_type = {}
+    if styles is not None:
+        # Raw shared style parts keep their namespace declarations/attributes.
+        # Conditional element wrappers can select a different default style or
+        # inheritance chain in Office, so this bounded merger never interprets
+        # them as an empty/non-numbered profile.
+        allowed_root = {_q(W, n) for n in ('docDefaults', 'latentStyles', 'style')}
+        if (any(node.tag not in allowed_root for node in styles)
+                or any(sum(node.tag == _q(W, name) for node in styles) > 1
+                       for name in ('docDefaults', 'latentStyles'))
+                or any(_split(node.tag)[0] ==
+                       'http://schemas.openxmlformats.org/markup-compatibility/2006'
+                       for node in styles.iter())):
+            _fail('unsupported_style_profile')
+        allowed_style = {_q(W, n) for n in (
+            'name aliases basedOn next link autoRedefine hidden uiPriority '
+            'semiHidden unhideWhenUsed qFormat locked personal personalCompose '
+            'personalReply rsid pPr rPr tblPr trPr tcPr tblStylePr').split()}
+        for node in styles:
+            if node.tag == _q(W, 'style'):
+                if any(child.tag not in allowed_style for child in node):
+                    _fail('unsupported_style_profile')
+                sid = node.get(_q(W, 'styleId'))
+                if not sid or sid in rows: _fail('unsupported_style_profile')
+                rows[sid] = node
+                kind = node.get(_q(W, 'type'))
+                if node.get(_q(W, 'default')) in ('1', 'true', 'on'):
+                    if kind in defaults_by_type: _fail('unsupported_style_profile')
+                    defaults_by_type[kind] = sid
+        defaults = styles.find(_q(W, 'docDefaults'))
+        if defaults is not None and defaults.find('.//' + _q(W, 'numPr')) is not None:
+            _fail('unsupported_numbering_use')
+    for kind, sid in defaults_by_type.items():
+        used.setdefault(sid, set()).add(kind)
+    seen = set()
+    active = set()
+    def visit(sid, *, linked=False):
+        # Reciprocal paragraph/character links are normal Word profiles;
+        # inheritance (basedOn) cycles remain an explicit refusal.
+        if sid in active:
+            if linked: return
+            _fail('unsupported_style_profile')
+        if sid in seen: return
+        if len(active) >= 128:
+            _fail('style_inheritance_limit')
+        node = rows.get(sid)
+        if node is None: _fail('unsupported_style_reference')
+        active.add(sid)
+        if node.find('.//' + _q(W, 'numPr')) is not None:
+            _fail('unsupported_numbering_use')
+        for key in ('basedOn', 'link'):
+            ref = node.find(_q(W, key))
+            if ref is not None:
+                target = ref.get(_q(W, 'val'))
+                if not target: _fail('unsupported_style_reference')
+                targetnode = rows.get(target)
+                if targetnode is None: _fail('unsupported_style_reference')
+                if key == 'basedOn' and targetnode.get(_q(W,'type')) != node.get(_q(W,'type')):
+                    _fail('unsupported_style_reference')
+                visit(target, linked=key == 'link')
+        active.remove(sid)
+        seen.add(sid)
+    for sid, kinds in used.items():
+        if sid not in rows or rows[sid].get(_q(W, 'type')) not in kinds:
+            _fail('unsupported_style_reference')
+        visit(sid)
