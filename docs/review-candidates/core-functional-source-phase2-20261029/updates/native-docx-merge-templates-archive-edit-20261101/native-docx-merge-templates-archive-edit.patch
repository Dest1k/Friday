+"""Two own-workspace DOCX sources into one NEW native DOCX, in requested order.
+
+Both source identities and complete bytes are checked before and after the
+existing atomic no-replace publisher. Post-publication uncertainty is retained.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_docx_merge import MergeError, merge
+
+
+def _spec(content):
+    if not isinstance(content, str) or len(content) > 16_384:
+        raise ScopeDenied()
+
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ScopeDenied()
+            result[key] = value
+        return result
+
+    try:
+        value = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    if not isinstance(value, dict) or set(value) != {'sources'}:
+        raise ScopeDenied()
+    sources = value['sources']
+    if not isinstance(sources, list) or len(sources) != 2:
+        raise ScopeDenied()
+    return sources
+
+
+def _source(root, raw, destination):
+    if not isinstance(raw, str) or not raw or len(raw) > 4096 or '\x00' in raw:
+        raise ScopeDenied()
+    source = Path(raw)
+    if not source.is_absolute():
+        source = root / source
+    try:
+        relative = source.relative_to(root)
+    except ValueError:
+        raise ScopeDenied() from None
+    if (not relative.parts or any(part in ('.', '..') or part.startswith('.')
+                                  for part in relative.parts)
+            or source.suffix.lower() != '.docx'
+            or relative.as_posix() == destination):
+        raise ScopeDenied()
+    return source, relative.as_posix()
+
+
+def create(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import workspace_document
+
+    _check_parent(cap, fd, path)
+    if (not isinstance(path, str) or Path(path).suffix.lower() != '.docx'
+            or Path(path).name != leaf):
+        raise ScopeDenied()
+    root = cap.home / 'workspace'
+    sources = [_source(root, raw, path) for raw in _spec(content)]
+    if sources[0][1] == sources[1][1]:
+        raise ScopeDenied()
+    snapshots = []
+    for source, relative in sources:
+        check(cap)
+        data, _, identity = workspace_document(str(source), with_identity=True)
+        snapshots.append((source, relative, data, identity))
+    # Lexically distinct names cannot grant two views of the same source inode.
+    if snapshots[0][3][:2] == snapshots[1][3][:2]:
+        raise ScopeDenied()
+    try:
+        rendered = merge(snapshots[0][2], snapshots[1][2],
+                         checkpoint=lambda: check(cap))
+    except MergeError as error:
+        return json.dumps({'success': False, 'error': 'document_merge_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
+
+    def verify():
+        for source, _, original, identity in snapshots:
+            check(cap)
+            current, _, version = workspace_document(str(source), with_identity=True)
+            if current != original or version != identity:
+                raise ScopeDenied()
+        check(cap)
+
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                     output_format='docx', verify_source=verify))
+    if result.get('success'):
+        result.update(merge_mode='native_two_docx',
+                      sources=[relative for _, relative, _, _ in snapshots],
+                      source_sha256=[hashlib.sha256(data).hexdigest()
+                                     for _, _, data, _ in snapshots],
+                      sources_unchanged=True, source_order_preserved=True,
+                      coverage='supported_body_paragraphs_tables_inline_images',
+                      office_rendering_evaluated=False)
+    return json.dumps(result, ensure_ascii=False)
