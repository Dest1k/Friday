--- /dev/null
+++ b/tools/scoped_odt.py
@@ -0,0 +1,572 @@
+"""Bounded native OpenDocument text views and preserving literal edits.
+
+Immutable ZIP/XML only: no renderer, archive extraction, URL lookup, macro or
+field evaluation. The established presentation package guard bounds the same
+ODF container; this module owns only text-document semantics.
+"""
+from __future__ import annotations
+
+import io
+import json
+import re
+import zipfile
+import zlib
+from xml.etree import ElementTree as ET
+from xml.parsers import expat
+from xml.sax.saxutils import escape
+
+from tools.scoped_presentation import Package, PresentationError, encoded, q
+
+O = 'urn:oasis:names:tc:opendocument:xmlns:office:1.0'
+T = 'urn:oasis:names:tc:opendocument:xmlns:text:1.0'
+TB = 'urn:oasis:names:tc:opendocument:xmlns:table:1.0'
+DR = 'urn:oasis:names:tc:opendocument:xmlns:drawing:1.0'
+M = 'urn:oasis:names:tc:opendocument:xmlns:manifest:1.0'
+XL = 'http://www.w3.org/1999/xlink'
+SCRIPT = 'urn:oasis:names:tc:opendocument:xmlns:script:1.0'
+FORM = 'urn:oasis:names:tc:opendocument:xmlns:form:1.0'
+MIMES = {'odt': 'application/vnd.oasis.opendocument.text',
+         'ott': 'application/vnd.oasis.opendocument.text-template'}
+MAX_TEXT = 100_000
+MAX_RECORDS = 8_192
+MAX_CELLS = 4_096
+MAX_OUTPUT = 1_000_000
+
+
+class ODTError(ValueError):
+    """A fixed, content-free refusal code."""
+
+
+class DocumentText(str):
+    def __new__(cls, text, metadata):
+        result = super().__new__(cls, text)
+        result.extraction_metadata = metadata
+        return result
+
+
+def _fail(code):
+    raise ODTError(code)
+
+
+def _count(value, maximum=MAX_RECORDS):
+    if not isinstance(value, str) or not re.fullmatch(r'[0-9]{1,8}', value):
+        _fail('invalid_repeat_count')
+    number = int(value)
+    if not 1 <= number <= maximum:
+        _fail('repeat_count_limit')
+    return number
+
+
+def _tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+class DocumentPackage(Package):
+    def __init__(self, data, format='odt', checkpoint=None):
+        if format not in MIMES:
+            _fail('unsupported_format')
+        _tick(checkpoint)
+        try:
+            super().__init__(data)
+        except PresentationError as error:
+            raise ODTError(str(error)) from None
+        except (zipfile.BadZipFile, ET.ParseError, UnicodeError, zlib.error,
+                NotImplementedError, EOFError):
+            raise ODTError('malformed_package') from None
+        with zipfile.ZipFile(io.BytesIO(data)) as archive:
+            if any(info.is_dir() and info.file_size for info in archive.infolist()):
+                _fail('nonempty_directory_member')
+        _tick(checkpoint)
+        self.format = format
+        self.checkpoint = checkpoint
+        if (self.parts.get('mimetype') != MIMES[format].encode('ascii')
+                or self.member_info.get('mimetype') != (zipfile.ZIP_STORED, 0)):
+            _fail('not_native_' + format)
+        manifest = self.xml.get('META-INF/manifest.xml')
+        if manifest is None or manifest.tag != q(M, 'manifest'):
+            _fail('manifest_missing_or_namespace')
+        roots = []
+        names = set()
+        for node in manifest:
+            if node.tag != q(M, 'file-entry'):
+                _fail('manifest_structure')
+            name = node.get(q(M, 'full-path'))
+            if not name or name.casefold() in names:
+                _fail('duplicate_or_invalid_manifest_entry')
+            names.add(name.casefold())
+            if name == '/':
+                roots.append(node)
+            else:
+                key = name.rstrip('/')
+                if (not key or name.startswith('/') or any(c in name for c in '\\:%?#')
+                        or any(ord(c) < 32 for c in name)
+                        or any(part in ('', '.', '..') for part in key.split('/'))):
+                    _fail('unsafe_manifest_entry')
+                # ODF manifests may retain an empty directory (Configurations2/
+                # is usual). A directory declaration is not a fetched resource.
+                if not name.endswith('/') and name not in self.parts:
+                    _fail('manifest_target_missing')
+            if any(child.tag == q(M, 'encryption-data') for child in node.iter()):
+                _fail('encrypted_package')
+        if (len(roots) != 1 or roots[0].get(q(M, 'media-type')) != MIMES[format]
+                or 'content.xml' not in names):
+            _fail('manifest_type_or_content')
+        self.content = self.xml.get('content.xml')
+        if self.content is None or self.content.tag != q(O, 'document-content'):
+            _fail('content_missing_or_namespace')
+        bodies = self.content.findall(q(O, 'body'))
+        if len(bodies) != 1 or len(bodies[0]) != 1 or bodies[0][0].tag != q(O, 'text'):
+            _fail('not_native_' + format)
+        self.body = bodies[0][0]
+        self.unsupported = set()
+        for name, root in self.xml.items():
+            _tick(checkpoint)
+            if (name.lower().startswith(('meta-inf/documentsignatures', 'meta-inf/macrosignatures',
+                                         'basic/', 'scripts/'))):
+                self.unsupported.add('signatures_or_scripts_not_evaluated')
+            for node in root.iter():
+                if (node.tag in (q(O, 'script'), q(T, 'script'),
+                                 q(DR, 'plugin'), q(DR, 'object-ole'))
+                        or (node.tag == q(O, 'scripts') and (len(node) or (node.text or '').strip()))
+                        or node.tag.startswith((q(SCRIPT, ''), q(FORM, ''), q(T, 'dde-'),
+                                                q(T, 'database-'), q(TB, 'database-'),
+                                                q(TB, 'data-pilot-')))
+                        or node.tag in (q(O, 'dde-source'), q(T, 'execute-macro'),
+                                        q(TB, 'table-source'), q(TB, 'cell-range-source'))
+                        or any(attr.startswith(q(SCRIPT, '')) for attr in node.attrib)):
+                    self.unsupported.add('active_or_embedded_content_not_read')
+                href = node.get(q(XL, 'href'))
+                if href and not href.startswith('#'):
+                    self.unsupported.add('linked_content_not_resolved')
+                if node.tag in (q(T, 'tracked-changes'), q(T, 'change-start'), q(T, 'change-end')):
+                    self.unsupported.add('tracked_changes_not_resolved')
+
+
+def _text(node, package, *, omit_notes=True):
+    parts = []
+    chars = 0
+
+    def add(value):
+        nonlocal chars
+        if value:
+            chars += len(value)
+            if chars > MAX_TEXT:
+                _fail('paragraph_text_limit')
+            parts.append(value)
+
+    def walk(item):
+        if (item.tag in (q(O, 'scripts'), q(O, 'script'), q(T, 'script'))
+                or item.tag.startswith((q(SCRIPT, ''), q(FORM, '')))):
+            package.unsupported.add('active_or_embedded_content_not_read')
+            return
+        if item.tag == q(T, 's'):
+            add(' ' * _count(item.get(q(T, 'c'), '1'), MAX_TEXT))
+            return
+        if item.tag == q(T, 'tab'):
+            add('\t')
+            return
+        if item.tag == q(T, 'line-break'):
+            add('\n')
+            return
+        if item.tag in (q(T, 'note'), q(O, 'annotation')) and omit_notes:
+            package.unsupported.add('notes_and_annotations_separate')
+            return
+        if item.tag.startswith(q(DR, '')[:-1]):
+            package.unsupported.add('drawings_and_embedded_objects_not_read')
+            return
+        if item.tag.startswith(q(T, '')) and item.tag not in {
+                q(T, n) for n in ('p', 'h', 'span', 'a', 's', 'tab', 'line-break')}:
+            package.unsupported.add('fields_and_inline_metadata_not_evaluated')
+        add(item.text)
+        for child in item:
+            walk(child)
+            add(child.tail)
+
+    walk(node)
+    return ''.join(parts)
+
+
+def extract_document(data, format='odt', *, checkpoint=None):
+    """Return labelled paragraphs/lists/tables and explicit view limitations."""
+    pkg = DocumentPackage(data, format, checkpoint)
+    rows = []
+    output_bytes = 0
+    cells = 0
+    paragraph = 0
+    table_number = 0
+
+    def record(kind, value):
+        nonlocal output_bytes
+        if len(rows) >= MAX_RECORDS:
+            _fail('record_count_limit')
+        line = '[' + kind + ' ' + encoded(value) + ']'
+        output_bytes += len(line.encode('utf-8')) + 1
+        if output_bytes > 900_000:
+            _fail('extracted_text_limit')
+        rows.append(line)
+
+    def table_rows(table, budget):
+        nonlocal cells
+        result = []
+        used = 0
+        for node in table:
+            if node.tag in (q(TB, 'table-header-rows'), q(TB, 'table-rows'), q(TB, 'table-row-group')):
+                nested, cost = table_rows(node, budget - used)
+                result.extend(nested)
+                used += cost
+            elif node.tag == q(TB, 'table-row'):
+                row = []
+                row_cost = 2
+                for cell in node:
+                    if cell.tag not in (q(TB, 'table-cell'), q(TB, 'covered-table-cell')):
+                        _fail('unsupported_table_structure')
+                    repeat = _count(cell.get(q(TB, 'number-columns-repeated'), '1'), 256)
+                    cells += repeat
+                    if cells > MAX_CELLS or len(row) + repeat > 256:
+                        _fail('table_cell_limit')
+                    if cell.tag == q(TB, 'covered-table-cell'):
+                        value = {'covered': True}
+                    else:
+                        paragraphs = []
+                        cell_bytes = 0
+                        for p in cell:
+                            if p.tag in (q(T, 'p'), q(T, 'h')):
+                                text = _text(p, pkg)
+                                cell_bytes += len(text.encode('utf-8')) + 1
+                                if cell_bytes > MAX_TEXT or cell_bytes > budget - used - row_cost:
+                                    _fail('table_cell_text_limit')
+                                paragraphs.append(text)
+                        if any(p.tag not in (q(T, 'p'), q(T, 'h')) for p in cell):
+                            pkg.unsupported.add('nested_table_cell_content_not_read')
+                        value = {'text': '\n'.join(paragraphs)}
+                        for attr, key in (('number-columns-spanned', 'column_span'),
+                                          ('number-rows-spanned', 'row_span')):
+                            if cell.get(q(TB, attr)) is not None:
+                                value[key] = _count(cell.get(q(TB, attr)), 256)
+                        if cell.get(q(TB, 'formula')) is not None:
+                            value['formula_cached_only'] = True
+                            pkg.unsupported.add('table_formulas_not_evaluated')
+                    # Account for expanded JSON before allocating repeated
+                    # values/rows. XML repeat attributes cannot multiply a
+                    # bounded source text into an unbounded encoded record.
+                    row_cost += (len(encoded(value).encode('utf-8')) + 1) * repeat
+                    if row_cost > budget - used:
+                        _fail('extracted_text_limit')
+                    row.extend([value] * repeat)
+                if not row:
+                    _fail('empty_table_row')
+                repeat = _count(node.get(q(TB, 'number-rows-repeated'), '1'), MAX_RECORDS)
+                if len(result) + repeat > MAX_RECORDS or cells + len(row) * (repeat - 1) > MAX_CELLS:
+                    _fail('table_row_limit')
+                cost = (row_cost + 1) * repeat
+                if cost > budget - used:
+                    _fail('extracted_text_limit')
+                cells += len(row) * (repeat - 1)
+                result.extend([row] * repeat)
+                used += cost
+        return result, used
+
+    def walk(node, context=None):
+        nonlocal paragraph, table_number
+        _tick(checkpoint)
+        context = {} if context is None else context
+        if (node.tag in (q(O, 'scripts'), q(O, 'script'), q(T, 'script'))
+                or node.tag.startswith((q(SCRIPT, ''), q(FORM, '')))):
+            pkg.unsupported.add('active_or_embedded_content_not_read')
+            return
+        if node.tag == q(T, 'tracked-changes'):
+            pkg.unsupported.add('tracked_changes_not_resolved')
+            return
+        if node.tag == q(TB, 'table'):
+            table_number += 1
+            table, _ = table_rows(node, max(0, 900_000-output_bytes))
+            record('TABLE', {'number': table_number, 'name': node.get(q(TB, 'name')),
+                             'rows': table, **context})
+            return
+        if node.tag in (q(T, 'p'), q(T, 'h')):
+            paragraph += 1
+            item = {'number': paragraph, 'text': _text(node, pkg), **context}
+            if node.tag == q(T, 'h'):
+                item['level'] = _count(node.get(q(T, 'outline-level'), '1'), 10)
+            record('HEADING' if node.tag == q(T, 'h') else 'PARAGRAPH', item)
+            for note in node.iter(q(T, 'note')):
+                bodies = note.findall(q(T, 'note-body'))
+                if len(bodies) == 1:
+                    walk(bodies[0], {**context, 'role': note.get(q(T, 'note-class'), 'note')})
+            for annotation in node.iter(q(O, 'annotation')):
+                walk(annotation, {**context, 'role': 'annotation'})
+            return
+        if node.tag in (q(T, 'list'), q(T, 'list-item'), q(T, 'list-header')):
+            context = {**context, 'list_depth': context.get('list_depth', 0) + (node.tag == q(T, 'list'))}
+            if node.tag == q(T, 'list'):
+                context['list_style'] = node.get(q(T, 'style-name'))
+        if node.tag.startswith(q(DR, '')[:-1]):
+            pkg.unsupported.add('drawings_and_embedded_objects_not_read')
+            return
+        for child in node:
+            walk(child, context)
+
+    walk(pkg.body)
+    pkg.unsupported.add('page_layout_styles_and_rendering_not_evaluated')
+    metadata = {'format': format, 'native_container': True, 'view': 'native_text_structure',
+                'paragraphs': paragraph, 'tables': table_number,
+                'coverage': 'native_text_structure; images_layout_fields_and_external_content_not_evaluated',
+                'limitations': sorted(pkg.unsupported)}
+    header = '[DOCUMENT ' + encoded(metadata) + ']'
+    return DocumentText('\n'.join([header] + rows), metadata)
+
+
+def _plain(value):
+    if (not isinstance(value, str) or len(value) > MAX_TEXT
+            or any(not (ord(c) in (9, 10, 13) or 0x20 <= ord(c) <= 0xD7FF
+                       or 0xE000 <= ord(c) <= 0xFFFD or 0x10000 <= ord(c) <= 0x10FFFF)
+                   for c in value)):
+        _fail('invalid_text')
+    if len(value.encode('utf-8')) > MAX_TEXT:
+        _fail('text_limit')
+    return value.replace('\r\n', '\n').replace('\r', '\n')
+
+
+def _tag_end(raw, start):
+    quote = None
+    for index in range(start, len(raw)):
+        byte = raw[index]
+        if quote is not None:
+            if byte == quote:
+                quote = None
+        elif byte in (34, 39):
+            quote = byte
+        elif byte == 62:
+            return index + 1
+    _fail('malformed_xml')
+
+
+def _paragraph_slots(raw):
+    """Lexical text spans: untouched XML, namespaces and package parts survive."""
+    parser = expat.ParserCreate(namespace_separator='}')
+    stack = []
+    contexts = []
+    paragraphs = []
+    cursor = 0
+    body = False
+    total_chars = 0
+    total_slots = 0
+    text_tags = {T + '}' + n for n in ('p', 'h')}
+    space_tags = {T + '}' + n for n in ('s', 'tab', 'line-break')}
+    allowed_parents = {O + '}document-content', O + '}body', O + '}text',
+                       T + '}section', T + '}list', T + '}list-item', T + '}list-header',
+                       TB + '}table', TB + '}table-row', TB + '}table-cell',
+                       TB + '}table-header-rows', TB + '}table-rows', TB + '}table-row-group'}
+
+    def reserve(size):
+        nonlocal total_chars, total_slots
+        if contexts:
+            total_chars += size
+            total_slots += 1
+            if total_chars > 900_000 or total_slots > 50_000:
+                _fail('document_text_limit')
+            contexts[-1]['chars'] += size
+            if contexts[-1]['chars'] > MAX_TEXT:
+                _fail('paragraph_text_limit')
+
+    def flush(end):
+        nonlocal cursor
+        if contexts and end > cursor:
+            piece = raw[cursor:end]
+            if b'<' in piece:
+                contexts[-1]['supported'] = False
+            else:
+                value = ET.fromstring(b'<r>' + piece + b'</r>').text or ''
+                if value:
+                    reserve(len(value))
+                    profile = tuple(frame['attrs'] for frame in stack if frame['name'] == T + '}span')
+                    contexts[-1]['slots'].append((cursor, end, value, profile))
+        cursor = end
+
+    def start(name, attrs):
+        nonlocal cursor, body
+        begin = parser.CurrentByteIndex
+        flush(begin)
+        end = _tag_end(raw, begin)
+        frame = {'name': name, 'attrs': tuple(sorted(attrs.items())), 'start': begin,
+                 'end': end, 'empty': raw[begin:end].rstrip().endswith(b'/>')}
+        if name == O + '}text':
+            body = True
+        if name in text_tags and body:
+            if len(paragraphs) >= MAX_RECORDS:
+                _fail('record_count_limit')
+            if contexts:
+                contexts[-1]['supported'] = False
+            record = {'slots': [], 'chars': 0,
+                      'supported': all(p['name'] in allowed_parents for p in stack)}
+            contexts.append(record)
+            paragraphs.append(record)
+            frame['paragraph'] = record
+        elif contexts and name != T + '}span' and name not in space_tags:
+            contexts[-1]['supported'] = False
+        if contexts and name in space_tags:
+            if not frame['empty']:
+                contexts[-1]['supported'] = False
+            if name == T + '}s':
+                count = _count(attrs.get(T + '}c', '1'), MAX_TEXT)
+                reserve(count)
+                value = ' ' * count
+                if set(attrs) - {T + '}c'}:
+                    contexts[-1]['supported'] = False
+            else:
+                reserve(1)
+                value = '\t' if name == T + '}tab' else '\n'
+                if attrs:
+                    contexts[-1]['supported'] = False
+            profile = tuple(item['attrs'] for item in stack if item['name'] == T + '}span')
+            contexts[-1]['slots'].append((begin, end, value, profile))
+        stack.append(frame)
+        cursor = end
+
+    def end(name):
+        nonlocal cursor, body
+        frame = stack[-1]
+        if not frame['empty']:
+            flush(parser.CurrentByteIndex)
+            cursor = _tag_end(raw, parser.CurrentByteIndex)
+        if 'paragraph' in frame:
+            contexts.pop()
+        stack.pop()
+        if name == O + '}text':
+            body = False
+
+    def refuse(*args):
+        _fail('unsupported_xml_construct')
+
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    parser.CommentHandler = lambda *args: contexts[-1].update(supported=False) if contexts else None
+    parser.StartCdataSectionHandler = lambda: contexts[-1].update(supported=False) if contexts else None
+    try:
+        parser.Parse(raw, True)
+    except (expat.ExpatError, ET.ParseError):
+        raise ODTError('malformed_xml') from None
+    for record in paragraphs:
+        record['text'] = ''.join(slot[2] for slot in record['slots'])
+        if len(record['text']) > MAX_TEXT:
+            _fail('paragraph_text_limit')
+    return paragraphs
+
+
+def _literal_xml(value):
+    # Locally bound names cannot collide with a retained document namespace.
+    name = 'frwodft'
+    ns = ' xmlns:' + name + '="' + T + '"'
+    result = []
+    for part in re.split(r'( +|\t|\n)', value):
+        if not part:
+            continue
+        if part[0] == ' ':
+            result.append('<' + name + ':s' + ns + ' ' + name + ':c="' + str(len(part)) + '"/>')
+        elif part == '\t':
+            result.append('<' + name + ':tab' + ns + '/>')
+        elif part == '\n':
+            result.append('<' + name + ':line-break' + ns + '/>')
+        else:
+            result.append(escape(part))
+    return ''.join(result).encode('utf-8')
+
+
+def _editable_package(pkg):
+    for name in pkg.parts:
+        low = name.lower()
+        if (low.startswith(('meta-inf/documentsignatures', 'meta-inf/macrosignatures', 'basic/', 'scripts/'))
+                or low.endswith(('.js', '.py', '.jar', '.class', '.vbs', '.exe', '.dll'))):
+            _fail('signed_or_active_package')
+    forbidden = {q(O, 'script'), q(T, 'script'),
+                 q(DR, 'plugin'), q(DR, 'object'), q(DR, 'object-ole'),
+                 q(T, 'tracked-changes'), q(T, 'change-start'), q(T, 'change-end'),
+                 q(O, 'dde-source'), q(T, 'execute-macro'),
+                 q(TB, 'table-source'), q(TB, 'cell-range-source')}
+    for root in pkg.xml.values():
+        _tick(pkg.checkpoint)
+        for node in root.iter():
+            if (node.tag in forbidden or node.tag.startswith((q(SCRIPT, ''), q(FORM, ''),
+                    q(T, 'dde-'), q(T, 'database-'), q(TB, 'database-'), q(TB, 'data-pilot-')))
+                    or (node.tag == q(O, 'scripts') and (len(node) or (node.text or '').strip()))
+                    or node.get(q(TB, 'formula')) is not None
+                    or any(attr.startswith(q(SCRIPT, '')) for attr in node.attrib)):
+                _fail('active_embedded_or_tracked_content')
+            href = node.get(q(XL, 'href'))
+            if href and not href.startswith('#'):
+                candidate = href[2:] if href.startswith('./') else href
+                if (candidate not in pkg.parts or any(c in candidate for c in ':\\%?#')
+                        or any(p in ('', '.', '..') for p in candidate.split('/'))):
+                    _fail('external_or_unresolved_link')
+
+
+def edit_document(data, old_text, new_text, *, checkpoint=None):
+    """One unique body/table/list paragraph literal match to a preserving copy.
+
+    Mixed span formatting, fields, bookmarks, tracked changes, signatures and
+    active/external references refuse. XML outside selected text slots and all
+    other member payloads remain unchanged; ZIP records may be recompressed.
+    """
+    old = _plain(old_text)
+    new = _plain(new_text)
+    if not old or old == new:
+        _fail('invalid_replacement')
+    pkg = DocumentPackage(data, 'odt', checkpoint)
+    _editable_package(pkg)
+    records = _paragraph_slots(pkg.parts['content.xml'])
+    matches = []
+    for record in records:
+        _tick(checkpoint)
+        begin = record['text'].find(old)
+        while begin >= 0:
+            matches.append((record, begin))
+            if len(matches) > 1:
+                _fail('ambiguous_match')
+            begin = record['text'].find(old, begin + 1)
+    if not matches:
+        _fail('match_missing')
+    record, begin = matches[0]
+    if not record['supported']:
+        _fail('unsupported_paragraph_structure')
+    finish = begin + len(old)
+    selected = []
+    cursor = 0
+    for start, end, value, profile in record['slots']:
+        edge = cursor + len(value)
+        if cursor < finish and edge > begin:
+            selected.append((start, end, value, profile, max(0, begin-cursor), min(len(value), finish-cursor)))
+        cursor = edge
+    if not selected or len({slot[3] for slot in selected}) != 1:
+        _fail('mixed_span_format')
+    changes = []
+    for index, (start, end, value, profile, lo, hi) in enumerate(selected):
+        replacement = value[:lo] + (new if index == 0 else '') + value[hi:]
+        changes.append((start, end, _literal_xml(replacement)))
+    changed = pkg.parts['content.xml']
