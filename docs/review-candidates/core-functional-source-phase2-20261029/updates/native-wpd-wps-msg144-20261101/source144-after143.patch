+        children[ident] = [v for v in refs if v]
+        if flags & 2:
+            n = u16(data, p); p += 2
+            if not 1 <= n <= MAX_PREFIX or p + 4*(n+1) > pos+length:
+                fail('wpd_prefix_text_blocks')
