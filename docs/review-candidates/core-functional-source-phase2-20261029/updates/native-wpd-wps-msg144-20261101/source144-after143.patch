+    0x0E02, 0x0E03, 0x0E04, 0x0E06, 0x0E07, 0x0E1B, 0x0E1D,
+    0x0E28, 0x0E29, 0x0FF4, 0x0FF7, 0x1000, 0x1016, 0x1035, 0x1046,
+    0x1080, 0x1096, 0x3007, 0x3008, 0x300B, 0x340D, 0x3FDE, 0x3FFD,
+    0x5902, 0x5909, 0x5D01))
+_EDIT_RECIPIENT = frozenset((0x0C15, 0x0FF9, 0x0FFE, 0x0FFF, 0x3000,
+    0x3001, 0x3002, 0x3003, 0x300B, 0x3900, 0x3905, 0x39FE, 0x5FFD))
+
+
+def edit_msg(data, spec, *, cancelled=None):
+    """Replace exactly one literal in a plain-only message into new CFB bytes.
+
+    All other streams retain their exact bytes. The only property-table bytes
+    changed are the selected body entry's four-byte length. Logical directory
+    metadata remains exact; sector locations/tree pointers necessarily change.
+    """
+    check = _check_fn(cancelled)
+    if type(data) is not bytes or not data or len(data) > MAX_BYTES:
+        _fail('msg_edit_input_limit')
+    if type(spec) is not dict or set(spec) != {'old_text', 'new_text'}:
+        _fail('msg_edit_schema')
+    old = _text(spec['old_text'], multiline=True)
+    new = _text(spec['new_text'], multiline=True)
+    if old == new:
+        _fail('msg_edit_noop')
+    parsed = parse_msg(data, cancelled=cancelled)
+    if parsed['other_body_formats_present']:
+        _fail('msg_edit_alternate_body')
+    if parsed['attachments']:
+        _fail('msg_edit_attachments_unsupported')
+    if parsed['body_text'] is None:
+        _fail('msg_edit_plain_body_missing')
+    cfb = _CFB(data, check)
+    if (_NAMEID,) not in cfb.storages or any(
+            (_NAMEID, f'__substg1.0_{tag}') not in cfb.streams
+            for tag in ('00020102', '00030102', '00040102')):
+        _fail('msg_edit_missing_nameid_mapping')
+    root = _Properties(cfb, (), 32, set(), check)
+    if set(root.values) - _EDIT_ROOT:
+        _fail('msg_edit_active_or_unknown_property')
+    if 0x0E1B in root.values and root.values[0x0E1B] != (0x000B, bytes(8)):
+        _fail('msg_edit_attachment_claim')
+    for path in cfb.storages:
+        check()
+        if path and cfb.directory_records[path][80:96] != bytes(16):
+            _fail('msg_edit_active_storage')
+        if not path or path == (_NAMEID,):
+            continue
+        props = _Properties(cfb, path, 8, set(), check)
+        if set(props.values) - _EDIT_RECIPIENT:
+            _fail('msg_edit_active_or_unknown_property')
+    for pid in (0x1016, 0x5909):
+        if pid in root.values and root.integer(pid) != 1:
+            _fail('msg_edit_body_format')
+    body = parsed['body_text']
+    # Count possible starting positions, including overlapping literals.
+    # str.count would treat "aaa" inside "aaaaa" as one non-overlapping hit.
+    start = body.find(old)
+    if start < 0 or body.find(old, start + 1) >= 0:
+        _fail('msg_edit_missing_or_ambiguous')
+    changed = body.replace(old, new, 1)
+    _text(changed, multiline=True)
+    kind, raw = root.values[0x1000]
+    codec = 'utf-16le' if kind == 0x1F else _CODEPAGES.get(
+        root.integer(0x3FDE), _CODEPAGES.get(root.integer(0x3FFD), 'ascii'))
+    if codec is None:
+        _fail('msg_edit_codepage')
+    original = root.blobs[0x1000]
+    unit = 2 if kind == 0x1F else 1
+    terminator = bytes(unit) if original.endswith(bytes(unit)) else b''
+    try:
+        replacement = changed.encode(codec, 'strict') + terminator
+    except UnicodeError:
+        _fail('msg_edit_unrepresentable_text')
+    table = bytearray(cfb.streams[(_TABLE,)])
+    selected = None
+    for at in range(32, len(table), 16):
+        if struct.unpack_from('<I', table, at)[0] >> 16 == 0x1000:
+            selected = at
+            if not struct.unpack_from('<I', table, at + 4)[0] & 4:
+                _fail('msg_edit_body_not_writable')
+            old_size = struct.unpack_from('<I', raw)[0]
+            struct.pack_into('<I', table, at + 8, len(replacement) + old_size - len(original))
+            break
+    if selected is None:
+        _fail('msg_edit_plain_body_missing')
+    body_path = (f'__substg1.0_1000{kind:04X}',)
+    streams = dict(cfb.streams)
+    streams[body_path], streams[(_TABLE,)] = replacement, bytes(table)
+    output = _serialize(streams, cfb.storages, cfb.directory_records, check)
+    after = _CFB(output, check)
+    if after.streams != streams or after.storages != cfb.storages:
+        _fail('msg_edit_preservation_failed')
+    for path, before in cfb.directory_records.items():
+        if after.directory_records[path][80:116] != before[80:116]:
+            _fail('msg_edit_metadata_preservation_failed')
+    if parse_msg(output, cancelled=cancelled)['body_text'] != changed:
+        _fail('msg_write_roundtrip')
+    check()
+    return output
