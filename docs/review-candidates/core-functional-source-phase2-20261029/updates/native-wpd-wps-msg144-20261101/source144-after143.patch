+"""Bounded stored-text readers for WP6 flat WPD and Works 4 Windows WPS.
+
+Pure bytes only: no converters, external resources, or active content. Not a
+renderer. Unknown text semantics refuse; metadata and secondary stories never
+become body text. Format facts: Corel SDK WPFF and libwps 0.4.14 (see package
+FORMAT-NOTES.md). This implementation is independent, not translated library code.
+"""
+from __future__ import annotations
+
+import hashlib
+import struct
