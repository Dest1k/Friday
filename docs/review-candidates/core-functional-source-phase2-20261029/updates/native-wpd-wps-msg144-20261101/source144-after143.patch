+def create_msg(spec, *, cancelled=None):
+    check = _check_fn(cancelled)
+    if type(spec) is not dict or set(spec) != {'sender', 'recipients', 'subject', 'body_text'}:
+        _fail('msg_create_schema')
+    sender_name, sender_email = _person(spec['sender'])
+    recipients = spec['recipients']
+    if type(recipients) is not list or not 1 <= len(recipients) <= MAX_RECIPIENTS:
+        _fail('msg_create_recipient_limit')
+    subject, body = _text(spec['subject']), _text(spec['body_text'], multiline=True)
+    # MS-OXMSG 2.3 requires one mapping storage even with no named properties.
+    # Each of its three mapping streams is empty for this all-tagged profile.
+    storages = {(), (_NAMEID,)}
+    streams = {(_NAMEID, f'__substg1.0_{tag}'): b''
+               for tag in ('00020102', '00030102', '00040102')}
+    displays = {'to': [], 'cc': [], 'bcc': []}
+    for idx, recipient in enumerate(recipients):
+        check()
+        name, email = _person(recipient, True)
+        displays[recipient['type']].append(name)
+        path = (f'__recip_version1.0_#{idx:08X}',)
+        storages.add(path)
+        _props(path, [(0x0C15, 3, {'to': 1, 'cc': 2, 'bcc': 3}[recipient['type']]),
+                      (0x3001, 0x1F, name), (0x3002, 0x1F, 'SMTP'),
+                      (0x3003, 0x1F, email), (0x39FE, 0x1F, email)], bytes(8), streams)
+    root_values = [(0x001A, 0x1F, 'IPM.Note'), (0x0037, 0x1F, subject),
+                   (0x0C1A, 0x1F, sender_name), (0x0C1E, 0x1F, 'SMTP'),
+                   (0x0C1F, 0x1F, sender_email), (0x5D01, 0x1F, sender_email),
+                   (0x0E07, 3, 8), (0x0E1B, 0x0B, False),
+                   (0x1000, 0x1F, body), (0x1016, 3, 1),
+                   (0x340D, 3, 0x40000), (0x5909, 3, 1)]
+    for pid, name in ((0x0E04, 'to'), (0x0E03, 'cc'), (0x0E02, 'bcc')):
+        if displays[name]:
+            root_values.append((pid, 0x1F, '; '.join(displays[name])))
+    header = bytes(8) + struct.pack('<IIII', len(recipients), 0, len(recipients), 0) + bytes(8)
+    _props((), root_values, header, streams)
+    output = _serialize(streams, storages, {}, check)
+    parsed = parse_msg(output, cancelled=cancelled)
+    if parsed['subject'] != subject or parsed['body_text'] != body or len(parsed['recipients']) != len(recipients):
+        _fail('msg_write_roundtrip')
+    check()
+    return output
+
+
