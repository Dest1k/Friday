+"""Bounded native CFB/OXMSG creation and source-preserving plain-body copies.
+
+Only inert stored email is written. No Outlook/Office, transport or attachment
+execution is involved. CFB allocation is rebuilt; retained logical stream bytes
+and directory CLSID/state/timestamps are verified independently of allocation.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+import struct
+
+from tools.scoped_msg import (
+    _CFB, _Properties, _TABLE, _NAMEID, _CODEPAGES, MSG_CLSID, MSGError,
+    FREE, END, FAT, parse_msg,
+)
+
+MAX_BYTES = 1_000_000
+MAX_TEXT_BYTES = 100_000
+MAX_RECIPIENTS = 128
+
+
+def _fail(code):
+    raise MSGError(code)
+
+
+def _check_fn(cancelled):
+    if cancelled is not None and not callable(cancelled):
+        _fail('msg_cancel_type')
+    def check():
+        if cancelled is not None and cancelled():
+            _fail('msg_cancelled')
+    check()
+    return check
+
+
+def _text(value, *, multiline=False, limit=MAX_TEXT_BYTES):
+    if type(value) is not str or not value or len(value) > limit:
+        _fail('msg_write_text')
+    allowed = '\t\r\n' if multiline else '\t'
+    if any(ord(c) == 127 or ord(c) < 32 and c not in allowed for c in value):
+        _fail('msg_write_text')
+    if multiline and '\r' in value.replace('\r\n', ''):
+        _fail('msg_write_line_endings')
+    try:
+        if len(value.encode('utf-8')) > limit:
+            _fail('msg_write_text_limit')
+        value.encode('utf-16le')
+    except UnicodeError:
+        _fail('msg_write_text_encoding')
+    return value
+
+
+def _person(value, recipient=False):
+    if type(value) is not dict or set(value) not in (
+            {'email', 'type'} if recipient else {'email'},
+            {'email', 'name', 'type'} if recipient else {'email', 'name'}):
+        _fail('msg_write_person_schema')
+    email = _text(value['email'], limit=254)
+    # A deliberately narrow explicit SMTP mailbox profile, not a delivery claim.
+    if not email.isascii() or re.fullmatch(
+            r"[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+", email) is None:
+        _fail('msg_write_email')
+    name = _text(value['name'], limit=4096) if 'name' in value else email
+    if recipient and value['type'] not in ('to', 'cc', 'bcc'):
+        _fail('msg_write_recipient_type')
+    return name, email
+
+
+def _record(tag, raw, flags=6):
+    return struct.pack('<II', tag, flags) + raw
+
+
+def _props(path, values, header, streams):
+    records = []
+    for pid, kind, value in sorted(values):
+        if kind == 0x001F:
+            blob = value.encode('utf-16le')
+            streams[path + (f'__substg1.0_{pid:04X}{kind:04X}',)] = blob
+            raw = struct.pack('<II', len(blob) + 2, 0)
+        elif kind == 0x0003:
+            raw = struct.pack('<II', value, 0)
+        elif kind == 0x000B:
+            raw = struct.pack('<H', int(value)) + bytes(6)
+        else:
+            _fail('msg_write_internal_type')
+        records.append(_record((pid << 16) | kind, raw))
+    streams[path + (_TABLE,)] = header + b''.join(records)
+
+
+def _new_record(name, kind):
+    row = bytearray(128)
+    encoded = (name + '\0').encode('utf-16le')
+    if len(encoded) > 64:
+        _fail('msg_write_directory_name')
+    row[:len(encoded)] = encoded
+    struct.pack_into('<H', row, 64, len(encoded))
+    row[66:68] = bytes((kind, 1))
+    struct.pack_into('<III', row, 68, FREE, FREE, FREE)
+    struct.pack_into('<I', row, 116, END)
+    if kind == 5:
+        row[80:96] = MSG_CLSID
+    return bytes(row)
+
+
+def _serialize(streams, storages, records, check):
+    """Emit CFB v3 with real FAT, mini-FAT and balanced sibling trees."""
+    check()
+    if () not in storages or set(streams) & set(storages):
+        _fail('msg_write_directory_shape')
+    paths = [()] + sorted((set(streams) | set(storages)) - {()})
+    if len(paths) > 2048 or sum(map(len, streams.values())) > MAX_BYTES:
+        _fail('msg_write_output_limit')
+    indexes = {path: i for i, path in enumerate(paths)}
+    rows = []
+    for path in paths:
+        check()
+        kind = 5 if not path else 1 if path in storages else 2
+        row = bytearray(records.get(path) or _new_record(path[-1] if path else 'Root Entry', kind))
+        if len(row) != 128 or row[66] != kind:
+            _fail('msg_write_directory_metadata')
+        row[67] = 1
+        struct.pack_into('<III', row, 68, FREE, FREE, FREE)
+        struct.pack_into('<IQ', row, 116, END, 0)
+        rows.append(row)
+    for parent in storages:
+        check()
+        members = sorted((p for p in paths if p and p[:-1] == parent),
+                         key=lambda p: (len(p[-1]), p[-1].upper()))
+        # TreeMap's linear sorted-build coloring gives equal black heights even
+        # when the last level is incomplete. Empty leaves count as black.
+        red_level, remaining = 0, len(members) - 1
+        while remaining >= 0:
+            red_level += 1
+            remaining = remaining // 2 - 1
+        def build(lo, hi, level):
+            if lo > hi:
+                return FREE
+            mid = (lo + hi) // 2
+            idx = indexes[members[mid]]
+            left = build(lo, mid - 1, level + 1)
+            right = build(mid + 1, hi, level + 1)
+            struct.pack_into('<II', rows[idx], 68, left, right)
+            rows[idx][67] = 0 if level == red_level else 1
+            return idx
+        child = build(0, len(members) - 1, 0)
+        struct.pack_into('<I', rows[indexes[parent]], 76, child)
+    # Small streams reside in mini sectors; large streams in ordinary sectors.
+    mini = bytearray()
+    mini_fat = []
+    big = []
+    for path in paths:
+        check()
+        if path not in streams:
+            continue
+        data = streams[path]
+        row = rows[indexes[path]]
+        struct.pack_into('<Q', row, 120, len(data))
+        if len(data) < 4096:
+            start = len(mini_fat) if data else END
+            count = (len(data) + 63) // 64
+            mini_fat.extend(start + i + 1 if i + 1 < count else END for i in range(count))
+            mini.extend(data + bytes(count * 64 - len(data)))
+            struct.pack_into('<I', row, 116, start)
+        else:
+            big.append((indexes[path], data))
+    sectors, allocation = [], []
+    def allocate(data):
+        if not data:
+            return END, 0
+        start = len(sectors)
+        count = (len(data) + 511) // 512
+        for i in range(count):
+            check()
+            sectors.append(data[i*512:(i+1)*512].ljust(512, b'\0'))
+            allocation.append(start + i + 1 if i + 1 < count else END)
+        return start, count
+    for idx, data in big:
+        start, _ = allocate(data)
+        struct.pack_into('<I', rows[idx], 116, start)
+    start, _ = allocate(bytes(mini))
+    struct.pack_into('<IQ', rows[0], 116, start, len(mini))
+    mf = b''.join(struct.pack('<I', item) for item in mini_fat)
+    # Mini-FAT padding is FREE, not sector zero.
+    mf += struct.pack('<I', FREE) * ((-len(mini_fat)) % 128)
+    mini_start, mini_count = allocate(mf)
+    directory = b''.join(rows)
+    directory += bytes((-len(directory)) % 512)
+    directory_start, _ = allocate(directory)
+    nfat = 1
+    while (len(sectors) + nfat + 127) // 128 > nfat:
+        nfat += 1
+    if nfat > 109 or (len(sectors) + nfat + 1) * 512 > MAX_BYTES:
+        _fail('msg_write_output_limit')
+    fat_ids = list(range(len(sectors), len(sectors) + nfat))
+    allocation += [FAT] * nfat
+    allocation += [FREE] * (nfat * 128 - len(allocation))
+    fat_data = b''.join(struct.pack('<I', item) for item in allocation)
+    sectors.extend(fat_data[i*512:(i+1)*512] for i in range(nfat))
+    header = bytearray(512)
+    header[:8] = bytes.fromhex('d0cf11e0a1b11ae1')
+    struct.pack_into('<HHHHH', header, 24, 0x003E, 3, 0xFFFE, 9, 6)
+    struct.pack_into('<IIIIIIIII', header, 40, 0, nfat, directory_start, 0,
+                     4096, mini_start, mini_count, END, 0)
+    struct.pack_into('<109I', header, 76, *(fat_ids + [FREE] * (109 - nfat)))
+    check()
+    return bytes(header) + b''.join(sectors)
+
