+    done = set()
+    for ident in children:
+        stack = [(ident, False)]; active = set()
+        while stack:
+            node, leave = stack.pop()
+            if leave:
+                active.remove(node); done.add(node); continue
+            if node in active:
+                fail('wpd_prefix_cycle')
+            if node in done:
+                continue
+            if len(active) >= 16:
+                fail('wpd_prefix_depth')
+            active.add(node); stack.append((node, True))
+            stack.extend((kid, False) for kid in children[node])
+    return count
+
