+"""Scoped native MSG creation and hash-bound, new-copy plain-body editing."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+
+from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_communication import _object
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_msg import MSGError
+from tools.scoped_msg_write import MAX_BYTES, create_msg, edit_msg
+
+
+def execute(cap, fd, leaf, path, content, operation):
+    _check_parent(cap, fd, path)
+    if operation not in ('msg_create', 'msg_edit') or Path(path).name != leaf or Path(path).suffix.lower() != '.msg':
+        raise ScopeDenied()
+    try:
+        os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError:
+        pass
+    else:
+        return json.dumps({'success': False, 'error': 'document_already_exists',
+                           'effect_disposition': 'none'})
+    source = original = identity = relative = None
+    action = operation.split('_')[1]
+    def cancelled():
+        check(cap)
+        return False
+    try:
+        check(cap)
+        spec = _object(content)
+        if action == 'create':
+            rendered = create_msg(spec, cancelled=cancelled)
+        else:
+            if set(spec) != {'source', 'source_sha256', 'old_text', 'new_text'}:
+                raise MSGError('msg_edit_schema')
+            expected = spec['source_sha256']
+            if type(expected) is not str or re.fullmatch(r'[0-9a-f]{64}', expected) is None:
+                raise MSGError('msg_source_hash_required')
+            raw = spec['source']
+            if type(raw) is not str or not raw or '\0' in raw:
+                raise ScopeDenied()
+            root = cap.home / 'workspace'
+            source = Path(raw)
+            if not source.is_absolute():
+                source = root / source
+            try:
+                relative = source.relative_to(root)
+            except ValueError:
+                raise ScopeDenied() from None
+            if (source.suffix.lower() != '.msg' or not relative.parts
+                    or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+                    or relative.as_posix() == path):
+                raise ScopeDenied()
+            original, _, identity = workspace_document(str(source), max_bytes=MAX_BYTES, with_identity=True)
+            if hashlib.sha256(original).hexdigest() != expected:
+                raise MSGError('msg_source_hash_mismatch')
+            rendered = edit_msg(original, {k: spec[k] for k in ('old_text', 'new_text')}, cancelled=cancelled)
+        check(cap)
+    except MSGError as error:
+        return json.dumps({'success': False, 'error': 'msg_' + action + '_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
+    verify = None
+    if source is not None:
+        def verify():
+            check(cap)
+            current, _, current_identity = workspace_document(str(source), max_bytes=MAX_BYTES, with_identity=True)
+            if current != original or current_identity != identity:
+                raise ScopeDenied()
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                     output_format=operation, verify_source=verify))
+    if result.get('success'):
+        result.update(local_file_only=True, external_side_effects='none',
+                      profile='native_cfb_plain_email_v1',
+                      application_interoperability='not_live_tested')
+        if source is not None:
+            result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(original).hexdigest(),
+                          source_unchanged=True, replacements=1,
+                          edit_mode='unique_literal_in_plain_body',
+                          unselected_streams_preserved=True, storage_metadata_preserved=True,
+                          container_allocation_rebuilt=True)
+    return json.dumps(result, ensure_ascii=False)
