+def _wps_paragraph(prop):
+    # The three initial bytes are unknown in the retained primary reference;
+    # admit only its observed zero form, then bounded layout-only operations.
+    if len(prop)<3 or prop[:3] != b'\0\0\0':
+        fail('wps_paragraph_header_unsupported')
+    p=3
+    while p<len(prop):
+        code=prop[p];p+=1
+        if code in (5,7,8):
+            if p>=len(prop) or prop[p]>(3 if code==5 else 1):
+                fail('wps_paragraph_property')
+            p+=1
+        elif code==15:
+            if p+3>len(prop): fail('wps_paragraph_tabs')
+            size,flags,count=prop[p:p+3]
+            if flags or size!=2+3*count or p+1+size>len(prop):
+                fail('wps_paragraph_tabs')
+            # Positions are 16-bit values followed by the alignment bytes.
+            align=p+3+2*count
