+# file, You can obtain one at https://mozilla.org/MPL/2.0/.
+"""Bounded, read-only desktop OneStore section decoder.
+
+Portions adapted from onenote.rs / onenote_parser, commit
+ de3a64e8159c684b137ded89c3fef3c17272ec1d (MPL-2.0).
+See scoped_onenote.NOTICE for provenance and the accepted format profile.
+No external programs, network, attachment extraction, or writes are used.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import struct
+import uuid
+import zlib
+
+MAX_FILE = 16 * 1024 * 1024
+MAX_NODES = 100_000
+MAX_LISTS = 4096
+MAX_REVISIONS = 8192
+MAX_OBJECTS = 100_000
+MAX_REFS = 100_000
+MAX_DEPTH = 64
+MAX_OUTPUT = 2 * 1024 * 1024
+MAX_PROPERTIES = 4096
+MAX_PROPERTY_BYTES = 4 * 1024 * 1024
+_NIL = (bytes(16), 0)
+
+
+class OneNoteError(ValueError):
+    """Input is malformed, unsupported, or exceeds a declared bound."""
+
+
+def _require(value, message):
+    if not value:
+        raise OneNoteError(message)
+
+
+class _Reader:
+    __slots__ = ('data', 'pos', 'end')
+    def __init__(self, data, start=0, end=None):
+        self.data, self.pos = data, start
+        self.end = len(data) if end is None else end
+        _require(0 <= start <= self.end <= len(data), 'invalid chunk bounds')
+
+    def take(self, count):
+        _require(0 <= count <= self.end - self.pos, 'truncated structure')
+        at = self.pos
+        self.pos += count
+        return self.data[at:self.pos]
+
+    def num(self, width):
+        return int.from_bytes(self.take(width), 'little')
+
+    def guid(self):
+        return bytes(self.take(16))
+
+    def exguid(self):
+        return (self.guid(), self.num(4))
+
+    def done(self):
+        _require(self.pos == self.end, 'unexpected structure trailing bytes')
+
+
+@dataclass(frozen=True)
+class _Node:
+    kind: int
+    payload: bytes
+    ref: tuple[int, int] | None
+    children: tuple['_Node', ...] | None
+    offset: int
+
+
+@dataclass
+class _Object:
+    jcid: int
+    props: dict
+    offset: int
+
+
+@dataclass
+class _Revision:
+    ident: tuple
+    parent: tuple
+    context: tuple
+    role: int
+    roots: dict
+    objects: dict
+    ids: dict
+
+
+class _Store:
+    def __init__(self, data, checkpoint=None):
+        self.checkpoint = checkpoint or (lambda: None)
+        self.work = 0
+        self.checkpoint()
+        _require(isinstance(data, bytes), 'input must be bytes')
+        _require(1024 <= len(data) <= MAX_FILE, 'OneNote file size outside supported bound')
+        self.data = data
+        self.nodes = 0
+        self.list_count = 0
+        self.object_count = 0
+        self.property_count = 0
+        self.property_bytes = 0
+        self.reference_count = 0
+        self.list_stack = set()
+        self.list_ids = {}
+        self.lists = {}
+        self.trace = {'transactions': [], 'lists': [], 'revisions': [], 'objects': []}
+        self.readonly = {}
+        self.spaces = {}
+        self.header()
+        self.counts = self.transactions()
+        self.root_nodes = self.node_list(self.root_ref)
+        self.materialize()
+
+    def charge(self, amount=1):
+        self.work += amount
+        _require(self.work <= 2_000_000, 'decoder operation bound exceeded')
+        self.checkpoint()
+
+    def chunk(self, ref):
+        start, size = ref
+        _require(start >= 1024 and size > 0 and start + size <= self.length, 'invalid file chunk reference')
+        return _Reader(self.data, start, start + size)
+
+    @staticmethod
+    def ref(r, sf=0, cf=0):
+        sw = (8, 4, 2, 4)[sf]
+        cw = (4, 8, 1, 2)[cf]
+        start, size = r.num(sw), r.num(cw)
+        if sf >= 2:
+            start *= 8
+        if cf >= 2:
+            size *= 8
+        return start, size
+
+    def header(self):
+        r = _Reader(self.data, 0, 1024)
+        _require(r.guid() == uuid.UUID('7b5c52e4-d88c-4da7-aeb1-5378d02996d3').bytes_le,
+                 'only desktop OneNote .one sections are supported')
+        self.file_id = r.guid()
+        r.take(16)  # legacy version, explicitly ignored by MS-ONESTORE
+        _require(r.guid() == uuid.UUID('109add3f-911b-49f5-a5d0-1791edc8aed8').bytes_le,
+                 'unsupported OneStore format')
+        _require([r.num(4) for _ in range(4)] == [42] * 4, 'unsupported OneStore version')
+        r.pos = 96
+        self.transaction_count = r.num(4)
+        _require(0 < self.transaction_count <= MAX_NODES, 'invalid committed transaction count')
+        r.pos = 160
+        self.log_ref = self.ref(r)
+        self.root_ref = self.ref(r)
+        self.free_ref = self.ref(r)
+        self.length = r.num(8)
+        _require(1024 <= self.length <= len(self.data), 'truncated expected file length')
+        # Extra physical bytes may belong to an uncommitted append. Never read them.
+        r.pos = 228
+        self.generation = r.num(8)
+        self.deny_read_version = r.guid()  # a file-mutation identity, not an encryption flag
+
+    def transactions(self):
+        counts = {}
+        ref = self.log_ref
+        seen = set()
+        committed, crc = 0, 0
+        while committed < self.transaction_count:
+            self.charge()
+            _require(ref not in seen and len(seen) < MAX_LISTS, 'transaction log cycle or bound')
+            seen.add(ref)
+            r = self.chunk(ref)
+            _require(r.end-r.pos >= 20, 'invalid transaction fragment length')
+            entries_end = r.pos + ((r.end-r.pos-12)//8)*8
+            pending = {}
+            while r.pos < entries_end:
+                self.charge()
+                offset = r.pos
+                raw = r.take(8)
+                ident, count = struct.unpack('<II', raw)
+                if ident == 1:
+                    _require(count == crc, 'transaction CRC mismatch')
+                    _require(pending, 'empty committed transaction')
+                    counts.update(pending)
+                    pending = {}
+                    committed += 1
+                    self.trace['transactions'].append({'sentinel_offset': offset, 'crc': crc})
+                    if committed == self.transaction_count:
+                        return counts
+                else:
+                    _require(ident >= 16 and 0 <= count <= MAX_NODES, 'invalid transaction list count')
+                    _require(ident not in pending and count > counts.get(ident, -1),
+                             'non-increasing or duplicate transaction list count')
+                    pending[ident] = count
+                # Desktop .one CRC is cumulative over entries including earlier sentinels.
+                crc = zlib.crc32(raw, crc)
+            _require(not pending, 'transaction crosses fragment boundary')
+            ref = self.ref(r)
+        return counts
+
+    def node_list(self, ref, depth=0):
+        _require(depth < MAX_DEPTH, 'file node list depth bound exceeded')
+        _require(ref not in self.list_stack, 'cyclic file node list')
+        if ref in self.lists:
+            return self.lists[ref]
+        self.list_count += 1
+        _require(self.list_count <= MAX_LISTS, 'file node list count bound exceeded')
+        original = ref
+        self.list_stack.add(original)
+        result = []
+        fragments = set()
+        ident = None
+        remaining = None
+        sequence = 0
+        try:
+            while True:
+                _require(ref not in fragments, 'cyclic file node fragments')
+                fragments.add(ref)
+                r = self.chunk(ref)
+                _require(r.end-r.pos >= 36, 'short file node fragment')
+                _require(r.num(8) == 0xA4567AB1F5F7F4C4, 'invalid file node fragment magic')
+                fid, seq = r.num(4), r.num(4)
+                _require(seq == sequence, 'invalid file node fragment sequence')
+                sequence += 1
+                if ident is None:
+                    ident = fid
+                    _require(fid in self.counts, 'uncommitted file node list')
+                    _require(fid not in self.list_ids, 'duplicate file node list ID')
+                    self.list_ids[fid] = original
+                    remaining = self.counts[fid]
+                _require(fid == ident, 'file node list ID changed between fragments')
+                node_end = r.end - 20
+                footer = int.from_bytes(self.data[r.end-8:r.end], 'little')
+                _require(footer == 0x8BC215C38233BA4B, 'invalid file node fragment footer')
+                terminator = False
+                while remaining and r.pos + 4 <= node_end:
+                    self.charge()
+                    at = r.pos
+                    head = r.num(4)
+                    kind, size = head & 1023, (head >> 10) & 8191
+                    if kind == 0:
+                        _require(head == 0, 'invalid null file node')
+                        continue
+                    _require(4 <= size <= node_end-at and head >> 31 == 1, 'invalid file node size/header')
+                    nr = _Reader(self.data, r.pos, at+size)
+                    r.pos = at + size
+                    base = (head >> 27) & 15
+                    _require(base <= 2, 'unsupported file node base type')
+                    nref = self.ref(nr, (head >> 23) & 3, (head >> 25) & 3) if base else None
+                    children = self.node_list(nref, depth+1) if base == 2 else None
+                    payload = bytes(nr.take(nr.end-nr.pos))
+                    _require(kind != 0x7C, 'encrypted OneStore object space is unsupported')
+                    if kind == 255:
+                        _require(base == 0 and size == 4, 'invalid chunk terminator')
+                        terminator = True
+                        break
+                    self.nodes += 1
+                    _require(self.nodes <= MAX_NODES, 'file node count bound exceeded')
+                    result.append(_Node(kind, payload, nref, children, at))
+                    remaining -= 1
+                self.charge()
+                self.trace['lists'].append({'id': ident, 'offset': ref[0], 'sequence': seq, 'remaining': remaining})
+                if remaining == 0:
+                    break  # nextFragment belongs to uncommitted data and MUST be ignored.
+                _require(terminator or r.pos+4 > node_end, 'unterminated fragment')
+                r.pos = r.end - 20
+                ref = self.ref(r)
+                _require(ref[1] > 0, 'committed file node count exceeds available nodes')
+            self.lists[original] = tuple(result)
+            return self.lists[original]
+        finally:
+            self.list_stack.remove(original)
+
+    @staticmethod
+    def payload(node, base=None):
+        if base is not None:
+            _require((node.children is not None if base == 2 else node.ref is not None if base == 1 else node.ref is None),
+                     'file node reference type mismatch')
+        return _Reader(node.payload)
+
+    def global_ids(self, nodes, start, parent):
+        ids = {}
+        n = nodes[start]
+        _require(n.kind in (0x21,0x22), 'global ID table missing')
+        r = self.payload(n, 0)
+        if n.kind == 0x21:
+            _require(r.num(1) == 0, 'invalid global ID table reserved field')
+        r.done()
+        start += 1
+        while start < len(nodes):
+            n = nodes[start]
+            start += 1
+            r = self.payload(n, 0)
+            if n.kind == 0x28:
+                r.done()
+                return ids, start
+            if n.kind == 0x24:
+                index, guid = r.num(4), r.guid()
+                values = [(index,guid)]
+            elif n.kind == 0x25:
+                src,dst = r.num(4),r.num(4)
+                _require(src in parent, 'missing parent global ID')
+                values = [(dst,parent[src])]
+            elif n.kind == 0x26:
+                src,count,dst = r.num(4),r.num(4),r.num(4)
+                _require(count <= MAX_REFS, 'global ID copy count bound exceeded')
+                _require(all(src+i in parent for i in range(count)), 'missing parent global ID range')
+                self.charge(count)
+                values = [(dst+i,parent[src+i]) for i in range(count)]
+            else:
+                raise OneNoteError('unexpected node in global ID table')
+            r.done()
+            for index,guid in values:
+                _require(index < 0xFFFFFF and index not in ids, 'invalid or duplicate global ID index')
+                ids[index]=guid
+            _require(len(ids) <= MAX_REFS, 'global ID count bound exceeded')
+        raise OneNoteError('unterminated global ID table')
+
+    @staticmethod
+    def resolve(cid, ids):
+        n, index = cid & 255, cid >> 8
+        _require(index in ids, 'unresolved compact global ID')
+        return ids[index], n
+
+    def property_set(self, r, streams, ids, depth=0):
+        _require(depth < MAX_DEPTH, 'property nesting bound exceeded')
+        count = r.num(2)
+        self.charge(count)
+        self.property_count += count
+        _require(count <= MAX_PROPERTIES and self.property_count <= MAX_NODES*4, 'property count bound exceeded')
+        keys = [r.num(4) for _ in range(count)]
+        result = {}
+        for key in keys:
+            ident, kind = key & 0x3FFFFFF, (key >> 26) & 31
+            _require(ident not in result, 'duplicate property ID')
+            if kind == 1:
+                value = None
+            elif kind == 2:
+                value = bool(key >> 31)
+            elif 3 <= kind <= 6:
+                value = r.num((1,2,4,8)[kind-3])
+            elif kind == 7:
+                size = r.num(4)
+                self.property_bytes += size
+                _require(size <= MAX_PROPERTY_BYTES and self.property_bytes <= MAX_FILE*4, 'property byte bound exceeded')
+                value = bytes(r.take(size))
+            elif 8 <= kind <= 13:
+                which = (kind-8)//2
+                number = r.num(4) if kind % 2 else 1
+                _require(number <= MAX_REFS, 'property reference count bound exceeded')
+                stream, cursor = streams[which]
+                _require(cursor+number <= len(stream), 'property references exceed stream')
+                value = [self.resolve(cid, ids) for cid in stream[cursor:cursor+number]]
+                streams[which] = stream, cursor+number
+            elif kind == 16:
+                number = r.num(4)
+                _require(number <= MAX_PROPERTIES, 'nested property array bound exceeded')
+                _require(number == 0 or (r.num(4)>>26)&31 == 17, 'unsupported nested property type')
+                value = [self.property_set(r,streams,ids,depth+1) for _ in range(number)]
+            elif kind == 17:
+                value = self.property_set(r,streams,ids,depth+1)
+            else:
+                raise OneNoteError('unsupported property type')
+            result[ident] = (kind,value)
+        return result
+
+    def properties(self, ref, ids):
+        r = self.chunk(ref)
+        header = r.num(4)
+        streams = []
+        def read_stream(h):
+            _require(h & 0x3F000000 == 0, 'invalid object stream reserved bits')
+            count = h & 0xFFFFFF
+            self.reference_count += count
+            _require(count <= MAX_REFS and self.reference_count <= MAX_REFS,
+                     'object stream cumulative reference bound exceeded')
+            self.charge(count)
+            return ([r.num(4) for _ in range(count)],0)
+        streams.append(read_stream(header))
+        if not header & 0x80000000:
+            sh = r.num(4)
+            streams.append(read_stream(sh))
+            if sh & 0x40000000:
+                streams.append(read_stream(r.num(4)))
+        while len(streams)<3:
+            streams.append(([],0))
+        props = self.property_set(r,streams,ids)
+        _require(all(len(stream)==cursor for stream,cursor in streams), 'unused object references')
+        padding = r.take(r.end-r.pos)
+        _require(len(padding) <= 7 and not any(padding), 'invalid object property padding')
+        return props
+
+    def declaration(self, node, ids, objects, inherited):
+        r = self.payload(node)
+        kind = node.kind
+        oid = self.resolve(r.num(4),ids)
+        if kind in (0x2D,0x2E):
+            meta = r.num(4)
+            _require(meta == 1, 'encrypted or unsupported legacy object declaration')
+            _require(r.num(2)==0, 'invalid legacy object reserved field')
+            jcid = 0x20001
+            r.num(1 if kind==0x2D else 4)
+        elif kind in (0x41,0x42):
+            meta = r.num(1 if kind==0x41 else 4)
+            if kind==0x42:
+                r.num(4)
+            old = objects.get(oid) or inherited.get(oid)
+            _require(old is not None, 'object revision has no ancestor declaration')
+            jcid = old.jcid
+        elif kind in (0x72,0x73):
+            jcid = r.num(4)
+            r.num(1 if kind==0x72 else 4)
+            for _ in range(2):
+                count = r.num(4)
+                _require(count <= MAX_PROPERTIES, 'attachment descriptor string bound exceeded')
+                r.take(count*2).decode('utf-16-le',errors='strict')
+            r.done()
+            _require(node.ref is None and jcid & 0x80000, 'invalid attachment declaration')
+            return oid, _Object(jcid,{},node.offset)
