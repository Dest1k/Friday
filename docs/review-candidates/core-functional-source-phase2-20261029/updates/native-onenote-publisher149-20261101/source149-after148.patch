+++ b/hermes_cli/friday_workspace_onenote.py
@@ -0,0 +1,61 @@
+"""Read current OneNote section text through the existing own-workspace boundary."""
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_zip import _source, _verify, _inline_budget, _fits, _encode
+from tools.scoped_onenote import extract_onenote, OneNoteError
+
+
+def read_section(cap, relative, *, offset=1, limit=2000, char_offset=0, password=None):
+    if (PurePosixPath(relative).suffix.lower() != '.one' or password is not None
+            or type(offset) is not int or not 1 <= offset <= 1_000_000
+            or type(limit) is not int or not 1 <= limit <= 2000
+            or type(char_offset) is not int or not 0 <= char_offset <= 1_000_000):
+        raise ScopeDenied()
+    data, identity = _source(cap, relative)
+    sources = [(relative, data, identity)]
+    try:
+        text = extract_onenote(data, checkpoint=lambda: check(cap))
+    except OneNoteError as exc:
+        _verify(cap, sources)
+        return _encode(dict(success=False, error='document_extraction_failed',
+                            format='one', reason=str(exc), effect_disposition='none'))
+    _verify(cap, sources)
+    lines = text.splitlines()
+    if offset <= len(lines) and char_offset > len(lines[offset-1]):
+        raise ScopeDenied()
+    metadata = text.extraction_metadata
+    result = dict(success=True, path=relative, scope='own_user_workspace',
+                  content='', total_lines=len(lines), extracted_document=True,
+                  format='one', extraction=metadata, source_sha256=metadata['source_sha256'],
+                  coverage=metadata['coverage'], partial=offset <= len(lines),
+                  next_offset=offset, next_char_offset=char_offset)
+    budget = _inline_budget()
+    if not _fits(result, budget):
+        return _encode(dict(success=False, error='capacity', effect_disposition='none'))
+    for n in range(offset-1, min(len(lines), offset-1+limit)):
+        start = char_offset if n == offset-1 else 0
+        payload = lines[n][start:]
+        prior = result['content']
+        prefix = ('\n' if prior else '') + f'{n+1}: '
+        low, high = 0, len(payload)
+        while low < high:
+            mid = (low+high+1)//2
+            result.update(content=prior+prefix+payload[:mid], partial=True,
+                          next_offset=n+1, next_char_offset=start+mid)
+            if _fits(result,budget): low=mid
+            else: high=mid-1
+        complete = low == len(payload)
+        result.update(content=prior+prefix+payload[:low], partial=not(complete and n+1==len(lines)),
+                      next_offset=n+2 if complete else n+1,
+                      next_char_offset=0 if complete else start+low)
+        if not _fits(result,budget) or (not complete and low==0):
+            result.update(content=prior, partial=True, next_offset=n+1, next_char_offset=start)
+            if not prior:
+                return _encode(dict(success=False,error='capacity',effect_disposition='none'))
+            break
+        if not complete: break
+    _verify(cap,sources)
+    check(cap)
+    return _encode(result)
