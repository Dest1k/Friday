+# SPDX-License-Identifier: MPL-2.0
+"""Bounded inert Publisher 2002+ (Contents 0x2c) stored text reader.
+
+CFB validation specializes native scoped_msg/scoped_doc. Indexed Contents and
+Quill interpretation follows LibreOffice libmspub (MPL-2.0); see accompanying
+LICENSE and source notes. No binary string scanning, rendering or execution.
+The result is partial stored text, not layout, visual order or complete PUB.
+"""
+from __future__ import annotations
+
+import hashlib
+import struct
+import json
+import time
+
+MAX_INPUT = 1_000_000
+MAX_DIRECTORY = 256
+MAX_DEPTH = 8
+MAX_RECORDS = 4096
+MAX_STORIES = 512
+MAX_TEXT_UNITS = 200_000
+MAX_PAGES = 64
+MAX_TEXT = 1_500_000
+FREE = 0xFFFFFFFF
+END = 0xFFFFFFFE
+FAT = 0xFFFFFFFD
+DIF = 0xFFFFFFFC
+PUB_CLSID = bytes.fromhex('011202000000000000c0000000000046')
+
+class PUBError(ValueError):
+    """Content-free refusal code; includes cancellation."""
+
+def _fail(code):
+    raise PUBError(code)
+
+def _u16(data, at):
+    return struct.unpack_from('<H', data, at)[0]
+
+def _u32(data, at):
+    return struct.unpack_from('<I', data, at)[0]
+
+def _words(data):
+    return struct.unpack('<' + 'I' * (len(data) // 4), data)
+
+class _CFB:
+    def __init__(self, data, check):
+        self.check = check
+        self.check()
+        if len(data) < 512 or data[:8] != bytes.fromhex('d0cf11e0a1b11ae1'):
+            _fail('cfb_signature')
+        self.data = data
+        version = _u16(data, 26)
+        shift = _u16(data, 30)
+        if (data[8:24] != b'\0' * 16 or _u16(data, 24) != 0x003E or version not in (3, 4)
+                or _u16(data, 28) != 0xFFFE or shift != (9 if version == 3 else 12)
+                or _u16(data, 32) != 6 or data[34:40] != b'\0' * 6
+                or _u32(data, 56) != 4096):
+            _fail('cfb_header')
+        self.sector_size = 1 << shift
+        if (len(data) % self.sector_size or len(data) < self.sector_size * 3
+                or any(data[512:self.sector_size])):
+            _fail('cfb_geometry')
+        self.sectors = len(data) // self.sector_size - 1
+        self.used = set()
+        ndir, nfat = _u32(data, 40), _u32(data, 44)
+        nmini, ndif = _u32(data, 64), _u32(data, 72)
+        if ((version == 3 and ndir != 0) or not 1 <= nfat <= self.sectors
+                or nmini > self.sectors or ndif > self.sectors):
+            _fail('cfb_allocation_count')
+        fat_ids = []
+        saw_free = False
+
+        def add_fat_ids(items):
+            nonlocal saw_free
+            for sid in items:
+                if sid == FREE:
+                    saw_free = True
+                else:
+                    if saw_free or len(fat_ids) >= nfat:
+                        _fail('cfb_difat_count')
+                    self._claim(sid)
+                    fat_ids.append(sid)
+
+        add_fat_ids(_words(data[76:512]))
+        dif_ids = []
+        sid = _u32(data, 68)
+        for _ in range(ndif):
+            self._claim(sid)
+            dif_ids.append(sid)
+            items = _words(self._sector(sid))
+            add_fat_ids(items[:-1])
+            sid = items[-1]
+        if sid != END or len(fat_ids) != nfat:
+            _fail('cfb_difat_count')
+        self.fat = tuple(v for sid in fat_ids for v in _words(self._sector(sid)))
+        if len(self.fat) < self.sectors:
+            _fail('cfb_fat_coverage')
+        for sid, value in enumerate(self.fat):
+            if sid >= self.sectors:
+                if value != FREE:
+                    _fail('cfb_fat_padding')
+            elif value not in (FREE, END, FAT, DIF) and value >= self.sectors:
+                _fail('cfb_sector_bounds')
+        if any(self.fat[sid] != FAT for sid in fat_ids) or any(
+                self.fat[sid] != DIF for sid in dif_ids):
+            _fail('cfb_allocation_marker')
+        directory = self._chain(_u32(data, 48), self.fat, self.sector_size,
+                                self.sectors, self.used, limit=MAX_DIRECTORY // (self.sector_size // 128))
+        if version == 4 and len(directory) // self.sector_size != ndir:
+            _fail('cfb_directory_count')
+        if not directory:
+            _fail('cfb_directory_missing')
+        entries = []
+        for at in range(0, len(directory), 128):
+            self.check()
+            row = directory[at:at + 128]
+            kind = row[66]
+            if kind == 0:
+                entries.append(None)
+                continue
+            length = _u16(row, 64)
+            if (kind not in (1, 2, 5) or length < 2 or length > 64 or length % 2
+                    or row[length - 2:length] != b'\0\0' or row[67] not in (0, 1)):
+                _fail('cfb_directory_entry')
+            try:
+                name = row[:length - 2].decode('utf-16le')
+            except UnicodeError:
+                _fail('cfb_directory_name')
+            if not name or any(c in name for c in '\0/\\:!'):
+                _fail('cfb_directory_name')
+            if version == 3 and _u32(row, 124):
+                _fail('cfb_v3_stream_size')
+            size = _u32(row, 120) if version == 3 else struct.unpack_from('<Q', row, 120)[0]
+            if size > MAX_INPUT:
+                _fail('cfb_stream_limit')
+            entries.append((name, kind, _u32(row, 68), _u32(row, 72),
+                            _u32(row, 76), row[80:96], _u32(row, 116), size, row[67]))
+        root = entries[0]
+        if (root is None or root[0] != 'Root Entry' or root[1] != 5
+                or root[2:4] != (FREE, FREE)):
+            _fail('cfb_root')
+        if root[5] != PUB_CLSID:
+            _fail('pub_cfb_identity')
+        # Root coloring is not part of stream identity. Validate every storage
+        # sibling tree, stream allocation and directory node before interpretation.
+        stack = [(root[4], None, None, False, (), 1, True)]
+        seen = {0}
+        streams = []
+        self.storages = {()}
+        self.directory_records = {(): directory[:128]}
+        while stack:
+            self.check()
+            idx, low, high, parent_red, parent_path, depth, tree_root = stack.pop()
+            if idx == FREE:
+                continue
+            if depth > MAX_DEPTH:
+                _fail('cfb_depth_limit')
+            if idx >= len(entries) or idx in seen or entries[idx] is None:
+                _fail('cfb_directory_cycle_or_bounds')
+            seen.add(idx)
+            row = entries[idx]
+            name, kind, left, right, child, clsid, start, size, color = row
+            if not name.isascii():
+                _fail('pub_nonascii_storage_name')
+            key = (len(name), name.upper())
+            if ((low is not None and key <= low) or (high is not None and key >= high)
+                    or (parent_red and color == 0) or (tree_root and color != 1)):
+                _fail('cfb_directory_tree')
+            path = parent_path + (name,)
+            self.directory_records[path] = directory[idx * 128:(idx + 1) * 128]
+            if kind == 2:
+                if child != FREE or clsid != bytes(16):
+                    _fail('cfb_stream_metadata')
+                streams.append((path, start, size))
+            elif kind == 1:
+                self.storages.add(path)
+                stack.append((child, None, None, False, path, depth + 1, True))
+            else:
+                _fail('cfb_nested_root')
+            stack.extend(((left, low, key, color == 0, parent_path, depth, False),
+                          (right, key, high, color == 0, parent_path, depth, False)))
+        if seen != {i for i, row in enumerate(entries) if row is not None}:
+            _fail('cfb_directory_orphan')
+        mini_table = self._chain(_u32(data, 60), self.fat, self.sector_size,
+                                 self.sectors, self.used, count=nmini)
+        self.mini_fat = _words(mini_table)
+        self.mini = self._chain(root[6], self.fat, self.sector_size,
+                                self.sectors, self.used, size=root[7])
+        if len(self.mini) % 64:
+            _fail('cfb_ministream_geometry')
+        mini_count = len(self.mini) // 64
+        if len(self.mini_fat) < mini_count:
+            _fail('cfb_minifat_coverage')
+        for idx, value in enumerate(self.mini_fat):
+            if value not in (FREE, END) and value >= mini_count:
+                _fail('cfb_minisector_bounds')
+            if idx >= mini_count and value != FREE:
+                _fail('cfb_minifat_padding')
+        mini_used = set()
+        self.streams = {}
+        for name, start, size in streams:
+            if size < 4096:
+                blob = self._chain(start, self.mini_fat, 64, mini_count, mini_used, size=size, mini=True)
+            else:
+                blob = self._chain(start, self.fat, self.sector_size, self.sectors, self.used, size=size)
+            self.streams[name] = blob
+        if any(value != FREE and idx not in self.used for idx, value in enumerate(self.fat[:self.sectors])):
+            _fail('cfb_unowned_sector')
+        if any(value != FREE and idx not in mini_used for idx, value in enumerate(self.mini_fat)):
+            _fail('cfb_unowned_minisector')
+    def _sector(self, sid):
+        if not 0 <= sid < self.sectors:
+            _fail('cfb_sector_bounds')
+        at = (sid + 1) * self.sector_size
+        return self.data[at:at + self.sector_size]
+
+    def _claim(self, sid):
+        if not 0 <= sid < self.sectors:
+            _fail('cfb_sector_bounds')
+        if sid in self.used:
+            _fail('cfb_sector_overlap_or_cycle')
+        self.used.add(sid)
+
+    def _chain(self, start, table, unit, available, used, *, size=None, count=None,
+               limit=None, mini=False):
+        expected = (size + unit - 1) // unit if size is not None else count
+        maximum = available if limit is None else min(available, limit)
+        if expected is not None and expected > maximum:
+            _fail('cfb_chain_limit')
+        ids = []
+        sid = start
+        while sid != END:
+            self.check()
+            if not 0 <= sid < available or sid >= len(table):
+                _fail('cfb_chain_bounds')
+            if sid in used:
+                _fail('cfb_sector_overlap_or_cycle')
+            if len(ids) >= maximum or (expected is not None and len(ids) >= expected):
+                _fail('cfb_chain_length')
+            used.add(sid)
+            ids.append(sid)
+            sid = table[sid]
+        if expected is not None and len(ids) != expected:
+            _fail('cfb_chain_length')
+        value = b''.join(self.mini[sid * unit:(sid + 1) * unit] if mini else self._sector(sid) for sid in ids)
+        return value if size is None else value[:size]
+
+
+GUIDANCE = ('Publisher PUB: read_file exposes bounded 0x2C (Publisher 2002+) Contents/Quill stored text, '
+    'with document page order, page/master/dummy roles and exact page/shape/story record IDs. '
+    'Text is partial untrusted stored content, not visible layout or visual reading order. '
+    'Images, formatting, links, table cell structure and opaque metadata are not interpreted; '
+    'no rendering, OCR, Office, network or embedded code runs. 0x22/older versions, grouped or alternate shapes, '
+    'embedded objects/VBA, unknown records, malformed references and unsupported text controls refuse. '
+    'PUB creation, editing, conversion, raw overwrite and patching are unsupported. ')
+
+# libmspub MSPUBParser::getBlockDataLength; variable size includes its DWORD.
+_BLOCK_SIZE = {**dict.fromkeys((0x78, 5, 8, 10), 0),
+    **dict.fromkeys((0x10, 0x12, 0x18, 0x1a, 7), 2),
+    **dict.fromkeys((0x20, 0x22, 0x58, 0x68, 0x70, 0xb8), 4),
+    0x28: 8, 0x38: 16, 0x48: 24,
+    **dict.fromkeys((0xc0, 0x80, 0x82, 0x88, 0x8a, 0x90, 0x98, 0xa0), -1)}
+# Unknown chunks are not guessed. These known envelopes are retained only as
+# bounded opaque records (native document preferences/palette/fonts/etc).
+_CONTENT_TYPES = {1, 0x10, 0x43, 0x44, 0x46, 0x4a, 0x4b, 0x4c, 0x4f,
+                  0x54, 0x5b, 0x5c, 0x60, 0x61, 0x63, 0x65, 0x6c,
+                  0x72, 0x73, 0x77, 0x7f, 0x8a}
+_QUILL_NAMES = {b'TEXT', b'STSH', b'FDPP', b'FDPC', b'SYID', b'SGP ',
+                b'INK ', b'BTEP', b'BTEC', b'FONT', b'TCD ', b'TOKN',
+                b'STRS', b'MCLD', b'PL  '}
+_DUMMY_PAGES = {0x10d, 0x110, 0x113, 0x117}
+_STORAGES = {(), ('Objects',), ('VBA',), ('Escher',), ('Quill',), ('Quill', 'QuillSub')}
+_STREAMS = {('Contents',), ('Envelope',), ('\x01CompObj',), ('\x03Internal',),
+    ('\x05SummaryInformation',), ('\x05DocumentSummaryInformation',),
+    ('Quill', 'QuillSub', '\x01CompObj'), ('Quill', 'QuillSub', 'CONTENTS'),
+    ('Escher', 'EscherStm'), ('Escher', 'EscherDelayStm')}
+_REQUIRED = {('Contents',), ('Quill', 'QuillSub', 'CONTENTS'), ('Escher', 'EscherStm')}
+
+
+def _bounds(data, offset, size, end=None):
+    limit = len(data) if end is None else end
+    if not 0 <= offset <= limit <= len(data) or size < 0 or size > limit - offset:
+        _fail('pub_record_bounds')
+
+
+class _Parser:
+    def __init__(self, check):
+        self.check = check
+        self.records = 0
+
+    def blocks(self, data, start, end):
+        _bounds(data, start, end - start)
+        out = []
+        while start < end:
+            self.check()
+            self.records += 1
+            if self.records > MAX_RECORDS:
+                _fail('pub_record_limit')
+            _bounds(data, start, 2, end)
+            ident, kind = data[start:start + 2]
+            size = _BLOCK_SIZE.get(kind)
+            if size is None:
+                _fail('pub_block_type_unsupported')
+            payload = start + 2
+            if size == -1:
+                _bounds(data, payload, 4, end)
+                size = _u32(data, payload)
+                if size < 4:
+                    _fail('pub_block_length')
+            _bounds(data, payload, size, end)
+            value = int.from_bytes(data[payload:payload + size], 'little') if size in (2, 4) and kind not in (0x88,0x90,0xa0,0xc0,0x80,0x82,0x8a,0x98) else None
+            out.append((ident, kind, start, payload, size, value))
+            start = payload + size
+        return out
+
+    def nested(self, data, block):
+        if block[1] not in (0x88, 0x90, 0xa0):
+            _fail('pub_expected_container')
+        return self.blocks(data, block[3] + 4, block[3] + block[4])
+
+    def fields(self, blocks):
+        out = {}
+        for block in blocks:
+            if block[0] in out:
+                _fail('pub_duplicate_field')
+            out[block[0]] = block
+        return out
+
+    def scalar(self, fields, ident, kind, *, required=True):
+        block = fields.get(ident)
+        if block is None and not required:
+            return None
+        if block is None or block[1] != kind or block[5] is None:
+            _fail('pub_field_type_or_missing')
+        return block[5]
+
+    def contents(self, data):
+        _bounds(data, 0, 32)
+        if data[:4] != b'\xe8\xac\x2c\x00':
+            _fail('pub_version_unsupported')
+        if _u32(data, 8) != len(data):
+            _fail('pub_contents_length')
+        trailer = _u32(data, 0x1a)
+        _bounds(data, trailer, 4)
+        if trailer < 32 or trailer + _u32(data, trailer) != len(data):
+            _fail('pub_trailer_length')
+        parts = self.blocks(data, trailer + 4, len(data))
+        if len(parts) != 3 or [(b[0], b[1]) for b in parts] != [(1,0x20),(2,0x20),(3,0x90)]:
+            _fail('pub_trailer_profile')
+        entries = self.nested(data, parts[2])
+        if parts[0][5] != len(entries) or parts[1][5] + 1 != len(entries):
+            _fail('pub_directory_count')
+        refs = {}
+        previous = 31
+        for seq, block in enumerate(entries):
+            if block[1] == 0x78:
+                continue
+            if block[1] != 0x88:
+                _fail('pub_directory_entry')
+            fields = self.fields(self.nested(data, block))
+            if set(fields) - {2,4,5,6,8,11}:
+                _fail('pub_directory_field_unsupported')
+            kind = self.scalar(fields, 2, 0x18)
+            if kind not in _CONTENT_TYPES:
+                _fail('pub_content_type_unsupported')
+            offset = self.scalar(fields, 4, 0xb8)
+            parent = self.scalar(fields, 5, 0x68, required=False)
+            if offset <= previous:
+                _fail('pub_content_offsets')
+            _bounds(data, offset, 4, trailer)
+            size = _u32(data, offset)
+            if size < 4:
+                _fail('pub_content_length')
+            _bounds(data, offset, size, trailer)
+            if refs and next(reversed(refs.values()))['end'] > offset:
+                _fail('pub_content_overlap')
+            refs[seq] = dict(kind=kind, offset=offset, end=offset + size, parent=parent)
+            previous = offset
+        docs = [seq for seq, ref in refs.items() if ref['kind'] == 0x44]
+        if len(docs) != 1:
+            _fail('pub_document_count')
+        docseq = docs[0]
+        def fields_for(seq):
+            ref = refs[seq]
+            return self.fields(self.blocks(data, ref['offset'] + 4, ref['end']))
+        doc = fields_for(docseq)
+        if 2 not in doc or 0x12 not in doc:
+            _fail('pub_document_fields')
+        page_order = []
+        for b in self.nested(data, doc[2]):
+            if b[0] != 0 or b[1] != 0x70:
+                _fail('pub_page_order_record')
+            page_order.append(b[5])
+        if len(page_order) != len(set(page_order)) or not 1 <= len(page_order) <= MAX_PAGES:
+            _fail('pub_page_order_limit_or_duplicate')
+        pages = {seq:ref for seq,ref in refs.items() if ref['kind'] == 0x43}
+        if set(page_order) != set(pages):
+            _fail('pub_page_order_reference')
+        dimensions = self.fields(self.nested(data, doc[0x12]))
+        width = self.scalar(dimensions, 1, 0x20)
+        height = self.scalar(dimensions, 2, 0x20)
+        if not 0 < width <= 100_000_000 or not 0 < height <= 100_000_000:
+            _fail('pub_page_dimensions')
+        shape_pages = {}
+        output_pages = []
+        number = 0
+        for seq in page_order:
+            self.check()
+            ref = refs[seq]
+            if ref['parent'] != docseq:
+                _fail('pub_page_parent')
+            fields = fields_for(seq)
+            master = fields.get(0x0e)
+            if master is not None and master[1] != 0xc0:
+                _fail('pub_master_name_type')
+            is_master = master is not None and any(data[master[3]+4:master[3]+master[4]])
+            role = 'dummy_page' if seq in _DUMMY_PAGES else 'master_page' if is_master else 'page'
+            if role == 'page':
+                number += 1
+            shape_ids = []
+            if 2 in fields:
+                for b in self.nested(data, fields[2]):
+                    if b[1] != 0x70 or b[5] in shape_pages:
+                        _fail('pub_page_shape_record')
+                    shape = refs.get(b[5])
+                    if shape is None or shape['kind'] not in (1,0x10) or shape['parent'] != seq:
+                        _fail('pub_page_shape_reference')
+                    shape_pages[b[5]] = seq
+                    shape_ids.append(b[5])
+            output_pages.append(dict(kind=role, page=number if role=='page' else None,
+                page_id=seq, record_offset=ref['offset'], shape_ids=shape_ids,
+                applied_master_id=self.scalar(fields,0x0d,0x68,required=False)))
+        for page in output_pages:
+            mid = page['applied_master_id']
+            if mid is not None and not any(x['page_id']==mid and x['kind']=='master_page' for x in output_pages):
+                _fail('pub_master_reference')
+        shapes = []
+        story_ids = set()
+        for seq, ref in refs.items():
+            if ref['kind'] not in (1,0x10):
+                continue
+            if seq not in shape_pages:
+                _fail('pub_shape_unassigned')
+            fields = fields_for(seq)
+            story = self.scalar(fields,0x27,0x20,required=False)
+            if story is not None:
+                if story in story_ids:
+                    _fail('pub_linked_story_unsupported')
+                story_ids.add(story)
+            shapes.append(dict(kind='table_story' if ref['kind']==0x10 else 'shape_story',
+                shape_id=seq,page_id=shape_pages[seq],story_id=story,
+                record_offset=ref['offset']))
+        return dict(width_emu=width,height_emu=height,pages=output_pages,
+                    shapes=shapes,records=refs,normal_page_count=number)
+
+    def quill(self, data):
+        _bounds(data, 0, 32)
+        if data[:12] != b'CHNKINK \x04\x00\x07\x00':
+            _fail('pub_quill_version')
+        at = 0x18
+        seen = set()
+        regions = [(0,0x18)]
+        chunks = {}
+        while at != FREE:
+            self.check()
+            if at in seen or len(seen) >= 16:
+                _fail('pub_quill_directory_cycle_or_limit')
+            seen.add(at)
+            _bounds(data, at, 8)
+            count, next_at = _u16(data,at+2), _u32(data,at+4)
+            if count > 128 or len(chunks)+count > 256:
+                _fail('pub_quill_chunk_limit')
+            _bounds(data, at, 8+count*24)
+            regions.append((at,at+8+count*24))
+            for i in range(count):
+                pos = at + 8 + i*24
+                marker,name,ident,flag,name2,start,size = struct.unpack_from('<H4sHI4sII',data,pos)
+                if marker != 24 or flag != 1 or name not in _QUILL_NAMES or name2 not in (name,b'PLC '):
+                    _fail('pub_quill_chunk_unsupported')
+                if (name,ident) in chunks:
+                    _fail('pub_quill_duplicate_chunk')
+                _bounds(data,start,size)
+                if not size:
+                    _fail('pub_quill_chunk_empty')
+                chunks[name,ident] = (start,size)
+                regions.append((start,start+size))
+            at = next_at
+        regions.sort()
+        if any(a[1]>b[0] for a,b in zip(regions,regions[1:])):
+            _fail('pub_quill_overlap')
+        for name in (b'TEXT',b'STRS',b'SYID'):
+            if sum(k[0]==name for k in chunks)!=1 or (name,0) not in chunks:
+                _fail('pub_quill_story_chunks')
+        text_at,text_size = chunks[b'TEXT',0]
+        start,size = chunks[b'STRS',0]
+        _bounds(data,start,8,start+size)
+        count, displacement = _u32(data,start),_u32(data,start+4)
+        if not 1 <= count <= MAX_STORIES or displacement < 4:
+            _fail('pub_story_count_or_offset')
+        lengths_at = start+4+displacement
+        _bounds(data,lengths_at,4*count,start+size)
+        lengths = [_u32(data,lengths_at+4*i) for i in range(count)]
+        if sum(lengths)>MAX_TEXT_UNITS or 2*sum(lengths)!=text_size:
+            _fail('pub_story_text_length')
+        id_at,id_size = chunks[b'SYID',0]
+        _bounds(data,id_at,8,id_at+id_size)
+        if _u32(data,id_at+4)!=count or id_size!=8+4*count:
+            _fail('pub_story_id_count')
+        ids = [_u32(data,id_at+8+4*i) for i in range(count)]
+        if len(set(ids))!=count or 0 in ids:
+            _fail('pub_story_id_duplicate_or_zero')
+        stories = {}
+        for ident,length in zip(ids,lengths):
+            self.check()
+            raw = data[text_at:text_at+2*length]
+            try:
+                text = raw.decode('utf-16le')
+            except UnicodeError:
+                _fail('pub_text_encoding')
+            if any((ord(ch)<32 and ch not in '\t\r\n') or ord(ch) in (0xfffe,0xffff) for ch in text):
+                _fail('pub_text_control_unsupported')
+            stories[ident] = dict(text=text,quill_offset=text_at,utf16_units=length)
+            text_at += 2*length
+        return stories, len(chunks)
+
+
+class _Text(str):
+    def __new__(cls, value, metadata):
+        obj = super().__new__(cls, value)
+        obj.extraction_metadata = metadata
+        return obj
+
+
+def extract_pub(data, *, checkpoint=None):
+    """Read immutable bytes only; caller supplies capability/revocation checks."""
+    if not isinstance(data, bytes) or not 512 <= len(data) <= MAX_INPUT:
+        _fail('pub_input_limit')
+    deadline = time.monotonic() + 5
+    def check():
+        if checkpoint is not None:
+            checkpoint()
+        if time.monotonic() > deadline:
+            _fail('pub_deadline')
+    check()
+    cfb = _CFB(data,check)
+    if not cfb.storages <= _STORAGES or not set(cfb.streams) <= _STREAMS:
+        _fail('pub_embedded_or_unknown_storage')
+    if not _REQUIRED <= set(cfb.streams):
+        _fail('pub_required_stream')
+    if cfb.streams.get(('Envelope',), b''):
+        _fail('pub_envelope_unsupported')
+    parser = _Parser(check)
+    contents = parser.contents(cfb.streams[('Contents',)])
+    stories, quill_count = parser.quill(cfb.streams[('Quill','QuillSub','CONTENTS')])
+    if {x['story_id'] for x in contents['shapes'] if x['story_id'] is not None} != set(stories):
+        _fail('pub_story_shape_reference')
+    records = [dict(kind='document', profile='publisher_2002_plus_0x2c_stored_text_v1',
+        width_emu=contents['width_emu'],height_emu=contents['height_emu'],
+        page_count=contents['normal_page_count'])]
+    for page in contents['pages']:
+        records.append(page)
+        for shape in contents['shapes']:
+            if shape['page_id']==page['page_id']:
+                record = dict(shape, page=page['page'],page_role=page['kind'])
+                if shape['story_id'] is not None:
+                    record.update(stories[shape['story_id']])
+                records.append(record)
+    value='\n'.join(json.dumps(record,ensure_ascii=True,separators=(',',':')) for record in records)
+    if len(value.encode('utf-8')) > MAX_TEXT:
+        _fail('pub_output_limit')
+    check()
+    return _Text(value,dict(kind='native_publisher_stored_text_v1',format='pub',
+        profile='publisher_2002_plus_0x2c_stored_text_v1',semantic_status='PARTIAL',
+        source_sha256=hashlib.sha256(data).hexdigest(),content_records_untrusted=True,
+        page_count=contents['normal_page_count'],story_count=len(stories),
+        content_record_count=len(contents['records']),quill_record_count=quill_count,
+        coverage='indexed_Contents_pages_shapes_and_Quill_TEXT_STRS_SYID_only',
+        limitations=['not_rendered_or_visual_reading_order','formatting_images_links_and_metadata_not_decoded',
+                     'table_cell_structure_not_decoded','no_creation_editing_conversion_or_execution'],
+        writes_supported=False))
