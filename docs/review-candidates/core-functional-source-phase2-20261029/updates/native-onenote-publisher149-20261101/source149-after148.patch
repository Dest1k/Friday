+    def flatten(self,revisions,rid):
+        chain=[];seen=set()
+        while rid!=_NIL:
+            _require(rid in revisions and rid not in seen and len(seen)<MAX_REVISIONS,'invalid revision dependency chain')
+            self.charge()
+            seen.add(rid);rev=revisions[rid];chain.append(rev);rid=rev.parent
