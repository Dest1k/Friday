+        decoded = value.decode('utf-16-le',errors='strict')
+        if '\0' in decoded:
+            decoded, padding = decoded.split('\0', 1)
+            _require(not padding.strip('\0'), 'embedded NUL in Unicode text')
+        return decoded
+    except UnicodeError as exc:raise OneNoteError('invalid UTF-16 text') from exc
