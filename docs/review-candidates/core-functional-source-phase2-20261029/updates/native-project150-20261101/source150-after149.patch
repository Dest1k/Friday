+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Bounded inert MPP9 stored task catalog reader.
+
+Binary layouts documented by MPXJ at commit
+38f49731d3f3d5aa58998f0ed5d328eddfe41095 (see scoped_mpp.LICENSE).
+The native CFB allocation validator is specialized from scoped_msg.py.
+No Project execution, scheduling, external resolution or write support.
+"""
+from __future__ import annotations
+import hashlib
+import json
+import struct
+
+MAX_INPUT = 1_000_000
+MAX_DIRECTORY = 512
+MAX_DEPTH = 8
+MAX_RECORDS = 4096
+MAX_TASKS = 512
+MAX_TEXT = 262144
+FREE = 0xFFFFFFFF
+END = 0xFFFFFFFE
+FAT = 0xFFFFFFFD
+DIF = 0xFFFFFFFC
+MPP9_CLSID = bytes.fromhex('3a8fb774c8c8d111be1100c04fb6faf1')
+
+class MPPError(ValueError):
+    """Content-free native format refusal."""
+    @property
+    def code(self):
+        return str(self)
+
+
+def _fail(code):
+    raise MPPError(code)
+
+def _u16(data, at):
+    return struct.unpack_from('<H', data, at)[0]
+
+def _u32(data, at):
+    return struct.unpack_from('<I', data, at)[0]
+
+def _words(data):
+    return struct.unpack('<' + 'I' * (len(data) // 4), data)
+
+class _CFB:
+    def __init__(self, data, check):
+        self.check = check
+        self.check()
+        if len(data) < 512 or data[:8] != bytes.fromhex('d0cf11e0a1b11ae1'):
+            _fail('cfb_signature')
+        self.data = data
+        version = _u16(data, 26)
+        shift = _u16(data, 30)
+        if (data[8:24] != b'\0' * 16 or _u16(data, 24) != 0x003E or version not in (3, 4)
+                or _u16(data, 28) != 0xFFFE or shift != (9 if version == 3 else 12)
+                or _u16(data, 32) != 6 or data[34:40] != b'\0' * 6
+                or _u32(data, 56) != 4096):
+            _fail('cfb_header')
+        self.sector_size = 1 << shift
+        if (len(data) % self.sector_size or len(data) < self.sector_size * 3
+                or any(data[512:self.sector_size])):
+            _fail('cfb_geometry')
+        self.sectors = len(data) // self.sector_size - 1
+        self.used = set()
+        ndir, nfat = _u32(data, 40), _u32(data, 44)
+        nmini, ndif = _u32(data, 64), _u32(data, 72)
+        if ((version == 3 and ndir != 0) or not 1 <= nfat <= self.sectors
+                or nmini > self.sectors or ndif > self.sectors):
+            _fail('cfb_allocation_count')
+        fat_ids = []
+        saw_free = False
+
+        def add_fat_ids(items):
+            nonlocal saw_free
+            for sid in items:
+                if sid == FREE:
+                    saw_free = True
+                else:
