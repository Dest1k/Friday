+def _plain(value):
+    if type(value) is not str or not value or len(value) > 4096:
+        _fail('project_name_text_required')
+    if any(ord(c) < 32 or ord(c) == 127 or c in '\x85\u2028\u2029' for c in value):
+        _fail('project_name_single_line_required')
+    try:
+        return value.encode('utf-16le')
+    except UnicodeError:
+        _fail('project_name_encoding')
+
+def _ids(first, table, count, check):
+    result = []
+    seen = set()
+    sid = first
+    for _ in range(count):
+        check()
+        if not 0 <= sid < len(table) or sid in seen:
+            _fail('project_write_chain_bounds')
+        result.append(sid); seen.add(sid); sid = table[sid]
+    if sid != mpp.END:
+        _fail('project_write_chain_length')
+    return result
+
+def _physical_offsets(cfb, path, start, size, check):
+    entry = cfb.directory_records[path]
+    stream_size = mpp._u32(entry, 120)
+    if start < 0 or size < 0 or start + size > stream_size:
+        _fail('project_name_patch_bounds')
+    first = mpp._u32(entry, 116)
+    if stream_size < 4096:
+        units = _ids(first, cfb.mini_fat, (stream_size + 63) // 64, check)
+        root = cfb.directory_records[()]
+        root_size = mpp._u32(root, 120)
+        roots = _ids(mpp._u32(root, 116), cfb.fat,
+                     (root_size + cfb.sector_size - 1) // cfb.sector_size, check)
+        for at in range(start, start + size):
+            logical = units[at // 64] * 64 + at % 64
+            if logical >= root_size:
+                _fail('project_write_mini_bounds')
+            yield (roots[logical // cfb.sector_size] + 1) * cfb.sector_size + logical % cfb.sector_size
+    else:
+        units = _ids(first, cfb.fat, (stream_size + cfb.sector_size - 1) // cfb.sector_size, check)
+        for at in range(start, start + size):
+            yield (units[at // cfb.sector_size] + 1) * cfb.sector_size + at % cfb.sector_size
+
+def edit_task_name(data, spec, *, checkpoint=None):
+    """Change exactly one catalog leaf task name of equal UTF-16 length."""
+    check = checkpoint or (lambda: None)
+    check()
+    if type(spec) is not dict or set(spec) != {'source_sha256','unique_id','old_text','new_text'}:
+        _fail('project_edit_schema')
+    expected = spec['source_sha256']
+    if type(expected) is not str or re.fullmatch(r'[0-9a-f]{64}', expected) is None:
+        _fail('project_source_hash_required')
+    if type(data) is not bytes or not 512 <= len(data) <= mpp.MAX_INPUT:
+        _fail('project_edit_input_limit')
+    if hashlib.sha256(data).hexdigest() != expected:
+        _fail('project_source_hash_mismatch')
+    uid = spec['unique_id']
+    if type(uid) is not int or not 1 <= uid <= 65535:
+        _fail('project_non_summary_task_required')
+    old, new = _plain(spec['old_text']), _plain(spec['new_text'])
+    if old == new:
+        _fail('project_edit_no_change')
+    if len(old) != len(new):
+        _fail('project_equal_utf16_length_required')
+    before = [json.loads(line) for line in mpp.extract_mpp(data, checkpoint=check).split('\n') if line]
+    matches = [row for row in before[1:] if row['unique_id'] == uid]
+    if len(matches) != 1 or matches[0]['name'] != spec['old_text']:
+        _fail('project_task_precondition_mismatch')
+    if any(item['parent_unique_id'] == uid for item in before[1:]):
+        _fail('project_non_summary_task_required')
+    row = matches[0]
+    cfb = mpp._CFB(data, check)
+    values = mpp._variable(cfb.streams[TASK + ('VarMeta',)], cfb.streams[TASK + ('Var2Data',)], check)
+    offset = row['name_offset']
+    aliases = [item for item in values.values() if item[0] == offset]
+    if len(aliases) != 1 or aliases[0][1] != old + b'\0\0':
+        _fail('project_task_name_alias_or_mismatch')
+    positions = list(_physical_offsets(cfb, TASK + ('Var2Data',), offset + 4, len(old), check))
+    if len(set(positions)) != len(old) or bytes(data[p] for p in positions) != old:
+        _fail('project_task_name_mapping_mismatch')
+    output = bytearray(data)
+    for pos, byte in zip(positions, new):
+        check(); output[pos] = byte
+    output = bytes(output)
+    after = [json.loads(line) for line in mpp.extract_mpp(output, checkpoint=check).split('\n') if line]
+    wanted = [dict(item) for item in before]
+    for item in wanted[1:]:
+        if item['unique_id'] == uid:
+            item['name'] = spec['new_text']
+    if after != wanted or len(output) != len(data):
+        _fail('project_edit_postcondition_failed')
+    allowed = set(positions)
+    if any(a != b and i not in allowed for i, (a,b) in enumerate(zip(data, output))):
+        _fail('project_unselected_bytes_changed')
+    check()
+    return output
+
+GUIDANCE = (' MPP task-name edit: write_file format=mpp_task_name_edit to a NEW .mpp path with JSON exactly '
+            '{"source":"project.mpp","source_sha256":"<current read_file SHA256>","unique_id":1,'
+            '"old_text":"Task #1","new_text":"Task #2"}. Select one existing leaf task by its native unique_id '
+            '(nonzero ID and no children in the decoded catalog), not its displayed ordinal. Native summary flags are not interpreted. '
+            'The old name must match exactly. The new single-line Unicode name must have the same UTF-16 byte length; all other source bytes remain unchanged. Source stays untouched. '
+            'No task creation/deletion, scheduling, dates, dependencies, template editing, conversion or overwrite. ')
