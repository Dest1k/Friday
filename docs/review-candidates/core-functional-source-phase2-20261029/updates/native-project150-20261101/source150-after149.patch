+"""Own-workspace MPP9 task-name edits published as verified new files."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_communication import _object
+from hermes_cli.friday_workspace_zip import _source, _verify, _path, _inline_budget, _fits, _capacity, _encode
+from tools.scoped_mpp import MPPError
+from tools.scoped_mpp_write import edit_task_name
+
+def execute(cap, fd, leaf, path, content):
+    _check_parent(cap, fd, path)
+    if PurePosixPath(path).suffix.lower() != '.mpp' or PurePosixPath(path).name != leaf:
+        raise ScopeDenied()
+    checkpoint = lambda: check(cap)
+    try:
+        spec = _object(content)
+        if type(spec) is not dict or set(spec) != {'source','source_sha256','unique_id','old_text','new_text'}:
+            raise MPPError('project_edit_schema')
+        source = _path(spec['source'])
+        if PurePosixPath(source).suffix.lower() != '.mpp' or source == path:
+            raise ScopeDenied()
+        original, identity = _source(cap, source)
+        sources = [(source, original, identity)]
+        data = edit_task_name(original, {k:spec[k] for k in ('source_sha256','unique_id','old_text','new_text')}, checkpoint=checkpoint)
+    except MPPError as error:
+        return _encode({'success':False,'error':'project_edit_refused','reason':error.code,'effect_disposition':'none'})
+    receipt = {'operation':'mpp_task_name_edit','profile':'mpp9_same_size_task_name',
+               'source':source,'source_sha256':hashlib.sha256(original).hexdigest(),
+               'source_unchanged':True,'other_bytes_preserved':True,'unique_id':spec['unique_id'],
+               'replacements':1,'task_selection':'nonzero_uid_no_catalog_children',
+               'project_application_interoperability':'NOT_TESTED',
+               'scheduling_recalculated':False}
+    estimate = dict(receipt,success=True,path=path,format='mpp',scope='own_user_workspace',
+                    create_only=True,verified=True,bytes_written=len(data),sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate,_inline_budget()):return _capacity(_inline_budget())
+    _verify(cap,sources)
+    answer = json.loads(_create_bytes(cap,fd,leaf,path,data,output_format='mpp',verify_source=lambda:_verify(cap,sources)))
+    if answer.get('success'):answer.update(receipt)
+    return _encode(answer)
