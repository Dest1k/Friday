+    def get_session_recall_page(self, session_id: str, head: int = 20,
+                                tail: int = 10) -> Dict[str, Any]:
+        """Active head/tail plus exact count in one SQLite read snapshot.
+
+        The edge queries select only IDs. Message payloads are fetched after
+        LIMIT, so retained middle rows are never decoded just to omit them.
+        This preserves the existing read-mode active-only visibility policy.
+        """
+        if type(head) is not int or type(tail) is not int or not 1 <= head <= 30 or not 0 <= tail <= 30:
+            raise ValueError('invalid recall page bounds')
+        sql = """WITH
+            first_ids AS (SELECT id FROM messages WHERE session_id = ? AND active = 1 ORDER BY id LIMIT ?),
+            last_ids AS (SELECT id FROM messages WHERE session_id = ? AND active = 1 ORDER BY id DESC LIMIT ?),
+            selected_ids AS (SELECT id FROM first_ids UNION SELECT id FROM last_ids),
+            totals AS (SELECT COUNT(*) AS recall_count FROM messages WHERE session_id = ? AND active = 1)
+            SELECT m.*, totals.recall_count FROM messages m
+            JOIN selected_ids x ON x.id = m.id CROSS JOIN totals ORDER BY m.id"""
+        rows = self._read_all(sql, (session_id, head, session_id, tail, session_id))
+        total = rows[0]['recall_count'] if rows else 0
+        messages = []
+        for row in rows:
+            clean = dict(row)
+            clean.pop('recall_count')
+            messages.append(self._row_to_message_dict(clean, warn_context='session_recall_page', summary_flag=True))
+        return {'messages': messages, 'message_count': total, 'truncated': total > head + tail}
 
