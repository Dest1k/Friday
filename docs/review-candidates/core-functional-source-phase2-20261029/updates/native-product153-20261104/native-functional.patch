+"""Create-only password-protected OOXML edits using existing native editors.
+
+The opening password never grants permission to ignore a native edit lock.
+Decrypted package bytes stay in memory; only a verified encrypted derivative
+reaches the existing source-CAS/NOREPLACE publication boundary.
+"""
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import re
+from xml.etree import ElementTree as ET
+from xml.parsers.expat import ExpatError
+import zipfile
+
+from tools.scoped_ooxml_password import (
+    FORMATS, MAX_XML, OOXMLPasswordError, prepare_read,
+)
+
+GUIDANCE = (
+    'Protected OOXML edit: use write_file format=ooxml_password_edit into a NEW name '
+    'with the SAME extension, content JSON {"source":"input.docx",'
+    '"source_sha256":"<encrypted source hash from read_file>",'
+    '"password":"<supplied password>","edit":{"old_text":"Old","new_text":"New"}}. '
+    'DOCX/DOTX/DOCM/DOTM use exact unique old_text/new_text; '
+    'XLSX/XLTX/XLSM/XLTM use {"sheet":"Sheet1","cell":"A1","expected":1,"value":2} '
+    'with the native cell types, never numeric strings for numeric cells; '
+    'PPTX/POTX/PPSX/PPTM/POTM/PPSM use {"slide":1,"role":"slide","old_text":"Old","new_text":"New"}. '
+    'Only the existing bounded native editor profiles are supported. '
+    'The original remains unchanged; the derivative is encrypted with the same supplied '
+    'password and fresh keys/salts. Never put passwords in names, prose, or receipts. '
+    'An opening password does not authorize removing native edit restrictions: '
+    'locked, restricted, unsupported encryption, missing/wrong password and XLSB edits refuse. '
+    'No plaintext export, conversion, macro execution or visual/application validation is implied. '
+)
+
+
+def _refuse(reason):
+    raise OOXMLPasswordError(reason)
+
+
+def _request(content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    if type(content) is not str:
+        raise ScopeDenied()
+    try:
+        if len(content.encode('utf-8')) > 100_000:
+            raise ScopeDenied()
+        def pairs(items):
+            value = {}
+            for key, item in items:
+                if key in value:
+                    raise ScopeDenied()
+                value[key] = item
+            return value
+        value = json.loads(content, object_pairs_hook=pairs,
+            parse_constant=lambda _: (_ for _ in ()).throw(ScopeDenied()))
+    except (ValueError, RecursionError, UnicodeError):
+        raise ScopeDenied() from None
+    required = {'source', 'source_sha256', 'edit'}
+    if type(value) is not dict or set(value) not in (required, required | {'password'}):
+        raise ScopeDenied()
+    value.setdefault('password', None)
+    if (type(value['source']) is not str or not 1 <= len(value['source']) <= 4096
+            or '\x00' in value['source'] or type(value['edit']) is not dict):
+        raise ScopeDenied()
+    if type(value['source_sha256']) is not str or not re.fullmatch('[0-9a-f]{64}', value['source_sha256']):
+        _refuse('source_hash_required')
+    return value
+
+
+def _edit_permission(data, checkpoint):
+    """Conservatively reject native restrictions before the existing editor.
+
+    Some plain-text editors preserve a lock without enforcing it. This new
+    protected route must not use an opening password to bypass that lock.
+    Empty/advisory protection elements also remain refused, rather than
+    guessing that their producer intended to authorize editing.
+    """
+    from tools.scoped_word_profiles import _xml, WordProfileError
+    w = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main'
+    s = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main'
+    p = 'http://schemas.openxmlformats.org/presentationml/2006/main'
+    a = 'http://schemas.openxmlformats.org/drawingml/2006/main'
+    ep = 'http://schemas.openxmlformats.org/officeDocument/2006/extended-properties'
+    forbidden = {f'{{{w}}}{name}' for name in ('documentProtection', 'writeProtection')}
+    forbidden |= {f'{{{s}}}{name}' for name in (
+        'sheetProtection', 'workbookProtection', 'protectedRanges', 'fileSharing')}
+    forbidden |= {f'{{{p}}}{name}' for name in ('modifyVerifier', 'presentationProtection')}
+    try:
+        with zipfile.ZipFile(io.BytesIO(data)) as archive:
+            for info in archive.infolist():
+                checkpoint()
+                if not info.filename.lower().endswith(('.xml', '.rels')):
+                    continue
+                if info.file_size > MAX_XML:
+                    _refuse('ooxml_edit_xml_limit')
