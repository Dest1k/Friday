+def _bound_provenance(result):
+    """Bound added provenance without cutting an observation or changing selected rows.
+
+    The caller repeats this on the final success envelope so paths and receipt fields
+    count toward the same declared write_file result budget. Legacy selected fields
+    are omitted only as whole records when their own size exceeds the budget; counts
