+        return _publish(cap, fd, leaf, path, result, 'ooxml_password_edit', (source, data, identity),
+            {'source': relative, 'source_sha256': spec['source_sha256'], 'source_unchanged': True,
+             'output_profile': profile, 'encrypted': True, 'password_verified': True,
+             'same_password': True, 'encryption_parameters_preserved': True,
+             'data_integrity_verified': True, 'decrypted_output_published': False,
+             'preserving_edit': True, 'macros_executed': False, 'macro_security_verified': False})
+    except ScopeDenied:
