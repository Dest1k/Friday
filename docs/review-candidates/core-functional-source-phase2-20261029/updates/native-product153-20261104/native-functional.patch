+"""Still-image accounting for the observed local Qwen deployment only.
+
+The 2026-11-04 deployment profile is SHA256
+e4194d2f3fd6b4cf4cc11a12bfd455ea8658b2b2be42d8910c4c875e23b5f2b9.
+Qwen3VLProcessor / Qwen2VLImageProcessor, torchvision, patch16/merge2/
+temporal2, size min65536/max16777216: each still image has at most
+16384 image tokens plus two vision wrapper tokens. We deliberately charge
+that proven maximum, not a pixel/token heuristic or an exact tokenizer count.
+This route pin is not a live attestation of remote loaded code. Deploying a
+different server/processor/config requires reviewing this profile again.
+"""
+from __future__ import annotations
+
+import base64
+import binascii
+from io import BytesIO
+import warnings
+
+PROFILE_SHA256 = "e4194d2f3fd6b4cf4cc11a12bfd455ea8658b2b2be42d8910c4c875e23b5f2b9"
+_ROUTE = ("custom:friday-local", "qwen38-flash-next-abliterated", "http://192.168.1.195:30000/v1")
+_IMAGE_TOKENS = 16384 + 2
+# Same limits as tools.vision_tools._MAX_BASE64_BYTES and
+# tools.vision_tools_image_prep._VISION_MAX_VALIDATED_AGGREGATE_PIXELS.
+_MAX_DATA_URL_BYTES = 20 * 1024 * 1024
+_MAX_PIXELS = 100_000_000
+_MIME_FORMAT = {"data:image/png;base64,": "PNG", "data:image/jpeg;base64,": "JPEG"}
+
+# Closed request shape: every admitted non-image value is still byte-priced.
+# No image/video/server processor options can silently expand the profile.
+_BODY_KEYS = frozenset({
+    "model", "messages", "max_tokens", "max_completion_tokens", "temperature",
+    "top_p", "top_k", "min_p", "frequency_penalty", "presence_penalty",
+    "repetition_penalty", "seed", "stop", "stream", "stream_options", "n",
+    "tools", "tool_choice", "modalities", "response_format", "reasoning",
+    "reasoning_effort", "chat_template_kwargs",
+})
+_EXTRA_KEYS = _BODY_KEYS - {"model", "messages", "tools", "tool_choice", "modalities"}
+
+
+def _image_pixels(url):
+    from agent.bounded_context import BoundedContextError
+    if not isinstance(url, str) or len(url) > _MAX_DATA_URL_BYTES:
+        raise BoundedContextError("bounded_context: inline image exceeds media byte limit")
+    prefix = next((p for p in _MIME_FORMAT if url.startswith(p)), None)
+    if prefix is None:
+        raise BoundedContextError("bounded_context: only inline PNG/JPEG still images are supported")
+    try:
+        from PIL import Image, ImageFile
+    except ImportError as exc:
+        raise BoundedContextError("bounded_context: image decoder unavailable") from exc
+    try:
+        data = base64.b64decode(url[len(prefix):], validate=True)
+        # A global permissive decoder could otherwise admit a truncated image.
+        if ImageFile.LOAD_TRUNCATED_IMAGES:
+            raise ValueError("permissive image decoder")
+        with warnings.catch_warnings():
+            warnings.simplefilter("error", Image.DecompressionBombWarning)
+            with Image.open(BytesIO(data)) as image:
+                width, height = image.size
+                if (image.format != _MIME_FORMAT[prefix] or getattr(image, "n_frames", 1) != 1
+                        or width <= 0 or height <= 0 or width * height > _MAX_PIXELS
+                        or max(width, height) / min(width, height) > 200):
+                    raise ValueError("unsupported image geometry or format")
+                image.verify()
+            with Image.open(BytesIO(data)) as image:
+                image.load()
+        return width * height
+    except (OSError, ValueError, SyntaxError, binascii.Error,
+            Image.DecompressionBombError, Image.DecompressionBombWarning) as exc:
+        raise BoundedContextError("bounded_context: invalid or unsupported inline still image") from exc
+
+
+def account_still_images(policy, request, image_budget):
+    """Validate without I/O and replace only base64 payloads in a private view."""
+    from agent.bounded_context import BoundedContextError, BoundedContextOverflowError, wire_body
+    from hermes_cli.route_identity import normalize_route_base_url
+    if (policy.provider, policy.model, normalize_route_base_url(policy.base_url)) != _ROUTE:
+        raise BoundedContextError("bounded_context: no still-image profile for this route")
+    extra = request.get("extra_body", {})
+    body = wire_body(request)
+    if request.get("extra_query") or set(extra) - _EXTRA_KEYS or set(body) - _BODY_KEYS:
+        raise BoundedContextError("bounded_context: unaccounted vision request override")
+    template = body.get("chat_template_kwargs", {})
+    if (not isinstance(template, dict) or set(template) - {"enable_thinking", "preserve_thinking"}
+            or any(type(value) is not bool for value in template.values())):
+        raise BoundedContextError("bounded_context: unsupported vision template override")
+    if body.get("n", 1) != 1 or body.get("tools") or body.get("tool_choice") not in (None, "none"):
+        raise BoundedContextError("bounded_context: vision is one text response without tools")
+    rows = body.get("messages")
+    if not isinstance(rows, list) or not rows:
+        raise BoundedContextError("bounded_context: nonempty vision messages required")
+    view, count, pixels, media_bytes = [], 0, 0, 0
+    for row in rows:
+        if (not isinstance(row, dict) or set(row) - {"role", "content", "name"}
+                or row.get("role") not in {"system", "developer", "user", "assistant"}):
+            raise BoundedContextError("bounded_context: unsupported vision message")
+        content = row.get("content")
+        if isinstance(content, str) or content is None:
+            view.append(dict(row))
+            continue
+        if not isinstance(content, list):
+            raise BoundedContextError("bounded_context: invalid vision content")
+        blocks = []
+        for block in content:
+            if (isinstance(block, dict) and set(block) == {"type", "text"}
+                    and block.get("type") == "text" and isinstance(block.get("text"), str)):
+                blocks.append(dict(block))
+                continue
+            if (not isinstance(block, dict) or set(block) != {"type", "image_url"}
+                    or block.get("type") != "image_url" or row["role"] != "user"):
+                raise BoundedContextError("bounded_context: unsupported vision media block")
+            media = block["image_url"]
+            if (not isinstance(media, dict) or set(media) - {"url", "detail"}
+                    or media.get("detail", "auto") != "auto"):
+                raise BoundedContextError("bounded_context: unsupported image options")
+            count += 1
+            if count * _IMAGE_TOKENS > image_budget:
+                raise BoundedContextOverflowError("bounded_context: image token bound exceeds input budget")
+            url = media.get("url")
+            if not isinstance(url, str):
+                raise BoundedContextError("bounded_context: inline image URL required")
+            media_bytes += len(url)
+            if media_bytes > _MAX_DATA_URL_BYTES:
+                raise BoundedContextError("bounded_context: aggregate image bytes exceed media byte limit")
+            pixels += _image_pixels(url)
+            if pixels > _MAX_PIXELS:
+                raise BoundedContextError("bounded_context: aggregate image pixels exceed media limit")
+            # Keep the complete JSON envelope; omit only the binary encoding,
+            # which the server replaces with the separately reserved image span.
+            blocks.append({**block, "image_url": {**media, "url": ""}})
+        view.append({**row, "content": blocks})
+    if count == 0:
+        raise BoundedContextError("bounded_context: vision requires an inline still image")
+    return {**body, "messages": view}, {
+        "image_count": count, "image_tokens_upper_bound": count * _IMAGE_TOKENS,
+        "image_profile_sha256": PROFILE_SHA256,
+        "verification_scope": "observed_local_deployment_profile_not_live_remote_attestation",
+    }
