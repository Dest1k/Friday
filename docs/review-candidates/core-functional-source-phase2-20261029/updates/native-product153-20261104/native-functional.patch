+                for node in root.iter():
+                    if node.tag in forbidden:
+                        _refuse('native_edit_restriction')
+                    if node.tag == f'{{{ep}}}DocSecurity' and (node.text or '').strip() != '0':
+                        _refuse('native_edit_restriction')
+                    if node.tag == f'{{{w}}}lock' and node.get(f'{{{w}}}val') != 'unlocked':
+                        _refuse('native_edit_restriction')
+                    if node.tag.startswith(f'{{{a}}}') and node.get('noTextEdit', '0') not in ('0', 'false'):
