+def protect_like(original, clear, password, *, format, checkpoint=None):
+    """Authenticate original; encrypt replacement ZIP with its exact suite.
+
+    Returns encrypted bytes only. Uses the supplied password once per bounded
+    derivation, fresh random salts/verifier/package key/HMAC key, and the
+    original independent keyData/password AES bit sizes, hashes and spin count.
+    The existing reader authenticates and compares the final clear bytes before
+    output is returned. No I/O, callbacks other than checkpoint, or metadata.
+    """
