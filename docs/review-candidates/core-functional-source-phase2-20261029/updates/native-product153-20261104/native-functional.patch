+"""Memory-only re-protection for the bounded OOXML Agile reader profile.
+
+AES is provided by installed Cryptodome. CFB writing is limited to the exact
+six streams and four storages accepted by scoped_ooxml_password; no generic
+container or cryptographic implementation is included. Secrets and clear ZIP
+bytes never leave this function except inside the returned encrypted envelope.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import secrets
+import struct
+from xml.etree import ElementTree as ET
+
+from tools import scoped_ooxml_password as _read
+
+
+def _encrypt(value, key, iv):
+    try:
+        from Cryptodome.Cipher import AES
+    except ImportError:
+        _read._fail('ooxml_encryption_crypto_unavailable')
+    value = value.ljust(_read._round_block(len(value)), b'\0')
+    return AES.new(key, AES.MODE_CBC, iv).encrypt(value)
+
+
+def _cfb(streams, check):
+    """Write only the reader's fixed envelope, with canonical v3 geometry."""
+    _read._dataspaces(streams, _read._STORAGES)
+    paths = [()] + sorted(_read._STORAGES | set(streams), key=lambda p: (len(p), p))
+    ids = {p: i for i, p in enumerate(paths)}
+    rows = [bytearray(128) for _ in paths]
