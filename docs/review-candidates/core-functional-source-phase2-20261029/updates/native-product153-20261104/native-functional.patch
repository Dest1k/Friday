+        raise OOXMLPasswordError(str(error)) from None
+    except (zipfile.BadZipFile, ET.ParseError, ExpatError, KeyError, UnicodeError):
+        _refuse('ooxml_edit_package_invalid')
+
+
+def _native_edit(clear, profile, edit, checkpoint):
+    """Only existing same-profile pure editors; no application or conversion."""
+    from tools.scoped_word_profiles import WordProfileError, render_edit
+    from tools.scoped_presentation_write import PresentationRefused
+    from tools.scoped_presentation_variants import PresentationRefused as VariantRefused
+    from tools.scoped_odt import ODTError
+    from tools.scoped_ods import ODSError
+    try:
+        if profile in ('docx', 'dotx', 'docm', 'dotm'):
+            if set(edit) != {'old_text', 'new_text'}:
+                _refuse('ooxml_word_edit_schema')
+            if profile in ('docm', 'dotm'):
+                from tools.scoped_word_macro_edit import edit_text
+                return edit_text(clear, profile, edit, checkpoint=checkpoint)[0]
+            return render_edit(clear, edit['old_text'], edit['new_text'], profile, checkpoint=checkpoint)
+        if profile in ('xlsx', 'xltx', 'xlsm', 'xltm'):
+            if set(edit) != {'sheet', 'cell', 'expected', 'value'}:
+                _refuse('ooxml_spreadsheet_edit_schema')
+            from tools.scoped_spreadsheet_profiles import edit as edit_sheet
+            spec = dict(edit)
+            if profile in ('xlsm', 'xltm'):
+                # The existing macro editor binds its immediate plaintext
+                # input; the outer request binds the original ciphertext.
+                spec['source_sha256'] = hashlib.sha256(clear).hexdigest()
+            return edit_sheet(clear, profile, spec, checkpoint=checkpoint)
+        if profile in ('pptx', 'potx', 'ppsx', 'pptm', 'potm', 'ppsm'):
+            if set(edit) != {'slide', 'role', 'old_text', 'new_text'}:
+                _refuse('ooxml_presentation_edit_schema')
+            if profile in ('pptm', 'potm', 'ppsm'):
+                from tools.scoped_presentation_macro_edit import edit_text
+                return edit_text(clear, profile, edit, checkpoint=checkpoint)[0]
+            from tools.scoped_presentation_text import edit_text
+            checkpoint()
+            result = edit_text(clear, profile, edit)
+            checkpoint()
+            return result
+        # The binary XLSB writer has a narrower profile. Opening an encrypted
+        # arbitrary XLSB does not establish its binary native edit permission.
+        _refuse('protected_xlsb_edit_permission_unsupported')
+    except (WordProfileError, PresentationRefused, VariantRefused, ODTError, ODSError) as error:
+        raise OOXMLPasswordError(str(error)) from None
+
+
+def render_edit(data, profile, password, edit, *, checkpoint=None):
+    check = checkpoint if checkpoint is not None else lambda: None
+    check()
+    if type(edit) is not dict:
+        _refuse('ooxml_edit_schema')
+    clear, metadata = prepare_read(data, profile, password, checkpoint=check)
+    if metadata is None:
+        _refuse('ooxml_encrypted_source_required')
+    if profile == 'xlsb':
+        _refuse('protected_xlsb_edit_permission_unsupported')
+    _edit_permission(clear, check)
+    rendered = _native_edit(clear, profile, edit, check)
+    check()
+    from tools.scoped_ooxml_password_edit import protect_like
+    protected = protect_like(data, rendered, password, format=profile, checkpoint=check)
+    check()
+    return protected
+
+
+def create_edit(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    try:
+        check(cap)
+        _check_parent(cap, fd, path)
+        spec = _request(content)
+        profile = Path(spec['source']).suffix.lower().lstrip('.')
+        if (profile not in FORMATS or Path(path).suffix.lower() != '.' + profile
+                or Path(path).name != leaf):
+            _refuse('ooxml_edit_output_profile_mismatch')
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
