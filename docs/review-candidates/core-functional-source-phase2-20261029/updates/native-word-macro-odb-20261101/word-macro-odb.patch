+"""Bounded, non-executing OpenDocument database declaration view.
+
+This reads ODF XML declarations, never a database engine. Table representations
+are not schemas; schemas are not stored rows. Embedded HSQL/Firebird payloads,
+SQL text, credentials, connection settings and component bodies remain opaque.
+"""
+from __future__ import annotations
+
+import io
+import json
+import re
+import struct
+import zipfile
+
+from tools.scoped_odf_profiles import _preflight_package, _root, ODFProfileError
+
+O = 'urn:oasis:names:tc:opendocument:xmlns:office:1.0'
+D = 'urn:oasis:names:tc:opendocument:xmlns:database:1.0'
+M = 'urn:oasis:names:tc:opendocument:xmlns:manifest:1.0'
+XL = 'http://www.w3.org/1999/xlink'
+MIME = 'application/vnd.oasis.opendocument.database'
+MAX_RECORDS = 4096
+MAX_NAME = 256
+MAX_OUTPUT = 1_000_000
+REDACTED = '[redacted]'
+
+
+def q(namespace, local):
+    return '{' + namespace + '}' + local
+
+
+class ODBError(ValueError):
+    """Fixed, content-free refusal code."""
+
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+class DatabaseText(str):
+    def __new__(cls, text, metadata):
+        value = super().__new__(cls, text)
+        value.extraction_metadata = metadata
+        return value
+
+
+def _fail(code):
+    raise ODBError(code)
+
+
+def _tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+def _safe_path(name):
+    key = name.rstrip('/')
+    return bool(key and not name.startswith('/')
+                and not any(c in name for c in '\\:%?#')
+                and not any(ord(c) < 32 for c in name)
+                and all(part not in ('', '.', '..') for part in key.split('/')))
+
+
+def _load(data, checkpoint):
+    try:
+        parts, xml_names = _preflight_package(data, checkpoint)
+        if parts.get('mimetype') != MIME.encode('ascii'):
+            _fail('not_native_odb')
+        with zipfile.ZipFile(io.BytesIO(data)) as archive:
+            info = archive.getinfo('mimetype')
+            local_extra_size = struct.unpack_from('<H', data, info.header_offset + 28)[0]
+            if (info.header_offset != 0 or info.compress_type != zipfile.ZIP_STORED
+                    or info.extra or local_extra_size):
+                _fail('not_native_odb')
+        roots = {name: _root(parts[name], checkpoint) for name in sorted(xml_names)}
+    except ODFProfileError as error:
+        raise ODBError(error.code) from None
+    manifest = roots.get('META-INF/manifest.xml')
+    if manifest is None or manifest.tag != q(M, 'manifest'):
+        _fail('manifest_missing_or_namespace')
+    declarations = {}
+    seen = set()
+    for entry in manifest:
+        _tick(checkpoint)
+        if entry.tag != q(M, 'file-entry'):
+            _fail('manifest_structure')
+        name = entry.get(q(M, 'full-path'), '')
+        key = name.rstrip('/').casefold()
+        if not name or key in seen:
+            _fail('duplicate_or_invalid_manifest_entry')
+        seen.add(key)
+        if name != '/' and not _safe_path(name):
+            _fail('unsafe_manifest_entry')
+        if name != '/' and not name.endswith('/') and name not in parts:
+            _fail('manifest_target_missing')
+        if any(node.tag == q(M, 'encryption-data') for node in entry.iter()):
+            _fail('encrypted_package')
+        declarations[name] = entry.get(q(M, 'media-type'), '')
+    if declarations.get('/') != MIME or 'content.xml' not in declarations:
+        _fail('manifest_type_or_content')
+    if any(name not in declarations for name in parts
+           if name not in ('mimetype', 'META-INF/manifest.xml')):
+        _fail('undeclared_package_member')
+    if declarations['content.xml'] != 'text/xml':
+        _fail('content_media_type')
+    content = roots.get('content.xml')
+    if content is None or content.tag != q(O, 'document-content'):
+        _fail('content_missing_or_namespace')
+    bodies = content.findall(q(O, 'body'))
+    if len(bodies) != 1 or len(bodies[0]) != 1 or bodies[0][0].tag != q(O, 'database'):
+        _fail('not_native_odb')
+    return parts, roots, bodies[0][0]
+
+
+class _View:
+    def __init__(self, database, checkpoint):
+        self.checkpoint = checkpoint
+        self.count = 0
+        self.redacted = False
+        self.uninterpreted = False
+        self.sensitive = set()
+        # Prevent known connection/credential values from leaking through an
+        # identifier duplicated elsewhere. Never include these values in errors.
+        for source in database.findall(q(D, 'data-source')):
+            for node in source.iter():
+                _tick(checkpoint)
+                values = [value for attr, value in node.attrib.items()
+                          if attr == q(XL, 'href') or attr.rsplit('}', 1)[-1] in
+                          ('user-name', 'password', 'host-name', 'hostname',
+                           'database-name', 'local-socket')]
+                if node.tag == q(D, 'data-source-setting'):
+                    values.extend(value for child in node.iter()
+                                  for value in [*child.attrib.values(), child.text or ''])
+                for value in values:
+                    if value.strip():
+                        self.sensitive.add(value.strip())
+        # SQL and component references are withheld too. Collect before reading
+        # any identifiers, so a later declaration cannot disclose a value by
+        # duplicating it in an earlier object's name.
+        for node in database.iter():
+            _tick(checkpoint)
+            for attr in (q(D, 'command'), q(XL, 'href')):
+                value = node.get(attr, '').strip()
+                if value:
+                    self.sensitive.add(value)
+        self.sensitive_lengths = {len(value) for value in self.sensitive
+                                  if len(value) <= MAX_NAME}
+
+    def record(self):
+        _tick(self.checkpoint)
+        self.count += 1
+        if self.count > MAX_RECORDS:
+            _fail('record_limit')
+
+    def name(self, node, attribute='name', required=True):
+        value = node.get(q(D, attribute))
+        if value is None:
+            if required:
+                _fail('missing_declared_name')
+            return None
+        if not value or len(value) > MAX_NAME or any(ord(c) < 32 for c in value):
+            _fail('invalid_or_long_declared_name')
+        # This is intentionally conservative: do not echo URI-looking values,
+        # login assignments or known secrets as object names or SQL type names.
+        # Bounded by MAX_NAME: also block a known value wrapped in punctuation
+        # or an innocent-looking prefix/suffix, without scanning each setting
+        # for each identifier or returning any part of those settings.
+        if (any(value[start:start + size] in self.sensitive
+                for size in self.sensitive_lengths if size <= len(value)
+                for start in range(len(value) - size + 1))
+                or re.search(r'[/\\:@?#]|\b(?:password|passwd|token|secret|user(?:name)?)\s*=', value, re.I)):
+            self.redacted = True
+            return REDACTED
+        return value
+
+    def children(self, parent, local):
+        children = parent.findall(q(D, local))
+        if len(children) > 1:
+            _fail('duplicate_declaration_container')
+        return children[0] if children else None
+
+    def unique(self, nodes, attributes=('name',)):
+        seen = set()
+        for node in nodes:
+            _tick(self.checkpoint)
+            key = tuple(node.get(q(D, attr)) for attr in attributes)
+            if key in seen:
+                _fail('duplicate_declared_name')
+            seen.add(key)
+
+    def columns(self, parent, schema=False):
+        container = self.children(parent, 'column-definitions' if schema else 'columns')
+        result = []
+        if container is None:
+            return result
+        expected = q(D, 'column-definition' if schema else 'column')
+        self.unique(list(container))
+        for node in container:
+            if node.tag != expected:
+                self.uninterpreted = True
+                continue
+            if len(node):
+                self.uninterpreted = True
+            self.record()
+            item = {'name': self.name(node)}
+            if schema:
+                # Optional properties retain declared values; none is inferred.
+                for attr in ('data-type', 'type-name'):
+                    value = self.name(node, attr, False)
+                    if value is not None:
+                        item[attr] = value
+                for attr in ('precision', 'scale'):
+                    value = node.get(q(D, attr))
+                    if value is not None:
+                        if not re.fullmatch(r'[0-9]{1,8}', value) or int(value) < 1:
+                            _fail('invalid_declared_column_property')
+                        item[attr] = int(value)
+                for attr, values in (('is-nullable', ('no-nulls', 'nullable')),
+                                     ('is-autoincrement', ('true', 'false', '1', '0')),
+                                     ('is-empty-allowed', ('true', 'false', '1', '0'))):
+                    value = node.get(q(D, attr))
+                    if value is not None:
+                        if value not in values:
+                            _fail('invalid_declared_column_property')
+                        item[attr] = value
+            result.append(item)
+        return result
+
+    def keys(self, parent, table):
+        container = self.children(parent, 'keys')
+        keys, relationships = [], []
+        if container is None:
+            return keys, relationships
+        named = [node for node in container if node.get(q(D, 'name')) is not None]
+        self.unique(named)
+        for node in container:
+            if node.tag != q(D, 'key'):
+                self.uninterpreted = True
+                continue
+            self.record()
+            kind = node.get(q(D, 'type'))
+            if kind not in ('primary', 'unique', 'foreign'):
+                _fail('unsupported_declared_key_type')
+            item = {'name': self.name(node, required=False), 'type': kind, 'columns': []}
+            for columns in node:
+                if columns.tag != q(D, 'key-columns'):
+                    self.uninterpreted = True
+                    continue
+                # ODF permits related-column-only records (db:name optional).
+                # Missing names do not establish duplicate source identities.
+                self.unique([column for column in columns
+                             if column.get(q(D, 'name')) is not None])
+                for column in columns:
+                    if column.tag != q(D, 'key-column'):
+                        self.uninterpreted = True
+                        continue
+                    self.record()
+                    item['columns'].append({'name': self.name(column, required=False),
+                        'related_column': self.name(column, 'related-column-name', False)})
+            if kind == 'foreign':
+                item['referenced_table'] = self.name(node, 'referenced-table-name', False)
+                for attr in ('update-rule', 'delete-rule'):
+                    value = node.get(q(D, attr))
+                    if value is not None:
+                        if value not in ('cascade', 'restrict', 'set-null', 'no-action', 'set-default'):
+                            _fail('unsupported_declared_key_rule')
+                        item[attr] = value
+                relationships.append({'source_table': table, **item,
+                    'target_and_constraint_not_verified': True})
+            keys.append(item)
+        return keys, relationships
+
+    def tables(self, database):
+        tables, relationships = [], []
+        containers = []
+        representations = self.children(database, 'table-representations')
+        if representations is not None:
+            containers.append((representations, False))
+        schema = self.children(database, 'schema-definition')
+        if schema is not None:
+            if any(node.tag != q(D, 'table-definitions') for node in schema):
+                self.uninterpreted = True
+            definitions = self.children(schema, 'table-definitions')
+            if definitions is not None:
+                containers.append((definitions, True))
+        for container, is_schema in containers:
+            self.unique(list(container), ('catalog-name', 'schema-name', 'name'))
+            expected = q(D, 'table-definition' if is_schema else 'table-representation')
+            for node in container:
+                if node.tag != expected:
+                    self.uninterpreted = True
+                    continue
+                interpreted = {q(D, name) for name in
+                    (('column-definitions', 'keys') if is_schema else ('columns',))}
+                if any(child.tag not in interpreted for child in node):
+                    self.uninterpreted = True
+                self.record()
+                item = {'name': self.name(node),
+                    'declaration_index': len(tables) + 1,
+                    'declaration': 'schema_definition' if is_schema else 'table_representation',
+                    'catalog_declared': q(D, 'catalog-name') in node.attrib,
+                    'schema_declared': q(D, 'schema-name') in node.attrib,
+                    'columns': self.columns(node, is_schema), 'rows': 'unavailable'}
+                if is_schema:
+                    item['keys'], refs = self.keys(node, item['name'])
+                    for ref in refs:
+                        ref['source_declaration_index'] = item['declaration_index']
+                    relationships.extend(refs)
+                tables.append(item)
+        return tables, relationships
+
+    def collection(self, container, parts, kind, members):
+        if container is None:
+            return
+        self.unique(list(container))
+        for node in container:
+            _tick(self.checkpoint)
+            if node.tag == q(D, 'query-collection' if kind == 'query' else 'component-collection'):
+                self.record()
+                path = parts + [self.name(node)]
+                members.append({'kind': 'collection', 'path': path})
+                self.collection(node, path, kind, members)
+            elif node.tag == q(D, kind if kind == 'query' else 'component'):
+                self.record()
+                item = {'kind': kind, 'path': parts + [self.name(node)]}
+                if kind == 'query':
+                    if any(child.tag != q(D, 'columns') for child in node):
+                        self.uninterpreted = True
+                    item.update(command_declared=q(D, 'command') in node.attrib,
+                                command='withheld; never executed',
+                                columns=self.columns(node), results='unavailable')
+                else:
+                    if len(node):
+                        self.uninterpreted = True
+                    item.update(reference_declared=q(XL, 'href') in node.attrib,
+                                reference='redacted; never opened',
+                                body='unavailable; not rendered or executed')
+                members.append(item)
+            else:
+                self.uninterpreted = True
+
+
+def extract_database(data, format='odb', *, checkpoint=None):
+    """Return a string-compatible, structured view of explicit ODF declarations.
+
+    Missing XML schema/relationship records mean unavailable, never no tables,
+    no relationships, or an empty database. No plaintext SQL is returned.
+    """
+    if format != 'odb':
+        _fail('unsupported_format')
+    parts, roots, database = _load(data, checkpoint)
+    view = _View(database, checkpoint)
+    sources = database.findall(q(D, 'data-source'))
+    if len(sources) != 1:
+        _fail('missing_or_duplicate_data_source')
+    connection_declared = view.children(sources[0], 'connection-data') is not None
+    tables, relationships = view.tables(database)
+    queries, forms, reports = [], [], []
+    for local, kind, output in (('queries', 'query', queries),
+                                ('forms', 'form', forms), ('reports', 'report', reports)):
+        view.collection(view.children(database, local), [], kind, output)
+    known = {q(D, name) for name in ('data-source', 'queries', 'forms', 'reports',
+                                    'table-representations', 'schema-definition')}
+    if any(node.tag not in known for node in database):
+        view.uninterpreted = True
+    result = {
+        'format': 'odb', 'view': 'declared_metadata_only',
+        'tables': tables, 'queries': queries, 'relationships': relationships,
+        'forms': forms, 'reports': reports,
+        'connection': {'declared': connection_declared,
+            'details': 'redacted; never opened' if connection_declared else 'not declared'},
+        'declaration_sections_present': {name: database.find(q(D, name)) is not None
+            for name in ('table-representations', 'schema-definition', 'queries', 'forms', 'reports')},
+        'opaque_non_xml_members': sum(name != 'mimetype' and name not in roots for name in parts),
+        'unavailable': ['stored_rows', 'live_schema', 'query_results', 'SQL_text',
+                        'form_and_report_contents', 'embedded_database_contents'],
+        'limitations': [
