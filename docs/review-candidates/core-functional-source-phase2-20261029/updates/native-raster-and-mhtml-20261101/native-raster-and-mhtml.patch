+"""Own-workspace raster frame registry and new-file transformations."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import (
+    _source, _verify, _path, _inline_budget, _fits, _capacity, _encode,
+)
+
+
+def read_image(cap, relative, *, offset=1, limit=2000, char_offset=0):
+    from tools.scoped_raster import inspect_raster, RasterError
+    if (type(offset) is not int or not 1 <= offset <= 1_000_000
+            or type(limit) is not int or not 1 <= limit <= 2000
+            or type(char_offset) is not int or char_offset != 0):
+        raise ScopeDenied()
+    data, identity = _source(cap, relative)
+    format = PurePosixPath(relative).suffix.lower().lstrip('.')
+    try:
+        metadata = inspect_raster(data, format)
+    except RasterError:
+        raise ScopeDenied() from None
+    _verify(cap, [(relative, data, identity)])
+    check(cap)
+    frames = metadata.pop('frames')
+    start = min(offset, len(frames) + 1)
+    result = dict(metadata, success=True, path=relative, scope='own_user_workspace',
+                  image_frames=[], partial=start <= len(frames), next_offset=start)
+    budget = _inline_budget()
+    if not _fits(result, budget):
+        return _capacity(budget, total=len(frames), offset=start)
+    for i in range(start - 1, min(len(frames), start - 1 + limit)):
+        candidate = dict(result, image_frames=result['image_frames'] + [frames[i]],
+                         partial=i + 1 < len(frames), next_offset=i + 2)
+        if not _fits(candidate, budget):
+            if not result['image_frames']:
+                return _capacity(budget, total=len(frames), offset=start)
+            break
+        result = candidate
+    check(cap)
+    return _encode(result)
+
+
+def create_transform(cap, fd, leaf, relative, content):
+    from tools.scoped_raster import transform_raster, RasterError
+    _check_parent(cap, fd, relative)
+    if not isinstance(content, str) or len(content.encode('utf-8')) > 100_000:
+        raise ScopeDenied()
+    def pairs(items):
+        value = {}
+        for k, v in items:
+            if k in value:
+                raise ScopeDenied()
+            value[k] = v
+        return value
+    try:
+        spec = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    if (not isinstance(spec, dict) or not {'source', 'frame'} <= set(spec)
+            or set(spec) - {'source', 'frame', 'rotation', 'crop'}):
+        raise ScopeDenied()
+    source = _path(spec['source'])
+    data, identity = _source(cap, source)
+    output_format = PurePosixPath(relative).suffix.lower().lstrip('.')
+    input_format = PurePosixPath(source).suffix.lower().lstrip('.')
+    check(cap)
+    try:
+        encoded, metadata = transform_raster(data, input_format, output_format,
+            frame=spec['frame'], rotation=spec.get('rotation', 0), crop=spec.get('crop'))
+    except RasterError:
+        raise ScopeDenied() from None
+    check(cap)
+    # Frame details are obtained through read_file; keep the effect reply bounded
+    # before publication rather than losing its receipt after a successful write.
+    output = metadata['output']['frames'][0]
+    receipt = dict(source_sha256=hashlib.sha256(data).hexdigest(),
+        input_total_frames=len(metadata['input_frames']), selected_frame=metadata['selected_frame'],
+        rotation_clockwise=metadata['rotation_clockwise'], crop=metadata['crop'],
+        width=output['width'], height=output['height'], pixel_sha256=output['pixel_sha256'],
+        pixel_lossy=metadata['pixel_lossy'], metadata_preserved=False,
+        metadata_policy=metadata['metadata_policy'])
+    budget = _inline_budget()
+    estimate = dict(receipt, success=True, path=relative, format=output_format,
+        scope='own_user_workspace', create_only=True, verified=True,
+        bytes_written=len(encoded), sha256=hashlib.sha256(encoded).hexdigest())
+    if not _fits(estimate, budget):
+        return _capacity(budget)
+    sources = [(source, data, identity)]
+    _verify(cap, sources)
+    result = json.loads(_create_bytes(cap, fd, leaf, relative, encoded,
+        output_format=output_format, verify_source=lambda: _verify(cap, sources)))
+    result.update(receipt)
+    return _encode(result)
