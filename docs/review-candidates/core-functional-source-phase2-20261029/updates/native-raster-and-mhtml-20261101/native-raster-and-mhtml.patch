+    'us-ascii': 'ascii', 'ascii': 'ascii',
+    'iso-8859-1': 'latin-1', 'latin1': 'latin-1', 'latin-1': 'latin-1',
+    'windows-1252': 'cp1252', 'cp1252': 'cp1252',
+    'windows-1251': 'cp1251', 'cp1251': 'cp1251',
+    'koi8-r': 'koi8-r',
