+"""Native inert MHTML/MHT creation and preserving new-copy text edits."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _source, _verify, _path
+
+
+def _spec(content):
+    if type(content) is not str or len(content.encode('utf-8')) > 100_000:
+        raise ScopeDenied()
+    def pairs(items):
+        result = {}
+        for k, v in items:
+            if k in result:
+                raise ScopeDenied()
+            result[k] = v
+        return result
+    try:
+        return json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+
+
+def create(cap, fd, leaf, relative, content, *, format, operation):
+    from tools.scoped_mhtml import create_mhtml, edit_mhtml, MHTMLError
+    _check_parent(cap, fd, relative)
+    if format not in ('mhtml', 'mht') or PurePosixPath(relative).suffix.lower() != '.' + format:
+        raise ScopeDenied()
+    if type(content) is not str or len(content.encode('utf-8')) > 100_000:
+        raise ScopeDenied()
+    check(cap)
+    sources = []
+    if operation == 'edit':
+        spec = _spec(content)
+        if type(spec) is not dict or set(spec) != {'source', 'old_text', 'new_text'}:
+            raise ScopeDenied()
+        source = _path(spec['source'])
+        if source == relative or PurePosixPath(source).suffix.lower() not in ('.mhtml', '.mht'):
+            raise ScopeDenied()
+        data, identity = _source(cap, source)
+        sources = [(source, data, identity)]
+        try:
+            encoded = edit_mhtml(data, spec['old_text'], spec['new_text'])
+        except MHTMLError as exc:
+            return json.dumps(dict(success=False, error='document_edit_refused',
+                                   reason=exc.code, effect_disposition='none'))
+    elif operation in ('plain', 'structured'):
+        value = _spec(content) if operation == 'structured' else content
+        try:
+            encoded = create_mhtml(value, structured=operation == 'structured')
+        except MHTMLError as exc:
+            return json.dumps(dict(success=False, error='document_create_refused',
+                                   reason=exc.code, effect_disposition='none'))
+    else:
+        raise ScopeDenied()
+    check(cap)
+    _verify(cap, sources)
+    result = json.loads(_create_bytes(cap, fd, leaf, relative, encoded,
+        output_format=format, verify_source=lambda: _verify(cap, sources)))
+    if result.get('success') and sources:
+        result.update(source=sources[0][0], source_sha256=hashlib.sha256(sources[0][1]).hexdigest(),
+            replacements=1, source_unchanged=True, unchanged_parts_preserved=True,
+            edit_mode='one_literal_root_HTML_text_run')
+    return json.dumps(result, ensure_ascii=False)
