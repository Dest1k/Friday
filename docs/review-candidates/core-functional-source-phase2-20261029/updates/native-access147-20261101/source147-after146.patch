+"""Bounded, passive Jet4/ACE2007 table decoding; never open a database engine.
+
+Structure references: mdbtools HACKING.md, file.c, table.c and write.c;
+Jackcess JetFormat.java/DatabaseImpl.java. See package provenance for hashes.
+This is a deliberately narrow reader, not an Access implementation.
+"""
+import hashlib
+import json
+import math
+import struct
+import uuid
+
+MAX_BYTES = 1_000_000
+MAX_TABLES = 16
+MAX_COLUMNS = 64
+MAX_ROWS = 1024
+MAX_CELLS = 8192
+MAX_TEXT = 4096
+MAX_OUTPUT = 750_000
+PAGE = 4096
+
+
+class AccessError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def require(condition, code):
+    if not condition:
+        raise AccessError(code)
+
+
+def u16(b, p):
+    require(0 <= p <= len(b)-2, 'access_bounds')
+    return struct.unpack_from('<H', b, p)[0]
+
+
+def u32(b, p):
+    require(0 <= p <= len(b)-4, 'access_bounds')
+    return struct.unpack_from('<I', b, p)[0]
+
+
+def header_plain(data):
+    # Public, fixed header obfuscation seed, NOT password/page decryption.
+    h = bytearray(data[:PAGE])
+    s = list(range(256)); j = 0
+    key = bytes.fromhex('c7da396b')
+    for i in range(256):
+        j = (j+s[i]+key[i % 4]) % 256
+        s[i], s[j] = s[j], s[i]
+    i = j = 0
+    for p in range(0x18, 0x98):
+        i = (i+1) % 256; j = (j+s[i]) % 256
+        s[i], s[j] = s[j], s[i]
+        h[p] ^= s[(s[i]+s[j]) % 256]
+    return h
+
+
+def unicode_text(raw, *, compressed=True, name=False):
+    require(len(raw) <= MAX_TEXT*2+2, 'access_text_limit')
+    if compressed and raw.startswith(b'\xff\xfe'):
+        result = bytearray(); p = 2; narrow = True
+        while p < len(raw):
+            if raw[p] == 0:
+                narrow = not narrow; p += 1
+            elif narrow:
+                result.extend((raw[p], 0)); p += 1
+            else:
+                require(p+2 <= len(raw), 'access_unicode_truncated')
+                result.extend(raw[p:p+2]); p += 2
+        raw = bytes(result)
+    try:
+        text = raw.decode('utf-16le', errors='strict')
+    except UnicodeError:
+        raise AccessError('access_unicode_invalid') from None
+    require(len(text) <= MAX_TEXT and '\x00' not in text, 'access_text_limit_or_nul')
+    if name:
+        require(0 < len(text) <= 128 and all(ord(x) >= 32 for x in text), 'access_name')
+    return text
+
+
+TYPES = {1: 'boolean', 2: 'byte', 3: 'int16', 4: 'int32', 5: 'currency',
+         6: 'float32', 7: 'float64', 8: 'datetime_serial', 9: 'binary',
+         10: 'text', 15: 'guid'}
+WIDTHS = {1: 0, 2: 1, 3: 2, 4: 4, 5: 8, 6: 4, 7: 8, 8: 8, 15: 16}
+
+
+class Reader:
+    def __init__(self, data, format, checkpoint):
+        self.data = data; self.checkpoint = checkpoint; self.cells = 0
+        require(type(data) is bytes and 0 < len(data) <= MAX_BYTES, 'access_input_limit')
+        require(format in ('mdb', 'accdb'), 'access_format')
+        require(len(data) >= PAGE*3 and len(data) % PAGE == 0, 'access_file_length')
+        require(data[:4] == b'\x00\x01\x00\x00', 'access_magic')
+        engine = b'Standard Jet DB' if format == 'mdb' else b'Standard ACE DB'
+        require(data[4:19] == engine and data[19] == 0, 'access_engine_suffix')
+        self.version = u32(data, 20)
+        require(self.version == (1 if format == 'mdb' else 2), 'access_version_unsupported')
+        h = header_plain(data)
+        require(u32(h, 0x3e) == 0, 'access_encryption_unsupported')
+        date = struct.unpack_from('<d', h, 114)[0]
+        require(math.isfinite(date) and -2147483648 <= date < 2147483648, 'access_header_date')
+        mask = struct.pack('<i', int(date))
+        require(all((h[66+i] ^ mask[i % 4]) == 0 for i in range(40)), 'access_password_unsupported')
+        self.tick()
+
+    def tick(self):
+        if self.checkpoint is not None:
+            self.checkpoint()
+
+    def page(self, number):
+        self.tick()
+        require(type(number) is int and 0 < number < len(self.data)//PAGE, 'access_page_pointer')
+        return self.data[number*PAGE:(number+1)*PAGE]
+
+    def slots(self, number):
+        p = self.page(number)
+        require(p[:2] == b'\x01\x01', 'access_data_page')
+        count = u16(p, 12)
+        require(count <= 512 and 14+count*2 <= PAGE, 'access_slot_count')
+        end = PAGE; out = []
+        for i in range(count):
+            field = u16(p, 14+2*i); start = field & 0x1fff
+            require(not field & 0x2000 and 14+count*2 <= start <= end <= PAGE
+                    and (start < end or field & 0x8000), 'access_slot_bounds')
+            out.append((field & 0xc000, p[start:end], start, end))
+            end = start
+        return p, out
+
+    def reference(self, pointer):
+        page, row = pointer >> 8, pointer & 255
+        _, rows = self.slots(page)
+        require(row < len(rows) and rows[row][0] == 0, 'access_row_pointer')
+        return rows[row][1]
+
+    def map_pages(self, pointer):
+        raw = self.reference(pointer)
+        require(5 <= len(raw) <= 1024, 'access_map_length')
+        mapped = set()
+        def bitmap(bits, base):
+            for i, value in enumerate(bits):
+                for j in range(8):
+                    if value & (1 << j):
+                        n = base+i*8+j
+                        require(0 < n < len(self.data)//PAGE, 'access_map_page_bounds')
+                        mapped.add(n)
+        if raw[0] == 0:
+            bitmap(raw[5:], u32(raw, 1))
+        elif raw[0] == 1:
+            require((len(raw)-1) % 4 == 0, 'access_map_length')
+            for i in range((len(raw)-1)//4):
+                n = u32(raw, 1+i*4)
+                if n:
+                    p = self.page(n)
+                    require(p[:4] == b'\x05\x01\x00\x00', 'access_map_type')
+                    bitmap(p[4:], i*(PAGE-4)*8)
+        else:
+            raise AccessError('access_map_type')
+        return mapped
+
+    def table(self, number, *, catalog=False):
+        p = self.page(number)
+        require(p[:2] == b'\x02\x01' and u32(p, 4) == 0, 'access_tdef_or_continuation_unsupported')
+        length = u32(p, 8)
+        require(63 <= length <= PAGE, 'access_tdef_length')
+        rows = u32(p, 16); maximum = u16(p, 41); variable = u16(p, 43); count = u16(p, 45)
+        indexes = u32(p, 47); real_indexes = u32(p, 51)
+        require(0 < count <= MAX_COLUMNS and maximum == count and variable <= count,
+                'access_columns_or_schema_evolution_unsupported')
+        require(rows <= MAX_ROWS and indexes <= 64 and real_indexes <= 64, 'access_table_limit')
+        require(p[40] in (0x4e, 0x53), 'access_table_type')
+        start = 63+12*real_indexes
+        require(start+count*25 <= length, 'access_column_bounds')
+        columns = []
+        for i in range(count):
+            a = start+25*i
+            col = {'type': p[a], 'number': u16(p, a+5), 'variable': u16(p, a+7),
+                   'row_number': u16(p, a+9), 'flags': p[a+15], 'ext_flags': p[a+16],
+                   'fixed_offset': u16(p, a+21), 'size': u16(p, a+23)}
+            col['fixed'] = bool(col['flags'] & 1)
+            # Boolean storage is the bitmap bit; its descriptor length is not
+            # a payload length (mdbtools mdb_read_columns makes it zero too).
+            if col['type'] == 1:
+                require(col['fixed'], 'access_boolean_storage')
+                col['size'] = 0
+            columns.append(col)
+        at = start+count*25
+        for col in columns:
+            size = u16(p, at); at += 2
+            require(0 < size <= 256 and at+size <= length, 'access_column_name_bounds')
+            col['name'] = unicode_text(p[at:at+size], compressed=False, name=True); at += size
+        require(sorted(c['number'] for c in columns) == list(range(count))
+                and len({c['name'].casefold() for c in columns}) == count,
+                'access_column_identity')
+        require(sorted(c['variable'] for c in columns if not c['fixed']) == list(range(variable)),
+                'access_variable_identity')
+        if not catalog:
+            for c in columns:
+                require(c['row_number'] == c['number'],
+                        'access_columns_or_schema_evolution_unsupported')
+                require(c['type'] in TYPES and not (c['ext_flags'] & ~1)
+                        and not (c['flags'] & ~0x47), 'access_column_type_or_flags_unsupported')
+                require(c['size'] <= 8192, 'access_column_size')
+                if c['type'] in WIDTHS:
+                    require(c['size'] == WIDTHS[c['type']], 'access_scalar_width')
+        pages = self.map_pages(u32(p, 55))
+        return {'page': number, 'rows': rows, 'variable': variable, 'columns': columns,
+                'pages': pages, 'catalog': catalog}
+
+    def row(self, raw, table, selected=None):
+        cols = table['columns']; count = u16(raw, 0)
+        require(count == len(cols), 'access_row_schema_evolution_unsupported')
+        nullsize = (count+7)//8
+        require(len(raw) >= 2+nullsize, 'access_row_length')
+        mask = raw[-nullsize:]; end = len(raw)-nullsize
+        offsets = []
+        if table['variable']:
+            n = u16(raw, end-2)
+            require(n == table['variable'], 'access_row_variable_count')
+            trailer = end-2-2*(n+1)
+            require(trailer >= 2, 'access_row_variable_bounds')
+            offsets = [u16(raw, end-4-i*2) for i in range(n+1)]
+            require(2 <= offsets[0] and offsets[-1] == trailer
+                    and offsets == sorted(offsets), 'access_row_variable_offsets')
+            end = offsets[0]
+        result = {}
+        spans = []
+        for c in cols:
+            self.tick()
+            valid = bool(mask[c['number']//8] & (1 << (c['number'] % 8)))
+            if c['fixed']:
+                a = 2+c['fixed_offset']; z = a+c['size']
+                require(2 <= a <= z <= end, 'access_row_fixed_bounds')
+                if z > a:
+                    require(all(z <= x or a >= y for x, y in spans), 'access_row_fixed_overlap')
+                    spans.append((a, z))
+            else:
+                k = c['variable']; a, z = offsets[k:k+2]
+                require(z-a <= c['size'] or c['type'] in (11,12), 'access_row_variable_size')
+                require(valid or a == z, 'access_null_variable_payload')
+            if selected is not None and c['name'] not in selected:
+                continue  # Validated catalog ranges; never emit/interpret memo/OLE properties.
+            result[c['name']] = self.value(raw[a:z], c, valid)
+            self.cells += 1
+            require(self.cells <= MAX_CELLS, 'access_cell_limit')
+        return result
+
+    def value(self, raw, c, valid):
+        typ = c['type']
+        if typ == 1:
+            require(not raw, 'access_boolean_width')
+            return valid
+        if not valid:
+            return None
+        require(typ in TYPES, 'access_column_type_unsupported')
+        if typ in WIDTHS:
+            require(len(raw) == WIDTHS[typ], 'access_value_width')
+        if typ in (2, 3, 4):
+            return int.from_bytes(raw, 'little', signed=typ != 2)
+        if typ == 5:
+            v = int.from_bytes(raw, 'little', signed=True)
+            return {'currency_decimal': ('-' if v < 0 else '')+str(abs(v)//10000)+'.'+str(abs(v)%10000).zfill(4)}
+        if typ in (6, 7, 8):
+            v = struct.unpack('<f' if typ == 6 else '<d', raw)[0]
+            require(math.isfinite(v), 'access_nonfinite_number')
+            return {'access_datetime_serial': v, 'epoch': '1899-12-30'} if typ == 8 else v
+        if typ == 9:
+            return {'binary_hex': raw.hex()}
+        if typ == 10:
+            return unicode_text(raw)
+        if typ == 15:
+            return str(uuid.UUID(bytes_le=raw))
+        raise AccessError('access_column_type_unsupported')
+
+    def rows(self, table, selected=None):
+        out = []; deleted = 0
+        for n in sorted(table['pages']):
+            p = self.page(n)
+            if p[0] != 1:
+                # Owned index/table-definition pages are not data records.
+                require(p[0] in (2, 3, 4), 'access_owned_page_type')
+                continue
+            require(u32(p, 4) == table['page'], 'access_page_owner')
+            _, slots = self.slots(n)
+            for flags, raw, start, end in slots:
+                self.tick()
+                if flags & 0x8000:
+                    deleted += 1; continue
+                require(flags == 0, 'access_row_overflow_unsupported')
+                out.append(self.row(raw, table, selected))
+                require(len(out) <= MAX_ROWS, 'access_row_limit')
+        require(len(out) == table['rows'], 'access_row_count_mismatch')
+        return out, deleted
+
+    def decode(self):
+        cat = self.table(2, catalog=True)
+        wanted = {'Id', 'Name', 'Type', 'Flags'}
+        require(wanted <= {c['name'] for c in cat['columns']}, 'access_catalog_schema')
+        expected = {'Id': 4, 'Name': 10, 'Type': 3, 'Flags': 4}
+        require(all(c['type'] == expected[c['name']] for c in cat['columns'] if c['name'] in wanted),
+                'access_catalog_schema')
+        catalog, _ = self.rows(cat, wanted)
+        tables = []; names = set(); pages = set()
+        for item in catalog:
+            if item['Type'] in (4, 6):
+                raise AccessError('access_linked_table_unsupported')
+            if item['Type'] != 1:
+                continue
+            require(type(item['Flags']) is int and type(item['Id']) is int
+                    and type(item['Name']) is str, 'access_catalog_value')
+            require(0 < len(item['Name']) <= 128
+                    and all(ord(x) >= 32 for x in item['Name']), 'access_table_name')
+            # Access reserves the MSys namespace; output explicitly excludes
+            # this namespace even when a repair-created MSysCompactError lacks
+            # the system flag. This is user-table extraction, not DB coverage.
+            if item['Flags'] & 0x80000002 or item['Name'].startswith('MSys'):
+                continue
+            require(not item['Flags'] & 8,
+                    'access_hidden_table_unsupported')
+            require(item['Id'] > 2 and item['Id'] not in pages
+                    and item['Name'].casefold() not in names, 'access_table_identity')
+            require(len(tables) < MAX_TABLES, 'access_table_count')
+            names.add(item['Name'].casefold()); pages.add(item['Id'])
+            table = self.table(item['Id']); rows, deleted = self.rows(table)
+            tables.append({'name': item['Name'], 'definition_page': item['Id'],
+                           'columns': [{'name': c['name'], 'type': TYPES[c['type']]} for c in table['columns']],
+                           'row_count': len(rows), 'deleted_slots_skipped': deleted, 'rows': rows})
+        require(tables, 'access_no_user_tables')
+        self.tick()
+        return tables
+
+
+class AccessText(str):
+    pass
+
+
+def extract(data, format, *, checkpoint=None):
+    reader = Reader(data, format, checkpoint)
+    tables = reader.decode()
+    metadata = {'format': format, 'profile': 'jet4-ace2007-scalar-read-v1',
+                'status': 'BOUNDED_STORED_TABLES', 'source_sha256': hashlib.sha256(data).hexdigest(),
+                'table_count': len(tables), 'row_count': sum(t['row_count'] for t in tables),
+                'coverage': 'bounded_stored_scalar_user_tables; system_flags_and_MSys_namespace_excluded; '
+                'no_queries_indexes_relationships_forms_macros_or_database_execution; not_whole_database_acceptance',
+                'stored_values_untrusted': True, 'read_only': True,
+                'limitations': 'Scalar local user tables only; system-flagged tables and the MSys '
+                'namespace are excluded. No queries, indexes, relationships, '
+                'forms, macros, SQL, external connections or database execution. No encryption, '
+                'memo/OLE/complex/numeric types, schema evolution, overflow rows or table continuation. '
+                'Date/time values are raw Access serials, currency exact decimal, binary hex. '
+                'No write, edit, creation or conversion. Whole input refuses on unsupported user data.'}
+    rendered = json.dumps({**metadata, 'tables': tables}, ensure_ascii=False, indent=2, allow_nan=False)
+    require(len(rendered.encode('utf-8')) <= MAX_OUTPUT, 'access_output_limit')
+    text = AccessText(rendered); text.extraction_metadata = metadata
+    reader.tick()
+    return text
