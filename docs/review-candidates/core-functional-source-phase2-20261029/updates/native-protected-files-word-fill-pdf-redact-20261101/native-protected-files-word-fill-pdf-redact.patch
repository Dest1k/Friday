+"""Read-only PDF decryption under the existing native call and private custody.
+
+Passwords travel on a pipe, never argv, environment, request files or receipts.
+Only inert page PDFs and permission-enabled extraction are supported. No public
+decrypted copy is created; the caller retains the original source identity/hash.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+
+try:
+    from tools import scoped_pdf_pages as _pages
+except ModuleNotFoundError:
+    import scoped_pdf_pages as _pages
+
+PDFReadError = _pages.PDFPagesError
+MAX_BYTES = _pages.MAX_BYTES
+MAX_PAGES = _pages.MAX_PAGES
+WALL_SECONDS = _pages.WALL_SECONDS
+
+
+def _password(value):
+    if value is None:
+        return None
+    if type(value) is not str or not value or '\x00' in value:
+        raise PDFReadError('pdf_password_invalid')
+    try:
+        if len(value.encode('utf-8')) > 1024:
+            raise PDFReadError('pdf_password_invalid')
+    except UnicodeError:
+        raise PDFReadError('pdf_password_invalid') from None
+    return value
+
+
+def _argv(work, count):
+    argv = _pages._argv(work, count)
+    index = argv.index('--chdir')
+    argv[index:index] = ['--ro-bind', str(work/'scoped_pdf_pages.py'), '/work/scoped_pdf_pages.py']
+    argv[-2:] = ['-c', "import sys,runpy;sys.path.insert(0,'/work');sys.argv=['/work/runner.py','--child'];runpy.run_path('/work/runner.py',run_name='__main__')"]
+    return argv
+
+
+def _run(cap, work, password):
+    from agent.web_call_context import _current, same_web_authority
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    if call is None or not same_web_authority(call):
+        raise PDFReadError('native_deadline_required')
+    custody = _Custody()
+    bound = False
+    deadline = min(call.deadline(), time.monotonic() + WALL_SECONDS)
+    pending = json.dumps({'password': password}, ensure_ascii=True).encode()
+    try:
+        with call.turn.lock:
+            check(cap)
+            call.check()
+            if call.session is not None or call.registry is not None:
+                raise PDFReadError('pdf_custody_busy')
+            if time.monotonic() >= deadline:
+                raise PDFReadError('pdf_timeout')
+            call.session = call.registry = custody
+            call.turn.calls.add(custody)
+            bound = True
+            custody.process = subprocess.Popen(_argv(work, 1), cwd=work,
+                stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                close_fds=True, start_new_session=True,
+                env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'})
+        while True:
+            check(cap)
+            call.check()
+            if not same_web_authority(call):
+                raise PDFReadError('pdf_authority_changed')
+            if time.monotonic() >= deadline:
+                raise PDFReadError('pdf_timeout')
+            try:
+                custody.process.communicate(input=pending,
+                    timeout=min(.05, max(.001, deadline-time.monotonic())))
+                break
+            except subprocess.TimeoutExpired:
+                # communicate resumes its original pipe write, without replaying it.
+                pending = None
+        check(cap)
+        call.check()
+        if custody.process.returncode != 0:
+            raise PDFReadError('pdf_engine_failed')
+    finally:
+        pending = None
+        receipt = custody.stop()
+        if custody.process is not None and custody.process.stdin is not None:
+            custody.process.stdin.close()
+        with call.turn.lock:
+            if bound and receipt['status'] == 'QUIESCENT':
+                if call.session is not custody or call.registry is not custody:
+                    receipt = {'status': 'STOP_UNCONFIRMED'}
+                else:
+                    call.session = call.registry = None
+                    call.turn.calls.discard(custody)
+        if receipt['status'] != 'QUIESCENT':
+            if hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFReadError('pdf_cleanup_unconfirmed')
+
+
+def prepare_read(cap, source, password=None):
+    from hermes_cli.friday_workspace_revision import check
