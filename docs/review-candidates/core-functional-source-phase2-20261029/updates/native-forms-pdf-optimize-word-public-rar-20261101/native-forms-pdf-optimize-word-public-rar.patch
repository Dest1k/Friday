+"""Finite inert RAR reader; no extraction, host paths or proprietary encoder.
+
+RAR4 stored members and RAR5 version-0 stored/compressed members are supported.
+RAR4 compression is refused: libarchive 3.8.5's public reader stops at the
+untrusted declared size and cannot establish the compression stream's end.
+A Python envelope pass verifies every block before a networkless bwrap worker
+loads the documented libarchive C ABI. No libarchive runs in the host process.
+The caller retains workspace/name/secret checks and its original native clock.
+"""
+import base64
+import binascii
+import json
+import os
+from pathlib import Path
+import selectors
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unicodedata
+
+MAX_BYTES = 1_000_000
+MAX_ENTRIES = 128
+MAX_DEPTH = 16
+MAX_NAME_BYTES = 512
+WALL_SECONDS = 12
+CPU_SECONDS = 4
+MEMORY_BYTES = 384 * 1024 * 1024
+_WIRE_MAX = 2_200_000
+_LIBRARY = '/usr/lib/x86_64-linux-gnu/libarchive.so.13'
+_VERSION = 3008005
+_RAR4 = b'Rar!\x1a\x07\x00'
+_RAR5 = b'Rar!\x1a\x07\x01\x00'
+_CODES = frozenset(('rar_invalid_archive', 'rar_header_crc', 'rar_data_crc',
+    'rar_byte_limit', 'rar_entry_limit', 'rar_invalid_name', 'rar_special_member',
+    'rar_encrypted_archive', 'rar_multivolume_archive', 'rar_unsupported_archive',
+    'rar_unsupported_compression', 'rar_name_encoding_unsupported',
+    'rar_codec_unavailable', 'rar_worker_failed', 'rar_resource_limit',
+    'rar_cleanup_unconfirmed', 'rar_custody_busy', 'rar_authority_changed'))
+
+
+class RARCodecError(ValueError):
+    """Finite reason code, never dependency diagnostics or archive contents."""
+
+
+def _crc(data):
+    return binascii.crc32(data) & 0xffffffff
+
+
+def _name(value, directory):
+    try:
+        raw = value.encode('utf-8', 'strict')
+    except (AttributeError, UnicodeError):
+        raise RARCodecError('rar_invalid_name') from None
+    body = value[:-1] if directory and value.endswith('/') else value
+    pieces = body.split('/')
+    if (not body or len(raw) > MAX_NAME_BYTES or len(pieces) > MAX_DEPTH
+            or body != unicodedata.normalize('NFC', body)
+            or any(c in body for c in ('\\', ':', '\x00'))
+            or any(unicodedata.category(c).startswith('C') for c in body)
+            or any(not p or p in ('.', '..') or len(p.encode('utf-8')) > 255 for p in pieces)
+            or not directory and value.endswith('/')):
+        raise RARCodecError('rar_invalid_name')
+    return body + ('/' if directory else '')
+
+
+def _paths(rows):
+    names = {}
+    for row in rows:
+        name, directory = row['name'], row['directory']
+        body = name[:-1] if directory else name
+        if body in names:
+            raise RARCodecError('rar_invalid_name')
+        names[body] = directory
+    for body in names:
+        pieces = body.split('/')
+        if any(names.get('/'.join(pieces[:n])) is False for n in range(1, len(pieces))):
+            raise RARCodecError('rar_invalid_name')
+
+
+class _Cursor:
+    def __init__(self, data, start=0, end=None):
+        self.data, self.pos = data, start
+        self.end = len(data) if end is None else end
+        if not 0 <= start <= self.end <= len(data):
+            raise RARCodecError('rar_invalid_archive')
+
+    def take(self, length):
+        if not 0 <= length <= self.end - self.pos:
+            raise RARCodecError('rar_invalid_archive')
+        result = self.data[self.pos:self.pos + length]
+        self.pos += length
+        return result
+
+    def u8(self):
+        return self.take(1)[0]
+
+    def u16(self):
+        return int.from_bytes(self.take(2), 'little')
+
+    def u32(self):
+        return int.from_bytes(self.take(4), 'little')
+
+    def vint(self, maximum=10):
+        value = 0
+        for index in range(maximum):
+            byte = self.u8()
+            if index == 9 and byte > 1:
+                raise RARCodecError('rar_invalid_archive')
+            value |= (byte & 127) << (7 * index)
+            if byte < 128:
+                return value
+        raise RARCodecError('rar_invalid_archive')
+
+    def finish(self):
+        if self.pos != self.end:
+            raise RARCodecError('rar_unsupported_archive')
+
+
+def _attributes(host, attrs, directory, *, rar5):
+    unix = 1 if rar5 else 3
+    windows = (0,) if rar5 else (0, 1, 2)
+    if host == unix:
+        if stat.S_IFMT(attrs) != (stat.S_IFDIR if directory else stat.S_IFREG):
+            raise RARCodecError('rar_special_member')
+        if attrs & ~0xffff:
+            raise RARCodecError('rar_special_member')
+    elif host in windows:
+        # FILE_ATTRIBUTE_DEVICE / REPARSE_POINT, unknown future bits and a
+        # disagreement between the two independent directory declarations fail.
+        if attrs & ~0x27b7 or attrs & (0x40 | 0x200 | 0x400) or bool(attrs & 0x10) != directory:
+            raise RARCodecError('rar_special_member')
+    else:
+        raise RARCodecError('rar_unsupported_archive')
+
+
+def _rar4(data, checkpoint):
+    pos, main, ended, rows, total = len(_RAR4), False, False, [], 0
+    while pos < len(data):
+        checkpoint()
+        if ended:
+            raise RARCodecError('rar_invalid_archive')
+        head = _Cursor(data, pos)
+        stored_crc, kind, flags, size = head.u16(), head.u8(), head.u16(), head.u16()
+        if size < 7 or size > len(data) - pos:
+            raise RARCodecError('rar_invalid_archive')
+        end = pos + size
+        if _crc(data[pos + 2:end]) & 0xffff != stored_crc:
+            raise RARCodecError('rar_header_crc')
+        head.end = end
+        packed = 0
+        if kind == 0x73:
+            if main or rows or size != 13:
+                raise RARCodecError('rar_invalid_archive')
+            if flags & 0x101:
+                raise RARCodecError('rar_multivolume_archive')
+            if flags & 0x80:
+                raise RARCodecError('rar_encrypted_archive')
+            if flags & ~0x14 or head.take(6) != b'\0' * 6:
+                raise RARCodecError('rar_unsupported_archive')
+            main = True
+        elif kind == 0x74:
+            if not main:
+                raise RARCodecError('rar_invalid_archive')
+            if flags & 3:
+                raise RARCodecError('rar_multivolume_archive')
+            if flags & (4 | 0x400):
+                raise RARCodecError('rar_encrypted_archive')
+            if not flags & 0x8000 or flags & ~0x93e0:
+                raise RARCodecError('rar_unsupported_archive')
+            packed, unpacked, host, crc = head.u32(), head.u32(), head.u8(), head.u32()
+            dos_time = head.u32()
+            version, method, name_size, attrs = head.u8(), head.u8(), head.u16(), head.u32()
+            if flags & 0x100:
+                packed += head.u32() << 32
+                unpacked += head.u32() << 32
+            if method != 0x30:
+                raise RARCodecError('rar_unsupported_compression')
+            if version > 50:
+                raise RARCodecError('rar_unsupported_compression')
+            directory = flags & 0xe0 == 0xe0
+            _attributes(host, attrs, directory, rar5=False)
+            raw_name = head.take(name_size)
+            try:
+                if flags & 0x200 and b'\0' in raw_name:
+                    raise RARCodecError('rar_name_encoding_unsupported')
+                name = raw_name.decode('utf-8' if flags & 0x200 else 'ascii', 'strict')
+            except UnicodeError:
+                raise RARCodecError('rar_name_encoding_unsupported') from None
+            # RAR4's documented path separator is backslash, independently of
+            # the originating OS. It denotes a path boundary, not a literal '\\'.
+            name = _name(name.replace('\\', '/'), directory)
+            if flags & 0x1000:
+                times = head.u16()
+                for index in range(3, -1, -1):
+                    mode = (times >> (index * 4)) & 15
+                    if mode & 8:
+                        if index != 3:
+                            head.take(4)
+                        elif dos_time == 0:
+                            raise RARCodecError('rar_unsupported_archive')
+                        head.take(mode & 3)
+            if packed != unpacked or directory and (packed or crc):
+                raise RARCodecError('rar_invalid_archive')
+            total += unpacked
+            if total > MAX_BYTES or packed > MAX_BYTES:
+                raise RARCodecError('rar_byte_limit')
+            if packed > len(data) - end:
+                raise RARCodecError('rar_invalid_archive')
+            if _crc(data[end:end + packed]) != crc:
+                raise RARCodecError('rar_data_crc')
+            rows.append({'name': name, 'directory': directory, 'size': unpacked,
+                         'crc': crc, 'start': end, 'end': end + packed, 'method': 0})
+            if len(rows) > MAX_ENTRIES:
+                raise RARCodecError('rar_entry_limit')
+        elif kind == 0x7b:
+            if not main or flags & ~0x4000 or size != 7:
+                raise RARCodecError('rar_unsupported_archive')
+            ended = True
+        else:
+            # Includes archive comments, recovery records, substreams and all
+            # service blocks. They are never silently skipped.
+            raise RARCodecError('rar_unsupported_archive')
+        head.finish()
+        pos = end + packed
+    if not ended:
+        raise RARCodecError('rar_invalid_archive')
+    return rows
+
+
+def _extras(data, start, end, *, main):
+    extra = _Cursor(data, start, end)
+    seen = set()
+    while extra.pos < end:
+        length = extra.vint()
+        record = _Cursor(data, extra.pos, extra.pos + length)
+        extra.pos += length
+        kind = record.vint()
+        if kind in seen:
+            raise RARCodecError('rar_invalid_archive')
+        seen.add(kind)
+        if main:
+            if kind != 1:
+                raise RARCodecError('rar_unsupported_archive')
+            flags = record.vint()
+            if flags & ~3:
+                raise RARCodecError('rar_unsupported_archive')
+            # A nonzero locator promises a separate service block that this
+            # finite profile does not accept. Zero overprovisioned vints are
+            # explicitly permitted by the RAR specification.
+            for bit in (1, 2):
+                if flags & bit and record.vint():
+                    raise RARCodecError('rar_unsupported_archive')
+        elif kind == 1:
+            raise RARCodecError('rar_encrypted_archive')
+        elif kind == 5:
+            raise RARCodecError('rar_special_member')
+        elif kind == 3:
+            flags = record.vint()
+            if flags & ~0x1f or flags & 0x10 and not flags & 1:
+                raise RARCodecError('rar_unsupported_archive')
+            for bit in (2, 4, 8):
+                if flags & bit:
+                    record.take(4 if flags & 1 else 8)
+            if flags & 0x10:
+                for bit in (2, 4, 8):
+                    if flags & bit and record.u32() >= 1_000_000_000:
+                        raise RARCodecError('rar_invalid_archive')
+        else:
+            # BLAKE2sp-only checksums, versions, owner records and extra data
+            # are outside this profile. Every supported regular file has CRC32.
+            raise RARCodecError('rar_unsupported_archive')
+        record.finish()
+    extra.finish()
+
+
+def _rar5_frames(data, start, end, checkpoint):
+    """Verify physical compressed block boundaries, checksums and final marker.
+
+    Layout is published in libarchive 3.8.5 parse_block_header/bf_* functions.
+    No entropy decode happens here. A last marker must coincide with the exact
+    packed extent; unused bits must be zero. Native output is independently
+    counted using archive_read_data_block, never a declared-size copy helper.
+    """
+    block = _Cursor(data, start, end)
+    count = 0
+    while block.pos < end:
+        checkpoint()
+        count += 1
+        if count > MAX_BYTES // 3:
+            raise RARCodecError('rar_resource_limit')
+        flags, checksum = block.u8(), block.u8()
+        size_bytes = ((flags >> 3) & 7) + 1
+        if size_bytes > 3:
+            raise RARCodecError('rar_unsupported_compression')
+        length = int.from_bytes(block.take(size_bytes), 'little')
+        if checksum != (0x5a ^ flags ^ (length & 255) ^ ((length >> 8) & 255) ^ ((length >> 16) & 255)):
+            raise RARCodecError('rar_header_crc')
+        if not length:
+            raise RARCodecError('rar_invalid_archive')
+        payload = block.take(length)
+        bits = (flags & 7) + 1
+        if payload[-1] & ((1 << (8 - bits)) - 1):
+            raise RARCodecError('rar_invalid_archive')
+        if flags & 0x40:
+            block.finish()
+            return
+    raise RARCodecError('rar_invalid_archive')
+
+
+def _rar5(data, checkpoint):
+    pos, main, ended, rows, total = len(_RAR5), False, False, [], 0
+    while pos < len(data):
+        checkpoint()
+        if ended:
+            raise RARCodecError('rar_invalid_archive')
+        block = _Cursor(data, pos)
+        stored_crc = block.u32()
+        size_start = block.pos
+        size = block.vint(3)
+        end = block.pos + size
+        if end > len(data):
+            raise RARCodecError('rar_invalid_archive')
+        if _crc(data[size_start:end]) != stored_crc:
+            raise RARCodecError('rar_header_crc')
+        block.end = end
+        kind, flags = block.vint(), block.vint()
+        if flags & 0x18:
+            raise RARCodecError('rar_multivolume_archive')
+        if flags & ~7:
+            raise RARCodecError('rar_unsupported_archive')
+        extra_size = block.vint() if flags & 1 else 0
+        packed = block.vint() if flags & 2 else 0
+        field_end = end - extra_size
+        if field_end < block.pos or packed > len(data) - end:
+            raise RARCodecError('rar_invalid_archive')
+        block.end = field_end
+        if kind == 1:
+            if main or rows or packed:
+                raise RARCodecError('rar_invalid_archive')
+            archive_flags = block.vint()
+            if archive_flags & 3:
+                raise RARCodecError('rar_multivolume_archive')
+            if archive_flags & ~0x10:
+                raise RARCodecError('rar_unsupported_archive')
+            main = True
+            _extras(data, field_end, end, main=True)
+        elif kind == 2:
+            if not main:
+                raise RARCodecError('rar_invalid_archive')
+            file_flags, unpacked, attrs = block.vint(), block.vint(), block.vint()
+            if file_flags & ~7:
+                raise RARCodecError('rar_unsupported_archive')
+            directory = bool(file_flags & 1)
+            if file_flags & 2:
+                block.u32()
+            crc = block.u32() if file_flags & 4 else None
+            compression, host, name_size = block.vint(), block.vint(), block.vint()
+            method = (compression >> 7) & 7
+            if (compression & 63 or compression & 0x40 or compression >> 14
+                    or method > 5 or ((compression >> 10) & 15) > 9):
+                raise RARCodecError('rar_unsupported_compression')
+            _attributes(host, attrs, directory, rar5=True)
+            try:
+                name = _name(block.take(name_size).decode('utf-8', 'strict'), directory)
+            except UnicodeError:
+                raise RARCodecError('rar_name_encoding_unsupported') from None
+            if (directory and (packed or unpacked or crc not in (None, 0))
+                    or not directory and crc is None
+                    or not directory and not flags & 2
+                    or directory and method != 0):
+                raise RARCodecError('rar_invalid_archive')
+            total += unpacked
+            if total > MAX_BYTES or packed > MAX_BYTES:
+                raise RARCodecError('rar_byte_limit')
+            _extras(data, field_end, end, main=False)
+            if method == 0:
+                if packed != unpacked:
+                    raise RARCodecError('rar_invalid_archive')
+                if _crc(data[end:end + packed]) != (crc or 0):
+                    raise RARCodecError('rar_data_crc')
+            elif not directory:
+                _rar5_frames(data, end, end + packed, checkpoint)
+            rows.append({'name': name, 'directory': directory, 'size': unpacked,
+                         'crc': crc or 0, 'start': end, 'end': end + packed, 'method': method})
+            if len(rows) > MAX_ENTRIES:
+                raise RARCodecError('rar_entry_limit')
+        elif kind == 4:
+            raise RARCodecError('rar_encrypted_archive')
+        elif kind == 5:
+            if not main or packed or extra_size:
+                raise RARCodecError('rar_invalid_archive')
+            end_flags = block.vint()
+            if end_flags & 1:
+                raise RARCodecError('rar_multivolume_archive')
+            if end_flags:
+                raise RARCodecError('rar_unsupported_archive')
+            ended = True
+        else:
+            raise RARCodecError('rar_unsupported_archive')
+        block.finish()
+        pos = end + packed
+    if not ended:
+        raise RARCodecError('rar_invalid_archive')
+    return rows
+
+
+def _parse(data, checkpoint):
+    if type(data) is not bytes or not 0 < len(data) <= MAX_BYTES:
+        raise RARCodecError('rar_byte_limit')
+    checkpoint()
+    if data.startswith(_RAR5):
+        rows = _rar5(data, checkpoint)
+    elif data.startswith(_RAR4):
+        rows = _rar4(data, checkpoint)
+    else:
+        raise RARCodecError('rar_invalid_archive')
+    _paths(rows)
+    checkpoint()
+    return rows
+
+
+def _argv(work):
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--as-pid-1',
+            '--cap-drop', 'ALL', '--clearenv', '--setenv', 'LANG', 'C.UTF-8',
+            '--setenv', 'LC_ALL', 'C.UTF-8', '--ro-bind', '/usr', '/usr']
+    for name in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / name
+        if path.exists():
+            target = path.resolve()
+            if not target.is_relative_to('/usr'):
+                raise RARCodecError('rar_codec_unavailable')
+            argv += ['--symlink', str(target), '/' + name]
+    # There is no writable host mount and no output file. The sole result pipe
+    # is bounded by the parent; all other mounts are private or read-only.
+    argv += ['--proc', '/proc', '--remount-ro', '/proc', '--dir', '/tmp',
+             '--ro-bind', str(work), '/work', '--chdir', '/work',
+             '--remount-ro', '/', '--', '/usr/bin/python3', '-I', '-B', '-S',
+             '/work/runner.py', '--child']
+    return argv
+
+
+def _run(work, checkpoint):
+    from agent.web_call_context import _current, same_web_authority
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    custody = _Custody()
