+def create_public_copy(cap,fd,leaf,path,content):
+    _check_parent(cap,fd,path)
+    if Path(path).name!=leaf or Path(path).suffix.lower()!='.docx':raise ScopeDenied()
+    if type(content)is not str or len(content.encode('utf-8'))>100000:raise ScopeDenied()
+    def pairs(items):
+        result={}
+        for key,value in items:
+            if key in result:raise ScopeDenied()
+            result[key]=value
+        return result
+    try:spec=json.loads(content,object_pairs_hook=pairs)
+    except(ValueError,RecursionError):raise ScopeDenied()from None
+    if type(spec)is not dict or set(spec)!={'source','source_sha256','remove_strings'}:raise ScopeDenied()
+    expected=spec['source_sha256'];name=spec['source']
+    if type(expected)is not str or len(expected)!=64 or any(c not in '0123456789abcdef'for c in expected):raise ScopeDenied()
+    if type(name)is not str or not name or '\x00'in name:raise ScopeDenied()
+    source=Path(name);root=cap.home/'workspace'
+    if not source.is_absolute():source=root/source
+    try:relative=source.relative_to(root)
+    except ValueError:raise ScopeDenied()from None
+    if (not relative.parts or any(p in('.','..')or p.startswith('.')for p in relative.parts)
+            or source.suffix.lower()not in('.docx','.dotx')or relative.as_posix()==path):raise ScopeDenied()
+    data,_,identity=workspace_document(str(source),with_identity=True)
+    digest=hashlib.sha256(data).hexdigest()
+    if digest!=expected:
+        return json.dumps(dict(success=False,error='public_copy_refused',reason='source_hash_mismatch',effect_disposition='none'))
+    try:result,metadata=public_copy(data,spec['remove_strings'],source.suffix.lower()[1:],checkpoint=lambda:check(cap))
+    except WordProfileError as error:
+        return json.dumps(dict(success=False,error='public_copy_refused',reason=error.code,effect_disposition='none'))
+    if any(term in path for term in spec['remove_strings']):
+        return json.dumps(dict(success=False,error='public_copy_refused',reason='private_output_name',effect_disposition='none'))
+    def verify():
+        check(cap);current,_,version=workspace_document(str(source),with_identity=True)
+        if current!=data or version!=identity:raise ScopeDenied()
