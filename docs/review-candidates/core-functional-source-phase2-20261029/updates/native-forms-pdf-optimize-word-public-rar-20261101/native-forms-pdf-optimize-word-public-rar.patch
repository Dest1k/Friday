+"""Create-only PDF optimization with source hash and workspace CAS."""
+import hashlib
+import json
+
+
+def create(cap, fd, leaf, relative, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+    from hermes_cli.friday_workspace_zip import _path, _source, _verify, _inline_budget, _fits, _capacity, _encode
+    from tools.scoped_pdf_optimize import request, optimize, PDFOptimizeError
+    _check_parent(cap, fd, relative)
+    try:
+        spec=request(content)
+        path=_path(spec['source'])
+        if not path.lower().endswith('.pdf'):raise ScopeDenied()
+        state=(path,*_source(cap,path))
+        if hashlib.sha256(state[1]).hexdigest()!=spec['source_sha256']:
+            raise PDFOptimizeError('pdf_source_changed')
+        data,metadata=optimize(cap,state[1],spec['source_sha256'])
+        check(cap)
+        receipt=dict(metadata,source=path,sources_unchanged=True)
+        budget=_inline_budget()
+        estimate=dict(receipt,success=True,path=relative,format='pdf',scope='own_user_workspace',
+                      create_only=True,verified=True,bytes_written=len(data),sha256=hashlib.sha256(data).hexdigest())
+        if not _fits(estimate,budget):return _capacity(budget)
+        _verify(cap,[state])
+        result=json.loads(_create_bytes(cap,fd,leaf,relative,data,output_format='pdf',verify_source=lambda:_verify(cap,[state])))
+        if result.get('success'):result.update(receipt)
+        return _encode(result)
+    except PDFOptimizeError as error:
+        return _encode(dict(success=False,error='pdf_optimize_refused',reason=str(error),
+                            effect_disposition='unknown' if str(error)=='pdf_cleanup_unconfirmed' else 'none'))
