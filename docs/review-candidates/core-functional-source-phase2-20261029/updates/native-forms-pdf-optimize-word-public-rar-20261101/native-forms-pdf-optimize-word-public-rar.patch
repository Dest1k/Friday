+"""Bounded flat AcroForm text metadata and actual /V + /AP/N filling.
+
+Uses installed libqpdf 12.3.2 C ABI only after networkless native isolation.
+Printable ASCII, standard Helvetica/Courier, plain single-line widgets only.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+
+MAX_BYTES = 1_000_000
+MAX_PAGES = 32
+MAX_FIELDS = 32
+MAX_TEXT = 256
+MAX_JSON = 8_000_000
+WALL_SECONDS = 40
+CPU_SECONDS = 30
+LIBRARY = '/usr/lib/x86_64-linux-gnu/libqpdf.so.30'
+
+
+class PDFFormError(ValueError):
+    pass
+
+
+def _argv(work, count):
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--as-pid-1',
+            '--cap-drop', 'ALL', '--clearenv', '--ro-bind', '/usr', '/usr']
+    for name in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / name
+        if path.exists():
+            target = path.resolve()
+            if not target.is_relative_to('/usr'):
+                raise PDFFormError('pdf_engine_unavailable')
+            argv += ['--symlink', str(target), '/' + name]
+    argv += ['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
+             '--bind', str(work), '/work']
+    for name in ['runner.py', 'request.json'] + [f'input{i}.pdf' for i in range(count)]:
+        argv += ['--ro-bind', str(work / name), '/work/' + name]
+    argv += ['--chdir', '/work', '--remount-ro', '/', '--',
+             '/usr/bin/python3', '-I', '-B', '-S', '/work/runner.py', '--child']
+    return argv
+
+
+def _run(cap, work, count):
+    from agent.web_call_context import _current, same_web_authority
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    if call is None or not same_web_authority(call):
+        raise PDFFormError('native_deadline_required')
+    custody = _Custody()
+    bound = False
+    deadline = min(call.deadline(), time.monotonic() + WALL_SECONDS)
+    try:
+        with call.turn.lock:
+            check(cap)
+            call.check()
+            if call.session is not None or call.registry is not None:
+                raise PDFFormError('pdf_custody_busy')
+            if time.monotonic() >= deadline:
+                raise PDFFormError('pdf_timeout')
+            call.session = call.registry = custody
+            call.turn.calls.add(custody)
+            bound = True
+            custody.process = subprocess.Popen(_argv(work, count), cwd=work,
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                close_fds=True, start_new_session=True,
+                env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'})
+        while custody.process.poll() is None:
+            check(cap)
+            call.check()
+            if not same_web_authority(call):
+                raise PDFFormError('pdf_authority_changed')
+            if time.monotonic() >= deadline:
+                raise PDFFormError('pdf_timeout')
+            try:
+                custody.process.wait(timeout=min(.05, max(.001, deadline - time.monotonic())))
+            except subprocess.TimeoutExpired:
+                pass
+        check(cap)
+        call.check()
+        if custody.process.returncode != 0:
+            raise PDFFormError('pdf_engine_failed')
+    finally:
+        receipt = custody.stop()
+        with call.turn.lock:
+            if bound and receipt['status'] == 'QUIESCENT':
+                if call.session is not custody or call.registry is not custody:
+                    receipt = {'status': 'STOP_UNCONFIRMED'}
+                else:
+                    call.session = call.registry = None
+                    call.turn.calls.discard(custody)
+        if receipt['status'] != 'QUIESCENT':
+            if hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFFormError('pdf_cleanup_unconfirmed')
+
+
+def _library():
+    import ctypes as C
+    lib = C.CDLL(LIBRARY)
+    ptr, uint, integer, string = C.c_void_p, C.c_uint, C.c_int, C.c_char_p
+    signatures = {
+        'qpdf_get_qpdf_version': (string, []), 'qpdf_init': (ptr, []),
+        'qpdf_cleanup': (None, [C.POINTER(ptr)]),
+        'qpdf_silence_errors': (None, [ptr]), 'qpdf_set_suppress_warnings': (None, [ptr, integer]),
+        'qpdf_set_attempt_recovery': (None, [ptr, integer]),
+        'qpdf_has_error': (integer, [ptr]), 'qpdf_more_warnings': (integer, [ptr]),
+        'qpdf_read': (integer, [ptr, string, string]), 'qpdf_is_encrypted': (integer, [ptr]),
+        'qpdf_get_pdf_version': (string, [ptr]),
+        'qpdf_set_minimum_pdf_version': (None, [ptr, string]),
+        'qpdf_check_pdf': (integer, [ptr]), 'qpdf_empty_pdf': (integer, [ptr]),
+        'qpdf_get_num_pages': (integer, [ptr]), 'qpdf_get_page_n': (uint, [ptr, C.c_size_t]),
+        'qpdf_push_inherited_attributes_to_page': (integer, [ptr]),
+        'qpdf_get_root': (uint, [ptr]), 'qpdf_oh_get_object_id': (integer, [ptr, uint]),
+        'qpdf_oh_get_generation': (integer, [ptr, uint]),
+        'qpdf_oh_new_integer': (uint, [ptr, C.c_longlong]),
+        'qpdf_oh_replace_key': (None, [ptr, uint, string, uint]),
+        'qpdf_add_page': (integer, [ptr, ptr, uint, integer]),
+        'qpdf_get_object_by_id': (uint, [ptr, integer, integer]),
+        'qpdf_oh_get_stream_data': (integer, [ptr, uint, integer, C.POINTER(integer), C.POINTER(ptr), C.POINTER(C.c_size_t)]),
+        'qpdf_oh_free_buffer': (None, [C.POINTER(ptr)]),
+        'qpdf_init_write': (integer, [ptr, string]), 'qpdf_write': (integer, [ptr]),
+        'qpdf_set_stream_data_mode': (None, [ptr, integer]),
+        'qpdf_set_decode_level': (None, [ptr, integer]),
+        'qpdf_set_compress_streams': (None, [ptr, integer]),
+        'qpdf_set_object_stream_mode': (None, [ptr, integer]),
+    }
+    signatures.update({
+        'qpdf_oh_get_key': (uint, [ptr, uint, string]),
+        'qpdf_oh_get_dict': (uint, [ptr, uint]),
+        'qpdf_oh_parse': (uint, [ptr, string]),
+        'qpdf_oh_new_string': (uint, [ptr, string]),
+        'qpdf_oh_new_null': (uint, [ptr]),
+        'qpdf_oh_new_stream': (uint, [ptr]),
+        'qpdf_oh_replace_stream_data': (None, [ptr, uint, string, C.c_size_t, uint, uint]),
+    })
+    callback = C.CFUNCTYPE(integer, ptr, C.c_size_t, ptr)
+    signatures['qpdf_write_json'] = (integer, [ptr, integer, callback, ptr, integer, integer, string, C.POINTER(string)])
+    for name, (restype, argtypes) in signatures.items():
+        function = getattr(lib, name)
+        function.restype, function.argtypes = restype, argtypes
+    if lib.qpdf_get_qpdf_version() != b'12.3.2':
+        raise PDFFormError('pdf_engine_unavailable')
+    return lib, C, callback
+
+
+def _checked(lib, handle, name, *args):
+    result = getattr(lib, name)(handle, *args)
+    if lib.qpdf_has_error(handle) or lib.qpdf_more_warnings(handle):
+        raise PDFFormError('pdf_malformed_or_unsupported')
+    return result
+
+
+
+
+def _ascii(value, maximum=MAX_TEXT):
+    return (type(value) is str and len(value) <= maximum
+            and all(32 <= ord(c) <= 126 for c in value))
+
+
+def request(content):
+    def pairs(rows):
+        out = {}
+        for key, value in rows:
+            if key in out:
+                raise PDFFormError('pdf_request_invalid')
+            out[key] = value
+        return out
+    try:
+        if type(content) is not str or len(content.encode('utf-8')) > 16_000:
+            raise ValueError()
+        spec = json.loads(content, object_pairs_hook=pairs)
+        import re
+        if (type(spec) is not dict or set(spec) != {'source', 'source_sha256', 'fields'}
+                or type(spec['source']) is not str or not 1 <= len(spec['source']) <= 512
+                or type(spec['source_sha256']) is not str
+                or not re.fullmatch('[0-9a-f]{64}', spec['source_sha256'])
+                or type(spec['fields']) is not dict or not 1 <= len(spec['fields']) <= MAX_FIELDS
+                or any(not _ascii(k, 64) or not k or not _ascii(v) for k, v in spec['fields'].items())):
+            raise ValueError()
+        return spec
+    except (ValueError, UnicodeError, RecursionError):
+        raise PDFFormError('pdf_request_invalid') from None
+
+
+def process(cap, data, fields=None):
+    """Read field metadata or return a newly rewritten, verified native PDF."""
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _private_read, LocalOCRFailure
+    if type(data) is not bytes or not 0 < len(data) <= MAX_BYTES:
+        raise PDFFormError('pdf_input_limit')
+    if fields is not None:
+        fields = request(json.dumps(dict(source='x.pdf', source_sha256='0'*64, fields=fields)))['fields']
+    try:
+        library = Path(LIBRARY).resolve(strict=True)
+        info = library.stat()
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+            raise PDFFormError('pdf_engine_unavailable')
+    except OSError:
+        raise PDFFormError('pdf_engine_unavailable') from None
+    check(cap)
+    work = Path(tempfile.mkdtemp(prefix='friday-pdf-form-'))
+    try:
+        work.chmod(0o700)
+        for name, value in {'runner.py': Path(__file__).read_bytes(), 'input0.pdf': data,
+                'request.json': json.dumps({'fields': fields}, separators=(',', ':')).encode()}.items():
+            (work / name).write_bytes(value)
+            (work / name).chmod(0o600)
+        _run(cap, work, 1)
+        result = json.loads(_private_read(work / 'result.json', 32_000))
+        if type(result) is dict and set(result) == {'error'}:
+            allowed = {'pdf_malformed_or_unsupported', 'pdf_profile_unsupported', 'pdf_page_limit',
+                'pdf_output_limit', 'pdf_engine_unavailable', 'pdf_verification_failed',
+                'pdf_no_form', 'pdf_field_unknown', 'pdf_text_does_not_fit'}
+            raise PDFFormError(result['error'] if result['error'] in allowed else 'pdf_engine_failed')
+        if (type(result) is not dict or set(result) != {'fields', 'pages', 'engine', 'profile', 'appearance'}
+                or result['engine'] != 'libqpdf-12.3.2'
+                or result['profile'] != 'flat_text_AcroForm_ASCII_Helvetica_Courier'
+                or result['appearance'] != ('generated_and_reparsed' if fields is not None else 'metadata_only')
+                or type(result['pages']) is not int or not 1 <= result['pages'] <= MAX_PAGES
+                or type(result['fields']) is not list or not 1 <= len(result['fields']) <= MAX_FIELDS):
+            raise PDFFormError('pdf_verification_failed')
+        names = set()
+        for row in result['fields']:
+            if (type(row) is not dict or set(row) != {'name', 'type', 'value', 'page', 'max_length', 'font'}
+                    or not _ascii(row['name'], 64) or not row['name'] or row['name'] in names
+                    or row['type'] != 'text' or not _ascii(row['value'])
+                    or type(row['page']) is not int or not 1 <= row['page'] <= result['pages']
+                    or type(row['max_length']) is not int or not 1 <= row['max_length'] <= MAX_TEXT
+                    or row['font'] not in ('Helvetica', 'Courier')):
+                raise PDFFormError('pdf_verification_failed')
+            names.add(row['name'])
+        if fields is not None and any(row['value'] != fields[row['name']] for row in result['fields'] if row['name'] in fields):
+            raise PDFFormError('pdf_verification_failed')
+        output = None
+        if fields is not None:
+            output = _private_read(work / 'output.pdf', MAX_BYTES)
+            if not output.startswith(b'%PDF-') or not output.rstrip().endswith(b'%%EOF'):
+                raise PDFFormError('pdf_verification_failed')
+        check(cap)
+        return output, result
+    except (OSError, LocalOCRFailure, json.JSONDecodeError):
+        raise PDFFormError('pdf_engine_failed') from None
+    finally:
+        try:
+            shutil.rmtree(work)
+        except OSError:
+            from agent.web_call_context import _current
+            call = _current.get()
+            if call is not None and hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFFormError('pdf_cleanup_unconfirmed') from None
+
+
+def _objects(lib, C, callback, handle):
+    chunks, size = [], 0
+    def receive(data, count, _):
+        nonlocal size
+        size += count
+        if size > MAX_JSON:
+            return 1
+        chunks.append(C.string_at(data, count))
+        return 0
+    writer = callback(receive)
+    if _checked(lib, handle, 'qpdf_write_json', 2, writer, None, 0, 0, b'', None):
+        raise PDFFormError('pdf_malformed_or_unsupported')
+    graph = json.loads(b''.join(chunks))['qpdf'][1]
+    if len(graph) > 4096:
+        raise PDFFormError('pdf_profile_unsupported')
