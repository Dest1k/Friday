+        _fail('tar_pax_invalid')
+    return result
+
+
+def decode_tar(data: bytes, format: str) -> list[tuple[str, bool, bytes]]:
+    """Decode one bounded archive, preserving member order and payload bytes."""
+    format = normalize_format(format)
+    if type(data) is not bytes:
+        _fail('tar_input_invalid')
+    if len(data) > MAX_BYTES:
+        _fail('tar_size_limit')
+    raw = _inflate(data, format)
+    if len(raw) > MAX_RAW:
+        _fail('tar_size_limit')
+    if len(raw) < 1024 or len(raw) % 512:
+        _fail('tar_header_invalid')
+    rows = []
+    offset = 0
+    pending = None
+    pax_total = 0
+    total = 0
+    while offset < len(raw):
+        block = raw[offset:offset+512]
+        offset += 512
+        if block == bytes(512):
+            if pending is not None or len(raw) - offset < 512 or any(raw[offset:]):
+                _fail('tar_header_invalid')
+            return _validate_rows(rows)
+        name, kind, size = _header(block)
+        if kind not in (b'\x00', b'0', b'5', b'x'):
+            _fail('tar_type_unsupported')
+        if size > (MAX_PAX_BYTES if kind == b'x' else MAX_BYTES):
+            _fail('tar_size_limit')
+        end = offset + size
+        padded = end + (-size % 512)
+        if padded > len(raw) or any(raw[end:padded]):
+            _fail('tar_header_invalid')
+        payload = raw[offset:end]
+        offset = padded
+        if kind == b'x':
+            pax_total += size
+            if pending is not None or pax_total > MAX_PAX_TOTAL:
+                _fail('tar_pax_invalid')
+            pending = _pax(payload)
+            continue
