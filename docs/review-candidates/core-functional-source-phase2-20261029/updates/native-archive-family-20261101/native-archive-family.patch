+            if not re.fullmatch(r'[0-9]{1,24}', value):
+                _fail('tar_pax_invalid')
+        elif key in {'mtime', 'atime', 'ctime'}:
+            if not re.fullmatch(r'-?[0-9]{1,24}(\.[0-9]{1,24})?', value):
+                _fail('tar_pax_invalid')
