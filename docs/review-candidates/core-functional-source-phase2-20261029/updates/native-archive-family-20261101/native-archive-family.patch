+
+import bz2
+import gzip
+import lzma
+import zlib
+
+from tools.scoped_tar import TarError, decompress_stream
+
+try:
+    from compression import zstd as _zstd
+except ImportError:
+    _zstd = None
+
+MAX_BYTES = 1_000_000
+FORMATS = frozenset({'gzip', 'bzip2', 'xz', 'zstd'})
+ALIASES = {'gz': 'gzip', 'bz2': 'bzip2', 'zst': 'zstd'}
+CODES = frozenset({
+    'stream_format_unsupported', 'stream_codec_unavailable',
+    'stream_input_invalid', 'stream_size_limit', 'stream_compression_invalid',
+})
+_CODEC_ERRORS = (ValueError, OSError, EOFError, zlib.error, lzma.LZMAError) + (
+    (_zstd.ZstdError,) if _zstd is not None else ())
+_TAR_ERROR_CODES = {
+    'tar_format_unsupported': 'stream_format_unsupported',
+    'tar_codec_unavailable': 'stream_codec_unavailable',
+    'tar_input_invalid': 'stream_input_invalid',
+    'tar_size_limit': 'stream_size_limit',
+    'tar_compression_invalid': 'stream_compression_invalid',
+}
+
+
+class StreamError(ValueError):
+    """A fixed safe code without input content or codec exception details."""
+
+    def __init__(self, code):
+        self.code = code if type(code) is str and code in CODES else 'stream_input_invalid'
+        super().__init__(self.code)
+
+
+def _fail(code):
+    raise StreamError(code) from None
+
+
+def normalize_format(format: str) -> str:
+    if type(format) is not str:
+        _fail('stream_format_unsupported')
+    format = ALIASES.get(format.lower(), format.lower())
+    if format not in FORMATS:
+        _fail('stream_format_unsupported')
+    return format
+
+
+def _validate(data: bytes, format: str) -> str:
+    format = normalize_format(format)
+    if type(data) is not bytes:
+        _fail('stream_input_invalid')
+    if len(data) > MAX_BYTES:
+        _fail('stream_size_limit')
