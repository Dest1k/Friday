+        _fail('stream_codec_unavailable')
+    return format
+
+
+def encode_stream(data: bytes, format: str) -> bytes:
+    """Encode at most 1 MB; refuse encoded output larger than 1 MB.
+
+    Gzip has zero mtime and no filename. Other codecs contain no timestamps;
+    Zstandard uses one thread and includes content size and a checksum.
+    """
