+"""Bounded, inert POSIX USTAR/PAX archives. Pure bytes in, pure bytes out.
+
+No extraction, files, subprocesses or external codecs. One compressed stream only;
+concatenated streams and trailing compressed bytes are refused. TAR padding after
+the required two zero blocks may contain only complete, all-zero blocks.
+"""
+from __future__ import annotations
+
+import bz2
+import gzip
+import lzma
+import re
+import unicodedata
+import zlib
+
+try:
+    from compression import zstd as _zstd
+except ImportError:
+    _zstd = None
+
+_CODEC_ERRORS = (ValueError, OSError, EOFError, zlib.error, lzma.LZMAError) + (
+    (_zstd.ZstdError,) if _zstd is not None else ())
+
+MAX_BYTES = 1_000_000
+MAX_RAW = 2_000_000
+MAX_MEMBERS = 128
+MAX_DEPTH = 16
+MAX_PAX_BYTES = 16_384
+MAX_PAX_TOTAL = 65_536
+FORMATS = frozenset({'tar', 'tar.gz', 'tar.bz2', 'tar.xz', 'tar.zst'})
+ALIASES = {'tgz': 'tar.gz', 'tbz2': 'tar.bz2', 'txz': 'tar.xz', 'tzst': 'tar.zst'}
+CODES = frozenset({
+    'tar_format_unsupported', 'tar_codec_unavailable', 'tar_input_invalid',
+    'tar_size_limit', 'tar_compression_invalid', 'tar_header_invalid',
+    'tar_checksum_invalid', 'tar_type_unsupported', 'tar_pax_invalid',
+    'tar_path_invalid', 'tar_duplicate_path', 'tar_path_conflict',
+    'tar_member_limit', 'tar_payload_invalid',
+})
+
+
+class TarError(ValueError):
+    """A fixed safe diagnostic code, never archive content or codec messages."""
+
+    def __init__(self, code):
+        self.code = code if code in CODES else 'tar_input_invalid'
+        super().__init__(self.code)
+
+
+def _fail(code):
+    raise TarError(code)
+
+
+def normalize_format(format):
+    if type(format) is not str:
+        _fail('tar_format_unsupported')
+    result = ALIASES.get(format.lower(), format.lower())
+    if result not in FORMATS:
+        _fail('tar_format_unsupported')
+    return result
+
+
+def _path(value, directory=False):
+    if type(value) is not str or not value:
+        _fail('tar_path_invalid')
+    try:
+        length = len(value.encode('utf-8'))
+    except UnicodeError:
+        _fail('tar_path_invalid')
+    if length > 512:
+        _fail('tar_path_invalid')
+    name = value[:-1] if directory and value.endswith('/') else value
+    parts = name.split('/')
+    if (not name or len(parts) > MAX_DEPTH
+            or name != unicodedata.normalize('NFC', name)
+            or any(c in name for c in ('\\', ':', '\x00'))
+            or any(unicodedata.category(c).startswith('C') for c in name)
+            or any(not p or p in ('.', '..') or p.startswith('.') for p in parts)):
+        _fail('tar_path_invalid')
+    for part in parts:
+        lower = part.casefold()
+        if (lower in {'credentials', 'credentials.json', 'secrets', 'secrets.json',
+                      'secrets.txt', 'token', 'token.txt', 'id_rsa', 'id_ed25519'}
+                or lower.endswith(('.pem', '.key', '.p12', '.pfx'))):
+            _fail('tar_path_invalid')
+    return name
+
+
+def _validate_rows(rows):
+    if type(rows) is not list:
+        _fail('tar_input_invalid')
+    if len(rows) > MAX_MEMBERS:
+        _fail('tar_member_limit')
+    result = []
+    names = set()
+    files = set()
+    total = 0
+    for row in rows:
+        if type(row) not in (list, tuple) or len(row) != 3:
+            _fail('tar_input_invalid')
+        name, directory, payload = row
+        if type(directory) is not bool or type(payload) is not bytes:
+            _fail('tar_payload_invalid')
+        name = _path(name, directory)
+        key = name.casefold()
+        if key in names:
+            _fail('tar_duplicate_path')
+        names.add(key)
+        if directory and payload:
+            _fail('tar_payload_invalid')
+        if not directory:
+            files.add(key)
+        total += len(payload)
+        if total > MAX_BYTES:
+            _fail('tar_size_limit')
+        result.append((name, directory, payload))
+    for key in names:
+        parts = key.split('/')
+        if any('/'.join(parts[:i]) in files for i in range(1, len(parts))):
+            _fail('tar_path_conflict')
+    return result
+
+
+def _inflate(data, format):
+    if format == 'tar':
+        return data
+    if format == 'tar.zst' and _zstd is None:
+        _fail('tar_codec_unavailable')
+    try:
+        if format == 'tar.gz':
+            dec = zlib.decompressobj(16 + zlib.MAX_WBITS)
+        elif format == 'tar.bz2':
+            dec = bz2.BZ2Decompressor()
+        elif format == 'tar.xz':
+            dec = lzma.LZMADecompressor(format=lzma.FORMAT_XZ, memlimit=64 * 1024**2)
+        else:
+            # 8 MiB history limit, independent of an untrusted frame declaration.
+            if not data.startswith(b'\x28\xb5\x2f\xfd'):
+                _fail('tar_compression_invalid')
+            dec = _zstd.ZstdDecompressor(
+                options={_zstd.DecompressionParameter.window_log_max: 23})
