+        # Both the fallback header and effective PAX path must be harmless.
+        name = _path(name, directory)
+        if pending is not None:
+            if 'size' in pending and int(pending['size']) != size:
+                _fail('tar_pax_invalid')
+            name = _path(pending.get('path', name), directory)
+            pending = None
+        if directory and size:
+            _fail('tar_payload_invalid')
+        total += size
+        if total > MAX_BYTES:
+            _fail('tar_size_limit')
+        rows.append((name, directory, payload))
+    _fail('tar_header_invalid')
+
+
+def _octal(value, width):
+    return f'{value:0{width-1}o}'.encode('ascii') + b'\x00'
+
