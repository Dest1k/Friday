+        if len(raw) > MAX_RAW:
+            _fail('tar_size_limit')
+        # Incremental APIs can retain output after consuming the supplied input.
+        # Every drain has a hard remaining-output bound; there is no flush().
+        while not dec.eof:
+            if format == 'tar.gz':
+                pending = dec.unconsumed_tail
+                if not pending:
+                    _fail('tar_compression_invalid')
+            else:
+                if dec.needs_input:
+                    _fail('tar_compression_invalid')
+                pending = b''
+            part = dec.decompress(pending, MAX_RAW + 1 - len(raw))
+            if not part and not dec.eof:
+                _fail('tar_compression_invalid')
+            raw += part
+            if len(raw) > MAX_RAW:
+                _fail('tar_size_limit')
+        if dec.unused_data or (format == 'tar.gz' and dec.unconsumed_tail):
+            _fail('tar_compression_invalid')
+        return raw
+    except TarError:
+        raise
+    except _CODEC_ERRORS:
+        _fail('tar_compression_invalid')
+
+
+def decompress_stream(data: bytes, compression: str) -> bytes:
+    """Bounded single gzip/bz2/xz/zstd stream; returned bytes need not be TAR.
+
+    Intended for the existing caller's nested secret scanner. It remains the
+    caller's responsibility to bound recursive nesting and aggregate scan work.
+    """
+    mapping = {'gzip': 'tar.gz', 'bz2': 'tar.bz2', 'xz': 'tar.xz', 'zstd': 'tar.zst'}
+    if type(compression) is not str or compression not in mapping:
+        _fail('tar_format_unsupported')
+    if type(data) is not bytes:
+        _fail('tar_input_invalid')
+    if len(data) > MAX_BYTES:
+        _fail('tar_size_limit')
+    return _inflate(data, mapping[compression])
+
+
+def _number(field):
+    # No base-256, negative values, signs, embedded NULs or non-octal digits.
+    if not re.fullmatch(rb' *[0-7]+[ \x00]*|[ \x00]*', field):
+        _fail('tar_header_invalid')
+    value = field.strip(b' \x00')
+    return int(value, 8) if value else 0
+
+
+def _string(field):
+    head, separator, tail = field.partition(b'\x00')
+    if separator and any(tail):
+        _fail('tar_header_invalid')
+    try:
+        return head.decode('utf-8')
+    except UnicodeError:
+        _fail('tar_header_invalid')
+
+
+def _header(block):
+    stored = _number(block[148:156])
+    if stored != sum(block[:148]) + 8 * 32 + sum(block[156:]):
+        _fail('tar_checksum_invalid')
+    if block[257:263] != b'ustar\x00' or block[263:265] != b'00' or any(block[500:]):
+        _fail('tar_header_invalid')
+    name = _string(block[:100])
+    prefix = _string(block[345:500])
+    name = prefix + '/' + name if prefix else name
+    mode = _number(block[100:108])
+    _number(block[108:116])
+    _number(block[116:124])
+    size = _number(block[124:136])
+    _number(block[136:148])
+    link = _string(block[157:257])
+    _string(block[265:297])
+    _string(block[297:329])
+    major, minor = _number(block[329:337]), _number(block[337:345])
+    if mode > 0o777 or link or major or minor:
+        _fail('tar_header_invalid')
+    return name, block[156:157], size
+
+
+def _pax(payload):
+    allowed = {'path', 'size', 'mtime', 'atime', 'ctime', 'uid', 'gid', 'uname', 'gname'}
+    result = {}
+    offset = 0
+    while offset < len(payload):
+        space = payload.find(b' ', offset, min(offset + 8, len(payload)))
+        if space < 0:
+            _fail('tar_pax_invalid')
