+        rows = [(rid, target) for rid, (actual, target) in package.relationships.get(owner, {}).items()
+                if actual == VR + kind]
+        if len(rows) != 1:
+            fail('ambiguous_or_missing_' + kind + '_relationship')
+        return rows[0][1]
+    document = related('', 'document')
+    if effective.get(document) != MAIN[format]:
+        fail('not_native_' + format)
+    if sum(value in MAIN.values() or 'visio.' in value and '.main+' in value
+           for value in effective.values()) != 1:
+        fail('ambiguous_visio_main_part')
+    package.root(document, q(V, 'VisioDocument'))
+    pages = related(document, 'pages')
+    if effective.get(pages) != 'application/vnd.ms-visio.pages+xml':
+        fail('pages_content_type')
+    page_root = package.root(pages, q(V, 'Pages'))
+    return package, effective, pages, page_root
+
+
+def _text(shape):
+    node = one(shape, 'Text')
+    if node is None:
+        return None, 'UNKNOWN_missing_or_inherited'
+    value = ''.join(node.itertext())
+    if len(value) > MAX_TEXT:
+        fail('shape_text_limit')
+    status = 'stored_literal'
+    for child in node.iter():
+        if child is node:
+            continue
+        if child.tag not in {q(V, key) for key in ('cp', 'pp', 'tp')}:
+            status = 'PARTIAL_stored_field_or_unsupported_text_not_evaluated'
+    return value, status
+
+
+def _cell(shape, name):
+    rows = [row for row in shape.findall(q(V, 'Cell')) if row.get('N') == name]
+    if len(rows) > 1:
+        fail('duplicate_shape_cell')
+    if not rows:
+        return {'status': 'UNKNOWN', 'reason': 'missing_or_inherited'}
+    raw = {key: value for key, value in rows[0].attrib.items() if key in ('V', 'F', 'E', 'U')}
+    result = {'raw': raw, 'status': 'UNKNOWN'}
+    if 'E' in raw or 'F' in raw:
+        result['reason'] = 'error_formula_or_inheritance_not_evaluated'
+    elif re.fullmatch(r'[0-9]{1,2}', raw.get('V', '')) and 0 <= int(raw['V']) <= 45:
+        value = int(raw['V'])
+        result.update(status='local_literal', value=value,
+                      kind='no_arrowhead' if value == 0 else 'indexed_line_end')
+    else:
+        result['reason'] = 'unsupported_line_end_value'
+    return result
+
+
+def _extract(data, format, checkpoint):
+    package, types, pages_part, pages_root = _load(data, format, checkpoint)
+    pages = list(pages_root)
+    if len(pages) > MAX_PAGES or any(row.tag != q(V, 'Page') for row in pages):
+        fail('page_count_or_structure')
+    page_records = []; objects = []; connections = []; connectors = []; warnings = set()
+    page_ids = set(); page_parts = set(); output_size = 0
+    def record(rows, value):
+        nonlocal output_size
+        output_size += len(encoded(value).encode('utf-8'))
+        if output_size > 850000:
+            fail('extracted_text_limit')
+        rows.append(value)
