+            if local in {'foreigndata', 'eventlist', 'event', 'script', 'oleobject',
+                         'control', 'controls', 'bindata'}:
+                fail('active_or_embedded_content')
+            if (local == 'cell' and (node.get('N', '').startswith('Event')
+                    or re.search(r'\b(?:RUNADDONWARGS|RUNADDON|RUNMACRO|CALLTHIS|SHELL)\s*\(', node.get('F', ''), re.I))
