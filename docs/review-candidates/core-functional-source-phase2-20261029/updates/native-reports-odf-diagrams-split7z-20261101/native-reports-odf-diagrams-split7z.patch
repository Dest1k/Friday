+"""Pure admission for explicit, bounded raw split-7z sets; never opens paths.
+
+Only conventional fixed-size volumes NAME.7z.001 through NAME.7z.NNN are
+accepted. The caller snapshots every named workspace file and retains custody.
+No archive discovery, arbitrary concatenation API, or SFX handling is provided.
+"""
+import re
+import struct
+import zlib
+
+MAX_PARTS = 128
+_PATTERN = re.compile(r'(.+\.7z)\.([0-9]{3})\Z', re.IGNORECASE)
+_MAGIC = b'7z\xbc\xaf\x27\x1c'
+
+
+class Split7zRefused(ValueError):
+    """Content-free finite split-set error, safe for the ordinary tool result."""
+
+
+def is_split_path(relative):
+    return type(relative) is str and _PATTERN.fullmatch(relative) is not None
+
+
+def ordered_parts(relative, parts):
+    if parts is None:
+        raise Split7zRefused('archive_parts_required')
+    if type(parts) is not list or not 2 <= len(parts) <= MAX_PARTS:
+        raise Split7zRefused('archive_parts_invalid')
+    match = _PATTERN.fullmatch(relative) if type(relative) is str else None
+    if match is None or match[2] != '001':
+        raise Split7zRefused('archive_parts_invalid')
+    base = match[1]
+    # Exact spelling includes the directory and extension; no sorting, case
+    # folding, implicit sibling search or repair of the caller's ordered list.
+    expected = [f'{base}.{number:03d}' for number in range(1, len(parts) + 1)]
+    if any(type(part) is not str for part in parts) or parts != expected:
+        raise Split7zRefused('archive_parts_invalid')
+    return tuple(parts)
+
+
+def assemble(payloads, *, max_bytes):
+    if (type(payloads) is not list or not 2 <= len(payloads) <= MAX_PARTS
+            or type(max_bytes) is not int or not 32 <= max_bytes <= 1000000
+            or any(type(part) is not bytes for part in payloads)):
+        raise Split7zRefused('archive_parts_invalid')
+    total = sum(map(len, payloads))
+    width = len(payloads[0])
+    if (width < 32 or total > max_bytes or any(len(part) != width for part in payloads[:-1])
+            or not 1 <= len(payloads[-1]) <= width):
+        raise Split7zRefused('archive_parts_invalid')
+    data = b''.join(payloads)
+    if data[:6] != _MAGIC or data[6] != 0:
+        raise Split7zRefused('archive_parts_invalid')
+    start_crc, offset, size, next_crc = struct.unpack_from('<IQQI', data, 8)
+    if zlib.crc32(data[12:32]) != start_crc:
+        raise Split7zRefused('archive_parts_invalid')
+    end = 32 + offset + size
+    if end > total:
+        raise Split7zRefused('archive_parts_incomplete')
+    if end < total:
+        raise Split7zRefused('archive_parts_extra_data')
+    if zlib.crc32(data[32 + offset:end]) != next_crc:
+        raise Split7zRefused('archive_parts_invalid')
+    # The existing isolated 7z decoder separately validates packed streams,
+    # supported filters, member CRCs and decoded limits before any publication.
+    return data
