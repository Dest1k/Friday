+        def visit(container, groups=()):
+            for shape in container:
+                tick(checkpoint)
+                if shape.tag != q(V, 'Shape'):
+                    fail('unsupported_shapes_child')
+                if shape.get('Type') not in (None, 'Shape', 'Group', 'Guide', 'Foreign'):
+                    fail('invalid_shape_type')
+                if any(child.tag not in {q(V, key) for key in
+                        ('Cell', 'Data1', 'Data2', 'Data3', 'ForeignData', 'Section', 'Shapes', 'Text')}
+                        for child in shape):
