+                           'reason': 'source_hash_mismatch', 'effect_disposition': 'none'})
+    try:
+        rendered, info = render_fill(data, spec['fields'], source_format,
+                                     checkpoint=lambda: check(cap))
+    except ODFProfileError as error:
+        return json.dumps({'success': False, 'error': 'document_fill_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
+
+    def verify():
+        check(cap)
+        current, _, version = workspace_document(str(source), with_identity=True)
+        if current != data or version != identity or hashlib.sha256(current).hexdigest() != digest:
+            raise ScopeDenied()
+
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                     output_format=output_format, verify_source=verify))
+    if result.get('success'):
+        result.update(source=relative.as_posix(), source_sha256=actual,
+                      source_unchanged=True, unchanged_parts_preserved=True,
+                      edit_mode='literal_template_fill', **info)
+    return json.dumps(result, ensure_ascii=False)
