+"""Admitted create-only PDF reports; native custody and existing publisher."""
+import hashlib
+import json
+from pathlib import Path
+
+GUIDANCE = 'Native PDF report: format=pdf_report, NEW .pdf path, content JSON {"title":"Отчёт","blocks":[{"type":"heading","text":"Итоги"},{"type":"paragraph","text":"Краткое описание"},{"type":"table","columns":["Показатель","Значение"],"rows":[["Итого","125"]]},{"type":"link","text":"Источник","url":"https://example.org/report"}]}. Exact keys only; title optional, blocks non-empty. Searchable embedded-font Latin/Cyrillic text, metric wrapping, real table cells, repeated table headers, deterministic A4 pagination and actual page numbers. Links are deliberate supplied HTTP(S) URLs only; never fetch or invent URLs. Finite profile: 100000 UTF-8 JSON bytes, 128 blocks, 256 total table rows, 1-8 columns, 4096 characters per string, 20000 total text characters, 32 pages, 1 MB output. Unsupported/missing glyphs, controls, combining/RTL/emoji, unsafe URLs and layout overflow refuse; no truncation, images, TOC, signatures or arbitrary rich layout. Creates a new report, never rewrites an existing PDF. read_file can extract text with normal continuation; extraction does not verify visual layout or active links. Subsequent PDF editing operations retain their own narrower profiles and may refuse links or embedded fonts. Creation and channel delivery are separate. '
+
+
+def create_report(cap, fd, leaf, relative, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+    from hermes_cli.friday_workspace_zip import _inline_budget, _fits, _capacity, _encode
+    from tools.scoped_pdf_report import request, process, PDFReportError
+    _check_parent(cap, fd, relative)
+    path = Path(relative)
+    if path.name != leaf or path.suffix.lower() != '.pdf':
+        raise ScopeDenied()
+    try:
+        spec = request(content)
+        output, metadata = process(cap, spec)
+        check(cap)
+        receipt = dict(report=metadata, rasterized=False)
+        estimate = dict(receipt, success=True, path=relative, format='pdf',
+            scope='own_user_workspace', create_only=True, verified=True,
+            bytes_written=len(output), sha256=hashlib.sha256(output).hexdigest())
+        budget = _inline_budget()
+        if not _fits(estimate, budget):
+            return _capacity(budget)
+        result = json.loads(_create_bytes(cap, fd, leaf, relative, output, output_format='pdf'))
+        if result.get('success'):
+            result.update(receipt)
+        return _encode(result)
+    except PDFReportError as error:
+        return _encode(dict(success=False, error='pdf_report_refused', reason=str(error),
+            effect_disposition='unknown' if str(error) == 'pdf_cleanup_unconfirmed' else 'none'))
