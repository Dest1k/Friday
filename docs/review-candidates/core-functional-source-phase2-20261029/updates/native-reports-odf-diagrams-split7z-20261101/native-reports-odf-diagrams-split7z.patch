+        tick(checkpoint)
+        page_id = uint(page.get('ID'))
+        if page_id in page_ids:
+            fail('duplicate_page_id')
+        page_ids.add(page_id)
+        rel = one(page, 'Rel', True)
+        relation = package.relationships.get(pages_part, {}).get(rel.get(q(R, 'id')))
+        if relation is None or relation[0] != VR + 'page':
+            fail('page_relationship_missing_or_wrong_type')
+        part = relation[1]
+        if part in page_parts:
+            fail('duplicate_page_part')
+        page_parts.add(part)
+        if types.get(part) != 'application/vnd.ms-visio.page+xml':
+            fail('page_content_type')
+        root = package.root(part, q(V, 'PageContents'))
+        if any(child.tag not in {q(V, 'Shapes'), q(V, 'Connects')} for child in root):
+            fail('unsupported_page_content')
+        record(page_records, {'page': page_index, 'id': page_id, 'name': page.get('Name'),
+                             'name_u': page.get('NameU'), 'part': part,
+                             'background': page.get('Background'), 'back_page': page.get('BackPage')})
