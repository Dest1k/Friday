+"""Bounded offline Visio OPC view: stored shapes, text and declared connections.
+
+No master/style inheritance, ShapeSheet evaluation, geometry interpretation,
+rendering, link fetching or active content. Connects is glue, not process flow.
+"""
+from __future__ import annotations
+
+import re
+import struct
+import zipfile
+import zlib
+from xml.etree import ElementTree as ET
+
+from tools.scoped_presentation import Package, PresentationError, encoded, local_path, q
+
+V = 'http://schemas.microsoft.com/office/visio/2012/main'
+R = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships'
+VR = 'http://schemas.microsoft.com/visio/2010/relationships/'
+CT = 'http://schemas.openxmlformats.org/package/2006/content-types'
+MAIN = {'vsdx': 'application/vnd.ms-visio.drawing.main+xml',
+        'vstx': 'application/vnd.ms-visio.template.main+xml'}
+MAX_SHAPES = 4096
+MAX_CONNECTIONS = 8192
+MAX_TEXT = 32768
+MAX_PAGES = 200
+
+
+class VSDXError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+class DiagramText(str):
+    def __new__(cls, text, metadata):
+        obj = super().__new__(cls, text)
+        obj.extraction_metadata = metadata
+        return obj
+
+
+def fail(code):
+    raise VSDXError(code)
+
+
+def tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+def uint(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[0-9]{1,10}', value):
+        fail('invalid_native_id')
+    number = int(value)
+    if number > 4294967295:
+        fail('invalid_native_id')
+    return str(number)
+
+
+def one(parent, name, required=False):
+    children = parent.findall(q(V, name))
+    if len(children) > 1 or required and not children:
+        fail('ambiguous_or_missing_' + name.lower())
+    return children[0] if children else None
+
+
+def _load(data, format, checkpoint):
+    if not isinstance(format, str) or format not in MAIN:
+        fail('unsupported_visio_format')
+    tick(checkpoint)
+    try:
+        package = Package(data)
+    except PresentationError as exc:
+        fail(str(exc))
+    except (ET.ParseError, zipfile.BadZipFile, ValueError, RuntimeError,
+            NotImplementedError, LookupError, struct.error, zlib.error):
+        fail('malformed_visio_package')
+    if package.external:
+        fail('external_relationship_forbidden')
+    if package.unsupported:
+        fail('active_or_embedded_content')
+    types = package.xml.get('[Content_Types].xml')
+    if types is None or types.tag != q(CT, 'Types'):
+        fail('content_types_missing_or_invalid')
+    overrides = {}; defaults = {}
+    for row in types:
+        if row.tag == q(CT, 'Override'):
+            name = row.get('PartName', '')
+            if not name.startswith('/'):
+                fail('invalid_content_type_part')
+            name = local_path('', name)
+            if name in overrides or name not in package.parts:
+                fail('duplicate_or_missing_content_type_part')
+            overrides[name] = row.get('ContentType', '')
+        elif row.tag == q(CT, 'Default'):
+            extension = row.get('Extension', '')
+            if not re.fullmatch(r'[a-zA-Z0-9]+', extension) or extension.lower() in defaults:
+                fail('invalid_or_duplicate_content_type_default')
+            defaults[extension.lower()] = row.get('ContentType', '')
+        else:
+            fail('unsupported_content_type_entry')
+    effective = {}
+    for name in package.parts:
+        tick(checkpoint)
+        if name == '[Content_Types].xml':
+            continue
