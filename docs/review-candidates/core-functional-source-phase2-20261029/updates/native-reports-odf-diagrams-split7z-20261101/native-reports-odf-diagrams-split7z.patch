+"""Create-only encrypted ODF edits, original identity checked before publication."""
+import hashlib
+import json
+import re
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied,workspace_document
+from hermes_cli.friday_workspace_docx import _check_parent,_create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_odf_password import encrypted_edit,ODFPasswordError,MIMES
+
+
+def create_edit(cap,fd,leaf,path,content):
+    _check_parent(cap,fd,path)
+    if type(content)is not str:raise ScopeDenied()
+    try:
+        if len(content.encode('utf-8'))>100_000:raise ScopeDenied()
+        def pairs(items):
+            value={}
+            for k,v in items:
+                if k in value:raise ScopeDenied()
+                value[k]=v
+            return value
+        spec=json.loads(content,object_pairs_hook=pairs,
+            parse_constant=lambda _:(_ for _ in ()).throw(ScopeDenied()))
+    except (ValueError,RecursionError,UnicodeError):raise ScopeDenied()from None
+    if type(spec)is not dict or set(spec)!={'source','source_sha256','password','edit'}:raise ScopeDenied()
+    raw=spec['source'];expected=spec['source_sha256']
+    if type(raw)is not str or not raw or '\x00'in raw or type(expected)is not str or not re.fullmatch('[0-9a-f]{64}',expected):
+        raise ScopeDenied()
+    source=Path(raw);root=cap.home/'workspace'
+    if not source.is_absolute():source=root/source
+    try:relative=source.relative_to(root)
+    except ValueError:raise ScopeDenied()from None
+    format=source.suffix.lower().lstrip('.')
+    if (format not in MIMES or Path(path).suffix.lower()!='.'+format
+            or Path(path).name!=leaf or relative.as_posix()==path
+            or any(p in('.','..')or p.startswith('.')for p in relative.parts)):
+        raise ScopeDenied()
+    data,_,identity=workspace_document(str(source),with_identity=True)
+    if hashlib.sha256(data).hexdigest()!=expected:
+        return json.dumps(dict(success=False,error='protected_document_edit_refused',reason='source_hash_mismatch',effect_disposition='none'))
+    try:result,metadata=encrypted_edit(data,format,spec['password'],spec['edit'],checkpoint=lambda:check(cap))
+    except ODFPasswordError as error:
+        return json.dumps(dict(success=False,error='protected_document_edit_refused',reason=str(error),effect_disposition='none'))
+    def verify():
+        check(cap);current,_,version=workspace_document(str(source),with_identity=True)
+        if current!=data or version!=identity:raise ScopeDenied()
+    answer=json.loads(_create_bytes(cap,fd,leaf,path,result,output_format='odf_password_edit',verify_source=verify))
+    if answer.get('success'):
+        answer.update(source=relative.as_posix(),source_sha256=expected,**metadata)
+    return json.dumps(answer,ensure_ascii=False)
