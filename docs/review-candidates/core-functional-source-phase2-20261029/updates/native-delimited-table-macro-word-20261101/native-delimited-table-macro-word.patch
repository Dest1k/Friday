+def _macro_metadata(package):
+    # Presence is not safety: inspect only the bounded CFB header, never streams.
+    if not package.vba_parts:
+        return {'present': False, 'execution': 'not_performed', 'safety': 'unproven'}
+    name, = package.vba_parts
+    raw = package.parts[name]
+    if (len(raw) < 512 or raw[:8] != bytes.fromhex('d0cf11e0a1b11ae1')
+            or raw[8:24] != bytes(16) or raw[28:30] != b'\xfe\xff'
+            or raw[32:34] != b'\x06\x00' or raw[34:40] != bytes(6)):
+        _fail('invalid_vba_project_container')
+    major = int.from_bytes(raw[26:28], 'little')
+    shift = int.from_bytes(raw[30:32], 'little')
+    if (major, shift) not in ((3, 9), (4, 12)) or len(raw) % (1 << shift):
+        _fail('invalid_vba_project_container')
+    return {'present': True, 'source': name, 'bytes': len(raw),
+            'sha256': hashlib.sha256(raw).hexdigest(),
+            'validation': 'cfb_header_only_not_vba_semantics',
+            'source_code': 'not_read', 'compiled_pcode': 'not_disassembled',
+            'execution': 'not_performed', 'safety': 'unproven'}
