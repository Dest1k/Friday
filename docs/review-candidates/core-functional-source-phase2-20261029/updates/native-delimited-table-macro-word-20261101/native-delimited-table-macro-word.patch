+def edit_text(data, profile, spec, *, checkpoint=None):
+    if not isinstance(spec, dict) or set(spec) != {'old_text', 'new_text'}:
+        _fail('text_edit_schema')
+    for value in spec.values():
+        if (not isinstance(value, str) or len(value) > 4000 or any(
+                not (0x20 <= ord(c) <= 0xD7FF or 0xE000 <= ord(c) <= 0xFFFD
+                     or 0x10000 <= ord(c) <= 0x10FFFF) for c in value)):
+            _fail('unsupported_text')
+    if not spec['old_text'] or spec['old_text'] == spec['new_text']:
+        _fail('invalid_replacement')
+    package, metadata = validate_profile(data, profile, checkpoint=checkpoint)
+    from hermes_cli.friday_workspace_docx import _replace_docx_text, _EditRefused
+    try:
+        changed = _replace_docx_text(package.parts['word/document.xml'], spec['old_text'], spec['new_text'])
+    except _EditRefused as error:
+        _fail(str(error))
+    _tick(checkpoint)
+    result = _rewrite_main(data, changed)
+    final, final_metadata = validate_profile(result, profile, checkpoint=checkpoint)
+    _preserved(data, result, {'word/document.xml'})
+    if final_metadata != metadata or final.parts['word/document.xml'] != changed:
+        _fail('preservation_mismatch')
+    return result, {'edited_part': 'word/document.xml', 'replacements': 1,
+                    'macro_project': metadata, 'macros_executed': False,
+                    'main_content_type': MAIN_TYPES[profile],
+                    'preserved_other_members': len(package.parts)-1,
+                    'unchanged_parts_preserved': True,
+                    'office_rendering_evaluated': False}
