+def validate_profile(data, profile, *, checkpoint=None):
+    if not isinstance(profile, str) or profile not in MACRO_FORMATS:
+        _fail('unsupported_macro_word_profile')
+    if not isinstance(data, bytes) or not 1 <= len(data) <= MAX_BYTES:
+        _fail('input_limit')
+    expected_members = _envelope(data)
+    package = _MacroPackage(data, profile, checkpoint)
+    if len(package.infos) != expected_members:
+        _fail('unsupported_zip_envelope')
+    if any(kind not in _REL_TYPES for rows in package.relationships.values()
+           for kind, target in rows.values()):
+        _fail('unsupported_relationship')
+    allowed_types = {kind for kinds in _ROOT_TYPES.values() for kind in kinds} | {
+        MAIN_TYPES[profile], VBA_TYPE, 'application/xml',
+        'application/vnd.openxmlformats-package.relationships+xml', 'image/png', 'image/jpeg'}
+    # Unused declarations also refuse: no hidden alternate macro/signature type.
+    for declaration in package.xml['[Content_Types].xml']:
+        if declaration.get('ContentType') not in allowed_types:
+            _fail('unsupported_content_type')
+    for name, raw in package.parts.items():
+        _tick(checkpoint)
+        if any(value in name.lower() for value in ('_xmlsignatures', 'signature',
+                '/activex/', '/embeddings/', '/customxml/', '/ctrlprops/', '/customui/')):
+            _fail('signed_or_active_package')
+        kind = package.types.get(name)
+        root = package.xml.get(name)
+        if name == '[Content_Types].xml':
+            continue
+        if name.endswith('.rels'):
+            continue  # _Package checked root, type, targets and cardinality.
+        if root is not None:
+            expected = {MAIN_TYPES[profile]} if name == 'word/document.xml' else _ROOT_TYPES.get(root.tag, set())
+            if kind not in expected:
+                _fail('unsupported_part_or_content_type')
+        elif name in package.vba_parts:
+            continue
+        elif kind == 'image/png' and raw.startswith(b'\x89PNG\r\n\x1a\n'):
+            continue
+        elif kind == 'image/jpeg' and raw.startswith(b'\xff\xd8\xff'):
+            continue
+        else:
+            _fail('unsupported_binary_part')
+    for name, root in package.xml.items():
+        for node in root.iter():
+            ns = _namespace(node.tag); local = node.tag.rsplit('}', 1)[-1]
+            if ns not in _NAMESPACES:
+                _fail('unsupported_xml_namespace')
+            if (ns == W and (local in _FORBIDDEN_WORD or local.endswith('Change')
+                    or local.startswith(('moveFromRange', 'moveToRange', 'customXml')))):
+                _fail('protected_hidden_field_revision_or_active_xml')
+            if (ns == _EP and local == 'DocSecurity' and (node.text or '').strip() != '0'):
+                _fail('protected_document')
+            # Only inert Word-generated shape defaults are accepted; no VML shapes.
+            if ns in (_O, _V) and (name != 'word/settings.xml' or
+                    (ns, local) not in {(_O, 'shapedefaults'), (_O, 'shapelayout'), (_O, 'idmap')}):
+                _fail('active_or_unsupported_vml')
+            if ns == _MC:
+                _fail('alternate_content_unsupported')
+            for key, value in node.attrib.items():
+                attr_ns = _namespace(key)
+                if attr_ns and attr_ns not in _NAMESPACES:
+                    _fail('unsupported_xml_attribute')
+                if key == _q(_XML, 'base') or key.rsplit('}', 1)[-1].lower() in ('macro', 'action'):
+                    _fail('active_xml_attribute')
+                if attr_ns == R and value not in package.relationships.get(name, {}):
+                    _fail('dangling_xml_relationship')
+    # Reject text outside the unique main body and malformed table ancestry.
+    main = package.xml['word/document.xml']
+    if list(main) != [package.body] or list(main.iter(_q(W, 'body'))) != [package.body]:
+        _fail('ambiguous_main_body')
+    _main_structure(package.body)
+    parents = {child: node for node in package.body.iter() for child in node}
+    for cell in package.body.iter(_q(W, 'tc')):
+        row = parents.get(cell)
+        table = parents.get(row)
+        if row is None or row.tag != _q(W, 'tr') or table is None or table.tag != _q(W, 'tbl'):
+            _fail('unsupported_table_structure')
+    for table in package.body.iter(_q(W, 'tbl')):
+        if parents.get(table) is None or parents[table].tag not in (_q(W, 'body'), _q(W, 'tc')):
+            _fail('unsupported_table_structure')
+    paragraphs = list(package.body.iter(_q(W, 'p')))
+    if len(paragraphs) > MAX_PARAGRAPHS:
+        _fail('paragraph_count_limit')
+    for paragraph in paragraphs:
+        parent = parents.get(paragraph)
+        if parent is None or parent.tag not in (_q(W, 'body'), _q(W, 'tc')):
+            _fail('unsupported_paragraph_location')
+    metadata = _macro_metadata(package)
+    _tick(checkpoint)
+    return package, metadata
