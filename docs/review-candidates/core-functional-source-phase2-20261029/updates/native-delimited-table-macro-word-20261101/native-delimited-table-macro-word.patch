+"""Scoped create-only CSV/TSV ↔ XLSX/ODS adapter using existing source CAS."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+def execute(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_delimited_table import request, validate, convert, DelimitedRefused
+    from tools.scoped_ods import ODSError
+    from tools.scoped_odt import ODTError
+    from tools.scoped_presentation import PresentationError
+    try:
+        check(cap); _check_parent(cap, fd, path)
+        spec = request(content)
+        source = Path(spec.get('source', '')).suffix.lower().lstrip('.') if isinstance(spec.get('source'), str) else ''
+        target = Path(path).suffix.lower().lstrip('.')
+        validate(spec, source, target)
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            return json.dumps(dict(success=False, error='document_already_exists', effect_disposition='none'))
+        item, relative, data, identity = _read_source(spec['source'], cap, '.'+source)
+        rendered, facts = convert(data, source, target, spec, checkpoint=lambda: check(cap))
+        check(cap)
+        facts.update(source=relative, source_sha256=hashlib.sha256(data).hexdigest(),
+                     source_unchanged=True, export_mode=source+'_'+target)
+        return _publish(cap, fd, leaf, path, rendered, target, (item, data, identity), facts)
+    except ScopeDenied:
+        raise
+    except (DelimitedRefused, ODSError, ODTError, PresentationError) as error:
+        return json.dumps(dict(success=False, error='delimited_conversion_refused',
+                               reason=str(error), effect_disposition='none'))
+    except (OSError, RuntimeError, TimeoutError):
+        return json.dumps(dict(success=False, error='delimited_conversion_stopped', effect_disposition='none'))
