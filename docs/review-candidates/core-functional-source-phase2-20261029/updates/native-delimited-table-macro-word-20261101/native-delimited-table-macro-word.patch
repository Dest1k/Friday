+def _main_structure(body):
+    """Keep literal selection inside an unambiguous finite Word body tree."""
+    children = {
+        'body': {'p', 'tbl', 'sectPr'},
+        'tbl': {'tblPr', 'tblGrid', 'tr'},
+        'tr': {'trPr', 'tc'},
+        'tc': {'tcPr', 'p', 'tbl'},
+        'p': {'pPr', 'r', 'bookmarkStart', 'bookmarkEnd', 'proofErr'},
+        'r': {'rPr', 't', 'tab', 'br', 'cr', 'noBreakHyphen', 'softHyphen',
+              'sym', 'lastRenderedPageBreak'},
+    }
+    properties = {'tbl': ('tblPr', 'tblGrid'), 'tr': ('trPr',),
+                  'tc': ('tcPr',), 'p': ('pPr',), 'r': ('rPr',)}
+    containers = {'p': {'body', 'tc'}, 'r': {'p'}, 't': {'r'},
+                  'tbl': {'body', 'tc'}, 'tr': {'tbl'}, 'tc': {'tr'},
+                  'tblPr': {'tbl'}, 'tblGrid': {'tbl'}, 'trPr': {'tr'},
+                  'tcPr': {'tc'}, 'pPr': {'p'}, 'rPr': {'r', 'pPr'},
+                  'sectPr': {'body', 'pPr'}}
+    parents = {child: node for node in body.iter() for child in node}
+    for node in body.iter():
+        if node.tag != _q(W, 't') and (node.text or '').strip():
+            _fail('unsupported_main_structure')
+        if any((child.tail or '').strip() for child in node):
+            _fail('unsupported_main_structure')
+        local = node.tag.rsplit('}', 1)[-1]
+        if node.tag == _q(W, local) and local in containers:
+            parent = parents.get(node)
+            if parent is None or parent.tag not in {_q(W, name) for name in containers[local]}:
+                _fail('unsupported_main_structure')
+        if node.tag == _q(W, 't'):
+            if (parents.get(node) is None or parents[node].tag != _q(W, 'r')
+                    or len(node) or any(key != _q(_XML, 'space') for key in node.attrib)
+                    or node.get(_q(_XML, 'space'), 'default') not in ('default', 'preserve')):
+                _fail('unsupported_main_structure')
+        if node.tag != _q(W, local) or local not in children:
+            continue
+        tags = [child.tag for child in node]
+        if any(tag not in {_q(W, name) for name in children[local]} for tag in tags):
+            _fail('unsupported_main_structure')
+        prior = -1
+        for prop in properties.get(local, ()):
+            key = _q(W, prop)
+            if tags.count(key) > 1:
+                _fail('unsupported_main_structure')
+            if key in tags:
+                index = tags.index(key)
+                if index != prior + 1:
+                    _fail('unsupported_main_structure')
+                prior = index
+        if local == 'body' and (_q(W, 'sectPr') in tags and
+                (tags.count(_q(W, 'sectPr')) != 1 or tags[-1] != _q(W, 'sectPr'))):
+            _fail('unsupported_main_structure')
