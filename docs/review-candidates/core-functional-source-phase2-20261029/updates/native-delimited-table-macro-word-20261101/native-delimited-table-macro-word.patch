+"""Own-workspace SHA-bound DOCM/DOTM literal edit into a NEW same-profile file."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+
+GUIDANCE = ('Word macro text: word_macro_edit accepts exactly {source,source_sha256,old_text,new_text} '
+    'into a NEW same-format .docm/.dotm. Obtain source_sha256 from current read_file. '
+    'One unique literal in a supported main-body/table paragraph changes; equal-format split runs work. '
+    'All other XML/member bytes, macro-enabled main declaration and any opaque VBA project remain intact. '
+    'Signatures, protection, fields, revisions, hidden text, mixed-format matches, external/active/OLE/unknown '
+    'parts refuse. VBA is never evaluated or executed and its safety remains unproven. '
+    'This operation does not create, instantiate, convert or strip macro templates/documents. ')
+
+
+def _request(content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    if not isinstance(content, str) or len(content) > 50000:
+        raise ScopeDenied()
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ScopeDenied()
+            result[key] = value
+        return result
+    try:
+        result = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    if not isinstance(result, dict) or set(result) != {'source', 'source_sha256', 'old_text', 'new_text'}:
+        raise ScopeDenied()
+    if not isinstance(result['source'], str) or not 1 <= len(result['source']) <= 4096:
+        raise ScopeDenied()
+    return result
+
+
+def create_edit(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_word_profiles import MACRO_FORMATS, WordProfileError
+    from tools.scoped_word_macro_edit import edit_text
+    try:
+        check(cap)
+        _check_parent(cap, fd, path)
+        request = _request(content)
+        digest = request['source_sha256']
+        if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest):
+            raise WordProfileError('source_hash_required')
+        profile = Path(request['source']).suffix.lower().lstrip('.')
+        if (profile not in MACRO_FORMATS or not isinstance(path, str)
+                or Path(path).suffix.lower() != '.'+profile or Path(path).name != leaf):
+            raise WordProfileError('macro_edit_output_profile_mismatch')
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            raise WordProfileError('document_already_exists')
+        source, relative, data, identity = _read_source(request['source'], cap, '.'+profile)
+        if relative == path:
+            raise ScopeDenied()
+        if hashlib.sha256(data).hexdigest() != digest:
+            raise WordProfileError('source_hash_mismatch')
+        rendered, details = edit_text(data, profile,
+            {key: request[key] for key in ('old_text', 'new_text')}, checkpoint=lambda: check(cap))
+        check(cap)
+        return _publish(cap, fd, leaf, path, rendered, profile, (source, data, identity),
+            {'source': relative, 'source_sha256': digest, 'source_unchanged': True,
+             'preserving_edit': True, 'edit_mode': 'unique_macro_native_text',
+             'output_profile': profile, **details})
+    except ScopeDenied:
+        raise
+    except WordProfileError as error:
+        return json.dumps({'success': False, 'error': 'word_macro_edit_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
