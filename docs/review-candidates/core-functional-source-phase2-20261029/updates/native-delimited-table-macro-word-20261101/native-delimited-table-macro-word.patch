+def _rewrite_main(data, changed):
+    """Retain every unselected local ZIP record, including compressed bytes.
+
+    Only selected CRC/sizes/payload and central offsets change. No prefix, gaps,
+    ZIP64 records or trailing envelope are accepted. Streaming descriptors are
+    supported in their original signed/unsigned form.
+    """
+    end = data.rfind(b'PK\x05\x06', max(0, len(data)-65557))
+    central_offset = struct.unpack_from('<I', data, end+16)[0]
+    with ZipFile(BytesIO(data)) as archive:
+        infos = archive.infolist()
+        central = []; cursor = central_offset
+        for info in infos:
+            if data[cursor:cursor+4] != b'PK\x01\x02':
+                _fail('unsupported_zip_layout')
+            names, extra, comment = struct.unpack_from('<HHH', data, cursor+28)
+            stop = cursor+46+names+extra+comment
+            if stop > end or struct.unpack_from('<I', data, cursor+42)[0] != info.header_offset:
+                _fail('unsupported_zip_layout')
+            if 0xffffffff in (info.compress_size, info.file_size, info.header_offset):
+                _fail('unsupported_zip_layout')
+            central.append((info, bytearray(data[cursor:stop])))
+            cursor = stop
+        if cursor != end:
+            _fail('unsupported_zip_layout')
+        offsets = {}; changed_info = None; selected_crc = selected_size = selected_compressed = None
+        local = bytearray()
+        ordered = sorted(infos, key=lambda item: item.header_offset)
+        for index, info in enumerate(ordered):
+            begin = info.header_offset
+            boundary = ordered[index+1].header_offset if index+1 < len(ordered) else central_offset
+            if (index == 0 and begin != 0) or data[begin:begin+4] != b'PK\x03\x04':
+                _fail('unsupported_zip_layout')
+            names, extra = struct.unpack_from('<HH', data, begin+26)
+            payload_start = begin+30+names+extra
+            payload_end = payload_start+info.compress_size
+            descriptor = data[payload_end:boundary]
+            if info.flag_bits & 8:
+                signed = descriptor.startswith(b'PK\x07\x08')
+                expected = (b'PK\x07\x08' if signed else b'')+struct.pack('<III',info.CRC,info.compress_size,info.file_size)
+                if descriptor != expected:
+                    _fail('unsupported_zip_descriptor')
+            elif payload_end != boundary:
+                _fail('unsupported_zip_layout')
+            offsets[begin] = len(local)
+            if info.filename != 'word/document.xml':
+                local.extend(data[begin:boundary]); continue
+            changed_info = info
+            if info.compress_type == zipfile.ZIP_DEFLATED:
+                level = {0:6,2:9,4:3,6:1}[info.flag_bits & 6]
+                compressor = zlib.compressobj(level, zlib.DEFLATED, -15)
+                compressed = compressor.compress(changed)+compressor.flush()
+            else:
+                compressed = changed
+            selected_crc = zlib.crc32(changed); selected_size = len(changed); selected_compressed = len(compressed)
+            header = bytearray(data[begin:payload_start])
+            if not info.flag_bits & 8:
+                struct.pack_into('<III',header,14,selected_crc,selected_compressed,selected_size)
+            local.extend(header); local.extend(compressed)
+            if info.flag_bits & 8:
+                local.extend((b'PK\x07\x08' if signed else b'')+struct.pack('<III',selected_crc,selected_compressed,selected_size))
+        if changed_info is None:
+            _fail('main_part_missing_or_namespace')
+        result = bytearray(local)
+        for info, record in central:
+            struct.pack_into('<I',record,42,offsets[info.header_offset])
+            if info is changed_info:
+                struct.pack_into('<III',record,16,selected_crc,selected_compressed,selected_size)
+            result.extend(record)
+        final = bytearray(data[end:])
+        struct.pack_into('<II',final,12,len(result)-len(local),len(local))
+        result.extend(final)
+        if len(result) > MAX_BYTES:
+            _fail('output_limit')
+        return bytes(result)
