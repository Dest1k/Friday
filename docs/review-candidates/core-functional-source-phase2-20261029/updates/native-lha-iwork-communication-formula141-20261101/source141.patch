+def edit_formula(data, spec, *, checkpoint=None):
+    if type(spec) is not dict or set(spec) != {'node_id', 'old_text', 'new_text'}:
+        fail('formula_edit_schema')
+    node_id = spec['node_id']
+    if type(node_id) is not int or not 1 <= node_id <= MAX_NODES:
+        fail('formula_node_id_required')
+    pkg = _package(data, checkpoint)
+    nodes = list(pkg.content.iter())
+    if node_id > len(nodes):
+        fail('formula_node_not_found')
+    selected = nodes[node_id - 1]
+    tag = selected.tag.split('}', 1)[1]
+    if tag not in TOKENS | {'annotation'} or len(selected):
+        fail('formula_plain_leaf_required')
+    old = text(spec['old_text'], tag)
+    new = text(spec['new_text'], tag)
+    if selected.text != old or old == new:
+        fail('formula_old_text_mismatch_or_noop')
+    raw = pkg.parts['content.xml']
+    # Expat's byte offsets locate exactly the selected leaf, independent of
+    # namespace prefixes, escapes, formatting and identical text elsewhere.
+    parser = expat.ParserCreate(namespace_separator='}')
+    stack = []; spans = {}; count = 0
+    def start(name, attrs):
+        nonlocal count
+        count += 1
+        stack.append((count, parser.CurrentByteIndex))
+    def end(name):
+        ident, begin = stack.pop()
+        spans[ident] = (begin, parser.CurrentByteIndex)
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.Parse(raw, True)
+    begin, end = spans[node_id]
+    quote = None; cursor = begin
+    while cursor < end:
+        char = raw[cursor]
+        if quote is not None:
+            if char == quote: quote = None
+        elif char in (34, 39): quote = char
+        elif char == 62: break
+        cursor += 1
+    cursor += 1
+    if cursor >= end or not raw[end:end+2] == b'</' or b'<' in raw[cursor:end]:
+        fail('formula_lexical_plain_leaf_required')
+    # Preserve CR literally via a reference, avoiding XML newline normalization.
+    replacement = escape(new).replace('\r', '&#13;').encode('utf-8')
+    changed = raw[:cursor] + replacement + raw[end:]
+    result = _rewrite_content(data, changed, checkpoint)
+    final = _package(result, checkpoint)
+    final_nodes = list(final.content.iter())
+    if len(final_nodes) != len(nodes) or final_nodes[node_id - 1].text != new:
+        fail('formula_edit_verification')
+    if any(final.parts[n] != b for n, b in pkg.parts.items() if n != 'content.xml'):
+        fail('formula_unrelated_member_changed')
