+            if h[2] & 8:
+                output.extend((b'PK\x07\x08' if signed else b'') + struct.pack('<3I', *triple))
+            struct.pack_into('<3I', central_record, 16, *triple)
+        else:
+            output.extend(data[offset:end])
+        central.append(central_record)
+    new_cd = len(output)
+    for record in central:
+        output.extend(record)
+    ending = bytearray(data[pos:])
+    struct.pack_into('<2I', ending, 12, len(output)-new_cd, new_cd)
+    output.extend(ending)
+    require(len(output) <= profiles.MAX_BYTES)
+    return bytes(output)
