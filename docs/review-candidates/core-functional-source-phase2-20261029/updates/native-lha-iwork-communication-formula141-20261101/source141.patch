+                else:
+                    call.session = call.registry = None
+                    call.turn.calls.discard(custody)
+        if receipt['status'] != 'QUIESCENT':
+            if call is not None and hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise LHACodecError('lha_cleanup_unconfirmed')
+
+
+def _response(raw, expected):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise LHACodecError('lha_worker_failed')
+            result[key] = value
+        return result
+    try:
+        value = json.loads(raw, object_pairs_hook=pairs)
+        if type(value) is not dict:
+            raise LHACodecError('lha_worker_failed')
+        if set(value) == {'error'}:
+            code = value['error']
+            raise LHACodecError(code if type(code) is str and code in _CODES else 'lha_worker_failed')
+        if (set(value) != {'members', 'version'} or value['version'] != _VERSION
+                or type(value['members']) is not list or len(value['members']) != len(expected)):
+            raise LHACodecError('lha_worker_failed')
