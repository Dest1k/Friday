+            if hashlib.sha256(original).hexdigest() != digest:
+                raise FormulaError('formula_source_hash_mismatch')
+            rendered = edit_formula(original, {k: spec[k] for k in ('node_id', 'old_text', 'new_text')},
+                                    checkpoint=lambda: check(cap))
+        else:
