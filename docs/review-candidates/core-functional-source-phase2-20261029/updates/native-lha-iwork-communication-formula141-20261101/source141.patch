+def _rewrite_content(data, changed, checkpoint):
+    """Preserve ZIP32 member records, metadata and descriptor style.
+
+    zipfile.writestr clears UTF-8/descriptor flags and changes zero external
+    attributes in genuine LibreOffice archives. Copy every untouched local
+    record verbatim; modify only content.xml and the necessary central offsets.
+    Reject unsupported envelope variants rather than silently normalizing them.
+    """
+    def require(ok):
+        if not ok:
+            fail('formula_zip_envelope_unsupported')
+    pos = data.rfind(b'PK\x05\x06')
+    require(pos >= 0 and pos + 22 <= len(data))
+    e = struct.unpack_from('<4s4H2IH', data, pos)
+    require(e[1] == e[2] == 0 and e[3] == e[4] and 0 < e[4] < 65535
+            and pos + 22 + e[7] == len(data) and e[6] + e[5] == pos)
+    cd = e[6]; cursor = cd; rows = []
+    for _ in range(e[4]):
+        tick(checkpoint)
+        require(cursor + 46 <= pos)
+        c = struct.unpack_from('<4s6H3I5H2I', data, cursor)
+        require(c[0] == b'PK\x01\x02' and c[13] == 0 and c[8] < 0xffffffff
+                and c[9] < 0xffffffff and c[16] < 0xffffffff)
+        end = cursor + 46 + c[10] + c[11] + c[12]
+        require(end <= pos)
+        name = data[cursor+46:cursor+46+c[10]]
+        rows.append((c, name, data[cursor:end]))
+        cursor = end
