+    # archive comment must agree. Refuse unsupported descriptor/extra profiles.
+    fields = ('filename', 'date_time', 'compress_type', 'comment', 'extra',
+              'create_system', 'create_version', 'extract_version', 'reserved',
+              'flag_bits', 'volume', 'internal_attr', 'external_attr')
+    with zipfile.ZipFile(io.BytesIO(data)) as a, zipfile.ZipFile(io.BytesIO(result)) as b:
+        aa, bb = a.infolist(), b.infolist()
+        if a.comment != b.comment or len(aa) != len(bb) or any(
+                any(getattr(x, k) != getattr(y, k) for k in fields) for x, y in zip(aa, bb)):
+            fail('formula_zip_metadata_profile_unsupported')
+    tick(checkpoint)
+    return result
