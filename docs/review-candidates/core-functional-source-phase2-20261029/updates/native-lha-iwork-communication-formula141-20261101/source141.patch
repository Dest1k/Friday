+        struct.pack_into('<I', central_record, 42, len(output))
+        if name == b'content.xml':
+            require(c[4] in (zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED))
+            if c[4] == zipfile.ZIP_DEFLATED:
+                compressor = zlib.compressobj(level=6, wbits=-15)
+                payload = compressor.compress(changed) + compressor.flush()
+            else:
+                payload = changed
+            triple = (zlib.crc32(changed) & 0xffffffff, len(payload), len(changed))
+            header = bytearray(data[offset:begin])
+            for number, value in enumerate(triple):
+                if not h[2] & 8 or h[6+number] != 0:
+                    struct.pack_into('<I', header, 14+number*4, value)
