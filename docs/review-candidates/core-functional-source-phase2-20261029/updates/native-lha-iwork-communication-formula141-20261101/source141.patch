+"""Finite LHA/LZH reader: level 0/1/2, -lh0-/-lh5-/-lh6-/-lh7-/-lhd-.
+
+A pure envelope pass validates every record before the networkless read-only
+bwrap child loads pinned libarchive. The child returns bytes, never extracts.
+ASCII paths only; unknown headers/methods, SFX, links and special types refuse.
+Limits and cancellation custody match the established RAR reader.
+"""
+import base64
+import binascii
+import json
+import os
+from pathlib import Path
+import selectors
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unicodedata
+
+MAX_BYTES = 1_000_000
+MAX_ENTRIES = 128
+MAX_DEPTH = 16
+MAX_NAME_BYTES = 512
+WALL_SECONDS = 12
+CPU_SECONDS = 4
+MEMORY_BYTES = 384 * 1024 * 1024
+_WIRE_MAX = 2_200_000
+_LIBRARY = '/usr/lib/x86_64-linux-gnu/libarchive.so.13'
+_VERSION = 3008005
+_CODES = frozenset(('lha_invalid_archive', 'lha_data_crc',
+    'lha_byte_limit', 'lha_entry_limit', 'lha_invalid_name', 'lha_special_member',
+    'lha_unsupported_compression', 'lha_name_encoding_unsupported',
+    'lha_codec_unavailable', 'lha_worker_failed', 'lha_resource_limit',
+    'lha_cleanup_unconfirmed', 'lha_custody_busy', 'lha_authority_changed',
+    'lha_header_checksum', 'lha_header_profile'))
+
+
+class LHACodecError(ValueError):
+    """Finite reason code, never dependency diagnostics or archive contents."""
+
+
+def _crc(data):
+    # LHA CRC-16/IBM, initial value zero, reflected polynomial 0xA001.
+    crc = 0
+    for value in data:
+        crc ^= value
+        for _ in range(8):
+            crc = (crc >> 1) ^ (0xa001 if crc & 1 else 0)
+    return crc
+
+
+def _name(value, directory):
+    try:
+        raw = value.encode('utf-8', 'strict')
+    except (AttributeError, UnicodeError):
+        raise LHACodecError('lha_invalid_name') from None
+    body = value[:-1] if directory and value.endswith('/') else value
+    pieces = body.split('/')
+    if (not body or len(raw) > MAX_NAME_BYTES or len(pieces) > MAX_DEPTH
+            or body != unicodedata.normalize('NFC', body)
+            or any(c in body for c in ('\\', ':', '\x00'))
+            or any(unicodedata.category(c).startswith('C') for c in body)
+            or any(not p or p in ('.', '..') or len(p.encode('utf-8')) > 255 for p in pieces)
+            or not directory and value.endswith('/')):
+        raise LHACodecError('lha_invalid_name')
+    return body + ('/' if directory else '')
+
+
+def _paths(rows):
+    names = {}
+    for row in rows:
+        name, directory = row['name'], row['directory']
+        body = name[:-1] if directory else name
+        if body in names:
+            raise LHACodecError('lha_invalid_name')
+        names[body] = directory
+    for body in names:
+        pieces = body.split('/')
+        if any(names.get('/'.join(pieces[:n])) is False for n in range(1, len(pieces))):
+            raise LHACodecError('lha_invalid_name')
+
+
+def _parse(data, checkpoint):
+    if type(data) is not bytes or not 0 < len(data) <= MAX_BYTES:
+        raise LHACodecError('lha_byte_limit')
+    pos, total, rows = 0, 0, []
+    def take(start, length, end=None):
+        stop = len(data) if end is None else end
+        if not 0 <= start <= stop or not 0 <= length <= stop - start:
+            raise LHACodecError('lha_invalid_archive')
+        return data[start:start + length]
+    def u16(start, end=None):
+        return int.from_bytes(take(start, 2, end), 'little')
+    def ascii_name(raw):
+        try:
+            return raw.decode('ascii', 'strict')
+        except UnicodeError:
+            raise LHACodecError('lha_name_encoding_unsupported') from None
+    while pos < len(data):
+        checkpoint()
+        if data[pos] == 0:
+            if pos != len(data) - 1 or not rows:
+                raise LHACodecError('lha_invalid_archive')
+            _paths(rows)
+            checkpoint()
+            return rows
+        common = take(pos, 22)
+        method, level = common[2:7], common[20]
+        if method not in (b'-lh0-', b'-lh5-', b'-lh6-', b'-lh7-', b'-lhd-'):
+            raise LHACodecError('lha_unsupported_compression')
+        if level not in (0, 1, 2):
+            raise LHACodecError('lha_header_profile')
+        directory = method == b'-lhd-'
+        packed = int.from_bytes(common[7:11], 'little')
+        unpacked = int.from_bytes(common[11:15], 'little')
+        if common[19] & ~0x37 or level and common[19] != 0x20:
+            raise LHACodecError('lha_special_member')
+        # Level 0 is DOS attributes; regular entries cannot claim directory,
+        # volume-label or device status. lhd is the directory declaration.
+        if not level and (common[19] & 0x08 or not directory and common[19] & 0x10):
+            raise LHACodecError('lha_special_member')
+        size = common[0] + 2 if level < 2 else u16(pos)
+        if size > 8192:
+            raise LHACodecError('lha_header_profile')
+        header = take(pos, size)
+        mode, dirname, filename, crc_at, header_crc_at = None, b'', b'', None, None
+        if level < 2:
+            minimum = 24 if level == 0 else 27
+            namelen = common[21]
+            if size < minimum + namelen:
+                raise LHACodecError('lha_invalid_archive')
+            if sum(header[2:]) & 255 != header[1]:
+                raise LHACodecError('lha_header_checksum')
+            filename = header[22:22+namelen]
+            crc_at = pos + 22 + namelen
+            if level == 0:
+                extra = header[24+namelen:]
+                if extra:
+                    if len(extra) != 12 or extra[:2] != b'U\0':
+                        raise LHACodecError('lha_header_profile')
+                    mode = int.from_bytes(extra[6:8], 'little')
+                start = pos + size
+            else:
+                if size != 27 + namelen or header[24+namelen] not in (0, ord('U'), ord('M')):
+                    raise LHACodecError('lha_header_profile')
+                ext_start, limit = pos + size - 2, min(len(data), pos + size + packed)
+        else:
+            if size < 26 or header[23] not in (0, ord('U'), ord('M')):
+                raise LHACodecError('lha_header_profile')
+            crc_at = pos + 21
+            ext_start, limit = pos + 24, pos + size
+        if level:
+            q, seen = ext_start, set()
+            while True:
+                length = u16(q, limit)
+                if length == 0:
+                    q += 2
+                    break
+                if length < 3 or len(seen) >= 16:
+                    raise LHACodecError('lha_header_profile')
+                ext = take(q, length, limit)
+                kind, body = ext[2], ext[3:]
+                if kind in seen:
+                    raise LHACodecError('lha_header_profile')
+                seen.add(kind)
+                if kind == 0:
+                    if len(body) != 2:
+                        raise LHACodecError('lha_header_profile')
+                    header_crc_at = q + 3
+                elif kind == 1:
+                    filename = body
+                elif kind == 2:
+                    if not body or body[-1:] not in (b'\xff', b'/'):
+                        raise LHACodecError('lha_invalid_name')
+                    dirname = body.replace(b'\xff', b'/')
+                elif kind == 0x40:
+                    if len(body) != 2 or int.from_bytes(body, 'little') & ~0x27:
+                        raise LHACodecError('lha_special_member')
+                elif kind == 0x50:
+                    if len(body) != 2:
+                        raise LHACodecError('lha_header_profile')
+                    mode = int.from_bytes(body, 'little')
+                elif kind in (0x51, 0x54):
+                    if len(body) != 4:
+                        raise LHACodecError('lha_header_profile')
+                elif kind in (0x52, 0x53):
+                    if not body or len(body) > 255 or any(x < 32 or x > 126 for x in body):
+                        raise LHACodecError('lha_header_profile')
+                else:
+                    raise LHACodecError('lha_header_profile')
+                q += length
+            if level == 1:
+                # Packed size includes extended records beyond the base header.
+                packed -= q - (pos + size)
+                if packed < 0:
+                    raise LHACodecError('lha_invalid_archive')
+                start = q
+                if header_crc_at is not None:
+                    raise LHACodecError('lha_header_profile')
+            else:
+                # Only the standard optional one-byte zero pad is supported.
+                if q > pos + size or pos + size - q > 1 or any(data[q:pos+size]):
+                    raise LHACodecError('lha_header_profile')
+                if header_crc_at is None:
+                    raise LHACodecError('lha_header_checksum')
+                checked = bytearray(header)
+                h = header_crc_at - pos
+                checked[h:h+2] = b'\0\0'
+                if _crc(checked) != u16(header_crc_at):
+                    raise LHACodecError('lha_header_checksum')
+                start = pos + size
+        if mode is not None and (stat.S_IFMT(mode) != (stat.S_IFDIR if directory else stat.S_IFREG)
+                                 or mode & 0o7000):
+            raise LHACodecError('lha_special_member')
+        raw_name = dirname + filename
+        if level == 0:
+            raw_name = raw_name.replace(b'\\', b'/')
+        name = _name(ascii_name(raw_name), directory)
+        crc = u16(crc_at)
+        if (directory and (packed or unpacked or crc)
+                or method == b'-lh0-' and packed != unpacked
+                or not directory and method != b'-lh0-' and (not packed or not unpacked)):
+            raise LHACodecError('lha_invalid_archive')
+        total += unpacked
+        if total > MAX_BYTES or packed > MAX_BYTES:
+            raise LHACodecError('lha_byte_limit')
+        payload = take(start, packed)
+        if method == b'-lh0-' and _crc(payload) != crc:
+            raise LHACodecError('lha_data_crc')
+        rows.append(dict(name=name, directory=directory, size=unpacked, crc=crc,
+                         start=start, end=start+packed, method=method.decode('ascii'), level=level))
+        if len(rows) > MAX_ENTRIES:
+            raise LHACodecError('lha_entry_limit')
+        pos = start + packed
+    # Missing terminators and concatenated/trailing data are refused.
+    raise LHACodecError('lha_invalid_archive')
+
+
+def _argv(work):
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--as-pid-1',
+            '--cap-drop', 'ALL', '--clearenv', '--setenv', 'LANG', 'C.UTF-8',
+            '--setenv', 'LC_ALL', 'C.UTF-8', '--ro-bind', '/usr', '/usr']
+    for name in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / name
+        if path.exists():
+            target = path.resolve()
+            if not target.is_relative_to('/usr'):
+                raise LHACodecError('lha_codec_unavailable')
+            argv += ['--symlink', str(target), '/' + name]
+    # There is no writable host mount and no output file. The sole result pipe
+    # is bounded by the parent; all other mounts are private or read-only.
+    argv += ['--proc', '/proc', '--remount-ro', '/proc', '--dir', '/tmp',
+             '--ro-bind', str(work), '/work', '--chdir', '/work',
+             '--remount-ro', '/', '--', '/usr/bin/python3', '-I', '-B', '-S',
+             '/work/runner.py', '--child']
+    return argv
+
+
+def _run(work, checkpoint):
+    from agent.web_call_context import _current, same_web_authority
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    custody = _Custody()
+    lock = call.turn.lock if call is not None else threading.RLock()
+    bound = False
