+        end = rows[index+1][0][16] if index+1 < len(rows) else cd
+        require(offset + 30 <= end <= cd)
+        h = struct.unpack_from('<4s5H3I2H', data, offset)
+        require(h[0] == b'PK\x03\x04' and h[2] == c[3] and h[3] == c[4]
+                and h[1] == c[2] and h[4] == c[5] and h[5] == c[6])
+        begin = offset + 30 + h[9] + h[10]
+        finish = begin + c[8]
+        require(data[offset+30:offset+30+h[9]] == name and begin <= finish <= end)
+        if h[2] & 8:
+            tail = data[finish:end]
+            signed = tail.startswith(b'PK\x07\x08')
+            require(len(tail) == (16 if signed else 12))
+            require(struct.unpack('<3I', tail[4:] if signed else tail) == (c[7],c[8],c[9]))
