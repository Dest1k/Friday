+"""Strict passive MPP12/MPP14 task catalog; no scheduling or writer support.
+
+Original bounded Python implementation informed by MPXJ (c) Packwood
+Software, Jon Iles and contributors; LGPL-2.1-or-later. The complete license
+and original attribution are retained in scoped_mpp.LICENSE.
+
+Native layouts: pinned MPXJ 38f49731d3f3d5aa58998f0ed5d328eddfe41095,
+MPP12Reader/MPP14Reader, FieldMap12/14, FixedMeta, FixedData and VarMeta12.
+Fixed2Data is validated as a separate record table; no values are borrowed
+between physical records or interpreted from unsupported fields.
+"""
+import hashlib
+import json
+from tools import scoped_mpp as m
+
+
+def _structure(cfb, version):
+    project, views = '   1' + version, '   2' + version
+    root_streams = {'\x01CompObj', '\x05SummaryInformation', '\x05DocumentSummaryInformation', 'Props' + version}
+    tables = {project: {'TBkndTask', 'TBkndRsc', 'TBkndAssn', 'TBkndCons', 'TBkndCal', 'TBkndOutlCode'},
+              views: {'CGrouping', 'CCommandBar', 'CFilter', 'CReport', 'CTable', 'CMap', 'CEdl', 'CUdm', 'CV_iew', 'CVba', 'CDrawing'}}
+    for path in cfb.storages:
+        cfb.check()
+        if len(path) > 2 and path[:2] == (views, 'CVba'):
+            m._fail('project_vba_storage')
+        if path and not (len(path) == 1 and path[0] in tables
+                         or len(path) == 2 and path[0] in tables and path[1] in tables[path[0]]):
+            m._fail('unsupported_project_storage')
+    for path, payload in cfb.streams.items():
+        cfb.check()
+        if path[:2] == (views, 'CVba'):
+            m._fail('project_vba_storage')
+        # CDrawing is accepted only as an empty native table. Drawing content
+        # and all embedded/OLE objects remain outside this passive profile.
+        if path[:2] == (views, 'CDrawing'):
+            if ((path[-1] in {'FixedData', 'Var2Data'} and payload == b'')
+                    or (path[-1] == 'FixedMeta' and len(payload) == 16
+                        and m._u32(payload, 0) == 0xFADFADBA and m._u32(payload, 8) == 0 and m._u32(payload, 12) == 0)
+                    or (path[-1] == 'VarMeta' and len(payload) == 24
+                        and m._u32(payload, 0) == 0xFADFADBA and m._u32(payload, 8) == 0 and m._u32(payload, 20) == 0)):
+                continue
+            m._fail('project_embedded_content')
+        if len(path) == 1 and path[0] in root_streams:
+            continue
+        if len(path) == 2 and path[0] in tables and path[1] == 'Props':
+            continue
+        if (len(path) == 3 and path[0] in tables and path[1] in tables[path[0]]
+                and (path[2] in {'FixedData', 'FixedMeta', 'Fixed2Data', 'Fixed2Meta', 'VarMeta', 'Var2Data', 'Props'}
+                     or path == (views, 'CCommandBar', '2a400000_ffffffff'))):
+            continue
+        m._fail('unsupported_project_stream')
+
+
+def _fixed(meta, data, width, check, *, count=None):
+    if (len(meta) < 16 or m._u32(meta, 0) != 0xFADFADBA or (len(meta) - 16) % width
+            or not 4 <= (len(meta) - 16) // width <= m.MAX_TASKS + 3
+            or m._u32(meta, 8) != (len(meta) - 16) // width
+            or m._u32(meta, 12) != len(data)):
+        m._fail('task_fixedmeta_geometry')
+    actual_count = (len(meta) - 16) // width
+    if count is not None and actual_count != count:
+        m._fail('task_fixed2_record_count')
+    records, starts = [], set()
+    for pos in range(16, len(meta), width):
+        check()
+        flags, offset = m._u32(meta, pos), m._u32(meta, pos + 4)
+        if offset >= len(data) or offset in starts:
+            m._fail('task_fixed_record_geometry')
+        starts.add(offset)
+        records.append((flags, offset))
+    ordered = sorted(starts)
+    # Every metadata record owns its interval, including all reserved records.
+    ends = dict(zip(ordered, ordered[1:] + [len(data)]))
+    return [(flags, offset, ends[offset]) for flags, offset in records]
+
+
+def extract_catalog(cfb, native_format, check, external_check):
+    version = {'MSProject.MPP12': '12', 'MSProject.MPP14': '14'}[native_format]
+    _structure(cfb, version)
+    def required(path):
+        if path not in cfb.streams:
+            m._fail('project_stream_missing')
+        return cfb.streams[path]
+    props = m._properties(required(('Props' + version,)), check)
