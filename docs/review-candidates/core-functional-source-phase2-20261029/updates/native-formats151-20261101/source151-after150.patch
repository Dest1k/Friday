+"""Own-user, create-only publication of a narrow native Publisher text copy."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _source, _verify, _path, _inline_budget, _fits, _capacity, _encode
+from tools.scoped_pub import PUBError
+from tools.scoped_pub_write import edit_pub, parse_request
+
+
+def execute(cap, fd, leaf, relative, content):
+    _check_parent(cap, fd, relative)
+    if PurePosixPath(relative).suffix.lower()!='.pub' or PurePosixPath(relative).name!=leaf:
+        raise ScopeDenied()
+    checkpoint=lambda:check(cap)
+    try:
+        spec=parse_request(content,checkpoint)
+        try:
+            source=_path(spec['source'])
+        except UnicodeError:
+            raise ScopeDenied() from None
+        if PurePosixPath(source).suffix.lower()!='.pub' or source==relative:
+            raise ScopeDenied()
+        original,identity=_source(cap,source)
+        sources=[(source,original,identity)]
+        edit={key:value for key,value in spec.items() if key!='source'}
+        data,receipt=edit_pub(original,edit,checkpoint=checkpoint)
+    except PUBError as error:
+        return _encode({'success':False,'error':'pub_operation_refused','reason':str(error),'effect_disposition':'none'})
+    estimate=dict(receipt,success=True,path=relative,format='pub',scope='own_user_workspace',
+        create_only=True,verified=True,bytes_written=len(data),sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate,_inline_budget()):
+        return _capacity(_inline_budget())
+    _verify(cap,sources)
+    answer=json.loads(_create_bytes(cap,fd,leaf,relative,data,output_format='pub',
+        verify_source=lambda:_verify(cap,sources)))
+    if answer.get('success'):answer.update(receipt)
+    return _encode(answer)
