+
+class EditNotAccepted(ValueError):
+    pass
+
+
+def require(value, reason):
+    if not value:
+        raise EditNotAccepted(reason)
+
+
+def _spans(store, r, depth=0):
+    """Walk actual PropertyID/value serialization; never search for text bytes."""
+    require(depth < one.MAX_DEPTH, 'property_depth')
+    count = r.num(2)
+    require(count <= one.MAX_PROPERTIES, 'property_count')
+    keys = [(r.pos, r.num(4)) for _ in range(count)]
+    result = {}
+    store.charge(count)
+    for number, (key_at, key) in enumerate(keys):
+        if number and number % 64 == 0:
+            store.charge()
+        ident, kind = key & 0x3FFFFFF, (key >> 26) & 31
+        require(ident not in result, 'property_duplicate')
+        at, width = r.pos, 0
+        if kind in (1, 2):
+            pass
+        elif 3 <= kind <= 6:
+            width = (1, 2, 4, 8)[kind-3]
+            r.take(width)
+        elif kind == 7:
+            width = r.num(4)
+            at = r.pos
+            require(width <= one.MAX_PROPERTY_BYTES, 'property_bytes')
+            r.take(width)
+        elif 8 <= kind <= 13:
+            if kind % 2:
+                r.num(4)
+        elif kind == 16:
+            number = r.num(4)
+            require(number <= one.MAX_PROPERTIES, 'property_array')
+            if number:
+                require((r.num(4) >> 26) & 31 == 17, 'property_array_type')
+            for _ in range(number):
+                _spans(store, r, depth+1)
+        elif kind == 17:
+            _spans(store, r, depth+1)
+        else:
+            raise EditNotAccepted('property_type')
+        result[ident] = dict(kind=kind, key_offset=key_at,
+                             value_offset=at, value_bytes=width)
+    return result
+
+
+class TraceStore(one._Store):
+    """Location-aware derivative; reuses the production parser and semantic validation."""
+    def __init__(self, data, checkpoint=None):
+        self.property_spans = {}
+        self.declarations = []
+        self.revision_details = {}
+        super().__init__(data, checkpoint=checkpoint)
+
+    def properties(self, ref, ids):
+        props = super().properties(ref, ids)
+        r = self.chunk(ref)
+        header = r.num(4)
+        r.take((header & 0xFFFFFF)*4)
+        if not header & 0x80000000:
+            sh = r.num(4)
+            r.take((sh & 0xFFFFFF)*4)
+            if sh & 0x40000000:
+                th = r.num(4)
+                r.take((th & 0xFFFFFF)*4)
+        spans = _spans(self, r)
+        require(all(props[k][0] == v['kind'] for k, v in spans.items())
+                and set(props) == set(spans), 'property_span_mismatch')
+        self.property_spans[ref] = spans
+        return props
+
+    def declaration(self, node, ids, objects, inherited):
+        oid, obj = super().declaration(node, ids, objects, inherited)
+        self.declarations.append(dict(oid=oid, obj=obj, node=node))
+        return oid, obj
+
+    def revision_list(self, nodes, space_id):
+        result = super().revision_list(nodes, space_id)
+        labels, revisions, declaration_revisions = {}, {}, {}
+        current = None
+        for node in nodes:
+            self.charge()
+            if node.kind in (0x1B, 0x1E, 0x1F):
+                r = self.payload(node, 0)
+                rid, parent = r.exguid(), r.exguid()
+                if node.kind == 0x1B:
+                    r.num(8)
+                role, odcs = r.num(4), r.num(2)
+                context = r.exguid() if node.kind == 0x1F else one._NIL
+                r.done()
+                current = rid
+                revisions[rid] = dict(parent=parent, role=role, context=context,
+                                      node_offset=node.offset)
+                labels[context, role] = rid
+            elif node.kind in (0x5C, 0x5D):
+                r = self.payload(node, 0)
+                rid, role = r.exguid(), r.num(4)
+                context = r.exguid() if node.kind == 0x5D else one._NIL
+                r.done()
+                labels[context, role] = rid
+            elif node.kind == 0x1C:
+                current = None
+            elif node.kind == 0xB0:
+                for child in node.children:
+                    if child.kind in (0x2D,0x2E,0x41,0x42,0x72,0x73,0xA4,0xA5,0xC4,0xC5):
+                        declaration_revisions[child.offset] = current
+            elif node.kind in (0x2D,0x2E,0x41,0x42,0x72,0x73,0xA4,0xA5,0xC4,0xC5):
+                declaration_revisions[node.offset] = current
+        self.revision_details[space_id] = dict(active=labels[one._NIL, 1],
+            revisions=revisions, declaration_revisions=declaration_revisions)
+        return result
+
+
+def _nodes(nodes):
+    for node in nodes:
+        yield node
+        if node.children:
+            yield from _nodes(node.children)
+
+
+def _current_paragraphs(store):
+    """Follow the same persisted semantic edges; include aliases for refusal."""
+    roots, objects = store.spaces[store.root_space]
+    section = objects[roots[1]]
+    rows = []
+    def walk(oid, objs, sid, page_oid, where, path, depth=0):
+        store.charge()
+        require(depth < one.MAX_DEPTH and oid not in path, 'semantic_cycle')
+        obj = objs[oid]
+        if obj.jcid == 0x6000E:
+            rows.append(dict(space=sid, page=page_oid, oid=oid, obj=obj,
+                             where=where, path=path+(oid,)))
+            require(len(rows) <= one.MAX_NODES, 'paragraph_count')
+            return
+        if obj.jcid in (0x60011, 0x60035, 0x60014):
+            return
+        if obj.jcid == 0x6000D:
+            for child in one._refs(obj, 0x1C1F):
+                walk(child, objs, sid, page_oid, where, path+(oid,), depth+1)
+        for child in one._refs(obj, 0x1C20):
+            walk(child, objs, sid, page_oid, where, path+(oid,), depth+1)
+    for series_id in one._refs(section, 0x1C20):
+        for sid in one._property(objects[series_id], 0x1D63, 11, []):
+            roots, objs = store.spaces[sid]
+            page_oid, = one._refs(objs[roots[1]], 0x1C1F)
+            page = objs[page_oid]
+            for title in one._refs(page, 0x1D5F):
+                children = one._refs(objs[title], 0x1C20)
+                if children:
+                    walk(children[0], objs, sid, page_oid, 'title', (title,))
+            for child in one._refs(page, 0x1C20):
+                walk(child, objs, sid, page_oid, 'body', ())
+    return rows
+
+
+def inspect_native(data, *, checkpoint=None):
+    """Offline diagnostic IDs, not a published read/write tool contract."""
+    store = TraceStore(data, checkpoint=checkpoint)
+    document = one._decode_store(store)
+    rows = _current_paragraphs(store)
+    return store, document, rows
+
+
+def inspect_edit(data, spec, *, checkpoint=None, _return_context=False):
+    require(type(spec) is dict and set(spec) == {
+        'source_sha256','page_id','object_id','old_text','new_text'}, 'edit_schema')
+    require(type(data) is bytes and len(data) <= 1_000_000, 'tool_input_bound')
+    expected = spec['source_sha256']
+    require(type(expected) is str and re.fullmatch('[0-9a-f]{64}', expected), 'source_sha256')
+    require(hashlib.sha256(data).hexdigest() == expected, 'source_changed')
+    for key in ('page_id', 'object_id'):
+        require(type(spec[key]) is str and 1 <= len(spec[key]) <= 64, 'native_identity')
+    for key in ('old_text', 'new_text'):
+        value = spec[key]
+        require(type(value) is str and 1 <= len(value) <= 8192, 'literal_text')
+        require(not any(ord(c) < 32 or 0x7F <= ord(c) <= 0x9F
+                or 0xD800 <= ord(c) <= 0xDFFF or 0xFDD0 <= ord(c) <= 0xFDEF
+                or ord(c) in (0x2028,0x2029) or ord(c) & 0xFFFF in (0xFFFE,0xFFFF)
+                for c in value), 'unsupported_literal_text')
+    old = spec['old_text'].encode('utf-16-le')
+    new = spec['new_text'].encode('utf-16-le')
+    require(old != new and len(old) == len(new), 'same_utf16_width_required')
+    store, document, rows = inspect_native(data, checkpoint=checkpoint)
+    selected = [r for r in rows if one._id(r['space']) == spec['page_id']
+                and one._id(r['oid']) == spec['object_id']]
+    require(len(selected) == 1, 'ambiguous_or_missing_current_object')
+    target, = selected
+    require(target['where'] == 'body', 'body_paragraph_only')
+    obj = target['obj']
+    require(sum(r['obj'] is obj for r in rows) == 1, 'active_semantic_alias')
+    raw = one._property(obj, 0x1C22, 7)
+    property_id = 0x1C22
+    if raw is None:
+        raw = one._property(obj, 0x3498, 7)
+        property_id = 0x3498
+        require(raw is not None, 'native_text_property_required')
+        try:
+            old_native = spec['old_text'].encode('latin1')
+            new_native = spec['new_text'].encode('latin1')
+        except UnicodeError:
+            raise EditNotAccepted('native_text_encoding') from None
+        require(raw == old_native and len(old_native) == len(new_native), 'old_text_mismatch')
+    else:
+        require(0x3498 not in obj.props, 'dual_native_text_properties')
+        require(one._text(obj, 0x1C22) == spec['old_text'], 'old_text_mismatch')
+        require(raw.startswith(old) and not any(raw[len(old):]) and len(raw) % 2 == 0,
+                'unicode_storage_padding')
+    require(not one._refs(obj, 0x3458) and 0x3499 not in obj.props,
+            'rich_text_data_requires_native_writer')
+    require(len(one._refs(obj, 0x1E13)) <= 1
+            and not one._property(obj, 0x1E12, 7, b''), 'multi_run_requires_native_writer')
+    require(not one._property(obj, 0x1E16, 2, False), 'hidden_text')
+    objs = store.spaces[target['space']][1]
+    for fid in one._refs(obj, 0x1E13) + one._property(obj, 0x342C, 8, []):
+        style = objs[fid]
+        require(not any(one._property(style, key, 2, False)
+            for key in (0x1E16,0x1E22,0x3401,0x1E14,0x1E19)), 'hidden_field_or_link_run')
+    decls = [r for r in store.declarations if r['obj'].offset == obj.offset]
+    require(len(decls) == 1, 'declaration_identity')
+    node = decls[0]['node']
+    require(node.kind in (0xA4,0xA5) and obj.jcid == 0x6000E, 'writable_native_declaration_required')
+    spans = store.property_spans[node.ref]
+    span = spans[property_id]
+    require(data[span['value_offset']:span['value_offset']+span['value_bytes']] == raw,
+            'native_span_mismatch')
+    overlaps = []
+    lo, size = node.ref
+    for other in _nodes(store.root_nodes):
+        if other.offset != node.offset and other.ref:
+            a, n = other.ref
+            if n and max(a,lo) < min(a+n,lo+size):
+                overlaps.append(dict(node=other.offset, kind=other.kind, ref=other.ref))
+    require(not overlaps, 'shared_or_overlapping_native_storage')
+    detail = store.revision_details[target['space']]
+    declaration_revision = detail['declaration_revisions'][node.offset]
+    active = detail['active']
+    require(declaration_revision == active, 'inherited_or_history_backing_storage')
+    hcl = struct.unpack_from('<QI', data, 148)
+    unknown_properties = sorted(set(obj.props) - {
+        0x1D7A,0x342C,0x1CFE,0x1E13,0x1E12,0x1C22,0x1C3E,0x1C84,0x3498})
+    plan = dict(status='STRUCTURAL_SELECTION_ONLY', writable=False, effect_disposition='none',
+        reason='additional_write_validation_required',
+        source_sha256=expected, page_id=spec['page_id'], object_id=spec['object_id'],
+        current_revision_id=one._id(active), declaration_revision_id=one._id(declaration_revision),
+        native_declaration_offset=node.offset, native_declaration_kind=node.kind,
+        native_chunk=list(node.ref), native_property_id=hex(property_id), **span,
+        old_utf16_bytes=len(old), new_utf16_bytes=len(new),
+        materialized_node_storage_overlap_count=len(overlaps),
+        complete_storage_exclusivity='NOT_PROVEN',
+        hashed_chunk_list_reference=list(hcl),
+        hashed_chunks_and_free_space_validation='NOT_IMPLEMENTED_FOR_WRITING',
+        unknown_selected_property_ids=[hex(k) for k in unknown_properties],
+        required_native_writer=[
+          'new dependent revision identity; retain original revision object states',
+          'new unshared property chunk and native declaration with resolved IDs',
+          'object reference counts and dependency-override CRC',
+          'committed file-node-list extension and cumulative transaction CRC',
+          'header transaction count, version GUID/generation, deny-read GUID when required',
+          'destination-name CRC and exact unaffected-byte manifest',
+          'validate hashed/free/uncommitted storage and unsupported text semantics'],
+        ordinary_tool_feature_enabled=False, application_interoperability='NOT_TESTED')
+    return (plan, store, document, rows) if _return_context else plan
+
+
+GUIDANCE = ('OneNote native literal copy edit: format=onenote_text_edit, NEW .one path, '
+    'exact JSON {source,source_sha256,page_id,object_id,old_text,new_text}. '
+    'Obtain persisted page_id/object_id from own-workspace read_file native_text_objects '
+    'and the current source hash; explicitly supplied whole-paragraph literals only. '
+    'The current body object must be unique, plain, have one or no formatting run, '
+    'known supported properties, schema40 metadata and unshared storage; equal UTF-16 byte width and '
+    'equal native byte width required. ANSI text is limited to German/English/French language IDs and non-control Latin-1 bytes; Unicode is UTF-16. A new dependent revision/transaction retains '
+    'all original revision bytes; old text remains in native history. This is not '
+    'redaction. Unknown properties (including common 0x34DD), fields, hidden text, '
+    'links, multi-run text, titles, aliases, inherited backing, nonempty free lists '
+    'and unsupported transaction geometry refuse. No general .one creation, '
+    '.onepkg/.onetoc2 writes, conversion or raw overwrite. No application '
+    'interoperability, rendering or sync behavior has been tested. ')
+
+
+def _raw_node(data, node):
+    size = (int.from_bytes(data[node.offset:node.offset+4], 'little') >> 10) & 8191
+    return data[node.offset:node.offset+size]
+
+
+def _node(kind, payload=b'', ref=None, base=0):
+    size = 4 + len(payload) + (12 if ref else 0)
+    require(4 <= size < 8192, 'new_file_node_size')
+    return (struct.pack('<I', 0x80000000 | (base << 27) | (size << 10) | kind)
+            + (struct.pack('<QI', *ref) if ref else b'') + payload)
+
+
+def _fragment(ident, sequence, nodes):
+    data = struct.pack('<QII', 0xA4567AB1F5F7F4C4, ident, sequence) + b''.join(nodes)
+    data += bytes((-(len(data)+20)) % 8)
+    return data + struct.pack('<QIQ', 0xFFFFFFFFFFFFFFFF, 0, 0x8BC215C38233BA4B)
+
+
+def _log_prefix(store):
+    result, ref, committed = [], store.log_ref, 0
+    while committed < store.transaction_count:
+        r = store.chunk(ref)
+        end = r.pos + ((r.end-r.pos-12)//8)*8
+        while r.pos < end:
+            store.charge()
+            raw = r.take(8)
+            result.append(raw)
+            if int.from_bytes(raw[:4], 'little') == 1:
+                committed += 1
+                if committed == store.transaction_count:
+                    return b''.join(result)
+        ref = store.ref(r)
+    raise EditNotAccepted('transaction_prefix')
+
+
+def _incoming(objects, roots, target):
+    def refs(props):
+        for kind, value in props.values():
+            if kind in (8,9):
+                yield from value
+            elif kind == 16:
+                for child in value:
+                    yield from refs(child)
+            elif kind == 17:
+                yield from refs(value)
+    return sum(target in set(refs(obj.props)) for obj in objects.values()) + (target in roots.values())
+
+
+def edit_text(data, spec, destination_name, *, checkpoint=None, now=None):
+    """Return new native bytes plus structural receipt, or refuse before staging.
+
+    MS-ONESTORE 2.1.8/2.1.9/2.3.1/2.3.3/2.4.1/2.6.10 govern this append.
+    Existing FileNodes and property chunks are never rewritten. Only the selected
+    revision-list last-fragment link and related header fields change in prefix.
+    """
+    plan, store, before_doc, rows = inspect_edit(data, spec, checkpoint=checkpoint, _return_context=True)
+    require(type(destination_name) is str and destination_name.lower().endswith('.one')
+            and '/' not in destination_name and '\\' not in destination_name
+            and len(destination_name.encode('utf-16-le')) <= 512, 'destination_name')
+    require(not plan['unknown_selected_property_ids'], 'unknown_selected_property')
+    require(len(data) == store.length, 'uncommitted_physical_append')
+    require(store.free_ref in ((0,0),(0xFFFFFFFFFFFFFFFF,0)), 'free_list_write_validation_required')
+    require(store.transaction_count < one.MAX_NODES and store.generation < 0xFFFFFFFFFFFFFFFF,
+            'file_generation_bound')
+    target = next(r for r in rows if one._id(r['space']) == spec['page_id']
+                  and one._id(r['oid']) == spec['object_id'])
+    obj, oid, sid = target['obj'], target['oid'], target['space']
+    roots, objects = store.spaces[sid]
+    property_kinds = {0x1D7A:5,0x342C:8,0x1CFE:4,0x1E13:9,0x1E12:7,
+                      0x1C22:7,0x3498:7,0x1C3E:5,0x1C84:5}
+    require(all(kind == property_kinds.get(key) for key,(kind,_) in obj.props.items()),
+            'selected_property_type')
+    if plan['native_property_id'] == '0x3498':
+        # In the retained German/English/French producer profiles the admitted
+        # non-control bytes are shared by Latin-1 and Windows-1252. Never infer
+        # an arbitrary ANSI/DBCS code page from the read-only decoder's fallback.
+        require(one._property(obj,0x1CFE,4) in (1031,1033,1036), 'native_text_language')
+    for space_roots, space_objects in store.spaces.values():
+        for candidate in space_objects.values():
+            for key in (0x1D82,0x348B):
+                if key in candidate.props:
+                    require(candidate.props[key] == (5,40), 'unsupported_write_schema_revision')
+    metadata = objects.get(roots.get(2))
+    require(metadata is not None and all(metadata.props.get(key) == (5,40)
+            for key in (0x1D82,0x348B)), 'write_schema_metadata_required')
+    require(_incoming(objects, roots, oid) == 1 and oid not in roots.values(), 'object_reference_alias')
+    require(all(oid not in obs for other_sid, (_,obs) in store.spaces.items() if other_sid != sid),
+            'cross_space_identity_alias')
+    selected = next(d['node'] for d in store.declarations if d['obj'].offset == obj.offset)
+    group = next((n for n in _nodes(store.root_nodes) if n.kind == 0xB0
+                  and selected in n.children), None)
+    require(group is not None and group.children[1].kind == 0x22, 'native_group_table_required')
+    # A hash directory can alias property storage without appearing in the
+    # current semantic graph. Parse it with committed list counts, never scan.
+    hcl_ref = struct.unpack_from('<QI', data, 148)
+    hcl = () if hcl_ref in ((0,0),(0xFFFFFFFFFFFFFFFF,0)) else store.node_list(hcl_ref)
+    lo, size = selected.ref
+    for n in hcl:
+        store.charge()
+        require(n.kind == 0xC2 and n.ref and n.children is None and len(n.payload) == 16,
+                'hashed_chunk_directory')
+        store.chunk(n.ref)
+        a, length = n.ref
+        require(max(lo,a) >= min(lo+size,a+length), 'hashed_property_storage_alias')
+    # No property data can overlap header, logs or list-fragment metadata.
+    protected = [(0,1024)]
+    for ref in (store.log_ref,):
+        seen = set()
+        while ref not in seen:
+            seen.add(ref); protected.append(ref)
+            # Only committed fragments are relevant. Last sentinel can end
+            # before undefined fragment links, which must never be followed.
+            sentinel_offsets = [x['sentinel_offset'] for x in store.trace['transactions']]
+            if any(ref[0] <= x < sum(ref) for x in sentinel_offsets[-1:]):
+                break
+            r = store.chunk(ref)
+            r.pos += ((r.end-r.pos-12)//8)*8
+            ref = store.ref(r)
+            require(len(seen) < one.MAX_LISTS, 'log_fragment_bound')
+    traces = {t['offset']: t for t in store.trace['lists']}
+    for first in list(store.lists):
+        ref = first
+        while True:
+            protected.append(ref)
+            tr = traces[ref[0]]
+            if tr['remaining'] == 0:
+                break
+            ref = struct.unpack_from('<QI', data, sum(ref)-20)
+    for a, length in protected:
+        require(max(lo,a) >= min(lo+size,a+length), 'property_metadata_overlap')
+    # Locate the current space's revision list, including its final committed
+    # fragment. A nonzero unused tail could be an outstanding native intent.
+    space_node = next(n for n in store.root_nodes if n.kind == 8
+                      and store.payload(n,2).exguid() == sid)
+    rev_first = space_node.children[-1].ref
+    rev_id = int.from_bytes(data[rev_first[0]+8:rev_first[0]+12], 'little')
+    ref = rev_first
+    while traces[ref[0]]['remaining']:
+        ref = struct.unpack_from('<QI', data, sum(ref)-20)
+    tr = traces[ref[0]]
+    last = store.lists[rev_first][-1]
+    last_end = last.offset + len(_raw_node(data,last))
+    footer_at = sum(ref)-20
+    require(last.kind in (0x1C,0x5C,0x5D) and ref[0]+16 <= last_end <= footer_at
+            and not any(data[last_end:footer_at]), 'uncommitted_revision_tail')
+    require(struct.unpack_from('<QI', data, footer_at) == (0xFFFFFFFFFFFFFFFF,0),
+            'uncommitted_revision_next_fragment')
+    require(tr['sequence'] < 0xFFFFFFFF and store.counts[rev_id]+4 <= one.MAX_NODES,
+            'revision_list_bound')
+    group_list_id = max(store.counts)+1
+    require(group_list_id < 0xFFFFFFFF, 'file_list_identity_bound')
+    # Preserve the exact source table, but define only the selected object in
+    # the new group. All its outbound object identities stay unchanged.
+    table = []
+    for n in group.children[1:]:
+        table.append(_raw_node(data,n))
+        if n.kind == 0x28:
+            break
+    require(group.children[1].kind == 0x22 and any(n.kind == 0x28
+            and not n.payload and n.ref is None for n in group.children[1:]), 'native_global_id_table')
+    payload = bytearray(selected.payload)
+    require(len(payload) == (10 if selected.kind == 0xA4 else 13), 'object_declaration_geometry')
+    require(int.from_bytes(payload[9:], 'little') == 1, 'native_reference_count_mismatch')
+    span = store.property_spans[selected.ref][int(plan['native_property_id'],16)]
+    native_encoding = 'utf-16-le' if int(plan['native_property_id'],16) == 0x1C22 else 'latin1'
+    old, new = spec['old_text'].encode(native_encoding), spec['new_text'].encode(native_encoding)
