+    # password flag, nonzero code or password-hash property is refused.
+    if (props.get(893386752) != b'\0'
+            or props.get(893386759, b'\0') != b'\0'
+            or 893386756 in props or 893386757 in props):
+        m._fail('project_password_or_encryption')
+    field_map, field_count = m._layout(m._properties(required(('   1' + version, 'Props')), check), check, modern=True)
+    prefix = ('   1' + version, 'TBkndTask')
+    fixed = required(prefix + ('FixedData',))
+    records = _fixed(required(prefix + ('FixedMeta',)), fixed, 47, check)
+    meta2, fixed2 = required(prefix + ('Fixed2Meta',)), required(prefix + ('Fixed2Data',))
+    widths = (86,) if version == '12' else (92, 93, 94, 95, 96)
+    candidates = [width for width in widths if len(meta2) == 16 + len(records) * width]
+    if len(candidates) != 1:
+        m._fail('unsupported_task_fixed2_layout')
+    records2 = _fixed(meta2, fixed2, candidates[0], check, count=len(records))
+    var = m._variable(required(prefix + ('VarMeta',)), required(prefix + ('Var2Data',)), check, modern=True)
+    required_size = max(field_map[n] + width for n, width in
+                        [('unique_id', 4), ('id', 4), ('parent_unique_id', 4), ('outline_level', 2)])
+    rows, ids, uids = [], set(), set()
+    for index, ((flags, offset, end), (_, offset2, end2)) in enumerate(zip(records, records2)):
+        check()
+        if index < 3:
+            if (flags != 4 or end - offset != 16 or m._u32(fixed, offset) != 0xFFFF0000 + index):
+                m._fail('task_reserved_record')
+            continue
+        # Resolving deleted, alternate, null and partial historical records is
+        # intentionally not inferred. Accept only complete unambiguous rows.
+        if flags & 6:
+            m._fail('unsupported_task_history_or_deletion')
+        if offset + required_size > end or end2 <= offset2:
+            m._fail('task_fixed_record_geometry')
+        uid = m._u32(fixed, offset + field_map['unique_id'])
+        task_id = m._u32(fixed, offset + field_map['id'])
+        parent = m._u32(fixed, offset + field_map['parent_unique_id'])
+        level = m._u16(fixed, offset + field_map['outline_level'])
+        if uid > 0xFFFFFF or task_id > 0xFFFFFF or uid in uids or task_id in ids or level > 64:
+            m._fail('task_identity_or_outline')
+        entry = var.get((uid, field_map['name']))
+        if entry is None:
+            m._fail('task_name_record_missing')
+        name_offset, raw = entry
+        if len(raw) < 2 or len(raw) > 8192 or len(raw) % 2 or raw[-2:] != b'\0\0':
+            m._fail('task_name_encoding')
+        try:
+            name = raw[:-2].decode('utf-16le', errors='strict')
+        except UnicodeError:
+            m._fail('task_name_encoding')
+        if any(ord(ch) < 32 and ch not in '\t\n\r' for ch in name):
+            m._fail('task_name_control')
+        uids.add(uid); ids.add(task_id)
+        rows.append(dict(record_type='task', unique_id=uid, id=task_id, name=name,
+                         parent_unique_id=None if parent == m.FREE else parent, outline_level=level,
+                         native_record=index, fixed_offset=offset, name_offset=name_offset))
+    by_uid = {row['unique_id']: row for row in rows}
+    if 0 not in by_uid:
+        m._fail('project_summary_record_missing')
+    for row in rows:
+        check()
+        if row['unique_id'] == 0:
+            if row['id'] != 0 or row['parent_unique_id'] is not None or row['outline_level'] != 0:
+                m._fail('project_summary_identity')
+        else:
+            parent = by_uid.get(row['parent_unique_id'])
+            if parent is None or parent['outline_level'] + 1 != row['outline_level'] or parent['id'] >= row['id']:
+                m._fail('task_parent_reference')
+    rows.sort(key=lambda row: row['id'])
+    coverage = 'stored_task_identity_name_outline_only; scheduling_and_other_fields_not_decoded'
+    metadata = dict(schema='friday.mpp.task_catalog.v1', format='mpp', native_format=native_format,
+                    input_version=int(version), source_sha256=hashlib.sha256(cfb.data).hexdigest(), coverage=coverage,
+                    task_count=len(rows), deleted_records_omitted=0, field_map_records=field_count,
+                    fixed2_meta_record_size=candidates[0], partial_semantics=True, stored_content_untrusted=True)
+    header = dict(record_type='project_profile', native_format=native_format, input_version=int(version),
+                  task_count=len(rows), deleted_records_omitted=0,
+                  omitted=['dates', 'durations', 'dependencies', 'calendars', 'resources', 'assignments',
+                           'costs', 'baselines', 'custom_fields', 'notes', 'views', 'embedded_content'])
+    text = '\n'.join(json.dumps(row, ensure_ascii=True, separators=(',', ':')) for row in [header] + rows) + '\n'
+    if len(text.encode('utf-8')) > m.MAX_TEXT:
+        m._fail('task_catalog_output_limit')
+    external_check()
+    return m._Text(text, metadata)
