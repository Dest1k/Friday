+# SPDX-License-Identifier: MPL-2.0
+"""Equal-length native PUB text copies using validated Contents/Quill allocation.
+
+This module uses the MPL-2.0 parser in scoped_pub; see scoped_pub.LICENSE.
+No CFB allocation, directory record, style, image or layout is rewritten.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import time
+import unicodedata
+
+from tools.scoped_pub import (
+    PUBError, MAX_INPUT, MAX_TEXT_UNITS, END, _CFB, _Parser, _fail, extract_pub,
+)
+
+QUILL = ('Quill', 'QuillSub', 'CONTENTS')
+MAX_REQUEST = 100_000
+GUIDANCE = (
+    'PUB narrow text edit: write_file format=pub_text_edit creates a NEW .pub from exactly '
+    '{source,source_sha256,page_id,shape_id,story_id,old_text,new_text}. Read first for the current '
+    'lowercase SHA-256 and native integer page/shape/story IDs. The IDs select one ordinary-page '
+    'shape story; old_text must occur exactly once within it, including overlapping matches. '
+    'Use nonempty plain text with equal UTF-16 byte length; old_text and new_text must differ and '
+    'must not include tabs, paragraph breaks or control characters. All other file bytes, streams, '
+    'CFB allocation and directories are preserved exactly; the input remains unchanged. '
+    'Master/dummy pages, tables, shared/linked stories, unsupported structures and documents with '
+    'Quill TOKN link/field records refuse. File links, overwrite, source mutation, stale hash, '
+    'revocation and cancellation refuse. Current own-workspace scope and deadline apply. '
+    'This is a stored-text replacement only: no Publisher application interoperability, rendering, '
+    'layout, visual fit, style correctness, creation, broad editing or conversion is claimed. '
+)
+
+
+def parse_request(content, checkpoint=None):
+    if type(content) is not str or len(content) > MAX_REQUEST:
+        _fail('pub_edit_request_limit')
+    try:
+        if len(content.encode('utf-8')) > MAX_REQUEST:
+            _fail('pub_edit_request_limit')
+    except UnicodeError:
+        _fail('pub_edit_invalid_text')
+    # Bound nesting before the JSON decoder and reject duplicated keys.
+    depth = 0; quoted = False; escaped = False
+    for index, ch in enumerate(content):
+        if index % 1024 == 0 and checkpoint is not None:
+            checkpoint()
+        if quoted:
+            if escaped: escaped = False
+            elif ch == '\\': escaped = True
+            elif ch == '"': quoted = False
+        elif ch == '"': quoted = True
+        elif ch in '[{':
+            depth += 1
+            if depth > 4: _fail('pub_edit_json_depth')
+        elif ch in ']}': depth -= 1
+    def pairs(items):
+        out = {}
+        for key, value in items:
+            if key in out: _fail('pub_edit_duplicate_key')
+            out[key] = value
+        return out
+    try:
+        spec = json.loads(content, object_pairs_hook=pairs,
+            parse_constant=lambda _: _fail('pub_edit_nonfinite'))
+    except (ValueError, RecursionError) as error:
+        if isinstance(error, PUBError): raise
+        _fail('pub_edit_invalid_json')
+    required = {'source', 'source_sha256', 'page_id', 'shape_id', 'story_id', 'old_text', 'new_text'}
+    if type(spec) is not dict or set(spec) != required:
+        _fail('pub_edit_fields')
+    return spec
+
+
+def _literal(value):
+    if type(value) is not str or not 1 <= len(value) <= 16384:
+        _fail('pub_edit_text_limit')
+    try:
+        encoded = value.encode('utf-16le')
+    except UnicodeError:
+        _fail('pub_edit_invalid_text')
+    if any(unicodedata.category(c).startswith('C') or unicodedata.category(c) in ('Zl','Zp')
+           or ord(c) in (0xfffe, 0xffff) for c in value):
+        _fail('pub_edit_control')
+    return encoded
+
+
+def _chain_ids(cfb, start, size, *, mini=False):
+    unit = 64 if mini else cfb.sector_size
+    count = (size + unit - 1) // unit
+    table = cfb.mini_fat if mini else cfb.fat
+    available = len(cfb.mini) // 64 if mini else cfb.sectors
+    ids = []; seen = set(); sid = start
+    for _ in range(count):
+        cfb.check()
+        if not 0 <= sid < available or sid >= len(table) or sid in seen:
+            _fail('pub_edit_allocation')
+        ids.append(sid); seen.add(sid); sid = table[sid]
+    if sid != END:
+        _fail('pub_edit_allocation')
+    return ids
+
+
+def physical_spans(cfb, stream, offset, length):
+    """Map a checked stream byte range to original file ranges without scanning."""
+    if stream not in cfb.stream_allocations:
+        _fail('pub_edit_stream_missing')
+    start, size = cfb.stream_allocations[stream]
+    if type(offset) is not int or type(length) is not int or not 0 <= offset <= size or not 0 < length <= size-offset:
+        _fail('pub_edit_range')
+    mini = size < 4096
+    ids = _chain_ids(cfb, start, size, mini=mini)
+    root_ids = _chain_ids(cfb, cfb.mini_start, len(cfb.mini)) if mini else []
+    unit = 64 if mini else cfb.sector_size
+    spans = []; remaining = length
+    while remaining:
+        cfb.check()
+        index, within = divmod(offset, unit)
+        amount = min(remaining, unit-within)
+        if mini:
+            root_offset = ids[index]*64+within
+            root_index, root_within = divmod(root_offset, cfb.sector_size)
+            physical = (root_ids[root_index]+1)*cfb.sector_size+root_within
+        else:
+            physical = (ids[index]+1)*cfb.sector_size+within
+        if physical < cfb.sector_size or physical+amount > len(cfb.data):
+            _fail('pub_edit_allocation')
+        spans.append((physical, amount))
+        offset += amount; remaining -= amount
+    # Chain validation already proves disjoint ownership. Check the mapped bytes
+    # as well, so an incorrect logical-to-physical mapping cannot publish a copy.
+    mapped = b''.join(cfb.data[p:p+n] for p,n in spans)
+    original_offset = offset-length
+    if mapped != cfb.streams[stream][original_offset:original_offset+length]:
+        _fail('pub_edit_allocation')
+    return spans
+
+
+def edit_pub(data, spec, *, checkpoint=None):
+    """Return bytes and a content-free receipt; caller owns publication and CAS."""
+    deadline = time.monotonic()+5
+    def check():
+        if checkpoint is not None: checkpoint()
+        if time.monotonic() > deadline: _fail('pub_edit_deadline')
+    check()
+    if type(data) is not bytes or not 512 <= len(data) <= MAX_INPUT:
+        _fail('pub_input_limit')
+    if type(spec) is not dict or set(spec) != {'source_sha256','page_id','shape_id','story_id','old_text','new_text'}:
+        _fail('pub_edit_fields')
+    digest = spec['source_sha256']
+    if type(digest) is not str or re.fullmatch('[0-9a-f]{64}',digest) is None or hashlib.sha256(data).hexdigest()!=digest:
+        _fail('pub_edit_source_hash')
+    for key in ('page_id','shape_id','story_id'):
+        if type(spec[key]) is not int or not 0 <= spec[key] < 2**32:
+            _fail('pub_edit_identity')
+    old = _literal(spec['old_text']); new = _literal(spec['new_text'])
+    if len(old)!=len(new): _fail('pub_edit_utf16_length')
+    if old==new: _fail('pub_edit_no_change')
+    before = extract_pub(data, checkpoint=check)
+    records = [json.loads(line) for line in before.splitlines()]
+    selected = [r for r in records if r.get('shape_id')==spec['shape_id']]
+    if len(selected)!=1: _fail('pub_edit_identity')
+    selected = selected[0]
+    if any(selected.get(k)!=spec[k] for k in ('page_id','shape_id','story_id')):
+        _fail('pub_edit_identity')
+    if selected['kind']!='shape_story' or selected.get('page_role')!='page' or not selected.get('text'):
+        _fail('pub_edit_story_unsupported')
+    if sum(r.get('story_id')==spec['story_id'] for r in records)!=1:
+        _fail('pub_edit_story_shared')
+    text = selected['text']; at = text.find(spec['old_text'])
+    if at<0: _fail('pub_edit_text_missing')
+    if text.find(spec['old_text'],at+1)>=0: _fail('pub_edit_text_ambiguous')
+    cfb = _CFB(data,check)
+    parser = _Parser(check); stories,_ = parser.quill(cfb.streams[QUILL])
+    # TOKN contains links/fields whose offsets and meaning are not decoded by
+    # this bounded writer. Refuse the document, including unselected TOKN.
+    if any(name==b'TOKN' for name,_ in parser.quill_chunks):
+        _fail('pub_edit_tokens_unsupported')
+    story = stories[spec['story_id']]
+    if story['text'] != text or story['utf16_units'] > MAX_TEXT_UNITS:
+        _fail('pub_edit_identity')
+    offset = story['quill_offset']+len(text[:at].encode('utf-16le'))
+    spans = physical_spans(cfb,QUILL,offset,len(old))
+    if b''.join(data[p:p+n] for p,n in spans)!=old:
+        _fail('pub_edit_text_mismatch')
+    output = bytearray(data); used = 0
+    for p,n in spans:
+        check();output[p:p+n]=new[used:used+n];used += n
+    output=bytes(output)
+    # Byte-for-byte outside exactly the selected native range, even allocation
+    # padding, unreachable FREE sectors and stream directory timestamps.
+    end=0
+    for p,n in sorted(spans):
+        check()
+        if p<end or output[end:p]!=data[end:p]: _fail('pub_edit_unselected_changed')
+        end=p+n
+    if output[end:]!=data[end:]: _fail('pub_edit_unselected_changed')
+    after = extract_pub(output,checkpoint=check)
+    expected = [dict(r) for r in records]
+    for r in expected:
+        if r.get('shape_id')==spec['shape_id']:
+            r['text']=text[:at]+spec['new_text']+text[at+len(spec['old_text']):]
+    if [json.loads(line) for line in after.splitlines()]!=expected:
+        _fail('pub_edit_postvalidation')
+    # Compare all logical streams independently of the parser's returned text.
+    revised=_CFB(output,check)
+    expected_quill=cfb.streams[QUILL][:offset]+new+cfb.streams[QUILL][offset+len(old):]
+    if (revised.directory_records!=cfb.directory_records or revised.storages!=cfb.storages
+        or set(revised.streams)!=set(cfb.streams)
+        or any(value!=(expected_quill if name==QUILL else cfb.streams[name])
+               for name,value in revised.streams.items())):
+        _fail('pub_edit_postvalidation')
+    check()
+    return output, {'operation':'pub_text_edit','profile':'publisher_2002_plus_0x2c_equal_length_text_v1',
+        'source_sha256':digest,'source_unchanged':True,'other_bytes_preserved':True,
+        'page_id':spec['page_id'],'shape_id':spec['shape_id'],'story_id':spec['story_id'],
+        'replaced_utf16_units':len(old)//2,'stored_text_verified':True,
+        'rendered':False,'publisher_interoperability':'NOT_TESTED','layout_verified':False}
