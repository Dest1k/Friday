+"""Native OneStore new-copy edit in the existing own-workspace boundary."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _archive_spec, _source, _verify, _path, _encode, _fits, _inline_budget, _capacity
+from tools.scoped_onenote_edit import edit_text, EditNotAccepted
+from tools.scoped_onenote import OneNoteError
+
+
+def create_edit(cap, fd, leaf, relative, content):
+    _check_parent(cap, fd, relative)
+    if PurePosixPath(relative).suffix.lower() != '.one':
+        raise ScopeDenied()
+    spec = _archive_spec(content, {'source','source_sha256','page_id','object_id','old_text','new_text'})
+    source = _path(spec.pop('source'))
+    if source == relative or PurePosixPath(source).suffix.lower() != '.one':
+        raise ScopeDenied()
+    data, identity = _source(cap, source)
+    sources = [(source, data, identity)]
+    try:
+        result, receipt = edit_text(data, spec, leaf, checkpoint=lambda: check(cap))
+    except (EditNotAccepted, OneNoteError) as exc:
+        _verify(cap, sources)
+        check(cap)
+        return _encode(dict(success=False, error='onenote_edit_refused', reason=str(exc), effect_disposition='none'))
+    estimate = dict(receipt, success=True, path=relative, format='one', scope='own_user_workspace',
+        create_only=True, verified=True, bytes_written=len(result), sha256=hashlib.sha256(result).hexdigest(),
+        source_unchanged=True)
+    if not _fits(estimate, _inline_budget()):
+        return _capacity(_inline_budget())
+    _verify(cap, sources)
+    answer = json.loads(_create_bytes(cap, fd, leaf, relative, result, output_format='one',
+        verify_source=lambda: _verify(cap, sources)))
+    if answer.get('success'):
+        answer.update(receipt)
+        answer['source_unchanged'] = True
+    return _encode(answer)
