+            pages.add(page)
+            if len(pages) > 200:
+                fail('xps_page_limit')
+            root = roots[page]
+            declared = {k: root.get(k) for k in ('Width', 'Height', 'BleedBox', 'ContentBox', 'Name') if root.get(k) is not None}
+            declared['xml:lang'] = root.get(q(XML, 'lang'))
+            for attr in ('Width', 'Height'):
+                actual = number(root.get(attr), positive=True)
+                if attr in reference.attrib and number(reference.get(attr), positive=True) != actual:
+                    fail('xps_page_dimension_mismatch')
+            for attr in ('BleedBox', 'ContentBox'):
+                if root.get(attr) is not None:
+                    values = root.get(attr).split(',')
+                    if len(values) != 4:
+                        fail('xps_invalid_page_box')
+                    for val in values:
+                        number(val.strip())
+            resource_set = {target for kind, target in rels.get(page, {}).values() if kind == ns+'/required-resource'}
+            # Every direct resource URI must remain inside the checked package;
+            # remote dictionary contents are validated but are not expanded.
+            for node in root.iter():
+                for attr in ('FontUri', 'ImageSource'):
+                    if node.get(attr) is not None:
+                        resource = resolve(page, node.get(attr))
+                        allowed = FONTS if attr == 'FontUri' else IMAGES
+                        if resource not in resource_set or types.get(resource) not in allowed:
+                            fail('xps_resource_missing_or_unrelated')
+                if node.tag == q(ns, 'ResourceDictionary') and node.get('Source') is not None:
+                    resource = resolve(page, node.get('Source'))
+                    if resource not in resource_set or types.get(resource) != TYPES['dictionary']:
+                        fail('xps_dictionary_missing_or_unrelated')
+            record('PAGE', {'page': len(pages), 'document': doc_index, 'document_page': within_doc,
+                            'part': page, 'declared': declared})
+            def visit(node, in_content=True):
+                nonlocal glyph_count, missing, resource_glyphs
+                tick(checkpoint)
+                local = node.tag.rsplit('}', 1)[-1]
+                if local == 'Glyphs':
+                    if not in_content:
+                        resource_glyphs += 1
+                        return
+                    glyph_count += 1
+                    if glyph_count > 4096:
+                        fail('xps_glyph_run_limit')
+                    value = node.get('UnicodeString')
+                    if value is None:
+                        missing += 1
+                    elif value.startswith('{}'):
+                        value = value[2:]
+                    elif value.startswith('{'):
+                        fail('xps_unescaped_unicode_brace')
+                    if value is not None and len(value) > 32768:
+                        fail('xps_glyph_text_limit')
+                    if node.get('FontUri') is None:
+                        fail('xps_glyph_font_missing')
+                    chunks = [None] if value is None else [value[i:i+1024] for i in range(0, len(value), 1024)] or ['']
+                    for offset, chunk in enumerate(chunks):
+                        record('GLYPHS', {'page': len(pages), 'run': glyph_count, 'char_offset': offset*1024,
+                              'text': chunk, 'status': 'UNKNOWN_missing_UnicodeString' if value is None else 'stored_UnicodeString',
+                              'indices_present': 'Indices' in node.attrib, 'bidi_level': node.get('BidiLevel'),
+                              'is_sideways': node.get('IsSideways'), 'xml:lang': node.get(q(XML, 'lang'))})
+                    return
+                for child in node:
+                    # Only direct page/Canvas content contributes runs. Resource,
+                    # brush, path, property and fallback glyphs never become text.
+                    visit(child, in_content and local in ('FixedPage', 'Canvas') and child.tag.rsplit('}', 1)[-1] in ('Canvas', 'Glyphs', 'Path'))
+            visit(root)
+    if {n for n,t in types.items() if t == TYPES['document']} != documents or {n for n,t in types.items() if t == TYPES['page']} != pages:
+        fail('xps_unreferenced_document_or_page')
+    metadata = {'format': format, 'namespace': ns, 'mime': 'application/oxps' if format == 'oxps' else 'application/vnd.ms-xpsdocument',
+                'status': 'PARTIAL', 'pages': len(pages), 'documents': len(documents), 'glyph_runs': glyph_count,
+                'missing_unicode_runs': missing, 'noncontent_glyphs_omitted': resource_glyphs,
+                'coverage': 'page_ordered_stored_UnicodeString_and_declared_page_metadata_only',
+                'limitations': 'markup_order_not_visual_reading_order; no_rendering_OCR_font_glyph_inference_or_resource_execution; print_tickets_and_structure_not_applied'}
+    return _Text(header+'\n'.join(records), metadata)
+
+
+GUIDANCE = ('XPS/OXPS: read_file returns PARTIAL page-ordered stored Glyphs UnicodeString runs and declared page dimensions/language. '
+            'Glyph order is XML markup order, never visual or semantic reading order. Missing UnicodeString stays UNKNOWN; '
+            'glyph indices, fonts, images, resource dictionaries, print tickets and document structure never produce inferred text. '
+            'No rendering, OCR, external fetching, printing, conversion or native writing. Continue pagination and join each run by char_offset. '
+            'Encrypted, active, external, mixed-namespace, unsupported resource and malformed packages refuse. ')
