+"""Create-only scoped DBF creation/cell-copy edits with source hash and identity CAS."""
+import json
+from pathlib import Path
+
+
+def execute(cap, fd, leaf, path, content, *, operation):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_dbf import request, create, edit, DBFError
+    try:
+        check(cap);_check_parent(cap,fd,path)
+        if Path(path).suffix.lower() != '.dbf':
+            raise DBFError('dbf_output_suffix')
+        spec=request(content);source_state=None
+        if operation=='dbf_create':
+            output,facts=create(spec,checkpoint=lambda:check(cap))
+        elif operation=='dbf_edit':
+            # Validate before source I/O; edit does complete exact schema validation.
+            if not isinstance(spec.get('source'),str):
+                raise DBFError('dbf_edit_schema')
+            source,relative,data,identity=_read_source(spec['source'],cap,'.dbf')
+            output,facts=edit(data,spec,checkpoint=lambda:check(cap))
+            source_state=(source,data,identity);facts['source']=relative
+        else:
+            raise DBFError('dbf_operation')
+        check(cap)
+        return _publish(cap,fd,leaf,path,output,'dbf',source_state,facts)
+    except ScopeDenied:
+        raise
+    except DBFError as error:
+        return json.dumps(dict(success=False,error='dbf_operation_refused',reason=error.code,effect_disposition='none'))
+    except (OSError,RuntimeError,TimeoutError):
+        return json.dumps(dict(success=False,error='dbf_operation_stopped',effect_disposition='none'))
