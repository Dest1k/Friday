+"""Own-workspace FB2 creation and hash-bound byte-preserving copy edit."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_fb2 import FB2Error, object_spec, create_fb2, edit_fb2
+
+
+def execute(cap, fd, leaf, path, content, operation):
+    _check_parent(cap, fd, path)
+    if Path(path).suffix.lower() != '.fb2' or leaf != Path(path).name:
+        raise ScopeDenied()
+    try: os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError: pass
+    else:
+        return json.dumps({'success': False, 'error': 'document_already_exists', 'effect_disposition': 'none'})
+    source = original = identity = relative = None
+    try:
+        check(cap)
+        if operation == 'fb2_create':
+            rendered = create_fb2(content, checkpoint=lambda: check(cap))
+        elif operation == 'fb2_edit':
+            spec = object_spec(content)
+            if set(spec) != {'source', 'source_sha256', 'old_text', 'new_text'}: raise FB2Error('fb2_edit_schema')
+            raw = spec['source']; digest = spec['source_sha256']
+            if not isinstance(raw, str) or not raw or len(raw) > 4096 or '\x00' in raw: raise ScopeDenied()
+            if not isinstance(digest, str) or len(digest) != 64 or any(c not in '0123456789abcdef' for c in digest):
+                raise FB2Error('fb2_source_hash_required')
+            root = cap.home / 'workspace'; source = Path(raw)
+            if not source.is_absolute(): source = root / source
+            try: relative = source.relative_to(root)
+            except ValueError: raise ScopeDenied() from None
+            if (source.suffix.lower() != '.fb2' or not relative.parts
+                    or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+                    or relative.as_posix() == path): raise ScopeDenied()
+            original, _, identity = workspace_document(str(source), with_identity=True)
+            if hashlib.sha256(original).hexdigest() != digest: raise FB2Error('fb2_source_hash_mismatch')
+            rendered = edit_fb2(original, spec['old_text'], spec['new_text'], checkpoint=lambda: check(cap))
+        else: raise ScopeDenied()
+        check(cap)
+    except FB2Error as error:
+        return json.dumps({'success': False, 'error': 'fb2_operation_refused', 'reason': error.code, 'effect_disposition': 'none'})
+    verify = None
+    if source is not None:
+        def verify():
+            check(cap)
+            current, _, current_identity = workspace_document(str(source), with_identity=True)
+            if current != original or current_identity != identity: raise ScopeDenied()
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered, output_format='fb2', verify_source=verify))
+    if result.get('success'):
+        result.update(rendered=False, native_format=True)
+        if source is not None:
+            result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(original).hexdigest(),
+                          source_unchanged=True, replacements=1, edit_mode='unique_complete_plain_section_paragraph',
+                          unselected_bytes_preserved=True)
+    return json.dumps(result, ensure_ascii=False)
