+"""Inert bounded dBASE III/Level 5 nonmemo DBF tables, version byte 0x03.
+
+Only C/N/L/D scalar fields. No sidecars, SQL, indexes, memo, engine or network.
+Read all rows including deletion marks; text padding is removed, numeric values
+remain exact decimal strings, blank numeric/date and unknown logical are None.
+Copy edits replace one same-type field span and preserve every other byte,
+including the original last-update date. Unknown dialect/encoding refuses.
+"""
+from __future__ import annotations
+
+import datetime
+import hashlib
+import json
+import re
+import struct
+import time
+
+MAX_BYTES = 1_000_000
+MAX_REQUEST = 200_000
+MAX_FIELDS = 32
+MAX_ROWS = 512
+MAX_CELLS = 4096
+MAX_TEXT = 500_000
+MAX_SECONDS = 5
+CODEPAGES = {0x00: 'ascii', 0x01: 'cp437', 0x02: 'cp850', 0x03: 'cp1252',
+             0x65: 'cp866', 0xC9: 'cp1251'}
+NAMES = re.compile(r'[A-Za-z_][A-Za-z0-9_]{0,9}\Z')
+NUMBER = re.compile(r'-?[0-9]+(?:\.[0-9]+)?\Z')
+SHA = re.compile(r'[0-9a-f]{64}\Z')
+
+READ_GUIDANCE = ('DBF: bounded version-0x03 dBASE III/Level 5 nonmemo tables expose field metadata and all rows, including deleted rows. '
+    'C text trims native right-space padding; N values are exact decimal strings (never floats); L is boolean or null; D is ISO date or null. '
+    'Language driver 0 permits ASCII only; supported declared drivers are 1=cp437, 2=cp850, 3=cp1252, 101=cp866, 201=cp1251. '
+    'Unknown drivers, unmarked non-ASCII, memo/index/encrypted/unsupported dialects refuse; no sidecar or database engine runs. ')
+WRITE_GUIDANCE = ('DBF uses NEW .dbf output names. dbf_create content is exact JSON {encoding,language_driver,last_updated,fields,rows}; '
+    'last_updated is YYYY-MM-DD; fields are {name,type,length,decimal_count}, type C/N/L/D; rows are {deleted:boolean,values:[...]}. '
+    'Use a matching supported encoding/driver pair. Values: C text without trailing padding spaces; N decimal strings with exactly declared scale (or null); '
+    'L boolean/null; D YYYY-MM-DD/null. Numeric overflow and precision loss refuse. '
+    'dbf_edit content is exactly {source,source_sha256,row,field,expected,value}; row is one-based including deleted rows; field is the exact field name. '
+    'Use the source hash and typed value from read_file. Only one same-type field span changes; every other source byte, deletion flag and original update date stays unchanged. '
+    'No DBF overwrite, schema change, memo/index/SQL or general database conversion. ')
+
+
+class DBFError(ValueError):
+    """Content-free deterministic refusal reason."""
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def fail(code):
+    raise DBFError(code)
+
+
+def _guard(checkpoint):
