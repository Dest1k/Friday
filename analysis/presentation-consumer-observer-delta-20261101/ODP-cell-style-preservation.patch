+def odf_cell_edges(facts, attributes):
+    """Resolve explicit cell side overrides after inherited shorthand values."""
+    sides = ('left', 'right', 'top', 'bottom')
+    border_names = {'border', *('border-' + side for side in sides)}
+    if border_names.intersection(attributes):
+        inherited = facts.get('border-sides')
+        if inherited:
+            borders = {side: dict(row) for side, row in zip(sides, inherited)}
+        else:
+            borders = {side: {'side': name, 'width': facts.get('border-width', 'UNKNOWN'),
+                              'color': facts.get('border-color', 'UNKNOWN'),
+                              'style': facts.get('border-style', 'UNKNOWN')}
+                       for side, name in zip(sides, ('lnL', 'lnR', 'lnT', 'lnB'))}
+        def parse(value, side):
+            if value in ('none', 'hidden'):
+                return {'side': side, 'width': '0', 'color': 'NONE', 'style': 'none'}
+            match = re.fullmatch(r'(\S+)\s+(solid|dashed|dotted|double)\s+(#[0-9A-Fa-f]{6})', value)
+            need(match is not None, 'ODF_EXPLICIT_BORDER_UNSUPPORTED')
+            return {'side': side, 'width': measurement(match[1]), 'color': match[3].upper(), 'style': match[2]}
+        if 'border' in attributes:
+            borders = {side: parse(attributes['border'], borders[side]['side']) for side in sides}
+        for side in sides:
+            key = 'border-' + side
+            if key in attributes:
+                borders[side] = parse(attributes[key], borders[side]['side'])
+        for key in ('border-width', 'border-color', 'border-style', 'border-sides'):
+            facts.pop(key, None)
+        common = {(row['width'], row['color'], row['style']) for row in borders.values()}
+        if len(common) == 1:
+            width, colour, style = next(iter(common))
+            facts.update({'border-width': width, 'border-color': colour, 'border-style': style})
+        else:
+            facts['border-sides'] = [borders[side] for side in sides]
+    padding_names = {'padding', *('padding-' + side for side in sides)}
+    if padding_names.intersection(attributes):
+        padding = list(facts.get('padding-sides', [facts.get('padding', 'UNKNOWN')] * 4))
+        if 'padding' in attributes:
+            padding = [measurement(attributes['padding'])] * 4
+        for index, side in enumerate(sides):
+            key = 'padding-' + side
+            if key in attributes:
+                padding[index] = measurement(attributes[key])
+        facts.pop('padding', None)
+        facts.pop('padding-sides', None)
+        if len(set(padding)) == 1:
+            facts['padding'] = padding[0]
+        else:
+            facts['padding-sides'] = padding
+
+
