+"""Bounded, read-only text view of classic PowerPoint 97-2003 CFB bytes.
+
+Only ``read_ppt(bytes)`` is public. This module does no I/O and imports only the
+standard library. Callers must gate the *filename* to .ppt: binary PPT, POT and
+PPS do not provide a reliable filename/format discriminator in every producer.
+
+Supported: current-edit persist resolution, native presentation slide order,
+slide hidden flag, Unicode/byte text bodies in OfficeArt textboxes and outline
+references, and associated notes text. Masters and obsolete edits never supply
+output text. This is not a renderer or a complete file-format/security validator.
+Shapes' individual visibility, layout, tables, charts, images, fields, animation,
+comments and binary extension payloads are not interpreted. Known active/OLE,
+macro and encryption structures are refused; no payload is ever executed.
+
+Layout references: Microsoft [MS-CFB] sections 2.2-2.6, [MS-PPT] sections
+2.1.2, 2.3.1-2.3.6, 2.4.14, 2.5.10-2.5.12, 2.6.6 and 2.9.40-2.9.43.
+"""
+from __future__ import annotations
+
+import struct
+
+MAX_INPUT = 1_000_000
+MAX_DIRECTORY = 256
+MAX_RECORDS = 50_000
+MAX_DEPTH = 32
+MAX_EDITS = 128
+MAX_PERSISTS = 4096
+MAX_SLIDES = 200
+MAX_TEXT = 500_000
+MAX_TEXT_TOTAL = 800_000
+FREE = 0xFFFFFFFF
+END = 0xFFFFFFFE
+FAT = 0xFFFFFFFD
+DIF = 0xFFFFFFFC
+PPT_CLSID = bytes.fromhex('108d81649b4fcf1186ea00aa00b929e8')
+STREAMS = frozenset(('PowerPoint Document', 'Current User', 'Pictures',
+                     '\x01CompObj', '\x01Ole', '\x05SummaryInformation',
+                     '\x05DocumentSummaryInformation'))
+
+
+class BinaryPresentationError(ValueError):
+    """The message is a fixed, content-free diagnostic code."""
+
+
+def _fail(code):
+    raise BinaryPresentationError(code)
+
+
+def _u16(data, at):
+    return struct.unpack_from('<H', data, at)[0]
+
+
+def _u32(data, at):
+    return struct.unpack_from('<I', data, at)[0]
+
+
+def _words(data):
+    return struct.unpack('<' + 'I' * (len(data) // 4), data)
+
+
+class _CFB:
+    def __init__(self, data):
+        if len(data) < 512 or data[:8] != bytes.fromhex('d0cf11e0a1b11ae1'):
+            _fail('cfb_signature')
+        self.data = data
+        version = _u16(data, 26)
+        shift = _u16(data, 30)
+        if (data[8:24] != b'\0' * 16 or version not in (3, 4)
+                or _u16(data, 28) != 0xFFFE or shift != (9 if version == 3 else 12)
+                or _u16(data, 32) != 6 or data[34:40] != b'\0' * 6
+                or _u32(data, 56) != 4096):
+            _fail('cfb_header')
+        self.sector_size = 1 << shift
+        if (len(data) % self.sector_size or len(data) < self.sector_size * 3
+                or any(data[512:self.sector_size])):
+            _fail('cfb_geometry')
+        self.sectors = len(data) // self.sector_size - 1
+        self.used = set()
+        ndir, nfat = _u32(data, 40), _u32(data, 44)
+        nmini, ndif = _u32(data, 64), _u32(data, 72)
+        if ((version == 3 and ndir != 0) or not 1 <= nfat <= self.sectors
+                or nmini > self.sectors or ndif > self.sectors):
+            _fail('cfb_allocation_count')
+        fat_ids = []
+        saw_free = False
+
+        def add_fat_ids(items):
+            nonlocal saw_free
+            for sid in items:
+                if sid == FREE:
+                    saw_free = True
+                else:
+                    if saw_free or len(fat_ids) >= nfat:
+                        _fail('cfb_difat_count')
+                    self._claim(sid)
+                    fat_ids.append(sid)
+
+        add_fat_ids(_words(data[76:512]))
+        dif_ids = []
+        sid = _u32(data, 68)
+        for _ in range(ndif):
+            self._claim(sid)
+            dif_ids.append(sid)
+            items = _words(self._sector(sid))
+            add_fat_ids(items[:-1])
+            sid = items[-1]
+        if sid != END or len(fat_ids) != nfat:
+            _fail('cfb_difat_count')
+        self.fat = tuple(v for sid in fat_ids for v in _words(self._sector(sid)))
+        if len(self.fat) < self.sectors:
+            _fail('cfb_fat_coverage')
+        for sid, value in enumerate(self.fat):
+            if sid >= self.sectors:
+                if value != FREE:
+                    _fail('cfb_fat_padding')
+            elif value not in (FREE, END, FAT, DIF) and value >= self.sectors:
+                _fail('cfb_sector_bounds')
+        if any(self.fat[sid] != FAT for sid in fat_ids) or any(
+                self.fat[sid] != DIF for sid in dif_ids):
+            _fail('cfb_allocation_marker')
+        directory = self._chain(_u32(data, 48), self.fat, self.sector_size,
+                                self.sectors, self.used, limit=MAX_DIRECTORY // (self.sector_size // 128))
+        if version == 4 and len(directory) // self.sector_size != ndir:
+            _fail('cfb_directory_count')
+        if not directory:
+            _fail('cfb_directory_missing')
+        entries = []
+        for at in range(0, len(directory), 128):
+            row = directory[at:at + 128]
+            kind = row[66]
+            if kind == 0:
+                entries.append(None)
+                continue
+            length = _u16(row, 64)
+            if (kind not in (1, 2, 5) or length < 2 or length > 64 or length % 2
+                    or row[length - 2:length] != b'\0\0' or row[67] not in (0, 1)):
+                _fail('cfb_directory_entry')
+            try:
+                name = row[:length - 2].decode('utf-16le')
+            except UnicodeError:
+                _fail('cfb_directory_name')
+            if not name or any(c in name for c in '\0/\\:!'):
+                _fail('cfb_directory_name')
+            size = _u32(row, 120) if version == 3 else struct.unpack_from('<Q', row, 120)[0]
+            if size > MAX_INPUT:
+                _fail('cfb_stream_limit')
+            entries.append((name, kind, _u32(row, 68), _u32(row, 72),
+                            _u32(row, 76), row[80:96], _u32(row, 116), size))
+        root = entries[0]
+        if (root is None or root[0] != 'Root Entry' or root[1] != 5
+                or root[2:4] != (FREE, FREE)):
+            _fail('cfb_root')
+        if root[5] != PPT_CLSID:
+            _fail('not_powerpoint_cfb')
+        # Walk every directory entry; no orphan streams or nested storage allowed.
+        stack = [root[4]]
+        seen = {0}
+        names = set()
+        streams = []
+        while stack:
+            idx = stack.pop()
+            if idx == FREE:
+                continue
+            if idx >= len(entries) or idx in seen or entries[idx] is None:
+                _fail('cfb_directory_cycle_or_bounds')
+            seen.add(idx)
+            row = entries[idx]
+            name, kind, left, right, child, _, start, size = row
+            if kind != 2 or child != FREE:
+                _fail('unsupported_cfb_storage')
+            if name.casefold() in names:
+                _fail('cfb_duplicate_stream')
+            names.add(name.casefold())
+            if name not in STREAMS:
+                _fail('unsupported_cfb_stream')
+            streams.append((name, start, size))
+            stack.extend((left, right))
+        if seen != {i for i, row in enumerate(entries) if row is not None}:
+            _fail('cfb_directory_orphan')
+        mini_table = self._chain(_u32(data, 60), self.fat, self.sector_size,
+                                 self.sectors, self.used, count=nmini)
+        self.mini_fat = _words(mini_table)
+        self.mini = self._chain(root[6], self.fat, self.sector_size,
+                                self.sectors, self.used, size=root[7])
+        if len(self.mini) % 64:
+            _fail('cfb_ministream_geometry')
+        mini_count = len(self.mini) // 64
+        if len(self.mini_fat) < mini_count:
+            _fail('cfb_minifat_coverage')
+        for idx, value in enumerate(self.mini_fat):
+            if value not in (FREE, END) and value >= mini_count:
+                _fail('cfb_minisector_bounds')
+            if idx >= mini_count and value != FREE:
+                _fail('cfb_minifat_padding')
+        mini_used = set()
+        self.streams = {}
+        for name, start, size in streams:
+            if size < 4096:
+                blob = self._chain(start, self.mini_fat, 64, mini_count, mini_used, size=size, mini=True)
+            else:
+                blob = self._chain(start, self.fat, self.sector_size, self.sectors, self.used, size=size)
+            self.streams[name] = blob
+        if any(value != FREE and idx not in self.used for idx, value in enumerate(self.fat[:self.sectors])):
+            _fail('cfb_unowned_sector')
+        if any(value != FREE and idx not in mini_used for idx, value in enumerate(self.mini_fat)):
+            _fail('cfb_unowned_minisector')
+        if not {'Current User', 'PowerPoint Document'} <= self.streams.keys():
+            _fail('powerpoint_streams_missing')
+
+    def _sector(self, sid):
+        if not 0 <= sid < self.sectors:
+            _fail('cfb_sector_bounds')
+        at = (sid + 1) * self.sector_size
+        return self.data[at:at + self.sector_size]
+
+    def _claim(self, sid):
+        if not 0 <= sid < self.sectors:
+            _fail('cfb_sector_bounds')
+        if sid in self.used:
+            _fail('cfb_sector_overlap_or_cycle')
+        self.used.add(sid)
+
+    def _chain(self, start, table, unit, available, used, *, size=None, count=None,
+               limit=None, mini=False):
+        expected = (size + unit - 1) // unit if size is not None else count
+        maximum = available if limit is None else min(available, limit)
+        if expected is not None and expected > maximum:
+            _fail('cfb_chain_limit')
+        ids = []
+        sid = start
+        while sid != END:
+            if not 0 <= sid < available or sid >= len(table):
+                _fail('cfb_chain_bounds')
+            if sid in used:
+                _fail('cfb_sector_overlap_or_cycle')
+            if len(ids) >= maximum or (expected is not None and len(ids) >= expected):
+                _fail('cfb_chain_length')
+            used.add(sid)
+            ids.append(sid)
+            sid = table[sid]
+        if expected is not None and len(ids) != expected:
+            _fail('cfb_chain_length')
+        value = b''.join(self.mini[sid * unit:(sid + 1) * unit] if mini else self._sector(sid) for sid in ids)
+        return value if size is None else value[:size]
+
+
+class _Record:
+    __slots__ = ('at', 'end', 'kind', 'version', 'instance', 'children')
+
+    def __init__(self, at, end, kind, options):
+        self.at, self.end, self.kind = at, end, kind
+        self.version, self.instance = options & 15, options >> 4
+        self.children = []
+
+
+# Refuse known embedded, macro, OLE, external-object and encryption structures.
+# An empty VBAInfoAtom (commonly emitted by ordinary producers) is handled below.
+_ACTIVE = frozenset((0x0409, 0x040A, 0x0BC1, 0x0FC3, 0x0FCC, 0x0FCD,
+                     0x0FCE, 0x0FD1, 0x0FEE, 0x0FFB, 0x1011, 0x2F14))
+_CONTAINERS = frozenset((1000, 1006, 1008, 1016, 1023, 4080,
+                          0xF004, 0xF00D, 0xF011))
+
+
+class _PPT:
+    def __init__(self, data, current):
+        self.data = data
+        self.record_count = 0
+        self.text_bytes = 0
+        self.text_bodies = 0
+        self.all_records = {}
+        self.unsupported = {
+            'images_layout_rendering_not_read', 'tables_charts_diagrams_not_structured',
+            'shape_visibility_not_evaluated', 'fields_animation_comments_extensions_not_interpreted',
+            'master_text_not_included', 'native_slide_names_not_extracted',
+        }
+        self.top = self._records(0, len(data), 0)
+        self.top_by_offset = {r.at: r for r in self.top}
+        if len(current) < 32:
+            _fail('current_user_length')
+        opt, kind, length = struct.unpack_from('<HHI', current)
+        if opt or kind != 4086 or length != len(current) - 8 or _u32(current, 8) != 20:
+            _fail('current_user_record')
+        if _u32(current, 12) != 0xE391C05F:
+            _fail('encrypted_or_unknown_powerpoint')
+        nuser = _u16(current, 20)
+        if (nuser > 255 or len(current) not in (32 + nuser, 32 + 3 * nuser)
+                or _u16(current, 22) != 0x03F4 or current[24:26] != b'\x03\x00'
+                or _u32(current, 28 + nuser) not in (8, 9)):
+            _fail('current_user_record')
+        self.persists = {}
+        offset = _u32(current, 16)
+        edits = set()
+        self.current_edit = offset
+        current_seed = None
+        while True:
+            if offset in edits or len(edits) >= MAX_EDITS:
+                _fail('edit_cycle_or_limit')
+            edits.add(offset)
+            edit = self._top(offset, 4085)
+            p = self._atom(edit, version=0, instance=0, lengths=(28, 32))
+            if p[6:8] != b'\x00\x03' or (len(p) == 32 and _u32(p, 28)):
+                _fail('encrypted_or_unknown_powerpoint')
+            previous, persist_at, doc_id, seed = struct.unpack_from('<IIII', p, 8)
+            if (doc_id != 1 or not previous < persist_at < offset
+                    or seed == 0 or seed > 0xFFFFF):
+                _fail('edit_persist_reference')
+            if current_seed is None:
+                current_seed = seed
+            directory = self._top(persist_at, 6002)
+            payload = self._atom(directory, version=0, instance=0)
+            at = 0
+            local = set()
+            while at < len(payload):
+                if at + 4 > len(payload):
+                    _fail('persist_directory_length')
+                word = _u32(payload, at)
+                at += 4
+                first, count = word & 0xFFFFF, word >> 20
+                if (not first or not count or first + count - 1 > seed
+                        or at + count * 4 > len(payload)):
+                    _fail('persist_directory_entry')
+                for pid in range(first, first + count):
+                    target = _u32(payload, at)
+                    at += 4
+                    if pid in local or target >= persist_at or target not in self.top_by_offset:
+                        _fail('persist_directory_reference')
+                    if self.top_by_offset[target].kind in (4085, 6002):
+                        _fail('persist_directory_reference')
+                    local.add(pid)
+                    self.persists.setdefault(pid, target)
+                    if len(self.persists) > MAX_PERSISTS:
+                        _fail('persist_limit')
+            if not previous:
+                break
+            offset = previous
+        if max(self.persists, default=0) > current_seed:
+            _fail('persist_seed')
+        self.edit_count = len(edits)
+
+    def _records(self, start, end, depth):
+        if depth > MAX_DEPTH:
+            _fail('record_depth_limit')
+        result = []
+        while start < end:
+            if start + 8 > end:
+                _fail('record_header_bounds')
+            options, kind, length = struct.unpack_from('<HHI', self.data, start)
+            stop = start + 8 + length
+            if stop > end:
+                _fail('record_length_bounds')
+            self.record_count += 1
+            if self.record_count > MAX_RECORDS:
+                _fail('record_count_limit')
+            row = _Record(start, stop, kind, options)
+            self.all_records[start] = row
+            if kind in _ACTIVE:
+                _fail('unsupported_active_content')
+            if kind in _CONTAINERS and row.version != 15:
+                _fail('record_container_version')
+            if kind == 1024:
+                payload = self._atom(row, version=2, instance=0, lengths=(12,))
+                if _u32(payload, 0) or _u32(payload, 4) or _u32(payload, 8) not in (1, 2):
+                    _fail('unsupported_macro_content')
+                if _u32(payload, 8) == 1:
+                    # LibreOffice emits version 1 for an explicitly empty project.
+                    # It carries no project reference or macro bytes.
+                    self.unsupported.add('empty_vba_info_legacy_version_1')
+            if kind in (4000, 4008):
+                self._text(row)  # Validate even obsolete or master text, without output.
+            if row.version == 15:
+                row.children = self._records(start + 8, stop, depth + 1)
+            result.append(row)
+            start = stop
+        return result
+
+    def _atom(self, row, *, version=None, instance=None, lengths=None):
+        length = row.end - row.at - 8
+        if ((version is not None and row.version != version)
+                or (instance is not None and row.instance != instance)
+                or (lengths is not None and length not in lengths)):
+            _fail('record_atom_shape')
+        return self.data[row.at + 8:row.end]
+
+    def _text(self, row):
+        payload = self._atom(row, version=0, instance=0)
+        if len(payload) > MAX_TEXT or (row.kind == 4000 and len(payload) % 2):
+            _fail('text_length_limit')
+        try:
+            value = payload.decode('utf-16le' if row.kind == 4000 else 'latin1')
+        except UnicodeError:
+            _fail('text_encoding')
+        if '\0' in value:
+            _fail('text_nul')
+        return value.replace('\r', '\n').replace('\v', '\n')
+
+    def _top(self, at, kind):
+        row = self.top_by_offset.get(at)
+        if row is None or row.kind != kind:
+            _fail('persist_object_type_or_bounds')
+        return row
+
+    def _object(self, pid, kind):
+        if pid not in self.persists:
+            _fail('persist_object_missing')
+        return self._top(self.persists[pid], kind)
+
+    def _one(self, rows, kind, required=True):
+        matches = [r for r in rows if r.kind == kind]
+        if len(matches) > 1 or (required and not matches):
+            _fail('duplicate_or_missing_record')
+        return matches[0] if matches else None
+
+    def _walk(self, rows):
+        for row in rows:
+            yield row
+            yield from self._walk(row.children)
+
+    def _text_blocks(self, rows):
+        result = []
+        for row in rows:
+            if row.kind == 3999:
+                payload = self._atom(row, version=0, lengths=(4,))
+                typ = _u32(payload, 0)
+                if row.instance > 5 or typ not in (0, 1, 2, 4, 5, 6, 7, 8):
+                    _fail('text_header_type')
+                result.append({'kind': 'title' if typ in (0, 6) else 'body',
