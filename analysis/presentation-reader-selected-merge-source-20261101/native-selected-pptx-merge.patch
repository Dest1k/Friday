+"""Bounded selected-slide PPTX merge; no renderer or arbitrary filesystem access.
+
+Slide1 is the declared title of each input. Keep one chosen title, followed by
+an explicit list of distinct non-title slides. Native part payloads stay byte
+identical; only package indexes and remapped relationship targets are rebuilt.
+"""
+from copy import deepcopy
+import hashlib
+import posixpath
+from xml.etree import ElementTree as ET
+
+from tools.scoped_presentation_write import (
+    P, A, C, R, PR, PresentationRefused, _parts, _xml, _tostring, _resolve,
+    _rels, _zip, MAX_MEMBERS,
+)
+
+CT = 'http://schemas.openxmlformats.org/package/2006/content-types'
+MIME = 'application/vnd.openxmlformats-officedocument.'
+ROLES = {
+    'slide': (MIME + 'presentationml.slide+xml', '{%s}sld' % P),
+    'slideMaster': (MIME + 'presentationml.slideMaster+xml', '{%s}sldMaster' % P),
+    'slideLayout': (MIME + 'presentationml.slideLayout+xml', '{%s}sldLayout' % P),
+    'notesSlide': (MIME + 'presentationml.notesSlide+xml', '{%s}notes' % P),
+    'notesMaster': (MIME + 'presentationml.notesMaster+xml', '{%s}notesMaster' % P),
+    'chart': (MIME + 'drawingml.chart+xml',
+              '{http://schemas.openxmlformats.org/drawingml/2006/chart}chartSpace'),
+    'theme': (MIME + 'theme+xml', '{%s}theme' % A),
+    'tableStyles': (MIME + 'presentationml.tableStyles+xml', '{%s}tblStyleLst' % A),
+}
+ALLOWED_EDGES = set(ROLES) | {'image', 'package', 'chartStyle', 'chartColorStyle'}
+MS_CHART_RELS = 'http://schemas.microsoft.com/office/2011/relationships/'
+PRESENTATION = 'ppt/presentation.xml'
+PRES_RELS = 'ppt/_rels/presentation.xml.rels'
+
+
+def refuse(reason):
+    raise PresentationRefused(reason)
+
+
+def _relname(owner):
+    folder, leaf = posixpath.split(owner)
+    return posixpath.join(folder, '_rels', leaf + '.rels')
+
+
+def _owner(name):
+    folder, leaf = name.rsplit('/_rels/', 1)
+    return folder + '/' + leaf[:-5]
+
+
+def _types(parts):
+    if '[Content_Types].xml' not in parts:
+        refuse('missing_content_types')
+    root = _xml(parts['[Content_Types].xml'])
+    if root.tag != '{%s}Types' % CT:
+        refuse('invalid_content_types')
+    defaults, overrides = {}, {}
+    for node in root:
+        if node.tag == '{%s}Default' % CT and set(node.attrib) == {'Extension', 'ContentType'}:
+            key = node.get('Extension')
+            target = defaults
+            if not key or key.lower() != key or '.' in key or '/' in key:
+                refuse('invalid_content_types')
+        elif node.tag == '{%s}Override' % CT and set(node.attrib) == {'PartName', 'ContentType'}:
+            name = node.get('PartName', '')
+            if not name.startswith('/') or name[1:] not in parts:
+                refuse('invalid_content_types')
+            key, target = name[1:], overrides
+        else:
+            refuse('invalid_content_types')
+        if key in target or not node.get('ContentType'):
+            refuse('ambiguous_content_types')
+        target[key] = node.get('ContentType')
+    result = {}
+    for name in parts:
+        if name == '[Content_Types].xml' or name.endswith('/'):
+            continue
+        content_type = overrides.get(name, defaults.get(name.rsplit('.', 1)[-1].lower()))
+        if content_type is None:
+            refuse('missing_content_type')
+        result[name] = content_type
+    return result
+
+
+def _role(parts, types, name, kind):
+    if kind in ROLES:
+        expected, tag = ROLES[kind]
+        if types[name] != expected or _xml(parts[name]).tag != tag:
+            refuse('relationship_role_mismatch')
+    elif kind == 'package':
+        if not name.lower().endswith('.xlsx') or types[name] != MIME + 'spreadsheetml.sheet':
+            refuse('unsupported_embedded_package')
+    elif kind == 'image':
+        if types[name] not in ('image/png', 'image/jpeg', 'image/gif', 'image/bmp', 'image/tiff'):
+            refuse('unsupported_image_type')
+    elif kind == 'chartStyle':
+        if (types[name] != 'application/vnd.ms-office.chartstyle+xml'
+                or _xml(parts[name]).tag != '{http://schemas.microsoft.com/office/drawing/2012/chartStyle}chartStyle'):
+            refuse('relationship_role_mismatch')
+    elif kind == 'chartColorStyle':
+        if (types[name] != 'application/vnd.ms-office.chartcolorstyle+xml'
+                or _xml(parts[name]).tag != '{http://schemas.microsoft.com/office/drawing/2012/chartStyle}colorStyle'):
+            refuse('relationship_role_mismatch')
+    else:
+        refuse('unsupported_slide_relationship')
+
+
+def _checked_rels(parts, owner):
+    name = _relname(owner)
+    result = _rels(parts, name)
+    if name in parts:
+        root = _xml(parts[name])
+        if root.tag != '{%s}Relationships' % PR or len(root) != len(result):
+            refuse('invalid_relationships')
+        for node in result.values():
+            kind = node.get('Type', '').rsplit('/', 1)[-1]
+            permitted_type = R + '/' + kind
+            chart_type = MS_CHART_RELS + kind if kind in ('chartStyle', 'chartColorStyle') else None
+            if (set(node.attrib) - {'Id', 'Type', 'Target', 'TargetMode'}
+                    or node.get('Type') not in (permitted_type, chart_type)
+                    or node.get('TargetMode', '').lower() not in ('', 'internal')):
+                refuse('unsupported_relationship')
+            target = node.get('Target', '')
+            if any(ch in target for ch in ('%', '?', '#', ':')) or any(ord(ch) < 32 for ch in target):
+                refuse('unsafe_relationship')
+    return result
+
+
+def _strict_parts(data, depth=0):
+    if depth > 2:
+        refuse('nested_package_capacity')
+    infos, parts = _parts(data)
+    if any(info.orig_filename != info.filename for info in infos):
+        refuse('noncanonical_part_name')
+    for name in parts:
+        if (name.endswith('/') or any(piece in ('', '.', '..') for piece in name.split('/'))
+                or any(char in name for char in ('%', '?', '#', ':'))
+                or any(ord(char) <= 32 or ord(char) == 127 for char in name)):
+            refuse('noncanonical_part_name')
+        suffix = name.rsplit('.', 1)[-1]
+        if suffix.lower() in ('xml', 'rels', 'vml', 'xlsx') and suffix != suffix.lower():
+            refuse('noncanonical_part_extension')
+        if name.endswith('.xlsx'):
+            _strict_parts(parts[name], depth + 1)
+    return parts
+
+
+def _deck(data):
+    parts = _strict_parts(data)
+    types = _types(parts)
+    if types.get(PRESENTATION) != MIME + 'presentationml.presentation.main+xml':
+        refuse('not_standard_pptx')
+    package_root = _rels(parts, '_rels/.rels')
+    office = [rel for rel in package_root.values() if rel.get('Type') == R + '/officeDocument']
+    if len(office) != 1 or _resolve('', office[0].get('Target', '')) != PRESENTATION:
+        refuse('invalid_office_document_relationship')
+    root = _xml(parts[PRESENTATION])
+    if root.tag != '{%s}presentation' % P:
+        refuse('not_standard_pptx')
+    permitted = {'sldMasterIdLst', 'notesMasterIdLst', 'sldIdLst', 'sldSz', 'notesSz', 'defaultTextStyle'}
+    if any(node.tag not in {'{%s}%s' % (P, tag) for tag in permitted} for node in root):
+        refuse('unsupported_global_presentation_structure')
+    if len({node.tag for node in root}) != len(root):
+        refuse('duplicate_presentation_index')
+    for tag in ('sldSz', 'notesSz'):
+        size = root.find('{%s}%s' % (P, tag))
+        if (size is None or any(not size.get(axis, '').isdigit()
+                              or not 1 <= int(size.get(axis)) <= 51206400
+                              for axis in ('cx', 'cy'))):
+            refuse('invalid_presentation_size')
+    # This is the only payload XML serialized. Refuse prefix-valued extension
+    # attributes rather than losing their namespace declarations with ElementTree.
+    for node in root.iter():
+        if node.tag.rsplit('}', 1)[0] not in ('{' + P, '{' + A):
+            refuse('unsupported_presentation_namespace')
+        if any(key.startswith('{') and not key.startswith(('{' + R + '}', '{http://www.w3.org/XML/1998/namespace}')) for key in node.attrib):
+            refuse('unsupported_presentation_namespace')
+    rels = _checked_rels(parts, PRESENTATION)
+    global_kinds = {'slide', 'slideMaster', 'notesMaster', 'theme', 'tableStyles',
+                    'presProps', 'viewProps', 'printerSettings'}
+    if any(rel.get('Type') not in {R + '/' + kind for kind in global_kinds} for rel in rels.values()):
+        refuse('unsupported_global_presentation_relationship')
+    paths = []
+    ids = set()
+    index = root.find('{%s}sldIdLst' % P)
+    if index is None:
+        refuse('missing_slides')
+    for node in index:
+        rid = node.get('{%s}id' % R)
+        sid = node.get('id', '')
+        if (node.tag != '{%s}sldId' % P or set(node.attrib) != {'id', '{%s}id' % R}
+                or not sid.isdigit() or int(sid) < 256 or sid in ids or rid not in rels
+                or rels[rid].get('Type') != R + '/slide'):
+            refuse('invalid_slide_index')
+        ids.add(sid)
+        path = _resolve(PRESENTATION, rels[rid].get('Target'))
+        _role(parts, types, path, 'slide')
+        if path in paths:
+            refuse('duplicate_slide')
+        paths.append(path)
+    if not 1 <= len(paths) <= 60:
+        refuse('slide_capacity')
+    for list_tag, child_tag, kind in [('sldMasterIdLst', 'sldMasterId', 'slideMaster'),
+                                       ('notesMasterIdLst', 'notesMasterId', 'notesMaster')]:
+        listing = root.find('{%s}%s' % (P, list_tag))
+        if listing is not None:
+            seen = set()
+            for node in listing:
+                rid = node.get('{%s}id' % R)
+                if (node.tag != '{%s}%s' % (P, child_tag) or rid in seen or rid not in rels
+                        or rels[rid].get('Type') != R + '/' + kind):
+                    refuse('invalid_master_index')
+                seen.add(rid)
+                _role(parts, types, _resolve(PRESENTATION, rels[rid].get('Target')), kind)
+    return {'parts': parts, 'types': types, 'root': root, 'rels': rels, 'slides': paths}
+
+
+def _closure(deck, seeds, selected):
+    parts, types = deck['parts'], deck['types']
+    found = set()
+    pending = list(seeds)
+    while pending:
+        name = pending.pop()
+        if name in found:
+            continue
+        if name not in parts or name == PRESENTATION or name.endswith('/'):
+            refuse('unsupported_graph_target')
+        if name in deck['slides'] and name not in selected:
+            refuse('unselected_slide_reference')
+        found.add(name)
+        rels = _checked_rels(parts, name)
+        relname = _relname(name)
+        if relname in parts:
+            found.add(relname)
+        if name.endswith('.xml'):
+            root = _xml(parts[name])
+            expected_roles = {
+                '{%s}chart' % C: 'chart', '{%s}externalData' % C: 'package',
+                '{%s}blip' % A: 'image', '{%s}hlinkClick' % A: 'slide',
+                '{%s}hlinkHover' % A: 'slide', '{%s}sldLayoutId' % P: 'slideLayout',
+            }
+            for node in root.iter():
+                for key, value in node.attrib.items():
+                    if key.startswith('{%s}' % R):
+                        if value not in rels:
+                            refuse('unbound_relationship_id')
+                        if (node.tag not in expected_roles
+                                or rels[value].get('Type') != R + '/' + expected_roles[node.tag]
+                                or key.rsplit('}', 1)[-1] not in
+                                (('embed', 'link') if node.tag == '{%s}blip' % A else ('id',))):
+                            refuse('relationship_reference_role_mismatch')
