+        if i == 1 and name in aliases:
+            i, name = aliases[name]
+        return 'ppt/merge%d/' % (i + 1) + name
+    output, output_types = {}, {}
+    changed_rels = []
+    for i, deck in enumerate(decks):
+        for name in sorted(closures[i]):
+            target = mapped(i, name)
+            if target in output:
+                continue
+            raw = deck['parts'][name]
+            if name.endswith('.rels'):
+                owner = _owner(name)
+                root = _xml(raw)
+                changed = False
+                for rel in root:
+                    old_target = _resolve(owner, rel.get('Target'))
+                    destination = mapped(i, old_target)
+                    relative = posixpath.relpath(destination, posixpath.dirname(mapped(i, owner)))
