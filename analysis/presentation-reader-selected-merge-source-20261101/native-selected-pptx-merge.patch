+    if (themes[0] is None) != (themes[1] is None) or (themes[0] is not None and
+            decks[0]['parts'][themes[0]] != decks[1]['parts'][themes[1]]):
+        refuse('incompatible_global_theme')
+    if themes[0] is not None:
+        for i in range(2):
+            closures[i] |= _closure(decks[i], [themes[i]], selected[i])
+    notes = []
+    for i, deck in enumerate(decks):
+        names = [name for name in closures[i] if deck['types'][name] == ROLES['notesMaster'][0]]
+        if len(names) > 1:
+            refuse('multiple_notes_masters_unsupported')
+        notes.append(names[0] if names else None)
+    aliases = {}
+    if all(notes):
+        graphs = [_closure(decks[i], [notes[i]], selected[i]) for i in range(2)]
+        if notes[0] != notes[1] or _snapshot(decks[0], graphs[0]) != _snapshot(decks[1], graphs[1]):
+            refuse('incompatible_notes_masters')
+        aliases = {name: (0, name) for name in graphs[1]}
