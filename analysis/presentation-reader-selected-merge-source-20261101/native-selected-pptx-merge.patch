+        if (not isinstance(item, dict) or set(item) != {'source', 'slide'}
+                or type(item['source']) is not int or item['source'] not in (1, 2)
+                or type(item['slide']) is not int):
+            refuse('merge_slide_schema')
+        source, slide = item['source'] - 1, item['slide']
+        if not 1 <= slide <= len(decks[source]['slides']):
+            refuse('merge_slide_range')
+        if (position == 0 and slide != 1) or (position > 0 and slide == 1):
+            refuse('one_explicit_first_slide_title_required')
+        address = (source, decks[source]['slides'][slide - 1])
+        if address in chosen:
+            refuse('duplicate_selected_slide')
+        chosen.append(address)
