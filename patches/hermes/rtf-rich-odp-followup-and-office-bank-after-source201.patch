+def _prepare_presentation_profile(program, env, deadline):
+    """Initialize an empty private profile without ever passing document args.
+
+    Exact b711 normally requests restart on its first extension-cache cleanup.
+    A genuine document-free initialization writes that cache identity. Empty
+    readonly shared/bundled repositories and absent fresh activation maps then
+    exclude the other known extension-sync restart branch. Nothing fabricates
+    a cache marker or changes macro security; a later restart remains an error.
+    """
+    import stat
+    import time
+    from xml.etree import ElementTree as ET
+
+    program = Path(program)
+    profile = Path(env['HOME']) / 'profile'
+    if os.path.lexists(profile):
+        raise ValueError('presentation_profile_not_fresh')
+
+    def empty_repositories():
+        for name, expected in (('extensions', set()),
+                               ('uno_packages', {'cache', 'cache/uno_packages'})):
+            root = program.parent / 'share' / name
+            if root.is_symlink() or not root.is_dir():
+                raise ValueError('presentation_repository_layout')
+            members = list(root.rglob('*'))
+            if ({member.relative_to(root).as_posix() for member in members} != expected
+                    or any(member.is_symlink() or not member.is_dir()
+                           for member in members)):
+                raise ValueError('presentation_repository_not_empty')
+
+    def remaining():
+        value = deadline - time.monotonic()
+        if value <= 0:
+            raise TimeoutError('presentation_original_budget_exhausted')
+        return value
+
+    def own_regular(path):
+        for parent in (path.parent, *path.parent.parents):
+            if parent.is_symlink():
+                raise ValueError('presentation_profile_link')
+            if parent == profile:
+                break
+        info = path.lstat()
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                or info.st_nlink != 1 or info.st_size > 1000000):
+            raise ValueError('presentation_profile_file')
+        key = lambda value: (value.st_dev, value.st_ino, value.st_mode,
+                             value.st_uid, value.st_gid, value.st_nlink,
+                             value.st_size, value.st_mtime_ns, value.st_ctime_ns)
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(fd, 'rb') as stream:
+            if key(os.fstat(stream.fileno())) != key(info):
+                raise ValueError('presentation_profile_changed')
+            raw = stream.read(1000001)
+            if (len(raw) != info.st_size or key(os.fstat(stream.fileno())) != key(info)
+                    or key(path.lstat()) != key(info)):
+                raise ValueError('presentation_profile_changed')
+        return raw
+
+    empty_repositories()
+    version = (program / 'versionrc').read_bytes()
+    if [line for line in version.splitlines() if line.startswith(b'buildid=')] != [b'buildid=620(Build:2)']:
+        raise ValueError('presentation_bank_buildid')
+    subprocess.run([str(program / 'soffice'), '--headless', '--norestore',
+                    '--nodefault', '--nolockcheck', '--nofirststartwizard',
+                    '-env:UserInstallation=' + profile.as_uri(),
+                    '--terminate_after_init'],
+                   env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                   stderr=subprocess.DEVNULL, timeout=remaining(), check=True)
+    remaining()
+    registry = own_regular(profile / 'user/registrymodifications.xcu')
+    if b'<!DOCTYPE' in registry.upper():
+        raise ValueError('presentation_profile_registry')
+    root = ET.fromstring(registry)
+    oor = '{http://openoffice.org/2001/registry}'
+    values = [value.text for item in root
+              if item.get(oor + 'path') == '/org.openoffice.Setup/Office'
+              for prop in item if prop.get(oor + 'name') == 'ooSetupInstCompleted'
+              for value in prop.findall('value')]
+    if root.tag != oor + 'items' or values != ['true']:
+        raise ValueError('presentation_profile_initialization')
+    if own_regular(profile / 'user/extensions/buildid') != b'620(Build:2)':
+        raise ValueError('presentation_profile_buildid')
+    for relative in ('user/extensions/shared/extensions.pmap',
+                     'user/extensions/bundled/extensions.pmap',
+                     'user/uno_packages/cache/uno_packages.pmap'):
+        if os.path.lexists(profile / relative):
+            raise ValueError('presentation_profile_activation_state')
+    empty_repositories()
+    remaining()
+
