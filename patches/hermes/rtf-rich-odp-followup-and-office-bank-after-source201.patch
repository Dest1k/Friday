+"""Passive ODP input for byte-preserving literal text edits only.
+
+This is an input profile, not evidence that a file came from our producer. It
+never renders, decodes graphics or opens embedded objects. Existing source
+admission stays strict for conversion, table editing and other operations.
+"""
+from copy import copy, deepcopy
+from io import BytesIO
+from zipfile import ZipFile
+
+from tools.scoped_presentation import Package, PresentationError, O, q, extract_presentation
+from tools.scoped_presentation_write import (
+    PresentationRefused, _parts, _xml, _tostring, _rewrite, _odp_structure,
+)
+from tools.scoped_presentation_variants import validate_profile
+
+
+def source_parts(data):
+    """Return the original package; permit only an exactly inert script section.
+
+    Ordinary supported ODPs keep their existing validator. The narrow fallback
+    validates the original ZIP/XML first and removes the inert section solely
+    from a private validation view, so the existing active-content checks still
+    inspect every other node/member. Returned bytes and edited output keep that
+    section and every unrelated payload verbatim. No generated-output flag or
+    producer marker participates in source admission.
+    """
+    try:
+        validate_profile(data, 'odp')
+        return _parts(data)
+    except PresentationRefused as error:
+        if str(error) != 'active_xml_content':
+            raise
+    try:
+        pkg = Package(data)
+        roots = {name: _xml(raw) for name, raw in pkg.parts.items()
+                 if name.endswith(('.xml', '.vml'))}
+        root = roots.get('content.xml')
+        if root is None or root.tag != q(O, 'document-content'):
+            raise PresentationRefused('passive_odp_content')
+        scripts = [node for node in root if node.tag == q(O, 'scripts')]
+        if (len(scripts) != 1 or scripts[0].attrib or len(scripts[0])
+                or scripts[0].text or (scripts[0].tail or '').strip()):
+            raise PresentationRefused('passive_odp_scripts')
+        with ZipFile(BytesIO(data)) as archive:
+            infos = archive.infolist()
+        if any(info.is_dir() and info.file_size != 0 for info in infos):
+            raise PresentationRefused('passive_odp_directory_payload')
+        original_parts = dict(pkg.parts)
+        original_parts.update((info.filename, b'') for info in infos if info.is_dir())
+        root.remove(scripts[0])
+        validation_view = _rewrite(infos, original_parts, {'content.xml': _tostring(root)})
+        _parts(validation_view)  # All original active/resource guards, no role flag.
+        _odp_structure(infos, original_parts)
+        # These helpers inspect only bounded passive structure. Calling them is
+        # not calling the generated-destination entry point or granting custody.
+        from tools.scoped_presentation_generated_odp import _manifest, _xml_profile, _resources
+        # An app save may leave the replacement's media type empty. This input
+        # profile accepts that declaration only when the existing strict role
+        # closure and bounded SVM framing validate its actual unchanged payload.
+        manifest_view = copy(pkg)
+        manifest_view.xml = dict(pkg.xml)
+        manifest = deepcopy(pkg.xml.get('META-INF/manifest.xml'))
+        if manifest is not None:
+            m = '{urn:oasis:names:tc:opendocument:xmlns:manifest:1.0}'
+            for entry in manifest:
+                if (entry.get(m+'full-path', '').startswith('ObjectReplacements/')
+                        and entry.get(m+'media-type') == ''):
+                    from tools.scoped_presentation_generated_odp import GDI
+                    entry.set(m+'media-type', GDI)
+            manifest_view.xml['META-INF/manifest.xml'] = manifest
+        objects = _manifest(manifest_view)
+        _xml_profile(pkg, objects)
+        _resources(pkg, objects)
+        view = extract_presentation(data, 'odp')
+        incomplete = {'odf_chart_range_not_resolved', 'chart_without_supported_series',
+                      'chart_values_not_available', 'unsupported_odf_object'}
+        if (view.extraction_metadata['charts'] != len(objects)
+                or incomplete.intersection(view.extraction_metadata['unsupported_features'])):
+            raise PresentationRefused('passive_odp_chart_data_coverage')
+        return infos, original_parts
+    except PresentationError as error:
+        raise PresentationRefused(str(error)) from None
