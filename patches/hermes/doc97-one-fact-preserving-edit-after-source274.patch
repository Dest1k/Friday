+def create_doc_edit(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_doc import DOCError, edit_passive_doc97_number
+
+    if not isinstance(path, str) or Path(path).suffix.lower() != '.doc' or Path(path).name != leaf:
+        raise ScopeDenied()
+    request = _request(content, extra_keys=('paragraph', 'old_value', 'new_value'))
+    try:
+        _check_parent(cap, fd, path)
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            return json.dumps({'success': False, 'error': 'document_already_exists', 'path': path})
+        source, relative, data, identity = _read_source(request['source'], cap, '.doc')
+        if relative == path:
+            raise ScopeDenied()
+        actual = hashlib.sha256(data).hexdigest()
+        if actual != request['source_sha256']:
+            raise DOCError('source_hash_mismatch')
+        check(cap)
+        output, facts = edit_passive_doc97_number(
+            data, request['paragraph'], request['old_value'], request['new_value'])
+        check(cap)
+        return _publish(cap, fd, leaf, path, output, 'doc', (source, data, identity),
+                        {'source': relative, 'source_sha256': actual, 'source_unchanged': True, **facts})
+    except ScopeDenied:
+        raise
+    except DOCError as error:
+        return json.dumps({'success': False, 'error': 'document_edit_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})


