+# M09 opt-in on the existing ordinary-turn-readonly verb; legacy path unchanged.
+# This projection never constructs agents/providers, formats memory or calls tools.
+# Fixed private selector bytes are operator custody, outside installed HOME.
+# The opaque commitment limits selection; current native policy remains authority.
+_M09_SCOPE_BINDING_SHA256 = 'ef12a05953f80a6347e2722abd46c190638bc6fbbd93002bba119d62d89adcf2'
+
+def _m09_scopes(pin):
+    import re
+    import stat
+    if (type(pin) is not dict or set(pin) != {'path','sha256'}
+            or type(pin.get('path')) is not str
+            or pin.get('sha256') != _M09_SCOPE_BINDING_SHA256):
+        raise RuntimeError('m09_fixed_scope_reference')
+    path = Path(pin['path'])
+    if not path.is_absolute() or '..' in path.parts or path.is_relative_to(HOME):
+        raise RuntimeError('m09_scope_asset_outside_installed_home')
+    info = path.lstat()
+    if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= 4096:
+        raise RuntimeError('m09_scope_asset_regular_bound')
+    binding = _checked_root_intent(pin)
+    if (type(binding) is not dict or set(binding) != {'schema','binding_nonce','scopes'}
+            or binding['schema'] != 'frw.Root.M09.scope-binding.v1'
+            or type(binding['binding_nonce']) is not str
+            or re.fullmatch('[a-f0-9]{64}', binding['binding_nonce']) is None
+            or type(binding['scopes']) is not list or len(binding['scopes']) != 2):
+        raise RuntimeError('m09_fixed_scope_binding_shape')
+    fields = {'slot','profile','user_id','principal_id','platform','transport_profile','account_id'}
+    rows = binding['scopes']
+    if (any(type(row) is not dict or set(row) != fields
+            or any(type(row[k]) is not str or not 0 < len(row[k]) <= 256 for k in fields)
+            or row['platform'] != 'telegram' for row in rows)
+            or [row['slot'] for row in rows] != ['A','B']
+            or len({row['principal_id'] for row in rows}) != 2
+            or len({row['profile'] for row in rows}) != 2
+            or any(Path(row['profile']).name != row['profile'] or row['profile'] in ('.','..') for row in rows)):
+        raise RuntimeError('m09_fixed_two_scope_binding')
+    return rows
+_M09_PROVIDER_IDS = {
+    ('plugins.memory.retaindb', 'RetainDBMemoryProvider'): 'retaindb',
+    ('plugins.memory.byterover', 'ByteRoverMemoryProvider'): 'byterover',
+    ('plugins.memory.holographic', 'HolographicMemoryProvider'): 'holographic',
+    ('plugins.memory.openviking', 'OpenVikingMemoryProvider'): 'openviking',
+}
