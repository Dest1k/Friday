+def _xlsx_edit_target_row(sheet, cell_ref):
+    groups = sheet.findall(q(S, 'sheetData'))
+    if len(groups) != 1:
+        return None, set()
+    rows = {}
+    target = None
+    try:
+        selected_row, selected_column = address(cell_ref)
+        for row in groups[0].findall(q(S, 'row')):
+            row_index, _ = address('A' + row.get('r', ''))
+            if row_index in rows:
+                return None, set()
+            rows[row_index] = row
+            seen = set()
+            for cell in row.findall(q(S, 'c')):
+                cell_row, column = address(cell.get('r'))
+                if cell_row != row_index or column in seen:
+                    return None, set()
+                seen.add(column)
+                if (cell_row, column) == (selected_row, selected_column):
+                    target = row
+        for merge in sheet.iter(q(S, 'mergeCell')):
+            first, last = merge.get('ref', '').split(':')
+            top, left = address(first)
+            bottom, right = address(last)
+            if (top > bottom or left > right
+                    or top <= selected_row <= bottom and left <= selected_column <= right):
+                return None, set()
+    except ValueError:
+        return None, set()
+    return target, set(rows.values())
