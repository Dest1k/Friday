+    def _archive_conversion_failure_response(self, response):
+        """Truthful managed completion for a refused, unsuperseded conversion.
+
+        No model prose is interpreted. Old-file retrieval and successful turns
+        keep their normal text; this typed failure retains only native, current
+        turn MEDIA references whose descriptor identity and content still match.
+        """
+        from hermes_cli.friday_user_scope import (
+            current, check_agent, managed_reply_stream, workspace_document, _same_scope,
+        )
+        self._turn_archive_conversion_failure_projected = False
+        if (not isinstance(response, str) or not response or not managed_reply_stream(self)
+                or getattr(self, "_interrupt_requested", False)):
+            return response, False
+        failed = getattr(self, "_turn_failed_file_mutations", None) or {}
+        if not any(info.get("operation") == "archive_convert"
+                   and info.get("error_code") == "document_already_exists"
+                   for info in failed.values()):
+            return response, False
+        cap = current(required=True)
+        check_agent(self)
+        if not any(_same_scope(info.get("archive_failure_scope"), cap)
+                   and info.get("operation") == "archive_convert"
+                   and info.get("error_code") == "document_already_exists"
+                   for info in failed.values()):
+            return response, False
+        text = "Не удалось выполнить преобразование архива: файл с выбранным именем уже существовал."
+        refused = {info.get("identity") for info in failed.values()
+                   if info.get("operation") == "archive_convert"
+                   and _same_scope(info.get("archive_failure_scope"), cap)}
+        from gateway.platforms.base import BasePlatformAdapter
+        selected = {_file_mutation_identity(path, getattr(self, "_current_task_id", None))
+                    for path, _ in BasePlatformAdapter.extract_media(response)[0]}
+        media = []
+        for target, artifact in (getattr(self, "_turn_file_mutation_artifacts", None) or {}).items():
+            if (target not in selected or target in refused
+                    or not _same_scope(artifact.get("scope"), cap)):
+                continue
+            relative = artifact["relative"]
+            if any(c in '\\"' or unicodedata.category(c) in ("Cc", "Cf", "Zl", "Zp") for c in relative):
+                continue
+            try:
+                blob, observed, identity = workspace_document(
+                    str(cap.home / "workspace" / relative), with_identity=True)
+            except (OSError, RuntimeError, ValueError):
+                continue
+            if (observed == relative and identity == artifact["identity"]
+                    and hashlib.sha256(blob).hexdigest() == artifact["sha256"]):
+                media.append('MEDIA:"./' + relative + '"')
+        cap.check()
+        if media:
+            text += "\nПодтверждённые результаты этой задачи приложены.\n" + "\n".join(dict.fromkeys(media))
+        self._turn_archive_conversion_failure_projected = True
+        return text, text != response
 
