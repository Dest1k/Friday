+def _address_header(value):
+    """Parse one header value through the existing EmailMessage header factory."""
+    message = EmailMessage(policy=policy.SMTP)
+    try:
+        message['Cc'] = value
+        header = message['Cc']
+    except (MessageError, ValueError, TypeError, IndexError, RecursionError):
+        _fail('invalid_address')
+    if header is None or getattr(header, 'defects', ()):
+        _fail('invalid_address')
+    groups = header.groups
+    if len(groups) != 1 or groups[0].display_name is not None or len(groups[0].addresses) != 1:
+        _fail('invalid_address')
+    address = groups[0].addresses[0]
+    if not address.username or not address.domain:
+        _fail('invalid_address')
+    return address.display_name, address.addr_spec
+
+
+def _mailbox_lists(spec, name):
+    """Validate one concrete, non-group mailbox per optional-field item."""
+    if name not in spec:
+        return [], []
+    values = spec[name]
+    if type(values) is not list or not 1 <= len(values) <= 100:
+        _fail('contact_list_limit')
+    parsed = []
+    for value in values:
+        if type(value) is not str or not value:
+            _fail('contact_list_schema')
+        try:
+            _text(value, 'invalid_address', 4096)
+        except UnicodeError:
+            _fail('invalid_address')
+        # The header parser accepts a terminal comma without reporting an empty item.
+        if value.rstrip().endswith(','):
+            _fail('invalid_address')
+        parsed.append(_address_header(value))
+    return values, parsed
+
+
