+def _stored_range(book, target):
+    """Accept a bounded local rectangle, with known sheet names on both ends."""
+    if not target or len(target.encode('utf-8')) > 512:
+        raise ValueError
+    left, right = target.split(':')
+
+    def endpoint(token, inherited=None):
+        if '.' in token:
+            prefix, cell = token.rsplit('.', 1)
+            label = prefix.removeprefix('$')
+            if label.startswith("'") and label.endswith("'"):
+                name = label[1:-1].replace("''", "'")
+                if label != "'" + name.replace("'", "''") + "'":
+                    raise ValueError
+            elif label and re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', label):
+                name = label
+            elif not prefix and inherited is not None:
+                name = inherited
+            else:
+                raise ValueError
+        else:
+            name, cell = inherited, token
+        if name not in {sheet.get(q(TB, 'name')) for sheet in book.sheets}:
+            raise ValueError
+        if not re.fullmatch(r'\$?[A-Z]{1,3}\$?[1-9][0-9]{0,6}', cell):
+            raise ValueError
+        return name, address(cell.replace('$', ''))
+
+    sheet, (top, first) = endpoint(left)
+    last_sheet, (bottom, last) = endpoint(right, sheet)
+    if sheet != last_sheet or top > bottom or first > last:
+        raise ValueError
+    return sheet, first, last
+
+
+def _stored_filter(node, first_column, last_column):
+    """Expose a small declarative condition tree without applying it."""
+    if node.attrib or (node.text or '').strip() or (node.tail or '').strip() or not len(node):
+        raise ValueError
+    parent, logic = node, None
+    groups = {q(TB, 'filter-and'): 'and', q(TB, 'filter-or'): 'or'}
+    if len(node) == 1 and node[0].tag in groups:
+        parent = node[0]
+        logic = groups[parent.tag]
+        if parent.attrib or (parent.text or '').strip() or (parent.tail or '').strip():
+            raise ValueError
+    if not 1 <= len(parent) <= (16 if logic else 1):
+        raise ValueError
+    allowed = {q(TB, attr) for attr in ('field-number', 'operator', 'data-type', 'case-sensitive', 'value')}
+    conditions = []
+    for child in parent:
+        if (child.tag != q(TB, 'filter-condition') or set(child.attrib) - allowed
+                or (child.text or '').strip() or (child.tail or '').strip()):
+            raise ValueError
+        field = child.get(q(TB, 'field-number'), '')
+        if not re.fullmatch(r'0|[1-9][0-9]{0,4}', field):
+            raise ValueError
+        field = int(field)
+        column = first_column + field
+        operator = child.get(q(TB, 'operator'))
+        data_type = child.get(q(TB, 'data-type'))
+        case_sensitive = child.get(q(TB, 'case-sensitive'))
+        value = child.get(q(TB, 'value'))
+        if (column > last_column or operator != '=' or data_type not in (None, 'text')
+                or case_sensitive not in (None, 'true', 'false')
+                or value is None or len(value.encode('utf-8')) > 256 or len(child) > 32):
+            raise ValueError
+        items = []
+        for entry in child:
+            member = entry.get(q(TB, 'value'))
+            if (entry.tag != q(TB, 'filter-set-item') or set(entry.attrib) != {q(TB, 'value')}
+                    or len(entry) or (entry.text or '').strip() or (entry.tail or '').strip()
+                    or member is None or len(member.encode('utf-8')) > 256):
+                raise ValueError
+            items.append(member)
+        if items and (items[0] != value or len(set(items)) != len(items)):
+            raise ValueError
+        record = {'field_number': field, 'column': colname(column), 'operator': operator, 'value': value}
+        if items:
+            record['set_items'] = items
+        if data_type is not None:
+            record['data_type'] = data_type
+        if case_sensitive is not None:
+            record['case_sensitive'] = case_sensitive == 'true'
+        conditions.append(record)
+    return {'logic': logic, 'conditions': conditions}
+
+
+def _stored_database_ranges(book):
+    """Yield only direct, independently identified local range records."""
+    group_tag = q(TB, 'database-ranges')
+    filter_tag = q(TB, 'filter')
+    groups = book.body.findall(group_tag)
+    filters = set(book.body.iter(filter_tag))
+    if not groups and not filters:
+        return
+    incomplete = 'ods_saved_filter_conditions_not_inspected'
+    if len(groups) != 1 or len(groups[0]) > 64 or groups[0].attrib or (groups[0].text or '').strip():
+        book.unsupported.add(incomplete)
+        return
+    names = [entry.get(q(TB, 'name')) for entry in groups[0]]
+    if len(set(names)) != len(names):
+        book.unsupported.add(incomplete)
+        return
+    allowed = {q(TB, key) for key in ('name', 'target-range-address', 'display-filter-buttons')}
+    for entry, name in zip(groups[0], names):
+        tick(book.checkpoint)
+        try:
+            if (entry.tag != q(TB, 'database-range') or set(entry.attrib) - allowed
+                    or not name or len(name.encode('utf-8')) > 128
+                    or (entry.text or '').strip() or (entry.tail or '').strip()
+                    or len(entry) > 1 or (len(entry) and entry[0].tag != filter_tag)):
+                raise ValueError
+            target = entry.get(q(TB, 'target-range-address'))
+            sheet, first, last = _stored_range(book, target)
+            buttons = entry.get(q(TB, 'display-filter-buttons'))
+            if buttons not in (None, 'true', 'false'):
+                raise ValueError
+            saved = _stored_filter(entry[0], first, last) if len(entry) else None
+            record = {'sheet': sheet, 'name': name, 'target_range': target, 'stored_filter': saved}
+            if buttons is not None:
+                record['display_filter_buttons'] = buttons == 'true'
+            if saved is not None:
+                filters.discard(entry[0])
+        except ValueError:
+            book.unsupported.add(incomplete)
+        else:
+            yield record
+    if filters:
+        book.unsupported.add(incomplete)
