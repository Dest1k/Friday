+def _footer_template(footer, w):
+    """Return a flat mixture of footer literals and decimal page fields."""
+    children = list(footer)
+    if len(children) != 1 or children[0].tag != w+'p':
+        raise ExportRefused('unsupported_package')
+    runs = list(children[0])
+    if runs and runs[0].tag == w+'pPr':
+        runs.pop(0)
+    if not 1 <= len(runs) <= 32:
+        raise ExportRefused('unsupported_package')
+    items = []
+    for run in runs:
+        nodes = list(run)
+        if nodes and nodes[0].tag == w+'rPr':
+            nodes.pop(0)
+        if run.tag != w+'r' or len(nodes) != 1 or len(nodes[0]):
+            raise ExportRefused('unsupported_package')
+        items.append(nodes[0])
+    template, fields = [], set()
+    i = 0
+    while i < len(items):
+        item = items[i]
+        if item.tag == w+'t':
+            text = item.text or ''
+            if len(text) > 256 or any(ord(c) < 32 for c in text):
+                raise ExportRefused('unsupported_package')
+            template.append(('literal', text))
+            i += 1
+            continue
+        group = items[i:i+5]
+        if [node.tag for node in group] != [w+'fldChar',w+'instrText',w+'fldChar',w+'t',w+'fldChar']:
+            raise ExportRefused('unsupported_package')
+        for node, label in zip((group[0], group[2], group[4]), ('begin','separate','end')):
+            allowed = {w+'fldCharType', w+'dirty'} if label == 'begin' else {w+'fldCharType'}
+            if (set(node.attrib) - allowed or node.get(w+'fldCharType') != label or node.text
+                    or node.get(w+'dirty', 'true') not in ('true','false','1','0')):
+                raise ExportRefused('unsupported_package')
+        instr = group[1]
+        if set(instr.attrib) - {'{http://www.w3.org/XML/1998/namespace}space'}:
+            raise ExportRefused('unsupported_package')
+        field = (instr.text or '').strip(' ')
+        if field not in ('PAGE','NUMPAGES') or field in fields:
+            raise ExportRefused('unsupported_package')
+        fields.add(field)
+        template.append((field, ''))
+        i += 5
+    if 'PAGE' not in fields:
+        raise ExportRefused('unsupported_package')
+    return template
