+def _stored_horizontal_merges(name, parts):
+    """Ground one-row anchors only when covered cells account for the full span."""
+    result = []
+    pending = None
+    span_column = q(TB, 'number-columns-spanned')
+    span_row = q(TB, 'number-rows-spanned')
+    repeated = q(TB, 'number-columns-repeated')
+    for row, column, height, width, cell in parts:
+        if (cell.tail or '').strip():
+            return None
+        if cell.tag == q(TB, 'covered-table-cell'):
+            if pending is None or height != 1 or (row, column) != pending[:2]:
+                return None
+            if set(cell.attrib) - {repeated} or len(cell) or (cell.text or '').strip():
+                return None
+            end, anchor = pending[2:]
+            after = column + width
+            if after > end:
+                return None
+            if after == end:
+                result.append({'sheet': name, 'anchor': anchor, 'range': f'{anchor}:{colname(end-1)}{row}'})
+                pending = None
+            else:
+                pending = row, after, end, anchor
+            continue
+        span = cell.get(span_column, '1')
+        if (pending is not None or height != 1 or width != 1 or cell.get(span_row, '1') != '1'
+                or not re.fullmatch(r'[1-9][0-9]{0,4}', span)):
+            return None
+        span = int(span)
+        if span <= 1 or column + span - 1 > MAX_COLS:
+            return None
+        pending = row, column + 1, column + span, f'{colname(column)}{row}'
+    return result if pending is None else None
+
