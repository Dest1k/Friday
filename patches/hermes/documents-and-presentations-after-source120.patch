+    P, A, PresentationRefused, _parts, _rewrite, _xml, _slide_paths,
+    _rels, _resolve, text,
+)
+from tools.scoped_presentation_variants import validate_profile, OOXML, FORMATS
+
+TB = "urn:oasis:names:tc:opendocument:xmlns:table:1.0"
+
+
+def refuse(reason):
+    raise PresentationRefused(reason)
+
+
