+            refuse('nested_text_element')
+        offset=parser.CurrentByteIndex;quote=None
+        for end in range(offset,len(raw)):
+            byte=raw[end]
+            if quote is not None:
+                if byte==quote:quote=None
+            elif byte in (34,39):quote=byte
+            elif byte==62:break
+        else:refuse('invalid_xml')
+        active=(end+1,raw[offset:end].rstrip().endswith(b'/'))
+    def end(name):
+        nonlocal active
+        if name==tag[1:]:
+            if active is None:refuse('invalid_xml')
+            begin,empty=active;spans.append((begin,begin if empty else parser.CurrentByteIndex,empty));active=None
+    def prohibited(*args):refuse('active_xml')
+    parser.StartElementHandler=start;parser.EndElementHandler=end
+    parser.StartDoctypeDeclHandler=prohibited;parser.EntityDeclHandler=prohibited
+    parser.ProcessingInstructionHandler=prohibited
+    _xml(raw)
+    try:parser.Parse(raw,True)
+    except expat.ExpatError:refuse('invalid_xml')
+    return spans
