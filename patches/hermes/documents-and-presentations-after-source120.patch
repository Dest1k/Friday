+            tuple(_fingerprint(node) for node in root
+                  if node.tag not in (q(O, 'body'), q(O, 'meta'))))
+
+
+def _selection(spec, decks):
+    if (not isinstance(spec, dict) or set(spec) != {'sources', 'title', 'order'}
+            or not isinstance(spec['sources'], list) or len(spec['sources']) != 2
+            or not all(isinstance(x, str) and x for x in spec['sources'])
+            or spec['sources'][0] == spec['sources'][1]):
