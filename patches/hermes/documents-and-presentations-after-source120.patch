+"""Own-workspace native ODF merge through the existing atomic CAS publisher."""
+import json
+from pathlib import Path
+
+
+def create_merge(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _create_bytes
+    from hermes_cli.friday_workspace_presentation import _read_source
+    from hermes_cli.friday_workspace_presentation_variants import _destination
+    from tools.scoped_presentation_write import json_object, PresentationRefused
+    from tools.scoped_presentation_variants import ODF
+    from tools.scoped_presentation_odf_merge import merge_odf
+    try:
+        target = _destination(cap, fd, leaf, path)
+        if target not in ODF:
+            raise PresentationRefused('unsupported_odf_merge_profile')
+        spec = json_object(content, ('sources', 'title', 'order'))
+        if not isinstance(spec['sources'], list) or len(spec['sources']) != 2:
+            raise ScopeDenied()
+        states, relatives, formats = [], [], []
+        for raw in spec['sources']:
+            if not isinstance(raw, str):
+                raise ScopeDenied()
+            format = Path(raw).suffix.lower().lstrip('.')
+            if format not in ODF:
+                raise PresentationRefused('unsupported_odf_merge_profile')
+            source, relative, data, identity = _read_source(raw, cap, '.'+format)
+            if source in [state[0] for state in states]:
+                raise ScopeDenied()
+            states.append((source, data, identity))
+            relatives.append(relative)
+            formats.append(format)
+        rendered, metadata = merge_odf([state[1] for state in states], spec, formats, target)
+        def verify():
+            check(cap)
+            for source, data, identity in states:
+                current, _, version = workspace_document(str(source), with_identity=True)
+                if current != data or version != identity:
+                    raise ScopeDenied()
+            check(cap)
+        result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                         output_format=target, verify_source=verify))
+        if result.get('success'):
+            result.update(metadata, sources=relatives, sources_unchanged=True)
+        return json.dumps(result, ensure_ascii=False)
+    except ScopeDenied:
+        raise
+    except PresentationRefused as error:
+        return json.dumps({'success': False, 'error': 'presentation_operation_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
