+"""Scoped unique slide/notes edits with original-source CAS publication."""
+import hashlib
+import json
+from pathlib import Path
+
+
+def create_edit(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from hermes_cli.friday_workspace_presentation_variants import _destination
+    from tools.scoped_presentation_write import json_object, PresentationRefused
+    from tools.scoped_presentation_text import edit_text
+    from tools.scoped_presentation_variants import FORMATS
+    try:
+        target = _destination(cap, fd, leaf, path)
+        request = json_object(content, ('source', 'slide', 'role', 'old_text', 'new_text'))
+        if not isinstance(request['source'], str):
+            raise ScopeDenied()
+        format = Path(request['source']).suffix.lower().lstrip('.')
+        if format not in FORMATS or target != format:
+            raise PresentationRefused('text_edit_output_profile_mismatch')
+        source, relative, original, identity = _read_source(request['source'], cap, '.'+format)
+        edit = {key: value for key, value in request.items() if key != 'source'}
+        rendered = edit_text(original, format, edit)
+        check(cap)
+        return _publish(cap, fd, leaf, path, rendered, format, (source, original, identity),
+                        {'source': relative, 'source_sha256': hashlib.sha256(original).hexdigest(),
+                         'source_unchanged': True, 'preserving_edit': True,
+                         'edit_mode': 'unique_native_text', 'slide': request['slide'],
+                         'role': request['role'], 'output_profile': format})
+    except ScopeDenied:
+        raise
+    except PresentationRefused as error:
+        return json.dumps({'success': False, 'error': 'presentation_text_edit_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
