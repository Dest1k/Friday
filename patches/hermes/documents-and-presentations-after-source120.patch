+"""Own-workspace ODT creation and source-preserving, create-only copies."""
+import hashlib
+import json
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_odt import ODTError, edit_document
+
+
+def _spec(content):
+    if not isinstance(content, str) or len(content.encode('utf-8')) > 100_000:
+        raise ScopeDenied()
+
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ScopeDenied()
+            result[key] = value
+        return result
+
+    try:
+        value = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    if not isinstance(value, dict) or set(value) != {'source', 'old_text', 'new_text'}:
+        raise ScopeDenied()
+    return value
+
+
+def create(cap, fd, leaf, path, content, *, structured=False):
+    from tools.scoped_odt_create import create_odt, ODTCreateError
+    from tools.scoped_odt import DocumentPackage
+
+    _check_parent(cap, fd, path)
+    try:
+        data = create_odt(content, structured=structured, checkpoint=lambda: check(cap))
+        DocumentPackage(data, 'odt', lambda: check(cap))
+    except (ODTCreateError, ODTError) as error:
+        return json.dumps({'success': False, 'error': 'document_create_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
+    return _create_bytes(cap, fd, leaf, path, data, output_format='odt')
+
+
+def create_edit(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import workspace_document
+
+    _check_parent(cap, fd, path)
+    spec = _spec(content)
+    raw = spec['source']
+    if not isinstance(raw, str) or not raw or '\x00' in raw:
+        raise ScopeDenied()
+    root = cap.home / 'workspace'
+    source = Path(raw)
+    if not source.is_absolute():
+        source = root / source
+    try:
+        relative = source.relative_to(root)
+    except ValueError:
+        raise ScopeDenied() from None
+    if (not relative.parts or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+            or source.suffix.lower() != '.odt' or relative.as_posix() == path):
+        raise ScopeDenied()
+    data, _, identity = workspace_document(str(source), with_identity=True)
+    try:
+        rendered = edit_document(data, spec['old_text'], spec['new_text'],
+                                 checkpoint=lambda: check(cap))
+    except ODTError as error:
+        return json.dumps({'success': False, 'error': 'document_edit_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
+
+    def verify():
+        check(cap)
+        current, _, version = workspace_document(str(source), with_identity=True)
+        if current != data or version != identity:
+            raise ScopeDenied()
+
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                     output_format='odt', verify_source=verify))
+    if result.get('success'):
+        result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(data).hexdigest(),
+                      replacements=1, source_unchanged=True, unchanged_parts_preserved=True,
+                      edit_mode='exact_text')
+    return json.dumps(result, ensure_ascii=False)
