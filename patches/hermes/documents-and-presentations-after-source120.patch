+                  and name != 'Thumbnails/thumbnail.png'}
+    if unexpected:
+        _refuse('unrepresented_package_parts')
+    # The ODF document order is significant; sections were collected from files.
+    rank = {q(O, name): index for index, name in enumerate(_ODF_SECTIONS)}
+    flat[:] = sorted(flat, key=lambda node: rank[node.tag])
+    result = _serialize(flat, namespaces)
+    validate_profile(result, 'fodp')
+    return result
+
+
+def reprofile(data, source_format, target_format):
+    """Convert within an XML family; no Office invocation or inferred format."""
+    validate_profile(data, source_format)
+    if target_format not in FORMATS:
+        _refuse('unsupported_presentation_profile')
+    if source_format == target_format:
+        return data
+    if (source_format in OOXML) != (target_format in OOXML):
+        _refuse('cross_family_requires_renderer')
+    if source_format == 'fodp':
+        data = flat_to_odp(data); source_format = 'odp'
+    if target_format == 'fodp':
+        return odp_to_flat(reprofile(data, source_format, 'odp'))
+    infos, parts = _parts(data)
+    if source_format in OOXML:
+        name = '[Content_Types].xml'
+        root = _xml(parts[name]); found = []
+        for node in root:
+            if node.tag == q(CT, 'Override') and node.get('PartName') == '/ppt/presentation.xml':
+                found.append(node)
+        if len(found) != 1 or found[0].get('ContentType') != PPT_MAIN_TYPES[source_format]:
+            _refuse('presentation_profile_mismatch')
+        found[0].set('ContentType', PPT_MAIN_TYPES[target_format])
+        changes = {name: _serialize(root, _namespaces(parts[name]))}
+    else:
+        name = 'META-INF/manifest.xml'; root = _xml(parts[name])
+        found = [node for node in root if node.get(q(MANIFEST, 'full-path')) == '/']
+        if len(found) != 1 or found[0].get(q(MANIFEST, 'media-type')) != ODF_MIMES[source_format]:
+            _refuse('presentation_profile_mismatch')
+        found[0].set(q(MANIFEST, 'media-type'), ODF_MIMES[target_format])
+        changes = {'mimetype': ODF_MIMES[target_format].encode(),
+                   name: _serialize(root, _namespaces(parts[name]))}
+    result = _rewrite(infos, parts, changes)
+    validate_profile(result, target_format)
+    return result
+
+
+def edit_profile(data, format, spec):
+    if format not in FORMATS:
+        _refuse('unsupported_presentation_profile')
+    fields = ({'slide', 'old_title', 'new_title', 'category', 'old_value', 'new_value'}
+              if format in OOXML else {'slide', 'table', 'row', 'column', 'old_value', 'new_value'})
+    if not isinstance(spec, dict) or set(spec) != fields:
+        _refuse('edit_schema')
+    base = 'pptx' if format in OOXML else 'odp'
+    normal = reprofile(data, format, base)
+    edited = edit_pptx(normal, spec) if base == 'pptx' else edit_odp(normal, spec)
+    return reprofile(edited, base, format)
