+    if not isinstance(spec['order'], list) or not 1 <= len(spec['order']) <= 59:
+        _refuse('merge_order_capacity')
+    chosen = []
+    for position, item in enumerate([spec['title']] + spec['order']):
+        if (not isinstance(item, dict) or set(item) != {'source', 'slide'}
+                or type(item['source']) is not int or item['source'] not in (1, 2)
+                or type(item['slide']) is not int):
