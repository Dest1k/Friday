+    """Byte spans for simple XML text elements; never reserialize a source part."""
+    parser=expat.ParserCreate(encoding='UTF-8',namespace_separator='}')
+    spans=[];active=None
+    def start(name,attrs):
+        nonlocal active
+        if name != tag[1:]:
+            return
