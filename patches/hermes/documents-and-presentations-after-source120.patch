+TEXT = 'urn:oasis:names:tc:opendocument:xmlns:text:1.0'
+CONFIG = 'urn:oasis:names:tc:opendocument:xmlns:config:1.0'
+FORM = 'urn:oasis:names:tc:opendocument:xmlns:form:1.0'
+ANIM = 'urn:oasis:names:tc:opendocument:xmlns:animation:1.0'
+SMIL = 'urn:oasis:names:tc:opendocument:xmlns:smil-compatible:1.0'
+PR = 'urn:oasis:names:tc:opendocument:xmlns:presentation:1.0'
+_PASSIVE_NAMESPACES = {
+    O, DR, XL, STYLE, TABLE, XML, TEXT, PR, META, CONFIG,
+    'urn:oasis:names:tc:opendocument:xmlns:chart:1.0',
+    'urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0',
+    'urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0',
+    'urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0',
+    'http://purl.org/dc/elements/1.1/',
+}
+_ID = re.compile(r'[A-Za-z_][A-Za-z0-9_.-]*\Z')
+_FORBIDDEN_ATTRIBUTES = {
+    q(DR, 'chain-next-name'), q(DR, 'copy-of'), q(DR, 'nav-order'),
+    q(TEXT, 'ref-name'), q(TEXT, 'note-ref'), q(PR, 'master-element'),
+}
+
+
+def _refuse(reason):
+    raise PresentationRefused(reason)
+
+
+def _fingerprint(node):
+    # Expanded element/attribute names avoid irrelevant serializer prefix changes.
+    # Whitespace remains significant: compatibility is intentionally conservative.
+    return (node.tag, tuple(sorted(node.attrib.items())), node.text,
+            tuple((_fingerprint(child), child.tail) for child in node))
+
+
+def _scope_nodes(root):
+    """Nodes in this ODF document; embedded office:document has its own IDs."""
+    yield root
+    for child in root:
+        if child.tag != q(O, 'document'):
+            yield from _scope_nodes(child)
+
+
+def _ids(root):
+    result = {}
+    for node in _scope_nodes(root):
+        for key in (q(XML, 'id'), q(DR, 'id')):
+            if key not in node.attrib:
+                continue
+            value = node.get(key)
+            if not _ID.fullmatch(value):
+                _refuse('odf_identifier_unsupported')
+            if value in result and result[value] is not node:
+                _refuse('ambiguous_odf_identifier')
+            result[value] = node
