+"""Scoped native template/show/flat-ODF writes through existing publication."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+def _destination(cap, fd, leaf, path):
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_presentation_variants import FORMATS
+    from tools.scoped_presentation_write import PresentationRefused
+    check(cap)
+    _check_parent(cap, fd, path)
+    target = Path(path).suffix.lower().lstrip('.')
+    if target not in FORMATS | {'pdf'}:
+        raise PresentationRefused('unsupported_presentation_profile')
+    try:
+        os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError:
+        return target
+    raise PresentationRefused('document_already_exists')
+
+
+def _convert(cap, data, source_format, target):
