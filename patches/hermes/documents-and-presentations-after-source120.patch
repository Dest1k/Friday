+    names = {page.get(q(DR, 'name')) for page in pages}
+    for node in root.iter():
+        if (node.tag.startswith(tuple('{'+ns+'}' for ns in (ANIM, SMIL, FORM)))
+                or node.tag in (q(O, 'forms'), q(DR, 'control'))
+                or any(key.startswith(tuple('{'+ns+'}' for ns in (ANIM, SMIL, FORM)))
+                       for key in node.attrib)):
