+
+
+def merge_odf(inputs, spec, source_formats, output_format='odp'):
+    """Return native bytes and provenance; inputs are immutable own-scope bytes."""
+    if (not isinstance(inputs, list) or len(inputs) != 2
+            or not all(isinstance(data, bytes) for data in inputs) or inputs[0] == inputs[1]):
+        _refuse('two_distinct_decks_required')
