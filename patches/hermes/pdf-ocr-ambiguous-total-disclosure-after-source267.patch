+def _ambiguous_total_start(words):
+    if not words or words[0].removesuffix(':').casefold() not in {'total', 'итого'}:
+        return None
+    start = 1
+    if not words[0].endswith(':') and words[1:2] == [':']:
+        start = 2
+    fragments = words[start:]
+    # Whitespace alone may be normal thousands grouping or separate values.
+    # A split amount and separate count/angle columns can have identical
+    # fragments. Describe uncertainty without inferring their meaning.
+    if len(fragments) == 2:
+        left, right = fragments
+        if re.fullmatch(r'[0-9]+', left) and re.fullmatch(r'[0-9]+°[0-9]+', right):
+            return start
+    elif len(fragments) == 3:
+        left, separator, right = fragments
+        if separator == '°' and re.fullmatch(r'[0-9]+', left) and re.fullmatch(r'[0-9]+', right):
+            return start
+    return None
+
