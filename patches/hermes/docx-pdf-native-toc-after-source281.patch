+"""Update one pending Writer TOC inside the existing private PDF renderer."""
+
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import sys
+from time import monotonic, sleep
+from uuid import uuid4
+
+
+BRIDGE_PINS = {
+    'uno.py': 'c3020eb13e43c0a3b33a73b0c1234017f556186ced5ee88d0d1483b3ad0cae4f',
+    'unohelper.py': '0aa4d49ca34e12f1facef61990f98a1817f419c6125d156cca8d968f1c88b389',
+    'pyuno.so': 'aa7eb3185fbd7e82dd95d3a5352f8a012824e674819562ebfe867bc5a59c648c',
+    'libpyuno.so': '9447d12c57f1cbca739791a227a47a7128b561225805741c6ce8029dafec362d',
+}
+_PREFIX = '/opt/friday-document-toolchain/root/usr/lib'
+_PROGRAM = _PREFIX + '/libreoffice/program'
+URE = 'vnd.sun.star.pathname:' + _PROGRAM + '/fundamentalrc'
+LD = _PROGRAM + ':' + _PREFIX + '/x86_64-linux-gnu:/bridge'
+PENDING = 'Оглавление требует обновления полей.'
+_SOURCE = Path('/work/input.docx')
+_DESTINATION = Path('/work/out/input.pdf')
+_EVIDENCE = Path('/work/toc-index.json')
+_PROTECTED_PROPERTIES = ('MacroExecutionMode', 'UpdateDocMode')
+
+
+class BridgeUnavailable(ValueError):
+    """The fixed PyUNO bridge could not be verified or loaded."""
+
+
+def _require(condition, reason):
+    if not condition:
+        raise ValueError(reason)
+
+
+def _identity(info):
+    return (info.st_dev, info.st_ino, info.st_mode, info.st_nlink, info.st_uid, info.st_gid,
+            info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+
+def _snapshot(path):
+    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
+    with os.fdopen(os.open(path, flags), 'rb') as stream:
+        before = os.fstat(stream.fileno())
+        _require(stat.S_ISREG(before.st_mode) and before.st_nlink == 1
+                 and before.st_uid == os.getuid() and not before.st_mode & 0o022
+                 and 0 < before.st_size <= 1_000_000, 'invalid_private_file')
+        data = stream.read(before.st_size + 1)
+        after = os.fstat(stream.fileno())
+    named = path.lstat()
+    identity = _identity(before)
+    _require(len(data) == before.st_size and identity == _identity(after) == _identity(named),
+             'private_file_changed')
+    return data, identity
+
+
+def _init_bridge(host_ns):
+    namespace_keys = ('net', 'mnt', 'pid')
+    _require(__debug__ and sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode
+             and os.getpid() == 1 and Path.cwd() == Path('/work')
+             and set(host_ns) == set(namespace_keys)
+             and all(os.readlink(f'/proc/self/ns/{key}') != host_ns[key] for key in namespace_keys),
+             'toc_renderer_isolation')
+    bridge = Path('/bridge')
+    try:
+        _require(os.environ.get('URE_BOOTSTRAP') == URE and os.environ.get('LD_LIBRARY_PATH') == LD,
+                 'bridge_environment')
+        _require({path.name for path in bridge.iterdir()} == set(BRIDGE_PINS), 'bridge_members')
+        for name, expected in BRIDGE_PINS.items():
+            data, _ = _snapshot(bridge / name)
+            _require(sha256(data).hexdigest() == expected, 'bridge_hash')
+        sys.path.insert(0, str(bridge))
+        import uno
+        import unohelper
+        import pyuno
+        for module, name in ((uno, 'uno.py'), (unohelper, 'unohelper.py'), (pyuno, 'pyuno.so')):
+            _require(module.__file__ == str(bridge / name), 'bridge_import_path')
+        maps = Path('/proc/self/maps').read_text().splitlines()
+        _require(any(line.endswith(' /bridge/libpyuno.so') for line in maps), 'bridge_mapping')
+        for name in ('MacroExecMode.NEVER_EXECUTE', 'UpdateDocMode.NO_UPDATE'):
+            _require(uno.getConstantByName('com.sun.star.document.' + name) == 0, 'bridge_policy')
+    except (ImportError, OSError, ValueError) as exc:
+        raise BridgeUnavailable('toc_binding_unavailable') from exc
+    return uno, unohelper
+
+
+def _rows(anchor):
+    _require(len(anchor) <= 8192 and PENDING.casefold() not in anchor.casefold(), 'toc_index_text')
+    lines = anchor.split('\n')
+    _require(1 <= len(lines) <= 8, 'toc_index_count')
+    rows = []
+    names = set()
+    for entry in lines:
+        heading, tab, page = entry.rpartition('\t')
+        name = ' '.join(heading.split())
+        _require(tab and 0 < len(heading) <= 256 and name and name not in names
+                 and not any(ord(char) < 32 for char in heading)
+                 and len(page) == 1 and '1' <= page <= '8', 'toc_index_entry')
+        number = int(page)
+        _require(not rows or rows[-1][1] <= number, 'toc_index_page_order')
+        names.add(name)
+        rows.append((heading, number))
+    return rows
+
+
+def _wait_for_context(process, resolver, connection, unavailable):
+    deadline = monotonic() + 12
+    while True:
+        _require(process.poll() is None and monotonic() < deadline, 'toc_private_bridge_unavailable')
+        try:
+            return resolver.resolve('uno:' + connection + 'StarOffice.ComponentContext')
+        except unavailable:
+            sleep(0.05)
+
+
+def _office_environment():
+    return {'PATH': '/usr/bin:/bin', 'HOME': '/work/home', 'TMPDIR': '/work/tmp',
+            'LANG': 'C.UTF-8', 'LC_ALL': 'C.UTF-8', 'SAL_USE_VCLPLUGIN': 'svp',
+            'XDG_CACHE_HOME': '/work/home/cache', 'XDG_CONFIG_HOME': '/work/home/config',
+            'XDG_RUNTIME_DIR': '/work/tmp', 'LD_LIBRARY_PATH': LD, 'URE_BOOTSTRAP': URE}
+
+
+def main(host_ns, source_sha256):
+    """Render a validated staged input and leave candidate rows for PDF verification."""
+    uno, unohelper = _init_bridge(host_ns)
+    from com.sun.star.connection import NoConnectException
+    from com.sun.star.task import XInteractionHandler
+
+    os.umask(0o077)
+    source, identity = _snapshot(_SOURCE)
+    _require(sha256(source).hexdigest() == source_sha256, 'toc_input_hash')
+    _require(not os.path.lexists(_DESTINATION) and not os.path.lexists(_EVIDENCE), 'toc_output_exists')
+    source_url = _SOURCE.as_uri()
+    abort_type = uno.getTypeByName('com.sun.star.task.XInteractionAbort')
+
+    class AbortOnly(unohelper.Base, XInteractionHandler):
+        requests = 0
+
+        def handle(self, request):
+            self.requests += 1
+            for option in request.getContinuations():
+                abort = option.queryInterface(abort_type)
+                if abort is not None:
+                    abort.select()
+                    return
+            raise ValueError('toc_interaction_without_abort')
+
+    def property_value(name, value):
+        item = uno.createUnoStruct('com.sun.star.beans.PropertyValue')
+        item.Name = name
+        item.Value = uno.Any('short', value) if name in _PROTECTED_PROPERTIES else value
+        return item
+
+    handler = AbortOnly()
+    local = uno.getComponentContext()
+    resolver = local.ServiceManager.createInstanceWithContext('com.sun.star.bridge.UnoUrlResolver', local)
+    connection = 'pipe,name=frw-one-toc-' + uuid4().hex + ';urp;'
+    process = subprocess.Popen([
+        _PROGRAM + '/soffice', '--headless', '--norestore', '--nodefault', '--nofirststartwizard',
+        '-env:UserInstallation=file:///work/home/profile', '--accept=' + connection + 'StarOffice.ServiceManager',
+    ], env=_office_environment(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL, close_fds=True)
+    try:
+        remote = _wait_for_context(process, resolver, connection, NoConnectException)
+        desktop = remote.ServiceManager.createInstanceWithContext('com.sun.star.frame.Desktop', remote)
+        _require(not desktop.getComponents().hasElements(), 'toc_desktop_not_empty')
+        provider = remote.ServiceManager.createInstanceWithContext(
+            'com.sun.star.configuration.ConfigurationProvider', remote)
+        product = provider.createInstanceWithArguments('com.sun.star.configuration.ConfigurationAccess',
+                                                       (property_value('nodepath', '/org.openoffice.Setup/Product'),))
+        _require(str(product.getByName('ooSetupVersionAboutBox')) == '26.2.5.2', 'toc_writer_version')
+        options = {'Hidden': True, 'ReadOnly': True, 'FilterName': 'Office Open XML Text',
+                   'InteractionHandler': handler, 'MacroExecutionMode': 0, 'UpdateDocMode': 0}
+        doc = desktop.loadComponentFromURL(source_url, '_blank', 0,
+                                          tuple(property_value(name, value) for name, value in options.items()))
+        _require(doc is not None and doc.supportsService('com.sun.star.text.TextDocument')
+                 and doc.getURL() == source_url and doc.isReadonly() and not doc.isModified()
+                 and handler.requests == 0, 'toc_document_boundary')
+        indexes = doc.getDocumentIndexes()
+        _require(indexes.getCount() == 1, 'toc_index_count')
+        index = indexes.getByIndex(0)
+        _require(index.supportsService('com.sun.star.text.ContentIndex')
+                 and index.getAnchor().getString() == PENDING, 'toc_index_not_pending')
+
+        index.update()
+        _require(handler.requests == 0 and doc.getURL() == source_url and doc.isReadonly()
+                 and indexes.getCount() == 1, 'toc_index_update_boundary')
+        doc.storeToURL(_DESTINATION.as_uri(), (property_value('FilterName', 'writer_pdf_Export'),
+                                               property_value('Overwrite', False)))
+        _require(handler.requests == 0 and doc.getURL() == source_url and doc.isReadonly()
+                 and indexes.getCount() == 1, 'toc_pdf_export_boundary')
+        rows = _rows(index.getAnchor().getString())
+
+        if doc.isModified():
+            doc.setModified(False)
+        doc.close(True)
+        _require(handler.requests == 0 and desktop.terminate(), 'toc_desktop_terminate')
+        _require(process.wait(timeout=4) == 0, 'toc_writer_status')
+        _require(not Path(f'/proc/{process.pid}').exists(), 'toc_writer_reap')
+    finally:
+        if process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=1)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=1)
+
+    after, after_identity = _snapshot(_SOURCE)
+    _require(after_identity == identity and sha256(after).hexdigest() == source_sha256, 'toc_source_changed')
+    pdf, _ = _snapshot(_DESTINATION)
+    _require(pdf.startswith(b'%PDF-') and pdf.rstrip().endswith(b'%%EOF'), 'toc_invalid_pdf')
+    with _EVIDENCE.open('x', encoding='utf-8') as evidence:
+        json.dump({'pdf_sha256': sha256(pdf).hexdigest(), 'rows': rows}, evidence, ensure_ascii=False)
+    return rows
diff --git a/hermes_cli/friday_workspace_pdf_toc_verify.py b/hermes_cli/friday_workspace_pdf_toc_verify.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/friday_workspace_pdf_toc_verify.py
@@ -0,0 +1,126 @@
+"""Verify searchable TOC targets in the bounded native report's exact PDF."""
+
+from itertools import groupby
+from typing import NamedTuple
+
+
+_TITLE = 'Оглавление'
+_PENDING = 'оглавление требует обновления полей'
+_MAX_PAGES = 8
+_MAX_HEADINGS = 8
+# Points from the pinned native report section, with Poppler subpoint tolerance.
+_PAGE = (612, 792)
+_LEFT, _RIGHT, _TOP = 90, 522, 72
+_TOLERANCE = .5
+_DOTS = '.…'
+
+
+class TocVerificationError(ValueError):
+    """A finite refusal without document content."""
+
+
+class _Line(NamedTuple):
+    page: int
+    text: str
+    left: float
+    top: float
+    right: float
+    bottom: float
+
+
+def _require(condition):
+    if not condition:
+        raise TocVerificationError('toc_unverified')
+
+
+def _lines(words, page):
+    for _, group in groupby(words, key=lambda word: word['line']):
+        row = list(group)
+        text = ' '.join(' '.join(word['text'] for word in row).split())
+        yield _Line(page, text, row[0]['bounds'][0], min(w['bounds'][1] for w in row),
+                    row[-1]['bounds'][2], max(w['bounds'][3] for w in row))
+
+
+def _after(previous, following):
+    return previous.page < following.page or (
+        previous.page == following.page and previous.bottom <= following.top)
+
+
+def _split_page_label(text):
+    prefix = text.rstrip('0123456789')
+    return prefix, text[len(prefix):]
+
+
+def _leader(text):
+    dots = text.replace(' ', '')
+    return len(dots) >= 2 and not set(dots).difference(_DOTS)
+
+
+def _right_aligned(line):
+    return abs(line.right - _RIGHT) <= _TOLERANCE
+
+
+def _in_body(line):
+    return line.top >= _TOP - _TOLERANCE
+
+
+def verify_toc(pages, geometry, expected_headings, model_rows):
+    """Return matched rows after existing bounded bbox and footer verification.
+
+    The DOCX profile supplies unambiguous styled headings in source order. The
+    caller supplies bbox data bound to the exact PDF, with an already verified
+    final footer on every page. Each accepted index row and body heading must
+    occupy its own physical line.
+    """
+    _require(1 <= len(pages) <= _MAX_PAGES and len(geometry) == len(pages)
+             and all(size == _PAGE for size in geometry))
+    headings = tuple(' '.join(heading.split()) for _, heading in expected_headings)
+    _require(1 <= len(headings) <= _MAX_HEADINGS and all(headings)
+             and len(set(headings)) == len(headings))
+    _require(isinstance(model_rows, (list, tuple)) and len(model_rows) == len(headings))
+    for heading, row in zip(headings, model_rows, strict=True):
+        _require(isinstance(row, (list, tuple)) and len(row) == 2
+                 and isinstance(row[0], str) and ' '.join(row[0].split()) == heading
+                 and type(row[1]) is int and 1 <= row[1] <= len(pages))
+
+    all_lines, body = [], []
+    for number, words in enumerate(pages, 1):
+        lines = list(_lines(words, number))
+        all_lines.extend(lines)
+        page_body = [line for line in lines[:-1] if _in_body(line)]
+        _require(any(any(char.isalnum() for char in line.text) for line in page_body))
+        body.extend(page_body)
+    _require(_PENDING not in ' '.join(line.text for line in all_lines).casefold()
+             and _PENDING not in ' '.join(line.text for line in body).casefold())
+    titles = [line for line in all_lines if line.text == _TITLE]
+    _require(len(titles) == 1 and titles[0].page == 1 and titles[0] in body
+             and abs(titles[0].left - _LEFT) <= _TOLERANCE)
+
+    title = titles[0]
+    first = body.index(title) + 1
+    end = first + len(headings)
+    index = body[first:end]
+    _require(len(index) == len(headings))
+    previous = title
+    for heading, (_, target), line in zip(headings, model_rows, index, strict=True):
+        prefix, number = _split_page_label(line.text)
+        _require(line.page == title.page and _after(previous, line) and _right_aligned(line)
+                 and prefix.startswith(heading) and _leader(prefix[len(heading):])
+                 and number == str(target))
+        previous = line
+
+    # A second index-looking row with the report's right-aligned tab is ambiguous.
+    for line in body[:first] + body[end:]:
+        if _right_aligned(line):
+            prefix, number = _split_page_label(line.text)
+            left = prefix.rstrip(_DOTS + ' ')
+            _require(not (left and number and _leader(prefix[len(left):])))
+
+    for heading, (_, target) in zip(headings, model_rows, strict=True):
+        matches = [line for line in all_lines if line.text == heading]
+        _require(len(matches) == 1 and matches[0] in body and matches[0].page == target
+                 and _after(previous, matches[0])
+                 and abs(matches[0].left - _LEFT) <= _TOLERANCE
+                 and matches[0].right <= _RIGHT + _TOLERANCE)
+        previous = matches[0]
+    return len(headings)
diff --git a/tools/scoped_word_pdf_toc.py b/tools/scoped_word_pdf_toc.py
new file mode 100644
--- /dev/null
+++ b/tools/scoped_word_pdf_toc.py
@@ -0,0 +1,235 @@
+"""Source candidate for the single pending TOC of the native Friday DOCX report."""
+from dataclasses import dataclass
+from hashlib import sha256
+from io import BytesIO
+import json
+from xml.etree.ElementTree import Element, ParseError
+from xml.parsers.expat import ExpatError
+from zipfile import ZipFile, BadZipFile
+import zlib
+
+from hermes_cli.friday_workspace_docx import _blocks, _edit_parts, _paragraph, _EditRefused, MAX_OUTPUT
+from tools.scoped_word_profiles import _Package, WordProfileError, W, R
+
+WORD = '{' + W + '}'
+REL = '{' + R + '}'
+SPACE = '{http://www.w3.org/XML/1998/namespace}space'
+MAIN = 'word/document.xml'
+HEADER = 'word/friday-report-header.xml'
+FOOTER = 'word/friday-report-footer.xml'
+OPC = ('[Content_Types].xml', 'word/_rels/document.xml.rels')
+VARIABLE = {*OPC, MAIN, HEADER}
+# The same static members, including the unchanged footer and settings, occur
+# in the qualified two-part diagnostic and the corrected report generator.
+SECTION_LAYOUT = '1a3d3a92662950cf8b99362186f393fa4dfd5ebb6de64c10fcff1947d53518fd'
+STATIC_MEMBERS = 'a8b8325cf93bbbdf276545dc18f04bcb173336931916251456230cd71b7ae9e2'
+OPC_PINS = {
+    False: ('602411ff642500c5ca439c823bdd97b4f6e04b06bdea4430dbffb4a7de74bbf2',
+            '8971fe62b40dbd44d747889a89743f2ccf8307f00af67e53664db817bc9e0c6f'),
+    True: ('f696348fe8a63fc07ec882fdd44173850673f9183ea14916db7e107d6dea700b',
+           '2f902aaab2cc886880b9ec9f45b0d8e10520155a522de30dd6b35251ced48f7e'),
+}
+TITLE = 'Оглавление'
+PENDING = 'Оглавление требует обновления полей.'
+INSTRUCTIONS = {r'TOC \o "1-2" \u': 2, r'TOC \o "1-3" \u': 3}
+FIELDS = {WORD+tag for tag in ('fldChar', 'instrText', 'delInstrText', 'fldSimple')}
+BODY_CHILDREN = {
+    'body': 'p tbl sectPr', 'p': 'pPr r', 'pPr': 'pStyle outlineLvl',
+    'r': 't br tab fldChar instrText', 'tbl': 'tblPr tblGrid tr', 'tblPr': 'tblStyle tblW',
+    'tblGrid': 'gridCol', 'tr': 'tc', 'tc': 'tcPr p', 'tcPr': 'tcW',
+    'sectPr': 'headerReference footerReference pgSz pgMar cols docGrid',
+}
+BODY_ATTRIBUTES = {
+    'br': '', 't': '', 'instrText': '', 'fldChar': 'dirty fldCharType',
+    'pStyle': 'val', 'outlineLvl': 'val', 'tblStyle': 'val', 'tblW': 'w type',
+    'gridCol': 'w', 'tcW': 'w type', 'sectPr': 'rsidR rsidRPr rsidSect',
+    'headerReference': 'type', 'footerReference': 'type', 'pgSz': 'w h',
+    'pgMar': 'top right bottom left header footer gutter', 'cols': 'space', 'docGrid': 'linePitch',
+}
+
+
+
+@dataclass(frozen=True)
+class TocProfile:
+    levels: int
+    headings: tuple[tuple[int, str], ...]
+    footer: Element
+
+
+def require(condition):
+    if not condition:
+        raise WordProfileError('unsupported_report_toc')
+
+
+def style(paragraph):
+    rows = paragraph.findall(WORD+'pPr')
+    if not rows:
+        return None, None
+    require(len(rows) == 1 and rows[0] is paragraph[0])
+    properties = rows[0]
+    names = properties.findall(WORD+'pStyle')
+    outlines = properties.findall(WORD+'outlineLvl')
+    require(len(names) <= 1 and len(outlines) <= 1 and len(properties) == len(names)+len(outlines))
+    return (names[0].get(WORD+'val') if names else None,
+            outlines[0].get(WORD+'val') if outlines else None)
+
+
+def literal(paragraph):
+    runs = [node for node in paragraph if node.tag != WORD+'pPr']
+    require(paragraph.tag == WORD+'p' and len(runs) == 1 and not runs[0].attrib)
+    run = runs[0]
+    require(run.tag == WORD+'r' and len(run) == 1)
+    text = run[0]
+    require(text.tag == WORD+'t' and not len(text) and set(text.attrib) <= {SPACE})
+    value = text.text or ''
+    require(0 < len(value) <= 256 and not any(ord(char) < 32 for char in value))
+    return value
+
+
+def shape(node):
+    return [node.tag, sorted(node.attrib.items()), node.text or '', [shape(child) for child in node]]
+
+
+def paragraph_text(paragraph, name=None, level=None):
+    runs = [node for node in paragraph if node.tag != WORD+'pPr']
+    require(paragraph.tag == WORD+'p' and len(runs) == 1 and runs[0].tag == WORD+'r')
+    pieces = {WORD+'br': '\n', WORD+'tab': '\t'}
+    require(all(node.tag == WORD+'t' or node.tag in pieces for node in runs[0]))
+    literal_text = ''.join(node.text or '' if node.tag == WORD+'t' else pieces[node.tag]
+                           for node in runs[0])
+    expected = Element('expected')
+    _paragraph(expected, literal_text, style=name, level=level)
+    require(shape(paragraph) == shape(expected[0]))
+    return literal_text
+
+
+def require_table(table):
+    rows = [row.findall(WORD+'tc') for row in table.findall(WORD+'tr')]
+    require(1 <= len(rows) <= 8 and 1 <= len(rows[0]) <= 4)
+    require(all(len(row) == len(rows[0]) for row in rows))
+    data = []
+    for row in rows:
+        cells = []
+        for cell in row:
+            paragraphs = cell.findall(WORD+'p')
+            require(len(paragraphs) == 1)
+            cells.append(paragraph_text(paragraphs[0]))
+        data.append(cells)
+    expected = Element('expected')
+    _blocks(expected, [{'type':'table','rows':data}])
+    require(shape(table) == shape(expected[0]))
+
+
+def profile(data, *, checkpoint=None):
+    """Recognize the raw package before any Writer launch or output effect."""
+    require(isinstance(data, bytes) and 0 < len(data) <= MAX_OUTPUT)
+    try:
+        with ZipFile(BytesIO(data)) as archive:
+            _edit_parts(archive)
+    except (_EditRefused, BadZipFile, KeyError, RuntimeError, NotImplementedError, OSError,
+            ParseError, ExpatError, zlib.error):
+        raise WordProfileError('unsupported_report_toc') from None
+    package = _Package(data, 'docx', checkpoint)
+    require(not package.active and not package.macro)
+    passive = sorted((name, sha256(raw).hexdigest()) for name, raw in package.parts.items()
+                     if name not in VARIABLE)
+    require(sha256(json.dumps(passive, separators=(',', ':')).encode()).hexdigest() == STATIC_MEMBERS)
+    has_header = HEADER in package.parts
+    require(tuple(sha256(package.parts[part]).hexdigest() for part in OPC) == OPC_PINS[has_header])
+    if has_header:
+        header = package.xml[HEADER]
+        require(header.tag == WORD+'hdr' and not header.attrib and len(header) == 1)
+        require(style(header[0]) == (None, None))
+        require(literal(header[0]) == paragraph_text(header[0]))
+
+    document = package.xml[MAIN]
+    body = package.body
+    require(list(document) == [body] and not document.attrib and not body.attrib and 4 <= len(body) <= 48)
+    for node in body.iter():
+        tag = node.tag.removeprefix(WORD)
+        require(all(child.tag in {WORD+name for name in BODY_CHILDREN.get(tag, '').split()} for child in node))
+        allowed = {WORD+name for name in BODY_ATTRIBUTES.get(tag, '').split()}
+        if tag in ('t', 'instrText'):
+            allowed.add(SPACE)
+        if tag in ('headerReference', 'footerReference'):
+            allowed.add(REL+'id')
+        require(set(node.attrib) <= allowed)
+        require(tag in ('t', 'instrText') or not (node.text or '').strip())
+    require(all(node.tag in (WORD+'p', WORD+'tbl') for node in list(body)[:-1]))
+    section = body[-1]
+    require(section.tag == WORD+'sectPr' and list(body.iter(WORD+'sectPr')) == [section])
+    stories = ('header', 'footer') if has_header else ('footer',)
+    references = [WORD+kind+'Reference' for kind in stories]
+    require([node.tag for node in section] ==
+            references+[WORD+tag for tag in ('pgSz', 'pgMar', 'cols', 'docGrid')])
+    physical_layout = [sorted(section.attrib.items()), [shape(node) for node in list(section)[len(stories):]]]
+    require(sha256(json.dumps(physical_layout, separators=(',', ':')).encode()).hexdigest() == SECTION_LAYOUT)
+    for kind, node in zip(stories, section):
+        require(not len(node) and node.attrib == {
+            WORD+'type': 'default', REL+'id': 'fridayReport'+kind.title(),
+        })
+        require(list(body.iter(node.tag)) == [node])
+
+    index = 1 if style(body[0]) == ('Title', None) else 0
+    label, toc = body[index:index+2]
+    require(style(label) == ('TOCHeading', None) and literal(label) == TITLE)
+    require(paragraph_text(label, 'TOCHeading') == TITLE)
+    require(toc.tag == WORD+'p' and not toc.attrib and len(toc) == 5)
+    require(all(run.tag == WORD+'r' and not run.attrib and len(run) == 1 for run in toc))
+    start, instr, separate, cache, end = (run[0] for run in toc)
+    for node, marker in zip((start, separate, end), ('begin', 'separate', 'end'), strict=True):
+        attributes = {WORD+'fldCharType': marker}
+        if marker == 'begin':
+            attributes[WORD+'dirty'] = 'true'
+        require(node.tag == WORD+'fldChar' and node.attrib == attributes and not len(node) and not node.text)
+    instruction = (instr.text or '').strip(' ')
+    require(instr.tag == WORD+'instrText' and instr.attrib == {SPACE: 'preserve'}
+            and not len(instr) and instruction in INSTRUCTIONS)
+    require(cache.tag == WORD+'t' and cache.attrib == {SPACE: 'preserve'}
+            and not len(cache) and cache.text == PENDING)
+    require({node for node in body.iter() if node.tag in FIELDS} == {start, instr, separate, end})
+
+    levels = INSTRUCTIONS[instruction]
+    headings = []
+    heading_nodes = set()
+    recognized = {label.find(WORD+'pPr/'+WORD+'pStyle')}
+    if index:
+        require(literal(body[0]) == paragraph_text(body[0], 'Title'))
+        recognized.add(body[0].find(WORD+'pPr/'+WORD+'pStyle'))
+    tables = 0
+    for paragraph in list(body)[index+2:-1]:
+        if paragraph.tag == WORD+'tbl':
+            tables += 1
+            require(tables == 1)
+            require_table(paragraph)
+            continue
+        name, outline = style(paragraph)
+        if name is None:
+            require(outline is None)
+            paragraph_text(paragraph)
+            continue
+        require(name in {f'Heading{level}' for level in range(1, levels+1)})
+        level = int(name[-1])
+        require(outline == str(level-1))
+        text = literal(paragraph)
+        require(paragraph_text(paragraph, name, level) == text)
+        headings.append((level, text))
+        heading_nodes.add(paragraph)
+        recognized.update(paragraph.find(WORD+'pPr'))
+    require({node for node in body.iter() if node.tag in {WORD+'pStyle', WORD+'outlineLvl'}} == recognized)
+    names = [' '.join(name.split()) for _, name in headings]
+    require(1 <= len(names) <= 8 and all(names) and len(set(names)) == len(names))
+    # The printed heading must not be imitated by a normal paragraph or table row.
+    def words(node):
+        return ' '.join(' '.join(t.text or '' for t in node.iter(WORD+'t')).split())
+    other = [words(node) for node in body.iter(WORD+'p') if node not in heading_nodes and node is not toc]
+    other += [words(row) for row in body.iter(WORD+'tr')]
+    if has_header:
+        other.append(words(package.xml[HEADER]))
+    require(not any(' '+name+' ' in ' '+value+' ' for name in names for value in other))
+    require(not any(name != peer and ' '+name+' ' in ' '+peer+' ' for name in names for peer in names))
+    # Match the existing footer anchor rule for this exact pinned Russian footer.
+    require(not any('страница' in ''.join(words(paragraph).split()).casefold()
+                    for part, root in package.xml.items() if part != FOOTER
+                    for paragraph in root.iter(WORD+'p')))
+    return TocProfile(levels, tuple(headings), package.xml[FOOTER])
