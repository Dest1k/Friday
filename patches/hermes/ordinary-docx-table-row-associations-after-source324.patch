+def _body_table_locations(body, parents, checkpoint):
+    """Locate physical cells of direct tables in the main Word body."""
+    table_tag, row_tag, cell_tag = (_q(W, name) for name in ('tbl', 'tr', 'tc'))
+    table_children = {row_tag, _q(W, 'tblPr'), _q(W, 'tblGrid')}
+    row_children = {cell_tag, _q(W, 'trPr'), _q(W, 'tblPrEx')}
+    locations = {}
+    for table_number, table in enumerate(body.iter(table_tag), 1):
+        _tick(checkpoint)
+        if parents[table] is not body or any(child.tag not in table_children for child in table):
+            continue
+        rows = table.findall(row_tag)
+        if any(child.tag not in row_children for row in rows for child in row):
+            continue
+        for row_number, row in enumerate(rows, 1):
+            for cell_number, cell in enumerate(row.iterfind(cell_tag), 1):
+                _tick(checkpoint)
+                locations[cell] = {'table': table_number, 'row': row_number, 'cell': cell_number}
+    return locations
+
+
+def _include_body_table_locations(view, rows, located_rows):
+    if not located_rows:
+        return view
+    header, separator, body_and_stories = view.partition('\n')
+    body_length = sum(map(len, rows)) + len(rows) - 1
+    body = '\n'.join(located_rows.get(index, row) for index, row in enumerate(rows))
+    expanded = header + separator + body + body_and_stories[body_length:]
+    # Optional locations share the original budget with body and story records.
+    if len(expanded.encode('utf-8')) > 900_000:
+        return view
+    return DocumentText(expanded, view.extraction_metadata)
+
+
