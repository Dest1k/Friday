+def _edit_eml_cc(data, spec, checkpoint):
+    old = _mailbox_item(spec['old_value'])
+    new = _mailbox_item(spec['new_value'])
+    if old == new:
+        _fail('no_op')
+    _read_eml(data, checkpoint)
+    try:
+        message = BytesParser(policy=policy.default).parsebytes(data)
+    except (MessageError, ValueError, TypeError, IndexError, RecursionError):
+        _fail('malformed_mime_headers')
+    if _eml_protected_target(message):
+        _fail('unsupported_contact_edit_target')
+    mailboxes = _cc_mailboxes(message)
+    matches = [index for index, value in enumerate(mailboxes) if value == old]
+    if not matches:
+        _fail('precondition_mismatch')
+    if len(matches) > 1:
+        _fail('cc_target_not_unique')
+    if new in mailboxes:
+        _fail('cc_target_not_unique')
+    revised = list(mailboxes)
+    revised[matches[0]] = new
+    match = _header_separator(data)
+    header = data[:match.start()]
+    lines = header.splitlines(keepends=True)
+    found = []
+    offset = 0
+    for index, line in enumerate(lines):
+        raw = line.rstrip(b'\r\n')
+        start, end = offset, offset + len(line)
+        offset = end
+        if raw.lower().startswith(b'cc:'):
+            last = index
+            while last + 1 < len(lines) and lines[last + 1][:1] in (b' ', b'\t'):
+                last += 1
+            found.append((start, start + len(b''.join(lines[index:last + 1])),
+                          lines[last][len(lines[last].rstrip(b'\r\n')):]))
+    if len(found) != 1:
+        _fail('cc_target_not_unique')
+    start, end, ending = found[0]
+    newline = '\r\n' if match.group().startswith(b'\r\n') else '\n'
+    try:
+        message_out = EmailMessage(policy=policy.SMTP.clone(linesep=newline))
+        message_out['Cc'] = ', '.join(
+            str(Address(display_name=name or None, addr_spec=address))
+            for name, address in revised)
+        folded = message_out['Cc'].fold(policy=policy.SMTP.clone(linesep=newline)).rstrip('\r\n').encode('ascii')
+    except (MessageError, ValueError, TypeError, UnicodeError, IndexError, RecursionError):
+        _fail('contact_roundtrip_changed')
+    output = data[:start] + folded + ending + data[end:]
+    if len(output) > MAX_BYTES:
+        _fail('output_limit')
+    _checkpoint(checkpoint)
+    parsed = BytesParser(policy=policy.default).parsebytes(output)
+    if _cc_mailboxes(parsed) != revised:
+        _fail('contact_roundtrip_changed')
+    _read_eml(output, checkpoint)
+    return output
+
