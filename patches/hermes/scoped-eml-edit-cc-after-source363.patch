+def _cc_mailboxes(message):
+    values = message.get_all('Cc', [])
+    if len(values) != 1 or message['Cc'] is None:
+        _fail('cc_target_not_unique')
+    raw_values = [value for name, value in message.raw_items() if name.lower() == 'cc']
+    if len(raw_values) != 1 or raw_values[0].rstrip().endswith(','):
+        _fail('invalid_address')
+    header = message['Cc']
+    if getattr(header, 'defects', ()):
+        _fail('invalid_address')
+    groups = header.groups
+    if not groups or any(group.display_name is not None for group in groups):
+        _fail('invalid_address')
+    mailboxes = []
+    for group in groups:
+        for address in group.addresses:
+            if not address.username or not address.domain:
+                _fail('invalid_address')
+            mailboxes.append((address.display_name, address.addr_spec))
+    return mailboxes
+
