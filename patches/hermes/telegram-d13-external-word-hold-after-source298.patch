+"""Host-only intent for a bounded external Word request. It grants no delivery."""
+from dataclasses import dataclass, field
+from hashlib import sha256
+import re
+import unicodedata
+
+
+# A direct imperative to create an external derivative in Word. Scope this
+# selector to the explicit form it supports, not subject mentions or instructions
+# obtained from attachments, quotes, restored prompts, or the model.
+_ACTION = re.compile(r"(?:(?:пожалуйста)[, ]+)?(?:сделай|подготовь|создай|составь|сформируй)\b")
+_DERIVATIVE = r"(?:сводк\w*|копи\w*|отч[её]т\w*)"
+_EXTERNAL = r"(?:внешн\w*|публичн\w*)"
+_SOURCE_PHRASE = (
+    r"(?:(?:по|из|на\s+основе)\s+"
+    r"(?:(?:приложенн\w*|исходн\w*|эт\w*|загруженн\w*)\s+)?"
+    r"(?:документ\w*|файл\w*|материал\w*)\s+)?"
+)
+_EXTERNAL_DERIVATIVE = re.compile(
+    rf"^{_SOURCE_PHRASE}(?:(?:отдельн\w*|нов\w*)\s+){{0,2}}"
+    rf"(?:{_EXTERNAL}\s+{_DERIVATIVE}|{_DERIVATIVE}\b[^,;.!?]{{0,80}}\bдля\s+{_EXTERNAL})\b"
+)
+_WORD = re.compile(r"\bв\s+(?:(?:новом|формате)\s+)?(?:docx|word)\b")
+_NEGATION = re.compile(r"\b(?:не|нельзя|запрещено)\b")
+_QUOTE_ENTITIES = {"blockquote", "expandable_blockquote", "code", "pre"}
+
+HOLD_REPLY = "Внешний DOCX не отправлен. Для выдачи нужно подтверждение готового файла."
+_INELIGIBLE = object()
+
+
+@dataclass(frozen=True)
+class _Request:
+    event_identity: int
+    raw: object = field(repr=False)
+    bot: object = field(repr=False)
+    ids: tuple[str, str, str, str, str]
+    text_sha256: str
+
+
+@dataclass(frozen=True)
+class ExternalWordIntent:
+    principal: tuple[str, str, str, str]
+    runtime_profile: str
+    admission_generation: int
+    session_key: str
+    run_generation: int
+    platform_update_id: str
+    message_id: str
+    chat_id: str
+    thread_id: str
+    request_sha256: str
+
+
+def _selects_word_copy(text):
+    if not isinstance(text, str) or not 0 < len(text) <= 4096:
+        return False
+    normalized = unicodedata.normalize("NFC", text).casefold().strip()
+    # Require the action, derivative, audience and format in one directive.
+    action = _ACTION.match(normalized)
+    if action is None:
+        return False
+    directive = re.split(r"[,.!?;\n]", normalized[action.end():], maxsplit=1)[0].strip()
+    return bool(_EXTERNAL_DERIVATIVE.match(directive) and _WORD.search(directive)
+                and not _NEGATION.search(directive))
+
+
+def _body(message):
+    # Read exactly one original SDK field. No event.text or secondary source.
+    if message.text is not None and message.caption is None:
+        return message.text, message.entities
+    if message.text is None and message.caption is not None:
+        return message.caption, message.caption_entities
+    return None, ()
+
+
+def _native_shape(message, entities):
+    return (message.chat.type == "private" and message.from_user is not None
+            and (message.text is not None or getattr(message, "document", None) is not None)
+            and getattr(message, "message_thread_id", None) is None
+            and all(not getattr(message, key, None) for key in (
+                "forward_origin", "forward_date", "forward_from", "forward_from_chat",
+                "forward_sender_name", "is_automatic_forward", "sender_chat", "via_bot",
+                "media_group_id", "business_connection_id",
+            ))
+            and not any(item.type in _QUOTE_ENTITIES for item in entities or ()))
+
+
+def mark_original_request(adapter, update, message, event):
+    """Only called by the registered Telegram handlers after their native gates."""
+    from plugins.platforms.telegram.telegram_ingress import _id
+
+    text, entities = _body(message)
+    if not _selects_word_copy(text):
+        return
+    # Recognized but unprovable input must not enter the ordinary output path.
+    event._external_word_request = _INELIGIBLE
+    event.allow_gateway_control = False
+    if (update.message is not message or event.raw_message is not message
+            or event.internal or event._ingress_merged or not _native_shape(message, entities)
+            or type(update.update_id) is not int or update.update_id <= 0
+            or event._ingress_update_id != update.update_id
+            or event.platform_update_id != update.update_id):
+        return
+    try:
+        bot = message.get_bot()
+        if bot is not adapter._bot:
+            return
+        chat_id, user_id, bot_id = _id(message.chat.id), _id(message.from_user.id), _id(bot.id)
+        if user_id != chat_id or user_id == bot_id:
+            return
+        ids = (bot_id, user_id, chat_id, _id(message.message_id), _id(update.update_id))
+    except (AttributeError, RuntimeError, TypeError, ValueError):
+        return
+    event._external_word_request = _Request(id(event), message, bot, ids, sha256(text.encode()).hexdigest())
+
+
+def is_external_word_request(event):
+    """Scheduling barrier only, including a recognized request without proof."""
+    marker = getattr(event, "_external_word_request", None)
+    return marker is _INELIGIBLE or type(marker) is _Request
+
+
+def bind_generation(runner, event, source, session_key, generation):
+    """Revalidate the exact process-local original inside native ordinary scope."""
+    from gateway.admitted_ingress import admitted_ingress
+    from gateway.session_identity import identity_of
+    from hermes_cli.friday_product_access import current_access
+    from hermes_cli.friday_user_scope import authority, current
+
+    request = getattr(event, "_external_word_request", None)
+    if (type(request) is not _Request or request.event_identity != id(event)
+            or event.internal or event._ingress_merged or event.allow_gateway_control
+            or getattr(event, "_d13_word_generation", None) is not None
+            or event.raw_message is not request.raw):
+        return None
+    text, entities = _body(request.raw)
+    if (not _selects_word_copy(text) or sha256(text.encode()).hexdigest() != request.text_sha256
+            or not _native_shape(request.raw, entities)):
+        return None
+    state = runner._peek_session_state(session_key)
+    if (state is None or state.turn.event is not event or type(generation) is not int or generation < 1
+            or state.persistent.run_generation != generation
+            or runner._session_key_for_source(source) != session_key):
+        return None
+    identity = identity_of(source)
+    transport = identity.adapter() if identity is not None and identity.multiplexed else None
+    owner = runner._transport_owner(source)
+    if transport is None or owner is None or owner[0] is not transport or transport._bot is not request.bot:
+        return None
+    ingress = admitted_ingress(event, source, session_key)
+    if ingress is None or ingress["platform"] != "telegram":
+        return None
+    native = ingress["message"]
+    if (tuple(native[k] for k in ("bot_id", "user_id", "chat_id", "message_id", "platform_update_id")) != request.ids
+            or native["thread_id"] != ""):
+        return None
+    cap = current(required=True)
+    principal = ("telegram", ingress["transport_profile"], native["bot_id"], native["user_id"])
+    if (getattr(source, "_friday_user_scope", None) is not cap or cap.principal != principal
+            or source.is_bot != request.raw.from_user.is_bot or cap.profile != ingress["runtime_profile"] or cap.authorization_home != identity.authorization_home):
+        return None
+    with authority(cap.authorization_home):
+        grant = current_access()["users"].get(cap.key)
+    if (grant is None or grant["enabled"] is not True or grant["role"] != "user"
+            or grant["generation"] != cap.admission_generation):
+        return None
+    result = ExternalWordIntent(principal, cap.profile, cap.admission_generation, session_key, generation,
+                                native["platform_update_id"], native["message_id"], native["chat_id"],
+                                native["thread_id"], request.text_sha256)
+    event._d13_word_generation = result
+    return result
