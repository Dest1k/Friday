+def _spans(raw, root, tag):
+    nodes = list(root.iter(tag)); spans = []; stack = []
+    parser = expat.ParserCreate(namespace_separator='}')
+    def start(name, attrs):
+        if name != tag[1:]:
+            return
+        offset = parser.CurrentByteIndex; quote = None
+        for end in range(offset, len(raw)):
+            c = raw[end]
+            if quote is not None:
+                if c == quote: quote = None
+            elif c in (34, 39): quote = c
+            elif c == 62: break
+        else: refuse('xml')
+        slot = len(spans); spans.append(None)
+        stack.append((slot, offset, end+1, raw[offset:end].rstrip().endswith(b'/')))
+    def end(name):
+        if name == tag[1:]:
+            slot, begin, opening_end, empty = stack.pop()
+            stop = parser.CurrentByteIndex if empty else raw.find(b'>', parser.CurrentByteIndex)+1
+            if stop < opening_end: refuse('xml')
+            spans[slot] = (begin, stop, opening_end, empty)
+    parser.StartElementHandler = start; parser.EndElementHandler = end
+    parser.Parse(raw, True)
+    if len(nodes) != len(spans): refuse('xml')
+    return dict(zip(nodes, spans))
