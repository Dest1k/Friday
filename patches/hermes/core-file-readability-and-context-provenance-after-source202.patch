+def _patch(raw, changes):
+    last = len(raw)
+    for begin, end, value in sorted(changes, reverse=True):
+        if not 0 <= begin <= end <= last: refuse('overlapping_change')
+        raw = raw[:begin] + value + raw[end:]; last = begin
+    _xml(raw)
+    return raw
