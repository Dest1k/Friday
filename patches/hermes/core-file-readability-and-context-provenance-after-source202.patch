+def _region(box, others, minimum_top, gap):
+    x, y, width, height = box
+    if width <= 0 or height <= 0: refuse('geometry')
+    bottom = y + height
+    upper = minimum_top
+    for ox, oy, ow, oh in others:
+        if ow <= 0 or oh <= 0: refuse('geometry')
+        if x < ox+ow and ox < x+width:
+            if oy > y: bottom = min(bottom, oy-gap)
+            elif oy+oh <= y: upper = max(upper, oy+oh+gap)
+            else: refuse('ambiguous_overlap')
+    if bottom <= y or upper > y: refuse('geometry')
+    return y, bottom, upper
