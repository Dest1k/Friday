+def fit_font(value, width, height, maximum=26, minimum=16, *, unicode_creation=False):
+    """Conservative Latin/Cyrillic profile: 1.1em columns, 1.3em lines.
+
+    Font substitution/shaping is not measured here. Actual app assessment is
+    required; unlike shape autofit this never silently selects < minimum pt.
+    """
+    if not value: refuse('text_profile')
+    bounded = not any(unicodedata.category(c).startswith('C') or
+                         unicodedata.combining(c) or
+                         not (c.isspace() or '\u0020' <= c <= '\u024f' or
+                              '\u0400' <= c <= '\u052f' or
+                              '\u2000' <= c <= '\u206f' and unicodedata.category(c).startswith('P') or c == '\u2116') for c in value)
+    if not bounded and not unicode_creation:
+        refuse('text_profile')
+    # Creation keeps all previously accepted Unicode literals. Unknown scripts,
+    # combining marks and wide glyphs consume two conservative logical cells;
+    # this is not a shaping or glyph-availability promise.
+    estimate = value if bounded else ''.join(c if c.isspace() else 'XX' for c in value)
+    for font in range(min(int(maximum), 96), minimum-1, -1):
+        columns = int(width / (font * 1.1))
+        if columns < 1:
+            continue
+        lines = textwrap.wrap(estimate, width=columns, expand_tabs=False,
+                              replace_whitespace=False, drop_whitespace=False,
+                              break_long_words=True, break_on_hyphens=False)
+        if len(lines) * font * 1.3 <= height:
+            return font
+    refuse('capacity')
+
