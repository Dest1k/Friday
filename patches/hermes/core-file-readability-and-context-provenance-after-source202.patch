+def _length(value):
+    match = re.fullmatch(r'([0-9]+(?:\.[0-9]+)?)(cm|mm|in|pt)', value or '')
+    if not match: refuse('geometry')
+    factors = {'cm': Decimal(72)/Decimal('2.54'), 'mm': Decimal(72)/Decimal('25.4'),
+               'in': Decimal(72), 'pt': Decimal(1)}
+    result = float(Decimal(match[1]) * factors[match[2]])
+    if not 0 <= result <= 4000: refuse('geometry')
+    return result
+
+
+def _cm(points):
+    return format(Decimal(str(points))*Decimal('2.54')/Decimal(72), '.6f') + 'cm'
+
