+# The parent-only OfficeArt output used by Calc on sheets without drawn
+# objects. Check the complete payload, including the global IDCL sequence
+# and each sheet's matching FDG and parent shape. Child drawings are refused.
+_CALC_DRAWING_KINDS = frozenset((0x00EB, 0x00EC))
+_CALC_DRAWING_DEFAULTS = bytes.fromhex(
+    '33000bf012000000bf0008000800810109000008c0014000000840001ef11000'
+    '00000d0000080c00000817000008f7000010')
+_CALC_PARENT_SHAPE = bytes.fromhex(
+    '0f0003f0300000000f0004f028000000010009f0100000000000000000000000'
+    '000000000000000002000af008000000')
+
+
+def _calc_drawing_group(sheet_count):
+    clusters = b''.join(struct.pack('<II', sheet_index, 1) for sheet_index in range(1, sheet_count + 1))
+    last_shape = sheet_count << 10
+    info = struct.pack('<4I', last_shape, sheet_count + 1, sheet_count, sheet_count) + clusters
+    content = struct.pack('<HHI', 0, 0xF006, len(info)) + info + _CALC_DRAWING_DEFAULTS
+    return struct.pack('<HHI', 0xF, 0xF000, len(content)) + content
+
+
+def _calc_sheet_drawing(sheet_index):
+    shape = sheet_index << 10
+    drawing_info = struct.pack('<HHIII', sheet_index << 4, 0xF008, 8, 1, shape)
+    content = drawing_info + _CALC_PARENT_SHAPE + struct.pack('<II', shape, 5)
+    return struct.pack('<HHI', 0xF, 0xF002, len(content)) + content
+
 
