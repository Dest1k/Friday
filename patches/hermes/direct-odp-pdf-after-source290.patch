+def _direct_pdf_settings(root):
+    """Accept scalar Impress settings and only the bank/profile palette paths."""
+    if root is None:
+        return
+    settings = root.findall(q(O, 'settings'))
+    if len(settings) != 1 or settings[0].attrib or (settings[0].text or '').strip():
+        raise PresentationRefused('odp_pdf_settings_profile')
+    name_key, type_key = q(_CONFIG, 'name'), q(_CONFIG, 'type')
+    configuration = 'ooo:configuration-settings'
+    view = 'ooo:view-settings'
+    profiles = {
+        view: {name: ('int', None) for name in _VIEW_INTS},
+        configuration: {
+            **{name: ('int', None) for name in _PRINT_INTS},
+            **{name: ('short', None) for name in _PRINT_SHORTS},
+            **{name: ('boolean', {'true', 'false'}) for name in _PRINT_BOOLS},
+            **{name: ('string', {'$(brandbaseurl)/share/palette%3B$(userpath)/config/standard.' + ext})
+               for name, ext in _PALETTE_EXTENSIONS.items()},
+            'PrinterName': ('string', {''}),
+            'PrinterSetup': ('base64Binary', {''}),
+            'PrinterIndependentLayout': ('string', {'low-resolution'}),
+        },
+    }
+    for section in settings[0]:
+        profile = profiles.pop(section.get(name_key), None)
+        if (section.tag != q(_CONFIG, 'config-item-set') or set(section.attrib) != {name_key}
+                or profile is None or (section.text or '').strip() or (section.tail or '').strip()):
+            raise PresentationRefused('odp_pdf_settings_profile')
+        for item in section:
+            spec = profile.pop(item.get(name_key), None)
+            if (item.tag != q(_CONFIG, 'config-item') or set(item.attrib) != {name_key, type_key}
+                    or len(item) or (item.tail or '').strip() or spec is None):
+                raise PresentationRefused('odp_pdf_settings_profile')
+            kind, allowed = spec
+            value = item.text or ''
+            if item.get(type_key) != kind:
+                raise PresentationRefused('odp_pdf_settings_profile')
+            if allowed is not None:
+                valid = value in allowed
+            else:
+                limit = 2 ** (15 if kind == 'short' else 31)
+                valid = re.fullmatch(r'-?[0-9]{1,10}', value) and -limit <= int(value) < limit
+            if not valid:
+                raise PresentationRefused('odp_pdf_settings_value')
+
+
+def direct_pdf_page_count(data):
+    """Admit the closed profile and return its count of visible source slides."""
+    try:
+        infos, parts = source_parts(data)
+        pkg = Package(data)
+        objects, slides = _closed_parts(data, pkg, infos, parts)
+    except PresentationError as error:
+        raise PresentationRefused(str(error)) from None
+
+    _direct_pdf_settings(pkg.xml.get('settings.xml'))
+    directories = {'Configurations2/'} | {name + '/' for name in objects}
+    if any(info.is_dir() and (info.file_size or info.filename not in directories) for info in infos):
+        raise PresentationRefused('odp_pdf_directory_profile')
+    chart_documents = {obj + '/content.xml' for obj in objects}
+    for member in chart_documents:
+        declarations = [pair for _, pair in ET.iterparse(BytesIO(parts[member]), events=('start-ns',))]
+        if ('chart', _CHART) not in declarations or any(
+                prefix == 'chart' and namespace != _CHART for prefix, namespace in declarations):
+            raise PresentationRefused('odp_pdf_chart_namespace')
+
+    content = pkg.xml['content.xml']
+    source_pages = set(content.findall('./' + q(O, 'body') + '/' + q(O, 'presentation') + '/' + q(DR, 'page')))
+    for name, root in pkg.xml.items():
+        for node in root.iter():
+            if (node.tag in (q(O, 'forms'), q(O, 'document'), q(DR, 'floating-frame'),
+                              q(PR, 'animations'))
+                    or node.tag.startswith(_ACTIVE_NAMESPACES)
+                    or any(key.startswith(_ACTIVE_NAMESPACES) for key in node.attrib)
+                    or _XML_BASE in node.attrib):
+                raise PresentationRefused('odp_pdf_active_context')
+            if node.tag in (q(DR, 'object'), q(DR, 'image')) and not node.get(q(XL, 'href')):
+                raise PresentationRefused('odp_pdf_inline_resource')
+            for key, value in node.attrib.items():
+                local = key.rsplit('}', 1)[-1]
+                if local in ('add-in-name', 'data-pilot-source'):
+                    raise PresentationRefused('odp_pdf_chart_provider')
+                if key == q(_CHART, 'class'):
+                    passive_class = {q(_CHART, 'chart'): 'chart:bar',
+                                     q(_CHART, 'series'): 'chart:bar',
+                                     q(_CHART, 'grid'): 'major'}
+                    if name not in chart_documents or value != passive_class.get(node.tag):
+                        raise PresentationRefused('odp_pdf_chart_class')
+                if local == 'external-data':
+                    # The stock importer records the embedded XLSX path as
+                    # chart-style provenance. No loader URL is allowed.
+                    if (key != q(_LO, 'external-data') or name not in chart_documents
+                            or node.tag != q(_STYLE, 'chart-properties')
+                            or re.fullmatch(r'ppt/embeddings/[A-Za-z0-9_ -]{1,72}\.xlsx', value) is None):
+                        raise PresentationRefused('odp_pdf_external_data')
+                if local == 'visibility':
+                    drawing_page_style = (name in ('content.xml', 'styles.xml')
+                                          and node.tag == q(_STYLE, 'drawing-page-properties'))
+                    if (key != q(PR, 'visibility') or value != 'visible'
+                            or (node not in source_pages and not drawing_page_style)):
+                        raise PresentationRefused('odp_pdf_slide_visibility')
+    return len(slides)
