+++ b/gateway/s14_pair_custody.py
@@ -0,0 +1,195 @@
+"""Selected ordinary S14 pair evidence from the exact gateway output writer."""
+
+from __future__ import annotations
+
+import asyncio
+from copy import deepcopy
+from dataclasses import dataclass, field
+from hashlib import sha256
+import re
+
+
+_SCENARIO = "e686e76c9d251bdda7e84056111c59c227b1489ffecf1a60142a21fb27fb546d"
+_NAMES = {"S14-Alder-Report.txt", "S14-Alder-Report.pdf"}
+
+
+@dataclass
+class _Selection:
+    run_id: str
+    pair: _Pair | None = None
+    refused: bool = False
+
+
+@dataclass
+class _Pair:
+    evidence: object
+    selection: _Selection
+    update: int
+    record: object
+    source: object
+    runner: object
+    cap: object
+    route: dict
+    run: tuple
+    answer: tuple
+    answer_id: str
+    candidate_sha256: dict = field(default_factory=dict)
+    message_ids: set = field(default_factory=set)
+
+
+def enable(ingress, claim_sha256, scenario_sha256, run_id):
+    """Bind the protected receiver's case before SDK capture. Carry no send authority."""
+    wire = ingress._wire()
+    if (claim_sha256 != ingress.claim.claim_sha256 or scenario_sha256 != _SCENARIO
+            or type(run_id) is not str or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", run_id)
+            or ingress._s14_output is not None or ingress._built or wire is None
+            or wire["state"] != "OPEN" or wire["target_update_ids"]):
+        raise ValueError("Selected S14 pair admission is unavailable")
+    ingress._s14_output = _Selection(run_id)
+
+
+def begin(adapter, source, paths, caption, authority):
+    """Bind exactly one two-document batch on the original SDK writer."""
+    from gateway.ordinary_dm_ingress import _ingress
+    from gateway.session_identity import identity_of
+    from hermes_cli.friday_native_state import encoded
+
+    evidence = _ingress(adapter)
+    selection = getattr(evidence, "_s14_output", None)
+    if selection is None or source is not evidence._receipt_source:
+        return None
+    if selection.refused or selection.pair is not None or len(paths) != 2 or caption is not None:
+        selection.refused = True
+        return None
+    try:
+        wire = evidence._wire()
+        if wire is None or len(wire["target_update_ids"]) != 1:
+            raise ValueError("Selected S14 wire update required")
+        update, = wire["target_update_ids"]
+        record = evidence._built[update]
+        event = record.event_ref()
+        cap, runner, _, route, _ = authority(adapter, source)
+        run = source._friday_document_run
+        answer = source._friday_document_turn
+        key = evidence.scope["session_key"]
+        session_id = source._friday_document_session_id
+        if (event is None or update not in evidence._commits
+                or evidence.select(event, source, identity_of(source), key) != update
+                or record.writer_task is None or record.writer_task() is not asyncio.current_task()
+                or record.settled or run[0] != key or type(session_id) is not str or not session_id
+                or type(answer) is not tuple or len(answer) != 2
+                or answer[0] != key or type(answer[1]) is not str or not answer[1]
+                or getattr(event, "_gateway_active_turn_session_key", None) != key
+                or getattr(event, "_gateway_active_turn_token", None) != answer[1]):
+            raise ValueError("Selected S14 writer or answer changed")
+        answer_id = sha256(encoded(["friday.s14.answer.v1", selection.run_id, update,
+                                   run[1], session_id, answer])).hexdigest()
+        selection.pair = _Pair(evidence, selection, update, record, source, runner, cap,
+                               route, run, answer, answer_id)
+        return selection.pair
+    except Exception:
+        selection.refused = True
+        return None
+
+
+def record_candidate(pair, source, receipt, native_candidate, check):
+    """Observe native DELIVERED only after the CAS and transcript both complete."""
+    if pair.selection.refused:
+        return
+    try:
+        name = receipt["file_name"]
+        message_id = receipt["message_id"]
+        wire = pair.evidence._wire()
+        if (wire is None or tuple(wire["target_update_ids"]) != (pair.update,)
+                or source is not pair.source or source._friday_document_run is not pair.run
+                or source._friday_document_turn is not pair.answer
+                or pair.record.writer_task is None or pair.record.writer_task() is not asyncio.current_task()
+                or pair.record.settled or pair.runner is not pair.evidence.adapter.gateway_runner
+                or name not in _NAMES or name in pair.candidate_sha256
+                or type(message_id) is not str or not re.fullmatch(r"[1-9][0-9]*", message_id)
+                or message_id in pair.message_ids
+                or receipt["state"] != "DELIVERED" or receipt["kind"] != "document"
+                or (receipt["bot_id"], receipt["chat_id"], receipt["thread_id"], receipt["reply_to"])
+                != (pair.route["bot_id"], pair.route["source"]["chat_id"],
+                    pair.route["source"]["thread_id"], pair.route["source"]["message_id"])):
+            raise ValueError("Selected S14 candidate or owner changed")
+        check()
+        pair.candidate_sha256[name] = sha256(native_candidate).hexdigest()
+        pair.message_ids.add(message_id)
+    except Exception:
+        pair.selection.refused = True
+
+
+def read_settled(ingress, claim_sha256):
+    """Project joined native candidate pins to the protected terminal reader."""
+    selection = ingress._s14_output
+    if (selection is None or selection.refused or selection.pair is None
+            or claim_sha256 != ingress.claim.claim_sha256 or ingress._settlement_state() != "SETTLED"):
+        return None
+    from hermes_cli.friday_user_scope import _CURRENT, authority
+
+    pair = selection.pair
+    wire = ingress._wire()
+    cap = pair.cap
+    ambient = _CURRENT.get()
+    if (wire is None or tuple(wire["target_update_ids"]) != (pair.update,)
+            or pair.record is not ingress._built.get(pair.update) or not pair.record.settled
+            or pair.runner is not ingress.adapter.gateway_runner
+            or not pair.runner._is_session_run_current(*pair.run)
+            or pair.candidate_sha256.keys() != _NAMES
+            or (ambient is not None and ambient is not cap)
+            or str(cap.home) != ingress.scope["runtime_home"]
+            or str(cap.authorization_home) != ingress.scope["authorization_home"]
+            or cap.profile != ingress.scope["runtime_profile"]):
+        return None
+    try:
+        with authority(cap.home):
+            cap.check()
+    except Exception:
+        return None
+    if (ingress._wire() != wire or pair.runner is not ingress.adapter.gateway_runner
+            or not pair.runner._is_session_run_current(*pair.run)):
+        return None
+    return {"scenario_sha256": _SCENARIO, "run_id": selection.run_id, "generation": pair.run[1],
+            "answer_id": pair.answer_id, "route": deepcopy(pair.route), "candidate_sha256": dict(pair.candidate_sha256)}
+
+
+def enable_terminal(ingress, claim_sha256, scenario_sha256, run_id):
+    """Arm the selected observation leaves together before input capture."""
+    try:
+        ingress._enable_selected_xlsx(claim_sha256, scenario_sha256)
+        enable(ingress, claim_sha256, scenario_sha256, run_id)
+    except Exception:
+        ingress.lost("s14_exact_input_and_output_selection_not_armed")
+        raise
+
+
+def read_terminal(ingress, claim_sha256):
+    """Compose the original admitted input and same-answer pair for protected FINALIZE."""
+    if claim_sha256 != ingress.claim.claim_sha256:
+        return None
+    wire = ingress._wire()
+    if wire is None or len(wire["target_update_ids"]) != 1:
+        return None
+    output = read_settled(ingress, claim_sha256)
+    if output is None:
+        return None
+    source_input = ingress._read_settled_xlsx(claim_sha256, expected_wire=wire)
+    if source_input is None:
+        return None
+    update, = wire["target_update_ids"]
+    sdk = source_input["sdk"]
+    pair = ingress._s14_output.pair
+    document = pair.record.xlsx_turn
+    route = output["route"]
+    source = route["source"]
+    if (document is None or document.runner is not pair.runner or document.scope is not pair.cap
+            or source_input["scenario_sha256"] != output["scenario_sha256"]
+            or source_input["turn_generation"] != output["generation"]
+            or source_input["session_id"] != pair.source._friday_document_session_id
+            or source_input["session_key"] != pair.run[0] or sdk["update_id"] != str(update)
+            or sdk["native_message_id"] != source["message_id"] or sdk["bot_id"] != route["bot_id"]
+            or sdk["actor_id"] != source["user_id"] or sdk["actor_id"] != source["chat_id"]):
+        return None
+    return {"schema": "friday.s14.native-typed-input-owned-pair.v1", "run_id": output["run_id"],
+            "claim_sha256": claim_sha256, "input": source_input, "output": output}
