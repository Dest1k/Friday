diff --git a/tools/scoped_xlsx_turn.py b/tools/scoped_xlsx_turn.py
new file mode 100644
--- /dev/null
+++ b/tools/scoped_xlsx_turn.py
@@ -0,0 +1,169 @@
+"""Protected host observations of the exact selected native Alder read."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from hashlib import sha256
+import json
+from threading import Lock
+
+SCENARIO_SHA256 = "e686e76c9d251bdda7e84056111c59c227b1489ffecf1a60142a21fb27fb546d"
+SOURCE_SHA256 = "689808642856d0b880cb0556e313fa0dd69db9f3845a77f5b33d5999798a5853"
+CAPTION_SHA256 = "fba4fb0b3e0dab4e9952b4b0bd7a66a4e34ad3c66798f895933121e759168fe5"
+SOURCE_BYTES = 2335
+SOURCE_NAME = "S14-Alder-Orders-r02.xlsx"
+SOURCE_MIME = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
+TYPED_CELLS = 35
+_TURN = ContextVar("s14_xlsx_turn", default=None)
+
+
+def _call_identity(call):
+    return call.task_id, call.call_id, call.session_id, call.session_key, call.turn_id
+
+
+def _owned_call(call, agent):
+    from agent.web_call_context import _current, same_web_authority
+    from tools.approval_context import get_current_session_key
+
+    if agent is None:
+        return False
+    session_id = getattr(agent, "session_id", "")
+    if (_current.get() is not call or getattr(call, "agent", None) is not agent
+            or call.session_id != session_id
+            or call.session_key != (get_current_session_key(default="") or session_id)
+            or call.turn_id != getattr(agent, "_current_turn_id", "")
+            or call.run_deadline != getattr(agent, "_web_run_deadline", None)
+            or call.turn is not getattr(agent, "_web_turn", None)
+            or getattr(agent, "_tool_result_calls", {}).get((call.task_id, call.call_id)) is not call
+            or getattr(agent, "_tool_result_call_stamp", None) != (call.session_id, call.turn_id, call.run_deadline)
+            or not all(type(value) is str and value for value in _call_identity(call))
+            or getattr(agent, "_interrupt_requested", False)
+            or getattr(agent, "_friday_reply_effect_unknown", False)
+            or call.turn.failure is not None or not same_web_authority(call)):
+        return False
+    try:
+        call.check()
+    except (RuntimeError, TimeoutError):
+        return False
+    return True
+
+
+class _SelectedRead:
+    def __init__(self, marker, session_id, session_key, cap, published):
+        self.marker = marker
+        self.session = session_id, session_key
+        self.cap = cap
+        self.published = published
+        self.path = published.path.relative_to(cap.home / "workspace").as_posix()
+        self.lock = Lock()
+        self.attempt = None
+        self.pending = None
+        self.terminal = None
+        self.closed = False
+        self.invalid = False
+
+    def read_settled(self, marker):
+        with self.lock:
+            if marker is not self.marker or not self.closed or self.invalid or self.terminal is None:
+                return None
+            return dict(self.terminal)
+
+
+@contextmanager
+def observe_xlsx_turn(marker, session_id, session_key, cap, published):
+    """Carry the selected event's read evidence through the existing worker context."""
+    witness = _SelectedRead(marker, session_id, session_key, cap, published)
+    token = _TURN.set(witness)
+    completed = False
+    try:
+        yield witness
+        completed = True
+    finally:
+        _TURN.reset(token)
+        with witness.lock:
+            witness.attempt = witness.pending = None
+            witness.invalid |= not completed
+            witness.closed = True
+
+
+def start_selected_xlsx_read(cap, path, task_id, pagination):
+    from agent.web_call_context import _current
+
+    witness = _TURN.get()
+    if witness is None or path != witness.path:
+        return None
+    call = _current.get()
+    if call is None:
+        return None
+    with call.turn.lock, witness.lock:
+        if (witness.invalid or witness.closed or witness.attempt is not None
+                or cap is not witness.cap or task_id != call.task_id
+                or witness.session != (call.session_id, call.session_key)
+                or pagination[0] != 1 or pagination[2] != 0
+                or not _owned_call(call, getattr(call, "agent", None))):
+            witness.invalid = True
+            return None
+        witness.attempt = call
+        call._s14_xlsx_pending = witness
+        return call
+
+
+def note_selected_xlsx_read(call, snapshot, result, rendered):
+    witness = _TURN.get()
+    if witness is None:
+        return
+    with call.turn.lock, witness.lock:
+        if (witness.invalid or witness.closed or witness.attempt is not call
+                or not _owned_call(call, getattr(call, "agent", None))):
+            return
+        data, path, identity = snapshot
+        published = witness.published
+        metadata = result.get("extraction") or {}
+        cells = metadata.get("cell_records") or {}
+        if (path != witness.path or identity != published.source_identity
+                or len(data) != published.size_bytes or sha256(data).hexdigest() != published.sha256
+                or result.get("success") is not True or result.get("partial") is not False
+                or result.get("format") != "xlsx" or result.get("scope") != "own_user_workspace"
+                or result.get("extracted_document") is not True or result.get("path") != path
+                or result.get("source_sha256") != published.sha256
+                or metadata.get("native_container") is not True or metadata.get("unsupported") != []
+                or cells.get("included_records") != TYPED_CELLS
+                or cells.get("observed_cells") != TYPED_CELLS or cells.get("truncated") is not False
+                or any(cells.get(key) != 0 for key in (
+                    "rows_omitted_by_preview_limit", "cells_omitted_by_column_limit",
+                    "records_with_truncated_fields", "unresolved_literal_records", "omitted_records"))
+                or result.get("next_char_offset") != 0
+                or result.get("next_offset") != result.get("total_lines", 0) + 1
+                or not result.get("content")):
+            witness.invalid = True
+            return
+        witness.pending = sha256(rendered.encode("utf-8")).hexdigest()
+
+
+def _accept_xlsx_turn_result(agent, ref, function_result, persisted_result):
+    """Seal the exact canonical managed result after the original tool row flush."""
+    from agent.web_call_context import _current
+
+    witness = _TURN.get()
+    call = _current.get()
+    if witness is None or call is None:
+        return
+    with call.turn.lock, witness.lock:
+        if (witness.invalid or witness.closed or witness.attempt is not call
+                or (call.task_id, call.call_id) != (ref.task_id, ref.call_id)
+                or not _owned_call(call, agent)):
+            return
+        if (witness.terminal is not None or witness.pending is None
+                or type(function_result) is not str or len(function_result) > 100000
+                or persisted_result != function_result
+                or sha256(function_result.encode("utf-8")).hexdigest() != witness.pending):
+            witness.invalid = True
+            return
+        call_pin = json.dumps(_call_identity(call), ensure_ascii=True, separators=(",", ":")).encode()
+        published = witness.published
+        witness.terminal = {
+            "scenario_sha256": SCENARIO_SHA256,
+            "session_id": call.session_id, "session_key": call.session_key, "turn_id": call.turn_id,
+            "source_sha256": published.sha256, "source_bytes": published.size_bytes,
+            "sealed_webcall_sha256": sha256(call_pin).hexdigest(),
+            "managed_result_sha256": witness.pending, "typed_cells": TYPED_CELLS,
+        }
