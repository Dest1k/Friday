+_FONT_LIMIT = 4_000_000
+
+
+def _font_identity(info):
+    # UID and GID are validated in the host namespace. Their mapped values in
+    # the confined parser neither identify the donor nor establish trust.
+    return (info.st_dev, info.st_ino, info.st_mode, info.st_nlink, info.st_size,
+            info.st_mtime_ns, info.st_ctime_ns)
+
+
+def _font_bytes_checked(fd, parent, leaf, digest, expected, *, host):
+    before = os.fstat(fd)
+    identity = _font_identity(before)
+    if (identity != expected or not stat.S_ISREG(before.st_mode)
+            or before.st_nlink != 1 or before.st_mode & 0o022
+            or not 0 < before.st_size <= _FONT_LIMIT
+            or host and (before.st_uid, before.st_gid) != (0, 0)):
+        raise ValueError('pdf_trusted_font_identity')
+    data = bytearray()
+    while len(data) <= before.st_size:
+        chunk = os.read(fd, min(65536, before.st_size + 1 - len(data)))
+        if not chunk:
+            break
+        data.extend(chunk)
+    after = os.fstat(fd)
+    named = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
+    if (len(data) != before.st_size or identity != _font_identity(after)
+            or identity != _font_identity(named)
+            or host and (after.st_uid, after.st_gid, named.st_uid, named.st_gid) != (0, 0, 0, 0)):
+        raise ValueError('pdf_trusted_font_identity')
+    if hashlib.sha256(data).hexdigest() != digest:
+        raise ValueError('pdf_trusted_font_digest')
+    return bytes(data)
+
+
+def _open_host_font(path, digest):
+    if (type(path) is not str or path not in TRUSTED_FONTS
+            or TRUSTED_FONTS[path] != digest or not path.startswith('/usr/share/fonts/')):
+        raise ValueError('pdf_trusted_font_path')
+    path = Path(path)
+    if '..' in path.parts:
+        raise ValueError('pdf_trusted_font_path')
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    with contextlib.ExitStack() as directories:
+        parent = os.open('/', flags)
+        directories.callback(os.close, parent)
+        for part in (*path.parts[1:-1], None):
+            info = os.fstat(parent)
+            if (info.st_uid, info.st_gid) != (0, 0) or info.st_mode & 0o022:
+                raise ValueError('pdf_trusted_font_path')
+            if part is not None:
+                parent = os.open(part, flags, dir_fd=parent)
+                directories.callback(os.close, parent)
+        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        try:
+            identity = _font_identity(os.fstat(fd))
+            _font_bytes_checked(fd, parent, path.name, digest, identity, host=True)
+        except BaseException:
+            os.close(fd)
+            raise
+    return fd, identity
+
+
+def _calc_mount_readonly(fd, destination):
+    with open(f'/proc/self/fdinfo/{fd}', 'rb') as stream:
+        info = stream.read(4097)
+    ids = re.findall(rb'^mnt_id:[ \t]+([0-9]+)$', info, re.M)
+    if len(info) > 4096 or len(ids) != 1:
+        raise ValueError('pdf_calc_print_mount')
+    with open('/proc/self/mountinfo', 'rb') as stream:
+        mountinfo = stream.read(1_048_577)
+    if len(mountinfo) > 1_048_576:
+        raise ValueError('pdf_calc_print_mount')
+    matches = [line.split() for line in mountinfo.splitlines() if line.split(maxsplit=1)[:1] == ids]
+    if (len(matches) != 1 or len(matches[0]) < 6 or matches[0][4] != os.fsencode(destination)
+            or b'ro' not in matches[0][5].split(b',') or b'rw' in matches[0][5].split(b',')
+            or not os.fstatvfs(fd).f_flag & os.ST_RDONLY):
+        raise ValueError('pdf_calc_print_mount')
+
+
+def _calc_font_bytes(identity):
+    parent = os.open(_CALC_FONT_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        leaf = f'{_CALC_FONT_INDEX}.ttf'
+        fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        try:
+            _calc_mount_readonly(fd, _CALC_FONT_MOUNT)
+            return _font_bytes_checked(fd, parent, leaf, TRUSTED_FONTS[_CALC_FONT], tuple(identity), host=False)
+        finally:
+            os.close(fd)
+    finally:
+        os.close(parent)
+
+
+def _calc_mounted_bytes(destination, limit):
+    fd = os.open(destination, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, 'rb') as stream:
+        _calc_mount_readonly(fd, destination)
+        before = _font_identity(os.fstat(fd))
+        data = stream.read(limit + 1)
+        _, _, mode, links, size, _, _ = before
+        if (not stat.S_ISREG(mode) or links != 1 or mode & 0o077 or
+                not 0 < len(data) <= limit or len(data) != size or
+                before != _font_identity(os.fstat(fd)) or
+                before != _font_identity(os.stat(destination, follow_symlinks=False))):
+            raise ValueError('pdf_calc_print_input')
+        return data
+
+
+def _calc_child_receipt(operation, encoded):
+    if operation != 'xlsx_pdf' or not 0 < len(encoded) <= 512:
+        raise ValueError('pdf_calc_print_receipt')
+    receipt = json.loads(encoded, object_pairs_hook=_unique_receipt_fields)
+    fields = ('source_sha256', 'render_input_sha256')
+    if (type(receipt) is not dict or set(receipt) != {*fields, 'font_identity'} or
+            any(type(receipt[key]) is not str or re.fullmatch('[0-9a-f]{64}', receipt[key]) is None
+                for key in fields) or receipt['source_sha256'] == receipt['render_input_sha256']):
+        raise ValueError('pdf_calc_print_receipt')
+    identity = receipt['font_identity']
+    if (type(identity) is not list or len(identity) != 7 or
+            any(type(value) is not int or not 0 <= value < 1 << 64 for value in identity)):
+        raise ValueError('pdf_calc_print_receipt')
+    return receipt
+
