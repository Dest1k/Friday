+"""Private print-layout derivative for the current minimal XLSX producer shape."""
+
+from copy import copy
+from io import BytesIO
+import re
+from struct import error as StructError
+from xml.etree import ElementTree as ET
+from zipfile import BadZipFile, ZIP_DEFLATED, ZIP_STORED, ZipFile, ZipInfo
+from zlib import error as ZlibError
+
+
+class ProjectionUnsupported(ValueError):
+    """The original workbook is outside the admitted print projection shape."""
+
+
+_SPREADSHEET = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
+_OFFICE_RELS = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
+_PACKAGE_RELS = "http://schemas.openxmlformats.org/package/2006/relationships"
+_CONTENT_TYPES = "http://schemas.openxmlformats.org/package/2006/content-types"
+_SPREADSHEET_TYPE = "application/vnd.openxmlformats-officedocument.spreadsheetml"
+_XML_SPACE = "{http://www.w3.org/XML/1998/namespace}space"
+_WORKBOOK = "xl/workbook.xml"
+_SHEET = "xl/worksheets/sheet1.xml"
+_STYLES = "xl/styles.xml"
+_PLAIN_TEXT = re.compile(r"[A-Za-zА-Яа-яЁё0-9]+(?: [A-Za-zА-Яа-яЁё0-9]+)*")
+
+# These are the actual minimal producer descriptors and empty Normal style.
+# XML prefixes, attribute order and formatting whitespace may vary.
+_BASE_PARTS = {
+    "[Content_Types].xml": f"""
+        <Types xmlns="{_CONTENT_TYPES}">
+          <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
+          <Default Extension="xml" ContentType="application/xml"/>
+          <Override PartName="/xl/workbook.xml" ContentType="{_SPREADSHEET_TYPE}.sheet.main+xml"/>
+          <Override PartName="/xl/styles.xml" ContentType="{_SPREADSHEET_TYPE}.styles+xml"/>
+          <Override PartName="/xl/worksheets/sheet1.xml" ContentType="{_SPREADSHEET_TYPE}.worksheet+xml"/>
+        </Types>""",
+    "_rels/.rels": f"""
+        <Relationships xmlns="{_PACKAGE_RELS}">
+          <Relationship Id="rId1" Type="{_OFFICE_RELS}/officeDocument" Target="xl/workbook.xml"/>
+        </Relationships>""",
+    _WORKBOOK: f"""
+        <workbook xmlns="{_SPREADSHEET}" xmlns:r="{_OFFICE_RELS}">
+          <sheets><sheet r:id="rId1" name="Data" sheetId="1"/></sheets>
+        </workbook>""",
+    "xl/_rels/workbook.xml.rels": f"""
+        <Relationships xmlns="{_PACKAGE_RELS}">
+          <Relationship Id="rId1" Type="{_OFFICE_RELS}/worksheet" Target="worksheets/sheet1.xml"/>
+          <Relationship Id="styles" Type="{_OFFICE_RELS}/styles" Target="styles.xml"/>
+        </Relationships>""",
+    _STYLES: f"""
+        <styleSheet xmlns="{_SPREADSHEET}">
+          <numFmts count="0"/>
+          <fonts count="1"><font/></fonts>
+          <fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills>
+          <borders count="1"><border/></borders>
+          <cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>
+          <cellXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/></cellXfs>
+          <cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles>
+        </styleSheet>""",
+}
+_PART_NAMES = {*_BASE_PARTS, _SHEET}
+
+
+class _PlainXML(ET.TreeBuilder):
+    def doctype(self, name, pubid, system):
+        raise ProjectionUnsupported("XML document type declaration")
+
+    def comment(self, text):
+        raise ProjectionUnsupported("XML comment")
+
+    def pi(self, target, text):
+        raise ProjectionUnsupported("XML processing instruction")
+
+
+def _parse(data: bytes) -> ET.Element:
+    # Require the producer's text encoding before parsing it.
+    try:
+        data.decode("utf-8")
+        parser = ET.XMLParser(encoding="utf-8", target=_PlainXML())
+        return ET.fromstring(data, parser=parser)
+    except (ET.ParseError, UnicodeError) as error:
+        raise ProjectionUnsupported("malformed XLSX XML") from error
+
+
+def _has_no_text(text: str | None) -> bool:
+    return not (text or "").strip(" \t\r\n")
+
+
+def _same_shape(actual: ET.Element, expected: ET.Element) -> bool:
+    return (
+        actual.tag == expected.tag
+        and actual.attrib == expected.attrib
+        and _has_no_text(actual.text)
+        and _has_no_text(actual.tail)
+        and len(actual) == len(expected)
+        and all(_same_shape(a, e) for a, e in zip(actual, expected))
+    )
+
+
+def _tag(name: str) -> str:
+    return f"{{{_SPREADSHEET}}}{name}"
+
+
+def _expect(
+    element: ET.Element, name: str, attrib: dict[str, str], children: int,
+) -> None:
+    if (
+        element.tag != _tag(name)
+        or element.attrib != attrib
+        or len(element) != children
+        or not _has_no_text(element.tail)
+        or (name != "t" and not _has_no_text(element.text))
+    ):
+        raise ProjectionUnsupported(f"unexpected worksheet {name} structure")
+
+
+def _check_sheet(sheet: ET.Element) -> None:
+    _expect(sheet, "worksheet", {}, 1)
+    sheet_data = sheet[0]
+    _expect(sheet_data, "sheetData", {}, 3)
+    for row_number, row in enumerate(sheet_data, 1):
+        _expect(row, "row", {"r": str(row_number)}, 2)
+        for column, cell in zip("AB", row):
+            _expect(cell, "c", {"r": f"{column}{row_number}", "t": "inlineStr"}, 1)
+            _expect(cell[0], "is", {}, 1)
+            inline_text = cell[0][0]
+            _expect(inline_text, "t", {_XML_SPACE: "preserve"}, 0)
+            text = inline_text.text or ""
+            if len(text) > 12 or not _PLAIN_TEXT.fullmatch(text):
+                raise ProjectionUnsupported("inline text outside the print layout bound")
+
+
+def _project_sheet(sheet: ET.Element) -> bytes:
+    sheet_data = sheet[0]
+    settings = ET.Element(_tag("sheetPr"))
+    ET.SubElement(settings, _tag("pageSetUpPr"), fitToPage="0")
+    sheet.insert(0, settings)
+
+    columns = ET.Element(_tag("cols"))
+    ET.SubElement(columns, _tag("col"), min="1", max="2", width="32", customWidth="1")
+    sheet.insert(1, columns)
+    for row in sheet_data:
+        row.attrib.update(ht="42", customHeight="1")
+        for cell in row:
+            cell.set("s", "1")
+
+    ET.SubElement(
+        sheet, _tag("pageMargins"),
+        left="0.7", right="0.7", top="0.75", bottom="0.75", header="0.3", footer="0.3",
+    )
+    ET.SubElement(sheet, _tag("pageSetup"), paperSize="9", orientation="portrait", scale="100")
+    return ET.tostring(sheet, encoding="utf-8", xml_declaration=True)
+
+
+def _project_styles(styles: ET.Element) -> bytes:
+    normal_font = styles.find(_tag("fonts"))[0]
+    ET.SubElement(normal_font, _tag("sz"), val="11")
+    ET.SubElement(normal_font, _tag("color"), rgb="FF000000")
+    ET.SubElement(normal_font, _tag("name"), val="Noto Sans")
+
+    cell_formats = styles.find(_tag("cellXfs"))
+    cell_formats.set("count", "2")
+    centered_format = ET.SubElement(
+        cell_formats, _tag("xf"), dict(cell_formats[0].attrib),
+        applyFont="1", applyAlignment="1",
+    )
+    ET.SubElement(
+        centered_format, _tag("alignment"),
+        horizontal="center", vertical="center", wrapText="0", shrinkToFit="0",
+    )
+    return ET.tostring(styles, encoding="utf-8", xml_declaration=True)
+
+
+def _read_parts(source: bytes) -> tuple[list[ZipInfo], dict[str, bytes]]:
+    if (
+        not isinstance(source, bytes)
+        or len(source) > 16384
+        or not source.startswith(b"PK\x03\x04")
+        or source[-22:-18] != b"PK\x05\x06"
+    ):
+        raise ProjectionUnsupported("unexpected XLSX archive envelope")
+    try:
+        with ZipFile(BytesIO(source)) as archive:
+            entries = archive.infolist()
+            if (
+                len(entries) != len(_PART_NAMES)
+                or {entry.filename for entry in entries} != _PART_NAMES
+                or archive.comment
+                or any(
+                    entry.flag_bits
+                    or entry.extra
+                    or entry.comment
+                    or entry.orig_filename != entry.filename
+                    or entry.file_size > 4096
+                    or entry.compress_type not in {ZIP_DEFLATED, ZIP_STORED}
+                    for entry in entries
+                )
+            ):
+                raise ProjectionUnsupported("unexpected XLSX package members or options")
+            return entries, {entry.filename: archive.read(entry) for entry in entries}
+    except ProjectionUnsupported:
+        raise
+    except (BadZipFile, EOFError, OSError, StructError, ValueError, ZlibError) as error:
+        raise ProjectionUnsupported("malformed XLSX archive") from error
+
+
+def _write_parts(entries: list[ZipInfo], parts: dict[str, bytes]) -> bytes:
+    staged = BytesIO()
+    with ZipFile(staged, "w") as archive:
+        for entry in entries:
+            archive.writestr(copy(entry), parts[entry.filename])
+    return staged.getvalue()
+
+
+def project(source: bytes) -> bytes:
+    """Stage an in-memory print copy after the caller's normal XLSX source guard."""
+    entries, parts = _read_parts(source)
+    # Admit only the producer's unambiguous ZIP envelope. ZipFile alone can
+    # ignore local header differences, gaps and trailing compressed bytes.
+    if _write_parts(entries, parts) != source:
+        raise ProjectionUnsupported("unexpected XLSX archive representation")
+    parsed = {name: _parse(data) for name, data in parts.items()}
+    for name, template in _BASE_PARTS.items():
+        expected = ET.fromstring(template)
+        if name == _WORKBOOK:
+            sheet = parsed[name].find(f"{_tag('sheets')}/{_tag('sheet')}")
+            if sheet is not None and "name" in sheet.attrib:
+                # The normal source guard validates the user's sheet name.
+                expected[0][0].set("name", sheet.attrib["name"])
+        if not _same_shape(parsed[name], expected):
+            raise ProjectionUnsupported(f"unexpected XLSX descriptor or style: {name}")
+    sheet = parsed[_SHEET]
+    _check_sheet(sheet)
+
+    parts[_STYLES] = _project_styles(parsed[_STYLES])
+    parts[_SHEET] = _project_sheet(sheet)
+    return _write_parts(entries, parts)
