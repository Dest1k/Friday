+def _plain_prose_geometry(page):
+    """Compute Poppler word box expectations from the pinned PDF font metrics."""
+    font = _font()['template']['/DescendantFonts'][0]['/FontDescriptor']
+    expected = []
+    for line, op in enumerate(op for op in page if op['text']):
+        size = op['size']
+        x = op['x']
+        y = PAGE_HEIGHT - op['baseline']
+        top = y - font['/Ascent'] * size / 1000
+        bottom = y - font['/Descent'] * size / 1000
+        space = _measure(' ', size)[-1]
+        for word in op['text'].split(' '):
+            right = x + _measure(word, size)[-1]
+            expected.append((word, line, (x, top, right, bottom)))
+            x = right + space
+    return (PAGE_WIDTH, PAGE_HEIGHT), expected
+
+
+def _layout_sha256(pages):
+    return hashlib.sha256(json.dumps(pages, ensure_ascii=False, sort_keys=True,
+                                     separators=(',', ':')).encode()).hexdigest()
