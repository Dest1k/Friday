+def _generated_table_records(word, table):
+    # Nonempty FIB pairs other than these observed ones can name fields,
+    # template paths, external data, additional stories or object structures.
+    pairs = tuple(struct.iter_unpack('<II', word[154:1242]))
+    if tuple(i for i, (_, size) in enumerate(pairs) if size) != _GENERATED_FIB_PAIRS:
+        _fail('doc_generated_fib_records')
+    if pairs[1] != pairs[0]:
+        _fail('doc_generated_table_layout')
+    records = {}
+    end = 0
+    for i in _GENERATED_TABLE_ORDER:
+        offset, size = pairs[i]
+        if offset != end or size > len(table) - offset:
+            _fail('doc_generated_table_layout')
+        end += size
+        records[i] = table[offset:end]
+    if end != len(table):
+        _fail('doc_generated_table_layout')
+    # MS-DOC ignores offsets of absent records. The pinned producer sets two
+    # such offsets; other nonzero offsets fall outside the observed shape.
+    for i, (offset, size) in enumerate(pairs):
+        if not size and offset != (pairs[93][0] if i == 24 else 0x00D90002 if i == 108 else 0):
+            _fail('doc_generated_table_layout')
+    return records
+
+
+def _check_generated_word_records(word, table, expected, boundaries):
+    first = _GENERATED_TEXT_START
+    last = boundaries[-1]
+    cp_count = len(expected) // 2
+    chpx_page = (last + 511) // 512
+    papx_page = chpx_page + 1
+    section_offset = (papx_page + 1) * 512
+    if (len(word) != section_offset + len(_GENERATED_SEPX)
+            or _u32(word, 28) != last or _u32(word, 64) != len(word)
+            or _u32(word, 76) != cp_count or _u32(word, 112) != chpx_page
+            or _u32(word, 124) != papx_page
+            or _generated_fixed_sha(word[:154], _GENERATED_FIB_VARIABLE)
+            != _GENERATED_FIB_FIXED_SHA
+            or any(word[1242:first])):
+        _fail('doc_generated_fib')
+    records = _generated_table_records(word, table)
+    # The CLX proves one contiguous uncompressed run with no PRM or PRCs.
+    if records[33] != struct.pack('<BIIIHIH', 2, 16, 0, cp_count, 0x50, first, 0):
+        _fail('doc_generated_clx')
+    if sha256(records[0]).hexdigest() != '5e41f68aa705556236c65dcb50333849415afd1e18c5e8447a1e3e2a27120edd':
+        _fail('doc_generated_style_profile')
+    if (sha256(records[15]).hexdigest() != '4bc65103cc6cea050c2d58982ae1b2ee1b47385c673acbd938f604de9f26327d'
+            or len(records[31]) != 610
+            or _generated_fixed_sha(records[31], _GENERATED_DOP_STATS) != _GENERATED_DOP_FIXED_SHA):
+        _fail('doc_generated_document_properties')
+    if (records[6] != struct.pack('<IIHIHI', 0, cp_count, 4, section_offset, 0, FREE)
+            or records[93] != struct.pack('<III', 0, cp_count, 0)
+            or records[12] != struct.pack('<III', first, last - 2, chpx_page)
+            or records[13] != struct.pack('<III', first, last, papx_page)):
+        _fail('doc_generated_text_records')
+    if word[first:last] != expected:
+        _fail('doc_generated_paragraph_mismatch')
+    if any(word[last:chpx_page * 512]) or word[section_offset:] != _GENERATED_SEPX:
+        _fail('doc_generated_section_profile')
+    chpx = struct.pack('<II', first, last - 2) + bytes(503) + b'\x01'
+    if word[chpx_page * 512:papx_page * 512] != chpx:
+        _fail('doc_generated_character_properties')
+    count = len(boundaries) - 1
+    papx = bytearray(512)
+    papx[:4 * len(boundaries)] = struct.pack(f'<{len(boundaries)}I', *boundaries)
+    for i in range(count):
+        # A BX entry points in two-byte units to the single Normal property
+        # record at byte 498. Its twelve documented PHE bytes remain zero.
+        papx[4 * len(boundaries) + i * 13] = 249
+    papx[498:511] = _GENERATED_PAPX
+    papx[511] = count
+    if word[papx_page * 512:section_offset] != papx:
+        _fail('doc_generated_paragraph_properties')
+
