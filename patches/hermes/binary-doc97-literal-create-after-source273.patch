+    ('Root Entry', 5, FREE, FREE, 1),
+    ('\x01CompObj', 2, 2, 4, FREE),
+    ('\x01Ole', 2, FREE, 3, FREE),
+    ('1Table', 2, FREE, FREE, FREE),
+    ('\x05SummaryInformation', 2, 5, 6, FREE),
+    ('WordDocument', 2, FREE, FREE, FREE),
+    ('\x05DocumentSummaryInformation', 2, FREE, FREE, FREE),
+)
