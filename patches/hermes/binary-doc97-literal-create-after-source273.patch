+def _check_generated_directory(directory, entries):
+    if (len(entries) != len(_GENERATED_TREE) + 1 or entries[-1] is not None
+            or sha256(directory[-128:]).hexdigest() != _GENERATED_EMPTY_DIRECTORY_ROW_SHA):
+        _fail('doc_generated_directory')
+    for i, spec in enumerate(_GENERATED_TREE):
+        entry = entries[i]
+        row = directory[i * 128:(i + 1) * 128]
+        clsid = WORD_CLSID if i == 0 else bytes(16)
+        if (entry is None or entry[:5] != spec or entry[5] != clsid or entry[8] != 0
+                or any(row[_u16(row, 64):64]) or any(row[96:116])):
+            _fail('doc_generated_directory')
+
+
+def _check_generated_allocation(cfb, mini_used):
+    # Writer leaves one initial directory image in a FREE sector. The only
+    # admitted nonzero free-sector contents are those exact bytes.
+    blank_directory_seen = False
+    for i in range(cfb.sectors):
+        if i in cfb.used:
+            continue
+        free = cfb._sector(i)
+        if not any(free):
+            continue
+        if blank_directory_seen or sha256(free).hexdigest() != _GENERATED_INITIAL_DIRECTORY_SHA:
+            _fail('doc_generated_free_sector')
+        blank_directory_seen = True
+    for i in range(len(cfb.mini) // 64):
+        if i not in mini_used and any(cfb.mini[64 * i:64 * (i + 1)]):
+            _fail('doc_generated_free_minisector')
+
+
+def _generated_fixed_sha(data, permitted_fields):
+    # Callers give fixed field ranges and exact-length records. Zero only the
+    # verified offsets / metadata fields before comparing the rest.
+    body = bytearray(data)
+    for start, stop in permitted_fields:
+        body[start:stop] = bytes(stop - start)
+    return sha256(body).hexdigest()
+
+
+def _check_generated_root_metadata(streams):
+    if streams['\x01Ole'] != struct.pack('<5I', 0x02000001, 0, 0, 0, 0):
+        _fail('doc_generated_ole_header')
+    if (sha256(streams['\x01CompObj']).hexdigest()
+            != 'fadeb43f2f725c7d4b4d451fb0a33f220157ca22cd5eaea3737ef76f635426c7'
+            or sha256(streams['\x05DocumentSummaryInformation']).hexdigest()
+            != '4bf70144f3e3f0b611e4aba0e93ceb37fd05a81a852137e1bf7b1f021a545c80'):
+        _fail('doc_generated_root_metadata')
+    summary = streams['\x05SummaryInformation']
+    # Permit one ASCII revision digit and only the two known FILETIME values.
+    if (len(summary) != 172 or summary[120] not in b'0123456789'
+            or _generated_fixed_sha(summary, _GENERATED_SUMMARY_METADATA)
+            != _GENERATED_SUMMARY_FIXED_SHA):
+        _fail('doc_generated_root_metadata')
+
+
+def generated_doc97_text(paragraphs):
+    """Validate literals and prepare their Word 97 main-story bytes and bounds."""
+    if type(paragraphs) not in (list, tuple) or not 1 <= len(paragraphs) <= _GENERATED_MAX_PARAGRAPHS:
+        _fail('doc_generated_expected_paragraphs')
+    end = _GENERATED_TEXT_START
+    boundaries = [end]
+    pieces = []
+    nonempty = False
+    for paragraph in paragraphs:
+        if (type(paragraph) is not str or len(paragraph) > MAX_CP
+                or any(ord(ch) < 32 or 0x7F <= ord(ch) <= 0x9F
+                       or ch in '\u2028\u2029\uFFFC\uFFFE\uFFFF' for ch in paragraph)):
+            _fail('doc_generated_expected_literal')
+        try:
+            piece = (paragraph + '\r').encode('utf-16le')
+        except UnicodeEncodeError:
+            _fail('doc_generated_expected_literal')
+        nonempty |= bool(paragraph.strip())
+        end += len(piece)
+        if end - _GENERATED_TEXT_START > 2 * MAX_CP:
+            _fail('doc_generated_expected_paragraphs')
+        pieces.append(piece)
+        boundaries.append(end)
+    # Only the observed CHPX boundary preceding a nonempty final paragraph
+    # is qualified. Interior empty paragraphs still produce exact PAPX runs.
+    if not nonempty or not paragraphs[-1]:
+        _fail('doc_generated_expected_paragraphs')
+    return b''.join(pieces), boundaries
+
