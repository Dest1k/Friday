+def validate_generated_doc97(data, expected_paragraphs):
+    """Verify fixed Writer-generated DOC bytes against the authorized literals.
+
+    Only call on bytes returned by the owned MS Word 97 exporter. The caller
+    binds producer custody before invoking this pure verifier. This entry
+    accepts the observed v3/minor 003B all-red directory tree and FIB 0101/136/0
+    compatibility shape. Independent Writer reopen remains separate.
+    """
+    if type(data) is not bytes or not 512 <= len(data) <= MAX_INPUT:
+        _fail('doc_input_limit')
+    expected, boundaries = generated_doc97_text(expected_paragraphs)
+    word, table = _generated_doc97_streams(data)
+    _check_generated_word_records(word, table, expected, boundaries)
+    return {
+        'format': 'doc',
+        'profile': 'writer_ms_word_97_literal_paragraphs',
+        'paragraphs_verified': len(boundaries) - 1,
+        'main_story_utf16_units': len(expected) // 2,
+    }
+
+
+def _generated_doc97_streams(data):
+    streams = _CFB(data, generated=True).streams
+    _check_generated_root_metadata(streams)
+    return streams['WordDocument'], streams['1Table']
+
+
+def _extract_passive_doc97(data):
+    word, table = _generated_doc97_streams(data)
+    first = _GENERATED_TEXT_START
+    if len(word) < first:
+        _fail('doc_generated_fib')
+    cp_count = _u32(word, 76)
+    last = _u32(word, 28)
+    if not 1 <= cp_count <= MAX_CP or last != first + 2 * cp_count or last > len(word):
+        _fail('doc_generated_text_bounds')
+    try:
+        body = word[first:last].decode('utf-16le', errors='strict')
+    except UnicodeError:
+        _fail('doc_invalid_unicode')
+    if not body.endswith('\r') or body.count('\r') > _GENERATED_MAX_PARAGRAPHS:
+        _fail('doc_generated_expected_paragraphs')
+    paragraphs = body[:-1].split('\r')
+    literals, boundaries = generated_doc97_text(paragraphs)
+    # Verify CLX, the permitted table records, and the CHPX/PAPX and section
+    # bytes against these bounds. Decoding alone never admits a document.
+    _check_generated_word_records(word, table, literals, boundaries)
+    text = '\n'.join(paragraphs) + '\n'
+    if len(text.encode('utf-8')) > MAX_TEXT:
+        _fail('doc_extracted_text_limit')
+    return _Text(text, {
+        'schema': 'friday.doc-text.v1', 'format': 'doc', 'parser': 'bounded_word_binary',
+        'profile': 'word97_literal_main_story',
+        'coverage': 'stored_main_story_literal_paragraphs_only; layout_and_rendering_not_verified',
+        'paragraph_count': len(paragraphs), 'main_story_cp': cp_count,
+        'field_evaluation': False, 'macro_execution': False, 'external_resources_loaded': False,
+        'read_only': True, 'provenance_verified': False,
+    })
+
+
+def extract_scoped_doc(data):
+    """Read strict DOC or the bounded passive Word 97 profile as untrusted text.
+
+    The original strict result wins whenever it succeeds, and its refusal
+    survives if the narrow profile cannot validate the bytes.
+    """
+    try:
+        return extract_doc(data)
+    except DOCError as original:
+        # cfb_header follows the CFB signature and length checks. This version
+        # hint only selects an inert parser, without trusting exporter origin.
+        if str(original) != 'cfb_header' or data[24:28] != b'\x3b\x00\x03\x00':
+            raise
+        try:
+            return _extract_passive_doc97(data)
+        except DOCError:
+            raise original from None
