+_GENERATED_MAX_PARAGRAPHS = 29  # One PAPX FKP; MS-DOC PapxFkp.crun <= 0x1d.
+_GENERATED_PAPX = bytes.fromhex('06000003240061240041240000')
+_GENERATED_SEPX = bytes.fromhex(
+    '2d003c300040500000425002001fb0822e20b0c64121b06e0422b06e0423906e0424906e04335000002832000e3000'
+)
+_GENERATED_FIB_PAIRS = (0, 1, 6, 12, 13, 15, 31, 33, 93)
+_GENERATED_TABLE_ORDER = (0, 6, 12, 13, 93, 33, 15, 31)
+_GENERATED_FIB_VARIABLE = ((28, 32), (64, 68), (76, 80), (112, 116), (124, 128))
+_GENERATED_FIB_FIXED_SHA = '4d8a5313c4f26172ecfde2ddcdfd2efcb7b2d99d472b609e3fa1f34194c0d1d3'
+_GENERATED_DOP_STATS = ((20, 32), (38, 52), (56, 78))
+_GENERATED_DOP_FIXED_SHA = '3a3f015705f439a6e8b23d48700b93d9f21a2b583216fdf4ea393f08d7794b6f'
+_GENERATED_SUMMARY_METADATA = ((120, 121), (152, 160), (164, 172))
+_GENERATED_SUMMARY_FIXED_SHA = 'e4daf0c5dc849469a091215f939bded604028d0835fe61fff366f9d7e26c918d'
+_GENERATED_INITIAL_DIRECTORY_SHA = '336d2487cad285ec88c1293ed6a2d36af7fa23366b302c3465c8b3df1a9210be'
+_GENERATED_EMPTY_DIRECTORY_ROW_SHA = '1ec86aefa9d60b803d55b4468fcd07b197720e4566abe4240f8b8209a3a47c07'
