+def macro_metadata(pkg, name, content_type):
+    """Identify an opaque, bounded project; never decode or execute its code.
+
+    Header checks establish a plausible CFB container only. They do not validate
+    VBA streams, compiled p-code, signatures, or the safety of any instructions.
+    """
+    projects = []
+    for owner, rows in pkg.relationships.items():
+        for kind, target in rows.values():
+            role = kind.rsplit('/', 1)[-1].casefold()
+            if role in ('vbaproject', 'oleobject', 'control', 'package', 'attachedtemplate',
+                        'externallink', 'audio', 'video') and target is None:
+                refuse('external_active_relationship')
+            if role == 'vbaproject':
+                if owner != name or kind != VBA_RELATIONSHIP or target is None:
+                    refuse('invalid_vba_relationship')
+                projects.append(target)
+    if len(projects) != 1:
+        refuse('vba_project_relationship_required')
+    target = projects[0]
+    declared = {part for part in pkg.parts if content_type(part) == VBA_CONTENT_TYPE}
+    if declared != {target}:
+        refuse('vba_project_content_type_mismatch')
+    raw = pkg.parts[target]
+    # CFB v3/v4 headers; no streams or source/compiled instructions are read.
+    if (len(raw) < 512 or raw[:8] != bytes.fromhex('d0cf11e0a1b11ae1')
+            or raw[8:24] != bytes(16) or raw[28:30] != b'\xfe\xff'
+            or raw[32:34] != b'\x06\x00' or raw[34:40] != bytes(6)):
+        refuse('invalid_vba_project_container')
+    major = int.from_bytes(raw[26:28], 'little')
+    shift = int.from_bytes(raw[30:32], 'little')
+    if (major, shift) not in ((3, 9), (4, 12)) or len(raw) % (1 << shift):
+        refuse('invalid_vba_project_container')
+    pkg.unsupported.add('vba_project_opaque_not_read_or_executed')
+    return {'present': True, 'source': target, 'bytes': len(raw),
+            'sha256': hashlib.sha256(raw).hexdigest(),
+            'validation': 'cfb_header_only_not_vba_semantics',
+            'source_code': 'not_read', 'compiled_pcode': 'not_disassembled',
+            'execution': 'not_performed', 'safety': 'unproven'}
+
