@@ -0,0 +1,26 @@
+"""Serialize OPC manifests and relationship parts with a local default namespace."""
+
+from copy import deepcopy
+from xml.etree import ElementTree as ET
+
+
+def opc_xml(root, namespace):
+    # Some OPC readers compare raw element names. Use a default namespace for
+    # this tree while keeping its attributes and ElementTree's registry intact.
+    root = deepcopy(root)
+    prefix = '{%s}' % namespace
+
+    def use_default(node, in_default_namespace):
+        if node.tag.startswith(prefix):
+            node.tag = node.tag[len(prefix):]
+            if not in_default_namespace:
+                node.set('xmlns', namespace)
+                in_default_namespace = True
+        elif in_default_namespace and not node.tag.startswith('{'):
+            node.set('xmlns', '')
+            in_default_namespace = False
+        for child in node:
+            use_default(child, in_default_namespace)
+
+    use_default(root, False)
+    return ET.tostring(root, encoding='utf-8', xml_declaration=True)
