+def ordinary_stop_route(source, opening_source, ctx_source):
+    """Check the attached principal and private route without doing I/O."""
+    if getattr(source, 'chat_type', None) != 'dm' or not source.chat_id:
+        return False
+    cap = getattr(source, '_friday_user_scope', None)
+    return all(getattr(opening, 'chat_type', None) == 'dm'
+               and opening.chat_id == source.chat_id
+               and _same_scope(cap, getattr(opening, '_friday_user_scope', None))
+               for opening in (opening_source, ctx_source))
+
+
+def ordinary_stop_authority(source, opening_source, ctx_source):
+    """Revalidate the principal and private delivery route for stop details."""
+    if not ordinary_stop_route(source, opening_source, ctx_source):
+        return None
+    cap = source._friday_user_scope
+    with authority(cap.home), scoped_source(source):
+        return delegation_authority()
+
+
+def settled_stop_copy(source, receipt=None):
+    from agent.i18n import t
+    if (isinstance(receipt, dict) and receipt.get('status') == 'QUIESCENT'
+            and getattr(source, 'chat_type', None) == 'dm' and ordinary_presentation(source)):
+        outcome = receipt.get('ordinary_publication_outcome')
+        if outcome == 'unknown':
+            return 'Остановка подтверждена. Действие могло завершиться частично. Проверьте результат перед повтором.'
+        if outcome == 'published':
+            return 'Остановка подтверждена. Файл успел сохраниться. Проверьте результат перед повтором.'
+    return t('gateway.stop.stopped')
+
