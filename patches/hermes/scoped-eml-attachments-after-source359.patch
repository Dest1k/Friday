+def _resolve_eml_attachments(cap, spec):
+    """Resolve refs with capped reads and return resolved entries plus custody records."""
+    refs = spec.get('attachments', [])
+    if type(refs) is not list or len(refs) > MAX_ATTACHMENTS:
+        raise CommunicationError('attachment_schema')
+    root = cap.home / 'workspace'
+    entries, sources = [], []
+    total = 0
+    for ref in refs:
+        check(cap)
+        if type(ref) is not dict or set(ref) != {'source', 'source_sha256', 'content_type'}:
+            raise CommunicationError('attachment_schema')
+        expected = ref['source_sha256']
+        if type(expected) is not str or re.fullmatch(r'[0-9a-f]{64}', expected) is None:
+            raise CommunicationError('source_hash_required')
+        raw = ref['source']
+        if type(raw) is not str or not raw or '\x00' in raw:
+            raise ScopeDenied()
+        source = Path(raw)
+        if not source.is_absolute():
+            source = root / source
+        try:
+            relative = source.relative_to(root)
+            _attachment_path(relative.as_posix())
+        except (ValueError, ScopeDenied):
+            raise ScopeDenied() from None
+        remaining = MAX_ATTACHMENT_TOTAL - total
+        if remaining <= 0:
+            raise CommunicationError('attachment_total_limit')
+        guard_tool('read_file', {'path': str(source)}, registry_scope=str(cap.home))
+        data, actual, identity = workspace_document(str(source), max_bytes=remaining,
+                                                    with_identity=True)
+        if actual != relative.as_posix():
+            raise ScopeDenied()
+        if hashlib.sha256(data).hexdigest() != expected:
+            raise CommunicationError('source_hash_mismatch')
+        total += len(data)
+        if total > MAX_ATTACHMENT_TOTAL:
+            raise CommunicationError('attachment_total_limit')
+        entries.append({'filename': relative.name, 'content_type': ref['content_type'], 'data': data})
+        sources.append((relative.as_posix(), data, identity))
+    return dict(spec, attachments=entries), sources
 
