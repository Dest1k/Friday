--- /dev/null
+++ b/hermes_cli/friday_protected_archive.py
@@ -0,0 +1,283 @@
+"""Pre-model one-use encrypted archive creation in the native user workspace."""
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+from hmac import compare_digest
+import json
+from pathlib import PurePosixPath
+import re
+import secrets
+from threading import Event, RLock
+import time
+
+from agent.web_call_context import _current, same_web_authority
+from hermes_cli.friday_protected_odt import Binding, TTL_SECONDS
+from hermes_cli.friday_user_scope import current, guard_tool
+from hermes_cli.friday_workspace_revision import check
+
+
+ZIP_AES = 'zip_aes256'
+SEVEN_AES = '7z_aes256'
+SEVEN_PRIVATE = '7z_aes256_private'
+_PROFILES = {
+    ZIP_AES: ('zip', 'WinZip AES-256 AE-2', False),
+    SEVEN_AES: ('7z', '7z AES-256', False),
+    SEVEN_PRIVATE: ('7z', '7z AES-256', True),
+}
+_HASH = re.compile(r'[0-9a-f]{64}')
+_ERRORS = frozenset(('archive_input_refused', 'archive_scope_refused', 'archive_intake_unavailable',
+                     'archive_source_changed', 'archive_protected_commit_unavailable'))
+
+
+class ArchiveRefused(RuntimeError):
+    pass
+
+
+def _need(condition, code):
+    if not condition:
+        raise ArchiveRefused(code)
+
+
+def _refusal(code, *, unknown=False):
+    return {'success': False, 'error': code,
+            'effect_disposition': 'unknown' if unknown else 'none'}
+
+
+@dataclass(frozen=True, slots=True)
+class Attachment:
+    upload_message: str
+    file_unique_id: str
+    source: str
+    member: str
+    source_sha256: str
+    file_identity: tuple
+
+
+@dataclass(frozen=True, slots=True)
+class Approval:
+    binding: Binding
+    attachments: tuple[Attachment, ...]
+    destination: str
+    profile: str
+
+    def check_shape(self):
+        from hermes_cli.friday_workspace_zip import MAX_ENTRIES, _path
+
+        _need(type(self.binding) is Binding and type(self.profile) is str and self.profile in _PROFILES
+              and type(self.attachments) is tuple and 1 <= len(self.attachments) <= MAX_ENTRIES,
+              'archive_scope_refused')
+        try:
+            destination = _path(self.destination)
+            _need(PurePosixPath(destination).suffix.lower() == '.' + _PROFILES[self.profile][0],
+                  'archive_scope_refused')
+            names = set()
+            for entry in self.attachments:
+                _need(type(entry) is Attachment
+                      and all(type(value) is str and 0 < len(value) <= 256
+                              for value in (entry.upload_message, entry.file_unique_id))
+                      and type(entry.source_sha256) is str and _HASH.fullmatch(entry.source_sha256)
+                      and type(entry.file_identity) is tuple and len(entry.file_identity) == 9
+                      and all(type(value) is int for value in entry.file_identity),
+                      'archive_scope_refused')
+                source, member = _path(entry.source), _path(entry.member)
+                _need(source != destination and member not in names, 'archive_scope_refused')
+                names.add(member)
+            _need(not any(str(parent) in names for name in names
+                          for parent in PurePosixPath(name).parents), 'archive_scope_refused')
+        except ArchiveRefused:
+            raise
+        except (ValueError, PermissionError, UnicodeError):
+            raise ArchiveRefused('archive_scope_refused') from None
+
+
+def _scope(approval, call, authorize):
+    cap = current(required=True)
+    binding = approval.binding
+    _need(call is not None and _current.get() is call and same_web_authority(call)
+          and call.session_id == binding.session_id
+          and (cap.principal, cap.profile, cap.admission_generation, cap.directory_identity)
+          == (binding.principal, binding.profile, binding.admission_generation, binding.home_identity)
+          and authorize(approval) is True, 'archive_scope_refused')
+    call.check()
+    check(cap)
+    return cap
+
+
+class _Invocation:
+    __slots__ = ('owner', 'ticket', 'approval', 'deadline', 'call', 'cancelled',
+                 'commit_attempted', '_codec_unsettled')
+
+    def __init__(self, owner, ticket, approval, deadline, call):
+        self.owner = owner
+        self.ticket = ticket
+        self.approval = approval
+        self.deadline = deadline
+        self.call = call
+        self.cancelled = self.commit_attempted = self._codec_unsettled = False
+
+    def _active(self):
+        _need(self.owner._active is self and not self.cancelled and not self.owner._stopped.is_set()
+              and self.owner._clock() < self.deadline, 'archive_intake_unavailable')
+
+    def codec_checkpoint(self):
+        """Poll original call STOP/deadline without taking the publication lock."""
+        self._active()
+        self.call.check()
+
+    def mark_codec_unsettled(self):
+        self._codec_unsettled = True
+
+    def checkpoint(self):
+        with self.owner._lock:
+            self.codec_checkpoint()
+            cap = _scope(self.approval, self.call, self.owner._authorize)
+            self.codec_checkpoint()
+            return cap
+
+    def before_codec(self):
+        from hermes_cli.friday_workspace_7z_codec import WALL_SECONDS
+
+        self.checkpoint()
+        _need(self.deadline - self.owner._clock() > WALL_SECONDS + 2, 'archive_intake_unavailable')
+
+    @contextmanager
+    def commit(self, verify):
+        with self.owner._lock:
+            self.checkpoint()
+            verify()
+            self.checkpoint()
+            self.commit_attempted = True
+            yield
+
+
+class NativeArchiveOwner:
+    """One ephemeral grant for an authenticated native operation."""
+
+    def __init__(self, authorize, *, clock=time.monotonic):
+        self._authorize = authorize
+        self._clock = clock
+        self._lock = RLock()
+        self._stopped = Event()
+        self._pending = self._active = None
+        self._issued = False
+        self._unknown = False
+
+    def issue(self, approval):
+        """The native producer calls this after confirming attachment and profile."""
+        _need(type(approval) is Approval, 'archive_scope_refused')
+        approval.check_shape()
+        call = _current.get()
+        with self._lock:
+            now = self._clock()
+            if self._pending is not None and now >= self._pending[2]:
+                self._pending = None
+            _need(not self._issued and not self._stopped.is_set() and not self._unknown
+                  and self._active is None and self._pending is None, 'archive_intake_unavailable')
+            _scope(approval, call, self._authorize)
+            deadline = min(now + TTL_SECONDS, call.deadline())
+            _need(self._clock() < deadline and not self._stopped.is_set(), 'archive_intake_unavailable')
+            ticket = secrets.token_urlsafe(32)
+            call.bind_protected_archive(self)
+            call.check()
+            _need(not self._stopped.is_set() and self._clock() < deadline,
+                  'archive_intake_unavailable')
+            self._pending = (ticket, approval, deadline, call)
+            self._issued = True
+            return ticket
+
+    def cancel(self, authenticated, ticket):
+        if type(authenticated) is not Binding or type(ticket) is not str or not ticket.isascii():
+            return
+        with self._lock:
+            pending = self._pending
+            if (pending is not None and authenticated == pending[1].binding
+                    and compare_digest(ticket, pending[0])):
+                self._pending = None
+            active = self._active
+            if (active is not None and authenticated == active.approval.binding
+                    and compare_digest(ticket, active.ticket)):
+                active.cancelled = True
+
+    def request_stop(self):
+        self._stopped.set()
+
+    def stop_status(self):
+        """Observe settlement without waiting for scope revalidation or rename."""
+        if not self._lock.acquire(blocking=False):
+            return 'PENDING'
+        try:
+            if self._pending is not None and (
+                    self._stopped.is_set() or self._clock() >= self._pending[2]):
+                self._pending = None
+            if self._active is not None:
+                return 'PENDING'
+            if self._unknown:
+                return 'UNKNOWN'
+            return 'PENDING' if self._pending is not None else 'QUIESCENT'
+        finally:
+            self._lock.release()
+
+    def stop(self):
+        self.request_stop()
+        return self.stop_status()
+
+    def submit(self, authenticated, ticket, secret):
+        """Accept only the owned protected buffer; the ticket stores no password."""
+        if type(secret) is not bytearray:
+            return _refusal('archive_input_refused')
+        invocation = None
+        outcome = None
+        try:
+            from hermes_cli.friday_workspace_zip import _create_protected_archive
+
+            with self._lock:
+                pending = self._pending
+                _need(type(authenticated) is Binding and type(ticket) is str and ticket.isascii()
+                      and pending is not None and self._active is None and not self._unknown
+                      and not self._stopped.is_set() and authenticated == pending[1].binding
+                      and compare_digest(ticket, pending[0]), 'archive_intake_unavailable')
+                _need(_current.get() is pending[3], 'archive_scope_refused')
+                self._pending = None
+                invocation = self._active = _Invocation(self, *pending)
+            cap = invocation.checkpoint()
+            invocation.before_codec()
+            _need(0 < len(secret) <= 1024 and 0 not in secret, 'archive_input_refused')
+            approval = invocation.approval
+            archive_format, encryption, private = _PROFILES[approval.profile]
+            guard_tool('write_file', {'path': approval.destination, 'format': archive_format})
+            result = json.loads(_create_protected_archive(cap, invocation, secret.decode('utf-8'),
+                                                          archive_format, private))
+            if result.get('success') is not True or invocation._codec_unsettled:
+                unknown = invocation._codec_unsettled or result.get('effect_disposition') == 'unknown'
+                outcome = _refusal('archive_effect_uncertain' if unknown else 'archive_input_refused',
+                                   unknown=unknown)
+            else:
+                # The native writer verified the committed archive before returning.
+                # A later stop cannot unsettle the write; delivery checks its own authority.
+                _need(invocation.commit_attempted and result['path'] == approval.destination
+                      and result['format'] == archive_format and result['scope'] == 'own_user_workspace'
+                      and result['create_only'] is True and result['verified'] is True
+                      and type(result['bytes_written']) is int and result['bytes_written'] > 0
+                      and type(result['sha256']) is str and _HASH.fullmatch(result['sha256']),
+                      'archive_input_refused')
+                outcome = {'success': True, 'effect_disposition': 'committed', 'artifact': {
+                    'path': approval.destination, 'sha256': result['sha256'], 'bytes': result['bytes_written'],
+                    'format': archive_format, 'encryption': encryption, 'member_names_encrypted': private,
+                }}
+        except Exception as error:
+            unknown = invocation is not None and (invocation.commit_attempted or invocation._codec_unsettled)
+            code = error.args[0] if type(error) is ArchiveRefused and len(error.args) == 1 else None
+            outcome = _refusal('archive_effect_uncertain' if unknown else
+                               code if type(code) is str and code in _ERRORS else 'archive_input_refused',
+                               unknown=unknown)
+        finally:
+            secret[:] = bytes(len(secret))
+            if invocation is not None:
+                with self._lock:
+                    if outcome is None or outcome.get('effect_disposition') == 'unknown':
+                        self._unknown = True
+                        if hasattr(invocation.call, 'agent'):
+                            invocation.call.agent._friday_reply_effect_unknown = True
+                    if self._active is invocation:
+                        self._active = None
+        return outcome
