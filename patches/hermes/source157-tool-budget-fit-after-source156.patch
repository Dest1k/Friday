+def bounded_trim_tools_to_trigger(agent):
+    """Drop the largest tool schemas until the fixed part fits under the soft trigger.
+
+    The bounded lane prices ``system prompt + tool schemas`` as overhead that
+    compression cannot shrink. When that overhead exceeds the trigger, pre-API
+    compression runs on every turn, cannot reach its target, and ends up
+    rewriting protected rows. Trimming the advertised tool set is the only local
+    lever that does not touch history, limits or the system prompt. Tools are
+    kept in their original order; the smallest are always retained so ordinary
+    work still has a usable surface. Returns the (possibly identical) list.
+    """
+    tools = getattr(agent, "tools", None)
+    policy = getattr(agent, "_bounded_context_policy", None)
+    if not isinstance(tools, list) or not tools or not isinstance(policy, BoundedContextPolicy):
+        return tools
+    system_prompt = getattr(agent, "_cached_system_prompt", None)
+    if not isinstance(system_prompt, str):
+        return tools
+    system_bytes = serialized_bytes([{"role": "system", "content": system_prompt}])
+    trigger = policy.trigger_tokens
+    sizes = []
+    for index, tool in enumerate(tools):
+        try:
+            sizes.append((index, serialized_bytes(tool)))
+        except BoundedContextError:
+            return tools
+    total = system_bytes + sum(size for _, size in sizes)
+    if total <= trigger:
+        return tools
+    # Keep the tools an ordinary conversation actually needs, then drop the
+    # biggest of the rest until the fixed part fits under the trigger.
+    essential = {"write_file", "read_file", "terminal", "memory", "clarify"}
+    names = {}
+    for index, tool in enumerate(tools):
+        function = tool.get("function") if isinstance(tool, dict) else None
+        if isinstance(function, dict):
+            names[index] = function.get("name")
+    candidates = sorted((row for row in sizes if names.get(row[0]) not in essential),
+                        key=lambda row: -row[1])
+    keep = dict(sizes)
+    floor = min(12, len(tools))
+    for index, size in candidates:
+        if len(keep) <= floor or total <= trigger:
+            break
+        total -= size
+        keep.pop(index, None)
+    if len(keep) == len(tools):
+        return tools
+    return [tool for index, tool in enumerate(tools) if index in keep]
