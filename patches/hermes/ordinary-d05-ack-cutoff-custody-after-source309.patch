+"""Project the native D05 terminal in the protected receiver's routed WAL snapshot."""
+
+from functools import partial
+
+from .d02_receiver_control import _CAPTURE, require
+from .ordinary_d05_turn import SCENARIO_SHA256
+from .ordinary_d05_writer import read_terminal
+from .s08_session_fence import project_session_fence
+
+
+def capture_d05_session_fence(arm, intent, joined, verified, *, deadline):
+    """Use the live arm and the original ACK values already verified by ReceiverControl."""
+    claim = intent["claim"]["sha256"]
+    run_id = intent["run_id"]
+    run = verified["run"]
+    ack = verified["ack"]
+    if run["sent_api_ack_reference"]["representation"] == "botapi-wire-envelope-json":
+        ack = ack["result"]
+
+    wire = arm.ingress.readback()["wire"]
+    update, = wire["target_update_ids"]
+    (receipt, _), = joined["observations"]
+    message = receipt["message"]
+    cutoff = run["capture_until"]
+    started = ack["date"]
+    require(arm.claim.selected_d05 == (SCENARIO_SHA256, run_id)
+            and arm.claim.claim_sha256 == claim == joined["claim_sha256"]
+            and arm.claim.generation == joined["generation"]
+            and intent["scenario_sha256"] == run["scenario_sha256"] == SCENARIO_SHA256
+            and run["id"] == run_id and run["status"] == "EVIDENCE_READY"
+            and run["capture_window_complete"] is True and run["send_attempts"] == 1
+            and wire["state"] == "LOCAL_WIRE_CLOSED"
+            and message["platform_update_id"] == str(update)
+            and type(started) is int and started == run["sent_date"]
+            and cutoff == run["sent_at"] + _CAPTURE and started <= cutoff,
+            "d05_exact_terminal_wal_binding_required")
+
+    fence, terminal = project_session_fence(
+        arm.ingress.adapter.gateway_runner, arm.ingress.scope, receipt,
+        started=started, cutoff=cutoff, deadline=deadline,
+        project=partial(read_terminal, arm.ingress, claim, run_id),
+    )
+    require(type(terminal) is dict
+            and terminal["schema"] == "friday.d05.native-typed-input-owned-edit.v2"
+            and terminal["run_id"] == run_id and terminal["claim_sha256"] == claim
+            and terminal["sdk"]["update_id"] == str(update)
+            and terminal["sdk"]["native_message_id"] == message["message_id"]
+            and terminal["sdk"]["date"] == started,
+            "d05_exact_terminal_wal_projection_required")
+    return fence, terminal
