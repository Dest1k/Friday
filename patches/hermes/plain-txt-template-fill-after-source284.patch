+def _render_plain_template_fill(data, fields, checkpoint):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import (
+        MAX_PARAGRAPHS, MAX_TEXT, _EditRefused, _fill_occurrences, _text,
+    )
+
+    if not isinstance(data, bytes) or not data or len(data) > MAX_TEXT:
+        _fail('text_template_size')
+    _tick(checkpoint)
+    try:
+        template = _text(data.decode('utf-8-sig'))
+    except (UnicodeError, ScopeDenied):
+        _fail('invalid_text_template')
+    # Match the source lines exposed by the ordinary UTF-8 reader.
+    template = '\n'.join(template.splitlines())
+    if template.count('\n') >= MAX_PARAGRAPHS:
+        _fail('text_template_paragraph_limit')
+    pieces, names = [], set()
+    offset = count = 0
+    try:
+        for name, start, end in _fill_occurrences(template):
+            _tick(checkpoint)
+            count += 1
+            if count > 256:
+                _fail('placeholder_occurrence_limit')
+            if name not in fields:
+                _fail('missing_fields')
+            names.add(name)
+            pieces.extend((template[offset:start], fields[name]))
+            offset = end
+    except _EditRefused as error:
+        _fail(str(error))
+    if not names:
+        _fail('placeholders_missing')
+    if names != fields.keys():
+        _fail('extra_fields')
+    pieces.append(template[offset:])
+    if sum(len(piece.encode('utf-8')) for piece in pieces) > MAX_TEXT:
+        _fail('replacement_limit')
+    rendered = render(''.join(pieces), 'docx', checkpoint=checkpoint)
+    return rendered, {'fields': sorted(names), 'replacements': count,
+                      'source_format': 'txt', 'output_format': 'docx'}
