+    if ET.tostring(verified) != ET.tostring(root):
+        raise WordProfileError('invalid_edit')
+    return changed
+
+
+def edit_paragraphs(data, edits, format, *, checkpoint=None):
+    """Apply a bounded list against one immutable passive DOCX package."""
+    if format != 'docx':
+        raise WordProfileError('unsupported_word_edit_list_profile')
+    specifications = _specs(edits)
+    package = _Package(data, format, checkpoint)
+    if package.active:
+        raise WordProfileError('unsupported_active_or_signed_edit')
+    try:
+        locations, valid_footnotes = _stored_locations(package, checkpoint)
+        footnotes = defaultdict(set)
+        for paragraph, identifier in valid_footnotes:
+            footnotes[paragraph].add(identifier)
+        parts = defaultdict(list)
+        for (part, identifier, number), old, new in specifications:
+            if part is None:
+                part = locations.get((None, identifier, number))
+                kind = 'comment'
+            elif part == 'word/document.xml' and identifier is None:
+                kind = 'body'
+            else:
+                kind = locations.get((part, identifier, number))
+            if part is None or kind is None:
+                raise WordProfileError('stored_word_location_missing')
+            parts[part].append((kind, identifier, number, old, new))
+        changes = {part: _edit_part(package.parts[part], entries, footnotes, checkpoint)
+                   for part, entries in parts.items()}
+        if checkpoint:
+            checkpoint()
+        result = _rewrite(data, changes)
+        if len(result) > MAX_BYTES:
+            raise WordProfileError('output_limit')
+        validated = _Package(result, format, checkpoint)
+        _stored_locations(validated, checkpoint)
+        _preserved(data, result, set(changes))
+        if checkpoint:
+            checkpoint()
+        return result
+    except _EditRefused as error:
+        raise WordProfileError(str(error)) from None
+    except (ET.ParseError, expat.ExpatError, UnicodeError):
+        raise WordProfileError('invalid_edit') from None
