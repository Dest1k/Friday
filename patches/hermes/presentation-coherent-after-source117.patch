+            kind = rel.get('Type').rsplit('/', 1)[-1]
+            if kind not in ALLOWED_EDGES:
+                refuse('unsupported_slide_relationship')
+            target = _resolve(name, rel.get('Target'))
+            _role(parts, types, target, kind)
+            if kind == 'notesSlide':
+                note_rels = _checked_rels(parts, target)
+                backlinks = [item for item in note_rels.values() if item.get('Type') == R + '/slide']
+                if len(backlinks) != 1 or _resolve(target, backlinks[0].get('Target')) != name:
+                    refuse('notes_slide_backlink_mismatch')
+            pending.append(target)
+    return found
+
+
+def _global(deck, kind):
+    matches = [rel for rel in deck['rels'].values() if rel.get('Type') == R + '/' + kind]
+    if len(matches) > 1:
+        refuse('ambiguous_global_relationship')
+    if not matches:
+        return None
+    name = _resolve(PRESENTATION, matches[0].get('Target'))
+    _role(deck['parts'], deck['types'], name, kind)
+    return name
+
+
+def _snapshot(deck, names):
+    return {name: deck['parts'][name] for name in names}
+
