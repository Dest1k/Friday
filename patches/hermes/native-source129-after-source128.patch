+"""Bounded signature inventory and deliberate unsigned derivative; no crypto validation.
+
+Original bytes stay immutable. Only flat signature-only AcroForms are admitted.
+All user parsing/native work uses the existing private networkless qpdf boundary.
+"""
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+try:
+    from tools import scoped_pdf_pages as _pages
+except ModuleNotFoundError:
+    import scoped_pdf_pages as _pages
+PDFSignatureError = _pages.PDFPagesError
+PDFPagesError = PDFSignatureError
+MAX_BYTES = _pages.MAX_BYTES
+MAX_PAGES = _pages.MAX_PAGES
+MAX_SIGNATURES = 16
+WALL_SECONDS = _pages.WALL_SECONDS
+LIBRARY = _pages.LIBRARY
+STATUS = 'NOT_CRYPTOGRAPHICALLY_VERIFIED'
+PROFILE = 'flat_signature_only_AcroForm'
+POLICY = 'signature_widgets_forms_and_document_metadata_discarded_in_unsigned_copy'
+
+
+def request(content):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise PDFSignatureError('pdf_request_invalid')
+            result[key] = value
+        return result
+    try:
+        if type(content) is not str or len(content.encode('utf-8')) > 2000:
+            raise ValueError()
+        spec = json.loads(content, object_pairs_hook=pairs)
+        if (type(spec) is not dict or set(spec) != {'source', 'source_sha256'}
+                or type(spec['source']) is not str or not spec['source']
+                or len(spec['source'].encode('utf-8')) > 512
+                or type(spec['source_sha256']) is not str
+                or not re.fullmatch('[0-9a-f]{64}', spec['source_sha256'])):
+            raise ValueError()
+        return spec
+    except (ValueError, UnicodeError, RecursionError):
+        raise PDFSignatureError('pdf_request_invalid') from None
+
+
+def _argv(work, count):
+    argv = _pages._argv(work, count)
+    # The isolated runner imports this exact pure helper, never the host package.
+    index = argv.index('--chdir')
+    argv[index:index] = ['--ro-bind', str(work / 'scoped_pdf_pages.py'), '/work/scoped_pdf_pages.py']
+    # -I excludes the script directory: add only our protected /work explicitly.
+    argv[-2:] = ['-c', "import sys,runpy;sys.path.insert(0,'/work');sys.argv=['/work/runner.py','--child'];runpy.run_path('/work/runner.py',run_name='__main__')"]
+    return argv
+
+def _run(cap, work, count):
+    from agent.web_call_context import _current, same_web_authority
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    if call is None or not same_web_authority(call):
+        raise PDFPagesError('native_deadline_required')
+    custody = _Custody()
+    bound = False
+    deadline = min(call.deadline(), time.monotonic() + WALL_SECONDS)
+    try:
+        with call.turn.lock:
+            check(cap)
+            call.check()
+            if call.session is not None or call.registry is not None:
+                raise PDFPagesError('pdf_custody_busy')
+            if time.monotonic() >= deadline:
+                raise PDFPagesError('pdf_timeout')
+            call.session = call.registry = custody
+            call.turn.calls.add(custody)
+            bound = True
+            custody.process = subprocess.Popen(_argv(work, count), cwd=work,
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                close_fds=True, start_new_session=True,
+                env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'})
+        while custody.process.poll() is None:
+            check(cap)
+            call.check()
+            if not same_web_authority(call):
+                raise PDFPagesError('pdf_authority_changed')
+            if time.monotonic() >= deadline:
+                raise PDFPagesError('pdf_timeout')
+            try:
+                custody.process.wait(timeout=min(.05, max(.001, deadline - time.monotonic())))
+            except subprocess.TimeoutExpired:
+                pass
+        check(cap)
+        call.check()
+        if custody.process.returncode != 0:
+            raise PDFPagesError('pdf_engine_failed')
+    finally:
+        receipt = custody.stop()
+        with call.turn.lock:
+            if bound and receipt['status'] == 'QUIESCENT':
+                if call.session is not custody or call.registry is not custody:
+                    receipt = {'status': 'STOP_UNCONFIRMED'}
+                else:
+                    call.session = call.registry = None
+                    call.turn.calls.discard(custody)
+        if receipt['status'] != 'QUIESCENT':
+            if hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFPagesError('pdf_cleanup_unconfirmed')
+
+
+
+def process(cap, source, *, create=False):
+    """Inventory a bounded signature form or create a deliberately unsigned PDF."""
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _private_read, LocalOCRFailure
+    if type(source) is not bytes or not 0 < len(source) <= MAX_BYTES or type(create) is not bool:
+        raise PDFSignatureError('pdf_input_limit')
