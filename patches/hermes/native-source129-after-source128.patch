+        if (type(result) is not dict or set(result) != {'pages', 'signatures', 'signature_validation',
+                    'profile', 'engine', 'derivative', 'metadata_policy', 'rasterized'}
+                or result['signature_validation'] != STATUS or result['profile'] != PROFILE
+                or result['engine'] != 'libqpdf-12.3.2' or result['rasterized'] is not False
+                or result['derivative'] != ('UNSIGNED_COPY' if create else 'NOT_CREATED')
+                or result['metadata_policy'] != POLICY
+                or type(result['pages']) is not int or not 1 <= result['pages'] <= MAX_PAGES
+                or type(result['signatures']) is not list or not 1 <= len(result['signatures']) <= MAX_SIGNATURES):
+            raise PDFSignatureError('pdf_verification_failed')
+        for row in result['signatures']:
+            if (type(row) is not dict or set(row) != {'field', 'page', 'byte_range', 'covers_current_file', 'status'}
+                    or type(row['field']) is not str or len(row['field']) > 256
+                    or row['status'] != STATUS or type(row['page']) is not int
+                    or not 1 <= row['page'] <= result['pages']
+                    or type(row['covers_current_file']) is not bool
+                    or type(row['byte_range']) is not list or len(row['byte_range']) != 4
+                    or any(type(v) is not int for v in row['byte_range'])):
+                raise PDFSignatureError('pdf_verification_failed')
+        output = _private_read(work/'output.pdf', MAX_BYTES) if create else None
+        if output is not None and (not output.startswith(b'%PDF-') or not output.rstrip().endswith(b'%%EOF')):
+            raise PDFSignatureError('pdf_verification_failed')
+        check(cap)
+        return output, result
+    except (OSError, LocalOCRFailure, json.JSONDecodeError):
+        raise PDFSignatureError('pdf_engine_failed') from None
+    finally:
+        try:
+            shutil.rmtree(work)
+        except OSError:
+            from agent.web_call_context import _current
+            call = _current.get()
+            if call is not None and hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFSignatureError('pdf_cleanup_unconfirmed') from None
