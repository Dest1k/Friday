+"""Signature inventory and create-only explicitly unsigned PDF derivatives."""
+import hashlib
+import json
+
+
+def _refusal(error):
+    from hermes_cli.friday_workspace_zip import _encode
+    return _encode(dict(success=False, error='pdf_signature_refused', reason=str(error),
+        effect_disposition='unknown' if str(error)=='pdf_cleanup_unconfirmed' else 'none',
+        signature_validation='NOT_CRYPTOGRAPHICALLY_VERIFIED'))
+
+
+def read_signatures(cap, relative):
+    from hermes_cli.friday_workspace_zip import _source, _verify, _inline_budget, _fits, _capacity, _encode
+    from tools.scoped_pdf_signatures import process, PDFSignatureError
+    data, identity = _source(cap, relative)
+    try:
+        _, metadata = process(cap, data)
+        _verify(cap, [(relative, data, identity)])
+        result = dict(metadata, success=True, path=relative, scope='own_user_workspace',
+            source_sha256=hashlib.sha256(data).hexdigest(), source_unchanged=True,
+            coverage='structural_signature_inventory_only; no_certificate_digest_trust_revocation_or_legal_validation')
+        budget = _inline_budget()
+        return _encode(result) if _fits(result, budget) else _capacity(budget)
+    except PDFSignatureError as error:
+        return _refusal(error)
+
+
+def create_unsigned(cap, fd, leaf, relative, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+    from hermes_cli.friday_workspace_zip import _path, _source, _verify, _inline_budget, _fits, _capacity, _encode
+    from tools.scoped_pdf_signatures import request, process, PDFSignatureError
+    _check_parent(cap, fd, relative)
+    try:
+        spec = request(content)
+        source = _path(spec['source'])
+        if not source.lower().endswith('.pdf') or source == relative:
+            raise ScopeDenied()
+        data, identity = _source(cap, source)
+        if hashlib.sha256(data).hexdigest() != spec['source_sha256']:
+            return _refusal('pdf_source_changed')
+        states = [(source, data, identity)]
+        output, metadata = process(cap, data, create=True)
+        check(cap)
+        receipt = dict(metadata, source=source, source_sha256=spec['source_sha256'], source_unchanged=True,
+            unsigned=True, verification_scope='native_structure_and_page_content_only; no_signature_verification',
+            preservation='page_content_resources_geometry_order_verified; signature_appearances_removed')
+        estimate = dict(receipt, success=True, path=relative, format='pdf', scope='own_user_workspace',
+            create_only=True, verified=True, bytes_written=len(output), sha256=hashlib.sha256(output).hexdigest())
+        budget = _inline_budget()
+        if not _fits(estimate, budget): return _capacity(budget)
+        _verify(cap, states)
+        result = json.loads(_create_bytes(cap, fd, leaf, relative, output, output_format='pdf',
+            verify_source=lambda: _verify(cap, states)))
+        if result.get('success'): result.update(receipt)
+        return _encode(result)
+    except PDFSignatureError as error:
+        return _refusal(error)
