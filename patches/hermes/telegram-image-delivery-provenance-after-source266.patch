+def owned_attachment_image_reference(event, path):
+    """Describe the verified image delivery method next to its scoped file reference."""
+    relative = owned_attachment_model_path(event, path)
+    if relative is None:
+        return None
+    receipts = getattr(event, '_telegram_media_receipts', None)
+    receipt = receipts.get(path) if isinstance(receipts, dict) else None
+    presentation = receipt.get('presentation') if isinstance(receipt, dict) else None
+    delivery = presentation.get('telegram_delivery') if isinstance(presentation, dict) else None
+    if delivery == 'photo':
+        return f'{relative} [Telegram photo rendition]'
+    if delivery == 'document':
+        return f'{relative} [Telegram file attachment]'
+    return relative
