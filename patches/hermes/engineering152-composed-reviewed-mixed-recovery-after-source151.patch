+"""Hash-bound, byte-preserving literal TXT edits through the existing publisher."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+import re
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _archive_spec, _path, _source, _verify, _inline_budget, _fits, _encode
+
+GUIDANCE = (
+    'For an exact literal correction of an existing UTF-8 TXT, use format=text_edit '
+    'and a NEW .txt output path. Content is JSON exactly {source,source_sha256,old_text,new_text}; '
+    'use the current read_file hash and explicitly requested old/new literals. '
+    'The old literal must occur exactly once. Every other source byte, including BOM, '
+    'line endings and the presence or absence of a final newline, is retained. '
+    'Do not reconstruct the entire file from a displayed excerpt. The source stays unchanged. '
+)
+
+
+class TextEditRefused(ValueError):
+    pass
+
+
+def replace_literal(original, expected_sha256, old_text, new_text):
+    """Change one explicitly identified UTF-8 byte span, with no newline normalization."""
+    if (type(original) is not bytes or len(original) > 1000000
+            or type(expected_sha256) is not str
+            or re.fullmatch(r'[0-9a-f]{64}', expected_sha256) is None):
+        raise TextEditRefused('source_identity_required')
+    if hashlib.sha256(original).hexdigest() != expected_sha256:
+        raise TextEditRefused('source_hash_mismatch')
+    if type(old_text) is not str or type(new_text) is not str or not old_text:
+        raise TextEditRefused('literal_required')
+    if old_text == new_text:
+        raise TextEditRefused('edit_is_unchanged')
+    try:
+        original.decode('utf-8')
+        old, new = old_text.encode('utf-8'), new_text.encode('utf-8')
+    except UnicodeError:
+        raise TextEditRefused('utf8_required') from None
+    if b'\x00' in original or b'\x00' in old or b'\x00' in new:
+        raise TextEditRefused('plain_text_required')
+    start = original.find(old)
+    if start < 0:
+        raise TextEditRefused('literal_not_found')
+    if original.find(old, start + 1) >= 0:
+        raise TextEditRefused('literal_ambiguous')
+    result = original[:start] + new + original[start + len(old):]
+    if len(result) > 1000000:
+        raise TextEditRefused('output_capacity')
+    return result
+
+
+def create_edit(cap, fd, leaf, relative, content):
+    """Create a new scoped file; never overwrite or silently retry an uncertain effect."""
+    _check_parent(cap, fd, relative)
+    relative = _path(relative)
+    if PurePosixPath(relative).suffix.lower() != '.txt' or leaf != PurePosixPath(relative).name:
+        raise ScopeDenied()
+    spec = _archive_spec(content, {'source', 'source_sha256', 'old_text', 'new_text'})
+    source = _path(spec['source'])
+    if PurePosixPath(source).suffix.lower() != '.txt' or source == relative:
+        raise ScopeDenied()
+    check(cap)
+    original, identity = _source(cap, source)
+    try:
+        data = replace_literal(original, spec['source_sha256'], spec['old_text'], spec['new_text'])
+    except TextEditRefused as error:
+        return _encode(dict(success=False, error='text_edit_refused', reason=str(error),
+                            effect_disposition='none'))
+    sources = [(source, original, identity)]
+    receipt = dict(operation='text_edit', source=source,
+                   source_sha256=hashlib.sha256(original).hexdigest(), source_unchanged=True,
+                   unselected_bytes_preserved=True, replacements=1)
+    estimate = dict(receipt, success=True, path=relative, format='txt',
+                    scope='own_user_workspace', create_only=True, verified=True,
+                    bytes_written=len(data), sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate, _inline_budget()):
+        return _encode(dict(success=False, error='text_edit_result_capacity', effect_disposition='none'))
+    _verify(cap, sources)
+    result = json.loads(_create_bytes(cap, fd, leaf, relative, data, output_format='txt',
+                                    verify_source=lambda: _verify(cap, sources)))
+    if result.get('success'):
+        result.update(receipt)
+    return _encode(result)
