+            ('cat/strRef', 'strCache', list(facts['totals']), f"Sheet1!$A$2:$A${len(facts['totals'])+1}"),
+            ('val/numRef', 'numCache', list(facts['totals'].values()), f"Sheet1!$B$2:$B${len(facts['totals'])+1}")]
