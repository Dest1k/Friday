+def _set_text(body, value):
+    """Retain the slot's paragraph/run style, refusing mixed-style replacement."""
+    paragraphs = body.findall('{%s}p' % A)
+    if not paragraphs:
+        raise PresentationRefused('template_text_slot')
+    sample = paragraphs[0]
+    runs = sample.findall('{%s}r' % A)
+    if len(runs) > 1 or sample.find('{%s}fld' % A) is not None:
+        raise PresentationRefused('template_mixed_text_style')
+    for paragraph in paragraphs[1:]:
+        if (ET.tostring(paragraph.find('{%s}pPr' % A)) if paragraph.find('{%s}pPr' % A) is not None else b'') != (
+                ET.tostring(sample.find('{%s}pPr' % A)) if sample.find('{%s}pPr' % A) is not None else b''):
+            raise PresentationRefused('template_mixed_text_style')
+        extra = paragraph.findall('{%s}r' % A)
+        if len(extra) > 1 or paragraph.find('{%s}fld' % A) is not None:
+            raise PresentationRefused('template_mixed_text_style')
+        left = runs[0].find('{%s}rPr' % A) if runs else None
+        right = extra[0].find('{%s}rPr' % A) if extra else None
+        if (ET.tostring(left) if left is not None else b'') != (ET.tostring(right) if right is not None else b''):
+            raise PresentationRefused('template_mixed_text_style')
+    for paragraph in paragraphs:
+        body.remove(paragraph)
+    for line in value.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
+        paragraph = deepcopy(sample)
+        for child in list(paragraph):
+            if child.tag not in ('{%s}pPr' % A, '{%s}endParaRPr' % A):
+                paragraph.remove(child)
+        run = deepcopy(runs[0]) if runs else ET.Element('{%s}r' % A)
+        for child in list(run):
+            if child.tag != '{%s}rPr' % A:
+                run.remove(child)
+        node = ET.SubElement(run, '{%s}t' % A)
+        node.set('{http://www.w3.org/XML/1998/namespace}space', 'preserve')
+        node.text = line
+        end = paragraph.find('{%s}endParaRPr' % A)
+        paragraph.insert(list(paragraph).index(end) if end is not None else len(paragraph), run)
+        body.append(paragraph)
+
