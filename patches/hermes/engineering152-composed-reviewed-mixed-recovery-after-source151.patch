+++ b/hermes_cli/friday_schema_guidance.py
@@ -0,0 +1,70 @@
+"""Share repeated documentation inside a file-tool schema without losing it.
+
+Format implementations put the same guidance in the tool, content and format
+descriptions. Repeating that prose can exceed a bounded request before a single
+ordinary question reaches the model. Only complete, identical description
+fragments are shared here; schema validation and executable tools are untouched.
+"""
+from __future__ import annotations
+
+import copy
+import re
+
+# Include the request projection in ordinary persisted tool-pin identity. The
+# donor build/version may stay unchanged when this product overlay is updated.
+PROJECTION_REVISION = "friday.file-schema-guidance.v1"
+
+_SHARED_PREFIX = "The shared requirements in "
+
+
+def _parts(text: str) -> list[str]:
+    return re.split(r"(?<=[.!?])(?=\s)", text)
+
+
+def share_file_schema_guidance(definition: dict) -> dict:
+    """Return a request-local schema with each shared requirement present once.
+
+    The caller selects an admitted ordinary file schema. No registry lookup,
+    capability cache or privilege decision belongs in this pure projection.
+    The complete tool description is kept byte-for-byte. Unique parameter prose,
+    even a near-duplicate differing by one character, is also kept byte-for-byte.
+    """
+    function = definition.get("function", {})
+    if function.get("name") not in {"read_file", "write_file"}:
+        return definition
+    main = function.get("description")
+    properties = function.get("parameters", {}).get("properties")
+    if not isinstance(main, str) or not isinstance(properties, dict):
+        return definition
+    sources = [("the tool description", {part.strip() for part in _parts(main)})]
+    replacements = {}
+    for name, prop in properties.items():
+        if not isinstance(prop, dict) or not isinstance(prop.get("description"), str):
+            continue
+        text = prop["description"]
+        parts = _parts(text)
+        kept = []
+        shared = []
+        for part in parts:
+            literal = part.strip()
+            source = next((label for label, sentences in sources
+                           if len(literal) >= 40 and not literal.startswith(_SHARED_PREFIX)
+                           and literal in sentences), None)
+            if source is None:
+                kept.append(part)
+            elif source not in shared:
+                shared.append(source)
+        remaining = "".join(kept)
+        if shared:
+            # Reference only descriptions that are still in this same schema.
+            # No file fetch or extra model round trip is needed to recover them.
+            pointer = _SHARED_PREFIX + " and ".join(shared) + " also apply. "
+            replacements[name] = pointer + remaining
+        sources.append((f"the {name} parameter description",
+                        {part.strip() for part in _parts(remaining)}))
+    if not replacements:
+        return definition
+    result = copy.deepcopy(definition)
+    for name, description in replacements.items():
+        result["function"]["parameters"]["properties"][name]["description"] = description
+    return result
