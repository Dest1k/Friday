+        ref = node.find('/'.join('{%s}%s' % (C, part) for part in path.split('/')))
+        if ref is None:
+            raise PresentationRefused('template_chart_cache')
+        ref.clear()
+        ET.SubElement(ref, '{%s}f' % C).text = formula
+        cache = ET.SubElement(ref, '{%s}%s' % (C, cache_name))
+        if cache_name == 'numCache':
+            ET.SubElement(cache, '{%s}formatCode' % C).text = '0.00'
+        ET.SubElement(cache, '{%s}ptCount' % C, val=str(len(values)))
+        for index, value in enumerate(values):
+            point = ET.SubElement(cache, '{%s}pt' % C, idx=str(index))
+            ET.SubElement(point, '{%s}v' % C).text = value
+    external = root.find('{%s}externalData' % C)
+    rels = _rels(parts, _relpath(name))
