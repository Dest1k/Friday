+"""Pure replay projection for gateway control notes and user context sidecars."""
+
+from typing import Any
+
+_AUTO_CONTINUE_NOTE_PREFIX = "[System note: Your previous turn"
+_AUTO_CONTINUE_FALLBACK_PREFIX = "[System note: A new message"
+
+
+def _is_auto_continue_noise(content: Any) -> bool:
+    return isinstance(content, str) and content.startswith(
+        (_AUTO_CONTINUE_NOTE_PREFIX, _AUTO_CONTINUE_FALLBACK_PREFIX))
+
+
+def _strip_auto_continue_noise(content: Any) -> Any:
+    """Remove only the existing leading gateway note protocol on replay."""
+    if not _is_auto_continue_noise(content):
+        return content
+    text = content
+    while _is_auto_continue_noise(text):
+        end = text.find("]")
+        if end < 0:
+            return ""
+        text = text[end + 1:].lstrip()
+    return text
+
+
+def project_replayed_user_row(row: dict) -> dict:
+    """Drop stale control notes without dropping the attached source evidence.
+
+    The sidecar is retained only when its normalized base exactly matches the
+    normalized user text, followed by the existing context separator. Its suffix
+    is never reconstructed, shortened, or borrowed from another user row.
+    """
+    if row.get("role") != "user" or not isinstance(row.get("content"), str):
+        return row
+    content = _strip_auto_continue_noise(row["content"])
+    sidecar = row.get("api_content")
+    projected = _strip_auto_continue_noise(sidecar)
+    if content == row["content"] and projected == sidecar:
+        return row
+    result = dict(row, content=content)
+    if isinstance(projected, str) and content and (
+            projected == content or projected.startswith(content + "\n\n")):
+        result["api_content"] = projected
+    else:
+        result.pop("api_content", None)
+    return result
