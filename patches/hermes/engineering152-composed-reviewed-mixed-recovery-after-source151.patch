+def create_template_pptx(data, facts, spec):
+    """Five existing title/body slots and one existing native table/chart.
+
+    Positions, template fonts, palette and master/layout topology are preserved.
+    Table header keys select source columns; row count and requested flags must
+    match the existing template. Authored prose remains explicitly unverified.
+    """
+    parts, paths = _template_parts(data)
+    slides = spec['slides']; series = text(spec['series'], limit=256)
+    if not isinstance(slides, list) or len(slides) != 5:
+        raise PresentationRefused('exactly_five_slides')
+    count_table = count_chart = 0
+    for name, slide in zip(paths, slides):
+        if not isinstance(slide, dict) or set(slide) != {'title', 'body', 'table', 'chart'}:
+            raise PresentationRefused('slide_schema')
+        title = text(slide['title'], limit=256); body = text(slide['body'], empty=True)
+        if type(slide['table']) is not bool or type(slide['chart']) is not bool:
+            raise PresentationRefused('slide_flags')
+        root = _xml(parts[name]); tree = root.find('{%s}cSld/{%s}spTree' % (P, P))
+        if (tree is None or root.find('{%s}timing' % P) is not None or
+                root.get('show', '1') not in ('1', 'true')):
+            raise PresentationRefused('template_slide_shape')
+        title_shapes = []; body_shapes = []; tables = []; charts = []
+        for shape in tree:
+            if shape.tag in ('{%s}nvGrpSpPr' % P, '{%s}grpSpPr' % P):
+                continue
+            if shape.tag == '{%s}sp' % P:
+                text_body = shape.find('{%s}txBody' % P)
+                ph = shape.find('{%s}nvSpPr/{%s}nvPr/{%s}ph' % (P, P, P))
+                if text_body is None:
+                    raise PresentationRefused('template_nontext_shape')
+                (title_shapes if ph is not None and ph.get('type') in ('title', 'ctrTitle')
+                 else body_shapes).append(shape)
+            elif shape.tag == '{%s}graphicFrame' % P:
+                table = shape.find('.//{%s}tbl' % A); chart = shape.find('.//{%s}chart' % C)
+                if (table is None) == (chart is None):
+                    raise PresentationRefused('template_graphic_shape')
+                (tables if table is not None else charts).append(table if table is not None else (shape, chart))
+            else:
+                raise PresentationRefused('template_unsupported_shape')
+        if (len(title_shapes) != 1 or len(body_shapes) != 1 or len(tables) > 1 or len(charts) > 1 or
+                bool(tables) != slide['table'] or bool(charts) != slide['chart']):
+            raise PresentationRefused('template_slot_topology')
+        for shape, value in ((title_shapes[0], title), (body_shapes[0], body)):
+            _text_capacity(parts, name, shape, value)
+            _set_text(shape.find('{%s}txBody' % P), value)
+        if tables:
+            _table(tables[0], facts); count_table += 1
+        if charts:
+            frame, chart = charts[0]
+            _chart(parts, name, frame, chart.get('{%s}id' % R), facts, series); count_chart += 1
+        parts[name] = _tostring(root)
+    if count_table != 1 or count_chart != 1:
+        raise PresentationRefused('one_native_table_and_chart')
+    result = _zip(parts)
+    _parts(result)  # The published bytes must pass the same native package gate.
+    return result
