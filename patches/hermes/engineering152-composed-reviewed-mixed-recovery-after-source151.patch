+def _table(table, facts):
+    rows = table.findall('{%s}tr' % A)
+    grid = table.find('{%s}tblGrid' % A)
+    if grid is None or len(rows) < 2:
+        raise PresentationRefused('template_table_shape')
+    keys = [''.join(node.text or '' for node in cell.iter('{%s}t' % A))
+            for cell in rows[0].findall('{%s}tc' % A)]
+    allowed = {'order_id', 'sku', 'qty', 'unit_price', 'currency', 'revision'}
+    if (not keys or len(keys) != len(grid) or len(set(keys)) != len(keys) or
+            not set(keys) <= allowed or len(facts['rows']) + 1 > 12):
+        raise PresentationRefused('template_table_columns')
+    # Preserve exact row geometry; unsupported row-count changes are explicit.
+    if len(rows) != len(facts['rows']) + 1:
+        raise PresentationRefused('template_table_row_count')
+    for row, fact in zip(rows[1:], facts['rows']):
+        cells = row.findall('{%s}tc' % A)
+        if len(cells) != len(keys):
+            raise PresentationRefused('template_table_shape')
+        for cell, key in zip(cells, keys):
+            if cell.get('gridSpan') or cell.get('rowSpan') or cell.get('hMerge') or cell.get('vMerge'):
+                raise PresentationRefused('template_merged_table')
+            body = cell.find('{%s}txBody' % A)
+            if body is None:
+                raise PresentationRefused('template_table_shape')
+            try:
+                width = int(grid[list(cells).index(cell)].get('w', '0')) / 12700 - 14.4
+                height = int(row.get('h', '0')) / 12700 - 7.2
+                explicit = _max_font(body, 1800)
+                points = int(explicit) / 100
+            except (ValueError, TypeError):
+                raise PresentationRefused('template_table_geometry') from None
+            if (width <= 0 or points < 1 or points * 1.2 > height or
+                    sum(1 if c in 'WM@#%&' or ord(c) > 0x2fff else .8 for c in fact[key]) * points > width):
+                raise PresentationRefused('template_table_capacity')
+            _set_text(body, fact[key])
