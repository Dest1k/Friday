+    if pres.find('{%s}extLst' % P) is not None:
+        raise PresentationRefused('template_presentation_extension')
+    for name in ('notesMasterIdLst', 'custDataLst'):
+        for node in list(pres.findall('{%s}%s' % (P, name))):
+            pres.remove(node)
+    parts['ppt/presentation.xml'] = _tostring(pres)
+    # Standard document properties are intentionally new; no personal metadata,
+    # previews, custom properties, notes, comments or unattached source parts survive.
+    parts['docProps/core.xml'] = (
+        '<cp:coreProperties xmlns:cp="http://schemas.openxmlformats.org/package/2006/metadata/core-properties"/>'
