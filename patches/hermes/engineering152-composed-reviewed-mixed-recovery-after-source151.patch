+    wraps = wraps is None or wraps.get('wrap') != 'none'
+    lines = 0
+    for line in value.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
+        units = sum(1 if c in 'WM@#%&' or ord(c) > 0x2fff else .8 for c in line)
+        text_width = units * points
+        if width <= 0 or (not wraps and text_width > width):
+            raise PresentationRefused('template_text_capacity')
+        lines += max(1, math.ceil(text_width / width))
+    if lines * points * 1.2 > height:
+        raise PresentationRefused('template_text_capacity')
+
+
+def _relpath(owner):
+    folder, name = posixpath.split(owner)
+    return folder + '/_rels/' + name + '.rels'
+
+
+def _template_parts(data):
+    """Copy only supported reachable styling/content, excluding private parts."""
+    _, source = _parts(data)
+    if not {'[Content_Types].xml', 'ppt/presentation.xml', '_rels/.rels'} <= source.keys():
+        raise PresentationRefused('template_required_parts')
+    # Apply a stricter URI/member policy to templates without changing old modes.
+    for name in source:
+        if (any(char in name for char in '%?#:') or
+                any(ord(char) < 32 for char in name) or
+                any(piece in ('', '.', '..') for piece in name.split('/'))):
+            raise PresentationRefused('template_package_path')
+        if name.endswith('.rels'):
+            for rel in _rels(source, name).values():
+                target = rel.get('Target', '')
+                if (any(char in target for char in '%?#:') or target.startswith('//') or
+                        any(ord(char) < 32 for char in target)):
+                    raise PresentationRefused('template_relationship_uri')
+                kind = rel.get('Type', '')
+                if not kind.startswith(R + '/') and not kind.startswith(PR + '/'):
+                    raise PresentationRefused('template_relationship_type')
+    paths = _slide_paths(source)
+    if len(paths) != 5 or len(set(paths)) != 5:
+        raise PresentationRefused('template_exactly_five_slides')
+    office = [rel for rel in _rels(source, '_rels/.rels').values()
+              if rel.get('Type') == R + '/officeDocument']
+    if len(office) != 1 or _resolve('', office[0].get('Target', '')) != 'ppt/presentation.xml':
+        raise PresentationRefused('template_main_part')
+    content_types = _xml(source['[Content_Types].xml'])
+    main = [entry for entry in content_types
+            if entry.get('PartName') == '/ppt/presentation.xml']
+    if (len(main) != 1 or main[0].get('ContentType') !=
+            'application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml'):
+        raise PresentationRefused('template_main_type')
+    parts = {}; pending = ['ppt/presentation.xml']
+    while pending:
+        name = pending.pop()
+        if name in parts:
+            continue
+        root = _xml(source[name])
+        role = root.tag.rsplit('}', 1)[-1]
+        namespace = root.tag.split('}', 1)[0].lstrip('{')
+        if (role not in _ALLOWED or namespace !=
+                (C if role == 'chartSpace' else A if role in ('theme', 'tblStyleLst') else P)):
+            raise PresentationRefused('template_unsupported_part')
+        parts[name] = _tostring(root) if _sanitize_metadata(root) else source[name]
+        relname = _relpath(name)
+        relroot = ET.Element('{%s}Relationships' % PR)
+        changed = False
+        for rel in _rels(source, relname).values():
+            kind = rel.get('Type', '').rsplit('/', 1)[-1]
+            if kind in _EXCLUDED:
+                changed = True
+                continue
+            if kind not in _ALLOWED[role] or rel.get('Type') != R + '/' + kind:
+                raise PresentationRefused('template_unsupported_relationship')
+            target = _resolve(name, rel.get('Target', ''))
+            relroot.append(deepcopy(rel))
+            if kind == 'package':
+                # Rebuilt from bound facts below, never copy historical workbook data.
+                if not target.lower().endswith('.xlsx'):
+                    raise PresentationRefused('template_chart_workbook')
+                parts[target] = b''
+            else:
+                pending.append(target)
+        if len(relroot):
+            parts[relname] = _tostring(relroot) if changed else source[relname]
