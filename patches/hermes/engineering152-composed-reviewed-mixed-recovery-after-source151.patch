+"""Narrow authored PPTX adapter: replace existing editable template slots.
+
+The existing writer owns the package limits, data projection and output format.
+This adapter never renders, executes, converts, or fetches template resources.
+"""
+from copy import deepcopy
+import math
+import posixpath
+from xml.etree import ElementTree as ET
+
+from tools.scoped_presentation_write import (
+    A, C, P, PR, R, PresentationRefused, _parts, _rels, _resolve,
+    _slide_paths, _tostring, _workbook, _xml, _zip, text,
+)
+
+CT = 'http://schemas.openxmlformats.org/package/2006/content-types'
+_ALLOWED = {
+    'presentation': {'slide', 'slideMaster', 'theme', 'tableStyles'},
+    'sld': {'slideLayout', 'chart'},
+    'sldLayout': {'slideMaster'},
+    'sldMaster': {'slideLayout', 'theme'},
+    'chartSpace': {'package'},
+    'theme': set(), 'tblStyleLst': set(),
+}
+_EXCLUDED = {'notesMaster', 'notesSlide', 'comments', 'commentAuthors',
+             'person', 'threadedComment', 'tags', 'presProps', 'viewProps',
+             'printerSettings'}
+
+
+def _sanitize_metadata(root):
+    changed = False
+    for node in root.iter():
+        if node.tag == '{%s}cNvPr' % P:
+            if node.get('hidden', '0') not in ('0', 'false'):
+                raise PresentationRefused('template_hidden_shape')
+            safe = {'id': node.get('id', ''), 'name': 'Shape ' + node.get('id', '')}
+            if node.attrib != safe:
+                node.attrib.clear(); node.attrib.update(safe); changed = True
+        elif node.tag == '{%s}cSld' % P:
+            if 'name' in node.attrib:
+                del node.attrib['name']; changed = True
+        elif node.tag in ('{%s}theme' % A, '{%s}clrScheme' % A,
+                          '{%s}fontScheme' % A, '{%s}fmtScheme' % A):
+            if node.get('name') != 'Template':
+                node.set('name', 'Template'); changed = True
+    return changed
+
+
+def _max_font(root, default=None):
+    """Conservatively cover every explicit paragraph/run size in a slot."""
+    sizes = []
+    for tag in ('rPr', 'defRPr'):
+        for node in root.iter('{%s}%s' % (A, tag)):
+            if node.get('sz') is not None:
+                try:
+                    size = int(node.get('sz'))
+                except ValueError:
+                    raise PresentationRefused('template_text_font') from None
+                if not 100 <= size <= 40000:
+                    raise PresentationRefused('template_text_font')
+                sizes.append(size)
+    return max(sizes) if sizes else default
+
+
+def _text_capacity(parts, owner, shape, value):
+    """Conservative slot budget, independent of rendering/autofit behavior."""
+    body = shape.find('{%s}txBody' % P)
+    old = '\n'.join(''.join(n.text or '' for n in p.iter('{%s}t' % A))
+                    for p in body.findall('{%s}p' % A))
+    # Reusing unchanged template text cannot introduce a new overflow.
+    if value == old:
+        return
+    ph = shape.find('{%s}nvSpPr/{%s}nvPr/{%s}ph' % (P, P, P))
+    chain = [shape]; master = None
+    current = owner
+    for kind in ('slideLayout', 'slideMaster'):
+        matches = [r for r in _rels(parts, _relpath(current)).values()
+                   if r.get('Type') == R + '/' + kind]
+        if len(matches) != 1:
+            raise PresentationRefused('template_text_inheritance')
+        current = _resolve(current, matches[0].get('Target', ''))
+        inherited = _xml(parts[current])
+        if kind == 'slideMaster':
+            master = inherited
+        if ph is not None:
+            candidates = []
+            for candidate in inherited.findall('.//{%s}sp' % P):
+                other = candidate.find('{%s}nvSpPr/{%s}nvPr/{%s}ph' % (P, P, P))
+                if other is not None and ((ph.get('idx') is not None and other.get('idx') == ph.get('idx')) or
+                        (ph.get('idx') is None and other.get('type', 'obj') == ph.get('type', 'obj'))):
+                    candidates.append(candidate)
+            if len(candidates) > 1:
+                raise PresentationRefused('template_text_inheritance')
+            chain.extend(candidates)
+    bounds = font = None
+    for candidate in chain:
+        if bounds is None:
+            ext = candidate.find('{%s}spPr/{%s}xfrm/{%s}ext' % (P, A, A))
+            if ext is not None:
+                try:
+                    bounds = (int(ext.get('cx', '0')) / 12700, int(ext.get('cy', '0')) / 12700)
+                except ValueError:
+                    raise PresentationRefused('template_text_geometry') from None
+        if font is None:
+            font = _max_font(candidate)
+    if font is None:
+        role = ph.get('type', 'obj') if ph is not None else ''
+        style = 'titleStyle' if role in ('title', 'ctrTitle') else 'bodyStyle' if role in ('body', 'obj') else 'otherStyle'
+        default = master.find('{%s}txStyles/{%s}%s/{%s}lvl1pPr/{%s}defRPr' % (P, P, style, A, A))
+        if default is not None:
+            font = default.get('sz')
+    try:
+        points = int(font) / 100
+    except (ValueError, TypeError):
+        raise PresentationRefused('template_text_font') from None
+    if bounds is None or not 1 <= points <= 400 or min(bounds) <= 0:
+        raise PresentationRefused('template_text_geometry')
