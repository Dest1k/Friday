+"""Exact D01 RTF receiver control on the existing bounded ordinary window."""
+
+from dataclasses import dataclass
+from hashlib import sha256
+import time
+
+from .d01_rtf_custody import CAPTION_SHA256, SCENARIO_SHA256, TERMINAL_SCHEMA, match_document
