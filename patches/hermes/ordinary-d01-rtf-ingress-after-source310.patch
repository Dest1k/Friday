+@dataclass(frozen=True, slots=True)
+class _BoundCutoff:
+    run_id: str
+    cutoff: float
+    original_proof_sha256: str
+    sender_message_id: int
+    sender: dict
+    ack_started: float
+    ack_completed: float
+
+
+def _original_cutoff(window_cutoff, verified, scenario):
+    run = verified["run"]
+    sender = ReceiverControl._ordinary_document_ack(
+        run, verified["ack"], scenario, "d01_rtf_exact_original_document_ack")
+    before, after = verified["ack_monotonic"]
+    require(sender["caption_sha256"] == CAPTION_SHA256 and 0 < sender["date"] < 2**63
+            and type(sender["date"]) is int and window_cutoff == after + 180,
+            "d01_rtf_exact_original_ack_cutoff")
+    proof = {
+        "ack": run["sent_api_ack_reference"], "window": run["sent_window_reference"],
+        "clock": verified["original_clock"], "wall_cutoff": run["capture_until"],
+        "task": run["sent_task_reference"],
+    }
+    return _BoundCutoff(run["id"], window_cutoff, sha256(_encode(proof)).hexdigest(),
+                        run["sent_message_id"], sender, before, after)
+
+
+class D01RTFReceiverControl(ReceiverControl):
+    request_schema = "frw.gateway.d01-rtf-owned-receiver-control.v1"
+    options_schema = "frw.Root.D01RTF.receiver-options.v1"
+    driver_schema = "frw.Root.D01RTF.owned-ordinary-driver.v1"
+    exact_phases = frozenset((SCENARIO_SHA256,))
+    terminal_schema = TERMINAL_SCHEMA
+    strict_terminal_extra = True
+
+    def _wire_options(self, intent):
+        return {"selected_d01_rtf": (SCENARIO_SHA256, intent["run_id"])}
+
+    @staticmethod
+    def _check_ack_window(run, ack, window, scenario):
+        ReceiverControl._check_ack_window(run, ack, window, scenario)
+        sender = ReceiverControl._ordinary_document_ack(
+            run, ack, scenario, "d01_rtf_exact_original_document_ack")
+        require(sender["caption_sha256"] == CAPTION_SHA256 and type(sender["date"]) is int
+                and 0 < sender["date"] < 2**63, "d01_rtf_exact_original_document_ack")
+
+    def _bind_terminal_cutoff(self, arm, window, cutoff, verified):
+        ingress = arm.ingress
+        run = verified["run"]
+        binding = _original_cutoff(cutoff, verified, run["scenario"])
+        wire = ingress._wire()
+        require(arm.claim.selected_d01_rtf == (SCENARIO_SHA256, binding.run_id)
+                and arm.window is window is ingress.window and ingress._d01_rtf_cutoff is None
+                and wire is not None and wire["state"] == "OPEN" and time.monotonic() < cutoff,
+                "d01_rtf_exact_open_cutoff_required")
+        window.bind_cutoff(cutoff)
+        ingress._d01_rtf_cutoff = binding
+
+    def _terminal_extra(self, arm, route, scenario, joined, verified, deadline):
+        ingress = arm.ingress
+        wire = ingress._wire()
+        require(wire is not None and wire["state"] == "LOCAL_WIRE_CLOSED"
+                and ingress._settlement_state() == "SETTLED"
+                and len(wire["target_update_ids"]) == 1 and len(joined["observations"]) == 1,
+                "d01_rtf_exact_closed_singleton_required")
+        bound = ingress._d01_rtf_cutoff
+        require(bound is not None and arm.claim.selected_d01_rtf == (SCENARIO_SHA256, bound.run_id)
+                and bound == _original_cutoff(arm.window._cutoff, verified, scenario)
+                and wire["empty_boundary"][0] >= bound.cutoff,
+                "d01_rtf_original_cutoff_or_ack_changed")
+        update, = wire["target_update_ids"]
+        record = ingress._built[update]
+        candidate, publication = record.d01_rtf_native, record.d01_rtf_publication
+        require(candidate is not None and publication is not None and candidate.raw is None
+                and bound.ack_started <= candidate.observed_monotonic < bound.cutoff
+                and all(candidate.sdk[key] == value for key, value in bound.sender.items()),
+                "d01_rtf_original_ack_sdk_document_mismatch")
+        (receipt, raw_caption), = joined["observations"]
+        message = receipt["message"]
+        sdk = candidate.sdk
+        require(sdk["update_id"] == str(update) and raw_caption == candidate.caption()
+                and receipt["platform"] == "telegram" and receipt["chat_type"] == "dm"
+                and all(receipt[key] == value for key, value in route.items())
+                and match_document(sdk, message)
+                and message["media"][0]["local_reference"] == str(publication.evidence.path),
+                "d01_rtf_exact_durable_route_pair_required")
+
+        def current():
+            return (time.monotonic() < deadline and ingress._wire() == wire
+                    and ingress._settlement_state() == "SETTLED" and ingress._d01_rtf_cutoff is bound)
+
+        require(current() and verify_published_d01_rtf_input(publication, still_current=current)
+                and current(), "d01_rtf_original_publication_identity_changed")
+        item = publication.evidence
+        return {
+            "d01_rtf_wire": wire,
+            "d01_rtf_first_offset": arm.first_offset,
+            "d01_rtf_original_ack": verified["run"]["sent_api_ack_reference"],
+            "d01_rtf_sender_message_id": str(bound.sender_message_id),
+            "d01_rtf_receiver_update_id": sdk["update_id"],
+            "d01_rtf_receiver_message_id": sdk["native_message_id"],
+            "d01_rtf_receiver_observed_monotonic": candidate.observed_monotonic,
+            "d01_rtf_publication": {
+                "path": str(item.path), "sha256": item.sha256, "bytes": item.size_bytes,
+                "source_identity": list(item.source_identity),
+                "directory_identities": [list(identity) for identity in publication.directories],
+            },
+        }
+
+
+def ordinary_d01_rtf_receiver_verb(runner, loop):
+    return _ordinary_receiver_verb(runner, loop, control_type=D01RTFReceiverControl)
