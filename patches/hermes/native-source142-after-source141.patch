+MAX_BYTES = 1_000_000
+MAX_TEXT_BYTES = 1_000_000
+MAX_PAGES = 64
+MAX_ENTRIES = 128
+MAX_CHUNKS = 4096
+WALL_SECONDS = 12
+CPU_SECONDS = 4
+MEMORY_BYTES = 384 * 1024 * 1024
+_WIRE_MAX = 6_100_000
+_LIBRARY = '/usr/lib/x86_64-linux-gnu/libdjvulibre.so.21.8.0'
+_VERSION = 'DjVuLibre-3.5.29'
+_CODES = frozenset('djvu_input_limit djvu_invalid_iff djvu_profile_unsupported djvu_indirect_unsupported djvu_external_dependency djvu_structure_limit djvu_text_limit djvu_text_invalid djvu_codec_unavailable djvu_worker_failed djvu_resource_limit djvu_cleanup_unconfirmed djvu_custody_busy djvu_authority_changed'.split())
+
+class DjVuError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+class DjVuText(str):
+    def __new__(cls, text, metadata):
+        result = super().__new__(cls, text)
+        result.extraction_metadata = metadata
+        return result
