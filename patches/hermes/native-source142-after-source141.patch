+        raise DjVuError('djvu_invalid_iff')
+    kind = data[12:16]
+    if kind not in (b'DJVU', b'DJVM'):
+        raise DjVuError('djvu_profile_unsupported')
+    counts = [0]
+    def chunks(start, end):
+        result=[]
+        while start < end:
+            checkpoint()
+            if end-start < 8: raise DjVuError('djvu_invalid_iff')
+            tag=data[start:start+4]; size=int.from_bytes(data[start+4:start+8], 'big')
+            stop=start+8+size
+            if stop>end: raise DjVuError('djvu_invalid_iff')
+            counts[0]+=1
+            if counts[0]>MAX_CHUNKS: raise DjVuError('djvu_structure_limit')
+            result.append((tag,start,size))
+            start=stop+(size&1)
+            # Last odd-sized chunk may omit its pad at the enclosing boundary.
+            if start>end and stop!=end: raise DjVuError('djvu_invalid_iff')
+        return result
+    forms=[]; offsets=[]
+    if kind==b'DJVU':
+        forms=[(b'DJVU',4,len(data)-12)]
+    else:
