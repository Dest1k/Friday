+def extract_djvu(data, *, checkpoint=None):
+    if checkpoint is None: checkpoint=lambda:None
+    if not callable(checkpoint): raise DjVuError('djvu_invalid_iff')
+    expected=_parse(data,checkpoint)
+    work=None
+    try:
+        checkpoint()
+        try:
+            library=Path(_LIBRARY).resolve(strict=True); info=library.stat()
+            if not stat.S_ISREG(info.st_mode) or info.st_uid!=0 or info.st_mode&0o022:
+                raise DjVuError('djvu_codec_unavailable')
+            work=Path(tempfile.mkdtemp(prefix='friday-djvu-')); work.chmod(0o700)
+            for name,payload in (('runner.py',Path(__file__).read_bytes()),('input.djvu',data)):
+                with (work/name).open('xb') as stream: stream.write(payload)
+                (work/name).chmod(0o600)
+        except OSError: raise DjVuError('djvu_codec_unavailable') from None
+        pages=_response(_run(work,checkpoint),expected)
+        checkpoint()
+        lines=[]
+        for n,row in enumerate(pages,1):
+            lines.append('[Page %d: %s]'%(n,'stored text layer' if row['has_text'] else 'no stored text layer'))
+            if row['text']: lines.append(row['text'])
+        metadata=dict(format='djvu',profile='bounded_single_or_bundled_djvu_stored_text',
+            semantic_status='PARTIAL',coverage='stored_page_text_layer_projection_only; unzoned_text_not_covered; no_OCR_images_rendering_or_visible_text_verification',
+            source_sha256=hashlib.sha256(data).hexdigest(),pages=len(pages),
+            pages_with_text=sum(r['has_text'] for r in pages),chunks=expected['chunks'],
+            page_structure=[dict(page=n,declared_width=r['width'],declared_height=r['height'],
+                                 stored_text_chunk=r['text'],internal_includes=len(r['incl']))
+                            for n,r in enumerate((x for x in expected['rows'] if x['kind']=='DJVU'),1)],
+            bundled=expected['bundled'],rendered=False,external_resources_loaded=False,
+            scripts_executed=False,decoder=_VERSION,
+            limitations=['Stored page-zone text may differ from page images; unzoned text is not covered.','Annotations, navigation, images and layout are not interpreted.'])
+        return DjVuText('\n'.join(lines),metadata)
+    finally:
+        if work is not None:
+            try: shutil.rmtree(work)
+            except OSError:
+                from agent.web_call_context import _current
+                call=_current.get()
+                if call is not None and hasattr(call,'agent'): call.agent._friday_reply_effect_unknown=True
+                raise DjVuError('djvu_cleanup_unconfirmed') from None
