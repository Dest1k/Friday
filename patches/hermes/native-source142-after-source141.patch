+        if not outer or outer[0][0]!=b'DIRM': raise DjVuError('djvu_invalid_iff')
+        _,pos,size=outer[0]
+        if size<3: raise DjVuError('djvu_invalid_iff')
+        flag=data[pos+8]; count=int.from_bytes(data[pos+9:pos+11],'big')
+        if not flag&128: raise DjVuError('djvu_indirect_unsupported')
+        if flag!=129: raise DjVuError('djvu_profile_unsupported')
+        if not 1<=count<=MAX_ENTRIES: raise DjVuError('djvu_structure_limit')
+        if size<=3+count*4: raise DjVuError('djvu_invalid_iff')
