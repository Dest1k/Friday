+def _child():
+    import resource
+    os.umask(0o077)
+    os.sched_setaffinity(0,sorted(os.sched_getaffinity(0))[:2])
+    for key,value in ((resource.RLIMIT_AS,MEMORY_BYTES),(resource.RLIMIT_CPU,CPU_SECONDS),
+                      (resource.RLIMIT_FSIZE,0),(resource.RLIMIT_CORE,0),(resource.RLIMIT_NOFILE,32),
+                      (resource.RLIMIT_NPROC,16)):
+        resource.setrlimit(key,(value,value))
+    try:
+        data=Path('/work/input.djvu').read_bytes();expected=_parse(data,lambda:None)
+        response=_native_decode(data,expected)
+    except DjVuError as error: response={'error':str(error) if str(error) in _CODES else 'djvu_worker_failed'}
+    except (OSError,AttributeError,ImportError): response={'error':'djvu_codec_unavailable'}
+    except MemoryError: response={'error':'djvu_resource_limit'}
+    except BaseException: response={'error':'djvu_text_invalid'}
+    raw=json.dumps(response,ensure_ascii=True,separators=(',',':')).encode('ascii')
+    if len(raw)>_WIRE_MAX: raw=b'{"error":"djvu_text_limit"}'
+    sys.stdout.buffer.write(raw);sys.stdout.buffer.flush()
+
+if __name__=='__main__':
+    if sys.argv[1:]==['--child']: _child()
+    else: raise SystemExit(2)
