+    class File(C.Structure):
+        _fields_=[('type',C.c_char),('pageno',C.c_int),('size',C.c_int),('id',C.c_void_p),('name',C.c_void_p),('title',C.c_void_p)]
+    lib=C.CDLL(_LIBRARY); p=C.c_void_p; i=C.c_int
+    signatures={
+        'ddjvu_get_version_string':(C.c_char_p,[]),'ddjvu_context_create':(p,[C.c_char_p]),
+        'ddjvu_context_release':(None,[p]),'ddjvu_cache_set_size':(None,[p,C.c_ulong]),
+        'ddjvu_document_create':(p,[p,C.c_char_p,i]),'ddjvu_document_job':(p,[p]),
+        'ddjvu_job_status':(i,[p]),'ddjvu_job_release':(None,[p]),'ddjvu_job_stop':(None,[p]),
+        'ddjvu_message_peek':(p,[p]),'ddjvu_message_pop':(None,[p]),
+        'ddjvu_stream_write':(None,[p,i,p,C.c_ulong]),'ddjvu_stream_close':(None,[p,i,i]),
+        'ddjvu_document_get_type':(i,[p]),'ddjvu_document_get_pagenum':(i,[p]),
+        'ddjvu_document_get_filenum':(i,[p]),'ddjvu_document_get_fileinfo_imp':(i,[p,i,C.POINTER(File),C.c_uint]),
+        'ddjvu_document_get_pagetext':(p,[p,i,C.c_char_p]),'ddjvu_miniexp_release':(None,[p,p]),
+        'miniexp_nth':(p,[i,p]),'miniexp_length':(i,[p]),'miniexp_stringp':(i,[p]),
+        'miniexp_to_lstr':(C.c_size_t,[p,C.POINTER(p)])}
