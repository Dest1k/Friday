+
+IFF structure and bundled offsets are checked before the decoder. The decoder
+never renders or follows files/URLs; its only input stream is the checked bytes.
+No creation, editing, OCR, annotations or visible-text/fidelity claim.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import selectors
+import shutil
+import stat
