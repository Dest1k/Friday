+class _Table:
+    """Map authored cells to the flat text and to their occupied grid slots."""
+
+    def __init__(self, depth):
+        self.depth = depth
+        self.rows = []
+        self.row_ends = {}
+        self.cell_count = 0
+        self.group = 0
+        self.section = 'table'
+        self.sections = set()
+        self.column_groups = []
+        self.declared_group_span = None
+        self.column_child_span = 0
+        self.invalid = False
+
+    def span(self, attrs, attribute):
+        value = attrs.get(attribute, '1')
+        if not re.fullmatch(r'[0-9]{1,3}', value) or not 1 <= int(value) <= MAX_TABLE_SLOTS:
+            self.invalid = True
+            return 0
+        return int(value)
+
+    def start(self, tag, parent, attrs, out_index):
+        if tag == 'colgroup':
+            if parent != 'table' or self.sections or len(self.column_groups) == MAX_TABLE_SLOTS:
+                self.invalid = True
+                return
+            self.declared_group_span = self.span(attrs, 'span') if 'span' in attrs else None
+            self.column_child_span = 0
+        elif tag == 'col':
+            if parent != 'colgroup' or self.declared_group_span is not None:
+                self.invalid = True
+                return
+            self.column_child_span += self.span(attrs, 'span')
+            self.invalid |= self.column_child_span > MAX_TABLE_SLOTS
+        elif tag in ('thead', 'tbody', 'tfoot'):
+            self.invalid |= (parent != 'table' or 'direct_rows' in self.sections
+                             or 'tfoot' in self.sections or tag == 'thead' and bool(self.sections))
+            self.sections.add(tag)
+            self.group += 1
+            self.section = tag
+        elif tag == 'tr':
+            self.invalid |= parent not in ('table', self.section)
+            if parent == 'table':
+                self.invalid |= bool(self.sections - {'direct_rows'})
+                self.sections.add('direct_rows')
+            if len(self.rows) == MAX_TABLE_SLOTS:
+                self.invalid = True
+                return
+            self.rows.append((self.group, self.section, out_index, []))
+        elif tag in ('th', 'td'):
+            self.cell_count += 1
+            if (parent != 'tr' or not self.rows or 'headers' in attrs
+                    or self.cell_count > MAX_TABLE_SLOTS):
+                self.invalid = True
+                return
+            scope = attrs.get('scope', '').lower()
+            if scope not in ('', 'row', 'col', 'colgroup') or tag == 'td' and scope:
+                self.invalid = True
+            rowspan, colspan = (self.span(attrs, name) for name in ('rowspan', 'colspan'))
+            if not self.invalid:
+                self.rows[-1][3].append((tag, scope, rowspan, colspan, out_index))
+        elif parent in ('table', 'thead', 'tbody', 'tfoot', 'tr', 'colgroup'):
+            self.invalid |= (parent, tag) not in (('table', 'caption'), ('table', 'colgroup'), ('colgroup', 'col'))
+
+    def end(self, tag, out):
+        if tag in ('td', 'th'):
+            start = self.rows[-1][3][-1][-1]
+            value = ''.join(out[start:])
+            if '\t' in value or len((value + '.').splitlines()) != 1:
+                self.invalid = True
+        if tag == 'tr':
+            self.row_ends[self.rows[-1][2]] = len(out)
+        if tag == 'colgroup':
+            self.column_groups.append(self.declared_group_span or self.column_child_span or 1)
+            self.invalid |= sum(self.column_groups) > MAX_TABLE_SLOTS
+        if tag in ('thead', 'tbody', 'tfoot'):
+            self.group += 1
+            self.section = 'table'
+
+    def project(self, lines, flat, out):
+        if self.invalid or not self.rows:
+            return None
+        # Use the authored row sections and positive spans. Do not repair holes
+        # or overlaps as a browser might, or infer from repeated header text.
+        grid, cells = set(), []
+        first_cells = self.rows[0][3]
+        leading_headers = (self.rows[0][1] == 'table' and first_cells
+                           and all(tag == 'th' and scope != 'row' for tag, scope, *_ in first_cells))
+        for row, (group, section, start, authored) in enumerate(self.rows, 1):
+            line = lines[start]
+            rendered = re.sub(r' +', ' ', ''.join(out[start:self.row_ends[start]])).strip()
+            if (not authored or not line or not rendered or flat[line - 1] != rendered
+                    or len(rendered.split('\t')) != len(authored)):
+                return None
+            header_row = section == 'thead' or row == 1 and leading_headers
+            column = 1
+            for field, (tag, scope, rowspan, colspan, _) in enumerate(authored, 1):
+                while (row, column) in grid:
+                    column += 1
+                if (row + rowspan - 1 > len(self.rows) or self.rows[row + rowspan - 2][0] != group
+                        or len(grid) + rowspan * colspan > MAX_TABLE_SLOTS):
+                    return None
+                if tag == 'th':
+                    if scope == 'colgroup':
+                        scope = 'column_group'
+                    elif scope == 'col' or not scope and header_row:
+                        scope = 'column'
+                    elif scope == 'row' or (not scope and field == rowspan == colspan == 1
+                                            and section in ('table', 'tbody')):
+                        scope = 'row'
+                    else:
+                        return None
+                if header_row != (scope in ('column', 'column_group')):
+                    return None
+                for y in range(row, row + rowspan):
+                    for x in range(column, column + colspan):
+                        if (y, x) in grid:
+                            return None
+                        grid.add((y, x))
+                cell = dict(row=row, column=column, rowspan=rowspan, colspan=colspan,
+                            line=line, field=field, kind=scope or 'data', column_headers=[],
+                            row_headers=[], column_group_headers=[])
+                cells.append(cell)
+                column += colspan
+        width = max(column for _, column in grid)
+        if len(grid) != len(self.rows) * width or sum(self.column_groups) > width:
+            return None
+
+        membership = [None] * (width + 1)
+        first = 1
+        for index, span in enumerate(self.column_groups):
+            membership[first:first + span] = [index] * span
+            first += span
+        group_headers = [[] for _ in self.column_groups]
+        columns = [[] for _ in range(width + 1)]
+        rows = [[] for _ in range(len(self.rows) + 1)]
+        refs = 0
+        for cell in cells:
+            y, x = cell['row'], cell['column']
+            if cell['kind'] in ('column', 'column_group'):
+                for column in range(x, x + cell['colspan']):
+                    columns[column].append((y, x))
+                if cell['kind'] == 'column_group':
+                    group = membership[x]
+                    if group is None:
+                        return None
+                    group_headers[group].append((y, x))
+            elif cell['kind'] == 'row':
+                if x != 1:
+                    return None
+                for row in range(y, y + cell['rowspan']):
+                    rows[row].append((y, x))
+        for cell in cells:
+            if cell['kind'] in ('column', 'column_group'):
+                continue
+            y, x = cell['row'], cell['column']
+            column_headers = sorted({anchor
+                for column in range(x, x + cell['colspan']) for anchor in columns[column]})
+            row_headers = (sorted({anchor
+                for row in range(y, y + cell['rowspan']) for anchor in rows[row]})
+                if cell['kind'] == 'data' else [])
+            group = membership[x]
+            scoped_groups = [] if group is None else [
+                (row, col) for row, col in group_headers[group]
+                if row < y + cell['rowspan'] and col < x + cell['colspan']
+            ]
+            refs += len(column_headers) + len(row_headers) + len(scoped_groups)
+            if refs > MAX_TABLE_REFS:
+                return None
+            cell.update(column_headers=column_headers, row_headers=row_headers,
+                        column_group_headers=scoped_groups)
+        return dict(status='AVAILABLE',
+                    row_sections=[section for _, section, _, _ in self.rows],
+                    cells=[[cell[key] for key in TABLE_CELL_FIELDS] for cell in cells])
+
