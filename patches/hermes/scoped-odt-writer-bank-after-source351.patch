+        raw = maps.read(_MAP_LIMIT + 1)
+    if not raw or len(raw) > _MAP_LIMIT:
+        raise ValueError('pdf_writer_viewer_engine')
+    for line in raw.splitlines():
+        fields = line.split(None, 5)
+        if len(fields) == 6 and fields[1][2:3] == b'x':
+            yield fields
+
+
