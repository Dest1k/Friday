+"""Resolve the locally provisioned tagged Writer bank and verify its mounted bytes."""
+from hashlib import file_digest, sha256
+import json
+import os
+from pathlib import Path
+import re
+import stat
+from contextlib import ExitStack
+
+NAME = 'libreoffice-26.2.5.2-frw-writer-tagged-20261126'
+MANIFEST = 'bundle-provenance.json'
+MANIFEST_SHA = 'f45327a18793f1218b6533652aff5101dda84b957387444f05305138729e72e1'
+PRODUCER_SHA = '4272745ee4d410ea8bdafc273cbae7ef33bfe304b1d6d4227322e8f8509a058c'
+SELECTION_SCHEMA = 'friday.scoped-writer-odt-profile.v1'
+
+
+def _pairs(pairs):
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError('pdf_writer_bank_manifest')
+        value[key] = item
+    return value
+
+
+def _owner_directory(path, writable):
+    path = Path(path)
+    info = path.lstat()
+    allowed_mode = 0o700 if writable else 0o500
+    if (not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != allowed_mode
+            or info.st_uid != os.getuid() or path.resolve(strict=True) != path):
+        raise ValueError('pdf_writer_bank_directory')
+    return path
+
+
+def selection_name(profile):
+    if type(profile) is not str or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,63}',profile) is None:
+        raise ValueError('pdf_writer_bank_selection')
+    return f'scoped-writer-odt-profile.{profile}.json'
+
+
+def configured(cap, source_sha):
+    """Use an explicit installation-owned declaration after ordinary source admission."""
+    from hermes_cli.friday_workspace_pdf import _private_bytes
+
+    home = Path(cap.authorization_home)
+    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(fd)
+        if info.st_uid != os.getuid() or info.st_mode & 0o077 or home.resolve(strict=True) != home:
+            raise ValueError('pdf_writer_bank_directory')
+        try:
+            raw = _private_bytes(fd, selection_name(cap.profile), 1024)
+        except FileNotFoundError:
+            return None
+    finally:
+        os.close(fd)
+    value = json.loads(raw, object_pairs_hook=_pairs)
+    if (type(value) is not dict or set(value) != {'schema','runtime_profile','source_sha256'}
+            or value['schema']!=SELECTION_SCHEMA or type(value['runtime_profile']) is not str
+            or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,63}',value['runtime_profile']) is None
+            or type(value['source_sha256']) is not str
+            or re.fullmatch(r'[0-9a-f]{64}',value['source_sha256']) is None):
+        raise ValueError('pdf_writer_bank_selection')
+    if (value['runtime_profile'], value['source_sha256']) != (cap.profile, source_sha):
+        return None
+    root = _owner_directory(home/'toolchains', writable=True)/NAME
+    return _owner_directory(root, writable=False)
+
+
+def _identity(info):
+    return (info.st_dev,info.st_ino,info.st_mode,info.st_uid,info.st_nlink,
+            info.st_size,info.st_mtime_ns,info.st_ctime_ns)
+
+
+def _checked_file(path, size, digest, *, capture=False):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, 'rb') as stream:
+        before = os.fstat(fd)
+        if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
+                or before.st_size != size or size > 200_000_000
+                or stat.S_IMODE(before.st_mode) not in (0o400,0o500)
+                or before.st_uid not in (0,os.getuid())):
+            raise ValueError('pdf_writer_bank_payload')
+        data = stream.read() if capture else None
+        found = sha256(data).hexdigest() if capture else file_digest(stream,'sha256').hexdigest()
+        if (found != digest or _identity(before) != _identity(os.fstat(fd))
+                or _identity(before) != _identity(path.lstat())):
+            raise ValueError('pdf_writer_bank_payload')
+    return data
+
+
+def verify_payload(root):
+    """The pinned closed inventory must match the separate unmasked mount."""
+    raw = _checked_file(root/MANIFEST, 1_184_918, MANIFEST_SHA, capture=True)
+    manifest = json.loads(raw, object_pairs_hook=_pairs)
+    if (manifest['schema']!='friday.scoped-writer-bank.v1'
+            or manifest['bank']!=NAME or manifest['producer']!=PRODUCER_SHA):
+        raise ValueError('pdf_writer_bank_manifest')
+    inventory = {row['path']:row for row in manifest['inventory']}
+    count = 0
+    for directory, directories, files in os.walk(root, followlinks=False):
+        for name in directories + files:
+            path = Path(directory)/name
+            relative = path.relative_to(root).as_posix()
+            if relative == MANIFEST:
+                continue
+            row = inventory.pop(relative, None)
+            if row is None:
+                raise ValueError('pdf_writer_bank_payload')
+            info = path.lstat()
+            if info.st_uid not in (0,os.getuid()):
+                raise ValueError('pdf_writer_bank_payload')
+            if row['kind'] == 'symlink':
+                if not stat.S_ISLNK(info.st_mode) or os.readlink(path) != row['target']:
+                    raise ValueError('pdf_writer_bank_payload')
+            elif stat.S_IMODE(info.st_mode) != row['mode']:
+                raise ValueError('pdf_writer_bank_payload')
+            elif row['kind'] == 'file':
+                _checked_file(path,row['bytes'],row['sha256'])
+            elif not stat.S_ISDIR(info.st_mode):
+                raise ValueError('pdf_writer_bank_payload')
+            count += 1
+    if inventory or count != manifest['payload']['entries']:
+        raise ValueError('pdf_writer_bank_payload')
+    return MANIFEST_SHA
+
+
+def verify_mount(proof, used, share, *, check_readonly):
+    """Bind both launch mounts to the exact sealed bank before Office starts."""
+    _owner_directory(proof, writable=False)
+    _owner_directory(used, writable=False)
+    with ExitStack() as resources:
+        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+        def open_directory(path):
+            fd = os.open(path, flags)
+            resources.callback(os.close, fd)
+            return fd
+        for original, stage, original_mount in (
+            (proof, used, proof), (proof/'share-merged', share, proof),
+        ):
+            left, right = open_directory(original), open_directory(stage)
+            check_readonly(left,str(original_mount))
+            check_readonly(right,str(stage))
+            a, b = os.fstat(left), os.fstat(right)
+            if (a.st_dev,a.st_ino) != (b.st_dev,b.st_ino):
+                raise ValueError('pdf_writer_bank_mount')
+        return verify_payload(proof)
