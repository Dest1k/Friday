+    vector = dict(dict(proof.Face._fields_)["glyph"]._type_._fields_)["advance"]
+    for name, result, args in (
+        ("FT_Set_Pixel_Sizes", C.c_int, [C.c_void_p, C.c_uint, C.c_uint]),
+        ("FT_Set_Transform", None, [C.c_void_p, C.POINTER(Matrix), C.POINTER(vector)]),
+        ("FT_Render_Glyph", C.c_int, [C.c_void_p, C.c_int]),
+    ):
+        call = getattr(proof.lib, name)
+        call.restype, call.argtypes = result, args
