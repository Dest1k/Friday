+    start = record["raw_start"]
+    inflate = zlib.decompressobj()
+    try:
+        data = inflate.decompress(pdf[start:start + record["raw_size"]], size + 1)
+    except zlib.error:
+        raise ValueError("pdf_writer_type1_program_pin") from None
