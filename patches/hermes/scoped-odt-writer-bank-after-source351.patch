+def read_pdf_font_metrics(lib, handle, slot, profile):
+    # _bind_writer_fonts has already bound every indirect resource to this page.
+    import ctypes as C
+    pointer, integer, obj = C.c_void_p, C.c_int, C.c_uint
+    signatures = {
+        "qpdf_get_last_string_length": (C.c_size_t, [pointer]),
+        "qpdf_oh_is_array": (integer, [pointer, obj]),
+        "qpdf_oh_get_array_n_items": (integer, [pointer, obj]),
+        "qpdf_oh_get_array_item": (obj, [pointer, obj, integer]),
+    }
+    for name, (result, args) in signatures.items():
+        function = getattr(lib, name)
+        function.restype, function.argtypes = result, args
