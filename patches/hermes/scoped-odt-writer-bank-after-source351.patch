+    if header is None:
+        raise ValueError('pdf_writer_xref')
+    cursor = header.end()
+    count = int(header[1])
+    if count > (len(pdf) - cursor) // 20 or pdf[cursor+20*count:cursor+20*count+8] != b'trailer\n':
+        raise ValueError('pdf_writer_xref')
+    rows = {}
+    row = re.compile(rb'([0-9]{10}) ([0-9]{5}) ([nf]) \n')
+    for item in range(count):
+        hit = row.match(pdf, cursor)
+        if hit is None:
+            raise ValueError('pdf_writer_xref')
+        cursor = hit.end()
+        if hit[3] == b'n':
+            offset = int(hit[1])
+            marker = f'{item} 0 obj\n'.encode('ascii')
+            if item == 0 or hit[2] != b'00000' or not 0 < offset < start or not pdf.startswith(marker, offset):
+                raise ValueError('pdf_writer_xref')
+            rows[item] = offset
