+def original_program(pdf, record, geometry):
+    """The raw digest must be the one proved for this current decoded program."""
+    size = sum(record["lengths"])
+    start, extent = record["raw_start"], record["raw_size"]
+    need(record["type1"] and 0 < size <= 12_000 and 0 < start < start+extent <= len(pdf),
+         "program_extent")
+    inflater = zlib.decompressobj()
+    try:
+        raw = inflater.decompress(pdf[start:start+extent], size+1)
+    except zlib.error:
+        raise ValueError("pdf_writer_viewer_program_extent") from None
+    need(inflater.eof and not inflater.unconsumed_tail and not inflater.unused_data
+         and len(raw) == size, "program_extent")
+    need(digest(raw).encode("ascii") == record["decoded_sha"]
+         and digest(raw) == geometry["embedded_program_sha256"], "program_identity")
+    return raw
