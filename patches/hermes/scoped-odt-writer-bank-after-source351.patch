+                    raise ValueError('pdf_writer_viewer_engine')
+            finally:
+                _stop(process)
+    except subprocess.TimeoutExpired:
+        raise ValueError('pdf_writer_viewer_deadline') from None
+    except OSError:
+        raise ValueError('pdf_writer_viewer_io') from None
+    _remaining(deadline)
+    if len(pgm) != len(header) + width * height or not pgm.startswith(header):
+        raise ValueError('pdf_writer_viewer_output')
+    return bytes(memoryview(pgm)[len(header):])
