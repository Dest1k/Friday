+    names = (
+        'FT_Init_FreeType', 'FT_Done_FreeType', 'FT_Library_Version', 'FT_New_Memory_Face',
+        'FT_Done_Face', 'FT_Select_Charmap', 'FT_Get_Char_Index', 'FT_Load_Glyph',
+        'FT_Get_Font_Format', 'FT_Get_Postscript_Name', 'FT_Get_Name_Index',
+        'FT_Get_Glyph_Name', 'FT_Get_CID_From_Glyph_Index',
+    )
+    if include_raster:
+        names += ('FT_Render_Glyph', 'FT_Set_Transform', 'FT_Set_Char_Size', 'FT_Set_Pixel_Sizes')
+    try:
+        addresses = {ctypes.cast(getattr(proof.lib, name), ctypes.c_void_p).value for name in names}
