+        require(lib.qpdf_oh_is_array(handle, node) and lib.qpdf_oh_get_array_n_items(handle, node) == count, reason)
+        values = []
+        for index in range(count):
+            entry = lib.qpdf_oh_get_array_item(handle, node, index)
+            require(lib.qpdf_oh_is_integer(handle, entry), reason)
+            values.append(lib.qpdf_oh_get_int_value(handle, entry))
+        return tuple(values)
+
+    page = lib.qpdf_get_page_n(handle, 0)
+    fonts = get(get(page, b"/Resources"), b"/Font")
+    font = get(fonts, b"/" + slot)
+    exact_keys(font, {b"/Type", b"/Subtype", b"/BaseFont", b"/FirstChar", b"/LastChar", b"/Widths",
+                      b"/FontDescriptor", b"/ToUnicode"})
+    name_is(get(font, b"/Type"), b"/Font")
+    name_is(get(font, b"/BaseFont"), profile["pdf_name"])
+    descriptor = get(font, b"/FontDescriptor")
+    fields = {b"/Flags": 4, b"/ItalicAngle": 0, b"/Ascent": 1160, b"/Descent": -288,
+              b"/CapHeight": profile["cap_height"], b"/StemV": 80}
+    exact_keys(descriptor, set(fields) | {b"/Type", b"/FontName", b"/FontBBox", b"/FontFile"})
+    name_is(get(descriptor, b"/Type"), b"/FontDescriptor")
+    name_is(get(descriptor, b"/FontName"), profile["pdf_name"])
+    for key, value in fields.items():
+        node = get(descriptor, key)
+        require(lib.qpdf_oh_is_integer(handle, node) and lib.qpdf_oh_get_int_value(handle, node) == value,
+                "pdf_writer_type1_dictionary")
+    require(numbers(get(descriptor, b"/FontBBox"), 4, "pdf_writer_type1_dictionary") == profile["bbox"],
+            "pdf_writer_type1_dictionary")
+    file = get(descriptor, b"/FontFile")
+    require(lib.qpdf_oh_is_stream(handle, file), "pdf_writer_type1_dictionary")
+    exact_keys(lib.qpdf_oh_get_dict(handle, file), {b"/Length", b"/Filter", b"/Length1", b"/Length2", b"/Length3"})
+
+    values = numbers(get(font, b"/Widths"), profile["count"] + 1, "pdf_writer_type1_widths")
+    require(values[0] == 0 and all(0 < w <= 4000 for w in values[1:]), "pdf_writer_type1_widths")
+
+    cmap = get(font, b"/ToUnicode")
