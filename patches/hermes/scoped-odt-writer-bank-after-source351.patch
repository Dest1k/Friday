+        if process.returncode is None:
+            try:
+                os.killpg(process.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+            try:
+                process.wait(timeout=0.5)
+            except subprocess.TimeoutExpired:
+                raise ValueError('pdf_writer_viewer_cleanup') from None
+    finally:
+        for pipe in (process.stdin, process.stdout, process.stderr):
+            pipe.close()
+
+
+def render_splash(pdf, *, expected_sha256, width, height, deadline):
+    """Return raw PGM pixels for already validated one-page Writer bytes.
+
+    The caller owns page/paint grammar and supplies its expected 300 dpi geometry
+    and a monotonic deadline. The renderer runs within the existing PID/mount
+    namespace and inherited resource limits.
+    """
+    deadline = min(time.monotonic() + 3, deadline)
+    _remaining(deadline)
