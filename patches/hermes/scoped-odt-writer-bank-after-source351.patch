+_FREETYPE = ('libfreetype.so.', '/usr/lib/x86_64-linux-gnu/libfreetype.so.6.20.5',
+             '36be278a8138d3e5773eb3f8491ff3fe73122a3051a9b36d1f86457ce0fad22d')
+_ENGINE = (
+    ('pdftoppm', '/usr/bin/pdftoppm',
+     '925ad4988c1fc776a829424094900473cd68d189fe8e84c15c1221ad01a0dbb7'),
+    ('libpoppler.so.', '/usr/lib/x86_64-linux-gnu/libpoppler.so.156.0.0',
+     '947213c32960198a957552383a924c5b6cbd513ab8ea95d9a414f0a0c54581cd'),
+    _FREETYPE,
+    ('ld-linux-x86-64.so.2', '/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2',
+     'c0b20d6e1ced12abfe0b1ef2b5b68017950beaaea3df69eb6949d73e0ecf7b40'),
+)
+_COMMAND = (
+    '/usr/bin/pdftoppm', '-f', '1', '-l', '1', '-r', '300', '-cropbox',
+    '-gray', '-singlefile', '-freetype', 'yes', '-aa', 'yes', '-aaVector', 'yes', '-',
+)
+_ENV = {'LANG': 'C', 'LC_ALL': 'C', 'HOME': '/tmp', 'TMPDIR': '/tmp'}
+_PDF_LIMIT = 1_000_000
+_PIXEL_LIMIT = 16 * 1024**2
+_MAP_LIMIT = 128 * 1024
+_IO_CHUNK = 64 * 1024
