+def _remaining(deadline):
+    remaining = deadline - time.monotonic()
+    if remaining <= 0:
+        raise ValueError('pdf_writer_viewer_deadline')
+    return remaining
+
+
+def _file_state(fd):
+    info = os.fstat(fd)
+    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns
+
+
+def _open_engine(stack, entries):
+    files = {}
+    for family, path, expected in entries:
+        fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK)
+        stack.callback(os.close, fd)
+        info = os.fstat(fd)
+        retained_state = _file_state(fd)
+        # Bubblewrap may report host root as overflowuid in its user namespace.
+        trusted_owner = info.st_uid == 0 or (
+            info.st_uid == 65534 and os.fstatvfs(fd).f_flag & os.ST_RDONLY
+        )
+        if (not stat.S_ISREG(info.st_mode) or not trusted_owner or info.st_mode & 0o022
+                or not 0 < info.st_size <= 8 * 1024**2):
+            raise ValueError('pdf_writer_viewer_engine')
+        with open(fd, 'rb', closefd=False) as file:
+            payload = file.read(info.st_size + 1)
+        if (len(payload) != info.st_size or sha256(payload).hexdigest() != expected
