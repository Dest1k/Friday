+def _writer_number(value, *, minimum=0, maximum=(1 << 63) - 1):
+    if re.fullmatch(rb'0|[1-9][0-9]{0,18}', value) is None:
+        raise ValueError('pdf_writer_output_custody')
+    number = int(value)
+    if not minimum <= number <= maximum:
+        raise ValueError('pdf_writer_output_custody')
+    return number
