+def need(condition, reason):
+    if not condition:
+        raise ValueError("pdf_writer_viewer_" + reason)
+
+
+def digest(raw):
+    return sha256(raw).hexdigest()
+
+
+def check_time(deadline):
+    need(monotonic() < deadline, "deadline")
+
