+        for pipe in (process.stdin, process.stdout, process.stderr):
+            os.set_blocking(pipe.fileno(), False)
+            ready.register(pipe, selectors.EVENT_WRITE if pipe is process.stdin else selectors.EVENT_READ)
+        offset = 0
+        while ready.get_map():
+            remaining = _remaining(deadline)
+            for key, _ in ready.select(remaining):
+                pipe = key.fileobj
+                try:
+                    if pipe is process.stdin:
+                        offset += os.write(key.fd, pdf[offset:offset + _IO_CHUNK])
+                        finished = offset == len(pdf)
+                    else:
+                        output, cap = outputs[pipe]
+                        chunk = os.read(key.fd, min(_IO_CHUNK, cap + 1 - len(output)))
+                        output.extend(chunk)
