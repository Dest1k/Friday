+                except ValueError as exc:
+                    raise OSError("path traversal blocked") from exc
+                directory = member.endswith("/")
+                target, private = _prepare_zip_home_entry(
+                    root, resolved_root, parts, private_profiles, friday_state, has_friday_state, directory,
+                )
+                if directory:
+                    restored_dirs += 1
+                    continue
+                mode = private_file_mode if private else new_file_mode
+                _restore_zip_home_file(zf, member, rel, target, mode, db_shrunk)
+            restored += 1
+        except (OSError, *backup._ZIP_MEMBER_READ_ERRORS) as exc:
+            errors.append(f"  {member if external else rel}: {exc}")
+        if restored % 500 == 0:
+            print(f"  {restored}/{file_count} files ...")
+
+    return restored, restored_dirs, restored_external, skipped_runtime, db_shrunk, errors
