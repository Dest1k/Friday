+def _make_import_directories(root: Path, parts: tuple[str, ...], private_from: int) -> None:
+    """Create new private parents one at a time: mkdir(parents=True) ignores their mode."""
+    if not private_from:
+        root.joinpath(*parts).mkdir(parents=True, exist_ok=True)
+        return
+    path = root.joinpath(*parts[:private_from - 1])
+    path.mkdir(parents=True, exist_ok=True)
+    for name in parts[private_from - 1:]:
+        path /= name
+        path.mkdir(mode=0o700, exist_ok=True)
+
+
+def _restore_external_zip_file(
+    zf: zipfile.ZipFile, member: str, rel: str, home_dir: Path, new_file_mode: Optional[int],
+) -> None:
+    from hermes_cli import backup
+
+    # External memory-provider state, such as ~/.honcho, is home-relative.
+    target = home_dir / rel
+    try:
+        target.resolve().relative_to(home_dir)
+    except ValueError as exc:
+        raise OSError("path traversal blocked") from exc
+    target.parent.mkdir(parents=True, exist_ok=True)
+    backup._extract_member_atomically(zf, member, target, new_file_mode)
+    if target.suffix in {".json", ".env", ".conf"} or target.name in backup._SECRET_FILE_NAMES:
+        try:
+            os.chmod(target, 0o600)
+        except OSError:
+            pass
+
+
+def _prepare_zip_home_entry(
+    root: Path, resolved_root: Path, parts: tuple[str, ...], private_profiles: set[str],
+    friday_state: tuple[str, str], has_friday_state: bool, directory: bool,
+) -> tuple[Path, bool]:
+    target = root.joinpath(*parts)
+    # Legacy ZIPs list files only, so derive private parent modes from the
+    # same portable paths for old and new archives.
+    private_from = 0
+    if len(parts) >= 2 and parts[0] == "profiles" and parts[1] in private_profiles:
+        private_from = 2
+    elif parts[:2] == friday_state:
+        private_from = 1
+
+    try:
+        resolved_parts = target.resolve().relative_to(resolved_root).parts
+    except ValueError as exc:
+        raise OSError("path traversal blocked") from exc
+    if private_from and resolved_parts != parts:
+        raise OSError("private restore requires a direct path")
+
+    if has_friday_state and parts[0] == "plugin-data" and not private_from:
+        # An ordinary sibling can be the first member under the shared parent.
+        (root / "plugin-data").mkdir(mode=0o700, exist_ok=True)
+    _make_import_directories(root, parts if directory else parts[:-1], private_from)
+    private = bool(private_from or private_profiles and parts == ("config.yaml",))
+    return target, private
+
+
+def _restore_zip_home_file(
+    zf: zipfile.ZipFile, member: str, rel: str, target: Path, member_mode: Optional[int],
+    db_shrunk: list[tuple[str, tuple[int, int], tuple[int, int]]],
+) -> None:
+    from hermes_cli import backup
+
+    if target.suffix == ".db":
+        # Capture counts around the write so any older imported rows are reported.
+        before = _count_session_rows(target)
+        backup._import_db_member(zf, member, target, member_mode)
+        after = _count_session_rows(target)
+        if before and after and after[1] < before[1]:
+            db_shrunk.append((rel, before, after))
+    else:
+        backup._extract_member_atomically(zf, member, target, member_mode)
+    if target.name in backup._SECRET_FILE_NAMES:
+        os.chmod(target, 0o600)
+
+
+def _import_zip_members(
+    zf: zipfile.ZipFile, members: list[str], prefix: str, root: Path,
+    private_profiles: set[str], file_count: int,
+):
+    """Restore ZIP entries and collect the CLI's counts, warnings, and errors."""
+    from hermes_cli import backup
+    from hermes_cli.archive_safe import normalize_archive_parts
+    from hermes_cli.plugins_state import _plugin_data_namespace
+
+    errors = []
+    restored = restored_dirs = restored_external = 0
+    skipped_runtime = []
+    db_shrunk = []
+    home_dir = Path.home().resolve()
+    resolved_root = root.resolve()
+    # Compute once because import normally uses the caller's umask for new
+    # files. In designated private paths it can only narrow owner-only mode.
+    new_file_mode = _default_new_file_mode()
+    private_file_mode = None if new_file_mode is None else new_file_mode & 0o600
+    friday_state = ("plugin-data", _plugin_data_namespace("friday_rework", ""))
+    state_member = "/".join((*friday_state, "state.json"))
+    has_friday_state = state_member in members or prefix + state_member in members
+
+    for member in members:
+        rel, skipped = backup._import_member_rel(member, prefix)
+        if not rel:
+            continue
+        if skipped:
+            skipped_runtime.append(rel)
+            continue
+        external = member.startswith(backup._EXTERNAL_PREFIX)
+        try:
+            if external:
