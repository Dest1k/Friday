+"""Full-backup coverage for Friday profile directories."""
+
+import zipfile
+from argparse import Namespace
+from pathlib import Path
+
+
+def test_preserves_required_friday_profile_directories(tmp_path, monkeypatch, capsys):
+    from hermes_cli.backup import run_backup
+    from hermes_cli.friday_user_scope import MARKER
+
+    hermes_home = tmp_path / ".hermes"
+    profiles = hermes_home / "profiles"
+    for profile in ("owner", "peer"):
+        (profiles / profile / "workspace").mkdir(parents=True)
+        (profiles / profile / "memories").mkdir()
+        (profiles / profile / MARKER).write_text("{}", encoding="utf-8")
+    (profiles / "unmarked" / "workspace").mkdir(parents=True)
+    cache = profiles / "peer" / "workspace" / "__pycache__"
+    cache.mkdir()
+    (cache / "ignored.pyc").write_bytes(b"omitted cache")
+    content = b"existing workspace artifact\n"
+    (profiles / "owner" / "workspace" / "artifact.txt").write_bytes(content)
+    memory = b"existing memory\n"
+    (profiles / "owner" / "memories" / "MEMORY.md").write_bytes(memory)
+    (hermes_home / "config.yaml").write_text("model: test\n", encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(hermes_home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+
+    out_zip = tmp_path / "backup.zip"
+    assert run_backup(Namespace(output=str(out_zip)))
+    assert "Backing up 5 files ..." in capsys.readouterr().out
+
+    with zipfile.ZipFile(out_zip) as archive:
+        artifact = "profiles/owner/workspace/artifact.txt"
+        memory_file = "profiles/owner/memories/MEMORY.md"
