+++ b/gateway/upload_anchor.py
@@ -0,0 +1,248 @@
+"""Resolve one direct upload in the current admitted Telegram turn."""
+from contextlib import closing, contextmanager
+from contextvars import ContextVar
+import hashlib
+import json
+from pathlib import Path
+import re
+from threading import Event
+import time
+
+from gateway.run_attachment_presentation import (
+    ATTACHMENT_PRESENTATIONS_KEY, DIRECT_UPLOAD_KEY, _file_record, _metadata_files,
+    _safe_name, _scope,
+)
+
+_TURN = ContextVar("direct_upload_anchor_turn", default=None)
+_MAX_METADATA = 65536
+_MAX_SEGMENTS = 32
+_RECEIVED_PATH = re.compile(r"received/telegram_[0-9a-f]{64}_[A-Za-z0-9_.-]{1,80}\.[a-z0-9]{1,12}")
+_SESSION_SQL = """SELECT id, source, user_id, session_key, chat_id, chat_type, thread_id,
+    profile_name, parent_session_id, ended_at, end_reason,
+    CASE WHEN length(CAST(model_config AS BLOB)) <= ? THEN model_config END AS model_config,
+    length(CAST(model_config AS BLOB)) AS config_bytes,
+    CASE WHEN length(CAST(origin_json AS BLOB)) <= ? THEN origin_json END AS origin_json
+    FROM sessions WHERE id = ?"""
+_ROW_SQL = """SELECT platform_message_id, message_uid, active, compacted,
+    CASE WHEN length(CAST(display_metadata AS BLOB)) <= ? THEN display_metadata END AS metadata
+    FROM messages WHERE session_id = ? AND id = ? AND role = 'user'
+    AND observed = 0 AND _compressed_summary = 0 AND display_kind IS NULL
+    AND ((active = 1 AND compacted = 0) OR (active = 0 AND compacted = 1))"""
+
+
+class AnchorUnavailable(ValueError):
+    """No verified, accessible attachment for the supplied exact anchor."""
+
+
+@contextmanager
+def bind_upload_anchor_turn(store, ctx, agent):
+    """Carry a read-only route witness within this existing native turn."""
+    cap = getattr(getattr(ctx, "source", None), "_friday_user_scope", None)
+    available = (cap is not None and store is not None and ctx.session_id and ctx.session_key
+                 and type(ctx.run_generation) is int and ctx.run_generation > 0)
+    closed = Event() if available else None
+    bound = (store, ctx, agent, cap, closed) if available else None
+    token = _TURN.set(bound)
+    try:
+        yield
+    finally:
+        if closed is not None:
+            closed.set()
+        _TURN.reset(token)
+
+
+def _selector(value):
+    if type(value) is not dict or set(value) != {"source_session_id", "native_row_id", "file_name"}:
+        raise AnchorUnavailable()
+    sid, row_id, name = (value[k] for k in ("source_session_id", "native_row_id", "file_name"))
+    if (not isinstance(sid, str) or not 0 < len(sid) <= 128 or sid in {".", ".."}
+            or "/" in sid or _safe_name(sid) != sid or type(row_id) is not int or not 0 < row_id < 2**63
+            or not isinstance(name, str) or _safe_name(name) != name):
+        raise AnchorUnavailable()
+    return sid, row_id, name
+
+
+def _object(raw):
+    def unique(pairs):
+        value = {}
+        for key, item in pairs:
+            if key in value:
+                raise AnchorUnavailable()
+            value[key] = item
+        return value
+
+    if not isinstance(raw, str):
+        raise AnchorUnavailable()
+    value = json.loads(raw, object_pairs_hook=unique)
+    if not isinstance(value, dict):
+        raise AnchorUnavailable()
+    return value
+
+
+def _route(source):
+    return (source.platform.value, source.user_id, source.chat_id, source.chat_type, source.thread_id)
+
+
+def _current_entry(store, ctx, cap, route):
+    if not store._lock.acquire(blocking=False):
+        raise AnchorUnavailable()
+    try:
+        # Longer-lived index initialization can repair/save routes. Only
+        # inspect the already published native entry from the owned turn.
+        entry = store._entries.get(ctx.session_key) if store._loaded else None
+        if (entry is None or entry.session_id != ctx.session_id or entry.session_key != ctx.session_key
+                or entry.origin is None or _route(entry.origin) != route
+                or store._profile_from_session_key(ctx.session_key) != cap.profile):
+            raise AnchorUnavailable()
+        return entry
+    finally:
+        store._lock.release()
+
+
+@contextmanager
+def _read_snapshot(db, deadline, progress):
+    if not db._read_budget.acquire(db):
+        raise AnchorUnavailable()
+    try:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise AnchorUnavailable()
+        # The pooled reader can fall back to the locked writer connection.
+        # An exact proof has no writer fallback, even on contention or close.
+        with closing(db._connect_read_only(timeout=min(remaining, 0.2))) as conn:
+            conn.execute("PRAGMA query_only=ON")
+            conn.set_progress_handler(progress, 1000)
+            conn.execute("BEGIN")
+            yield conn
+    finally:
+        db._read_budget.release()
+
+
+def _read_anchor(db, cap, ctx, route, selector, deadline):
+    source_sid, row_id, _ = selector
+    expected_account = {"schema": "friday.account_origin.v1", "platform": cap.principal[0],
+                        "transport_profile": cap.principal[1], "account_id": cap.principal[2]}
+    vm_steps = 0
+
+    def progress():
+        nonlocal vm_steps
+        vm_steps += 1000
+        return int(vm_steps > 2_000_000 or time.monotonic() >= deadline)
+
+    def session(conn, sid):
+        row = conn.execute(_SESSION_SQL, (_MAX_METADATA, _MAX_METADATA, sid)).fetchone()
+        if (row is None or row["profile_name"] != cap.profile or row["session_key"] != ctx.session_key
+                or tuple(row[key] for key in ("source", "user_id", "chat_id", "chat_type", "thread_id")) != route
+                or _object(row["origin_json"]).get("friday_account_origin") != expected_account
+                or (row["config_bytes"] or 0) > _MAX_METADATA):
+            raise AnchorUnavailable()
+        value = dict(row)
+        if value["model_config"] is not None:
+            value["model_config"] = _object(value["model_config"])
+        return value
+
+    with _read_snapshot(db, deadline, progress) as conn:
+        child = session(conn, ctx.session_id)
+        # A published compression/reset can finish the DB predecessor
+        # before the in-memory route entry points at the successor.
+        if child["ended_at"] is not None or child["end_reason"] is not None:
+            raise AnchorUnavailable()
+        lineage = []
+        seen = set()
+        for _ in range(_MAX_SEGMENTS):
+            sid = child["id"]
+            if sid in seen:
+                raise AnchorUnavailable()
+            seen.add(sid)
+            lineage.append(child)
+            if sid == source_sid:
+                row = conn.execute(_ROW_SQL, (_MAX_METADATA, source_sid, row_id)).fetchone()
+                if (row is None or not isinstance(row["metadata"], str)
+                        or not isinstance(row["message_uid"], str) or not row["message_uid"]):
+                    raise AnchorUnavailable()
+                return lineage, tuple(row)
+            parent = child["parent_session_id"]
+            if (not parent or db._is_explicit_fork_child_row(child, include_reset=True)
+                    or parent in seen):
+                raise AnchorUnavailable()
+            child = session(conn, parent)
+            if child["ended_at"] is None or child["end_reason"] != "compression":
+                raise AnchorUnavailable()
+        raise AnchorUnavailable()
+
+
+def _file(row, cap, name):
+    carrier, _, _, _, raw = row
+    display = _object(raw)
+    proof = display.get(DIRECT_UPLOAD_KEY)
+    if ("model_only" in display or type(proof) is not dict
+            or set(proof) != {"schema", "scope", "source_message_id", "file"}
+            or proof["schema"] != "friday.ordinary-direct-upload.v1" or proof["scope"] != _scope(cap)
+            or not isinstance(carrier, str) or re.fullmatch(r"[1-9][0-9]{0,31}", carrier) is None
+            or proof["source_message_id"] != carrier):
+        raise AnchorUnavailable()
+    file = proof["file"]
+    if (type(file) is not dict or set(file) != {"path", "sha256", "size_bytes", "file_name"}
+            or file["file_name"] != name or not isinstance(file["path"], str)
+            or _RECEIVED_PATH.fullmatch(file["path"]) is None
+            or _file_record(file["path"], {"sha256": file["sha256"], "size_bytes": file["size_bytes"]}, name) != file):
+        raise AnchorUnavailable()
+    presentation = display.get(ATTACHMENT_PRESENTATIONS_KEY)
+    records = _metadata_files(presentation, cap)
+    if not records or records != presentation["files"] or [item for item in records if item["file_name"] == name] != [file]:
+        raise AnchorUnavailable()
+    return file
+
+
+def resolve_upload_anchor(value):
+    """Return only the own workspace path, verified byte count and SHA-256."""
+    from agent.web_call_context import _current, same_web_authority
+    from hermes_cli.friday_user_scope import _same_scope, current, ordinary_file_source, workspace_document
+
+    selector = _selector(value)
+    bound = _TURN.get()
+    if bound is None:
+        raise AnchorUnavailable()
+    store, ctx, agent, cap, closed = bound
+    call = _current.get()
+    db = getattr(agent, "_session_db", None)
+    if (closed.is_set() or cap.principal[0] != "telegram"
+            or not {"session_search", "read_file"} <= set(cap.binding["tools"])
+            or call is None or getattr(call, "agent", None) is not agent
+            or call.session_id != ctx.session_id or call.session_key != ctx.session_key
+            or db is None or Path(db.db_path) != cap.home / "state.db"
+            or db._db_file_identity is None):
+        raise AnchorUnavailable()
+    route = _route(ctx.source)
+    if route[:2] != (cap.principal[0], cap.principal[3]):
+        raise AnchorUnavailable()
+    deadline = min(call.deadline(), time.monotonic() + 0.25)
+
+    def current_entry():
+        if (closed.is_set() or time.monotonic() >= deadline or not ctx._run_still_current()
+                or getattr(agent, "session_id", None) != ctx.session_id or not call.turn_id
+                or getattr(agent, "_current_turn_id", None) != call.turn_id
+                or getattr(agent, "_persist_disabled", False) or getattr(agent, "_session_db", None) is not db
+                or not _same_scope(current(required=True), cap) or not same_web_authority(call)
+                or _route(ordinary_file_source()) != route or db._conn is None or db._db_file_was_replaced()):
+            raise AnchorUnavailable()
+        call.check()
+        entry = _current_entry(store, ctx, cap, route)
+        if time.monotonic() >= deadline:
+            raise AnchorUnavailable()
+        return entry
+
+    entry = current_entry()
+    original = _read_anchor(db, cap, ctx, route, selector, deadline)
+    file = _file(original[1], cap, selector[2])
+    if current_entry() is not entry:
+        raise AnchorUnavailable()
+    raw, relative = workspace_document(str(cap.home / "workspace" / file["path"]), max_bytes=file["size_bytes"])
+    if relative != file["path"] or len(raw) != file["size_bytes"] or hashlib.sha256(raw).hexdigest() != file["sha256"]:
+        raise AnchorUnavailable()
+    # Use a new snapshot after file I/O, so rewind, reset and changed source
+    # metadata cannot reuse the earlier transaction's stale proof.
+    if (_read_anchor(db, cap, ctx, route, selector, deadline) != original
+            or current_entry() is not entry):
+        raise AnchorUnavailable()
+    return {"path": relative, "size_bytes": len(raw), "source_sha256": file["sha256"]}
