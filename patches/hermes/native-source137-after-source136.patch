+    inert_actions = False
+    stack = [(root, 1)]
+    while stack:
+        node, depth = stack.pop()
+        count += 1
+        if count > MAX_NODES or depth > MAX_DEPTH:
+            fail('vdx_structure_limit')
+        if count % 128 == 1:
+            shared.tick(checkpoint)
+        if not isinstance(node.tag, str) or not any(
+                node.tag.startswith('{' + ns + '}') for ns in (V, _EXTENSION)):
+            fail('foreign_vdx_namespace')
+        local = node.tag.rsplit('}', 1)[-1]
+        if local in _ACTIVE:
+            fail('active_or_embedded_vdx_content')
+        if '{http://www.w3.org/XML/1998/namespace}base' in node.attrib:
+            fail('external_xml_base_forbidden')
