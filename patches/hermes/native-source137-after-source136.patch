+                    attrs = {'N': name, 'V': (cell.text or '').strip()}
+                    attrs.update({key: cell.get(key) for key in ('F', 'E', 'U')
+                                  if cell.get(key) is not None})
+                    ET.SubElement(row, shared.q(shared.V, 'Cell'), attrs)
+    return target
+
+
