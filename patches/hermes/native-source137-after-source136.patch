+        metadata = dict(rendered.extraction_metadata)
+        metadata['action_definitions'] = ('present_not_executed_or_returned'
+                                          if inert_actions else 'not_observed')
+        metadata['limitations'] = sorted(set(metadata['limitations']) | {
+            'native_action_definitions_and_extension_properties_not_evaluated'})
+        lines = rendered.splitlines()
+        lines[0] = '[DIAGRAM ' + shared.encoded(metadata) + ']'
+        # Root metadata is not page content; no absent-master resolution or
+        # visual coverage is implied by the normalized structural projection.
+        return shared.DiagramText('\n'.join(lines) + '\n', metadata)
+    except shared.VSDXError as exc:
+        fail(exc.code)
