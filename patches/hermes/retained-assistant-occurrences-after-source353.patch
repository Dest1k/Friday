+    def test_failed_rotation_restores_unkeyed_assistant_handoff(self, db, monkeypatch):
+        for parent in ("before", "after"):
+            db.create_session(parent, source="cli")
+            db.append_message(parent, role="assistant", content="ok", timestamp=100.0)
+        handoff = [{"role": "assistant", "content": "ok"}]
+        insert = db._insert_message_rows
+
+        def fail_after_insert(*args, **kwargs):
+            insert(*args, **kwargs)
+            assert handoff[0].get("display_occurrence_uid") == handoff[0].get("message_uid")
+            assert handoff[0].get("message_uid")
+            raise RuntimeError("publication failed after the rows were staged")
+
+        with monkeypatch.context() as patch:
+            patch.setattr(db, "_insert_message_rows", fail_after_insert)
+            with pytest.raises(RuntimeError, match="publication failed"):
+                db.publish_compression_child(parent_session_id="before", child_session_id="failed",
+                                             source="cli", messages=handoff, require_compression_lease=False)
+
+        assert handoff == [{"role": "assistant", "content": "ok"}]
+        assert db.get_session("failed") is None
+        db.publish_compression_child(parent_session_id="after", child_session_id="successful",
+                                     source="cli", messages=handoff, require_compression_lease=False)
+        stored = db.get_messages("after")[0]
+        assert handoff[0]["message_uid"] == stored["message_uid"]
+        assert handoff[0]["display_occurrence_uid"] == stored["display_occurrence_uid"]
+        assert len(db.get_messages("successful", include_ancestors=True)) == 1
