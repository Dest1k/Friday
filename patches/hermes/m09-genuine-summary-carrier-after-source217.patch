+"""Narrow native summary receipts, stored on the existing committed carrier row.
+
+The trust boundary is native Python/SQLite, not arbitrary Python execution or an
+attacker able to edit state.db. Text, tags and serialized metadata are not minting
+APIs. Old rows are deliberately unbound; there is no ledger or backfill.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from dataclasses import dataclass
+from typing import Any
+
+SUMMARY_PROVENANCE_KEY = "_friday_summary_provenance_v1"
+SUMMARY_CARRIER_PROOF_KEY = "_friday_summary_carrier_proof"
+_SCHEMA = "friday.summary-provenance.v1"
+_PROOF_KEYS = frozenset(("schema", "producer", "outcome", "commit_kind",
+    "source_session_id", "session_id", "carrier_row_id", "message_uid", "role",
+    "policy", "placement", "has_user_turn", "body_sha256", "carrier_sha256",
+    "carrier_value_sha256"))
+
+
+def _text_sha256(value: str):
+    try:
+        return hashlib.sha256(value.encode("utf-8")).hexdigest()
+    except (AttributeError, UnicodeError):
+        return None
+
+
+def summary_content_fingerprint(content: Any):
+    """Full decoded carrier value, including its type; invalid values are unbound."""
+    if not isinstance(content, (str, list, dict)) and content is not None:
+        return None
+    try:
+        encoded = json.dumps({"type": type(content).__name__, "value": content},
+                             ensure_ascii=True, sort_keys=True, separators=(",", ":"), allow_nan=False)
+        return _text_sha256(encoded)
+    except (TypeError, ValueError, RecursionError):
+        return None
+
+
+@dataclass(frozen=True)
+class _ProducerProof:
+    source_session_id: str
+    body_sha256: str
+    rendered_summary_sha256: str
+
+    def __deepcopy__(self, memo):
+        return self
+
+
+@dataclass(frozen=True)
+class _CarrierProof:
+    producer: _ProducerProof
+    role: str
+    value_sha256: str
+    policy: str
+    placement: str
+    has_user_turn: bool
+
+    def __deepcopy__(self, memo):
+        return self
+
+
+def record_summary_success(compressor: Any, body: str, rendered_summary: str) -> None:
+    """Called only after the builtin producer's validation/stale-attempt guard."""
+    session_id = getattr(compressor, "_session_id", None)
+    body_sha256 = _text_sha256(body)
+    compressor._summary_producer_outcome = (
+        _ProducerProof(session_id, body_sha256, _text_sha256(rendered_summary))
+        if isinstance(session_id, str) and session_id and isinstance(body, str) and body
+        and isinstance(rendered_summary, str) and rendered_summary and body_sha256 else None)
+
+
+def producer_for_commit(compressor: Any):
+    proof = getattr(compressor, "_summary_producer_outcome", None)
+    body = getattr(compressor, "_previous_summary", None)
+    if (type(proof) is _ProducerProof and isinstance(body, str)
+            and proof.source_session_id == getattr(compressor, "_session_id", None)
+            and proof.body_sha256 == _text_sha256(body)
+            and not getattr(compressor, "_last_summary_fallback_used", False)
+            and not getattr(compressor, "_last_compress_aborted", False)):
+        return proof
+    return None
+
+
+def bind_summary_carrier(compressor: Any, message: dict, rendered_summary: str, placement: str) -> None:
+    """Bind the assembler's actual new carrier, never a content-search result."""
+    proof = producer_for_commit(compressor)
+    if (proof is None or _text_sha256(rendered_summary) != proof.rendered_summary_sha256
+            or message.get("_compressed_summary") is not True
+            or message.get("role") not in {"assistant", "user"}
+            or placement not in {"standalone", "merged_prefix", "merged_suffix"}):
+        return
+    policy = "bounded" if getattr(compressor, "bounded_context_policy", None) is not None else "ordinary"
