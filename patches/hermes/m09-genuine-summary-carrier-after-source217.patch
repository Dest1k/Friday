+            "_compressed_summary, active, compacted, display_metadata FROM messages "
+            "WHERE id = ? AND session_id = ?", (row_id, session_id)).fetchone()
+        if (row is None or row["role"] != proof.role or row["_compressed_summary"] != 1
+                or row["active"] != 1 or row["compacted"] != 0
+                or not isinstance(row["content"], str) or not isinstance(row["message_uid"], str)
+                or not row["message_uid"]
+                or summary_content_fingerprint(decode_content(row["content"])) != proof.value_sha256):
+            continue
+        metadata = json.loads(row["display_metadata"]) if row["display_metadata"] else {}
+        if not isinstance(metadata, dict):
+            continue
+        metadata[SUMMARY_PROVENANCE_KEY] = dict(
+            schema=_SCHEMA, producer="builtin_context_compressor", outcome="genuine_summary",
+            commit_kind="in_place" if session_id == source_session_id else "rotation",
+            source_session_id=source_session_id, session_id=session_id, carrier_row_id=row_id,
+            message_uid=row["message_uid"], role=proof.role, policy=proof.policy,
+            placement=proof.placement, has_user_turn=proof.has_user_turn,
+            body_sha256=producer.body_sha256, carrier_sha256=_text_sha256(row["content"]),
+            carrier_value_sha256=proof.value_sha256)
