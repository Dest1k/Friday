+                     (json.dumps(metadata), row_id, session_id))
+        # The caller's row snapshots are stamped immediately after this helper.
+        # Keep this dict aligned; _execute_transcript_write restores it on rollback.
+        message["display_metadata"] = metadata
+
+
+def committed_summary_proof(row, session_id: str):
+    """Validate a receipt read from a trusted native DB row; no text inference."""
+    try:
+        metadata = row["display_metadata"]
+        if isinstance(metadata, str):
+            metadata = json.loads(metadata)
+        if not isinstance(metadata, dict):
+            return None
+        proof = metadata.get(SUMMARY_PROVENANCE_KEY)
+        if not isinstance(proof, dict) or set(proof) != _PROOF_KEYS:
+            return None
+        if (proof["schema"] != _SCHEMA or proof["producer"] != "builtin_context_compressor"
+                or proof["outcome"] != "genuine_summary" or proof["session_id"] != session_id
+                or row["session_id"] != session_id or type(row["id"]) is not int
+                or proof["carrier_row_id"] != row["id"] or type(proof["carrier_row_id"]) is not int
+                or proof["message_uid"] != row["message_uid"] or not proof["message_uid"]
+                or proof["role"] != row["role"] or proof["role"] not in {"assistant", "user"}
+                or row["_compressed_summary"] != 1 or row["active"] != 1 or row["compacted"] != 0
+                or not isinstance(row["content"], str)
+                or proof["carrier_sha256"] != _text_sha256(row["content"])
+                or proof["policy"] not in {"ordinary", "bounded"}
+                or proof["placement"] not in {"standalone", "merged_prefix", "merged_suffix"}
+                or type(proof["has_user_turn"]) is not bool
+                or not isinstance(proof["source_session_id"], str) or not proof["source_session_id"]):
+            return None
+        if proof["policy"] == "bounded" and (proof["role"] != "assistant" or proof["placement"] != "standalone"):
+            return None
+        if proof["commit_kind"] != ("in_place" if proof["source_session_id"] == session_id else "rotation"):
+            return None
+        for key in ("body_sha256", "carrier_sha256", "carrier_value_sha256"):
+            value = proof[key]
+            if not isinstance(value, str) or len(value) != 64 or any(c not in "0123456789abcdef" for c in value):
+                return None
+        return dict(proof)
+    except (KeyError, TypeError, ValueError, UnicodeError):
+        return None
+
+
+def committed_summary_proof_for_agent(agent: Any, message: dict):
+    """Anchor a decoded cached source row to its current committed native DB row.
+
+    Called at native request assembly using an already-open SessionDB. Observer
+    reads later use the cache module's private sealed observation, without I/O.
+    """
+    if not isinstance(message, dict):
+        return None
+    session_id = getattr(agent, "session_id", None)
+    compressor = getattr(agent, "context_compressor", None)
+    db = getattr(agent, "_session_db", None)
+    row_id, uid = message.get("_row_id"), message.get("message_uid")
+    if (not isinstance(session_id, str) or not session_id
+            or getattr(compressor, "_session_id", None) != session_id
+            or (row_id is not None and (type(row_id) is not int or row_id <= 0))
+            or not isinstance(uid, str) or not uid or db is None):
+        return None
+    reader = getattr(db, "get_committed_summary_proof", None)
+    if not callable(reader):
+        return None
+    proof = reader(session_id, row_id, message_uid=uid)
+    if (proof is None or message.get("role") != proof["role"]
+            or message.get("_compressed_summary") is not True
+            or summary_content_fingerprint(message.get("content")) != proof["carrier_value_sha256"]):
+        return None
+    return proof
+
+
+def clear_summary_carrier_proofs(messages: list) -> None:
+    """Consume process-local capabilities before any ordinary request transport."""
+    for message in messages:
+        if isinstance(message, dict):
+            message.pop(SUMMARY_CARRIER_PROOF_KEY, None)
