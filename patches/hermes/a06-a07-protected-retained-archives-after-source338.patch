+async def issue_retained_for_turn(runner, event, selection):
+    """Use the existing foreground marker to acquire and stage its retained archive grants."""
+    from gateway.ordinary_archive_holder import _Prebind, owner_for_event
+    from gateway.run import _AGENT_PENDING_SENTINEL
+    from gateway.upload_anchor import _bind_retained_zip_for_gateway
+
+    operation = None
+    try:
+        prebind = owner_for_event(event)
+        if (type(selection) is not _RetainedSelection or selection.event is not event
+                or getattr(event, "_friday_archive_selection", None) is not selection
+                or selection.claim.archive_event_id != id(event) or not selection.original()
+                or type(prebind) is not _Prebind or prebind.runner is not runner
+                or prebind.setting or prebind.stopped or time.monotonic() >= selection.deadline):
+            return None
+        key, source = prebind.key, event.source
+        identity = identity_of(source)
+        cap = current(required=True)
+        state = runner._peek_session_state(key)
+        if (identity is None or cap is not getattr(source, "_friday_user_scope", None)
+                or cap.home != identity.runtime_home or cap.authorization_home != identity.authorization_home
+                or state is None or state.turn.event is not event or state.turn.agent is not _AGENT_PENDING_SENTINEL):
+            return None
+        binding = Binding(cap.principal, cap.profile, str(selection.message.chat.id), prebind.session_id,
+                          secrets.token_urlsafe(24), cap.admission_generation, cap.directory_identity)
+        anchor = WebCall(WebTurn(), selection.deadline, key, binding.session_id, binding.owner_generation)
+        anchor.session_key, anchor.turn_id, anchor.user_authority = key, prebind.marker, delegation_authority()
+        # Scope is already pinned by the Gateway holder. Resolve the existing
+        # session store handle without blocking the adapter loop on SQLite.
+        db = await asyncio.to_thread(runner.session_store._db_for_key, key)
+        with bind_web_call(anchor):
+            reference = selection.anchor_selector()
+            if reference is None:
+                retained = await _bind_retained_zip_for_gateway(runner, event, db, file_name=selection.anchor[2])
+            else:
+                retained = await _bind_retained_zip_for_gateway(runner, event, db, reference)
+        for destination, profile in selection.destinations:
+            guard_tool("write_file", {"path": destination, "format": ("zip" if profile == ZIP_AES else "7z")},
+                       execution=False)
+        operation = _RetainedOperation(runner, selection, prebind, state, cap, binding, anchor, retained)
+        event._friday_archive_operation = operation
+        calls = tuple(WebCall(anchor.turn, anchor.base_deadline, key, binding.session_id, secrets.token_urlsafe(24))
+                      for _ in selection.destinations)
+        for call in calls:
+            call.session_key, call.turn_id, call.user_authority = key, prebind.marker, anchor.user_authority
+        await asyncio.to_thread(operation.owner.issue, calls)
+        if not operation._turn_authorized(None):
+            operation.request_stop()
+            return None
+        operation._expiry = operation._loop.call_later(
+            max(0, selection.deadline - time.monotonic()), operation._expire,
+        )
+        return operation
+    except (ArchiveRefused, AttributeError, KeyError, OSError, ScopeDenied, RuntimeError, TypeError, ValueError):
+        if operation is not None:
+            operation.request_stop()
+        return None
+    except asyncio.CancelledError:
+        if operation is not None:
+            operation.request_stop()
+        raise
+
