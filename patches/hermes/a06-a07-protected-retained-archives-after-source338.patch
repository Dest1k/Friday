@@ -0,0 +1,568 @@
+"""Protected callback for an already selected native archive turn.
+
+The Gateway's existing direct TLS owner supplies the transport. The callback
+has no listener, registry or public entry point of its own.
+"""
+
+import asyncio
+from contextvars import ContextVar
+from hmac import compare_digest
+import secrets
+from threading import Event, Lock
+import time
+
+from gateway.ordinary_archive_issuer import _RetainedSelection, issue_for_turn, operation_for_event, retained_text
+from gateway.ordinary_f06_https import F06HTTPS, _REQUEST_ROUTE
+from hermes_cli.friday_protected_odt_http import (
+    ARCHIVE_LAUNCH_HEADER, MINIAPP_PATH, PATH, TICKET_PATH, READ_SECONDS, _REQUEST_REFUSALS, _Refused, _check_headers,
+    _header_values, _read_body, _respond, _respond_json, _same_origin_credential,
+    _take_body_ticket, _verified_principal,
+)
+
+_WORK = ContextVar("native_archive_protected_worker", default=None)
+_CLEANUP_SECONDS = 2.25  # Includes the stock codec's bounded two-second reap.
+_MINIAPP_TEXT = "Откройте защищённую форму для архива."
+_MINIAPP_BUTTON = "Открыть форму"
+
+
+def _wipe(buffer):
+    buffer[:] = bytes(len(buffer))
+
+
+class _Submission:
+    def __init__(self, interaction, buffer):
+        self.interaction = interaction
+        self.buffer = buffer
+        self._lock = Lock()
+        self._started = False
+        self.settled = Event()
+
+    def disarm(self):
+        """Retire an unentered worker before releasing the protected buffer."""
+        with self._lock:
+            if self._started or self.settled.is_set():
+                return
+            _wipe(self.buffer)
+            self.settled.set()
+        self.interaction._notify()
+
+    def invoke(self):
+        with self._lock:
+            if self._started or self.settled.is_set():
+                return
+            self._started = True
+        interaction = self.interaction
+        operation = interaction.operation
+        token = _WORK.set(self)
+        try:
+            with operation.runner._profile_scope_for_source(operation.source):
+                if interaction.authorizes_worker():
+                    interaction.receipt = operation.submit(self.buffer)
+        except Exception:
+            # Exceptions from protected scope or credential processing are private.
+            operation.request_stop()
+        finally:
+            _WORK.reset(token)
+            _wipe(self.buffer)
+            self.settled.set()
+            interaction._notify()
+
+
+class _ProtectedInput:
+    def __init__(self, owner, route, operation):
+        self.operation = operation
+        self._owner, self._route = owner, route
+        self._polling_progress = operation.selection.adapter._polling_progress_event
+        self._loop = asyncio.get_running_loop()
+        self._progress = asyncio.Event()
+        self._lock = Lock()
+        self._stopped_at = None
+        self._request = Event()
+        self._ack_request = Event()
+        self.delivery = None
+        self._ticket = secrets.token_urlsafe(32)
+        self._offered = self._offering = self._claimed = False
+        self._retained = type(operation.selection) is _RetainedSelection
+        self._launch_ref = secrets.token_urlsafe(24) if self._retained else None
+        self._launch_attempted = self._launch_acknowledged = False
+        self._launch = None
+        self._reader = self._work = self._driver = self.receipt = None
+
+    def _signature_current(self):
+        owner = self._owner
+        operation = self.operation
+        runner = operation.runner
+        adapter = operation.selection.adapter
+        app, bot = self._route[1:3]
+        updater = app.updater
+        if (owner._closing or getattr(runner, "_protected_odt_https", None) is not owner
+                or getattr(runner, "_protected_odt_channel", None) is not owner._channel
+                or getattr(runner, "_draining", False) or getattr(runner, "_external_drain_active", False)
+                or adapter._polling_progress_event is not self._polling_progress
+                or not self._polling_progress.is_set() or not adapter._polling_progress_accepting
+                or adapter.send_path_degraded or adapter._polling_last_progress_monotonic is None
+                or updater is None or not updater.running or updater.bot is not bot
+                or self._stopped_at is not None or time.monotonic() >= operation.selection.deadline
+                or operation_for_event(operation.selection.event) is not operation
+                or operation._protected_input is not self):
+            return False
+        route = owner._route_current(require_progress=False)
+        return (type(route) is tuple and len(route) == len(self._route)
+                and all(now is pinned for now, pinned in zip(route, self._route)))
+
+    def _current(self):
+        if (not self._signature_current()
+                or not self._owner._admitted(self.operation.selection.adapter)
+                or self._owner._route_current() is not self._route):
