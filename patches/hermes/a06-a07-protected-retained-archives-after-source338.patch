--- /dev/null
+++ b/plugins/platforms/telegram/telegram_archive_ingress.py
@@ -0,0 +1,283 @@
+"""Native Telegram custody for explicitly selected protected archive requests."""
+
+import asyncio
+from dataclasses import dataclass
+import inspect
+import logging
+import re
+import time
+
+from telegram import Document, Message, Update
+
+from gateway.platforms.event import MessageType
+
+from .telegram_ingress import has_pending_text
+from .telegram_message_event import build_message_event
+
+logger = logging.getLogger(__name__)
+_REFUSED = object()
+_RETAINED_REQUEST = re.compile(
+    r"\s*(?:используй(?:те)?|возьми(?:те)?)\s+(?:все\s+)?файлы\s+из\s+"
+    r"(?:уже\s+полученного|ранее\s+полученного|ранее\s+загруженного)\s+архива\s+"
+    r'(?:"([^"\n]+)"|«([^»\n]+)»|`([^`\n]+)`|([^\s]+?\.zip))\s*[.!]\s*(.+?)\s*',
+    re.IGNORECASE,
+)
+_PAIR_REQUEST = re.compile(
+    r"(?:создай(?:те)?|сделай(?:те)?)\s+"
+    r"(?:запароленн(?:ый|ые)|защищ[её]нн(?:ый|ые)\s+паролем)\s+zip\s+и\s+7z"
+    r"(?:\s+по\s+(?:явно\s+)?заданному\s+паролю)?"
+    r"(?:\s*;\s*не\s+вкладывай(?:те)?\s+пароль\s+внутрь)?[.!]?",
+    re.IGNORECASE,
+)
+_PRIVATE_7Z_REQUEST = re.compile(
+    r"(?:создай(?:те)?|сделай(?:те)?)\s+7z\s+"
+    r"(?:со\s+скрытием\s+им[её]н|с\s+зашифрованными\s+именами)"
+    r"(?:\s*,\s*проверь(?:те)?,\s*что\s+без\s+пароля\s+список\s+не\s+виден)?[.!]?",
+    re.IGNORECASE,
+)
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class ArchiveUploadSelection:
+    """Parameters supplied by a trusted in-process selector for one SDK Update."""
+
+    destination: str
+    member: str
+    profile: str
+    deadline: float
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class RetainedArchiveSelection:
+    """Host-selected historical receipt and output profiles for one native text Update."""
+
+    source_session_id: str | None
+    native_row_id: int | None
+    filename: str
+    destinations: tuple[tuple[str, str], ...]
+    deadline: float
+
+
+def _stock_retained_plan(adapter, message, match):
+    from gateway.ordinary_archive_issuer import retained_text
+    from gateway.ordinary_f06_https import https_ready_for
+    from gateway.run_attachment_presentation import _safe_name
+    from hermes_cli.friday_protected_archive import SEVEN_AES, SEVEN_PRIVATE, ZIP_AES
+    from hermes_cli.friday_protected_odt import TTL_SECONDS
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_zip import _path
+
+    if not retained_text(message):
+        return None
+    filename = next(name for name in match.groups()[:4] if name is not None)
+    if _safe_name(filename) != filename or not filename.lower().endswith(".zip"):
+        return None
+    action = match.group(5)
+    try:
+        stem = filename[:-4].encode("utf-8")[:120].decode("utf-8", errors="ignore")
+    except UnicodeError:
+        return None
+    message_id = message.message_id
+    if type(message_id) is not int or message_id <= 0:
+        return None
+    if _PAIR_REQUEST.fullmatch(action):
+        name = f"{stem}-protected-{message_id}"
+        destinations = ((f"{name}.zip", ZIP_AES), (f"{name}.7z", SEVEN_AES))
+    elif _PRIVATE_7Z_REQUEST.fullmatch(action):
+        destinations = ((f"{stem}-private-{message_id}.7z", SEVEN_PRIVATE),)
+    else:
+        return None
+    try:
+        _path(filename)
+        for path, _ in destinations:
+            _path(path)
+    except (ScopeDenied, ValueError):
+        return None
+
+    runner = adapter.gateway_runner
+    if (runner is None or not adapter._message_handler or adapter._should_drop_delayed_delivery()
+            or not https_ready_for(runner, adapter)):
+        return None
+    event = build_message_event(adapter, message, MessageType.TEXT)
+    event._preserve_native_origin = True
+    key = _idle_archive_key(runner, adapter, event)
+    if key is None or key in adapter._pending_messages or has_pending_text(adapter, key):
+        return None
+    return RetainedArchiveSelection(None, None, filename, destinations, time.monotonic() + TTL_SECONDS)
+
+
+def plan_for_update(adapter, update):
+    selector = getattr(adapter, "_protected_archive_selector", None)
+    message = update.message
+    if (type(update) is not Update or type(message) is not Message
+            or type(update.update_id) is not int or update.update_id <= 0
+            or message.chat.type != "private" or message.from_user is None
+            or message.from_user.is_bot or message.from_user.id != message.chat.id
+            or any(getattr(update, field, None) is not None for field in Update.ALL_TYPES if field != "message")):
+        return None
+    if selector is None:
+        if type(message.text) is not str or not 0 < len(message.text) <= 4096:
+            return None
+        match = _RETAINED_REQUEST.fullmatch(message.text)
+        if match is None or not adapter._is_user_authorized_from_message(message):
+            return None
+        return _stock_retained_plan(adapter, message, match)
+    if not adapter._is_user_authorized_from_message(message):
+        return None
+    from gateway.ordinary_archive_issuer import retained_text
+
+    if (type(message.document) is Document and message.text is None
+            and message.caption is None and not message.caption_entities):
+        expected = ArchiveUploadSelection
+    elif retained_text(message):
+        expected = RetainedArchiveSelection
+    else:
+        return None
+    try:
+        plan = selector(update)
+    except Exception as error:
+        logger.warning("Telegram archive selector failed (%s)", type(error).__name__)
+        return _REFUSED
+    if plan is None or type(plan) is expected:
+        return plan
+    if inspect.iscoroutine(plan):
+        plan.close()
+    return _REFUSED
+
+
+def _idle_archive_key(runner, adapter, event):
+    from gateway.session_identity import identity_of
+
+    if adapter._drop_unresolved(event):
+        return None
+    source = event.source
+    identity = identity_of(source)
+    if (identity is None or identity.transport_inferred or not identity.multiplexed
+            or identity.adapter() is not adapter or source.thread_id
+            or runner._intake_adapter_for(source) is not adapter
+            or runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True):
+        return None
+    key = adapter._event_session_key(event)
+    if (key != runner._session_key_for_source(source)
+            or key in adapter._active_sessions or key in adapter._session_tasks):
+        return None
+    return key
+
+
+def start_session(app, update, plan, claim_released, fifo_released):
+    """Reserve the stock session task while admission still owns this update."""
+    if type(plan) not in (ArchiveUploadSelection, RetainedArchiveSelection):
+        return
+    from gateway.ordinary_archive_issuer import select_retained, select_upload
+
+    from .update_admission import _PROCESSOR_TURN
+
+    adapter = app.adapter
+    runner = adapter.gateway_runner
+    if runner is None or not adapter._message_handler or adapter._should_drop_delayed_delivery():
+        return
+    message = update.message
+    if not adapter._should_process_message(message):
+        return
+    # Claim raw DM events before the ordinary prompt or batching path.
+    kind = MessageType.TEXT if type(plan) is RetainedArchiveSelection else MessageType.DOCUMENT
+    event = build_message_event(adapter, message, kind, update.update_id)
+    event.allow_gateway_control = False
+    event._preserve_native_origin = True
+    if kind is MessageType.TEXT:
+        selection = select_retained(adapter, event, update, plan)
+    else:
+        selection = select_upload(adapter, event, update, destination=plan.destination,
+                                  member=plan.member, profile=plan.profile, deadline=plan.deadline)
+    if selection is None:
+        return
+    session_key = _idle_archive_key(runner, adapter, event)
+    if session_key is None:
+        return
+    event._friday_archive_ingress_release = (claim_released, fifo_released)
+    claim_token = app._current_claim.set(None)
+    turn_token = _PROCESSOR_TURN.set(None)
+    try:
+        event._gateway_accepted = adapter._start_session_processing(event, session_key)
+    finally:
+        _PROCESSOR_TURN.reset(turn_token)
+        app._current_claim.reset(claim_token)
+
+
+async def prepare_session_input(adapter, event, session_key):
+    """Wait for the durable native receipt and prepare the selected input."""
+    from gateway.external_word_intent import hold_adapter_task_current
+    from gateway.ordinary_archive_issuer import _RetainedSelection, _Selection
+    from gateway.platforms.base import cache_document_from_bytes
+    from hermes_constants import (
+        get_routing_process_hermes_home, reset_hermes_home_override, set_hermes_home_override,
+    )
+
+    from .telegram_file_boundary import byte_limit
+
+    selection = getattr(event, "_friday_archive_selection", None)
+    releases = getattr(event, "_friday_archive_ingress_release", None)
+    if (type(selection) not in (_Selection, _RetainedSelection) or selection.adapter is not adapter
+            or selection.event is not event or releases is None):
+        return False
+    claim_released, fifo_released = releases
+    if not await asyncio.shield(claim_released):
+        return False
+    if fifo_released is not None:
+        await asyncio.shield(fifo_released)
+    runner = adapter.gateway_runner
+
+    def current():
+        claim = selection.claim
+        return (runner is not None and adapter.gateway_runner is runner
+                and claim.owners == 0 and claim.archive_receipt_closed is not None
+                and claim.archive_event_id == id(event)
+                and adapter._inflight_update_ids.get(claim.key) is not claim
+                and selection.original() and time.monotonic() < selection.deadline
+                and not adapter._should_drop_delayed_delivery()
+                and hold_adapter_task_current(runner, event, session_key, adapter=adapter))
+
+    if (not current() or runner._intake_adapter_for(event.source) is not adapter
+            or runner._is_user_authorized_for_source(event.source, allow_adapter_delegation=False) is not True):
+        return False
+    if type(selection) is _RetainedSelection:
+        return event._gateway_accepted is True
+    document = selection.document
+    try:
+        if document.file_size > byte_limit(adapter):
+            return False
+        async with asyncio.timeout(max(0, selection.deadline - time.monotonic())):
+            file_obj = await document.get_file()
+            if (not current() or getattr(file_obj, "file_id", None) != document.file_id
+                    or getattr(file_obj, "file_unique_id", None) != document.file_unique_id):
+                return False
+            data = bytes(await adapter._download_file(file_obj, document))
+            if len(data) != document.file_size or not current():
+                return False
+            launch_home = get_routing_process_hermes_home()
+            launch_cache = launch_home / "cache"
+
+            def confined(directory):
+                if not directory.is_relative_to(launch_cache) or directory.resolve() != directory:
+                    raise ValueError("archive_cache_directory_refused")
+
+            # Re-home consumes only the launch cache, even if the polling task
+            # inherited the scoped home of a secondary Telegram transport.
+            token = set_hermes_home_override(launch_home)
+            try:
+                path = await asyncio.to_thread(cache_document_from_bytes, data, "archive-input.bin",
+                                               directory_guard=confined)
+            finally:
+                reset_hermes_home_override(token)
+            if not current():
+                return False
+            adapter._stamp_media(event, selection.message, path, data)
+            if path not in event._telegram_media_receipts:
+                return False
+    except Exception as error:
+        logger.warning("Telegram archive upload preparation failed (%s)", type(error).__name__)
+        return False
+    event.media_urls = [path]
+    event.media_types = ["application/octet-stream"]
+    event.media_text_inlined = [False]
+    return True
