+
+async def bind_input(runner, event, selection, https_owner):
+    """Bind only inside the selected native Gateway turn with an owned HTTPS actor."""
+    from gateway.ordinary_archive_issuer import issue_retained_for_turn
+
+    operation = None
+    try:
+        adapter = selection.adapter
+        if (type(https_owner) is not F06HTTPS or https_owner._runner is not runner
+                or getattr(runner, "_protected_odt_https", None) is not https_owner
+                or not callable(https_owner._route_current) or not https_owner._admitted(adapter)):
+            return None
+        route = https_owner._route_current()
+        if (type(route) is not tuple or len(route) != 4 or route[0] is not adapter
+                or route[1] is not adapter._app or route[2] is not adapter._bot
+                or route[3] is not adapter._receipt_writer_lease):
+            return None
+        if type(selection) is _RetainedSelection:
+            operation = await issue_retained_for_turn(runner, event, selection)
+        else:
+            operation = issue_for_turn(runner, event, selection)
