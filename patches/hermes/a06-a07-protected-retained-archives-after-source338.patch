+                self._principal(credential)
+                staged = compare_digest(ticket, self._ticket) and delivery.acknowledge(body)
+                if not staged:
+                    raise _Refused(409)
+            except TimeoutError:
+                return await _respond(send, 408, "request_timeout")
+            except _Refused as error:
