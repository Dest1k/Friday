+"""Pre-model custody for a trusted native selection of one direct Telegram upload.
+
+The protected adapter caller selects the archive parameters. There is no listener,
+caption command or registration here, and the credential is accepted as an owned
+buffer only at the retained operation. Only a caller that already owns the stock
+inbound turn may invoke issuance.
+"""
+
+import asyncio
+from dataclasses import dataclass
+from hashlib import sha256
+import math
+from pathlib import PurePosixPath
+import secrets
+import time
+
+from agent.web_call_context import WebCall, WebTurn, bind_web_call
+from gateway.admitted_ingress import admitted_ingress
+from gateway.run_inbound_media import READABLE_ATTACHMENT_BYTES, owned_attachment_model_path
+from gateway.session_identity import identity_of
+from gateway.session_lifecycle import protected_archive_turn
+from gateway.turn_lease import SessionTurnLeaseRegistry, TurnLeaseToken
+from hermes_cli.friday_protected_archive import (
+    Approval, ArchiveRefused, Attachment, NativeArchiveOwner, RetainedArchiveBatch, SEVEN_AES, SEVEN_PRIVATE,
+    ZIP_AES,
+)
+from hermes_cli.friday_protected_odt import Binding, TTL_SECONDS
+from hermes_cli.friday_user_scope import (
+    ScopeDenied, current, delegation_authority, guard_tool, workspace_document,
+)
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class _Selection:
+    adapter: object
+    app: object
+    claim: object
+    update: object
+    message: object
+    document: object
+    event: object
+    polling_generation: int
+    upload_version: tuple
+    destination: str
+    member: str
+    profile: str
+    deadline: float
+
+    def original(self):
+        doc = self.document
+        return (
+            self.event.raw_message is self.message
+            and self.update.message is self.message
+            and self.message.document is doc
+            and self.message.get_bot() is self.adapter._bot
+            and self.app is self.adapter._app
+            and self.claim.lease is self.adapter._receipt_writer_lease
+            and self.claim.native_update is self.update
+            and not self.claim.failed and self.claim.lease.accepts(self.app)
+            and self.adapter._polling_generation == self.polling_generation
+            and self.event.platform_update_id == self.update.update_id
+            and self.event.message_id == str(self.message.message_id)
+            and (doc.file_id, doc.file_unique_id, doc.file_name, doc.file_size, doc.mime_type)
+            == self.upload_version
+            and not self.event.internal and not self.event._ingress_merged
+            and self.event.allow_gateway_control is False
+            and self.event.text == ""
+        )
+
+
+def select_upload(adapter, event, update, *, destination, member, profile, deadline):
+    """Seal an explicit native selection inside the original PTB admission handler."""
+    from telegram import Document, Message, Update
+    from plugins.platforms.telegram.update_admission import TelegramApplication, _Claim
+    from hermes_cli.friday_workspace_zip import _path
+
+    try:
+        if (type(update) is not Update or type(deadline) not in (float, int)
+                or not math.isfinite(deadline) or time.monotonic() >= deadline):
+            return None
+        app = adapter._app
+        if (type(app) is not TelegramApplication or app.adapter is not adapter
+                or app.bot is not adapter._bot):
+            return None
+        claim = app._current_claim.get()
+        key = f"{app.bot.id}:{update.update_id}"
+        if (type(claim) is not _Claim or claim.key != key or claim.archive_event_id is not None
+                or claim.native_update is not update or claim.dispatch_task is not asyncio.current_task()
+                or claim.completed or claim.failed or claim.owners <= 0
+                or adapter._inflight_update_ids.get(key) is not claim):
+            return None
+        raw = update.message
+        if (type(raw) is not Message or event.raw_message is not raw or raw.text is not None
+                or raw.chat.type != "private" or raw.from_user is None
+                or raw.from_user.is_bot or raw.from_user.id != raw.chat.id
+                or event.message_type.value != "document" or raw.photo
+                or any(getattr(raw, kind, None) is not None for kind in (
+                    "video", "audio", "voice", "sticker", "animation", "video_note", "location",
+                    "contact", "poll", "dice", "venue", "game", "story", "paid_media", "invoice",
+                ))
+                or any(getattr(raw, flag, None) for flag in (
+                    "forward_origin", "forward_date", "forward_from", "forward_from_chat",
+                    "forward_sender_name", "is_automatic_forward", "sender_chat", "via_bot",
+                    "business_connection_id", "media_group_id", "edit_date", "external_reply",
+                    "reply_to_message", "message_thread_id",
+                ))):
+            return None
+        doc = raw.document
+        if (type(doc) is not Document or type(doc.file_size) is not int
+                or not 0 < doc.file_size <= READABLE_ATTACHMENT_BYTES
+                or any(type(item) is not str or not 0 < len(item) <= 256
+                       for item in (doc.file_id, doc.file_unique_id, doc.file_name))
+                or hasattr(event, "_friday_archive_selection")):
+            return None
+        if type(profile) is not str or profile not in (ZIP_AES, SEVEN_AES, SEVEN_PRIVATE):
+            return None
+        if PurePosixPath(_path(destination)).suffix.lower() != (".zip" if profile == ZIP_AES else ".7z"):
+            return None
+        _path(member)
+        selection = _Selection(
+            adapter, app, claim, update, raw, doc, event, adapter._polling_generation,
+            (doc.file_id, doc.file_unique_id, doc.file_name, doc.file_size, doc.mime_type),
+            destination, member, profile, min(deadline, time.monotonic() + TTL_SECONDS),
+        )
+        # The selected caller must use the opaque document cache path and keep
+        # this original event outside model and ordinary hook dispatch.
+        if not selection.original():
+            return None
