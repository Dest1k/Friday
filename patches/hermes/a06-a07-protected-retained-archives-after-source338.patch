+            except TimeoutError:
+                _wipe(buffer)
+                return await _respond(send, 408, "request_timeout")
+            except _Refused as error:
+                _wipe(buffer)
+                return await _respond(send, error.status, _REQUEST_REFUSALS[error.status])
