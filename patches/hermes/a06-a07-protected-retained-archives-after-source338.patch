+                deadline = min(deadline, self._stopped_at + _CLEANUP_SECONDS)
+
+    async def wait(self):
+        """Hold the exact original Gateway task until protected custody is settled."""
+        if asyncio.current_task() is not self.operation.task:
+            raise RuntimeError("protected_archive_turn_refused")
+        cancelled = False
+        try:
+            await self._wait(self.operation.selection.deadline)
+            if self.delivery is not None:
+                await self.delivery.run()
+        except asyncio.CancelledError:
+            cancelled = True
+        finally:
+            self.operation.request_stop()
+            while not self._finished():
+                try:
+                    await self._wait(self._stopped_at + _CLEANUP_SECONDS)
+                    break
+                except asyncio.CancelledError:
+                    cancelled = True
+                    if time.monotonic() >= self._stopped_at + _CLEANUP_SECONDS:
+                        break
+        if cancelled:
+            raise asyncio.CancelledError
+
+    async def _run_owned(self, worker):
+        try:
+            await self._owner._channel.run_owned(worker.invoke)
+        except (asyncio.CancelledError, Exception):
+            self.operation.request_stop()
+        finally:
+            worker.disarm()
+            if not worker.settled.is_set():
