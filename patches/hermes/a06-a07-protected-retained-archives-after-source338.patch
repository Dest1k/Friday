+                self.operation.request_stop()
+                return
+            if not self._driver.done():
+                self.operation.request_stop()
+            outcome = self.receipt
+            if not worker.settled.is_set() or outcome is None or not self._current():
+                return await _respond(send, 503, "reconcile")
