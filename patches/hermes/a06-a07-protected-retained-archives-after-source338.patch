+def select_retained(adapter, event, update, plan):
+    """Seal the exact native text Update with the trusted caller's historical archive reference."""
+    from telegram import Update
+    from gateway.run_attachment_presentation import _safe_name
+    from gateway.upload_anchor import _selector
+    from hermes_cli.friday_workspace_zip import _path
+    from plugins.platforms.telegram.update_admission import TelegramApplication, _Claim
+
+    try:
+        if (type(update) is not Update or type(plan.deadline) not in (int, float)
+                or not math.isfinite(plan.deadline) or time.monotonic() >= plan.deadline
+                or not retained_text(update.message)
+                or any(getattr(update, field, None) is not None for field in Update.ALL_TYPES if field != "message")
+                or hasattr(event, "_friday_archive_selection")):
+            return None
+        app = adapter._app
+        if type(app) is not TelegramApplication or app.adapter is not adapter or app.bot is not adapter._bot:
+            return None
+        claim = app._current_claim.get()
+        key = f"{app.bot.id}:{update.update_id}"
+        if (type(claim) is not _Claim or claim.key != key or claim.archive_event_id is not None
+                or claim.native_update is not update or claim.dispatch_task is not asyncio.current_task()
+                or claim.completed or claim.failed or claim.owners <= 0
+                or adapter._inflight_update_ids.get(key) is not claim):
+            return None
+        if (type(plan.destinations) is not tuple
+                or not all(type(item) is tuple and len(item) == 2 for item in plan.destinations)
+                or tuple(profile for _, profile in plan.destinations) not in ((ZIP_AES, SEVEN_AES), (SEVEN_PRIVATE,))
+                or any(PurePosixPath(_path(path)).suffix.lower() != (".zip" if profile == ZIP_AES else ".7z")
+                       for path, profile in plan.destinations)):
+            return None
+        if (type(plan.filename) is not str or _safe_name(plan.filename) != plan.filename
+                or not plan.filename.lower().endswith(".zip")):
+            return None
+        if plan.source_session_id is None and plan.native_row_id is None:
+            anchor = (None, None, plan.filename)
+        else:
+            anchor = _selector({"source_session_id": plan.source_session_id, "native_row_id": plan.native_row_id,
+                                "file_name": plan.filename})
+        message = update.message
+        ids = (app.bot.id, message.from_user.id, message.chat.id, message.message_id, update.update_id)
+        if any(type(value) is not int or value <= 0 for value in ids):
+            return None
+        selection = _RetainedSelection(adapter, app, claim, update, message, event, adapter._polling_generation,
+                                       message.text, ids, anchor, plan.destinations,
+                                       min(plan.deadline, time.monotonic() + TTL_SECONDS))
+        if not selection.original():
+            return None
+        event._friday_archive_selection = selection
+        claim.archive_event_id = id(event)
+        return selection
+    except (AttributeError, ArithmeticError, RuntimeError, ScopeDenied, TypeError, ValueError):
+        return None
