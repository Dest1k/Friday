+            headers = _header_values(scope)
+            credential = _same_origin_credential(headers, self._owner._channel.origin)
+            if (headers.get(b"content-length", b"0") != b"0" or b"content-encoding" in headers
+                    or b"content-type" in headers):
+                raise _Refused(400)
+            self._principal(credential)
+            self._check_launch(headers)
