+def retained_text(message):
+    """Recognize the plain native DM shape supported by the protected text route."""
+    from telegram import Message
+
+    return (type(message) is Message and type(message.text) is str
+            and 0 < len(message.text) <= 4096 and bool(message.text.strip())
+            and not message.text.lstrip().startswith("/") and not message.entities
+            and message.chat.type == "private" and message.from_user is not None
+            and not message.from_user.is_bot and message.from_user.id == message.chat.id
+            and not message.photo and not message.caption_entities
+            and all(getattr(message, field, None) is None for field in (
+                "caption", "document", "video", "audio", "voice", "sticker", "animation", "video_note",
+                "location", "contact", "poll", "dice", "venue", "game", "story", "paid_media", "invoice",
+                "forward_origin", "forward_date", "forward_from", "forward_from_chat", "forward_sender_name",
+                "is_automatic_forward", "sender_chat", "via_bot", "business_connection_id", "media_group_id",
+                "edit_date", "external_reply", "reply_to_message", "message_thread_id",
+            )))
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class _RetainedSelection:
+    adapter: object
+    app: object
+    claim: object
+    update: object
+    message: object
+    event: object
+    polling_generation: int
+    text: str
+    ids: tuple
+    anchor: tuple
+    destinations: tuple
+    deadline: float
+
+    def original(self):
+        event, message, adapter = self.event, self.message, self.adapter
+        return (
+            event.raw_message is message and self.update.message is message and retained_text(message)
+            and message.get_bot() is adapter._bot and self.app is adapter._app and self.app.bot is adapter._bot
+            and self.claim.lease is adapter._receipt_writer_lease and self.claim.native_update is self.update
+            and not self.claim.failed and self.claim.lease.accepts(self.app)
+            and adapter._polling_generation == self.polling_generation
+            and (adapter._bot.id, message.from_user.id, message.chat.id, message.message_id,
+                 self.update.update_id) == self.ids
+            and event.platform_update_id == self.update.update_id and event.message_id == str(message.message_id)
+            and event.text == message.text == self.text and event.message_type.value == "text"
+            and not event.media_urls and not event.media_types and not event.reply_to_message_id
+            and not event.internal and not event._ingress_merged and event.allow_gateway_control is False
+        )
+
+    def anchor_selector(self):
+        session_id, row_id, filename = self.anchor
+        if session_id is None:
+            return None
+        return {"source_session_id": session_id, "native_row_id": row_id, "file_name": filename}
