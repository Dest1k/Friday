+            self._claimed = True
+            disconnect = asyncio.create_task(receive())
+            await asyncio.sleep(0)  # Observe an already queued disconnect before any work.
+            if disconnect.done():
+                self.operation.request_stop()
+                return
+            with self._lock:
+                if self._stopped_at is None:
+                    worker = self._work = _Submission(self, buffer)
+                    buffer = None
+            if worker is None:
+                return await _respond(send, 409, "receipt_unavailable")
