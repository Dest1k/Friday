+        except (OSError, AttributeError, RuntimeError, TypeError, ValueError):
+            pass  # Native scope failures may contain private details.
+        raise _Refused(403)
+
+    def _check_launch(self, headers):
+        value = headers.get(ARCHIVE_LAUNCH_HEADER)
+        if self._retained:
