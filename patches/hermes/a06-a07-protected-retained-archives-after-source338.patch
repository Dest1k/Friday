+def issue_for_turn(runner, event, selection):
+    """Issue only in the admitted task after the real lease, marker and re-home."""
+    from gateway.external_word_intent import hold_adapter_task_current
+    from gateway.run import _AGENT_PENDING_SENTINEL
+
+    try:
+        if (type(selection) is not _Selection or selection.event is not event
+                or selection.claim.archive_event_id != id(event)
+                or getattr(event, "_friday_archive_selection", None) is not selection
+                or hasattr(event, "_friday_archive_operation") or not selection.original()
+                or time.monotonic() >= selection.deadline):
+            return None
+        adapter, source = selection.adapter, event.source
+        key, identity = runner._session_key_for_source(source), identity_of(source)
+        if (identity is None or identity.transport_inferred or not identity.multiplexed
+                or identity.adapter() is not adapter or runner._intake_adapter_for(source) is not adapter
+                or not hold_adapter_task_current(runner, event, key, adapter=adapter)
+                or runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True):
+            return None
+        state = runner._peek_session_state(key)
+        if state is None or state.turn.event is not event or state.turn.agent is not _AGENT_PENDING_SENTINEL:
+            return None
+        generation = state.persistent.run_generation
+        lease = state.turn.lease_tokens.get(generation)
+        entry = runner.session_store.lookup_by_session_key(key)
+        marker = getattr(event, "_gateway_active_turn_token", None)
+        if (type(lease) is not TurnLeaseToken or type(generation) is not int or generation < 1
+                or type(getattr(runner, "_turn_leases", None)) is not SessionTurnLeaseRegistry
+                or entry is None or entry.session_id != lease.session_id or entry.active_turn_token != marker
+                or not protected_archive_turn(marker)
+                or getattr(event, "_gateway_active_turn_session_key", None) != key):
+            return None
+        cap = current(required=True)
+        if (cap is not getattr(source, "_friday_user_scope", None)
+                or cap.home != identity.runtime_home or cap.authorization_home != identity.authorization_home):
+            return None
+        attachment = _attachment(event, selection, cap, key)
+        if attachment is None:
+            return None
+        binding = Binding(cap.principal, cap.profile, str(selection.message.chat.id), lease.session_id,
+                          secrets.token_urlsafe(24), cap.admission_generation, cap.directory_identity)
+        approval = Approval(binding, (attachment,), selection.destination, selection.profile)
+        approval.check_shape()
+        guard_tool("read_file", {"path": attachment.source}, execution=False)
+        guard_tool("write_file", {"path": approval.destination,
+                                  "format": PurePosixPath(approval.destination).suffix.lower()[1:]}, execution=False)
+        operation = _Operation(runner, selection, key, state, lease, cap, marker, approval,
+                               asyncio.current_task(), event._friday_document_guard[1])
+        event._friday_archive_operation = operation
+        with bind_web_call(operation.call):
+            operation._ticket = operation.owner.issue(approval)
+        operation._expiry = operation._loop.call_later(
+            max(0, selection.deadline - time.monotonic()), operation._expire,
+        )
+        return operation
+    except (ArchiveRefused, AttributeError, KeyError, OSError, ScopeDenied, RuntimeError, TypeError, ValueError):
+        return None
+
+
+def operation_for_event(event):
+    operation = getattr(event, "_friday_archive_operation", None)
+    if type(operation) in (_Operation, _RetainedOperation) and operation.selection.event is event:
+        return operation
