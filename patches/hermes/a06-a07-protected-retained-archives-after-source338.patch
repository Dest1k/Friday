index 0000000000000000000000000000000000000000..ce401e62467781735543d990712944b9a69f8a06
--- /dev/null
+++ b/gateway/ordinary_archive_holder.py
@@ -0,0 +1,188 @@
+"""Stock foreground ownership of an explicitly selected protected archive upload."""
+
+import asyncio
+import logging
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def selected(event):
+    selection = getattr(event, "_friday_archive_selection", None)
+    if selection is None:
+        return False
+
+    from gateway.ordinary_archive_issuer import _RetainedSelection, _Selection
+
+    # A stale copy of a protected event must still avoid ordinary dispatch.
+    return type(selection) in (_Selection, _RetainedSelection)
+
+
+def selection_for(event):
+    if selected(event):
+        selection = event._friday_archive_selection
+        if selection.event is event and selection.claim.archive_event_id == id(event):
+            return selection
+    return None
+
+
+class _Prebind:
+    """Retain the exact turn while its off-loop marker may still materialize."""
+
+    def __init__(self, runner, event, key, generation, lease):
+        self.runner, self.event, self.key = runner, event, key
+        self.generation, self.lease = generation, lease
+        self.session_id = lease.session_id
+        self.setting = True
+        self.stopped = self.marker_cleared = False
+        self.marker = None
+
+    def owns_turn_lease(self, generation, token):
+        return generation == self.generation and token is self.lease
+
+    def marker_absent(self):
+        entry = self.runner.session_store.lookup_by_session_key(self.key)
+        return (entry is not None and entry.session_id == self.session_id
+                and entry.active_turn_token is None)
+
+    def stop_status(self):
+        return "PENDING" if self.setting else "QUIESCENT"
+
+    def release_ready(self):
+        return not self.setting and self.marker_cleared
+
+    def request_stop(self):
+        self.stopped = True
+
+    def close(self):
+        self.request_stop()
+        return {"status": "STOP_UNCONFIRMED", "reason": "archive_marker_pending"} if self.setting else {
+            "status": "QUIESCENT", "sessions": [],
+        }
+
+
+def owner_for_event(event):
+    from gateway.ordinary_archive_issuer import operation_for_event
+
+    operation = operation_for_event(event)
+    if operation is not None:
+        return operation
+    prebind = getattr(event, "_friday_archive_prebind", None)
+    if type(prebind) is _Prebind and prebind.event is event:
+        return prebind
+    return None
+
+
+async def process_adapter_task(adapter, event, key):
+    """Run on the stock adapter task with its own guard, outside reply hooks."""
+    from plugins.platforms.telegram.telegram_archive_ingress import prepare_session_input
+
+    binding = getattr(event, "_friday_document_guard", None)
+    task = asyncio.current_task()
+    if (type(binding) is not tuple or len(binding) != 2
+            or binding[0] != key or adapter._session_tasks.get(key) is not task
+            or adapter._active_sessions.get(key) is not binding[1]):
+        return
+    guard = binding[1]
+    try:
+        selection = selection_for(event)
+        if (selection is not None and selection.adapter is adapter
+                and await prepare_session_input(adapter, event, key)):
+            # Gateway owns protected marker CAS. Its return cannot become
+            # an ordinary text reply, post-delivery callback or artifact send.
+            event._turn_marker_handoff = False
+            await adapter._message_handler(event)
+    except Exception as exc:
+        logger.warning("Protected archive turn did not complete (%s)", type(exc).__name__)
+    finally:
+        if adapter._session_tasks.get(key) is task and adapter._active_sessions.get(key) is guard:
+            operation = owner_for_event(event)
+            if task.cancelling() or (operation is not None and not operation.release_ready()):
+                # Preserve parked follow-ups when Gateway still owns this
+                # exact lease. They cannot inherit archive custody.
+                adapter._cleanup_finished_session_task(key, guard)
+            else:
+                try:
+                    await adapter._flush_text_debounce_now(key)
+                finally:
+                    adapter._finish_session_task(key, guard)
+
+
+async def run_turn(runner, event, source, key, generation):
+    """Resolve and retain the original Gateway lease until private input settles."""
+    from gateway.external_word_intent import hold_adapter_task_current
+    from gateway.ordinary_archive_input import bind_input
+    from gateway.ordinary_archive_issuer import _RetainedSelection
+    from gateway.ordinary_f06_https import https_ready_for
+    from gateway.run_inbound_media import rehome_inbound_media
+    from gateway.turn_lease import TurnLeaseToken
+    from hermes_cli.friday_user_scope import ScopeDenied, check_database, current
+
+    selection = selection_for(event)
+    if selection is None:
+        return
+    adapter = selection.adapter
+
+    def still_current():
+        state = runner._peek_session_state(key)
+        return (selection.claim.owners == 0 and selection.original()
+                and time.monotonic() < selection.deadline
+                and event.source is source and not source.thread_id
+                and source._friday_user_scope is current(required=True)
+                and state is not None and state.turn.event is event
+                and runner._is_session_run_current(key, generation)
+                and hold_adapter_task_current(runner, event, key, adapter=adapter)
+                and runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is True
+                and https_ready_for(runner, adapter))
+
+    try:
+        if not still_current():
+            return
+        check_database()
+        # Use the stock exact route path; ordinary topic recovery cannot
+        # readdress this direct SDK upload.
+        metadata = event.metadata
+        event.metadata = {"gateway_session_key": key}
+        try:
+            resolved = await runner._hmwa_resolve_session(event, source)
+        finally:
+            event.metadata = metadata
+        if (resolved is None or resolved[0] is not source or resolved[2] != key
+                or not still_current()):
+            return
+        entry = resolved[1]
+        await runner._hmwa_acquire_turn_lease(key, generation, entry, [])
+        if not still_current():
+            return
+        state = runner._peek_session_state(key)
+        lease = state.turn.lease_tokens.get(generation)
+        if (type(lease) is not TurnLeaseToken or lease.owner_key != key or lease.generation != generation
+                or lease.session_id != entry.session_id or lease.released or lease.lease.holder is not lease):
+            return
+        prebind = _Prebind(runner, event, key, generation, lease)
+        event._friday_archive_prebind = prebind
+        try:
+            marked = await runner._mark_durable_active_turn(
+                event, key, protected_archive_session_id=entry.session_id,
+            )
+        finally:
+            prebind.marker = getattr(event, "_gateway_active_turn_token", None)
+            prebind.setting = False
+        if not marked or prebind.stopped or not still_current():
+            return
+        source._friday_document_turn = (key, event._gateway_active_turn_token)
+        source._friday_document_run = (key, generation)
+        if type(selection) is not _RetainedSelection:
+            rehome_inbound_media(event)
+        if not still_current():
+            return
+        holder = await bind_input(runner, event, selection, runner._protected_odt_https)
+        if (holder is not None and type(selection) is _RetainedSelection
+                and not await holder.offer_miniapp()):
+            return
+        if holder is not None:
+            await holder.wait()
+    except (AttributeError, OSError, RuntimeError, ScopeDenied, TypeError, ValueError):
+        # Missing archive marker support and failed native scope both close
+        # the selected turn before any protected worker can start.
+        return
