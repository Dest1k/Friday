+
+    async def __call__(self, scope, receive, send):
+        """Private callback called by the already-owned protected HTTPS route."""
+        try:
+            path = scope.get("path")
+            if (asyncio.get_running_loop() is not self._loop or scope.get("type") != "http"
+                    or scope.get("scheme") != "https" or path not in (PATH, TICKET_PATH)
