+def _attachment(event, selection, cap, key):
+    proof = admitted_ingress(event, event.source, key)
+    if proof is None:
+        return None
+    message = proof["message"]
+    if (proof["platform"] != "telegram" or proof["runtime_profile"] != cap.profile
+            or proof["source_profile"] not in ("", cap.profile)
+            or cap.principal != ("telegram", proof["transport_profile"], message["bot_id"], message["user_id"])
+            or message["chat_id"] != message["user_id"] or message["thread_id"] != ""
+            or message["message_id"] != event.message_id
+            or str(message["platform_update_id"]) != str(selection.update.update_id)):
+        return None
+    paths = event.media_urls
+    if type(paths) is not list or len(paths) != 1 or type(paths[0]) is not str:
+        return None
+    path = paths[0]
+    relative = owned_attachment_model_path(event, path)
+    items = message["media"]
+    if relative is None or len(items) != 1 or items[0]["local_reference"] != path:
+        return None
+    media = items[0]
+    origin, content = media.get("origin"), media.get("content")
+    document = selection.document
+    if (type(origin) is not dict or type(content) is not dict
+            or origin.get("message_id") != event.message_id
+            or origin.get("file_id") != document.file_id
+            or origin.get("file_unique_id") != document.file_unique_id
+            or type(content.get("size_bytes")) is not int
+            or content["size_bytes"] != document.file_size
+            or origin.get("declared_bytes") != document.file_size):
+        return None
+    data, actual_relative, file_identity = workspace_document(
+        path, max_bytes=READABLE_ATTACHMENT_BYTES, with_identity=True,
+    )
+    if (actual_relative != relative or len(data) != content["size_bytes"]
+            or sha256(data).hexdigest() != content["sha256"]):
+        return None
+    return Attachment(event.message_id, selection.document.file_unique_id, relative,
+                      selection.member, content["sha256"], file_identity)
+
+
+class _Operation:
+    """Ownership remains on the original gateway event across STOP invalidation."""
+
+    def __init__(self, runner, selection, key, state, lease, cap, marker, approval, task, guard):
+        self._init_turn(runner, selection, key, state, lease, cap, marker, task, guard)
+        self.approval, self.binding = approval, approval.binding
+        self.path = selection.event.media_urls[0]
+        self.owner = NativeArchiveOwner(self._authorize)
+        self.call = WebCall(WebTurn(), selection.deadline, key, self.session_id, approval.binding.owner_generation)
+        self.call.session_key = key
+        self.call.turn_id = marker
+        self.call.user_authority = delegation_authority()
+        self._ticket = None
+
+    def _init_turn(self, runner, selection, key, state, lease, cap, marker, task, guard):
+        self.runner, self.selection, self.key = runner, selection, key
+        self.state, self.turn, self.lease = state, state.turn, lease
+        self.registry = runner._turn_leases
+        self.agent_slot = self.turn.agent
+        self.source, self.cap = selection.event.source, cap
+        self.identity = identity_of(self.source)
+        self.generation, self.session_id = lease.generation, lease.session_id
+        self.marker = marker
+        self.marker_cleared = False
+        self.task, self.guard = task, guard
+        self._protected_input = None
+        self._expiry = None
+        self._loop = asyncio.get_running_loop()
+
+    def owns_turn_lease(self, generation, token):
+        return self.generation == generation and self.lease is token
+
+    def _authorize(self, approval):
+        protected = self._protected_input
+        return (protected is None or protected.authorizes_worker()) and self._turn_authorized(approval)
+
+    def _approval_current(self, approval):
+        event = self.selection.event
+        return (approval is self.approval and event.media_urls == [self.path]
+                and owned_attachment_model_path(event, self.path) == approval.attachments[0].source)
+
+    def _turn_authorized(self, approval):
+        event, adapter = self.selection.event, self.selection.adapter
+        lease, source = self.lease, self.source
+        try:
+            state = self.runner._peek_session_state(self.key)
+            if (state is not self.state or state.turn is not self.turn
+                    or state.turn.event is not event or event.source is not source
+                    or state.turn.agent is not self.agent_slot
+                    or getattr(event, "_friday_archive_operation", None) is not self
+                    or getattr(event, "_friday_archive_selection", None) is not self.selection
+                    or self.selection.claim.archive_event_id != id(event)
+                    or state.persistent.run_generation != self.generation
+                    or state.turn.lease_tokens.get(self.generation) is not lease
+                    or self.runner._turn_leases is not self.registry
+                    or self.registry._leases.get(self.session_id) is not lease.lease
+                    or lease.released is not False or lease.lease.holder is not lease
+                    or not lease.lease.lock.locked() or lease.session_id != self.session_id
+                    or lease.owner_key != self.key or lease.generation != self.generation
+                    or getattr(event, "_gateway_active_turn_session_key", None) != self.key
+                    or getattr(event, "_gateway_active_turn_token", None) != self.marker
+                    or getattr(event, "_friday_document_guard", None) != (self.key, self.guard)
+                    or adapter._session_tasks.get(self.key) is not self.task
+                    or adapter._active_sessions.get(self.key) is not self.guard
+                    or self.task.done() or self.task.cancelling() or self.guard.is_set()
+                    or not self.selection.original()
+                    or identity_of(source) is not self.identity or self.identity.adapter() is not adapter
+                    or source.is_bot or source.delivered_via_upstream_relay or source.thread_id
+                    or source.chat_type != "dm" or source.chat_id != source.user_id
+                    or source.user_id != str(self.selection.message.from_user.id)
+                    or adapter.gateway_runner is not self.runner
+                    or self.runner._intake_adapter_for(source) is not adapter
+                    or self.runner._session_key_for_source(source) != self.key
+                    or self.runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True
+                    or current(required=True) is not self.cap
+                    or getattr(source, "_friday_user_scope", None) is not self.cap
+                    or not self._approval_current(approval)):
+                return False
+            entry = self.runner.session_store.lookup_by_session_key(self.key)
+            return (entry is not None and entry.session_id == self.session_id
+                    and entry.active_turn_token == self.marker)
+        except (AttributeError, RuntimeError, ScopeDenied, TypeError, ValueError):
+            return False
+
+    def submit(self, secret):
+        """Trusted protected caller supplies only the owned, mutable credential."""
+        if type(secret) is not bytearray:
+            return {"success": False, "error": "archive_input_refused", "effect_disposition": "none"}
+        try:
+            if not self._authorize(self.approval) or time.monotonic() >= self.selection.deadline:
+                return {"success": False, "error": "archive_scope_refused", "effect_disposition": "none"}
+            with bind_web_call(self.call):
+                return self.owner.submit(self.approval.binding, self._ticket, secret)
+        finally:
+            secret[:] = bytes(len(secret))
+
+    def request_stop(self):
+        self.owner.request_stop()
+        if self._protected_input is not None:
+            self._protected_input.request_stop()
+
+    def _expire(self):
+        if self._protected_input is None:
+            self.close()
+        else:
+            self.request_stop()
+
+    def close(self):
+        self.request_stop()
+        if self._expiry is not None and not self._loop.is_closed():
+            self._loop.call_soon_threadsafe(self._expiry.cancel)
+        if self._protected_input is not None and self._protected_input.delivery_unknown():
+            return {"status": "STOP_UNCONFIRMED", "reason": "archive_delivery_uncertain"}
+        if self._protected_input is not None and self._protected_input.pending():
+            self.call.stopped.set()
+            self.call.turn.stopped.set()
+            reason = ("archive_effect_uncertain" if self.owner.stop_status() == "UNKNOWN"
+                      else "archive_protected_input_pending")
+            return {"status": "STOP_UNCONFIRMED", "reason": reason}
+        return self.call.turn.stop()
+
+    def stop_status(self):
+        status = self.owner.stop_status()
+        if self._protected_input is not None and self._protected_input.delivery_unknown():
+            return "UNKNOWN"
+        if status != "UNKNOWN" and self._protected_input is not None and self._protected_input.pending():
+            return "PENDING"
+        return status
+
+    def release_ready(self):
+        return self.marker_cleared and self.stop_status() == "QUIESCENT"
+
+    def marker_absent(self):
+        entry = self.runner.session_store.lookup_by_session_key(self.key)
+        return (entry is not None and entry.session_id == self.session_id
+                and entry.active_turn_token is None)
+
+
+class _RetainedOperation(_Operation):
+    """Keep the retained native turn while approved archive siblings settle."""
+
+    def __init__(self, runner, selection, prebind, state, cap, binding, call, retained):
+        key = prebind.key
+        event = prebind.event
+        self._init_turn(runner, selection, key, state, prebind.lease, cap, prebind.marker,
+                        asyncio.current_task(), event._friday_document_guard[1])
+        self.prebind, self.call, self.binding = prebind, call, binding
+        self.approval = None
+        self.owner = RetainedArchiveBatch(retained, binding, selection.destinations, self._authorize)
+
+    def _approval_current(self, approval):
+        return (not self.prebind.stopped and not self.prebind.marker_cleared
+                and self.prebind.owns_turn_lease(self.generation, self.lease)
+                and (approval is None or any(candidate is approval for candidate in self.owner._approvals)))
+
+    def submit(self, secret):
+        if type(secret) is not bytearray:
+            return ()
+        try:
+            if not self._authorize(None) or time.monotonic() >= self.selection.deadline:
+                return ()
+            return self.owner.submit(secret)
+        finally:
+            secret[:] = bytes(len(secret))
+
+    def request_stop(self):
+        self.prebind.request_stop()
+        super().request_stop()
+
