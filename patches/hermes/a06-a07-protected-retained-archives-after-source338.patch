new file mode 100644
index 0000000000000000000000000000000000000000..2624df0a38a8649b2fa3e4db528fa2eecf9b9315
--- /dev/null
+++ b/gateway/ordinary_archive_delivery.py
@@ -0,0 +1,288 @@
+"""One acknowledged delivery of verified archive outputs on their original turn."""
+
+import asyncio
+import copy
+from dataclasses import dataclass
+from hashlib import sha256
+from hmac import compare_digest
+from pathlib import PurePosixPath
+import secrets
+from threading import Lock
+import time
+
+from gateway.run_plugin_delivery import (
+    _DocumentHistoryTimeout, _begin_ordinary_document, _ordinary_authority, _ordinary_commit,
+    deliver_document, freeze_route,
+)
+from hermes_cli.friday_native_state import encoded
+from hermes_cli.friday_protected_archive import RetainedArchiveBatch, _VerifiedArchive
+from hermes_cli.friday_user_scope import current, workspace_document
+
+
+_JOURNAL_LOCK_WAIT = 2.0
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class _Output:
+    outcome: dict
+    witness: _VerifiedArchive
+
+
+def _binding_scope(binding):
+    return (binding.principal, binding.profile, binding.chat_id, binding.session_id,
+            binding.admission_generation, binding.home_identity)
+
+
+def _call_scope(call):
+    return (call.turn, call.session_id, call.session_key, call.turn_id, call.base_deadline,
+            call.run_deadline, call.user_authority)
+
+
+class ArchiveDelivery:
+    """A verified write becomes eligible after proof of receipt from its client."""
+
+    def __init__(self, interaction, outputs, *, retained=False):
+        self.interaction = interaction
+        self._operation = operation = interaction.operation
+        self._owner = operation.owner
+        self._approval = operation.approval
+        self._binding = operation.binding
+        self._source = operation.source
+        self._run = operation.source._friday_document_run
+        self._generation = operation.generation
+        self._selection = operation.selection
+        self._adapter = operation.selection.adapter
+        self._ingress = operation.selection.message
+        self._call = operation.call
+        self._receipt = interaction.receipt
+        self._outputs = outputs
+        self._retained = retained
+        self._cutoff = operation.selection.deadline
+        if retained:
+            self._cutoff = min(self._cutoff, self._call.deadline(),
+                               self._owner._approvals[0].retained_source.deadline)
+        self.challenge = secrets.token_urlsafe(32)
+        self.state = "WAITING_ACK"
+        self._lock = Lock()
+        self._stopped = False
+        self._output_states = ["NOT_ATTEMPTED"] * len(outputs)
+        self._receipts = [None] * len(outputs)
+        self.receipt = None
+
+    @classmethod
+    def from_receipt(cls, interaction):
+        """Build only from the settled worker's native outcome and witness identities."""
+        operation = interaction.operation
+        owner, outcome = operation.owner, interaction.receipt
+        if type(owner) is not RetainedArchiveBatch:
+            if type(outcome) is not dict or outcome.get("effect_disposition") == "unknown":
+                return None, 503
+            if outcome.get("effect_disposition") != "committed" or outcome.get("success") is not True:
+                return None, 409
+            witness = owner.verified_archive(outcome)
+            if witness is None:
+                return None, 503
+            return cls(interaction, (_Output(outcome, witness),)), 202
+
+        if (type(outcome) is not tuple or outcome is not owner.outcomes()
+                or owner.stop_status() != "QUIESCENT"):
+            return None, 503
+        approvals, calls = owner._approvals, owner._calls
+        if (len(outcome) != len(approvals) or any(
+                type(item) is not dict or item.get("effect_disposition") != "committed"
+                or item.get("success") is not True for item in outcome)):
+            return None, 409
+
+        from agent.web_call_context import WebCall
+
+        call = operation.call
+        if (type(call) is not WebCall or len(calls) != len(approvals)
+                or any(_call_scope(child) != _call_scope(call)
+                       or child.authorization_gate is not call.authorization_gate for child in calls)):
+            return None, 503
+        scope = _binding_scope(operation.binding)
+        outputs = []
+        for approval, item in zip(approvals, outcome, strict=True):
+            witness = owner.verified_archive(item)
+            if (_binding_scope(approval.binding) != scope
+                    or type(witness) is not _VerifiedArchive or witness.path != approval.destination):
+                return None, 503
+            outputs.append(_Output(item, witness))
+        if len({output.witness.path for output in outputs}) != len(outputs):
+            return None, 503
+        delivery = cls(interaction, tuple(outputs), retained=True)
+        if time.monotonic() >= delivery._cutoff:
+            return None, 503
+        return delivery, 202
+
+    @property
+    def output_states(self):
+        with self._lock:
+            return tuple(self._output_states)
+
+    @property
+    def receipts(self):
+        with self._lock:
+            return tuple(self._receipts)
+
+    def acknowledge(self, nonce):
+        with self._lock:
+            if (self.state != "WAITING_ACK" or time.monotonic() >= self._cutoff
+                    or not compare_digest(nonce, self.challenge.encode("ascii"))):
+                return False
+            self.state = "ACKNOWLEDGING"
+            return True
+
+    def finish_ack(self, locally_sent):
+        with self._lock:
+            if self.state == "ACKNOWLEDGING":
+                valid = locally_sent and time.monotonic() < self._cutoff
+                self.state = "READY" if valid else "REFUSED"
+
+    def stop(self):
+        with self._lock:
+            self._stopped = True
+            if self.state in ("WAITING_ACK", "ACKNOWLEDGING", "READY"):
+                self.state = "REFUSED"
+
+    def _check_live(self, cap):
+        interaction, operation = self.interaction, self._operation
+        if (self._stopped or time.monotonic() >= self._cutoff or current(required=True) is not cap
+                or interaction.operation is not operation or operation._protected_input is not interaction
+                or interaction.delivery is not self
+                or operation.owner is not self._owner or operation.call is not self._call
+                or operation.approval is not self._approval or operation.binding is not self._binding
+                or operation.source is not self._source
+                or operation.generation != self._generation
+                or self._source._friday_document_run is not self._run
+                or operation.selection is not self._selection or self._selection.message is not self._ingress
+                or self._selection.adapter is not self._adapter
+                or (self._retained and self._ingress.get_bot() is not self._adapter._bot)
+                or interaction.receipt is not self._receipt or not interaction._current()):
+            raise ValueError("archive_delivery_owner_changed")
+        self._call.check()
+
+    async def _send(self, index, cap, runner, context, route, check_origin):
+        output = self._outputs[index]
+        witness = output.witness
+        path = str(cap.home / "workspace" / witness.path)
+
+        def authority():
+            self._check_live(cap)
+            if (self._owner.verified_archive(output.outcome) is not witness
+                    or (self._retained and self._owner.outcomes() is not self._receipt)):
+                raise ValueError("archive_delivery_witness_changed")
+            check_origin()
+
+        def snapshot():
+            authority()
+            # The retained writer's exact size is already bounded by its native
+            # publisher. Preserve the existing direct-upload read limit.
+            limits = {"max_bytes": witness.size} if self._retained else {}
+            data, relative, identity = workspace_document(path, with_identity=True, **limits)
+            if (identity != witness.identity or relative != witness.path
+                    or len(data) != witness.size or sha256(data).hexdigest() != witness.sha256):
+                raise ValueError("archive_delivery_snapshot_changed")
+            authority()
+            return data
+
+        disposition = "REFUSED"
+        try:
+            data = snapshot()
+            name = PurePosixPath(witness.path).name
+            cutoff = self._cutoff
+            # A separate durable reservation precedes each possible wire effect.
+            # Only a persisted positive first receipt allows entry to its sibling.
+            disposition = "UNKNOWN"
+            state, row, reserved = await asyncio.to_thread(
+                _begin_ordinary_document, cap, witness.path, data, route, name,
+                cutoff=cutoff, lock_deadline=min(cutoff, time.monotonic() + _JOURNAL_LOCK_WAIT),
+            )
+            receipt = await deliver_document(
+                runner, context, route=route, data=data, file_name=name, caption=None,
+                timeout=min(30, cutoff - time.monotonic()), authority_check=snapshot,
+                exact_archive_ack=True,
+            )
+            if (receipt["state"] != "DELIVERED" or any(
+                    previous is not None and previous["message_id"] == receipt["message_id"]
+                    for previous in self._receipts)):
+                return
+            # Persist the actual SDK ACK under the original cutoff even if
+            # STOP revoked authority for subsequent sends during this attempt.
+            candidate = copy.deepcopy(reserved)
+            candidate["files"][row].update(state="DELIVERED", receipt=receipt)
+            await asyncio.to_thread(
+                _ordinary_commit, state, candidate, reserved,
+                journals=(("candidate", encoded({"selection": row, "receipt": receipt})),),
+                cutoff=cutoff, lock_deadline=min(cutoff, time.monotonic() + _JOURNAL_LOCK_WAIT),
+            )
+            with self._lock:
+                self._receipts[index] = receipt
+                if len(self._outputs) == 1:
+                    self.receipt = receipt
+            disposition = "DELIVERED"
+        except _DocumentHistoryTimeout:
+            disposition = "REFUSED"
+        except Exception:
+            # Native transport/state diagnostics may contain private material.
+            return
+        finally:
+            with self._lock:
+                self._output_states[index] = disposition
+
+    async def run(self):
+        interaction = self.interaction
+        operation = self._operation
+        if asyncio.current_task() is not operation.task or operation._protected_input is not interaction:
+            return
+        with self._lock:
+            if self.state != "READY":
+                return
+            self.state = "SENDING"
+
+        try:
+            cap, runner, context, route, check_origin = _ordinary_authority(
+                self._adapter, self._source,
+            )
+            self._check_live(cap)
+            raw, binding = self._ingress, self._binding
+            expected_route = freeze_route({
+                "transport_profile": binding.principal[1],
+                "runtime_profile": binding.profile,
+                "bot_id": binding.principal[2],
+                "source": {
+                    "platform": "telegram", "chat_type": "dm", "chat_id": str(raw.chat.id),
+                    "user_id": str(raw.from_user.id), "thread_id": None, "message_id": str(raw.message_id),
+                },
+            })
+            if (runner is not operation.runner or cap is not operation.cap or route != expected_route
+                    or self._source._friday_document_session_id != operation.session_id):
+                return
+            if self._retained:
+                from telegram import Message
+
+                if (type(raw) is not Message or self._selection.event.raw_message is not raw
+                        or raw.get_bot() is not self._adapter._bot or raw.chat.type != "private"
+                        or raw.from_user.is_bot or raw.from_user.id != raw.chat.id
+                        or binding.chat_id != str(raw.chat.id)
+                        or binding.session_id != operation.session_id
+                        or self._run != (operation.key, self._generation)):
+                    return
+            elif self._outputs[0].witness.path != self._approval.destination:
+                return
+
+            for index in range(len(self._outputs)):
+                self._check_live(cap)
+                await self._send(index, cap, runner, context, route, check_origin)
+                if self._output_states[index] != "DELIVERED":
+                    break
+        except Exception:
+            return
+        finally:
+            with self._lock:
+                if "UNKNOWN" in self._output_states:
+                    self.state = "UNKNOWN"
+                elif all(state == "DELIVERED" for state in self._output_states):
+                    self.state = "DELIVERED"
+                else:
+                    self.state = "REFUSED"
diff --git a/gateway/ordinary_archive_holder.py b/gateway/ordinary_archive_holder.py
