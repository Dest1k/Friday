+    'manager company operator category keywords comment doccomm hlinkbase '
+    'creatim revtim printim buptim generator listtable listoverridetable '
+    'revtbl rsidtbl xmlnstbl latentstyles colorschememapping themeData '
+    'datastore header headerl headerr headerf footer footerl footerr footerf '
