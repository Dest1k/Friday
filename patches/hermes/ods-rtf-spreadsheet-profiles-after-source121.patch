+MAX_DEPTH = 128
+MAX_PARAGRAPHS = 8_192
+MAX_TOKENS = 250_000
+MAX_UC = 16
+
+CODEPAGES = {437: 'cp437', 850: 'cp850', 874: 'cp874', 932: 'cp932',
+             936: 'gbk', 949: 'cp949', 950: 'cp950', 10000: 'mac_roman',
+             **{n: 'cp' + str(n) for n in range(1250, 1259)}}
