+        book = Package(data)
+        types = book.root('[Content_Types].xml', q(CT, 'Types'))
+        overrides = {}; defaults = {}
+        for node in types:
+            if len(node): fail('invalid_content_types')
+            content_type = node.get('ContentType', '')
+            if not content_type or '/' not in content_type or any(char.isspace() or ord(char) < 32 for char in content_type):
+                fail('invalid_content_types')
+            if node.tag == q(CT, 'Override'):
+                key = node.get('PartName', '')
+                if key in overrides or not key.startswith('/') or key[1:] not in book.parts: fail('invalid_content_types')
+                overrides[key] = node.get('ContentType')
+            elif node.tag == q(CT, 'Default'):
+                key = node.get('Extension', '').lower()
+                if not key or key in defaults: fail('invalid_content_types')
+                defaults[key] = node.get('ContentType')
+            else: fail('invalid_content_types')
+        if overrides.get('/xl/workbook.xml') != OOXML[format]: fail('native_spreadsheet_identity')
+        office = book.targets('', 'officeDocument')
+        if len(office) != 1 or office[0][1] != 'xl/workbook.xml':
+            fail('workbook_relationship')
+        root = book.root('xl/workbook.xml', q(S, 'workbook'))
+        groups = root.findall(q(S, 'sheets'))
+        if len(groups) != 1 or not 1 <= len(groups[0]) <= 32: fail('sheet_count_limit')
+        names = set(); ids = set(); targets = set(); sheet_parts = {}
+        for node in groups[0]:
+            name, rid = node.get('name'), node.get(q(R, 'id'))
+            if node.tag != q(S, 'sheet') or not name or name in names or not rid or rid in ids: fail('ambiguous_sheet_name')
+            names.add(name); ids.add(rid)
+            part = book.target('xl/workbook.xml', rid, 'worksheet')
+            if part in targets or overrides.get('/'+part) != 'application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml': fail('worksheet_identity')
+            targets.add(part); sheet = book.root(part, q(S, 'worksheet'))
+            sheet_parts[rid] = part
+            if writing and sheet.find(q(S,'sheetProtection')) is not None:
+                fail('protected_sheet')
+        if writing and root.find(q(S,'workbookProtection')) is not None:
+            fail('protected_workbook')
+        shared = book.targets('xl/workbook.xml', 'sharedStrings')
+        if len(shared) > 1:
+            fail('shared_strings_relationship')
+        shared_part = shared[0][1] if shared else None
+        string_count = 0
+        if shared_part is not None:
+            if overrides.get('/'+shared_part, defaults.get(shared_part.rpartition('.')[2].lower())) != 'application/vnd.openxmlformats-officedocument.spreadsheetml.sharedStrings+xml':
+                fail('shared_strings_identity')
+            string_count = len(book.root(shared_part, q(S, 'sst')).findall(q(S, 'si')))
+        for part in targets:
+            for cell in book.xml[part].iter(q(S, 'c')):
+                if cell.get('t') == 's':
+                    raw = cell.findtext(q(S, 'v'), '')
+                    if not raw.isascii() or not raw.isdecimal() or len(raw) > 8 or int(raw) >= string_count:
+                        fail('shared_string_index')
+        macro_parts = []
+        for name in book.parts:
+            typ = overrides.get('/'+name, defaults.get(name.rpartition('.')[2].lower(), '')) or ''
+            if name != '[Content_Types].xml' and not typ:
+                fail('missing_part_content_type')
+            if name.endswith('.rels') and typ != RELS_TYPE:
+                fail('relationship_content_type')
+            if 'vba' in typ.lower() or 'vba' in name.lower():
+                if typ != VBA_TYPE or not name.lower().endswith('vbaproject.bin'): fail('unsupported_macro_part')
+                macro_parts.append(name)
+            if name.lower().startswith('_xmlsignatures/'):
+                book.unsupported.add('signatures_not_validated')
+            if (any(key in name.lower() for key in ('/connections', '/externallinks/', '/querytables/', '/activex/', '/embeddings/'))
+                    or any(key in typ.lower() for key in ('activex', 'oleobject', 'externallink', 'connections', 'querytable'))):
+                book.unsupported.add('active_or_external_workbook_parts_not_executed')
+        links = [(owner,target) for owner, rows in book.relationships.items() for _, (typ,target) in rows.items() if typ.endswith('/vbaProject')]
+        if macro_parts or links:
+            if format not in ('xlsm', 'xltm') or len(macro_parts) != 1 or links != [('xl/workbook.xml', macro_parts[0])]: fail('macro_profile_mismatch')
+        for name, tree in book.xml.items():
+            tick(checkpoint)
+            for node in tree.iter():
+                if node.tag in FORMULA_FIELDS and active_formula(node.text):
+                    book.unsupported.add('active_or_external_formula_not_evaluated')
+        if writing and (format not in WRITABLE or macro_parts or links or book.external or book.unsupported):
+            fail('macro_external_or_active_mutation_unsupported')
+        if format in ('xlsm', 'xltm'):
+            book.unsupported.add('macro_profile_read_only; VBA_opaque_never_executed')
+        book.macro_parts = macro_parts
+        book.sheet_parts = sheet_parts
+        book.shared_strings_part = shared_part
+        return book
+    except (PresentationError, zipfile.BadZipFile, ET.ParseError, UnicodeError, EOFError, NotImplementedError, zlib.error) as error:
+        raise ODSError('invalid_spreadsheet_package') from error
+
+
+def extract_spreadsheet(data, format, *, checkpoint=None):
+    if format in ODF:
+        from tools.scoped_ods import extract_spreadsheet as extract
+        return extract(data, format, checkpoint=checkpoint)
+    book = ooxml(data, format, checkpoint=checkpoint)
+    from tools.read_extract import _extract_xlsx
+    text = _extract_xlsx(BytesIO(data), max_xml_bytes=1000000, max_total_xml_bytes=1000000,
+                         include_inventory=True, sheet_parts=book.sheet_parts,
+                         shared_strings_part=book.shared_strings_part)
+    metadata = dict(getattr(text, 'extraction_metadata', {}))
+    metadata.update(native_container=True, format=format, formulas_evaluated=False,
+                    macros_executed=False, macro_projects=len(book.macro_parts),
+                    unsupported=sorted(book.unsupported))
+    metadata.setdefault('coverage', 'visible_sheet_values_and_formula_cache_preview; layout_not_covered')
+    return SpreadsheetText(str(text), metadata)
+
+
+def _odf_convert(data, source, target, checkpoint=None):
+    from tools.scoped_presentation_variants import _namespaces, _merge_namespaces, _serialize
+    book = Spreadsheet(data, source, checkpoint)
+    if book.unsupported: fail('active_or_linked_conversion_unsupported')
+    if source == target: return data
+    if source != 'fods' and target != 'fods':
+        raw = book.parts['META-INF/manifest.xml']
+        # Only the exact root media-type declaration is changed; no other XML rewritten.
+        root = book.xml['META-INF/manifest.xml']
+        old, new = MIMES[source].encode(), MIMES[target].encode()
+        if raw.count(old) != 1: fail('manifest_profile_ambiguous')
+        result = _rewrite(data, {'mimetype': new, 'META-INF/manifest.xml': raw.replace(old,new)}, checkpoint)
+        Spreadsheet(result, target, checkpoint); return result
+    if source == 'fods':
+        flat = book.xml['content.xml']; namespaces = _namespaces(data)
+        allowed = {q(O, k) for k in SECTIONS}; seen = set()
+        for child in flat:
+            if child.tag not in allowed or child.tag in seen: fail('flat_sections_unsupported')
+            seen.add(child.tag)
+        if set(flat.attrib) - {q(O, 'version'), q(O, 'mimetype')}: fail('flat_attributes_unsupported')
+        attrs = {q(O, 'version'): flat.get(q(O, 'version'), '1.3')}
+        groups = {'content.xml': ('document-content', ('font-face-decls','automatic-styles','body')),
+                  'styles.xml': ('document-styles', ('font-face-decls','styles','automatic-styles','master-styles')),
+                  'meta.xml': ('document-meta', ('meta',)), 'settings.xml': ('document-settings', ('settings',))}
+        parts = {'mimetype': MIMES[target].encode()}
+        for name, (tag, children) in groups.items():
+            root = ET.Element(q(O, tag), attrs)
+            for section in children:
+                node = flat.find(q(O, section))
+                if node is not None:
+                    node = deepcopy(node)
+                    if section == 'automatic-styles':
+                        # Page layouts belong in document-styles. Other
+                        # automatic styles can be referenced by either sheet
+                        # content or master-page headers/footers, so keep their
+                        # definitions in both parts. The reverse merge below
+                        # deduplicates identical definitions by family/name.
+                        page = {q(ST,'page-layout'), q(ST,'presentation-page-layout')}
+                        if name == 'content.xml':
+                            node[:] = [child for child in node if child.tag not in page]
+                    if section != 'automatic-styles' or name != 'styles.xml' or len(node): root.append(node)
+            if len(root): parts[name] = _serialize(root, namespaces)
+        root = ET.Element(q(M,'manifest'),{q(M,'version'):'1.3'})
+        ET.SubElement(root,q(M,'file-entry'),{q(M,'full-path'):'/',q(M,'media-type'):MIMES[target]})
+        for name in parts:
+            if name != 'mimetype': ET.SubElement(root,q(M,'file-entry'),{q(M,'full-path'):name,q(M,'media-type'):'text/xml'})
+        parts['META-INF/manifest.xml'] = _serialize(root, {'manifest':M})
+        result = _zip(parts)
+    else:
+        if set(book.parts) - STANDARD: fail('flat_conversion_package_resources_unsupported')
+        root = ET.Element(q(O,'document'),{q(O,'version'):book.xml['content.xml'].get(q(O,'version'),'1.3'),q(O,'mimetype'):MIME})
+        sections = {}; namespaces = {}
+        for name in ('content.xml','styles.xml','meta.xml','settings.xml'):
+            if name not in book.xml: continue
+            namespaces = _merge_namespaces(namespaces, _namespaces(book.parts[name]))
+            tree = book.xml[name]
+            if tree.tag != q(O, {'content.xml':'document-content','styles.xml':'document-styles','meta.xml':'document-meta','settings.xml':'document-settings'}[name]): fail('odf_part_identity')
+            if set(tree.attrib) - {q(O,'version')}: fail('odf_part_attributes_unsupported')
+            for child in tree:
+                if child.tag not in {q(O,k) for k in SECTIONS}: fail('odf_sections_unsupported')
+                if child.tag in sections:
+                    previous = sections[child.tag]
+                    if child.tag not in {q(O,'automatic-styles'),q(O,'font-face-decls')}:
+                        fail('flat_global_styles_conflict')
+                    if child.attrib != previous.attrib or (child.text or '').strip() != (previous.text or '').strip():
+                        fail('flat_global_styles_conflict')
+                    def key(node):
+                        name = node.get(q(ST,'name'))
+                        if not name: fail('flat_unnamed_style_unsupported')
+                        return node.tag,node.get(q(ST,'family')),name
+                    known = {key(item):item for item in previous}
+                    if len(known) != len(previous): fail('flat_global_styles_conflict')
+                    for item in child:
+                        identity = key(item)
+                        if identity in known:
+                            left,right = deepcopy(known[identity]),deepcopy(item)
+                            left.tail = right.tail = None
+                            if ET.tostring(left) != ET.tostring(right): fail('flat_global_styles_conflict')
+                        else:
+                            previous.append(deepcopy(item));known[identity] = item
+                else: sections[child.tag] = deepcopy(child)
+        for section in SECTIONS:
+            if q(O,section) in sections: root.append(deepcopy(sections[q(O,section)]))
+        result = _serialize(root,namespaces)
+    Spreadsheet(result,target,checkpoint)
+    return result
+
+
+def convert(data, source, target, *, checkpoint=None):
+    if source not in WRITABLE or target not in WRITABLE: fail('macro_profile_read_only')
+    if source in ODF and target in ODF: return _odf_convert(data,source,target,checkpoint)
+    if source not in OOXML or target not in OOXML: fail('cross_family_conversion_requires_office; unsupported_native_operation')
+    book = ooxml(data,source,writing=True,checkpoint=checkpoint)
+    if source == target: return data
+    raw = book.parts['[Content_Types].xml']; old,new = OOXML[source].encode(),OOXML[target].encode()
+    if raw.count(old) != 1: fail('content_type_ambiguous')
+    result = _rewrite(data,{'[Content_Types].xml':raw.replace(old,new)},checkpoint)
+    ooxml(result,target,writing=True,checkpoint=checkpoint); return result
+
+
+def create(spec, format, *, checkpoint=None):
+    if format not in WRITABLE: fail('macro_profile_read_only')
+    if format in ODF:
+        from tools.scoped_ods import create_spreadsheet
+        return convert(create_spreadsheet(spec,checkpoint=checkpoint),'ods',format,checkpoint=checkpoint)
+    from hermes_cli import friday_workspace_xlsx_table as table
+    try:
+        sheets, tables, names = table.normalize_document(*table.create_document(spec))
+        data = table.render_document(sheets,checkpoint=lambda:tick(checkpoint),tables=tables,names=names)
+    except table.TableRefused as error: raise ODSError(str(error)) from None
+    return convert(data,'xlsx',format,checkpoint=checkpoint)
+
+
+def edit(data, source, spec, *, checkpoint=None):
+    if source not in WRITABLE: fail('macro_profile_read_only')
+    if source in ODF:
+        from tools.scoped_ods import edit_spreadsheet
+        return edit_spreadsheet(data,spec,format=source,checkpoint=checkpoint)
+    if not isinstance(spec,dict) or set(spec) != {'sheet','cell','expected','value'}: fail('spreadsheet_edit_schema')
+    from hermes_cli.friday_workspace_xlsx import render_copy
+    from hermes_cli.friday_user_scope import ScopeDenied
+    normalized = convert(data,source,'xlsx',checkpoint=checkpoint)
+    tick(checkpoint)
+    try: result = render_copy(normalized,**spec)
+    except ScopeDenied: fail('numeric_cell_edit_unsupported_or_expected_mismatch')
+    return convert(result,'xlsx',source,checkpoint=checkpoint)
