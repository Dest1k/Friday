+"""Native spreadsheet profiles through existing bounded workspace CAS publication."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+def execute(cap, fd, leaf, path, content, *, operation):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_presentation_write import json_object, PresentationRefused
+    from tools.scoped_presentation_variants import PresentationRefused as VariantRefused
+    from tools.scoped_odt import ODTError
+    from tools.scoped_spreadsheet_profiles import create, edit, convert, FORMATS, WRITABLE, ODSError
+    check(cap); _check_parent(cap, fd, path)
+    target = Path(path).suffix.lower().lstrip('.')
+    if target not in FORMATS: raise ScopeDenied()
+    try:
+        try: os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError: pass
+        else: raise ODSError('document_already_exists')
+        if target not in WRITABLE: raise ODSError('macro_profile_read_only')
+        state = None
+        if operation == 'spreadsheet_create':
+            # Rich XLSX creation validates its own exact optional keys.
+            spec = json_object(content, ('sheets',))
+            rendered = create(spec,target,checkpoint=lambda:check(cap))
+            extra = dict(native_editable=True, formulas_recalculated=False)
+        else:
+            keys = ('source',) if operation == 'spreadsheet_convert' else ('source','sheet','cell','expected','value')
+            spec = json_object(content,keys)
+            source_name = spec.pop('source')
+            if not isinstance(source_name,str): raise ScopeDenied()
+            source_format = Path(source_name).suffix.lower().lstrip('.')
+            if source_format not in FORMATS: raise ODSError('unsupported_spreadsheet_profile')
+            source,relative,data,identity = _read_source(source_name,cap,'.'+source_format)
+            if operation == 'spreadsheet_edit':
+                if source_format != target: raise ODSError('edit_requires_same_native_profile')
+                rendered = edit(data,source_format,spec,checkpoint=lambda:check(cap))
+            elif operation == 'spreadsheet_convert':
+                rendered = convert(data,source_format,target,checkpoint=lambda:check(cap))
+            else: raise ODSError('unsupported_spreadsheet_operation')
+            state = source,data,identity
+            extra = dict(source=relative,source_sha256=hashlib.sha256(data).hexdigest(),source_unchanged=True,
+                         formulas_recalculated=False, macros_executed=False,
+                         preservation='native_profile_conversion' if operation == 'spreadsheet_convert' else 'other_XML_bytes_and_package_payloads_preserved')
+        check(cap)
+        return _publish(cap,fd,leaf,path,rendered,target,state,extra)
+    except ScopeDenied: raise
+    except (ODSError, ODTError, PresentationRefused, VariantRefused) as error:
+        return json.dumps(dict(success=False,error='spreadsheet_operation_refused',reason=str(error),effect_disposition='none'))
