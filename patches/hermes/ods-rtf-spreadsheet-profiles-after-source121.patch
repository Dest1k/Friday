+"""Bounded native ODS values and create-only cell revisions.
+
+No Office, foreign formula execution, external reference resolution, or extraction.
+Creation calculates only the declared bounded SUM/product subset. Reading keeps
+formula strings and cached values separate. Unknown structures are disclosed.
+"""
+from datetime import date, timedelta
+from decimal import Decimal, InvalidOperation, localcontext
+from io import BytesIO
+import json
+import re
+import zipfile
+import zlib
+from xml.etree import ElementTree as ET
+from xml.parsers import expat
+from xml.sax.saxutils import escape, quoteattr
+
+from tools.scoped_presentation import Package, PresentationError, q, xml_root
+from tools.scoped_odt import _text, _count
+
+O = 'urn:oasis:names:tc:opendocument:xmlns:office:1.0'
+T = 'urn:oasis:names:tc:opendocument:xmlns:text:1.0'
+TB = 'urn:oasis:names:tc:opendocument:xmlns:table:1.0'
+M = 'urn:oasis:names:tc:opendocument:xmlns:manifest:1.0'
+ST = 'urn:oasis:names:tc:opendocument:xmlns:style:1.0'
+NUM = 'urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0'
+XL = 'http://www.w3.org/1999/xlink'
+OF = 'urn:oasis:names:tc:opendocument:xmlns:of:1.2'
+MIME = 'application/vnd.oasis.opendocument.spreadsheet'
+MIMES = {'ods': MIME, 'ots': MIME + '-template'}
+MAX_CELLS = 4096
+MAX_TEXT = 100000
+MAX_ROWS = 1048576
+MAX_COLS = 16384
+
+
+class ODSError(ValueError):
+    pass
+
+
+def fail(code):
+    raise ODSError(code)
+
+
+def tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+def active_formula(value):
+    # Formula-bearing names, validations and table columns are just as inert
+    # here as ordinary cells. Do not silently carry their external behavior
+    # through a write merely because they use a different XML field.
+    value = value or ''
+    return (('|' in value and '!' in value)
+            or bool(re.search(r'(?i)(?:\b(?:WEBSERVICE|DDE|HYPERLINK|RTD)\s*\(|(?:https?|file|ftp):)', value)))
+
+
+def decimal(raw):
+    if not isinstance(raw, str) or not re.fullmatch(r'-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?', raw) or len(raw) > 128:
+        fail('invalid_numeric_value')
+    try:
+        value = Decimal(raw)
+    except InvalidOperation:
+        fail('invalid_numeric_value')
+    if not value.is_finite() or value.adjusted() not in range(-300, 301):
+        fail('numeric_value_limit')
+    return value
+
+
+def colname(number):
+    text = ''
+    while number:
+        number, part = divmod(number - 1, 26)
+        text = chr(65 + part) + text
+    return text
+
+
+def address(raw):
+    if not isinstance(raw, str):
+        fail('invalid_cell_address')
+    match = re.fullmatch(r'([A-Z]{1,3})([1-9][0-9]{0,6})', raw)
+    if not match:
+        fail('invalid_cell_address')
+    column = 0
+    for char in match[1]:
+        column = column * 26 + ord(char) - 64
+    row = int(match[2])
+    if column > MAX_COLS or row > MAX_ROWS:
+        fail('invalid_cell_address')
+    return row, column
+
+
+class Spreadsheet(Package):
+    def __init__(self, data, format='ods', checkpoint=None):
+        if format not in (*MIMES, 'fods'):
+            fail('unsupported_spreadsheet_format')
+        tick(checkpoint)
+        if format == 'fods':
+            if not isinstance(data, bytes) or not 1 <= len(data) <= 1000000:
+                fail('input_limit')
+            try:
+                root = xml_root(data)
+                stack = [(root, 1)]; count = 0
+                while stack:
+                    node, depth = stack.pop(); count += 1
+                    if depth > 64 or count > 50000 or len(node.attrib) > 64:
+                        fail('xml_structure_limit')
+                    stack.extend((child, depth+1) for child in node)
+            except (PresentationError, ET.ParseError, UnicodeError) as error:
+                raise ODSError('invalid_flat_spreadsheet') from error
+            if (root.tag != q(O, 'document') or root.get(q(O, 'mimetype')) != MIME
+                    or root.get(q(O, 'version')) not in ('1.0','1.1','1.2','1.3')):
+                fail('native_flat_spreadsheet_identity')
+            self.parts = {'content.xml': data}; self.xml = {'content.xml': root}
+            self.member_info = {}; self.unsupported = set(); self.checkpoint = checkpoint
+        else:
+            try:
+                super().__init__(data)
+                with zipfile.ZipFile(BytesIO(data)) as z:
+                    if any(i.is_dir() and i.file_size for i in z.infolist()):
+                        fail('nonempty_directory_member')
+            except (PresentationError, zipfile.BadZipFile, ET.ParseError, UnicodeError,
+                    EOFError, NotImplementedError, zlib.error) as error:
+                raise ODSError('invalid_spreadsheet_package') from error
+            self.checkpoint = checkpoint
+            if self.parts.get('mimetype') != MIMES[format].encode() or self.member_info.get('mimetype') != (zipfile.ZIP_STORED, 0):
+                fail('native_spreadsheet_identity')
+            manifest = self.xml.get('META-INF/manifest.xml')
+            if manifest is None or manifest.tag != q(M, 'manifest'):
+                fail('spreadsheet_manifest_missing')
+            paths = set(); media_types = {}
+            for entry in manifest:
+                if entry.tag != q(M, 'file-entry'):
+                    fail('invalid_manifest_entry')
+                path = entry.get(q(M, 'full-path'), '')
+                if not path or path.casefold() in paths:
+                    fail('duplicate_manifest_entry')
+                paths.add(path.casefold())
+                media_types[path] = entry.get(q(M, 'media-type'))
+                if path == '/':
+                    if entry.get(q(M, 'media-type')) != MIMES[format]:
+                        fail('spreadsheet_manifest_type')
+                else:
+                    if path.startswith('/') or any(c in path for c in '\\:%?#') or any(ord(c) < 32 for c in path) or any(x in ('', '.', '..') for x in path.rstrip('/').split('/')):
+                        fail('unsafe_manifest_entry')
+                    if not path.endswith('/') and path not in self.parts:
+                        fail('manifest_target_missing')
+                if len(entry):
+                    fail('encrypted_or_unknown_manifest')
+            if not {'/', 'content.xml'} <= paths:
+                fail('spreadsheet_manifest_incomplete')
+            for part in ('content.xml', 'styles.xml', 'meta.xml', 'settings.xml'):
+                if part in self.parts and media_types.get(part) != 'text/xml':
+                    fail('spreadsheet_manifest_part_type')
+            root = self.xml.get('content.xml')
+            if root is None or root.tag != q(O, 'document-content'):
+                fail('spreadsheet_content_missing')
+        bodies = root.findall(q(O, 'body'))
+        if len(bodies) != 1 or len(bodies[0]) != 1 or bodies[0][0].tag != q(O, 'spreadsheet'):
+            fail('spreadsheet_body')
+        self.body = bodies[0][0]
+        self.sheets = self.body.findall(q(TB, 'table'))
+        if not 1 <= len(self.sheets) <= 32:
+            fail('sheet_count_limit')
+        names = [sheet.get(q(TB, 'name')) for sheet in self.sheets]
+        if any(not n or len(n) > 128 for n in names) or len(set(names)) != len(names):
+            fail('ambiguous_sheet_name')
+        self.unsupported = set(getattr(self, 'unsupported', ()))
+        for name in self.parts:
+            if name.lower().startswith(('basic/', 'scripts/', 'meta-inf/documentsignatures', 'meta-inf/macrosignatures')):
+                self.unsupported.add('scripts_or_signatures')
+        for name, tree in self.xml.items():
+            tick(checkpoint)
+            if name.lower().startswith(('basic/', 'scripts/', 'meta-inf/documentsignatures', 'meta-inf/macrosignatures')):
+                self.unsupported.add('scripts_or_signatures')
+            for node in tree.iter():
+                uri = node.tag[1:].split('}', 1)[0] if node.tag.startswith('{') else ''
+                if ('script' in uri or uri.endswith(':form:1.0') or node.tag.startswith((q(T, 'dde-'), q(TB, 'database-'))) or node.tag in
+                    {q(TB, n) for n in ('table-source', 'cell-range-source', 'dde-links', 'dde-link', 'data-pilot-tables', 'tracked-changes')}
+                    or node.tag == q(O, 'dde-source')
+                    or (node.tag == q(O, 'scripts') and (len(node) or (node.text or '').strip()))):
+                    self.unsupported.add('active_or_linked_content')
+                if node.get(q(XL, 'href')) or node.get('{http://www.w3.org/XML/1998/namespace}base'):
+                    self.unsupported.add('linked_or_embedded_content')
+                if any(active_formula(node.get(q(TB, field))) for field in ('formula', 'expression')):
+                    self.unsupported.add('active_or_external_formula_not_evaluated')
+
+    def rows(self, sheet):
+        def walk(parent):
+            for child in parent:
+                if child.tag == q(TB, 'table-row'):
+                    yield child
+                elif child.tag in {q(TB, n) for n in ('table-header-rows', 'table-row-group', 'table-rows')}:
+                    yield from walk(child)
+                elif child.tag not in {q(TB, n) for n in ('table-column', 'table-columns', 'table-column-group', 'table-header-columns', 'shapes', 'named-expressions')}:
+                    self.unsupported.add('unread_sheet_structure')
+        return walk(sheet)
+
+    def cells(self, sheet):
+        row_number = 1
+        for row in self.rows(sheet):
+            tick(self.checkpoint)
+            repeats = _count(row.get(q(TB, 'number-rows-repeated'), '1'), MAX_ROWS)
+            column = 1
+            if row_number + repeats - 1 > MAX_ROWS:
+                fail('row_limit')
+            for node in row:
+                if node.tag not in (q(TB, 'table-cell'), q(TB, 'covered-table-cell')):
+                    self.unsupported.add('unread_row_structure')
+                    continue
+                width = _count(node.get(q(TB, 'number-columns-repeated'), '1'), MAX_COLS)
+                if column + width - 1 > MAX_COLS:
+                    fail('column_limit')
+                yield row_number, column, repeats, width, node, row
+                column += width
+            row_number += repeats
+
+    def value(self, cell):
+        kind = cell.get(q(O, 'value-type'))
+        paragraphs = cell.findall(q(T, 'p'))
+        pieces = []; size = 0
+        for paragraph in paragraphs:
+            piece = _text(paragraph, self)
+            size += len(piece.encode('utf-8')) + bool(pieces)
+            if size > MAX_TEXT:
+                fail('cell_text_limit')
+            pieces.append(piece)
+        display = '\n'.join(pieces)
+        value = None
+        if kind in ('float', 'percentage', 'currency'):
+            raw = cell.get(q(O, 'value'))
+            decimal(raw)
+            value = raw
+        elif kind == 'string':
+            value = cell.get(q(O, 'string-value'), display)
+        elif kind == 'boolean':
+            raw = cell.get(q(O, 'boolean-value'))
+            if raw not in ('true', 'false'):
+                fail('invalid_boolean_value')
+            value = raw == 'true'
+        elif kind in ('date', 'time'):
+            value = cell.get(q(O, kind + '-value'))
+            if not value or len(value) > 128:
+                fail('invalid_temporal_value')
+        elif kind in (None, 'void'):
+            if display:
+                self.unsupported.add('untyped_cell_display')
+                value = display
+        else:
+            self.unsupported.add('unsupported_value_type')
+        result = {'type': kind or 'blank', 'value': value}
+        formula = cell.get(q(TB, 'formula'))
+        if formula is not None:
+            if len(formula) > 4096:
+                fail('formula_text_limit')
+            result.update(formula=formula, cache_status='cached_not_recalculated')
+        if display:
+            result['display'] = display
+        if kind == 'currency':
+            result['currency'] = cell.get(q(O, 'currency'))
+        if cell.tag == q(TB, 'covered-table-cell'):
+            result['covered'] = True
+        return result
+
+
+class SpreadsheetText(str):
+    def __new__(cls, value, metadata):
+        result = super().__new__(cls, value)
+        result.extraction_metadata = metadata
+        return result
+
+
+def extract_spreadsheet(data, format='ods', *, checkpoint=None):
+    book = Spreadsheet(data, format, checkpoint)
+    rows = []
+    count = total = 0
+    for sheet in book.sheets:
+        name = sheet.get(q(TB, 'name'))
+        rows.append('[SHEET ' + json.dumps(name, ensure_ascii=False) + ']')
+        for row, column, height, width, node, _ in book.cells(sheet):
+            value = book.value(node)
+            if value['value'] is None and 'formula' not in value and not value.get('covered'):
+                continue
+            count += height * width
+            if count > MAX_CELLS:
+                fail('nonempty_cell_limit')
+            for r in range(row, row + height):
+                for c in range(column, column + width):
+                    item = '[' + colname(c) + str(r) + ' ' + json.dumps(value, ensure_ascii=False, sort_keys=True) + ']'
+                    total += len(item.encode('utf-8'))
+                    if total > 900000:
+                        fail('spreadsheet_output_limit')
+                    rows.append(item)
+    metadata = dict(native_container=True, format=format, sheets=len(book.sheets), cells=count,
+                    coverage='native_cells_values_formulas_and_cached_results; drawings_layout_not_covered',
+                    formulas_evaluated=False, unsupported=sorted(book.unsupported))
+    return SpreadsheetText('\n'.join(rows), metadata)
+
+
+def _zip(parts):
+    out = BytesIO()
+    with zipfile.ZipFile(out, 'w') as z:
+        for name, data in parts.items():
+            z.writestr(name, data, compress_type=zipfile.ZIP_STORED if name == 'mimetype' else zipfile.ZIP_DEFLATED)
+    result = out.getvalue()
+    if len(result) > 1000000:
+        fail('output_limit')
+    return result
+
+
+def _literal(value):
+    """A paragraph's inner XML with explicit ODF whitespace; no namespace state."""
+    if not isinstance(value, str) or len(value.encode('utf-8')) > MAX_TEXT:
+        fail('invalid_text')
+    if any(not (ord(c) in (9, 10, 13) or 32 <= ord(c) <= 0xD7FF or 0xE000 <= ord(c) <= 0xFFFD or 0x10000 <= ord(c) <= 0x10FFFF) for c in value):
+        fail('invalid_text')
+    return ''.join('<text:s/>' if c == ' ' else '<text:tab/>' if c == '\t' else '<text:line-break/>' if c == '\n' else '&#13;' if c == '\r' else escape(c) for c in value)
+
+
+def create_spreadsheet(spec, *, checkpoint=None):
+    # Reuse the product's bounded, explicit scalar/formula validation.
+    from hermes_cli import friday_workspace_xlsx_table as table
+    if not isinstance(spec, dict) or set(spec) != {'sheets'} or not isinstance(spec['sheets'], list):
+        fail('ods_create_schema')
+    if any(not isinstance(s, dict) or set(s) != {'name', 'rows'} for s in spec['sheets']):
+        fail('ods_create_schema')
+    try:
+        sheets, _, _ = table.normalize_document(*table.create_document(spec))
+    except table.TableRefused:
+        fail('ods_create_values')
+    dimensions = {s[0]: (len(s[1]), len(s[1][0])) for s in sheets}
+    scalars = {}; plans = {}; waiting = {}; dependents = {}
+    for name, rows in sheets:
+        for r, row in enumerate(rows, 1):
+            for c, (kind, value, fmt) in enumerate(row, 1):
+                key = (name, r, c)
+                if kind == 'number': scalars[key] = decimal(value)
+                elif kind == 'formula':
+                    multiply = re.fullmatch('(' + table.REF + r')\*(' + table.REF + ')', value)
+                    total = re.fullmatch(r'SUM\((' + table.REF + '):(' + table.REF + r')\)', value, re.I)
+                    if multiply:
+                        deps = [table.reference(s, name, dimensions)[:3] for s in multiply.groups()]
+                        operation = 'multiply'
+                    elif total:
+                        first = table.reference(total[1], name, dimensions)
+                        last = table.reference(total[2], first[0], dimensions)
+                        deps = [(first[0], rr, cc) for rr in range(first[1], last[1] + 1) for cc in range(first[2], last[2] + 1)]
+                        operation = 'sum'
+                    else: fail('ods_formula_unsupported')
+                    plans[key] = operation, deps
+    for key, (_, deps) in plans.items():
+        missing = {dep for dep in deps if dep not in scalars}
+        if not missing <= plans.keys(): fail('ods_formula_nonnumeric_dependency')
+        waiting[key] = len(missing)
+        for dep in missing: dependents.setdefault(dep, set()).add(key)
+    ready = [key for key, count in waiting.items() if not count]
+    with localcontext() as precision:
+        precision.prec = 34
+        while ready:
+            tick(checkpoint); key = ready.pop(); operation, deps = plans[key]
+            result = scalars[deps[0]] * scalars[deps[1]] if operation == 'multiply' else sum((scalars[d] for d in deps), Decimal(0))
+            decimal(str(result)); scalars[key] = result
+            for dependent in dependents.get(key, ()):
+                waiting[dependent] -= 1
