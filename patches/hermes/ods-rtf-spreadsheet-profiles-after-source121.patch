+"""Exact-key ODS joins and revision merges into new plain native tables."""
+from xml.etree import ElementTree as ET
+
+from tools.scoped_ods import (
+    Spreadsheet, ODSError, create_spreadsheet, decimal, tick, q, O, T, TB, _zip, _count, MAX_ROWS,
+)
+
+
+def fail(reason):
+    raise ODSError(reason)
+
+
+def _cell_content(node):
+    # Flatten supported rich text only. Direct notes/lists/nested tables and
+    # unknown inline elements must not disappear from a successful result.
+    allowed = {q(T, name) for name in ('p', 'span', 'a', 's', 'tab', 'line-break')}
+    if (node.text or '').strip():
+        fail('table_unsupported_cell_content')
+    for child in node:
+        if child.tag != q(T, 'p') or (child.tail or '').strip():
+            fail('table_unsupported_cell_content')
+        for item in child.iter():
+            if item.tag not in allowed:
+                fail('table_unsupported_cell_content')
+            if item.tag in {q(T, name) for name in ('s', 'tab', 'line-break')} and (
+                    len(item) or (item.text or '').strip()):
+                fail('table_unsupported_cell_content')
+
+
+def table(data, name, checkpoint=None):
+    book = Spreadsheet(data, checkpoint=checkpoint)
+    selected = [s for s in book.sheets if s.get('{urn:oasis:names:tc:opendocument:xmlns:table:1.0}name') == name]
+    if len(selected) != 1:
+        fail('table_sheet_not_found')
+    if selected[0].get('{urn:oasis:names:tc:opendocument:xmlns:table:1.0}protected', 'false') != 'false':
+        fail('protected_table')
+    row_count = 0
+    for row_node in book.rows(selected[0]):
+        tick(checkpoint)
+        row_count += _count(row_node.get(q(TB, 'number-rows-repeated'), '1'), MAX_ROWS)
+        if row_count > 512:
+            fail('table_dimensions')
+    cells = {}; maximum_row = maximum_column = 0
+    for row, column, height, width, node, parent in book.cells(selected[0]):
+        tick(checkpoint)
+        if row + height - 1 > 512 or column + width - 1 > 64 or height * width > 4096:
+            fail('table_dimensions')
+        _cell_content(node)
+        value = book.value(node)
+        if value.get('covered') or 'formula' in value:
+            fail('table_formula_or_merged_cell')
+        if any(node.get('{urn:oasis:names:tc:opendocument:xmlns:table:1.0}' + field) for field in ('number-columns-spanned','number-rows-spanned')):
+            fail('table_merged_cell')
+        if value['type'] not in ('float','string','boolean','date','blank','void'):
+            fail('table_scalar_type')
+        for r in range(row, row + height):
+            for c in range(column, column + width):
+                cells[r, c] = value
+        if len(cells) > 4096:
+            fail('table_cell_limit')
+        maximum_row = max(maximum_row, row + height - 1)
+        maximum_column = max(maximum_column, column + width - 1)
+    if book.unsupported or not cells or maximum_row * maximum_column > 4096:
+        fail('table_unsupported_or_empty')
+    rows = [[cells.get((r,c),{'type':'blank','value':None}) for c in range(1,maximum_column+1)] for r in range(1,maximum_row+1)]
+    headers = rows.pop(0)
+    if (any(cell['type'] != 'string' or not cell['value'] for cell in headers)
+            or len({cell['value'] for cell in headers}) != len(headers)):
+        fail('unique_literal_headers_required')
+    return [c['value'] for c in headers], rows
+
+
+def _keys(header, rows, key):
+    if key not in header:
+        fail('literal_key_header_missing')
+    index = header.index(key); values = {}
+    for row in rows:
+        cell = row[index]
+        if cell['type'] != 'string' or not cell['value'] or cell['value'] in values:
+            fail('unique_nonempty_text_keys_required')
+        values[cell['value']] = row
+    return index, values
+
+
+def _scalar(cell):
+    kind, value = cell['type'], cell['value']
+    if kind in ('blank','void'):
+        return None
+    if kind == 'float':
+        return {'type':'decimal','value':value}
+    if kind == 'date':
+        return {'type':'date','value':value}
+    return value
+
+
+def _write(header, rows, name, checkpoint, revision_column=None):
+    scalars = [[_scalar(c) for c in row] for row in rows]
+    revisions = []
+    if revision_column is not None:
+        # Only the already-validated revision column has the wider safe-integer
+        # contract. Keep the existing creator's limits for every other scalar,
+        # text, dimension, sheet name and package. A private generated zero is
+        # replaced below with the exact native integer before publication.
+        for source, target in zip(rows, scalars):
+            revisions.append(str(_revision(source[revision_column])))
+            target[revision_column] = 0
+    result = create_spreadsheet({'sheets':[{'name':name,'rows':[header]+scalars}]}, checkpoint=checkpoint)
+    if not revisions:
+        return result
+    book = Spreadsheet(result, checkpoint=checkpoint)
+    generated_rows = list(book.rows(book.sheets[0]))
+    for row, value in zip(generated_rows[1:], revisions):
+        tick(checkpoint)
+        node = row[revision_column]
+        node.set(q(O, 'value'), value)
+        node.find(q(T, 'p')).text = value
+    book.parts['content.xml'] = ET.tostring(book.xml['content.xml'], encoding='utf-8', xml_declaration=True)
+    result = _zip(book.parts)
+    Spreadsheet(result, checkpoint=checkpoint)
+    return result
+
+
+def join(data, spec, *, checkpoint=None):
+    if (not isinstance(spec,dict) or set(spec) != {'left_sheet','right_sheet','key','sheet'}
+            or any(not isinstance(x,str) or not x for x in spec.values())
+            or spec['left_sheet'] == spec['right_sheet']):
+        fail('table_join_schema')
+    left_header,left = table(data,spec['left_sheet'],checkpoint)
+    right_header,right = table(data,spec['right_sheet'],checkpoint)
+    _,left_keys = _keys(left_header,left,spec['key'])
+    key_index,right_keys = _keys(right_header,right,spec['key'])
+    extra = [i for i in range(len(right_header)) if i != key_index]
+    if set(left_header) & {right_header[i] for i in extra}:
+        fail('table_join_overlapping_headers')
+    blank = {'type':'blank','value':None}
+    output = []
+    for key,row in left_keys.items():
+        tick(checkpoint)
+        found = right_keys.get(key)
+        output.append(row + [found[i] if found is not None else blank for i in extra])
+    return _write(left_header + [right_header[i] for i in extra],output,spec['sheet'],checkpoint)
+
+
+def _revision(cell):
+    if cell['type'] != 'float':
+        fail('numeric_integer_revision_required')
+    value = decimal(cell['value'])
+    if value < 0 or value > 9007199254740991 or value != value.to_integral_value():
+        fail('numeric_integer_revision_required')
+    return int(value)
+
+
+def _same(left,right):
+    if len(left) != len(right):return False
+    for x,y in zip(left,right):
+        if x['type'] != y['type']:return False
+        if x['type'] == 'float':
+            if decimal(x['value']) != decimal(y['value']):return False
+        elif x['value'] != y['value']:return False
+    return True
+
+
+def merge(base, update, spec, *, checkpoint=None):
+    if (not isinstance(spec,dict) or set(spec) != {'sheet','key','revision'}
+            or any(not isinstance(x,str) or not x for x in spec.values())
+            or spec['key'] == spec['revision']):
+        fail('table_merge_schema')
+    header,left = table(base,spec['sheet'],checkpoint)
+    other,right = table(update,spec['sheet'],checkpoint)
+    if header != other or spec['revision'] not in header:
+        fail('table_merge_header_mismatch')
+    _,left_keys = _keys(header,left,spec['key'])
+    _,right_keys = _keys(header,right,spec['key'])
+    revision = header.index(spec['revision'])
+    # Validate every row, including new keys and lower revisions.
+    left_revisions = {key:_revision(row[revision]) for key,row in left_keys.items()}
+    right_revisions = {key:_revision(row[revision]) for key,row in right_keys.items()}
+    result = dict(left_keys)
+    for key,row in right_keys.items():
+        tick(checkpoint)
+        if key not in result:
+            result[key] = row
+        elif right_revisions[key] > left_revisions[key]:
+            result[key] = row
+        elif right_revisions[key] == left_revisions[key] and not _same(result[key],row):
+            fail('same_revision_conflict')
+    return _write(header,list(result.values()),spec['sheet'],checkpoint,revision)
