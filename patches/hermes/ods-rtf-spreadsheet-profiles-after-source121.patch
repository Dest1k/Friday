+"""Native ODS creation/revision through existing own-workspace publication."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+def execute(cap, fd, leaf, path, content, *, edit=False, operation=None):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_presentation_write import json_object, PresentationRefused
+    from tools.scoped_odt import ODTError
+    from tools.scoped_ods import create_spreadsheet, edit_spreadsheet, ODSError
+    from tools.scoped_ods_table import join, merge
+    operation = operation or ('ods_edit' if edit else 'ods_create')
+    check(cap)
+    _check_parent(cap, fd, path)
+    if Path(path).suffix.lower() != '.ods':
+        raise ScopeDenied()
+    try:
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            raise ODSError('document_already_exists')
+        if operation in ('ods_join', 'ods_merge'):
+            if operation == 'ods_join':
+                spec = json_object(content, ('source', 'left_sheet', 'right_sheet', 'key', 'sheet'))
+                source, relative, data, identity = _read_source(spec.pop('source'), cap, '.ods')
+                states = [(source, data, identity)]
+                names = [relative]
+                rendered = join(data, spec, checkpoint=lambda: check(cap))
+            else:
+                spec = json_object(content, ('base', 'update', 'sheet', 'key', 'revision'))
+                first = _read_source(spec.pop('base'), cap, '.ods')
+                second = _read_source(spec.pop('update'), cap, '.ods')
+                if first[0] == second[0] or os.path.samestat(first[0].stat(), second[0].stat()):
+                    raise ODSError('distinct_sources_required')
+                states = [(row[0],row[2],row[3]) for row in (first,second)]
+                names = [first[1],second[1]]
+                rendered = merge(first[2], second[2], spec, checkpoint=lambda: check(cap))
+            from hermes_cli.friday_user_scope import workspace_document
+            from hermes_cli.friday_workspace_docx import _create_bytes
+            def verify():
+                check(cap)
+                for source, data, identity in states:
+                    current, _, version = workspace_document(str(source), with_identity=True)
+                    if current != data or version != identity:
+                        raise ScopeDenied()
+            result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                             output_format='ods', verify_source=verify))
+            if result.get('success'):
+                result.update(sources=names, source_unchanged=True, table_operation=operation,
+                              formatting_preserved=False, output_kind='new_plain_native_table')
+            return json.dumps(result, ensure_ascii=False)
+        if operation == 'ods_edit':
+            spec = json_object(content, ('source', 'sheet', 'cell', 'expected', 'value'))
+            source, relative, data, identity = _read_source(spec.pop('source'), cap, '.ods')
+            rendered = edit_spreadsheet(data, spec, checkpoint=lambda: check(cap))
+            state = source, data, identity
+            extra = dict(source=relative, source_sha256=hashlib.sha256(data).hexdigest(),
+                         source_unchanged=True, other_parts_preserved=True,
+                         formula_caches_not_recalculated=True)
+        elif operation == 'ods_create':
+            spec = json_object(content, ('sheets',))
+            rendered = create_spreadsheet(spec, checkpoint=lambda: check(cap))
+            state = None
+            extra = dict(native_editable=True, calculation='bounded_numeric_SUM_and_multiply_only')
+        else:
+            raise ODSError('unsupported_ods_operation')
+        check(cap)
+        return _publish(cap, fd, leaf, path, rendered, 'ods', state, extra)
+    except ScopeDenied:
+        raise
+    except (ODSError, ODTError, PresentationRefused) as error:
+        return json.dumps(dict(success=False, error='spreadsheet_operation_refused',
+                               reason=str(error), effect_disposition='none'))
