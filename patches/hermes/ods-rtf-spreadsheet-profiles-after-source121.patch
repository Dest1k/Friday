+"""RTF operations through the existing own-workspace atomic publisher."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_rtf import RTFError, create_rtf, edit_rtf, _object
+
+
+def execute(cap, fd, leaf, path, content, operation):
+    _check_parent(cap, fd, path)
+    if Path(path).suffix.lower() != '.rtf' or leaf != Path(path).name:
+        raise ScopeDenied()
+    try:
+        os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError:
+        pass
+    else:
+        return json.dumps({'success': False, 'error': 'document_already_exists',
+                           'effect_disposition': 'none'})
+    try:
+        check(cap)
+        original = source = identity = relative = None
+        if operation in ('rtf_create', 'rtf_structured'):
+            rendered = create_rtf(content, structured=operation == 'rtf_structured',
+                                  checkpoint=lambda: check(cap))
+        elif operation == 'rtf_edit':
+            spec = _object(content)
+            if not isinstance(spec, dict) or set(spec) != {'source', 'old_text', 'new_text'}:
+                raise RTFError('edit_schema')
+            raw = spec['source']
+            if not isinstance(raw, str) or not raw or '\x00' in raw:
+                raise ScopeDenied()
+            root = cap.home / 'workspace'
+            source = Path(raw)
+            if not source.is_absolute():
+                source = root / source
+            try:
+                relative = source.relative_to(root)
+            except ValueError:
+                raise ScopeDenied() from None
+            if (source.suffix.lower() != '.rtf' or not relative.parts
+                    or any(p in ('.', '..') or p.startswith('.') for p in relative.parts)
+                    or relative.as_posix() == path):
+                raise ScopeDenied()
+            original, _, identity = workspace_document(str(source), with_identity=True)
+            rendered = edit_rtf(original, spec['old_text'], spec['new_text'],
+                                checkpoint=lambda: check(cap))
+        else:
+            raise ScopeDenied()
+        check(cap)
+    except RTFError as error:
+        return json.dumps({'success': False, 'error': 'rtf_operation_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
+    verify = None
+    if source is not None:
+        def verify():
+            check(cap)
+            current, _, current_identity = workspace_document(str(source), with_identity=True)
+            if current != original or current_identity != identity:
+                raise ScopeDenied()
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+                                     output_format='rtf', verify_source=verify))
+    if result.get('success'):
+        result.update(native_editable=True)
+        if source is not None:
+            result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(original).hexdigest(),
+                          source_unchanged=True, replacements=1, edit_mode='unique_body_literal',
+                          unselected_bytes_preserved=True)
+    return json.dumps(result, ensure_ascii=False)
