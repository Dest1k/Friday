@@ -0,0 +1,49 @@
+"""One exact S08 control protocol on the existing bounded ordinary receiver."""
+
+from .d02_receiver_control import ReceiverControl, _ordinary_receiver_verb
+from .s08_document_custody import SCENARIO_SHA256, TERMINAL_SCHEMA, match_ingress, require, sender_witness
+from .s08_session_fence import capture_session_fence
+
+
+class S08ReceiverControl(ReceiverControl):
+    request_schema = "frw.gateway.s08-owned-receiver-control.v1"
+    options_schema = "frw.Root.S08.receiver-options.v1"
+    driver_schema = "frw.Root.S08.owned-ordinary-driver.v1"
+    exact_phases = frozenset((SCENARIO_SHA256,))
+    terminal_schema = TERMINAL_SCHEMA
+    wire_options = {"require_s08_document": True}
+
+    @staticmethod
+    def _check_ack_window(run, ack, window, scenario):
+        ReceiverControl._check_ack_window(run, ack, window, scenario)
+        if run["sent_api_ack_reference"]["representation"] == "botapi-wire-envelope-json":
+            ack = ack["result"]
+        sender_witness(ack, scenario)
+
+    def _terminal_extra(self, arm, route, scenario, joined, verified, deadline):
+        wire = arm.ingress.readback()["wire"]
+        require(wire["state"] == "LOCAL_WIRE_CLOSED" and len(wire["target_update_ids"]) == 1,
+                "s08_exact_closed_wire_required")
+        update, = wire["target_update_ids"]
+        sdk = arm.ingress._built[update].s08_document
+        run, ack = verified["run"], verified["ack"]
+        if run["sent_api_ack_reference"]["representation"] == "botapi-wire-envelope-json":
+            ack = ack["result"]
+        receipt, sender = match_ingress(ack, scenario, route, joined["observations"], sdk,
+                                        target_update_ids=wire["target_update_ids"])
+        fence = capture_session_fence(arm.ingress.adapter.gateway_runner, arm.ingress.scope, receipt,
+                                      started=sender["date"], cutoff=run["capture_until"], deadline=deadline)
+        return {
+            "s08_turn_fence": fence,
+            "s08_original_ack": run["sent_api_ack_reference"],
+            "s08_sender_message_id": sender["sender_message_id"],
+            "s08_receiver_update_id": receipt["message"]["platform_update_id"],
+            "s08_receiver_message_id": receipt["message"]["message_id"],
+            "s08_date": sender["date"],
+            "s08_input_sha256": receipt["message"]["media"][0]["content"]["sha256"],
+            "s08_input_bytes": receipt["message"]["media"][0]["content"]["size_bytes"],
+        }
+
+
+def ordinary_s08_receiver_verb(runner, loop):
+    return _ordinary_receiver_verb(runner, loop, control_type=S08ReceiverControl)
