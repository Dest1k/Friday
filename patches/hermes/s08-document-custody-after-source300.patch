+++ b/gateway/s08_session_fence.py
@@ -0,0 +1,76 @@
+"""Read the settled S08 row fence from the exact WAL-backed routed session."""
+
+from contextlib import closing
+import os
+from pathlib import Path
+import re
+import sqlite3
+import stat
+import time
+
+from .s08_document_custody import require
+
+
+def _sqlite_identity(path):
+    directory = path.parent.lstat()
+    require(stat.S_ISDIR(directory.st_mode) and directory.st_uid == os.getuid()
+            and directory.st_mode & 0o022 == 0 and path.parent.resolve(strict=True) == path.parent,
+            "s08_exact_routed_db_directory")
+    results = []
+    # A read-only WAL connection needs the existing sidecars. A missing
+    # sidecar is an unavailable fence, never a request to create one.
+    for candidate in (path, path.with_name(path.name + "-wal"), path.with_name(path.name + "-shm")):
+        info = candidate.lstat()
+        require(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and info.st_nlink == 1
+                and info.st_mode & 0o077 == 0, "s08_exact_routed_db_files")
+        identity = [info.st_dev, info.st_ino]
+        if candidate.suffix != ".db-shm":
+            identity.extend((info.st_size, info.st_mtime_ns, info.st_ctime_ns))
+        results.append(identity)
+    return results
