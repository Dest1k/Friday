--- /dev/null
+++ b/gateway/s08_document_custody.py
@@ -0,0 +1,143 @@
+"""Authenticated observations for the exact S08 upload on its owned native arm."""
+
+from datetime import datetime
+from hashlib import sha256
+import json
+
+SCENARIO_SHA256 = "3cd7e07aea3857a1b5f9b02b0516ad2904b3a42f3bfe213e808e1a0444228645"
+SOURCE_SHA256 = "06562cb3a7001ce6973727c72ad51dd433106e2a7ce068eb0c1fa36d8d9c712e"
+SOURCE_BYTES = 27799
+PAYLOAD_DOMAIN = b"friday.telegram.payload.v1\x00caption\x00"
+TERMINAL_SCHEMA = "frw.gateway.s08-native-settlement.v1"
+_EXCLUDED_MESSAGE_FIELDS = (
+    "message_thread_id", "reply_to_message", "external_reply", "edit_date", "media_group_id",
+    "forward_origin", "sender_chat", "via_bot", "business_connection_id", "text",
+    "audio", "video", "animation", "voice", "video_note", "sticker",
+)
+
+
+def require(condition, reason):
+    if not condition:
+        raise ValueError(reason)
+
+
+def _positive(value):
+    return type(value) is int and 0 < value < 2**63
+
+
+def _opaque(value):
+    return type(value) is str and 0 < len(value) <= 256 and all(33 <= ord(c) <= 126 for c in value)
+
+
+def _caption_digest(value):
+    require(type(value) is str and "\x00" not in value, "s08_exact_caption")
+    raw = value.encode("utf-8")
+    require(0 < len(raw) <= 16384, "s08_exact_caption")
+    return sha256(PAYLOAD_DOMAIN + raw).hexdigest()
+
+
+def upload_plan(scenario):
+    raw = (json.dumps(scenario, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n").encode("utf-8")
+    require(sha256(raw).hexdigest() == SCENARIO_SHA256, "s08_exact_scenario")
+    step, = scenario["steps"]
+    upload = step["input"]
+    require(upload["kind"] == "document" and upload["sha256"] == SOURCE_SHA256
+            and upload["stat"]["size_bytes"] == SOURCE_BYTES, "s08_exact_upload")
+    return upload
+
+
+def _plain_document(message):
+    topic = message.get("is_topic_message")
+    return (all(message.get(field) is None for field in _EXCLUDED_MESSAGE_FIELDS)
+            and message.get("photo") is None and (topic is None or topic is False))
+
+
+def sender_witness(ack, scenario):
+    """Use the original R4 ACK after its native window and file pins are checked."""
+    upload = upload_plan(scenario)
+    message_id, date = ack["message_id"], ack["date"]
+    actor, peer = scenario["tester_id"], scenario["peer_id"]
+    document = ack["document"]
+    planned = upload["caption"]
+    caption = ack["caption"]
+    # The stock sender permits one terminal LF omitted by Telegram.
+    require(caption == planned or planned.endswith("\n")
+            and not planned.endswith(("\n\n", "\r\n")) and caption == planned[:-1], "s08_ack_caption_changed")
+    require(_positive(message_id) and _positive(date) and _plain_document(ack)
+            and _positive(ack["from"]["id"]) and _positive(ack["chat"]["id"])
+            and ack["from"]["id"] == actor and ack["from"]["is_bot"] is True
+            and ack["chat"]["type"] == "private" and ack["chat"]["id"] == peer
+            and type(document["file_size"]) is int and document["file_size"] == SOURCE_BYTES
+            and document["file_name"] == upload["filename"] and document["mime_type"] == upload["mime_type"]
+            and _opaque(document["file_id"]) and _opaque(document["file_unique_id"]), "s08_exact_ack_document")
+    return {"sender_message_id": str(message_id), "date": date, "caption_sha256": _caption_digest(caption),
+            "file_unique_id": document["file_unique_id"], "file_name": document["file_name"],
+            "mime_type": document["mime_type"], "declared_bytes": document["file_size"]}
+
+
+def capture_document(adapter, update, event, *, actor, bot_id):
+    """Capture ingress only from the actual unmodified PTB media callback."""
+    from telegram import Chat, Document, Message, Update, User
+
+    require(type(update) is Update and type(update.message) is Message
+            and update.message is event.raw_message and update.get_bot() is adapter._bot,
+            "s08_original_sdk_update_required")
+    message = update.message
+    document = message.document
+    user, chat = message.from_user, message.chat
+    require(type(document) is Document and type(user) is User and type(chat) is Chat
+            and message.get_bot() is adapter._bot and document.get_bot() is adapter._bot
+            and user.get_bot() is adapter._bot and chat.get_bot() is adapter._bot
+            and _positive(actor) and _positive(bot_id) and actor != bot_id
+            and user.id == actor and user.is_bot is True and chat.id == actor and chat.type == "private"
+            and _positive(update.update_id) and _positive(message.message_id) and adapter._bot.id == bot_id
+            and event.platform_update_id == event._ingress_update_id == update.update_id
+            and event.message_type.value == "document" and event.message_id == str(message.message_id)
+            and event.reply_to_message_id is None and not event.internal and not event._ingress_merged,
+            "s08_exact_sdk_route")
+    raw_fields = {field: getattr(message, field) for field in _EXCLUDED_MESSAGE_FIELDS}
+    raw_fields.update(photo=message.photo or None, is_topic_message=message.is_topic_message)
+    require(_plain_document(raw_fields)
+            and type(message.date) is datetime and message.date.utcoffset() is not None
+            and message.date.microsecond == 0 and type(document.file_size) is int
+            and document.file_size == SOURCE_BYTES and _opaque(document.file_id)
+            and _opaque(document.file_unique_id) and _opaque(document.file_name) and _opaque(document.mime_type),
+            "s08_exact_sdk_document")
+    date = int(message.date.timestamp())
+    require(_positive(date), "s08_exact_sdk_date")
+    return {"update_id": str(update.update_id), "native_message_id": str(message.message_id),
+            "bot_id": str(bot_id), "actor_id": str(actor), "date": date,
+            "caption_sha256": _caption_digest(message.caption), "file_id": document.file_id,
+            "file_unique_id": document.file_unique_id, "file_name": document.file_name,
+            "mime_type": document.mime_type, "declared_bytes": document.file_size}
+
+
+def match_ingress(ack, scenario, route, observations, sdk, *, target_update_ids):
+    """Bind one complete settled wire update to one original sender and receiving document."""
+    wanted = sender_witness(ack, scenario)
+    require(type(observations) in (list, tuple) and len(observations) == 1
+            and type(sdk) is dict and tuple(target_update_ids) == (int(sdk["update_id"]),),
+            "s08_exact_one_closed_native_update_required")
+    compared = ("date", "caption_sha256", "file_unique_id", "file_name", "mime_type", "declared_bytes")
+    require(all(sdk[key] == wanted[key] for key in compared)
+            and sdk["actor_id"] == str(scenario["tester_id"]) and sdk["bot_id"] == str(scenario["peer_id"]),
+            "s08_original_ack_sdk_document_mismatch")
+    (receipt, payload), = observations
+    message = receipt["message"]
+    media, = message["media"]
+    require(receipt["platform"] == "telegram" and receipt["chat_type"] == "dm"
+            and all(receipt[key] == route[key] for key in
+                    ("session_key", "source_profile", "transport_profile", "runtime_profile"))
+            and (message["platform_update_id"], message["message_id"], message["bot_id"],
+                 message["user_id"], message["chat_id"], message["thread_id"], message["reply_to_message_id"])
+            == (sdk["update_id"], sdk["native_message_id"], sdk["bot_id"], sdk["actor_id"],
+                sdk["actor_id"], "", "")
+            and payload == {"kind": "caption", "date": sdk["date"], "sha256": sdk["caption_sha256"]},
+            "s08_registered_pair_changed")
+    origin = media["origin"]
+    require(all(origin[key] == message[key] for key in ("bot_id", "chat_id", "thread_id", "message_id"))
+            and all(origin[key] == sdk[key] for key in ("file_id", "file_unique_id", "declared_bytes"))
+            and media["mime_type"] == sdk["mime_type"]
+            and media["content"] == {"sha256": SOURCE_SHA256, "size_bytes": SOURCE_BYTES},
+            "s08_registered_media_not_original_xlsx")
+    return receipt, wanted
