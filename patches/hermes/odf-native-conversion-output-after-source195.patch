+        'xl/workbook.xml': {(R+'/theme', 'xl/theme/theme1.xml'),
+                            (R+'/styles', 'xl/styles.xml')}
+    }
+    expected['xl/workbook.xml'].update((R+'/worksheet', part) for part in book.sheet_parts.values())
+    if book.shared_strings_part is not None:
+        if book.shared_strings_part != 'xl/sharedStrings.xml':
+            refuse('conversion_relationship_unsupported')
+        expected['xl/workbook.xml'].add((R+'/sharedStrings', book.shared_strings_part))
+    if set(book.relationships) != set(expected):
+        refuse('conversion_relationship_unsupported')
+    for owner, rows in book.relationships.items():
+        if len(rows) != len(expected[owner]) or set(rows.values()) != expected[owner]:
+            refuse('conversion_relationship_unsupported')
+    pkg = 'http://schemas.openxmlformats.org/package/2006/relationships'
+    for part in ('_rels/.rels', 'xl/_rels/workbook.xml.rels'):
+        root = book.xml[part]
