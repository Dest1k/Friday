+def _passive(node, attrs, children=()):
+    """Exact known Office defaults; no arbitrary extension/property is ignored."""
+    if (node.attrib != attrs or (node.text or '').strip() or len(node) != len(children)
+            or any((child.tail or '').strip() for child in node)):
+        refuse('conversion_office_default_unsupported')
+    for item, (name, values, nested) in zip(node, children):
+        if item.tag != q(S, name): refuse('conversion_office_default_unsupported')
+        _passive(item, values, nested)
