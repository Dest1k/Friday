+OPERATIONS = {
+    'docx_odt': {'source': '.docx', 'output': '.odt', 'filter': 'odt:writer8'},
+    'odt_docx': {'source': '.odt', 'output': '.docx', 'filter': 'docx:Office Open XML Text'},
+}
+
+
+def _request(content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    if not isinstance(content, str) or len(content) > 8192:
+        raise ScopeDenied()
+    def pairs(items):
+        value = {}
+        for key, item in items:
+            if key in value:
+                raise ScopeDenied()
+            value[key] = item
+        return value
+    try:
+        value = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    if (not isinstance(value, dict) or set(value) != {'source', 'source_sha256'}
+            or not isinstance(value['source'], str) or not 1 <= len(value['source']) <= 4096
+            or '\x00' in value['source'] or not isinstance(value['source_sha256'], str)
+            or re.fullmatch('[0-9a-f]{64}', value['source_sha256']) is None):
+        raise ScopeDenied()
+    return value
+
+
+def _office_command(operation):
+    if operation not in OPERATIONS:
+        raise ValueError('unsupported_conversion')
+    spec = OPERATIONS[operation]
+    return ['/opt/friday-document-toolchain/root/usr/lib/libreoffice/program/soffice',
+            '--headless', '--norestore', '--nodefault', '--nolockcheck', '--nofirststartwizard',
+            '-env:UserInstallation=file:///work/home/profile', '--convert-to', spec['filter'],
+            '--outdir', '/work/out', '/work/input' + spec['source']]
+
+
+def _argv(work, toolchain, operation):
+    from hermes_cli.friday_workspace_pdf import _PREFIX, ExportRefused
+    if operation not in OPERATIONS:
+        raise ValueError('unsupported_conversion')
+    spec = OPERATIONS[operation]
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--new-session',
+            '--as-pid-1', '--cap-drop', 'ALL', '--clearenv', '--ro-bind', '/usr', '/usr']
+    for alias in ('bin', 'sbin', 'lib', 'lib64'):
+        item = Path('/') / alias
+        if item.exists():
+            target = item.resolve()
