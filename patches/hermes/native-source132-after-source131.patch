+                _fail('table_capacity')
+            rows.extend([row] * repeat)
+        if columns and rows and columns != len(rows[0]):
+            _fail('unsupported_table')
+        return self.state.table(rows)
+
+    def blocks(self):
+        _white(self.pkg.body)
+        result = []
+        for node in self.pkg.body:
+            if node.tag in (q(T, 'p'), q(T, 'h')):
+                result.append(self.paragraph(node))
+            elif node.tag == q(TB, 'table'):
+                result.append(self.table(node))
+            elif node.tag == q(T, 'sequence-decls'):
+                _white(node)
+                if any(c.tag != q(T, 'sequence-decl') or len(c) or (c.text or '').strip() for c in node):
+                    _fail('unsupported_odt_content')
+            else:
+                _fail('unsupported_odt_content')
+        return result
+
+
+def inventory(data, format, *, checkpoint=None):
+    """Return exact semantic blocks after a strict inert native preflight."""
+    state = _Inventory(checkpoint)
+    try:
+        if format == 'docx':
+            blocks = _Word(data, state).blocks()
+        elif format == 'odt':
+            blocks = _ODF(data, state).blocks()
+        else:
+            _fail('unsupported_conversion_format')
+    except (WordProfileError, ODFProfileError, ODTError, PresentationError) as error:
+        raise WordConversionError(str(error)) from None
+    if not blocks:
+        _fail('empty_document')
+    # Count expanded repeats too; physical XML counters alone are insufficient.
+    paragraphs = [p for b in blocks for p in ([b] if b['type'] != 'table' else
+                  [p for row in b['rows'] for cell in row for p in cell])]
+    total = sum(len(p['text'].encode('utf-8')) for p in paragraphs)
+    if len(paragraphs) > MAX_PARAGRAPHS or total > MAX_TEXT:
+        _fail('semantic_capacity')
+    _tick(checkpoint)
+    return blocks
+
+
+def validate_conversion(source, source_format, output, output_format, *, checkpoint=None):
+    if (source_format, output_format) not in (('docx', 'odt'), ('odt', 'docx')):
+        _fail('unsupported_conversion_pair')
+    before = inventory(source, source_format, checkpoint=checkpoint)
+    after = inventory(output, output_format, checkpoint=checkpoint)
+    if before != after:
+        _fail('semantic_mismatch')
+    paragraphs = [p for b in before for p in ([b] if b['type'] != 'table' else
+                  [p for row in b['rows'] for cell in row for p in cell])]
+    encoded = json.dumps(before, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode('utf-8')
+    return {'semantic_profile': 'plain_word_blocks_v1', 'semantic_sha256': hashlib.sha256(encoded).hexdigest(),
+            'body_blocks': len(before), 'paragraphs': len(paragraphs),
+            'headings': sum(p['type'] == 'heading' for p in paragraphs),
+            'tables': sum(b['type'] == 'table' for b in before),
+            'cells': sum(len(row) for b in before if b['type'] == 'table' for row in b['rows']),
+            'text_utf8_bytes': sum(len(p['text'].encode('utf-8')) for p in paragraphs),
+            'formatting_limits': FORMATTING_LIMITS}
