+    q(P, 'sldLayout'): _BASE+'presentationml.slideLayout+xml',
+    q(P, 'presentationPr'): _BASE+'presentationml.presProps+xml',
+    q(P, 'viewPr'): _BASE+'presentationml.viewProps+xml',
+    q(A, 'tblStyleLst'): _BASE+'presentationml.tableStyles+xml',
+    q(A, 'theme'): _BASE+'theme+xml',
+    q('http://schemas.openxmlformats.org/package/2006/metadata/core-properties', 'coreProperties'):
+        'application/vnd.openxmlformats-package.core-properties+xml',
+    q('http://schemas.openxmlformats.org/officeDocument/2006/extended-properties', 'Properties'):
+        _BASE+'extended-properties+xml',
+}
+_REL_TYPES = frozenset(R+'/'+name for name in (
+    'officeDocument', 'slide', 'slideMaster', 'slideLayout', 'notesSlide',
+    'notesMaster', 'theme', 'presProps', 'viewProps', 'tableStyles',
+    'extended-properties', 'image',
+)) | {VBA_RELATIONSHIP, PKG+'/metadata/core-properties', PKG+'/metadata/thumbnail'}
+_NAMESPACES = frozenset((P, A, R, PKG, CT,
