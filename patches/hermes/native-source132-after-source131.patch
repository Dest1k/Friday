+    'audiofile', 'videofile', 'snd', 'sndac', 'extlst', 'ext', 'custdata', 'custdatalst',
+    'hlinkclick', 'hlinkmouseover', 'timing', 'transition', 'webpr', 'embeddedfontlst',
