+    'http://purl.org/dc/elements/1.1/', 'http://purl.org/dc/terms/',
+    'http://purl.org/dc/dcmitype/', 'http://www.w3.org/2001/XMLSchema-instance',
+    'http://www.w3.org/XML/1998/namespace',
+))
