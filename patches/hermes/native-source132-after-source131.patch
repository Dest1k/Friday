+"""Own-workspace hash-bound macro presentation text edit into a NEW file."""
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+
+
+GUIDANCE = 'Macro presentation text: presentation_macro_edit uses exactly {source,source_sha256,slide,role,old_text,new_text} into a NEW same-format .pptm/.potm/.ppsm. Obtain source_sha256 from current read_file. slide is one-based; role is slide or notes. One unique literal within a supported paragraph is changed; all other member bytes, main type and opaque VBA are retained. Equal-format split runs are supported; fields, mixed formatting, signatures, protection, external/active/OLE/controls/unknown parts refuse. VBA is never inspected or executed; its safety is unproven. This does not create, merge or convert macro files or establish visual fidelity. '
+
+
+def create_edit(cap, fd, leaf, path, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_presentation import MACRO_FORMATS
+    from tools.scoped_presentation_write import json_object, PresentationRefused
+    from tools.scoped_presentation_macro_edit import edit_text
+    try:
+        check(cap)
+        _check_parent(cap, fd, path)
+        request = json_object(content, ('source', 'source_sha256', 'slide', 'role', 'old_text', 'new_text'))
+        if not isinstance(request['source'], str): raise ScopeDenied()
+        digest = request['source_sha256']
+        if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest):
+            raise PresentationRefused('source_hash_required')
+        profile = Path(request['source']).suffix.lower().lstrip('.')
+        if profile not in MACRO_FORMATS or Path(path).suffix.lower() != '.'+profile:
+            raise PresentationRefused('macro_edit_output_profile_mismatch')
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            raise PresentationRefused('document_already_exists')
+        source, relative, original, identity = _read_source(request['source'], cap, '.'+profile)
+        if hashlib.sha256(original).hexdigest() != digest:
+            raise PresentationRefused('source_hash_mismatch')
+        spec = {key: request[key] for key in ('slide', 'role', 'old_text', 'new_text')}
+        rendered, details = edit_text(original, profile, spec, checkpoint=lambda: check(cap))
+        check(cap)
+        return _publish(cap, fd, leaf, path, rendered, profile, (source, original, identity),
+            {'source': relative, 'source_sha256': digest, 'source_unchanged': True,
+             'preserving_edit': True, 'edit_mode': 'unique_macro_native_text',
+             'slide': request['slide'], 'role': request['role'], 'output_profile': profile,
+             **details})
+    except ScopeDenied:
+        raise
+    except PresentationRefused as error:
+        return json.dumps({'success': False, 'error': 'presentation_macro_edit_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
