+def create_copy(cap, fd, leaf, path, content):
+    """Copy an inert, hash-bound DOCX snapshot verbatim into a new owned name.
+
+    Package validation grants no rendering or edit fidelity claim. No XML,
+    extracted text or ZIP member is rewritten; the existing publisher verifies
+    both the source identity and the exact destination bytes around publication.
+    """
