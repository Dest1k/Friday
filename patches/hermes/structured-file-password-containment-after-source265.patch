+def _unique_argument_keys(items):
+    parsed = {}
+    for key, value in items:
+        if key in parsed:
+            raise ValueError("duplicate protected-file argument key")
+        parsed[key] = value
+    return parsed
+
+
+def _argument_object(raw):
+    parsed = json.loads(raw, object_pairs_hook=_unique_argument_keys) if isinstance(raw, str) else raw
+    if not isinstance(parsed, dict):
+        raise ValueError("protected-file arguments must be an object")
+    return parsed
+
+
+def _mask_password_fields(args):
+    passwords = {key: "[redacted]" for key in args
+                 if isinstance(key, str) and key.casefold() == "password" and args[key] is not None}
+    return {**args, **passwords} if passwords else args
+
+
+def _restore_argument_shape(raw, projected):
+    return json.dumps(projected, ensure_ascii=False) if isinstance(raw, str) else projected
