+    def _ordinary_busy_status(self, event: MessageEvent, session_key: str, adapter) -> Optional[str]:
+        """Describe the currently owned ordinary turn without dispatching a new turn."""
+        source = event.source
+        raw_message = getattr(event, "raw_message", None)
+        if (source.platform != Platform.TELEGRAM or getattr(adapter, "platform", None) != Platform.TELEGRAM
+                or source.chat_type != "dm" or source.is_bot
+                or event.message_type != MessageType.TEXT or not event.allow_gateway_control
+                or event.internal or event.media_urls or event.media_types or event._ingress_merged
+                or (event.text or "").strip().casefold() != "что сейчас происходит?"
+                or any(getattr(raw_message, field, None) for field in
+                       ("forward_origin", "forward_from", "forward_from_chat", "edit_date"))):
+            return None
+        if any(entity.type in {"blockquote", "expandable_blockquote", "code", "pre"}
+               for entity in (getattr(raw_message, "entities", None) or ())):
+            return None
+
+        from hermes_cli.friday_user_scope import UserScope, _same_scope
+        capability = getattr(source, "_friday_user_scope", None)
+        if not isinstance(capability, UserScope):
+            return None  # Native admission must have bound this ordinary user.
+
+        state = self._peek_session_state(session_key)
+        task = adapter._session_tasks.get(session_key)
+        guard = adapter._active_sessions.get(session_key)
+        unknown = "Не могу подтвердить, что предыдущий запрос ещё выполняется."
+        if (state is None or not isinstance(task, asyncio.Task) or task.done() or task.cancelling()
+                or guard is None or guard.is_set()):
+            return unknown
+        turn = state.turn
+        opening = turn.event
+        opening_scope = getattr(opening.source, "_friday_user_scope", None) if opening is not None else None
+        generation = self._current_session_run_generation(session_key)
+        token = turn.lease_tokens.get(generation)
+        if (opening is None or turn.agent is None
+                or getattr(opening, "_friday_document_guard", None) != (session_key, guard)
+                or getattr(guard, "_hermes_run_generation", None) != generation
+                or token is None or token.released or token.lease.holder is not token
+                or not _same_scope(capability, opening_scope) or capability.revoked or opening_scope.revoked):
+            return unknown
+
+        if (opening.message_type == MessageType.DOCUMENT
+                and getattr(turn.agent, "_executing_tools", False) is True):
+            with contextlib.suppress(Exception):
+                if turn.agent.get_activity_summary().get("current_tool") == "read_file":
+                    return "Читаю файл по этому запросу. Время завершения пока неизвестно."
+        return "Запрос ещё выполняется. Точный этап и время завершения пока неизвестны."
+
