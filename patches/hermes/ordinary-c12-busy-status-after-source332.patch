diff --git a/tests/gateway/test_ordinary_busy_status.py b/tests/gateway/test_ordinary_busy_status.py
new file mode 100644
index 0000000000000000000000000000000000000000..38a5528c574fe371264a36e190d63797a842e32f
--- /dev/null
+++ b/tests/gateway/test_ordinary_busy_status.py
@@ -0,0 +1,90 @@
+"""The ordinary Telegram status question excludes quoted or literal body text."""
+
+import asyncio
+from dataclasses import replace
+from datetime import datetime, timezone
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.event import MessageType
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from hermes_cli.friday_user_scope import UserScope
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from plugins.platforms.telegram.telegram_message_event import build_message_event
+
+
+QUESTION = "Что сейчас происходит?"
+READING = "Читаю файл по этому запросу. Время завершения пока неизвестно."
+UNKNOWN = "Не могу подтвердить, что предыдущий запрос ещё выполняется."
+
+
+def _telegram_event(entity_type):
+    entities = (SimpleNamespace(type=entity_type),) if entity_type else ()
+    quote = "Текст из предыдущего сообщения."
+    chat = SimpleNamespace(id=1001, type="private", full_name="Fixture", title=None)
+    previous = SimpleNamespace(message_id=20, text=quote + " Остаток.")
+    raw = SimpleNamespace(message_id=21, date=datetime.now(timezone.utc), chat=chat,
+                          from_user=SimpleNamespace(id=1001, full_name="Fixture", is_bot=False),
+                          text=QUESTION, entities=entities, reply_to_message=previous,
+                          quote=SimpleNamespace(text=quote))
+    adapter = SimpleNamespace(
+        config=PlatformConfig(),
+        _chat_type_str=lambda chat: chat.type,
+        _is_group_chat=lambda message: message.chat.type in {"group", "supergroup"},
+        _effective_message_thread_id=lambda message: None,
+        _resolve_topic_binding=lambda *args: (None, None),
+        _reply_context=lambda message: TelegramAdapter._reply_context(adapter, message),
+        build_source=lambda **kwargs: SessionSource(platform=Platform.TELEGRAM, **kwargs),
+    )
+    return build_message_event(adapter, raw, MessageType.TEXT, update_id=2001)
+
+
+async def _status(tmp_path, entity_type, *, stale=False, revoked=False, delivery=Platform.TELEGRAM):
+    event = _telegram_event(entity_type)
+    assert event.text == QUESTION
+    assert event.reply_to_message_id == "20"
+    assert event.reply_to_text == "Текст из предыдущего сообщения."
+    capability = UserScope(tmp_path, tmp_path, "fixture", ("telegram", "default", "5001", "1001"), {}, ())
+    event.source._friday_user_scope = capability
+    guard = asyncio.Event()
+    guard._hermes_run_generation = 6 if stale else 7
+    until_done = asyncio.Event()
+    task = asyncio.create_task(until_done.wait())
+    try:
+        opening_scope = replace(capability, revoked=revoked)
+        opening_source = SimpleNamespace(_friday_user_scope=opening_scope)
+        opening = SimpleNamespace(source=opening_source, message_type=MessageType.DOCUMENT,
+                                  _friday_document_guard=("own-session", guard))
+        agent = SimpleNamespace(_executing_tools=True, get_activity_summary=lambda: {"current_tool": "read_file"})
+        lease = SimpleNamespace()
+        token = SimpleNamespace(lease=lease, released=False)
+        lease.holder = token
+        state = SimpleNamespace(turn=SimpleNamespace(event=opening, agent=agent, lease_tokens={7: token}))
+        runner = SimpleNamespace(_peek_session_state=lambda key: state, _current_session_run_generation=lambda key: 7)
+        adapter = SimpleNamespace(platform=delivery, _session_tasks={"own-session": task},
+                                  _active_sessions={"own-session": guard})
+        return GatewayRunner._ordinary_busy_status(runner, event, "own-session", adapter)
+    finally:
+        until_done.set()
+        await task
+
+
+@pytest.mark.parametrize("entity_type", ("blockquote", "expandable_blockquote", "code", "pre"))
+def test_literal_telegram_body_stays_ordinary_busy_input(tmp_path, entity_type):
+    assert asyncio.run(_status(tmp_path, entity_type)) is None
+
+
+def test_plain_status_in_reply_reports_current_document_read(tmp_path):
+    assert asyncio.run(_status(tmp_path, None)) == READING
+
+
+@pytest.mark.parametrize(("stale", "revoked"), ((True, False), (False, True)))
+def test_stale_or_revoked_operation_gets_an_uncertain_status(tmp_path, stale, revoked):
+    assert asyncio.run(_status(tmp_path, None, stale=stale, revoked=revoked)) == UNKNOWN
+
+
+def test_relay_with_telegram_logical_source_keeps_normal_handling(tmp_path):
+    assert asyncio.run(_status(tmp_path, None, delivery=Platform.RELAY)) is None
