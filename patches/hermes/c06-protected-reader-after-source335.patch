+}
+STAGES = frozenset(("READONLY", "NEW", "CURSOR_AUTHORITY", "PRE_INTENT_REVALIDATION", "WIRE"))
+BOOT = Path("/proc/sys/kernel/random/boot_id")
+
+
+def require(value, reason):
+    if not value:
+        raise AnchorUnavailable(reason)
+
+
+def encoded(value):
+    return (json.dumps(value, ensure_ascii=True, sort_keys=True, allow_nan=False) + "\n").encode()
+
+
+def digest(value):
+    return sha256(encoded(value)).hexdigest()
+
+
+def phase_for(run_id, scenario):
+    scenario_hash = digest(scenario)
+    for role, (name, expected, needed) in PHASES.items():
+        if run_id == name and scenario_hash == expected:
+            return role, scenario_hash, needed
+    raise AnchorUnavailable("c06_exact_phase_scenario_required")
+
+
+def lineage_for(cap, entry):
+    transport, profile, peer, tester = cap.principal
+    origin = entry.origin
+    require(transport == "telegram" and origin is not None and origin.platform.value == transport
+            and (origin.user_id, origin.chat_id, origin.chat_type, origin.thread_id, origin.profile)
+            == (tester, tester, "dm", None, cap.profile)
+            and entry.session_key == f"agent:{cap.profile}:telegram:dm:{tester}"
+            and entry.transport_profile == profile and cap.home == cap.authorization_home / "profiles" / cap.profile,
+            "c06_exact_native_owner_and_conversation_required")
+    conversation = {
+        "platform": "telegram", "chat_type": "dm", "profile": cap.profile,
+        "tester_id": int(tester), "peer_id": int(peer), "scope": str(cap.authorization_home / "sessions"),
+        "session_key": entry.session_key, "session_id": entry.session_id,
+    }
+    return {
+        "owner": str(cap.home), "chat": int(peer), "tester": int(tester),
+        "native_conversation": digest({"conversation": conversation,
+                                       "route_created_at": entry.created_at.isoformat(),
+                                       "transport_profile": profile}),
+        "workspace": str(cap.home / "workspace"),
+    }
+
+
+def read_doc(reference, read_reference):
+    raw = read_reference(reference)
+    value = json.loads(raw)
+    require(type(value) is dict and encoded(value) == raw, "c06_canonical_protected_document_required")
+    return value
+
+
+def data_versions(connections):
+    # SQLite data_version is comparable over time on the same connection.
+    return tuple(conn.execute("PRAGMA data_version").fetchone()[0] for conn in connections)
+
+
+@dataclass(frozen=True, slots=True)
+class BorrowedOwner:
+    """Only the existing protected process can supply these native objects."""
+
+    routing_store: object
+    routing_db: SessionDB
+    profile_db: SessionDB
+    r4_store: object
+    cap: UserScope
+    entry: object
+    publications: tuple
+    expected_scope_bytes: bytes
