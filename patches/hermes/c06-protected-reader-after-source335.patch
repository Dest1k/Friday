+        cap.check()
+        current = _current_entry(
+            self.routing_store, SimpleNamespace(session_id=entry.session_id, session_key=entry.session_key),
+            cap, ("telegram", cap.principal[3], cap.principal[3], "dm", None),
+        )
+        require(current is entry and entry.active_turn_token is None and not entry.suspended
+                and not entry.expiry_finalized, "c06_native_route_incarnation_changed")
+        return lineage_for(cap, entry)
+
+    def check_current(self, scope, *, scenario, read_reference, load_module):
+        """Existing ordinary check; the producer will separately check C06 artifacts."""
+        with authority(self.cap.home):
+            self._current(scope)
+        return True
+
+    def require_finalizations(self, rows, needed, *, read_reference, in_time):
+        require(self.retired_publications is not None, "c06_exact_retired_predecessors_required")
+        publications = self._predecessors(needed)
+        for row, handle in zip(rows, self.retired_publications, strict=True):
+            in_time()
+            handle.require_finalization(row, lambda ref: read_doc(ref, read_reference))
+        in_time()
+        return publications
+
+    def c06_current_projection(self, scope, *, scenario, run_id, stage, authority_ref,
+                               read_reference, read_grant, load_module, deadline_monotonic=None):
+        """Issue only the existing phase projection, using the caller's held locks."""
+        if deadline_monotonic is not None:
+            require(type(deadline_monotonic) in (int, float) and isfinite(deadline_monotonic)
+                    and time.monotonic() < deadline_monotonic,
+                    "c06_current_projection_deadline_expired")
+        require(stage in STAGES, "c06_current_stage_refused")
+        phase, scenario_hash, needed = phase_for(run_id, scenario)
+        admission = read_doc(authority_ref, read_reference)
+        now = time.time()
+        require(admission.get("schema") == "frw.Root.ordinary-independent-history-admission.v1"
+                and admission.get("operator") == "Root" and admission.get("accepted") is True
+                and admission.get("boot_id") == self.boot_id
+                and admission.get("run_scenarios") == {run_id: scenario_hash}
+                and all(type(admission.get(key)) in (int, float) and isfinite(admission[key])
+                        for key in ("created_at", "expires_at"))
+                and admission["created_at"] <= now < admission["expires_at"],
+                "c06_exact_separate_current_admission_required")
+        rows, expected_lineage = read_predecessors(admission, phase, scenario_hash, read_grant)
+        proof_dir = Path(admission["c06"]["authority"]["path"]).parent
+        deadline = time.monotonic() + (admission["expires_at"] - now)
+        if deadline_monotonic is not None:
+            deadline = min(deadline, deadline_monotonic)
+
+        def in_time():
+            require(time.monotonic() < deadline, "c06_current_projection_deadline_expired")
+
+        with authority(self.cap.home), ExitStack() as resources:
+            lineage = self._current(scope)
+            require(lineage == expected_lineage, "c06_active_predecessor_lineage_changed")
+            in_time()
+            connections = []
+            for db in (self.routing_db, self.profile_db):
+                conn = resources.enter_context(
+                    _read_snapshot(db, deadline, lambda: int(time.monotonic() >= deadline)))
+                # Track commits across the separate existing F01 read snapshots.
+                conn.rollback()
+                connections.append(conn)
+            versions = data_versions(connections)
+            publications = self.require_finalizations(rows, needed, read_reference=read_reference, in_time=in_time)
+            if len(publications) == 2:
+                validate_pair(*publications, self.cap, entry=self.entry)
+            visible = {}
+            for original, expected in zip(publications, rows, strict=True):
+                in_time()
+                require(original.run_id == expected["binding"]["run_id"] != run_id,
+                        "c06_native_publication_or_future_run_changed")
+                settled = settle_native_text(
+                    self.r4_store, original.role, expected["binding"], original, self.profile_db,
+                    self.cap, routing_store=self.routing_store, routing_db=self.routing_db, entry=self.entry,
+                )
+                in_time()
+                require(settled["ingress"]["lineage"] == lineage,
+                        "c06_settled_native_lineage_changed")
+                verify_root_grade(proof_dir, expected["review"], expected["ingress"], settled)
+                visible[original.role] = dict(expected["ingress"])
+            in_time()
+            # No source/owner admission may drift while the other role is read.
+            require(all(before is after for before, after in
+                        zip(publications, self._predecessors(needed), strict=True)),
+                    "c06_retired_predecessor_changed_during_projection")
+            require(self._current(scope) == lineage,
+                    "c06_current_projection_closed_or_changed")
+            require(data_versions(connections) == versions,
+                    "c06_native_transcript_or_route_changed_during_projection")
+            in_time()
+            checked_at = time.time()
+            require(checked_at < admission["expires_at"], "c06_current_projection_closed_or_changed")
+        return {"schema": SCHEMA, "phase": phase, "run_id": run_id,
+                "scenario_sha256": scenario_hash, "lineage": lineage,
+                "checked_at": checked_at, "visible_sources": visible}
diff --git a/c06_r4_custody.py b/c06_r4_custody.py
new file mode 100644
index 0000000000000000000000000000000000000000..27ca2d92dfd1650fd2a6a47680882cfc68998ca6
--- /dev/null
+++ b/c06_r4_custody.py
@@ -0,0 +1,249 @@
+"""Owner-bound, read-only access to the privately installed R4 receipt reader."""
+
+from dataclasses import dataclass
+from functools import lru_cache
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import re
+import stat
+from types import ModuleType, SimpleNamespace
+from typing import NamedTuple
+
+
+HEX = re.compile(r'[0-9a-f]{64}')
+_RUN_ID = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}')
+_OPEN_PRIVATE = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
+_OPEN_DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
+_READER_DIR = 'c06-r4-reader-v1'
+_R4 = ('r4-reader.py', 1153121, '44577894f0669d305d2cd713048928c7ccbce265a40f1f6d09080b1fb62228bd')
+_F03 = ('f03-history-reader.py', 1148096, 'b901b7ac63e4ff0a6e279d2e13651ec03fb6d7de93866ae3cdf1b8d7ca85e9e1')
+_FIRST_SEND = ('f03-first-send-reader.py', 19459, '52d48a7cfc6162c137569728ec024e6d2633a0d7901ef92071b47cd764af63d7')
+
+
+class Refused(ValueError):
+    pass
+
+
+def require(condition, reason):
+    if not condition:
+        raise Refused(reason)
+
+
+def _file_identity(info):
+    return (info.st_dev, info.st_ino, info.st_uid, info.st_mode, info.st_nlink,
+            info.st_size, info.st_mtime_ns, info.st_ctime_ns)
+
+
+def _private_file(info, size):
+    return (stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and info.st_nlink == 1
+            and stat.S_IMODE(info.st_mode) in (0o400, 0o600) and info.st_size == size and size > 0)
+
+
+def _dir_identity(info):
+    require(stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid()
+            and stat.S_IMODE(info.st_mode) == 0o700, 'C06_R4_PROTECTED_DIRECTORY_REQUIRED')
+    return info.st_dev, info.st_ino, info.st_uid, info.st_mode
+
+
+def _snapshot_directory(path):
+    require(path.is_absolute() and path.resolve(strict=True) == path and '..' not in path.parts,
+            'C06_R4_CANONICAL_DIRECTORY_REQUIRED')
+    return _dir_identity(path.lstat())
+
+
+def read_pin(path, sha, cap):
+    """Read old evidence through the existing exact owner, mode and byte fence."""
+    require(isinstance(sha, str) and HEX.fullmatch(sha), 'Expected SHA-256 missing')
+    require(path.is_absolute() and path.resolve(strict=True) == path, 'Unprotected snapshot path')
+    with os.fdopen(os.open(path, _OPEN_PRIVATE), 'rb') as source:
+        info = os.fstat(source.fileno())
+        require(_private_file(info, info.st_size) and stat.S_IMODE(info.st_mode) == 0o600
+                and info.st_size <= cap, 'Unprotected snapshot file')
+        identity = _file_identity(info)
+        raw = source.read(info.st_size + 1)
+        require(len(raw) == info.st_size and identity == _file_identity(os.fstat(source.fileno()))
+                == _file_identity(path.lstat()), 'Snapshot changed during read')
+    require(sha256(raw).hexdigest() == sha, 'Pinned snapshot SHA-256 mismatch')
+    return raw
+
+
+def pin(r4, path, sha, cap):
+    raw = read_pin(path, sha, cap)
+    value = json.loads(raw, object_pairs_hook=r4.unique_object)
+    require(r4.encoded(value) == raw, 'Canonical protected JSON required')
+    return value
+
+
+@dataclass(frozen=True, slots=True)
+class _InstalledReader:
+    root: Path
+    root_identity: tuple
+    reader_identity: tuple
+
+    def read(self, role):
+        name, size, digest = role
+        directory = self.root / _READER_DIR
+        root_fd = directory_fd = None
+        try:
+            require(_snapshot_directory(self.root) == self.root_identity, 'C06_R4_AUTHORITY_ROOT_CHANGED')
+            root_fd = os.open(self.root, _OPEN_DIRECTORY)
+            require(_dir_identity(os.fstat(root_fd)) == self.root_identity, 'C06_R4_AUTHORITY_ROOT_CHANGED')
+            directory_fd = os.open(_READER_DIR, _OPEN_DIRECTORY, dir_fd=root_fd)
+            require(_dir_identity(os.fstat(directory_fd)) == self.reader_identity,
+                    'C06_R4_INSTALLED_DIRECTORY_CHANGED')
+            with os.fdopen(os.open(name, _OPEN_PRIVATE, dir_fd=directory_fd), 'rb') as source:
+                info = os.fstat(source.fileno())
+                require(_private_file(info, size), 'C06_R4_INSTALLED_PRIVATE_FILE_REQUIRED')
+                identity = _file_identity(info)
+                data = source.read(size + 1)
+                require(len(data) == size and identity == _file_identity(os.fstat(source.fileno()))
+                        == _file_identity(os.stat(name, dir_fd=directory_fd, follow_symlinks=False)),
+                        'C06_R4_INSTALLED_FILE_CHANGED')
+            require(_snapshot_directory(self.root) == self.root_identity
+                    and _snapshot_directory(directory) == self.reader_identity
+                    and identity == _file_identity((directory / name).lstat()), 'C06_R4_INSTALLED_PATH_CHANGED')
+            require(sha256(data).hexdigest() == digest, 'C06_R4_INSTALLED_SOURCE_PIN_CHANGED')
+            return data, directory / name
+        except OSError as exc:
+            raise Refused(f'C06_R4_INSTALLED_ROLE_UNAVAILABLE:{name}') from exc
+        finally:
+            if directory_fd is not None:
+                os.close(directory_fd)
+            if root_fd is not None:
+                os.close(root_fd)
+
+
+@dataclass(frozen=True, slots=True)
+class _BorrowedStore:
+    root: Path
+    runs: Path
+    captures: Path
+    downloads: Path
+    _read: object
+    _reader: _InstalledReader
+
+    def run_path(self, name):
+        require(type(name) is str and _RUN_ID.fullmatch(name), 'Run ID requires 1-64 simple characters')
+        return self.runs / (name + '.json')
+
+    def get(self, path, default=None):
+        path = Path(path)
+        require(path.is_relative_to(self.root) and '..' not in path.parts, 'C06_R4_BORROWED_STORE_PATH_CHANGED')
+        return self._read(path, default)
+
+
+def bind_r4_store(store, *, authority_root):
+    """Bind the existing Gateway owner's Store and exact private installation.
+
+    The owner supplies its existing protected authority directory in-process.
+    This only reads directory identities and lends the Store's existing reader.
+    """
+    try:
+        authority_root = Path(authority_root)
+        root = Path(store.root)
+        paths = tuple(root / leaf for leaf in ('runs', 'updates', 'downloads'))
+        require(paths == (store.runs, store.captures, store.downloads) and callable(store.get)
+                and not (root.is_relative_to(authority_root) or authority_root.is_relative_to(root)),
+                'C06_R4_SEPARATE_OWNER_AND_BORROWED_STORE_REQUIRED')
+        for directory in (root, *paths):
+            _snapshot_directory(directory)
+        installed = _InstalledReader(authority_root, _snapshot_directory(authority_root),
+                                     _snapshot_directory(authority_root / _READER_DIR))
+        installed.read(_R4)
+        return _BorrowedStore(root, *paths, store.get, installed)
+    except (OSError, AttributeError, TypeError) as exc:
+        raise Refused('C06_PROTECTED_INSTALLED_R4_READER_UNBOUND') from exc
+
+
+@lru_cache(maxsize=3)
+def _compiled(raw, path):
+    return compile(raw, path, 'exec')
+
+
+def _module(name, raw, real_path, *, evidence_path=None):
+    module = ModuleType(name)
+    module.__file__ = str(real_path if evidence_path is None else evidence_path)
+    exec(_compiled(raw, str(real_path)), vars(module))
+    return module
+
+
+def _first_send_reader(installed, history, history_path):
+    ref = history._F03_PHASE_SOURCE
+    require((ref['bytes'], ref['sha256']) == _FIRST_SEND[1:], 'C06_R4_FIRST_SEND_CONTRACT_CHANGED')
+    raw, path = installed.read(_FIRST_SEND)
+    original = Path(ref['path'])
+    # Preserve the archived implementation and consumer references while
+    # reading their exact source bytes through the current protected install.
+    phase = _module('_c06_exact_f03_first_send_reader', raw, path, evidence_path=original)
+    read_historical = phase.read
+
+    source_aliases = {original: _FIRST_SEND, history_path: _F03}
+
+    def read(selected, *, limit=24 * 1024**2):
+        source_role = source_aliases.get(Path(selected))
+        if source_role is None:
+            return read_historical(selected, limit=limit)
+        require(limit >= source_role[1], 'C06_R4_HISTORICAL_SOURCE_READ_LIMIT')
+        return installed.read(source_role)[0]
+
+    phase.read = read
+    return SimpleNamespace(effective_deadline=phase.effective_deadline)
+
+
+def _history_reader(installed, ref):
+    require((ref['bytes'], ref['sha256']) == _F03[1:], 'C06_R4_HISTORY_CONTRACT_CHANGED')
+    raw, path = installed.read(_F03)
+    history = _module('_c06_exact_f03_history_reader', raw, path)
+    history._f03_phase_module = lambda: _first_send_reader(installed, history, Path(ref['path']))
+    return SimpleNamespace(Runner=history.Runner)
+
+
+def _no_effect(*args, **kwargs):
+    raise Refused('C06_R4_READER_HAS_NO_EFFECT_AUTHORITY')
+
+
+class _ReceiptRunner(NamedTuple):
+    load: object
+    verify_reply_custody: object
+    receive_inventory: object
+    cursor_offsets: object
+
+
+class _ReceiptReader(NamedTuple):
+    Runner: object
+    Refused: type
+    MAX_JSON: int
+    TESTER: int
+    USERNAME: str
+    encoded: object
+    digest: object
+    unique_object: object
+    validate_scenario: object
+    read_document_input: object
+    document_multipart: object
+    input_method: object
+    valid_input_ack: object
+
+
+def load_r4(store):
+    """Open only the installed pins and expose the exact R4 receipt surface."""
+    require(type(store) is _BorrowedStore, 'C06_PROTECTED_INSTALLED_R4_READER_UNBOUND')
+    installed = store._reader
+    raw, path = installed.read(_R4)
+    r4 = _module('_c06_exact_r4_receipt_reader', raw, path)
+    r4._f03_history_source_module = lambda: _history_reader(installed, r4._F03_HISTORY_SOURCE)
+
+    def runner(selected, api):
+        require(selected is store and api is None, 'C06_R4_READONLY_EXACT_STORE_REQUIRED')
+        target = r4.Runner(selected, None, sleep=_no_effect)
+        for name in ('guard', 'send', '_send', 'save', 'capture', 'capture_reply',
+                     'process', 'commit_receive', 'keep_ack', 'terminal_drain',
+                     'poll_updates', 'observe', 'prepared_first_send'):
+            setattr(target, name, _no_effect)
+        return _ReceiptRunner(target.load, target.verify_reply_custody, target.receive_inventory, target.cursor_offsets)
+
+    return _ReceiptReader(runner, r4.Refused, r4.MAX_JSON, r4.TESTER, r4.USERNAME, r4.encoded, r4.digest,
+                          r4.unique_object, r4.validate_scenario, r4.read_document_input, r4.document_multipart,
+                          r4.input_method, r4.valid_input_ack)
diff --git a/c06_settlement.py b/c06_settlement.py
new file mode 100644
index 0000000000000000000000000000000000000000..891ddc97848f6b09cd73a6039ee2314375f524e3
--- /dev/null
+++ b/c06_settlement.py
@@ -0,0 +1,201 @@
+"""Reconcile one C06 native receiver publication with independently retained R4 text.
+
+The owner supplies the selected original publication and borrowed native
+handles, holds the R4 consumer fence and obtains grade pins through its
+existing protected Root path. This module only reads and joins evidence.
+"""
+
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import time
+
+from c06_ingress import PublishedOriginal, is_selected_plan, revalidate_original
+from c06_r4_custody import HEX, load_r4, pin, read_pin, require
+from gateway.d02_receiver_control import _private_doc
+from hermes_cli.friday_dashboard_owner import read_owned
+from hermes_cli.friday_user_scope import UserScope, authority
+from native_publisher import settle_receipt
+
+REVIEW_SCHEMA = 'frw.c06.independent-phase-review.v1'
+REF_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,190}\.json')
+
+
+def _reference_path(reference, parent):
+    require(type(reference) is dict and set(reference) == {'path', 'sha256'}
+            and type(reference['path']) is str and type(reference['sha256']) is str
+            and HEX.fullmatch(reference['sha256']),
+            'Exact C06 protected JSON reference required')
+    path = Path(reference['path'])
+    require(path.is_absolute() and str(path) == reference['path'] and REF_NAME.fullmatch(path.name)
+            and path.parent == parent,
+            'C06 authority, ingress and review need separate named files under one protected directory')
+    return path
+
+
+def _outbound(r4, plan):
+    # Recheck the physical sender preimage encoded in the historical scenario.
+    step, = plan['steps']
+    digest = r4.digest(r4.encoded(plan))
+    upload = step['input']
+    payload = r4.read_document_input(upload, lambda: None)
+    body, mime = r4.document_multipart(upload, payload)
+    return dict(method=r4.input_method(upload), chat_id=r4.USERNAME, input_sha256=upload['sha256'],
+                input_bytes=len(payload), input_stat=upload['stat'], filename=upload['filename'],
+                mime_type=upload['mime_type'], caption=upload['caption'], content_type=mime,
+                body_sha256=r4.digest(body), body_bytes=len(body), scenario_sha256=digest)
+
+
+def _completed_text(r4, store, binding):
+    fields = {'run_id', 'run_sha256', 'scenario_sha256', 'sent_message_id',
+              'terminal_sha256', 'text_receipt_sha256'}
+    require(type(binding) is dict and set(binding) == fields and
+            is_selected_plan((binding['scenario_sha256'], binding['run_id'])) and
+            type(binding['sent_message_id']) is int and binding['sent_message_id'] > 0 and
+            all(type(binding[k]) is str and HEX.fullmatch(binding[k])
+                for k in fields - {'run_id', 'sent_message_id'}),
+            'Exact Run, ACK, terminal and text receipt pins required')
+    run_path = store.run_path(binding['run_id'])
+    run = pin(r4, run_path, binding['run_sha256'], r4.MAX_JSON)
+    plan = run['scenario']
+    require(r4.validate_scenario(plan) == plan, 'Exact normalized C06 plan required')
+    runner = r4.Runner(store, None)
+    require(run == runner.load(binding['run_id']) and type(run['step']) is int and run['step'] == 0
+            and run['id'] == binding['run_id']
+            and run['scenario_sha256'] == binding['scenario_sha256'] == r4.digest(r4.encoded(plan)),
+            'Exact separate predecessor run and scenario differ')
+    sent = binding['sent_message_id']
+    require(run['status'] == 'EVIDENCE_READY' and run['capture_window_complete'] is True
+            and run['send_state'] == 'sent' and type(run['send_attempts']) is int
+            and run['send_attempts'] == 1 and run['sent_message_id'] == sent and run['sent_ids'] == [sent]
+            and run['reply_outcome'] == 'RECEIVED_UNGRADED'
+            and run['artifact_acceptance'] == 'NOT_VERIFIED'
+            and run.get('product_cancelled') is False
+            and run['acceptance'] == 'NOT_ESTABLISHED' and run['operator_corroboration_required'] is True,
+            'Completed single-send R4 predecessor required')
+    created = datetime.fromisoformat(run['created_at'])
+    observed = datetime.fromisoformat(run['observed_at'])
+    require(created.tzinfo is not None and observed.tzinfo is not None and
+            abs(run['deadline'] - created.timestamp() - 300) <= 1 and
+            created.timestamp() <= run['sent_at'] and run['capture_until'] == run['sent_at'] + 180
+            and run['capture_until'] <= observed.timestamp() <= run['deadline'],
+            'Original 300-second deadline and complete 180-second capture required')
+    runner.verify_reply_custody(run)
+    captures, _, drain = runner.receive_inventory(run, terminal=True)
+    terminal = drain.get('complete')
+    require(terminal is not None and binding['terminal_sha256'] == run['receive_head']['sha256']
+            == r4.digest(r4.encoded(terminal))
+            and run['capture_until'] <= terminal['completed_at'] <= observed.timestamp(),
+            'Exact terminal receipt within original capture required')
+    require(run['request_metadata'] == _outbound(r4, plan), 'Exact outbound source bytes differ')
+    ack_ref = run['sent_api_ack_reference']
+    ack_raw = read_pin(store.root / ack_ref['basename'], ack_ref['sha256'], r4.MAX_JSON)
+    ack = json.loads(ack_raw, object_pairs_hook=r4.unique_object)
+    if ack_ref['representation'] == 'botapi-wire-envelope-json':
+        ack = ack['result']
+    require(ack.get('from', {}).get('id') == r4.TESTER and ack['from'].get('is_bot') is True,
+            'Tester send ACK sender differs')
+    step, = plan['steps']
+    if 'input' in step:
+        source = step['input']
+        require(ack.get('caption') == source['caption'] and
+                r4.valid_input_ack(ack, source, require_document_size=True),
+                'Exact source-carrying ACK differs')
+    else:
+        require(ack.get('text') == step['request'], 'Exact text request ACK differs')
+    require(len(run['observations']) == 1 and run['observations'][0]['kind'] == 'reply_text',
+            'Exactly one committed predecessor text receipt required')
+    row, = run['observations']
+    require(row['receipt_sha256'] == binding['text_receipt_sha256'], 'Exact native text receipt differs')
+    receipt = pin(r4, Path(row['receipt_path']), binding['text_receipt_sha256'], r4.MAX_JSON)
+    event = captures[row['update_id']]
+    message = pin(r4, store.captures / (str(row['update_id']) + '.json'),
+                  event['raw_update']['sha256'], r4.MAX_JSON)['message']
+    require(receipt['text'] == message['text'] and
+            message['reply_to_message']['message_id'] == sent and sent < message['message_id'] and
+            type(message['chat']['id']) is int and message['chat']['id'] == ack['chat']['id'] and
+            message['chat']['type'] == 'private' and
+            run['sent_date'] <= message['date'] <= run['capture_until'] and
+            run['sent_at'] <= event['arrived_at'] < run['capture_until'],
+            'Exact same-chat in-window reply target differs')
+    require(pin(r4, run_path, binding['run_sha256'], r4.MAX_JSON) == run, 'Predecessor run changed during read')
+    return dict(run=run, row=row, text=receipt['text'], ack=ack, terminal=terminal)
+
+
+def settle_native_text(store, role, binding, publication, profile_db, cap, *,
+                       routing_store, routing_db, entry):
+    """Return the compact C06 ingress and exact physical F01 witness for one run."""
+    require(role in ('A', 'B') and type(binding) is dict
+            and binding.get('run_id') == f'c06-context-{role.lower()}'
+            and is_selected_plan((binding.get('scenario_sha256'), binding.get('run_id'))),
+            'Exact source-carrying C06 role and run required')
+    require(type(publication) is PublishedOriginal and type(cap) is UserScope
+            and publication.role == role and publication.run_id == binding['run_id']
+            and publication.scenario_sha256 == binding['scenario_sha256'],
+            'C06 original publication belongs to a different role or run')
+    r4 = load_r4(store)
+    try:
+        evidence = _completed_text(r4, store, binding)
+    except r4.Refused as exc:
+        raise ValueError('C06 protected R4 receipt refused') from exc
+    run, observation = evidence['run'], evidence['row']
+    require(run['deadline'] <= time.time(), 'Original C06 predecessor deadline remains open')
+
+    with authority(cap.home):
+        cap.check()
+        require(revalidate_original(publication, cap, entry=entry) is True,
+                'Original C06 workspace publication unavailable')
+        native, visible = settle_receipt(routing_store, routing_db, profile_db, cap,
+                                         publication, run, evidence['ack'])
+        require(revalidate_original(publication, cap, entry=entry) is True,
+                'C06 workspace publication changed during settlement')
+        cap.check()
+
+    conversation = native['conversation']
+    require(visible == dict(conversation=conversation,
+                            retained_input_sha256=publication.input_sha256,
+                            no_intervening_session_reset=True),
+            'Current C06 conversation no longer holds the exact original source')
+    lineage = dict(owner=str(cap.home), chat=conversation['peer_id'], tester=conversation['tester_id'],
+                   native_conversation=r4.digest(r4.encoded(dict(
+                       conversation=conversation, route_created_at=publication.route_created_at,
+                       transport_profile=publication.principal[1]))),
+                   workspace=str(cap.home / 'workspace'))
+    ingress = dict(role=role, lineage=lineage, native_source_id=publication.file_unique_id,
+                   run_sha256=binding['run_sha256'], run_id=run['id'],
+                   source_sha256=publication.input_sha256, source_bytes=publication.input_size_bytes,
+                   sent_message_id=run['sent_message_id'])
+    return dict(ingress=ingress, native_receipt=native, binding=dict(binding),
+                text_sha256=observation['text_sha256'])
+
+
+def verify_root_grade(proof_dir, trusted_grade_ref, ingress_ref, settlement):
+    """Check an independently Root-pinned semantic record for the exact settled reply.
+
+    The reference comes from the trusted Root selection, outside the native
+    event and the incoming request. The function never creates a grade.
+    """
+    directory = Path(proof_dir)
+    info = directory.lstat()
+    require(directory.is_absolute() and directory.resolve(strict=True) == directory
+            and stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid()
+            and stat.S_IMODE(info.st_mode) == 0o700,
+            'Exact protected C06 proof directory required')
+    grade_path = _reference_path(trusted_grade_ref, directory)
+    ingress_path = _reference_path(ingress_ref, directory)
+    require(grade_path != ingress_path, 'Independent C06 grade must use a distinct named file')
+    ingress = settlement['ingress']
+    require(_private_doc(ingress_ref, read_owned, sized=False, limit=16384)[0] == ingress,
+            'C06 grade references a different original ingress')
+    binding = settlement['binding']
+    grade = _private_doc(trusted_grade_ref, read_owned, sized=False, limit=16384)[0]
+    expected = dict(schema=REVIEW_SCHEMA, role=ingress['role'], verdict='PASS',
+                    lineage=ingress['lineage'], run_sha256=binding['run_sha256'],
+                    ingress=ingress_ref, terminal_sha256=binding['terminal_sha256'],
+                    text_receipt_sha256=binding['text_receipt_sha256'],
+                    text_sha256=settlement['text_sha256'])
+    require(grade == expected, 'Independent C06 semantic PASS differs from the exact terminal receipt')
+    return grade
