+++ b/c06_finalization_custody.py
@@ -0,0 +1,298 @@
+"""Persist and verify the C06 protected Once finalizer response."""
+
+from math import isfinite
+import os
+from pathlib import Path
+import re
+import stat
+import time
+
+
+MATCH_SCHEMA = 'frw.Root.C06.receiver-terminal-match.v1'
+REQUEST_SCHEMA = 'frw.gateway.c06-owned-receiver-control.v1'
+NATIVE_SCHEMA = 'frw.gateway.c06-native-settlement.v1'
+DRIVER_SCHEMA = 'frw.Root.C06.owned-ordinary-driver.v1'
+OPTIONS_SCHEMA = 'frw.Root.C06.receiver-options.v1'
+PHASES = {
+    'c06-context-a': ('A', '0edbaef98d5d04e37dc903ff90c72a037803bc1a4f3b0ef0922030b5e449b337'),
+    'c06-context-b': ('B', 'a3da899789ed331e75c38a51b7c0a63817abe9db4e21c6516676c994519d9146'),
+}
+CLOCK_TIMING = {'outer_seconds': 600, 'operation_seconds': 300, 'ack_seconds': 10,
+                'reply_window_seconds': 180, 'reserve_seconds': 5}
+CONTEXT_FIELDS = {'run_id', 'scenario_sha256'}
+OBSERVATION_FIELDS = {'request', 'response', 'sent_monotonic', 'observed_monotonic',
+                      'gateway', 'deadline_monotonic'}
+MATCH_FIELDS = CONTEXT_FIELDS | OBSERVATION_FIELDS | {
+    'schema', 'state', 'terminal_intent', 'native_terminal', 'caller', 'ack', 'match', 'no_retry',
+}
+REQUEST_FIELDS = {'schema', 'operator', 'action', 'query_id', 'boot_id', 'gateway', 'created_monotonic',
+                  'expires_monotonic', 'arm_intent', 'receiver_options', 'proof'}
+NATIVE_FIELDS = CONTEXT_FIELDS | {'schema', 'intent', 'claim_sha256', 'wire_sha256', 'generation',
+                                 'disposition_revision', 'route', 'observations', 'c06', 'no_retry'}
+SELECTION_FIELDS = {'role', 'sdk_update_id', 'sdk_message_id', 'tester_ack_message_id',
+                    'original_sender_proof_sha256', 'input_sha256', 'input_bytes', 'session_id',
+                    'route_created_at'}
+INTENT_FIELDS = CONTEXT_FIELDS | {'arm', 'clock', 'cutoff', 'run', 'cursor', 'invocation', 'locks', 'no_retry'}
+ROUTE_FIELDS = {'session_key', 'source_profile', 'transport_profile', 'runtime_profile'}
+HEX = re.compile('[a-f0-9]{64}')
+QUERY = re.compile('[a-f0-9]{32}')
+BOOT = re.compile('[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}')
+
+
+def _require(condition, reason):
+    if not condition:
+        raise ValueError(reason)
+
+
+def _fields(value, names):
+    return type(value) is dict and set(value) == names
+
+
+def _hex(value, shape=HEX):
+    return type(value) is str and shape.fullmatch(value) is not None
+
+
+def _integer(value, minimum=1):
+    return type(value) is int and value >= minimum
+
+
+def _monotonic(value):
+    return type(value) in (int, float) and isfinite(value) and value >= 0
+
+
+def _path(value):
+    _require(type(value) is str and '\0' not in value, 'C06_FINALIZATION_PATH_INVALID')
+    path = Path(value)
+    _require(path.is_absolute() and str(path) == value and '..' not in path.parts,
+             'C06_FINALIZATION_PATH_INVALID')
+    return path
+
+
+def _reference(value, name=None, work=None):
+    _require(_fields(value, {'path', 'bytes', 'sha256'}) and _hex(value['sha256'])
+             and _integer(value['bytes']), 'C06_FINALIZATION_REFERENCE_INVALID')
+    path = _path(value['path'])
+    _require((name is None or path.name == name) and (work is None or path.parent == work),
+             'C06_FINALIZATION_REFERENCE_WRONG_FILE')
+    return path
+
+
+def _document(reader, ref, name=None, work=None):
+    _reference(ref, name, work)
+    value = reader(ref)
+    _require(type(value) is dict, 'C06_FINALIZATION_DOCUMENT_INVALID')
+    return value
+
+
+def _same_context(value, context):
+    return value.get('no_retry') is True and all(value.get(key) == item for key, item in context.items())
+
+
+def _process(value):
+    return (_fields(value, {'pid', 'start_time', 'boot_id'}) and _integer(value['pid'])
+            and _integer(value['start_time']) and _hex(value['boot_id'], BOOT))
+
+
+def _clock_deadline(reader, work, context, intent, arm, request, options, observed):
+    clock = _document(reader, intent['clock'], 'clock.json', work)
+    bound = _document(reader, intent['cutoff'], 'receiver-cutoff.json', work)
+    original = _document(reader, bound['intent'], 'receiver-cutoff-intent.json', work)
+    receipt = arm['receipt']
+    cutoff = original.get('receiver_monotonic_cutoff')
+    ack_times = original.get('ack_monotonic')
+    start, outer = clock.get('started_monotonic'), clock.get('deadline_monotonic')
+    armed, arm_end = receipt.get('armed_monotonic'), receipt.get('expires_monotonic')
+    options_end = options.get('observer_expires_monotonic')
+    create, expires = request['created_monotonic'], request['expires_monotonic']
+    sent, received = observed['sent_monotonic'], observed['observed_monotonic']
+    _require(type(ack_times) is list and len(ack_times) == 2
+             and all(_monotonic(value) for value in (
+                 cutoff, *ack_times, start, outer, armed, arm_end, options_end, create, expires, sent, received,
+                 observed['deadline_monotonic']))
+             and _fields(clock, CONTEXT_FIELDS | {'schema', 'status', 'timing', 'old_effects_clocks_preserved',
+                                                  'started_monotonic', 'deadline_monotonic', 'receiver_arm'})
+             and all(clock[key] == value for key, value in context.items())
+             and clock['schema'] == 'frw.Root.F07.finite-operation-clock.v1'
+             and clock['status'] == 'ROOT_BOUND_FUTURE_OPERATION'
+             and clock['old_effects_clocks_preserved'] is True and clock['timing'] == CLOCK_TIMING
+             and clock['receiver_arm'] == intent['arm'] == original.get('arm')
+             and intent['clock'] == original.get('clock')
+             and _fields(bound, CONTEXT_FIELDS | {'intent', 'state', 'no_retry'})
+             and _same_context(bound, context) and bound['state'] == 'RECEIVER_CUTOFF_BOUND'
+             and _fields(original, CONTEXT_FIELDS | {'arm', 'clock', 'ack', 'send_window', 'ack_wall',
+                                                      'ack_monotonic', 'original_wall_cutoff',
+                                                      'receiver_monotonic_cutoff', 'no_retry'})
+             and _same_context(original, context) and _monotonic(original['ack_wall'])
+             and _monotonic(original['original_wall_cutoff'])
+             and original['original_wall_cutoff'] == original['ack_wall'] + CLOCK_TIMING['reply_window_seconds']
+             and armed <= start <= ack_times[0] <= ack_times[1] <= create <= sent <= received < expires
+             and cutoff == ack_times[1] + CLOCK_TIMING['reply_window_seconds'] and cutoff <= received
+             and outer == start + CLOCK_TIMING['outer_seconds'] and arm_end == options_end <= armed + 600
+             and cutoff + 25 <= min(outer, arm_end)
+             and observed['deadline_monotonic'] == expires == min(create + 25, cutoff + 25, outer,
+                                                                  arm_end, options_end),
+             'C06_FINALIZATION_ORIGINAL_CLOCK_CHANGED')
+    return original
+
+
+def _match_chain(row, reader, work, context, run_ref, *, route=None, native_ref=None):
+    role, scenario_sha = PHASES.get(context['run_id'], (None, None))
+    _require(scenario_sha is not None and scenario_sha == context['scenario_sha256']
+             and _fields(row, MATCH_FIELDS) and _same_context(row, context)
+             and row['schema'] == MATCH_SCHEMA and row['state'] == 'RECEIVER_MATCH_RETAINED'
+             and _fields(row['match'], {'message_id', 'platform_update_id'})
+             and all(_integer(value) for value in row['match'].values()), 'C06_FINALIZATION_MATCH_REQUIRED')
+    intent = _document(reader, row['terminal_intent'], 'receiver-terminal-intent.json', work)
+    request = _document(reader, row['request'], 'receiver-control-finalize.json', work)
+    native = _document(reader, row['native_terminal'], 'receiver-terminal-native.json', work)
+    caller = _document(reader, row['caller'], 'consumer-invocation.json', work)
+    _require(_fields(intent, INTENT_FIELDS) and _same_context(intent, context)
+             and intent['run'] == run_ref and intent['invocation'] == row['caller']
+             and _fields(intent['locks'], {'consumer.lock', 'tester-token'})
+             and all(type(item) is dict and bool(item) for item in intent['locks'].values()),
+             'C06_FINALIZATION_TERMINAL_INTENT_CHANGED')
+    _reference(intent['cursor'], 'cursor.json')
+    arm = _document(reader, intent['arm'], 'receiver-arm.json', work)
+    arm_intent = _document(reader, arm['intent'], 'receiver-arm-intent.json', work)
+    claim = _document(reader, arm['claim'], 'claim.json', work)
+    receipt = arm.get('receipt')
+    _require(_fields(arm, CONTEXT_FIELDS | {'parent', 'claim', 'intent', 'receipt', 'no_retry'})
+             and _same_context(arm, context)
+             and _fields(arm_intent, CONTEXT_FIELDS | {'claim', 'parent', 'binding', 'no_retry'})
+             and _same_context(arm_intent, context) and _same_context(claim, context)
+             and arm['claim'] == arm_intent['claim'] and arm['parent'] == arm_intent['parent'] == claim.get('parent')
+             and _process(arm['parent']) and arm_intent['binding'] == claim.get('binding')
+             and _fields(receipt, {'state', 'claim_sha256', 'generation', 'first_offset',
+                                   'armed_monotonic', 'expires_monotonic'})
+             and receipt['state'] == 'ARMED' and receipt['claim_sha256'] == arm['claim']['sha256']
+             and _integer(receipt['generation']) and _integer(receipt['first_offset'], 0),
+             'C06_FINALIZATION_ARM_OR_CLAIM_CHANGED')
+    _require(_fields(caller, {'schema', 'run_id', 'consumer', 'driver_binding', 'clock', 'no_retry'})
+             and caller['schema'] == 'frw.Root.F07.one-ordinary-consumer-invocation.v1'
+             and caller['run_id'] == context['run_id'] and caller['clock'] == intent['clock']
+             and caller['driver_binding'] == arm_intent['binding'] and caller['no_retry'] is True
+             and _process(caller['consumer']), 'C06_FINALIZATION_CALLER_CHANGED')
+    gateway = row['gateway']
+    _require(_fields(gateway, {'pid', 'start_time', 'boot_id', 'uid', 'socket', 'socket_identity'})
+             and _process({key: gateway[key] for key in ('pid', 'start_time', 'boot_id')})
+             and _integer(gateway['uid'], 0) and gateway['uid'] == os.getuid()
+             and type(gateway['socket_identity']) is list and len(gateway['socket_identity']) == 3
+             and _integer(gateway['socket_identity'][0], 0)
+             and all(_integer(item) for item in gateway['socket_identity'][1:])
+             and _path(gateway['socket']).name == 'gateway.sock'
+             and caller['consumer']['boot_id'] == arm['parent']['boot_id'] == gateway['boot_id'],
+             'C06_FINALIZATION_AUTHENTICATED_PEER_REQUIRED')
+    _require(_fields(request, REQUEST_FIELDS) and request['schema'] == REQUEST_SCHEMA
+             and request['operator'] == 'Root' and request['action'] == 'finalize'
+             and _hex(request['query_id'], QUERY) and request['boot_id'] == gateway['boot_id']
+             and _fields(request['gateway'], {'pid', 'start_time'})
+             and _integer(request['gateway']['pid']) and _integer(request['gateway']['start_time'])
+             and request['gateway'] == {key: gateway[key] for key in ('pid', 'start_time')}
+             and request['arm_intent'] == arm['intent'] and request['proof'] == row['terminal_intent'],
+             'C06_FINALIZATION_REQUEST_CHANGED')
+    driver = _document(reader, caller['driver_binding'], work=work.parent)
+    options = _document(reader, request['receiver_options'])
+    directory = work.lstat()
+    identity = dict(device=directory.st_dev, inode=directory.st_ino, uid=directory.st_uid,
+                    mode=stat.S_IMODE(directory.st_mode))
+    principal = options.get('principal')
+    _require(driver.get('schema') == DRIVER_SCHEMA and driver.get('operator') == 'Root'
+             and driver.get('status') == 'ROOT_BOUND_ONE_FUTURE_OPERATION'
+             and driver.get('workdir') == str(work) and driver.get('run_id') == context['run_id']
+             and driver.get('receiver_options') == request['receiver_options']
+             and work.resolve(strict=True) == work and stat.S_ISDIR(directory.st_mode)
+             and identity['mode'] == 0o700 and identity['uid'] == os.getuid()
+             and driver.get('work_identity') in (identity, dict(identity, mode=directory.st_mode))
+             and _fields(options, {'schema', 'principal', 'profile', 'rights', 'observer_expires_monotonic'})
+             and options['schema'] == OPTIONS_SCHEMA and type(principal) is dict
+             and all(type(principal.get(key)) is str and bool(principal[key])
+                     for key in ('user_id', 'account_id', 'transport_profile'))
+             and type(options['profile']) is str and bool(options['profile']),
+             'C06_FINALIZATION_DRIVER_OR_OPTIONS_CHANGED')
+    response = row['response']
+    _require(_fields(response, {'accepted', 'action', 'query_id', 'state', 'receipt'})
+             and response['accepted'] is True and response['action'] == 'finalize'
+             and response['query_id'] == request['query_id'] and response['state'] == 'RECEIVER_CLOSED_RETAINED'
+             and response['receipt'] == row['native_terminal']
+             and (native_ref is None or native_ref == row['native_terminal']),
+             'C06_FINALIZATION_EXACT_POSITIVE_RESPONSE_REQUIRED')
+    _require(_fields(native, NATIVE_FIELDS) and native['schema'] == NATIVE_SCHEMA
+             and _same_context(native, context) and native['intent'] == row['terminal_intent']
+             and native['claim_sha256'] == receipt['claim_sha256']
+             and _integer(native['generation']) and native['generation'] == receipt['generation']
+             and _hex(native['wire_sha256']) and _integer(native['disposition_revision'], 0)
+             and _fields(native['route'], ROUTE_FIELDS)
+             and all(type(part) is str for part in native['route'].values())
+             and native['route']['transport_profile'] == principal['transport_profile']
+             and native['route']['runtime_profile'] == options['profile']
+             and native['route']['session_key'] == f"agent:{options['profile']}:telegram:dm:{principal['user_id']}"
+             and (route is None or route == native['route'])
+             and type(native['observations']) is list and len(native['observations']) == 1
+             and _fields(native['c06'], SELECTION_FIELDS) and native['c06']['role'] == role,
+             'C06_FINALIZATION_NATIVE_RECEIPT_CHANGED')
+    selection = native['c06']
+    _require(all(_integer(selection[key]) for key in ('sdk_update_id', 'sdk_message_id',
+                                                       'tester_ack_message_id', 'input_bytes'))
+             and all(_hex(selection[key]) for key in ('original_sender_proof_sha256', 'input_sha256'))
+             and selection['sdk_message_id'] == row['match']['message_id']
+             and selection['sdk_update_id'] == row['match']['platform_update_id'],
+             'C06_FINALIZATION_MATCH_SELECTION_CHANGED')
+    original = _clock_deadline(reader, work, context, intent, arm, request, options, row)
+    ack = row['ack']
+    _require(type(ack) is dict and ack == original['ack']
+             and ack.get('basename') == f"send-ack-{context['run_id']}-0-1.json"
+             and _hex(ack.get('sha256')) and _integer(ack.get('bytes'))
+             and ack.get('representation') in ('botapi-wire-envelope-json', 'decoded-message-json'),
+             'C06_FINALIZATION_ORIGINAL_SEND_ACK_CHANGED')
+    return caller
+
+
+def record_match(once, observed, terminal_intent_ref, native_ref, ack_ref, match):
+    """Join the consumed socket observation with the successful Once matcher."""
+    _require(_fields(observed, OBSERVATION_FIELDS), 'C06_FINALIZATION_OBSERVATION_REQUIRED')
+    actor, work, context = once.actor, once.work, once.context
+    def read(ref):
+        raw = actor.readref(ref)
+        value = actor.parse(raw)
+        _require(actor.encoded(value) == raw, 'C06_FINALIZATION_CANONICAL_DOCUMENT_REQUIRED')
+        return value
+
+    work_identity = actor.protected_directory(work)[:5]
+    intent = _document(read, terminal_intent_ref, 'receiver-terminal-intent.json', work)
+    run_ref = intent['run']
+    _reference(run_ref, f"{context['run_id']}.json")
+    row = dict(**context, **observed, schema=MATCH_SCHEMA, state='RECEIVER_MATCH_RETAINED',
+               terminal_intent=terminal_intent_ref, native_terminal=native_ref, caller=intent['invocation'],
+               ack=ack_ref, match=match, no_retry=True)
+    caller = _match_chain(row, read, work, context, run_ref, native_ref=native_ref)
+    _require(caller['consumer'] == actor.kernel(os.getpid()), 'C06_FINALIZATION_WRITER_CHANGED')
+    _require(once.receiver_window.revalidate_finalization(observed) is True
+             and time.monotonic() < observed['deadline_monotonic'], 'C06_FINALIZATION_WRITE_DEADLINE')
+    ref = once.record('receiver-terminal-match.json', row)
+    checked = _document(read, ref, 'receiver-terminal-match.json', work)
+    _match_chain(checked, read, work, context, run_ref, native_ref=native_ref)
+    _require(actor.encoded(checked) == actor.encoded(row)
+             and actor.protected_directory(work)[:5] == work_identity
+             and caller['consumer'] == actor.kernel(os.getpid())
+             and once.receiver_window.revalidate_finalization(observed) is True
+             and time.monotonic() < observed['deadline_monotonic'], 'C06_FINALIZATION_READBACK_UNKNOWN')
+    return ref
+
+
+def read_finalization(ended_ref, read_document, *, run_id, scenario_sha256, run_sha256,
+                      route=None, native_ref=None):
+    """Validate the active predecessor with a canonical protected-document reader."""
+    work = _reference(ended_ref, 'consumer-ended.json').parent
+    context = {'run_id': run_id, 'scenario_sha256': scenario_sha256}
+    ended = _document(read_document, ended_ref, 'consumer-ended.json', work)
+    _require(_fields(ended, CONTEXT_FIELDS | {'stage', 'run', 'receiver_match', 'exception_class',
+                                             'no_retry', 'acceptance'})
+             and _same_context(ended, context) and ended['stage'] == 'RECEIVER_FINALIZE'
+             and ended['exception_class'] is None and ended['acceptance'] == 'NOT_ESTABLISHED',
+             'C06_FINALIZATION_SUCCESSFUL_CONSUMER_END_REQUIRED')
+    run_ref = ended['run']
+    _reference(run_ref, f'{run_id}.json')
+    _require(_hex(run_sha256) and run_ref['sha256'] == run_sha256, 'C06_FINALIZATION_HISTORICAL_RUN_CHANGED')
+    row = _document(read_document, ended['receiver_match'], 'receiver-terminal-match.json', work)
+    _match_chain(row, read_document, work, context, run_ref, route=route, native_ref=native_ref)
+    return row['native_terminal']
