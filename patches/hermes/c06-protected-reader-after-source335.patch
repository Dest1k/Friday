+"""C06 original Telegram upload and workspace custody for the protected owner."""
+
+import asyncio
+from dataclasses import dataclass, field, fields
+from datetime import datetime
+from pathlib import Path
+import re
+from time import monotonic as time_monotonic
+from types import SimpleNamespace
+from weakref import ref
+
+from gateway.admitted_ingress import admitted_ingress_with_telegram_payload
+from gateway.ordinary_dm_ingress import OrdinaryDMIngressOutcomes, _ingress
+from gateway.platforms.event import MessageEvent
+from gateway.run_inbound_media import (
+    PublishedXLSXInput, _read_published_input, _verify_published_input,
+    owned_attachment_display_name, owned_attachment_model_path,
+)
+from gateway.s08_document_custody import capture_document
+from gateway.session import SessionEntry, SessionStore
+from gateway.session_identity import identity_of
+from gateway.upload_anchor import AnchorUnavailable, _current_entry
+from hermes_cli.friday_user_scope import UserScope, _CURRENT, _same_scope, authority, current
+
+
+class _Refused(AnchorUnavailable):
+    """A protected observation lacks an exact C06 witness."""
+
+
+@dataclass(frozen=True, slots=True)
+class _Input:
+    role: str
+    scenario: str
+    name: str
+    mime: str
+    sha256: str
+    size: int
+    caption: str
+
+
+_A = _Input(
+    "A", "0edbaef98d5d04e37dc903ff90c72a037803bc1a4f3b0ef0922030b5e449b337",
+    "gorlitsa-handover.docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+    "397bfc889ef7c29281f7e10b299a77ca32fc5a46fd0df966da20dc316e19420d", 1181,
+    "8cb2a85f1232b512b37e4ea3dadcb4e8443e593333449b15b03fd5e603502b03",
+)
+_B = _Input(
+    "B", "a3da899789ed331e75c38a51b7c0a63817abe9db4e21c6516676c994519d9146",
+    "sinyaya-arka-routes.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+    "4580ad7ee8321611907a4ccf6e14698ce910435058b38f49582bee09101f9f54", 1875,
+    "559d60dbe994ff7d097654e75f122d85b7de47a8ee652a35f913a5b774e35a1a",
+)
+_INPUTS = {_A.scenario: _A, _B.scenario: _B}
+_PUBLICATION = "_friday_published_c06_input"
+_SDK_KEYS = ("update_id", "native_message_id", "bot_id", "actor_id", "date",
+             "caption_sha256", "file_id", "file_unique_id", "file_name", "mime_type", "declared_bytes")
+_ROUTE_KEYS = ("session_key", "source_profile", "transport_profile", "runtime_profile")
+_RUN_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}")
+_RECEIVED = re.compile(r"telegram_[a-f0-9]{64}_[A-Za-z0-9_.-]{1,80}\.(?:docx|xlsx)")
+
+
+def _require(condition, reason):
+    if not condition:
+        raise _Refused(reason)
+
+
+@dataclass(frozen=True, slots=True)
+class _Original:
+    ingress: OrdinaryDMIngressOutcomes
+    record: object
+    update: object
+    witness: tuple
+    fixture: _Input
+    run_id: str
+    claim_sha256: str
+    observed_monotonic: float
+
+
+@dataclass(frozen=True, slots=True)
+class _RuntimeOwner:
+    runner: object
+    adapter: object
+    app: object
+    updater: object
+    bot: object
+    generation: int
+    loop: asyncio.AbstractEventLoop
+    poller: asyncio.Task
+
+    def current(self, store):
+        try:
+            adapter = self.adapter
+            return (adapter.gateway_runner is self.runner and self.runner.adapters.get(adapter.platform) is adapter
+                    and self.runner.session_store is store and adapter._app is self.app
+                    and self.app.updater is self.updater and adapter._bot is self.bot and self.updater.bot is self.bot
+                    and adapter._polling_generation == self.generation and not adapter._teardown_started
+                    and adapter._polling_progress_accepting and self.updater.running
+                    and isinstance(self.poller, asyncio.Task) and not self.poller.done()
+                    and self.updater._Updater__polling_task is self.poller
+                    and self.poller.get_loop() is self.loop and not self.loop.is_closed())
+        except (AttributeError, RuntimeError):
+            return False
+
+
+@dataclass(frozen=True, slots=True)
+class _Custody:
+    owner: UserScope
+    store: ref
+    runtime: _RuntimeOwner
+    evidence: PublishedXLSXInput
+    directories: tuple
+    facts: tuple
+
+
+@dataclass(frozen=True, slots=True)
+class PublishedOriginal:
+    principal: tuple
+    profile: str
+    scope: str
+    session_key: str
+    session_id: str
+    route_created_at: str
+    native_message_id: int
+    sdk_date: int
+    caption_sha256: str
+    file_unique_id: str
+    file_name: str
+    mime_type: str
+    input_sha256: str
+    input_size_bytes: int
+    file_identity: tuple
+    relative_path: str
+    scenario_sha256: str
+    role: str
+    run_id: str
+    claim_sha256: str
+    update_id: int
+    file_id: str
+    observed_monotonic: float
+    _custody: _Custody = field(repr=False, compare=False)
+
+
+_FACTS = tuple(member.name for member in fields(PublishedOriginal) if member.name != "_custody")
+
+
+def _sdk(ingress, update, event, fixture):
+    sdk = capture_document(ingress.adapter, update, event, actor=ingress.claim.user_id,
+                           bot_id=ingress.scope["bot_id"], source_bytes=fixture.size)
+    _require((sdk["file_name"], sdk["mime_type"], sdk["caption_sha256"])
+             == (fixture.name, fixture.mime, fixture.caption), "c06_exact_original_caption_and_document")
+    return tuple(sdk[key] for key in _SDK_KEYS)
+
+
+def capture_original(ingress, native_update, event, *, scenario_sha256, run_id):
+    """Capture directly after the protected native builder records this event.
+
+    The protected owner supplies its exact selected scenario and run binding.
+    The stock arm currently has no C06 registration for calling this seam.
+    """
+    fixture = _INPUTS.get(scenario_sha256) if type(scenario_sha256) is str else None
+    _require(fixture is not None and type(run_id) is str and _RUN_ID.fullmatch(run_id)
+             and type(ingress) is OrdinaryDMIngressOutcomes and type(event) is MessageEvent,
+             "c06_exact_owner_and_upload_plan_required")
+    claim = ingress.claim
+    _require(not claim.require_s08_document and claim.selected_s14 is None
+             and claim.selected_d05 is None and claim.selected_d01_rtf is None,
+             "c06_wrong_selected_owner")
+    update_id = ingress._stamp(event)
+    wire = ingress._wire()
+    record = ingress._built.get(update_id)
+    _require(wire is not None and wire["state"] == "OPEN" and type(update_id) is int
+             and tuple(wire["target_update_ids"]) == (update_id,) and record is not None
+             and record.event_ref() is event and record.handoff == "unstarted"
+             and not hasattr(record, "c06_native") and not ingress._held and not ingress._commits,
+             "c06_original_native_dispatch_required")
+    try:
+        witness = _sdk(ingress, native_update, event, fixture)
+    except (AttributeError, TypeError, ValueError):
+        raise _Refused("c06_original_sdk_document_required") from None
+    original = _Original(ingress, record, native_update, witness, fixture, run_id,
+                         claim.claim_sha256, time_monotonic())
+    record.c06_native = original
+    return original
+
+
+def _selected(event):
+    identity = identity_of(event.source)
+    ingress = _ingress(identity.adapter()) if identity is not None else None
+    if type(ingress) is not OrdinaryDMIngressOutcomes:
+        return None
+    update_id = ingress._stamp(event)
+    record = ingress._built.get(update_id)
+    original = getattr(record, "c06_native", None)
+    if (type(original) is not _Original or original.ingress is not ingress
+            or original.record is not record or original.claim_sha256 != ingress.claim.claim_sha256
+            or ingress.select(event, event.source, identity, ingress.scope["session_key"]) != update_id
+            or original.witness != _sdk(ingress, original.update, event, original.fixture)):
+        return None
+    return original
+
+
+def _document_matches(original, message):
+    sdk = dict(zip(_SDK_KEYS, original.witness, strict=True))
+    media = message["media"]
+    if (len(media) != 1 or tuple(message[key] for key in (
+            "platform_update_id", "message_id", "bot_id", "user_id", "chat_id", "thread_id", "reply_to_message_id"))
+            != (sdk["update_id"], sdk["native_message_id"], sdk["bot_id"], sdk["actor_id"],
+                sdk["actor_id"], "", "")):
+        return False
+    item, = media
+    origin = item["origin"]
+    return (item["mime_type"] == sdk["mime_type"]
+            and item["content"] == {"sha256": original.fixture.sha256, "size_bytes": original.fixture.size}
+            and all(origin[key] == message[key] for key in ("bot_id", "chat_id", "thread_id", "message_id"))
+            and all(origin[key] == sdk[key] for key in ("file_id", "file_unique_id", "declared_bytes")))
+
+
+def selected_publication(event, message):
+    """Only the normal rehome writer can call this optional observation seam."""
+    if getattr(event, "_ordinary_dm_ingress_stamp", None) is None:
+        return False
+    try:
+        original = _selected(event)
+        return original is not None and _document_matches(original, message)
+    except (AttributeError, KeyError, RuntimeError, TypeError, ValueError):
+        return False
+
+
+def _route_current(store, entry, cap, session_key):
+    actor = cap.principal[3]
+    route = ("telegram", actor, actor, "dm", None)
+    _require(type(store) is SessionStore and store.sessions_dir == cap.authorization_home / "sessions"
+             and type(entry) is SessionEntry and type(entry.created_at) is datetime
+             and type(entry.session_id) is str and entry.session_id
+             and session_key == f"agent:{cap.profile}:telegram:dm:{actor}"
+             and getattr(entry.platform, "value", None) == "telegram" and entry.chat_type == "dm"
+             and entry.transport_profile == cap.principal[1] and entry.origin is not None
+             and entry.origin.profile == cap.profile and not entry.suspended and not entry.expiry_finalized,
+             "c06_native_route_unavailable")
+    ctx = SimpleNamespace(session_id=entry.session_id, session_key=session_key)
+    _require(_current_entry(store, ctx, cap, route) is entry, "c06_native_route_entry_changed")
+    return entry.session_id, entry.created_at.isoformat()
+
+
+def publish_original(ingress, original, event, *, entry, scenario_sha256):
+    """Bind the original SDK input to the live routed entry and normal published descriptor."""
+    try:
+        cap = current(required=True)
+        _require(type(original) is _Original and original.ingress is ingress
+                 and _selected(event) is original and original.fixture.scenario == scenario_sha256
+                 and not original.record.settled,
+                 "c06_same_original_native_event_required")
+        scope = ingress.scope
+        runner = ingress.adapter.gateway_runner
+        _require(type(cap) is UserScope and runner is not None
+                 and runner.adapters.get(ingress.adapter.platform) is ingress.adapter
+                 and cap.principal == ("telegram", scope["transport_profile"], str(scope["bot_id"]),
+                                       str(ingress.claim.user_id))
+                 and (cap.profile, str(cap.authorization_home), str(cap.home))
+                 == (scope["runtime_profile"], scope["authorization_home"], scope["runtime_home"]),
+                 "c06_same_admitted_owner_required")
+        store = runner.session_store
+        adapter, claim = ingress.adapter, ingress.claim
+        runtime = _RuntimeOwner(runner, adapter, adapter._app, claim.updater, ingress.bot,
+                                claim.generation, claim.loop, claim.updater._Updater__polling_task)
+        _require(runtime.current(store), "c06_original_application_changed")
+        key = scope["session_key"]
+        sid, created = _route_current(store, entry, cap, key)
+        proof, payload = admitted_ingress_with_telegram_payload(event, event.source, key)
+        sdk = dict(zip(_SDK_KEYS, original.witness, strict=True))
+        _require(proof is not None and proof["platform"] == "telegram"
+                 and all(proof[key] == scope[key] for key in _ROUTE_KEYS)
+                 and _document_matches(original, proof["message"])
+                 and payload == {"kind": "caption", "date": sdk["date"], "sha256": sdk["caption_sha256"]},
+                 "c06_same_native_document_and_payload_required")
+        evidence = _read_published_input(event, _PUBLICATION, pin_directories=True)
+        _require(type(evidence) is PublishedXLSXInput, "c06_original_workspace_publication_required")
+        record = getattr(event, _PUBLICATION)
+        directories = record[4]
+        path = str(evidence.path)
+        relative = owned_attachment_model_path(event, path)
+        _require(event.media_urls == [path] and proof["message"]["media"][0]["local_reference"] == path
+                 and relative == "received/" + evidence.path.name and _RECEIVED.fullmatch(evidence.path.name)
+                 and evidence.path.suffix == Path(original.fixture.name).suffix
+                 and owned_attachment_display_name(event, path) == original.fixture.name
+                 and (evidence.sha256, evidence.size_bytes) == (original.fixture.sha256, original.fixture.size)
+                 and _selected(event) is original and getattr(event, _PUBLICATION) is record
+                 and runtime.current(store) and _route_current(store, entry, cap, key) == (sid, created),
+                 "c06_original_workspace_or_route_changed")
+        facts = (cap.principal, cap.profile, str(store.sessions_dir), key, sid, created,
+                 int(sdk["native_message_id"]), sdk["date"], sdk["caption_sha256"], sdk["file_unique_id"],
+                 sdk["file_name"], sdk["mime_type"], evidence.sha256, evidence.size_bytes,
+                 evidence.source_identity, relative, scenario_sha256, original.fixture.role, original.run_id,
+                 original.claim_sha256, int(sdk["update_id"]), sdk["file_id"], original.observed_monotonic)
+        previous = getattr(original.record, "c06_publication", None)
+        if previous is not None:
+            _require(type(previous) is PublishedOriginal and previous._custody.facts == facts
+                     and previous._custody.evidence == evidence and previous._custody.directories == directories,
+                     "c06_original_publication_rebound")
+            revalidate_original(previous, cap, entry=entry)
+            return previous
+        publication = PublishedOriginal(*facts, _Custody(cap, ref(store), runtime, evidence, directories, facts))
+        original.record.c06_publication = publication
+        return publication
+    except _Refused:
+        raise
+    except (AttributeError, KeyError, OSError, TypeError, ValueError):
+        raise _Refused("c06_exact_workspace_publication_unavailable") from None
+
+
+def revalidate_original(publication, cap, *, entry):
+    """Reopen the retained original with the current native owner and route."""
+    _require(type(publication) is PublishedOriginal and type(cap) is UserScope
+             and type(publication._custody) is _Custody, "c06_native_publication_required")
+    retained = publication._custody
+    _require(tuple(getattr(publication, name) for name in _FACTS) == retained.facts
+             and _same_scope(retained.owner, cap) and not retained.owner.revoked
+             and (_CURRENT.get() is None or _CURRENT.get() is cap),
+             "c06_retained_publication_owner_or_facts_changed")
+    store = retained.store()
+    _require(retained.runtime.current(store), "c06_retained_application_changed")
+    expected_route = publication.session_id, publication.route_created_at
+
+    def route_matches():
+        return (retained.runtime.current(store)
+                and _route_current(store, entry, cap, publication.session_key) == expected_route)
+
+    try:
+        with authority(cap.home):
+            _require(route_matches() and _verify_published_input(
+                cap, retained.evidence, still_current=route_matches,
+                expected_directories=retained.directories) and route_matches(),
+                "c06_retained_workspace_descriptor_changed")
+    except _Refused:
+        raise
+    except (AttributeError, OSError, TypeError, ValueError):
+        raise _Refused("c06_retained_workspace_unavailable") from None
+    return True
+
+
+def validate_pair(a, b, cap, *, entry):
+    """Require same live lineage and two distinct, ordered original uploads."""
+    revalidate_original(a, cap, entry=entry)
+    revalidate_original(b, cap, entry=entry)
+    _require((a.role, b.role) == ("A", "B")
+             and (a.principal, a.profile, a.scope, a.session_key, a.session_id, a.route_created_at,
+                  a._custody.directories, a._custody.store())
+             == (b.principal, b.profile, b.scope, b.session_key, b.session_id, b.route_created_at,
+                 b._custody.directories, b._custody.store())
+             and a.update_id < b.update_id and a.native_message_id < b.native_message_id and a.sdk_date < b.sdk_date
+             and a.run_id != b.run_id and a.claim_sha256 != b.claim_sha256
+             and a.file_id != b.file_id and a.file_unique_id != b.file_unique_id
+             and a.relative_path != b.relative_path and a.file_identity[:2] != b.file_identity[:2],
+             "c06_native_original_pair_not_distinct_and_ordered")
+    return True
+
+
+def is_selected_plan(selection):
+    """Recognize only the two existing protected native upload plans."""
+    if (type(selection) is not tuple or len(selection) != 2
+            or not all(type(value) is str for value in selection)):
+        return False
+    scenario_sha256, run_id = selection
+    fixture = _INPUTS.get(scenario_sha256)
+    return fixture is not None and run_id == f"c06-context-{fixture.role.lower()}"
+
+
+def bind_worker_original(ingress, runner, event, session_id, key, generation, update):
+    """Capture the normal workspace publication in its existing admitted turn."""
+    original = _selected(event)
+    record = ingress._built.get(update)
+    state = runner._peek_session_state(key)
+    token = state.turn.lease_tokens.get(generation) if state is not None else None
+    _require(original is not None and type(original) is _Original and original.record is record
+             and original.ingress is ingress and not record.settled
+             and (original.fixture.scenario, original.run_id) == ingress.claim.selected_c06
+             and record.writer_task is not None and record.writer_task() is asyncio.current_task()
+             and not asyncio.current_task().cancelling() and update in ingress._commits
+             and runner is ingress.adapter.gateway_runner and runner._is_session_run_current(key, generation)
+             and state.turn.event is event and token is not None and token.released is False
+             and (token.session_id, token.owner_key, token.generation) == (session_id, key, generation)
+             and token.lease.holder is token and token.lease.lock.locked(),
+             "c06_current_owned_worker_required")
+    cap = current(required=True)
+    actor = cap.principal[3]
+    ctx = SimpleNamespace(session_id=session_id, session_key=key)
+    entry = _current_entry(runner.session_store, ctx, cap, ("telegram", actor, actor, "dm", None))
+    return publish_original(ingress, original, event, entry=entry, scenario_sha256=original.fixture.scenario)
+
+
+def _current_publication(publication):
+    custody = publication._custody
+    store = custody.store()
+    cap = custody.owner
+    actor = cap.principal[3]
+    ctx = SimpleNamespace(session_id=publication.session_id, session_key=publication.session_key)
+    entry = _current_entry(store, ctx, cap, ("telegram", actor, actor, "dm", None))
+    return revalidate_original(publication, cap, entry=entry)
+
+
+def close_original_dispatch(ingress, record, event):
+    """Recheck the original publication and discard the retained raw SDK object."""
+    try:
+        original = _selected(event)
+        publication = getattr(record, "c06_publication", None)
+        if (type(original) is not _Original or original.record is not record
+                or original.ingress is not ingress or type(publication) is not PublishedOriginal
+                or (publication.scenario_sha256, publication.run_id) != ingress.claim.selected_c06
+                or (publication.update_id, publication.claim_sha256)
+                != (ingress._stamp(event), ingress.claim.claim_sha256)
+                or not _current_publication(publication)):
+            return False
+        del record.c06_native
+        return True
+    except (OSError, RuntimeError, ValueError, TypeError, KeyError, AttributeError):
+        return False
+
+
+def settled_publication(arm, *, deadline):
+    """Read the exact publication while the native receiver still owns closure."""
+    ingress = arm.ingress
+    selection = arm.claim.selected_c06
+    _require(type(ingress) is OrdinaryDMIngressOutcomes and ingress.claim is arm.claim
+             and ingress.window is arm.window and ingress.adapter._ordinary_dm_wire_arm is arm
+             and is_selected_plan(selection) and time_monotonic() < deadline <= arm.claim.expires_monotonic,
+             "c06_exact_bounded_native_arm_required")
+    wire = ingress._wire()
+    _require(wire is not None and wire["state"] == "LOCAL_WIRE_CLOSED"
+             and ingress._settlement_state() == "SETTLED" and len(wire["target_update_ids"]) == 1,
+             "c06_exact_settled_native_dispatch_required")
+    update, = wire["target_update_ids"]
+    record = ingress._built[update]
+    publication = getattr(record, "c06_publication", None)
+    _require(type(publication) is PublishedOriginal and not hasattr(record, "c06_native")
+             and record.settled and record.writer_task is None
+             and (publication.scenario_sha256, publication.run_id) == selection
+             and (publication.update_id, publication.claim_sha256) == (update, arm.claim.claim_sha256)
+             and _current_publication(publication) and time_monotonic() < deadline
+             and ingress._wire() == wire and ingress._settlement_state() == "SETTLED",
+             "c06_settled_publication_or_current_owner_changed")
+    return publication
