+"""Detached owner adapter for the existing selected ordinary receiver.
+
+Only the authenticated receiver owner may call the original-event entry point.
+The current path requires the live admitted capability and borrowed handles;
+it never reconstructs either from receipt bytes.
+"""
+from dataclasses import dataclass
+from hashlib import sha256
+from pathlib import Path
+import time
+
+from gateway.run_inbound_media import (
+    d01_rtf_publication_current,
+    verify_published_d01_rtf_input,
+)
+from gateway.s08_document_custody import capture_document
+from gateway.upload_anchor import AnchorUnavailable, _object, _read_snapshot
+from hermes_cli.friday_user_scope import UserScope, authority
+
+from native_reader import read_retained_text_input
+
+
+@dataclass(frozen=True)
+class OriginalUpload:
+    principal: tuple
+    profile: str
+    scope: str
+    session_key: str
+    session_id: str
+    route_created_at: str
+    native_message_id: int
+    sdk_date: int
+    caption_sha256: str
+    file_unique_id: str
+    file_name: str
+    mime_type: str
+    input_sha256: str
+    input_size_bytes: int
+    file_identity: tuple
+    relative_path: str
+    scenario_sha256: str
+
+
+def capture_original_upload(adapter, update, event, entry, publication, scenario_sha256):
+    """Consume the actual SDK event and protected descriptor before owner unwind.
+
+    Use the existing selected receiver's publication contract. Stock D01 is
+    its owner, so no stock F01 event reaches this detached candidate today.
+    """
+    cap = publication.owner
+    item = publication.evidence
+    if type(cap) is not UserScope or not d01_rtf_publication_current(event, publication):
+        raise AnchorUnavailable('original_owned_publication_required')
+    transport, profile, peer, tester = cap.principal
+    sdk = capture_document(adapter, update, event, actor=int(tester), bot_id=int(peer),
+                           source_bytes=item.size_bytes)
+    origin = entry.origin
+    route_key = f'agent:{cap.profile}:telegram:dm:{tester}'
+    if (transport != 'telegram' or origin is None or origin.platform.value != transport
+            or (origin.user_id, origin.chat_id, origin.chat_type, origin.thread_id, origin.profile)
+               != (tester, tester, 'dm', None, cap.profile)
+            or entry.session_key != route_key or entry.transport_profile != profile
+            or event.media_urls != [str(item.path)]
+            or item.path.parent != cap.home / 'workspace' / 'received'):
+        raise AnchorUnavailable('original_owner_route_required')
+    download = event._telegram_media_receipts[str(item.path)]
+    if (download['content'] != {'sha256': item.sha256, 'size_bytes': item.size_bytes}
+            or any(download['origin'].get(key) != sdk[key]
+                   for key in ('bot_id', 'file_id', 'file_unique_id', 'declared_bytes'))
+            or download['origin'].get('chat_id') != sdk['actor_id']
+            or download['origin'].get('message_id') != sdk['native_message_id']
+            or download['presentation'].get('original_filename') != sdk['file_name']
+            or not verify_published_d01_rtf_input(
+                publication, still_current=lambda: d01_rtf_publication_current(event, publication))):
+        raise AnchorUnavailable('original_sdk_publication_changed')
+    return OriginalUpload(cap.principal, cap.profile, str(cap.authorization_home / 'sessions'),
+                          route_key, entry.session_id, entry.created_at.isoformat(),
+                          int(sdk['native_message_id']), sdk['date'], sdk['caption_sha256'],
+                          sdk['file_unique_id'], sdk['file_name'], sdk['mime_type'], item.sha256,
+                          item.size_bytes, item.source_identity,
+                          item.path.relative_to(cap.home / 'workspace').as_posix(), scenario_sha256)
+
+
+def _physical_read(profile_db, upload, cutoff):
+    """Identify one original active USER and one physical own-file read."""
+    deadline = time.monotonic() + 0.3
+    progress = lambda: int(time.monotonic() >= deadline)
+    active = ('active=1 AND compacted=0 AND observed=0 AND _compressed_summary=0 '
+              'AND display_kind IS NULL')
+    sid = upload.session_id
+    with _read_snapshot(profile_db, deadline, progress) as conn:
+        users = conn.execute(
+            f"SELECT id FROM messages WHERE session_id=? AND role='user' AND {active} "
+            "AND platform_message_id=? AND timestamp>=? AND timestamp<? LIMIT 2",
+            (sid, str(upload.native_message_id), upload.sdk_date, cutoff)).fetchall()
+        if len(users) != 1:
+            raise AnchorUnavailable('exact_original_native_user_required')
+        user_id = users[0]['id']
+        next_user = conn.execute(
+            "SELECT id FROM messages WHERE session_id=? AND role='user' AND active=1 "
+            "AND id>? ORDER BY id LIMIT 1", (sid, user_id)).fetchone()
+        rows = conn.execute(
+            f"SELECT id,role,tool_call_id,tool_call_uid,tool_call_uids,content FROM messages "
+            f"WHERE session_id=? AND id>? AND id<? AND {active} AND timestamp>=? AND timestamp<? "
+            "AND (role='assistant' OR (role='tool' AND tool_name='read_file')) "
+            "AND COALESCE(length(CAST(tool_call_uids AS BLOB)),0)<=65536 "
+            "AND COALESCE(length(CAST(content AS BLOB)),0)<=1048576 ORDER BY id LIMIT 65",
+            (sid, user_id, next_user['id'] if next_user is not None else 2**63-1,
+             upload.sdk_date, cutoff)).fetchall()
+    if len(rows) > 64 or time.monotonic() >= deadline:
+        raise AnchorUnavailable('original_read_scan_exceeded')
+    assistants = []
+    found = []
+    for row in rows:
+        if row['role'] == 'assistant':
+            if row['tool_call_uids'] is not None:
+                assistants.append((row['id'], _object(row['tool_call_uids'])))
+            continue
+        answer = _object(row['content'])
+        if (answer.get('success') is not True or answer.get('scope') != 'own_user_workspace'
+                or answer.get('path') != upload.relative_path
+                or answer.get('source_sha256') != upload.input_sha256):
+            continue
+        calls = [id_ for id_, uids in assistants
+                 if row['tool_call_uid'] and uids.get(row['tool_call_id']) == row['tool_call_uid']]
+        if len(calls) != 1:
+            raise AnchorUnavailable('original_read_occurrence_ambiguous')
+        found.append(dict(call_row=calls[0], result_row=row['id'], call_id=row['tool_call_id'],
+                          result_sha256=sha256(row['content'].encode()).hexdigest()))
+    if len(found) != 1:
+        raise AnchorUnavailable('exact_original_read_required')
+    return user_id, found[0]
+
+
+def current_projection(store, routing_db, profile_db, cap, receipt):
+    """Run on the current Gateway owner with its actual admitted UserScope."""
+    if type(cap) is not UserScope:
+        raise AnchorUnavailable('current_user_scope_required')
+    with authority(cap.home):
+        cap.check()
+        value = read_retained_text_input(store, routing_db, profile_db, cap, receipt)
+        cap.check()
+    return dict(conversation=value['conversation'], retained_input_sha256=value['retained_input_sha256'],
+                no_intervening_session_reset=value['route_incarnation_matches'])
+
+
+def settle_receipt(store, routing_db, profile_db, cap, original, previous, ack):
+    """Bind current original physical ingress/read to the already checked R4 ACK.
+
+    The caller must pass the exact R4 custody result, not a supplied HTTP or
+    model payload. No previous-run, Gateway, or Telegram state changes here.
+    """
+    transport, profile, peer, tester = original.principal
+    upload = previous['scenario']['steps'][0]['input']
+    ack_fields = (ack['chat']['id'], ack['from']['id'], ack['date'], ack['document']['file_unique_id'],
+                  ack['document']['file_name'], ack['document']['mime_type'], ack['document']['file_size'],
+                  sha256(b'friday.telegram.payload.v1\x00caption\x00' + ack['caption'].encode()).hexdigest())
+    native_fields = (int(peer), int(tester), original.sdk_date, original.file_unique_id,
+                     original.file_name, original.mime_type, original.input_size_bytes, original.caption_sha256)
+    if (type(cap) is not UserScope or cap.principal != original.principal
+            or transport != 'telegram' or ack_fields != native_fields
+            or ack['message_id'] != previous['sent_message_id']
+            or previous['scenario_sha256'] != original.scenario_sha256
+            or upload['sha256'] != original.input_sha256):
+        raise AnchorUnavailable('exact_independent_ack_original_sdk_join_required')
+    if (Path(profile_db.db_path) != cap.home / 'state.db'
+            or original.profile != cap.profile or original.scope != str(cap.authorization_home / 'sessions')):
+        raise AnchorUnavailable('exact_original_user_store_required')
+    with authority(cap.home):
+        cap.check()
+        user_id, read = _physical_read(profile_db, original, previous['capture_until'])
+    receipt = dict(schema='frw.gateway.ordinary-text-summary-ingress.v1',
+                   native=dict(namespace='native.telegram', message_id=original.native_message_id,
+                               input_row=user_id),
+                   tester_ack=dict(namespace='tester.telegram', message_id=ack['message_id'],
+                                   sha256=previous['sent_api_ack_reference']['sha256']),
+                   conversation=dict(tester_id=int(tester), peer_id=int(peer), platform=transport,
+                                     chat_type='dm', scope=original.scope, profile=original.profile,
+                                     session_key=original.session_key, session_id=original.session_id),
+                   input_sha256=original.input_sha256, input_size_bytes=original.input_size_bytes,
+                   file_name=original.file_name, caption_sha256=original.caption_sha256,
+                   sdk_date=original.sdk_date, file_unique_id=original.file_unique_id,
+                   original_scenario_sha256=original.scenario_sha256, transport_profile=profile,
+                   route_created_at=original.route_created_at, file_identity=list(original.file_identity),
+                   capture_until=previous['capture_until'], read=read)
+    projection = current_projection(store, routing_db, profile_db, cap, receipt)
+    return receipt, projection
