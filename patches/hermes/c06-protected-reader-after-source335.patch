@@ -0,0 +1,47 @@
+"""The versioned active C06 predecessor grant used by the Gateway."""
+
+from c06_finalization_custody import PHASES
+
+from .d02_receiver_control import _hex, require
+
+
+SCHEMA = "frw.c06.active-finalized-predecessor.v2"
+ROLES = {"B": ("A",), "RETURN": ("A", "B")}
+ROW_FIELDS = {"label", "binding", "ingress", "review", "receiver_finalization"}
+BINDING_FIELDS = {"run_id", "run_sha256", "scenario_sha256", "sent_message_id",
+                  "terminal_sha256", "text_receipt_sha256"}
+
+
+def read_predecessors(admission, phase, scenario_sha256, read_grant):
+    require(admission.get("qualification_only") is False and phase in ROLES,
+            "c06_active_predecessor_admission_required")
+    held = admission.get("c06")
+    require(type(held) is dict and set(held) == {"phase", "authority", "predecessors"}
+            and held["phase"] == phase and type(held["predecessors"]) is list,
+            "c06_active_predecessor_grant_required")
+    rows = held["predecessors"]
+    require(all(type(row) is dict and set(row) == ROW_FIELDS
+                and type(row["receiver_finalization"]) is dict
+                and set(row["receiver_finalization"]) == {"path", "bytes", "sha256"} for row in rows)
+            and tuple(row["label"] for row in rows) == ROLES[phase],
+            "c06_active_finalized_predecessor_rows_required")
+    history = admission.get("history")
+    require(type(history) is dict, "c06_active_finalized_history_required")
+    for row in rows:
+        binding, finalization = row["binding"], row["receiver_finalization"]
+        require(type(binding) is dict and set(binding) == BINDING_FIELDS and type(binding["run_id"]) is str
+                and PHASES.get(binding["run_id"]) == (row["label"], binding["scenario_sha256"])
+                and type(binding["sent_message_id"]) is int and binding["sent_message_id"] > 0
+                and all(_hex(binding[key]) for key in ("run_sha256", "terminal_sha256", "text_receipt_sha256"))
+                and type(history.get(binding["run_id"])) is dict
+                and history[binding["run_id"]].get("sha256") == binding["run_sha256"],
+                "c06_active_finalized_history_required")
+        require(type(finalization["path"]) is str and type(finalization["bytes"]) is int
+                and 0 < finalization["bytes"] <= 1024 * 1024 and _hex(finalization["sha256"]),
+                "c06_active_finalized_predecessor_rows_required")
+    grant = read_grant(held["authority"])
+    require(type(grant) is dict and set(grant) == {"schema", "phase", "scenario_sha256", "lineage", "predecessors"}
+            and grant["schema"] == SCHEMA and grant["phase"] == phase
+            and grant["scenario_sha256"] == scenario_sha256 and grant["predecessors"] == rows,
+            "c06_active_finalized_grant_v2_required")
+    return rows, grant["lineage"]
diff --git a/gateway/c06_current_authority.py b/gateway/c06_current_authority.py
new file mode 100644
index 0000000000000000000000000000000000000000..e76894b77ab9c002631892bb2408e3b1dcd1f38a
--- /dev/null
+++ b/gateway/c06_current_authority.py
@@ -0,0 +1,252 @@
+"""Gateway fence for the existing read-only C06 current observer."""
+
+from dataclasses import dataclass, field
+from hashlib import sha256
+import os
+from pathlib import Path
+import stat
+import time
+from types import MappingProxyType
+
+from .c06_active_predecessors import ROLES, read_predecessors
+from .d02_receiver_control import _encode, _held_slot, _hex, _kernel, _now, _private_bytes, require
+
+
+_MODE = 'c06-current'
+_FIELDS = {'mode', 'kind', 'proof_ref', 'contract_ref', 'prepare_ref', 'authority_ref',
+           'run_id', 'stage', 'deadline_monotonic'}
+_STAGES = {'READONLY', 'NEW', 'CURSOR_AUTHORITY', 'PRE_INTENT_REVALIDATION', 'WIRE'}
+_PHASES = {
+    'c06-context-b': ('B', 'a3da899789ed331e75c38a51b7c0a63817abe9db4e21c6516676c994519d9146', ('A',)),
+    'c06-context-return': ('RETURN', '782f3c6f20c5d543169ba7baf956a188e9b4f3bab70d115cea2f02a2c045b5cf', ('A', 'B')),
+}
+_TIMING = dict(operation_seconds=300, reply_window_seconds=180, ack_seconds=10,
+               reserve_seconds=5, outer_seconds=600)
+_DECISIONS = {'eligible_new_effect', 'old_effects_and_clocks_preserved',
+              'profile_chat_and_workspace_checked', 'privacy_and_current_stop_assessed'}
+_METADATA_SHA = '24215d1fca8d59e4109e5934464cf4cfbcf6d2dd48d33b7d44c3fc54377de47f'
+_SCOPE_SCHEMA = 'frw.Root.C06.gateway-current-observer.v1'
+_PRIVATE_LIMIT = 1024 * 1024
+_QUERY_SECONDS = 2
+
+
+@dataclass(frozen=True, slots=True)
+class CurrentOwnerPins:
+    """Exact Root selection supplied by the trusted in-process observer owner."""
+
+    contract_ref: dict
+    prepare_ref: dict
+    authority_ref: dict
+    slot_owner: dict
+
+    def __post_init__(self):
+        for name in ('contract_ref', 'prepare_ref', 'authority_ref', 'slot_owner'):
+            value = getattr(self, name)
+            require(type(value) is dict and all(type(key) is str and type(item) in (str, int)
+                    for key, item in value.items()), 'c06_current_registration_shape')
+            object.__setattr__(self, name, MappingProxyType(value.copy()))
+
+
+@dataclass(frozen=True, slots=True)
+class CurrentOwner:
+    kind: str
+    run_id: str
+    stage: str
+    scenario: dict
+    scope_ref: dict
+    authority_ref: dict
+    scope: dict
+    authority: dict
+    proof: dict
+    prepare: dict
+    contract: dict
+    consumer: dict
+    proof_ref: dict
+    cursor: dict
+    lock_identities: tuple
+    deadline: float = field(compare=False)
+
+
+def _reference_path(reference, root=None, *, limit=_PRIVATE_LIMIT):
+    require(type(reference) is dict and set(reference) == {'path', 'bytes', 'sha256'}
+            and type(reference['path']) is str and type(reference['bytes']) is int
+            and 0 < reference['bytes'] <= limit and _hex(reference['sha256']),
+            'c06_current_private_reference')
+    path = Path(reference['path'])
+    require(path.is_absolute() and str(path) == reference['path'] and '..' not in path.parts
+            and (root is None or path.is_relative_to(root)) and path.resolve(strict=True) == path,
+            'c06_current_private_reference_path')
+    return path
+
+
+def read_current_reference(controller, reference, *, root=None, limit=_PRIVATE_LIMIT):
+    """Read an exact private reference through the existing receiver custody check."""
+    path = _reference_path(reference, root, limit=limit)
+    raw = _private_bytes(path, controller.read_owned, limit)
+    require(len(raw) == reference['bytes'] and sha256(raw).hexdigest() == reference['sha256'],
+            'c06_current_private_reference_changed')
+    return raw
+
+
+def _lock_identity(path):
+    info = path.lstat()
+    return dict(device=info.st_dev, inode=info.st_ino, uid=info.st_uid,
+                mode=stat.S_IMODE(info.st_mode), nlink=info.st_nlink)
+
+
+def _locks(controller, owner, slot_owner):
+    identities = []
+    for path, holder in ((controller.slot, slot_owner), (controller.store / 'consumer.lock', owner),
+                         (controller.store / 'tester-token', owner)):
+        identity = _lock_identity(path)
+        _held_slot(path, identity, holder)
+        identities.append(identity)
+    require(not os.path.lexists(controller.store / 'observer-stop.json'), 'c06_current_observer_stopped')
+    return tuple(identities)
+
+
+def _process_parent(pid):
+    fields = (Path('/proc') / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
+    return int(fields[1])
+
+
+def _operation_end(document, proof, scenario_sha, run_id, stage, now):
+    # Same finite-operation record and 300/180/10/5/600 clock as ordinary_current.
+    if proof['role'] == 'preclock':
+        require(stage == 'READONLY' and proof['clock'] is None and proof['once_invocation'] is None,
+                'c06_current_preclock_readonly_only')
+        return None
+    clock = document(proof['clock'])
+    invocation = document(proof['once_invocation'])
+    start, end = clock['started_monotonic'], clock['deadline_monotonic']
+    require(clock.get('schema') == 'frw.Root.F07.finite-operation-clock.v1'
+            and clock.get('status') == 'ROOT_BOUND_FUTURE_OPERATION'
+            and clock.get('run_id') == run_id and clock.get('scenario_sha256') == scenario_sha
+            and clock.get('timing') == _TIMING and clock.get('old_effects_clocks_preserved') is True
+            and _now(start) and _now(end) and 0 <= start <= now and end == start + _TIMING['outer_seconds'],
+            'c06_current_operation_clock_changed')
+    require(invocation.get('schema') == 'frw.Root.F07.one-ordinary-consumer-invocation.v1'
+            and invocation.get('run_id') == run_id and invocation.get('clock') == proof['clock']
+            and invocation.get('consumer') == proof['lock_owners']['consumer']
+            and invocation.get('no_retry') is True, 'c06_current_once_invocation_changed')
+    return end
+
+
+def _check_admission(authority, gateway, run_id, scenario_sha, wall):
+    actual = authority['gateway']
+    start, end = authority['created_at'], authority['expires_at']
+    require(authority.get('schema') == 'frw.Root.ordinary-independent-history-admission.v1'
+            and authority.get('operator') == 'Root' and authority.get('accepted') is True
+            and authority.get('run_scenarios') == {run_id: scenario_sha}
+            and type(authority.get('history')) is dict and bool(authority['history'])
+            and run_id not in authority['history']
+            and authority.get('new_independent_inputs_only') is True and authority.get('no_old_task_replay') is True
+            and all(authority.get(key) is False for key in ('new_trial_for_historical_task',
+                    'old_rows_modified', 'unknown_effects_resolved', 'product_or_B00_acceptance'))
+            and authority['boot_id'] == gateway['boot_id'] and type(actual['pid']) is int
+            and actual['pid'] == gateway['pid'] and str(actual['start_time']) == str(gateway['start_time'])
+            and _now(start) and _now(end) and start <= wall < end,
+            'c06_current_exact_separate_admission_required')
+
+
+def verify_current_owner(controller, *, params, peer, contract_observer_sha256, authority_root,
+                         socket_path, owner_pins, expected=None):
+    """Join the trusted Root selection, actual socket peer and its current named locks."""
+    mono, wall = time.monotonic(), time.time()
+    require(type(params) is dict and set(params) == _FIELDS and params['mode'] == _MODE
+            and params['kind'] in ('check', 'projection') and type(params['stage']) is str
+            and params['stage'] in _STAGES and type(params['run_id']) is str and params['run_id'] in _PHASES,
+            'c06_current_exact_parameters')
+    deadline = params['deadline_monotonic']
+    require(_now(deadline) and mono < deadline <= mono + _QUERY_SECONDS, 'c06_current_query_deadline')
+    require(type(peer) is tuple and len(peer) == 3 and all(type(value) is int for value in peer)
+            and peer[0] > 0 and peer[1] == os.getuid(), 'c06_current_kernel_socket_peer_required')
+    require(type(owner_pins) is CurrentOwnerPins
+            and params['contract_ref'] == owner_pins.contract_ref and params['prepare_ref'] == owner_pins.prepare_ref
+            and params['authority_ref'] == owner_pins.authority_ref and _hex(contract_observer_sha256),
+            'c06_current_exact_registered_owner_required')
+    root = Path(authority_root)
+    info = root.lstat()
+    require(root.is_absolute() and root.resolve(strict=True) == root and stat.S_ISDIR(info.st_mode)
+            and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) == 0o700
+            and all(not root.is_relative_to(base) and not base.is_relative_to(root)
+                    for base in (controller.home, controller.store)),
+            'c06_current_protected_root_required')
+    run_id, stage = params['run_id'], params['stage']
+    phase, scenario_sha, predecessors = _PHASES[run_id]
+    proof_ref, contract_ref, prepare_ref, authority_ref = (params[key] for key in
+            ('proof_ref', 'contract_ref', 'prepare_ref', 'authority_ref'))
+
+    def document(reference):
+        _reference_path(reference, root)
+        return controller.doc(reference, limit=_PRIVATE_LIMIT)[0]
+
+    owner = _kernel(peer[0])
+    slot_owner = dict(owner_pins.slot_owner)
+    lock_identities = _locks(controller, owner, slot_owner)
+    proof, contract, prepare, authority = map(document, (proof_ref, contract_ref, prepare_ref, authority_ref))
+    for item, schema in ((proof, 'frw.Root.ordinary-current-proof.v1'),
+                         (contract, 'frw.Root.ordinary-current-contract.v1'),
+                         (prepare, 'frw.Root.ordinary-current-prepare.v1')):
+        require(item.get('schema') == schema and item.get('run_id') == run_id
+                and item.get('scenario_sha256') == scenario_sha, 'c06_current_run_scenario_changed')
+    require(proof['contract'] == contract_ref and proof['prepare'] == prepare_ref
+            and contract['authority'] == authority_ref and contract['operator'] == 'Root'
+            and type(contract['decisions']) is dict and all(contract['decisions'].get(k) is True for k in _DECISIONS)
+            and Path(contract['cursor']['path']) == controller.store / 'cursor.json',
+            'c06_current_contract_changed')
+    cursor_ref = contract['cursor']
+    _reference_path(cursor_ref, controller.store)
+    cursor = controller.doc(cursor_ref, name='cursor.json', limit=_PRIVATE_LIMIT)[0]
+    require(type(cursor.get('offset')) is int and cursor['offset'] >= 0, 'c06_current_cursor_changed')
+    require(prepare['timing'] == _TIMING and prepare['metadata_helper']['sha256'] == _METADATA_SHA
+            and prepare['current_observer']['sha256'] == contract_observer_sha256
+            and prepare['c06_scenario']['sha256'] == scenario_sha, 'c06_current_prepare_changed')
+    _reference_path(prepare['metadata_helper'])
+    read_current_reference(controller, prepare['current_observer'])
+    scenario = document(prepare['c06_scenario'])
+    require(scenario['deadline_seconds'] == _TIMING['operation_seconds'] and len(scenario['steps']) == 1
+            and scenario['steps'][0]['observe']['window_seconds'] == _TIMING['reply_window_seconds']
+            and sha256(_encode(scenario)).hexdigest() == scenario_sha, 'c06_current_exact_scenario_changed')
+
+    scope_ref = contract['scope']
+    scope = document(scope_ref)
+    gateway = dict(_kernel(os.getpid()), uid=os.getuid(), socket=str(socket_path))
+    require(set(scope) == {'schema', 'operator', 'run_id', 'scenario_sha256', 'authority', 'gateway', 'expires_monotonic'}
+            and scope['schema'] == _SCOPE_SCHEMA and scope['operator'] == 'Root'
+            and scope['run_id'] == run_id and scope['scenario_sha256'] == scenario_sha
+            and scope['authority'] == authority_ref and scope['gateway'] == gateway
+            and _now(scope['expires_monotonic']) and mono < scope['expires_monotonic'],
+            'c06_current_exact_gateway_scope_required')
+    _check_admission(authority, gateway, run_id, scenario_sha, wall)
+
+    require(predecessors == ROLES[phase], 'c06_current_exact_predecessor_set_required')
+    read_predecessors(authority, phase, scenario_sha, controller.read_predecessor_grant)
+
+    expected_locks = {'slot': slot_owner, 'consumer': owner, 'credential': owner}
+    role = proof['role']
+    require(role in ('preclock', 'owned_consumer') and proof['boot_id'] == owner['boot_id']
+            and proof['lock_owners'] == expected_locks and (slot_owner == owner if role == 'preclock'
+                else slot_owner['pid'] == _process_parent(owner['pid'])), 'c06_current_peer_owner_changed')
+    start_wall, end_wall, start_mono, end_mono = (proof[key] for key in
+            ('created_at', 'expires_at', 'created_monotonic', 'expires_monotonic'))
+    require(all(_now(value) for value in (start_wall, end_wall, start_mono, end_mono))
+            and 0 <= start_wall <= wall < end_wall <= start_wall + 120
+            and 0 <= start_mono <= mono < end_mono <= start_mono + 120, 'c06_current_proof_expired')
+    end = _operation_end(document, proof, scenario_sha, run_id, stage, mono)
+    deadline = min(deadline, scope['expires_monotonic'], end_mono,
+                   mono + min(end_wall, authority['expires_at']) - wall)
+    if end is not None:
+        required_time = (_TIMING['operation_seconds'] if stage in {'NEW', 'READONLY'} else
+                         _TIMING['reply_window_seconds'] + _TIMING['ack_seconds']) + _TIMING['reserve_seconds']
+        deadline = min(deadline, end - required_time)
+    require(_locks(controller, owner, slot_owner) == lock_identities, 'c06_current_lock_identity_changed')
+    require(time.monotonic() < deadline and time.time() < min(end_wall, authority['expires_at']),
+            'c06_current_bounded_window_expired')
+    require(role == 'preclock' or slot_owner['pid'] == _process_parent(owner['pid']),
+            'c06_current_peer_parent_changed')
+    result = CurrentOwner(params['kind'], run_id, stage, scenario, scope_ref, authority_ref, scope,
+                          authority, proof, prepare, contract, owner, proof_ref, cursor, lock_identities, deadline)
+    require(expected is None or (result == expected and time.monotonic() < expected.deadline),
+            'c06_current_owner_changed_during_query')
+    return result
diff --git a/gateway/c06_current_provider.py b/gateway/c06_current_provider.py
new file mode 100644
index 0000000000000000000000000000000000000000..86957e492393fa89ad088eaec6f34613e2e6c1f7
--- /dev/null
+++ b/gateway/c06_current_provider.py
@@ -0,0 +1,202 @@
+"""One process-owned C06 receiver sink and existing read-only control mode."""
+
+import asyncio
+import concurrent.futures
+from math import isfinite
+from collections.abc import Mapping
+from contextlib import contextmanager
+from pathlib import Path
+import os
+import stat
+import time
+from types import MappingProxyType
+
+from c06_ingress import PublishedOriginal, validate_pair
+from c06_owner_projection import BorrowedOwner, encoded, lineage_for, phase_for
+from .c06_active_predecessors import read_predecessors
+from .c06_current_authority import CurrentOwnerPins, read_current_reference, verify_current_owner
+from .c06_receiver_control import RetiredPublication
+from .d02_receiver_control import _kernel, _private_doc, require
+from .session import SessionStore
+
+_C06_RUNS = frozenset({"c06-context-b", "c06-context-return"})
+
+
+class C06NativeOwner:
+    """Keep only the two exact retired originals in the existing Gateway process."""
+
+    def __init__(self, runner, loop, *, authority_root, socket_path, contract_observer_sha256,
+                 r4_store, slot, read_owned, owner_pins):
+        require(type(runner.session_store) is SessionStore, "c06_exact_native_session_store_required")
+        if isinstance(owner_pins, Mapping):
+            require(set(owner_pins) <= _C06_RUNS
+                    and all(type(pin) is CurrentOwnerPins for pin in owner_pins.values()),
+                    "c06_exact_registered_root_pins_required")
+            owner_pins = MappingProxyType(dict(owner_pins)).get
+        require(callable(owner_pins), "c06_exact_registered_root_pins_required")
+        self.runner = runner
+        self.loop = loop
+        self.home = Path(runner.session_store._routing_home)
+        self.slot = Path(slot)
+        self.store = Path(r4_store.root)
+        self.r4_store = r4_store
+        self.read_owned = read_owned
+        self.authority_root = Path(authority_root)
+        self.socket_path = Path(socket_path)
+        self.contract_observer_sha256 = contract_observer_sha256
+        self._pins_for = owner_pins
+        self._retired = ()
+
+    def doc(self, reference, **options):
+        return _private_doc(reference, self.read_owned, **options)
+
+    def _native(self, handoff):
+        require(asyncio.get_running_loop() is self.loop and type(handoff) is RetiredPublication,
+                "c06_actual_native_gateway_loop_required")
+        original = handoff._publication
+        store = self.runner.session_store
+        require(type(original) is PublishedOriginal and original._custody.runtime.runner is self.runner
+                and original._custody.store() is store,
+                "c06_retired_original_owner_changed")
+        cap = original._custody.owner
+        with store._lock:
+            entry = store._entries.get(original.session_key)
+        require(entry is not None and entry.session_id == original.session_id
+                and handoff.borrow(cap, entry=entry) is original,
+                "c06_retired_original_current_route_required")
+        return store, cap, entry, original
+
+    @contextmanager
+    def accept_retained(self, handoff, *, deadline_monotonic):
+        """Expose the retired original only after the receiver confirms it synchronously."""
+        require(type(deadline_monotonic) in (int, float) and isfinite(deadline_monotonic),
+                "c06_exact_retired_handoff_deadline_required")
+        if time.monotonic() >= deadline_monotonic:
+            raise TimeoutError("c06_retired_handoff_deadline_expired")
+        _, cap, entry, original = self._native(handoff)
+        retained = self._retired
+        if not retained:
+            require(original.role == "A", "c06_A_must_be_retained_first")
+        else:
+            require(len(retained) == 1 and original.role == "B",
+                    "c06_exact_original_B_may_be_retained_once")
+            _, _, a_entry, a = self._native(retained[0])
+            require(a_entry is entry and validate_pair(a, original, cap, entry=entry) is True,
+                    "c06_ordered_distinct_retired_originals_required")
+        selected = (*retained, handoff)
+        if time.monotonic() >= deadline_monotonic:
+            raise TimeoutError("c06_retired_handoff_deadline_expired")
+        # The receiver checks its deadline inside the same synchronous gateway-loop turn.
+        # Keep the prior tuple visible until that check has succeeded.
+        yield
+        require(self._retired is retained, "c06_retired_owner_changed_during_confirmation")
+        if time.monotonic() >= deadline_monotonic:
+            raise TimeoutError("c06_retired_handoff_deadline_expired")
+        self._retired = selected
+
+    def read_predecessor_grant(self, reference):
+        root = self.authority_root
+        info = root.lstat()
+        path = Path(reference["path"])
+        require(root.is_absolute() and root.resolve(strict=True) == root and stat.S_ISDIR(info.st_mode)
+                and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) == 0o700
+                and all(not root.is_relative_to(base) and not base.is_relative_to(root)
+                        for base in (self.home, self.store))
+                and path.is_relative_to(root), "c06_current_protected_grant_root_required")
+        return self.doc(reference, sized=False, limit=1024 * 1024)[0]
+
+    def require_predecessor(self, admission, scenario_sha, *, options):
+        rows, lineage = read_predecessors(admission, "B", scenario_sha, self.read_predecessor_grant)
+        row, = rows
+        retained = self._retired
+        require(retained and retained[0].role == row["label"] == "A",
+                "c06_armed_B_requires_retained_A")
+        handoff = retained[0]
+        _, cap, entry, original = self._native(handoff)
+        principal = options["principal"]
+        require(original.principal == ("telegram", principal["transport_profile"],
+                                      principal["account_id"], principal["user_id"])
+                and original.profile == options["profile"]
+                and lineage_for(cap, entry) == lineage, "c06_armed_B_predecessor_scope_changed")
+        handoff.require_finalization(row, lambda ref: self.doc(ref, limit=1024 * 1024)[0])
+        require(self._retired is retained and self._native(handoff)[-1] is original,
+                "c06_armed_B_predecessor_changed")
+
+    def _borrowed(self, query):
+        _, _, needed = phase_for(query.run_id, query.scenario)
+        handles = self._retired[:len(needed)]
+        require(tuple(item.role for item in handles) == needed,
+                "c06_exact_original_receivers_not_retained")
+        store, cap, entry, _ = self._native(handles[0])
+        with store._db_handles_lock:
+            route_db = store._db_handles.get(cap.authorization_home / "state.db")
+            profile_db = store._db_handles.get(cap.home / "state.db")
+        return BorrowedOwner(store, route_db, profile_db, self.r4_store, cap, entry, (),
+                             encoded(query.scope_ref), query.scope["gateway"]["boot_id"],
+                             retired_publications=handles)
+
+    def _verify(self, params, peer, *, expected=None):
+        run_id = params.get("run_id") if type(params) is dict else None
+        require(type(run_id) is str and run_id in _C06_RUNS, "c06_exact_current_phase_unbound")
+        pins = self._pins_for(run_id)
+        require(type(pins) is CurrentOwnerPins, "c06_exact_current_phase_unbound")
+        return verify_current_owner(
+            self, params=params, peer=peer, contract_observer_sha256=self.contract_observer_sha256,
+            authority_root=self.authority_root, socket_path=self.socket_path,
+            owner_pins=pins, expected=expected,
+        )
+
+    @staticmethod
+    def _no_remote_code(*args, **kwargs):
+        raise ValueError("c06_remote_provider_code_is_fixed")
+
+    async def _project(self, query):
+        require(time.monotonic() < query.deadline, "c06_current_projection_expired")
+        owner = self._borrowed(query)
+
+        def read(reference):
+            return read_current_reference(self, reference)
+
+        if query.kind == "check":
+            phase, scenario_sha, needed = phase_for(query.run_id, query.scenario)
+            rows, lineage = read_predecessors(query.authority, phase, scenario_sha, self.read_predecessor_grant)
+            require(owner.check_current(query.scope_ref, scenario=query.scenario, read_reference=read,
+                                        load_module=self._no_remote_code) is True
+                    and lineage_for(owner.cap, owner.entry) == lineage,
+                    "c06_current_route_unavailable")
+
+            def in_time():
+                require(time.monotonic() < query.deadline, "c06_current_projection_expired")
+
+            owner.require_finalizations(rows, needed, read_reference=read, in_time=in_time)
+            projection = None
+        else:
+            projection = owner.c06_current_projection(
+                query.scope_ref, scenario=query.scenario, run_id=query.run_id, stage=query.stage,
+                authority_ref=query.authority_ref, read_reference=read, read_grant=self.read_predecessor_grant,
+                load_module=self._no_remote_code,
+                deadline_monotonic=query.deadline,
+            )
+        require(time.monotonic() < query.deadline, "c06_current_projection_expired")
+        return projection
+
+    def handle(self, params, *, peer):
+        """Called from the existing GatewayControlServer executor with kernel peer credentials."""
+        pending = None
+        try:
+            query = self._verify(params, peer)
+            pending = asyncio.run_coroutine_threadsafe(self._project(query), self.loop)
+            projection = pending.result(timeout=max(0, query.deadline - time.monotonic()))
+            fresh = self._verify(params, peer, expected=query)
+            observed = time.monotonic()
+            require(observed < min(query.deadline, fresh.deadline),
+                    "c06_current_projection_expired")
+            return {"accepted": True, "identity": _kernel(query.scope["gateway"]["pid"]),
+                    "observed_monotonic": observed, "read_only": True, "projection": projection}
+        except concurrent.futures.TimeoutError:
+            if pending is not None:
+                pending.cancel()
+            return {"accepted": False, "error": "c06_current_projection_unknown"}
+        except (OSError, RuntimeError, ValueError, TypeError, KeyError, IndexError, AttributeError,
+                concurrent.futures.CancelledError):
+            return {"accepted": False, "error": "c06_current_projection_refused"}
diff --git a/gateway/c06_receiver_control.py b/gateway/c06_receiver_control.py
new file mode 100644
index 0000000000000000000000000000000000000000..b99cea536deb5ce9f21d414a89f1ac98c1405598
--- /dev/null
+++ b/gateway/c06_receiver_control.py
@@ -0,0 +1,276 @@
+"""C06 selection for the existing bounded owner receiver."""
+
+from dataclasses import dataclass, field
+from datetime import datetime
+from functools import partial
+from hashlib import sha256
+from inspect import iscoroutinefunction
+import time
+
+from c06_ingress import (
+    PublishedOriginal, _INPUTS, _current_publication, is_selected_plan,
+    revalidate_original, settled_publication,
+)
+from c06_finalization_custody import read_finalization
+
+from .d02_receiver_control import (
+    ReceiverControl, _encode, _now, _ordinary_receiver_verb, _private_doc, require,
+)
+
+_BINDING_SCHEMA = "frw.gateway.c06-native-settlement.v1"
+_CURRENT_CONTRACT = "frw.Root.ordinary-current-contract.v1"
+_MAX_RECEIPT = 1024 * 1024
+_ROUTE = ("session_key", "source_profile", "transport_profile", "runtime_profile")
+_ACK_FIELDS = ("date", "caption_sha256", "file_unique_id", "file_name", "mime_type", "declared_bytes")
+
+
+@dataclass(frozen=True, slots=True)
+class _Cutoff:
+    selection: tuple
+    sender: tuple
+    started: float
+    completed: float
+    cutoff: float
+    provenance: str
+
+
+def _bound_cutoff(cutoff, verified, scenario):
+    run = verified["run"]
+    selection = (run["scenario_sha256"], run["id"])
+    require(is_selected_plan(selection) and run["scenario"] == scenario,
+            "c06_exact_original_selection_required")
+    fixture = _INPUTS[selection[0]]
+    sender = ReceiverControl._ordinary_document_ack(run, verified["ack"], scenario,
+                                                     "c06_original_document_ack_required")
+    before, after = verified["ack_monotonic"]
+    created = datetime.fromisoformat(run["created_at"])
+    require(created.utcoffset() is not None and scenario["deadline_seconds"] == 300
+            and scenario["steps"][0]["observe"]["window_seconds"] == 180
+            and abs(run["deadline"] - created.timestamp() - 300) <= 1
+            and cutoff == after + 180 and before <= after
+            and type(sender["date"]) is int and sender["date"] == run["sent_date"]
+            and sender["caption_sha256"] == fixture.caption,
+            "c06_original_300_180_clock_or_ack_changed")
+    proof = {"ack": run["sent_api_ack_reference"], "task": run["sent_task_reference"],
+             "window": run["sent_window_reference"], "clock": verified["original_clock"],
+             "sent_message_id": run["sent_message_id"], "wall_cutoff": run["capture_until"],
+             "ordinary_authority_sha256": run.get("ordinary_c06_authority_sha256")}
+    return _Cutoff(selection, tuple(sender[key] for key in _ACK_FIELDS), before, after, cutoff,
+                   sha256(_encode(proof)).hexdigest())
+
+
+@dataclass(frozen=True, slots=True)
+class RetiredPublication:
+    """Process-local handle with a fresh check of the exact protected receipt."""
+
+    _publication: PublishedOriginal = field(repr=False)
+    _reference: tuple = field(repr=False)
+    _evidence_bytes: bytes = field(repr=False)
+    _read_owned: object = field(repr=False, compare=False)
+
+    @property
+    def role(self):
+        return self._publication.role
+
+    def _check_receipt(self):
+        reference = dict(zip(("path", "bytes", "sha256"), self._reference, strict=True))
+        value, _ = _private_doc(reference, self._read_owned, name="receiver-terminal-native.json",
+                                limit=_MAX_RECEIPT)
+        original = self._publication
+        native = value["c06"]
+        route = value["route"]
+        require(_encode(value) == self._evidence_bytes and value.get("schema") == _BINDING_SCHEMA
+                and type(original) is PublishedOriginal
+                and (value["run_id"], value["scenario_sha256"], value["claim_sha256"], value["generation"])
+                == (original.run_id, original.scenario_sha256, original.claim_sha256,
+                    original._custody.runtime.generation)
+                and (route["session_key"], route["transport_profile"], route["runtime_profile"])
+                == (original.session_key, original.principal[1], original.profile)
+                and (native["role"], native["sdk_update_id"], native["sdk_message_id"],
+                     native["input_sha256"], native["input_bytes"], native["session_id"], native["route_created_at"])
+                == (original.role, original.update_id, original.native_message_id, original.input_sha256,
+                    original.input_size_bytes, original.session_id, original.route_created_at),
+                "c06_retired_receiver_receipt_changed")
+        return value
+
+    def require_finalization(self, row, read_document):
+        original = self._publication
+        binding = row["binding"]
+        value = self._check_receipt()
+        reference = dict(zip(("path", "bytes", "sha256"), self._reference, strict=True))
+        require(binding["run_id"] == original.run_id
+                and binding["scenario_sha256"] == original.scenario_sha256
+                and binding["sent_message_id"] == value["c06"]["tester_ack_message_id"],
+                "c06_confirmed_finalization_predecessor_changed")
+        result = read_finalization(row["receiver_finalization"], read_document, run_id=original.run_id,
+                                   scenario_sha256=original.scenario_sha256, run_sha256=binding["run_sha256"],
+                                   route=value["route"], native_ref=reference)
+        require(result == reference and self._check_receipt() == value,
+                "c06_confirmed_finalization_predecessor_changed")
+
+    def borrow(self, cap, *, entry):
+        self._check_receipt()
+        original = self._publication
+        require(revalidate_original(original, cap, entry=entry) is True,
+                "c06_retired_native_publication_changed")
+        self._check_receipt()
+        return original
+
+
+class C06ReceiverControl(ReceiverControl):
+    """Use the shared owner, original cutoff, private write and retirement."""
+
+    request_schema = "frw.gateway.c06-owned-receiver-control.v1"
+    options_schema = "frw.Root.C06.receiver-options.v1"
+    driver_schema = "frw.Root.C06.owned-ordinary-driver.v1"
+    exact_phases = frozenset(_INPUTS)
+    terminal_schema = _BINDING_SCHEMA
+    strict_terminal_extra = True
+
+    def __init__(self, *, accept_retained, require_predecessor, **kwargs):
+        require(callable(accept_retained) and not iscoroutinefunction(accept_retained)
+                and not iscoroutinefunction(getattr(accept_retained, "__call__", None)),
+                "c06_existing_native_observer_owner_required")
+        require(callable(require_predecessor) and not iscoroutinefunction(require_predecessor),
+                "c06_existing_native_predecessor_owner_required")
+        self._require_predecessor = require_predecessor
+        super().__init__(**kwargs)
+        self._accept_retained = accept_retained
+
+    def _owner(self, request):
+        owner = super()._owner(request)
+        intent, driver, options, scenario, _ = owner
+        run, scenario_sha = intent["run_id"], intent["scenario_sha256"]
+        self._wire_options(intent)
+        authority, _ = self.doc(driver["authority"], limit=_MAX_RECEIPT)
+        contract, _ = self.doc(driver["contract"])
+        gateway = authority["gateway"]
+        created, expires = authority["created_at"], authority["expires_at"]
+        require(contract.get("schema") == _CURRENT_CONTRACT and contract.get("operator") == "Root"
+                and contract.get("run_id") == run and contract.get("scenario_sha256") == scenario_sha
+                and contract.get("authority") == driver["authority"]
+                and authority["boot_id"] == request["boot_id"]
+                and {key: gateway[key] for key in ("pid", "start_time")} == request["gateway"]
+                and _now(created) and _now(expires) and created < expires
+                and created <= time.time() and (request["action"] != "arm" or time.time() < expires)
+                and scenario["deadline_seconds"] == 300 and len(scenario["steps"]) == 1
+                and scenario["steps"][0]["observe"]["window_seconds"] == 180,
+                "c06_exact_protected_current_owner_or_clock_required")
+        selected = _INPUTS[scenario_sha]
+        if selected.role == "A":
+            require(authority.get("c06") is None, "c06_A_and_B_require_separate_admissions")
+        else:
+            self._require_predecessor(authority, scenario_sha, options=options)
+        return owner
+
+    def _wire_options(self, intent):
+        selection = (intent["scenario_sha256"], intent["run_id"])
+        require(is_selected_plan(selection), "c06_exact_separately_selected_original_required")
+        return {"selected_c06": selection}
+
+    def _original_cutoff(self, reference, intent, work, scenario, receipt, *, terminal_run=None, verified=None):
+        captured = {}
+        cutoff = super()._original_cutoff(reference, intent, work, scenario, receipt,
+                                          terminal_run=terminal_run, verified=captured)
+        if _INPUTS[intent["scenario_sha256"]].role == "B":
+            driver, _ = self.doc(intent["binding"])
+            require(captured["run"].get("ordinary_c06_authority_sha256") == driver["authority"]["sha256"],
+                    "c06_B_sender_differs_from_original_receiver_grant")
+        if verified is not None:
+            verified.update(captured)
+        return cutoff
+
+    def _bind_terminal_cutoff(self, arm, window, cutoff, verified):
+        bound = _bound_cutoff(cutoff, verified, verified["run"]["scenario"])
+        ingress = arm.ingress
+        wire = ingress._wire()
+        require(arm.claim.selected_c06 == bound.selection
+                and arm.window is window is ingress.window and window._cutoff is None
+                and getattr(ingress, "_c06_cutoff", None) is None
+                and wire is not None and wire["state"] == "OPEN" and time.monotonic() < cutoff,
+                "c06_exact_open_original_cutoff_required")
+        window.bind_cutoff(cutoff)
+        ingress._c06_cutoff = bound
+
+    def _terminal_extra(self, arm, route, scenario, joined, verified, deadline):
+        publication = settled_publication(arm, deadline=deadline)
+        ingress = arm.ingress
+        wire = ingress._wire()
+        bound = getattr(ingress, "_c06_cutoff", None)
+        require(bound is not None and bound == _bound_cutoff(arm.window._cutoff, verified, scenario)
+                and wire is not None and wire["empty_boundary"][0] >= bound.cutoff
+                and bound.started <= publication.observed_monotonic < bound.cutoff
+                and len(joined["observations"]) == 1,
+                "c06_exact_original_ACK_and_closed_native_window_required")
+        observed = (publication.sdk_date, publication.caption_sha256, publication.file_unique_id,
+                    publication.file_name, publication.mime_type, publication.input_size_bytes)
+        require(observed == bound.sender, "c06_original_ACK_and_SDK_document_mismatch")
+        (receipt, caption), = joined["observations"]
+        message = receipt["message"]
+        (media,) = message["media"]
+        origin = media["origin"]
+        ids = {
+            "platform_update_id": str(publication.update_id),
+            "message_id": str(publication.native_message_id),
+            "bot_id": publication.principal[2], "user_id": publication.principal[3],
+            "chat_id": publication.principal[3], "thread_id": "", "reply_to_message_id": "",
+        }
+        source = publication._custody.evidence
+        require(receipt["platform"] == "telegram" and receipt["chat_type"] == "dm"
+                and all(receipt[key] == route[key] == ingress.scope[key] for key in _ROUTE)
+                and all(message[key] == value for key, value in ids.items())
+                and caption == {"kind": "caption", "date": publication.sdk_date,
+                                "sha256": publication.caption_sha256}
+                and media["mime_type"] == publication.mime_type and media["local_reference"] == str(source.path)
+                and media["content"] == {"sha256": publication.input_sha256,
+                                         "size_bytes": publication.input_size_bytes}
+                and all(origin[key] == ids[key] for key in ("bot_id", "chat_id", "thread_id", "message_id"))
+                and (origin["file_id"], origin["file_unique_id"], origin["declared_bytes"])
+                == (publication.file_id, publication.file_unique_id, publication.input_size_bytes)
+                and publication is settled_publication(arm, deadline=deadline),
+                "c06_exact_protected_settled_pair_and_publication_required")
+        return {"c06": {
+            "role": publication.role, "sdk_update_id": publication.update_id,
+            "sdk_message_id": publication.native_message_id,
+            "tester_ack_message_id": verified["run"]["sent_message_id"],
+            "original_sender_proof_sha256": bound.provenance,
+            "input_sha256": publication.input_sha256, "input_bytes": publication.input_size_bytes,
+            "session_id": publication.session_id, "route_created_at": publication.route_created_at,
+        }}
+
+    def _prepare_terminal_handoff(self, arm, reference, evidence, deadline):
+        original = settled_publication(arm, deadline=deadline)
+        handoff = RetiredPublication(original, (reference["path"], reference["bytes"], reference["sha256"]),
+                                     _encode(evidence), self.read_owned)
+        handoff._check_receipt()
+
+        def commit():
+            adapter = arm.ingress.adapter
+            if time.monotonic() >= deadline:
+                raise TimeoutError("c06_retired_handoff_deadline_expired")
+            require(adapter._ordinary_dm_wire_arm is None and adapter._ordinary_dm_wire_window is None
+                    and arm.ingress._unknown == "ingress_window_retired"
+                    and arm.claim.owner_is_current() is True and _current_publication(original),
+                    "c06_strict_native_retirement_unproved")
+            handoff._check_receipt()
+            if time.monotonic() >= deadline:
+                raise TimeoutError("c06_retired_handoff_deadline_expired")
+            with self._accept_retained(handoff, deadline_monotonic=deadline):
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("c06_retired_handoff_deadline_expired")
+
+        return commit
+
+
+def ordinary_c06_receiver_verb(runner, loop, *, accept_retained):
+    """Bind the receiver and predecessor reader to the same native owner."""
+    from .c06_current_provider import C06NativeOwner
+
+    owner = getattr(accept_retained, "__self__", None)
+    require(type(owner) is C06NativeOwner and owner.runner is runner and owner.loop is loop
+            and getattr(accept_retained, "__func__", None) is C06NativeOwner.accept_retained,
+            "c06_existing_native_observer_owner_required")
+    return _ordinary_receiver_verb(
+        runner, loop, control_type=partial(C06ReceiverControl, accept_retained=accept_retained,
+                                          require_predecessor=owner.require_predecessor),
+    )
