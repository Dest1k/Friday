@@ -0,0 +1,161 @@
+"""Corroborate an authenticated native text-summary receipt in the running store.
+
+The owner of the existing control socket must authenticate the original
+SDK/ACK receipt and supply the current admitted UserScope before calling this
+predicate. It returns no Telegram authority or R4 dispatch grant.
+"""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import re
+import time
+from types import SimpleNamespace
+
+from gateway.run_inbound_media import _absolute_directory, _file_identity, _verified_bytes
+from gateway.upload_anchor import (
+    AnchorUnavailable, _current_entry, _file, _object, _read_anchor, _read_snapshot,
+    _route, _selector,
+)
+from hermes_cli.friday_user_scope import UserScope
+
+
+def _original_read(db, sid, native_row, read, file, workspace, window, deadline):
+    call_row, result_row = read['call_row'], read['result_row']
+    if (type(call_row) is not int or type(result_row) is not int
+            or not native_row < call_row < result_row):
+        raise AnchorUnavailable('ordinary_text_read_row_order')
+    with _read_snapshot(db, deadline, lambda: int(time.monotonic() >= deadline)) as conn:
+        rows = conn.execute(
+            """SELECT id, role, timestamp, tool_name, tool_calls, tool_call_uids,
+                      tool_call_id, tool_call_uid, content, message_uid
+               FROM messages WHERE session_id = ? AND id IN (?,?,?)
+                 AND active=1 AND compacted=0 AND observed=0 AND _compressed_summary=0
+                 AND display_kind IS NULL AND length(CAST(content AS BLOB)) <= 1048576
+                 AND COALESCE(length(CAST(tool_calls AS BLOB)), 0) <= 65536
+                 AND COALESCE(length(CAST(tool_call_uids AS BLOB)), 0) <= 65536
+               ORDER BY id""", (sid, native_row, call_row, result_row)).fetchall()
+        # Do not let an exact-looking tool call from a different USER turn qualify.
+        intervening = conn.execute('SELECT 1 FROM messages WHERE session_id=? AND id>? AND id<? '
+                                   "AND role='user' AND active=1 LIMIT 1", (sid, native_row, result_row)).fetchone()
+    if len(rows) != 3 or intervening is not None or any(not row['message_uid'] for row in rows):
+        raise AnchorUnavailable('ordinary_text_read_occurrence_unavailable')
+    user, call, result = rows
+    if ((user['role'], call['role'], result['role']) != ('user', 'assistant', 'tool')
+            or not window[0] <= user['timestamp'] <= call['timestamp'] <= result['timestamp'] < window[1]
+            or result['tool_name'] != 'read_file' or result['tool_call_id'] != read['call_id']
+            or not result['tool_call_uid']
+            or _object(call['tool_call_uids']).get(read['call_id']) != result['tool_call_uid']):
+        raise AnchorUnavailable('ordinary_text_read_occurrence_changed')
+    matches = [item for item in json.loads(call['tool_calls'] or '[]') if item.get('id') == read['call_id']]
+    if len(matches) != 1:
+        raise AnchorUnavailable('ordinary_text_read_call_ambiguous')
+    function = matches[0]['function']
+    paths = {file['path'], str(workspace / file['path'])}
+    if function['name'] != 'read_file' or _object(function['arguments']).get('path') not in paths:
+        raise AnchorUnavailable('ordinary_text_read_call_changed')
+    answer = _object(result['content'])
+    result_digest = sha256(result['content'].encode()).hexdigest()
+    if (answer.get('success') is not True or answer.get('scope') != 'own_user_workspace'
+            or answer.get('source_sha256') != file['sha256'] or answer.get('path') != file['path']
+            or result_digest != read['result_sha256']):
+        raise AnchorUnavailable('ordinary_text_read_result_changed')
+    return tuple(tuple(row) for row in rows)
+
+
+def read_retained_text_input(store, routing_db, profile_db, cap, receipt):
+    """Check one exact active DM transcript, retained input and route incarnation."""
+    if type(cap) is not UserScope or cap.revoked:
+        raise AnchorUnavailable('current_user_scope_required')
+    conversation = receipt['conversation']
+    tester = str(conversation['tester_id'])
+    peer = str(conversation['peer_id'])
+    key = conversation['session_key']
+    sid = conversation['session_id']
+    home = cap.authorization_home
+    profile = conversation['profile']
+    scope = conversation['scope']
+    if (conversation['platform'] != 'telegram' or conversation['chat_type'] != 'dm'
+            or key != f'agent:{profile}:telegram:dm:{tester}' or cap.profile != profile
+            or cap.principal != ('telegram', receipt['transport_profile'], peer, tester)
+            or cap.home != home / 'profiles' / profile or scope != str(home / 'sessions')
+            or Path(routing_db.db_path) != home / 'state.db'
+            or Path(profile_db.db_path) != cap.home / 'state.db'):
+        raise AnchorUnavailable('ordinary_text_owner_scope_changed')
+    route = ('telegram', tester, tester, 'dm', None)
+    ctx = SimpleNamespace(session_id=sid, session_key=key)
+    native = receipt['native']
+    if (native['namespace'] != 'native.telegram' or type(native['message_id']) is not int
+            or native['message_id'] <= 0):
+        raise AnchorUnavailable('native_telegram_message_required')
+    selector = _selector(dict(source_session_id=sid, native_row_id=native['input_row'],
+                              file_name=receipt['file_name']))
+    deadline = time.monotonic() + 0.3
+
+    def current_route():
+        if (time.monotonic() >= deadline or routing_db._db_file_was_replaced()
+                or profile_db._db_file_was_replaced()):
+            raise AnchorUnavailable('ordinary_text_store_unavailable')
+        entry = _current_entry(store, ctx, cap, route)
+        if (getattr(entry.platform, 'value', None) != 'telegram' or entry.chat_type != 'dm'
+                or entry.origin.profile != profile
+                or entry.transport_profile != cap.principal[1]
+                or entry.created_at.isoformat() != receipt['route_created_at']
+                or entry.suspended or entry.active_turn_token is not None or entry.expiry_finalized):
+            raise AnchorUnavailable('ordinary_text_route_incarnation_changed')
+        with _read_snapshot(routing_db, deadline, lambda: int(time.monotonic() >= deadline)) as conn:
+            found = conn.execute(
+                'SELECT entry_json FROM gateway_routing WHERE scope=? AND session_key=? '
+                'AND length(CAST(entry_json AS BLOB)) <= 65536', (scope, key)).fetchone()
+        if found is None:
+            raise AnchorUnavailable('ordinary_text_durable_route_missing')
+        stored = _object(found['entry_json'])
+        origin = stored.get('origin')
+        if (stored.get('created_at') != receipt['route_created_at']
+                or stored.get('session_id') != sid or stored.get('session_key') != key
+                or stored.get('platform') != 'telegram' or stored.get('chat_type') != 'dm'
+                or stored.get('suspended') is not False or stored.get('expiry_finalized') is not False
+                or stored.get('active_turn_token') is not None
+                or stored.get('transport_profile') != cap.principal[1]
+                or not isinstance(origin, dict)
+                or tuple(origin.get(k) for k in ('platform','user_id','chat_id','chat_type','thread_id')) != route
+                or origin.get('profile') != profile):
+            raise AnchorUnavailable('ordinary_text_durable_route_changed')
+        return entry
+
+    entry = current_route()
+    original = _read_anchor(profile_db, cap, ctx, route, selector, deadline)
+    _, row = original
+    if row[0] != str(native['message_id']) or row[2:4] != (1, 0):
+        raise AnchorUnavailable('ordinary_text_active_native_input_changed')
+    file = _file(row, cap, receipt['file_name'])
+    if file['sha256'] != receipt['input_sha256'] or file['size_bytes'] != receipt['input_size_bytes']:
+        raise AnchorUnavailable('ordinary_text_direct_upload_changed')
+    def checked_read():
+        return _original_read(profile_db, sid, native['input_row'], receipt['read'], file,
+                              cap.home / 'workspace', (receipt['sdk_date'], receipt['capture_until']), deadline)
+
+    before_read = checked_read()
+    # _file requires the stock received-path syntax. Open through the exact
+    # protected owner directory and reject replacement, links and byte drift.
+    parent = cap.home / 'workspace' / 'received'
+    leaf = Path(file['path']).name
+    if re.fullmatch(r'telegram_[a-f0-9]{64}_[A-Za-z0-9_.-]{1,80}\.[a-z0-9]{1,12}', leaf) is None:
+        raise AnchorUnavailable('ordinary_text_received_leaf_required')
+    directory = _absolute_directory(parent)
+    try:
+        before = _file_identity(os.stat(leaf, dir_fd=directory, follow_symlinks=False))
+        if tuple(receipt['file_identity']) != before:
+            raise AnchorUnavailable('ordinary_text_retained_file_identity_changed')
+        raw = _verified_bytes(directory, (leaf,), dict(size_bytes=file['size_bytes'], sha256=file['sha256']))
+        after = _file_identity(os.stat(leaf, dir_fd=directory, follow_symlinks=False))
+        if before != after or not os.path.samestat(os.fstat(directory), parent.stat(follow_symlinks=False)):
+            raise AnchorUnavailable('ordinary_text_retained_file_changed')
+    finally:
+        os.close(directory)
+    if (_read_anchor(profile_db, cap, ctx, route, selector, deadline) != original
+            or checked_read() != before_read
+            or current_route() is not entry or time.monotonic() >= deadline):
+        raise AnchorUnavailable('ordinary_text_current_snapshot_changed')
+    return {'conversation': conversation, 'retained_input_sha256': sha256(raw).hexdigest(),
+            'route_incarnation_matches': True}
