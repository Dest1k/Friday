+                and Path(self.routing_db.db_path) == cap.authorization_home / "state.db"
+                and Path(self.profile_db.db_path) == cap.home / "state.db"
+                and self._current_handles()
+                and not self.routing_db._db_file_was_replaced() and not self.profile_db._db_file_was_replaced()
+                and self.boot_id == BOOT.read_text().strip() and encoded(scope) == self.expected_scope_bytes,
