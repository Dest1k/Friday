+        photo_tasks.update((task, photo) for task, (_, photo) in dispatching_photos.items())
+        candidates = [(task, photo) for task, photo in photo_tasks.items()
+                      if task is not None and not task.done()
+                      and type(photo.platform_update_id) is int and photo.platform_update_id < text.platform_update_id
+                      and _photo_followup_scope(adapter, photo) == scope]
