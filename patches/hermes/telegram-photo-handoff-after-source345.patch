+def _photo_followup_scope(adapter, event):
+    source = event.source
+    message = event.raw_message
+    sender = message.from_user.id if message is not None and message.from_user is not None else source.user_id
+    if sender is None:
+        return None
+    return (source.chat_id, source.chat_type, str(sender), adapter._session_key_profile(source))
+
+
+def _photo_followup_thread_matches(adapter, text, candidates, *, recover=False):
+    """Compare routing threads without changing the queued events or their SDK origins."""
+    def thread_for(event):
+        if not recover or str((event.metadata or {}).get("gateway_session_key") or "").strip():
+            return event.source.thread_id
+        preview = copy(event)
+        adapter._apply_topic_recovery(preview)
+        return preview.source.thread_id
+
+    thread = thread_for(text)
+    return [task for task, photo in candidates if thread_for(photo) == thread]
+
+
+async def wait_for_earlier_photo_batches(adapter, text):
+    """Keep earlier buffered standalone photos ahead of text in the same route."""
+    if type(text.platform_update_id) is not int:
+        return
+    dispatching_photos = getattr(adapter, "_dispatching_photos", {})
+    if not (adapter._pending_photo_batches or dispatching_photos):
+        return
+    if getattr(text, "allow_gateway_control", False):
+        from gateway.platforms.base import coerce_plaintext_gateway_command
+        preview = copy(text)
+        coerce_plaintext_gateway_command(preview)
+        if preview.get_command():
+            return
+    scope = _photo_followup_scope(adapter, text)
+    if scope is None:
+        return
+    loop = asyncio.get_running_loop()
+    recover = text.source.chat_type == "dm" and getattr(adapter, "_topic_recovery_fn", None) is not None
+    delay = adapter._media_batch_delay_seconds
+    deadline = loop.time() + (max(0, delay) if math.isfinite(delay) else 0) + adapter._TEXT_BATCH_MAX_DELAY_S
+    while not adapter._should_drop_delayed_delivery():
+        photo_tasks = {adapter._pending_photo_batch_tasks.get(key): photo
