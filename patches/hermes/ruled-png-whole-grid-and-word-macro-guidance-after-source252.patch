+++ b/tools/scoped_png_table.py
@@ -0,0 +1,441 @@
+"""Observe words in a bounded ruled RGB PNG using the local OCR custody.
+
+Cell and word boxes are half-open XYXY in the original pixel coordinates.
+The result contains recognition candidates and their native confidence scores.
+The ordinary caller owns scope checks and any acceptance of candidate text.
+"""
+from __future__ import annotations
+
+import ctypes
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import resource
+import shutil
+import stat
+from statistics import median
+import struct
+import sys
+import tempfile
+from types import SimpleNamespace
+import unicodedata
+import zlib
+
+
+_MAX_BYTES = 1_000_000
+_MAX_EDGE = 2000
+_MAX_CELLS = 64
+_MAX_WORDS_PER_CELL = 32
+_MAX_WORD_CHARS = 128
+_MAX_TSV = 32_768
+_OUTPUT_LIMIT = 1_000_000
+_IMAGE = 'png_ruled_table_image_unsupported'
+_LAYOUT = 'png_ruled_table_layout_unsupported'
+_INVALID_OUTPUT = 'local_ocr_invalid_output'
+_UNAVAILABLE = 'local_ocr_unavailable'
+_FAILED = 'local_ocr_failed'
+_PREFIX = Path('/opt/local-ocr')
+_LIB = 'usr/lib/x86_64-linux-gnu'
+_LEPT = f'{_LIB}/libleptonica.so.6.0.0'
+_TESS = f'{_LIB}/libtesseract.so.5.0.5'
+_MODELS = 'usr/share/tesseract-ocr/5/tessdata'
+_TOOLCHAIN_PINS = {
+    _LEPT: '34320a35133dfcccf07bab56f64948689afcea16f60783dc5a16536843af96a6',
+    _TESS: '53b8de203802e1fa28fbea711ea27e8227111cbfc87f27e3392a1b6fa57d00a3',
+    f'{_MODELS}/rus.traineddata': 'e16e5e036cce1d9ec2b00063cf8b54472625b9e14d893a169e2b0dedeb4df225',
+    f'{_MODELS}/eng.traineddata': '7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2',
+}
+_PNG_SIGNATURE = b'\x89PNG\r\n\x1a\n'
+_PNG_ANCILLARY = {b'cHRM': 32, b'gAMA': 4, b'sRGB': 1, b'pHYs': 9,
+                  b'sBIT': 3, b'bKGD': 6}
+_TSV_HEADER = ('level\tpage_num\tblock_num\tpar_num\tline_num\tword_num\tleft\t'
+               'top\twidth\theight\tconf\ttext')
+_TSV_INTEGER = re.compile(r'[0-9]{1,6}\Z')
+_TSV_CONFIDENCE = re.compile(r'[0-9]{1,3}(?:\.[0-9]{1,10})?\Z')
+
+
+class _PNGFailure(ValueError):
+    """A finite internal refusal shared by the supervisor and child."""
+
+
+def _png_size(data):
+    # Restrict the direct decoder to opaque, noninterlaced RGB8. The small
+    # ancillary allowlist excludes EXIF, animation, transparency and profiles.
+    if type(data) is not bytes or not 45 <= len(data) <= _MAX_BYTES:
+        raise _PNGFailure(_IMAGE)
+    if data[:16] != _PNG_SIGNATURE + b'\x00\x00\x00\x0dIHDR':
+        raise _PNGFailure(_IMAGE)
+    width, height = struct.unpack_from('>II', data, 16)
+    if (not 1 <= width <= _MAX_EDGE or not 1 <= height <= _MAX_EDGE
+            or data[24:29] != bytes((8, 2, 0, 0, 0))):
+        raise _PNGFailure(_IMAGE)
+    pos = len(_PNG_SIGNATURE)
+    chunks = set()
+    idat_bytes = 0
+    for _ in range(128):
+        if pos + 12 > len(data):
+            break
+        length, kind = struct.unpack_from('>I4s', data, pos)
+        end = pos + 12 + length
+        if (end > len(data) or zlib.crc32(data[pos + 4:end - 4])
+                != struct.unpack_from('>I', data, end - 4)[0]):
+            break
+        if kind == b'IEND' and length == 0 and idat_bytes and end == len(data):
+            return width, height
+        if kind == b'IDAT':
+            idat_bytes += length
+        elif (kind != b'IHDR' or chunks) and (
+                b'IDAT' in chunks or kind in chunks or _PNG_ANCILLARY.get(kind) != length):
+            break
+        chunks.add(kind)
+        pos = end
+    raise _PNGFailure(_IMAGE)
+
+
+def _long_run(bits, minimum):
+    found = None
+    start = None
+    for index, ink in enumerate(bits):
+        if ink and start is None:
+            start = index
+        elif not ink and start is not None:
+            if index - start >= minimum:
+                if found is not None:
+                    raise _PNGFailure(_LAYOUT)
+                found = (start, index)
+            start = None
+    if start is not None and len(bits) - start >= minimum:
+        if found is not None:
+            raise _PNGFailure(_LAYOUT)
+        found = (start, len(bits))
+    return found
+
+
+def _rule_bands(scans, length):
+    bands = []
+    for index, bits in enumerate(scans):
+        run = _long_run(bits, max(24, length // 5))
+        if run is None:
+            continue
+        if bands and index == bands[-1][0] + len(bands[-1][1]):
+            bands[-1][1].append(run)
+        else:
+            bands.append((index, [run]))
+    result = []
+    for start, spans in bands:
+        edges_start, edges_end = zip(*spans)
+        if (len(spans) > max(3, length // 40) or max(edges_start) - min(edges_start) > 3
+                or max(edges_end) - min(edges_end) > 3):
+            raise _PNGFailure(_LAYOUT)
+        result.append((start, start + len(spans), int(median(edges_start)), int(median(edges_end))))
+    return result
+
+
+def _grid(pixels):
+    height, width = len(pixels), len(pixels[0])
+    horizontal = _rule_bands(pixels, width)
+    vertical = _rule_bands(zip(*pixels), height)
+    rows, columns = len(horizontal) - 1, len(vertical) - 1
+    if not (2 <= rows <= 16 and 2 <= columns <= 16 and rows * columns <= _MAX_CELLS):
+        raise _PNGFailure(_LAYOUT)
+    for y0, y1, left, right in horizontal:
+        if abs(left - vertical[0][0]) > 3 or abs(right - vertical[-1][1]) > 3:
+            raise _PNGFailure(_LAYOUT)
+        for x0, x1, _, _ in vertical:
+            if not any(any(scan[x0:x1]) for scan in pixels[y0:y1]):
+                raise _PNGFailure(_LAYOUT)
+    for _, _, top, bottom in vertical:
+        if abs(top - horizontal[0][0]) > 3 or abs(bottom - horizontal[-1][1]) > 3:
+            raise _PNGFailure(_LAYOUT)
+    cells = []
+    for row, (top, bottom) in enumerate(zip(horizontal, horizontal[1:]), 1):
+        for column, (left, right) in enumerate(zip(vertical, vertical[1:]), 1):
+            box = [left[1], top[1], right[0], bottom[0]]
+            if box[2] - box[0] < 8 or box[3] - box[1] < 8:
+                raise _PNGFailure(_LAYOUT)
+            cells.append({'row': row, 'column': column, 'box': box})
+    return rows, columns, cells
+
+
+def _valid_box(box, outer):
+    return (type(box) is list and len(box) == 4 and all(type(value) is int for value in box)
+            and outer[0] <= box[0] < box[2] <= outer[2]
+            and outer[1] <= box[1] < box[3] <= outer[3])
+
+
+def _valid_word(word):
+    return (type(word) is str and 1 <= len(word) <= _MAX_WORD_CHARS
+            and all(not char.isspace() and not unicodedata.category(char).startswith('C')
+                    for char in word))
+
+
+def _parse_tsv(raw, bounds):
+    if not 0 < len(raw) <= _MAX_TSV:
+        raise _PNGFailure(_INVALID_OUTPUT)
+    lines = raw.decode('utf-8').removesuffix('\n').split('\n')
+    if lines[0] == _TSV_HEADER:
+        lines = lines[1:]
+    if not 1 <= len(lines) <= 4 * _MAX_WORDS_PER_CELL + 1:
+        raise _PNGFailure(_INVALID_OUTPUT)
+    words = []
+    for line in lines:
+        fields = line.split('\t')
+        if (len(fields) != 12 or fields[0] not in ('1', '2', '3', '4', '5')
+                or any(not _TSV_INTEGER.fullmatch(field) for field in fields[1:10])):
+            raise _PNGFailure(_INVALID_OUTPUT)
+        confidence, word = fields[10:]
+        if fields[0] != '5':
+            if confidence != '-1' or word:
+                raise _PNGFailure(_INVALID_OUTPUT)
+            continue
+        if (not _valid_word(word) or not _TSV_CONFIDENCE.fullmatch(confidence)
+                or len(words) == _MAX_WORDS_PER_CELL):
+            raise _PNGFailure(_INVALID_OUTPUT)
+        x, y, width, height = map(int, fields[6:10])
+        box = [x, y, x + width, y + height]
+        score = float(confidence)
+        if not _valid_box(box, bounds) or not 0 <= score <= 100:
+            raise _PNGFailure(_INVALID_OUTPUT)
+        words.append({'text': word, 'confidence': score, 'box': box})
+    return words
+
+
+def _validate_result(payload, width, height, *, headers_only=False):
+    if (type(payload) is not dict or set(payload) != {'width', 'height', 'rows', 'columns', 'cells'}
+            or any(type(payload[key]) is not int for key in ('width', 'height', 'rows', 'columns'))
+            or (payload['width'], payload['height']) != (width, height)):
+        raise _PNGFailure(_INVALID_OUTPUT)
+    rows, columns, cells = payload['rows'], payload['columns'], payload['cells']
+    if (not (2 <= rows <= 16 and 2 <= columns <= 16 and rows * columns <= _MAX_CELLS)
+            or type(cells) is not list or len(cells) != (columns if headers_only else rows * columns)):
+        raise _PNGFailure(_INVALID_OUTPUT)
+    x_ranges = []
+    y_ranges = []
+    for index, cell in enumerate(cells):
+        row, column = divmod(index, columns)
+        if (type(cell) is not dict or set(cell) != {'row', 'column', 'box', 'words'}
+                or type(cell['row']) is not int or type(cell['column']) is not int
+                or (cell['row'], cell['column']) != (row + 1, column + 1)
+                or not _valid_box(cell['box'], [0, 0, width, height])):
+            raise _PNGFailure(_INVALID_OUTPUT)
+        left, top, right, bottom = cell['box']
+        if right - left < 8 or bottom - top < 8:
+            raise _PNGFailure(_INVALID_OUTPUT)
+        if row == 0:
+            if x_ranges and x_ranges[-1][1] >= left:
+                raise _PNGFailure(_INVALID_OUTPUT)
+            x_ranges.append((left, right))
+        if column == 0:
+            if y_ranges and y_ranges[-1][1] >= top:
+                raise _PNGFailure(_INVALID_OUTPUT)
+            y_ranges.append((top, bottom))
+        if (x_ranges[column] != (left, right) or y_ranges[row] != (top, bottom)
+                or type(cell['words']) is not list or len(cell['words']) > _MAX_WORDS_PER_CELL):
+            raise _PNGFailure(_INVALID_OUTPUT)
+        for word in cell['words']:
+            if (type(word) is not dict or set(word) != {'text', 'confidence', 'box'}
+                    or not _valid_word(word['text']) or not _valid_box(word['box'], cell['box'])
+                    or type(word['confidence']) is not float or not 0 <= word['confidence'] <= 100):
+                raise _PNGFailure(_INVALID_OUTPUT)
+    return payload
+
+
+def _write_private(path, data):
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
+    with os.fdopen(os.open(path, flags, 0o600), 'wb') as stream:
+        stream.write(data)
+
+
+def _png_argv(ocr, work, toolchain, *, headers_only=False):
+    locations = {str(work / 'input.pdf'): str(work / 'input.png'),
+                 '/input.pdf': '/input.png', '/work/input.pdf': '/work/input.png'}
+    argv = [locations.get(item, item) for item in ocr._argv(work, toolchain)]
+    position = argv.index('--remount-ro')
+    argv[position:position] = [
+        '--setenv', 'FRIDAY_HOST_NETNS', os.readlink('/proc/self/ns/net'),
+        '--setenv', 'LD_LIBRARY_PATH', str(_PREFIX / _LIB),
+        '--setenv', 'OMP_THREAD_LIMIT', '2', '--setenv', 'OMP_NUM_THREADS', '2',
+    ]
+    if headers_only:
+        argv[-1] = '--child-headings'
+    return argv
+
+
+def extract_ruled_png(data: bytes, *, headers_only=False) -> dict:
+    """Return physical cells and observable OCR words for an authorized PNG."""
+    from tools import scoped_pdf_ocr as ocr
+
+    work = None
+    try:
+        if type(headers_only) is not bool:
+            raise _PNGFailure(_INVALID_OUTPUT)
+        width, height = _png_size(data)
+        toolchain = ocr._toolchain()
+        work = Path(tempfile.mkdtemp(prefix='friday-ruled-png-'))
+        _write_private(work / 'input.png', data)
+        _write_private(work / 'runner.py', Path(__file__).read_bytes())
+        ocr._run(_png_argv(ocr, work, toolchain, headers_only=headers_only), work,
+                 wall_seconds=18, exclusive_turn=True)
+        payload = json.loads(ocr._private_read(work / 'result.json', _OUTPUT_LIMIT))
+        if type(payload) is dict and set(payload) == {'error'}:
+            code = payload['error']
+            if type(code) is str and code in (_IMAGE, _LAYOUT, _INVALID_OUTPUT, _UNAVAILABLE, _FAILED):
+                raise _PNGFailure(code)
+            raise _PNGFailure(_INVALID_OUTPUT)
+        return _validate_result(payload, width, height, headers_only=headers_only)
+    except _PNGFailure as failure:
+        raise ocr.LocalOCRFailure(str(failure)) from None
+    except (OSError, ValueError):
+        raise ocr.LocalOCRFailure(_FAILED) from None
+    finally:
+        if work is not None:
+            try:
+                shutil.rmtree(work)
+            except OSError:
+                raise ocr.LocalOCRFailure('local_ocr_cleanup_unconfirmed') from None
+
+
+def _check_toolchain():
+    # Check owner, stable file identity and the measured C ABI and language bytes
+    # inside the same read-only namespace used by the child decoder.
+    for relative, pin in _TOOLCHAIN_PINS.items():
+        path = _PREFIX / relative
+        if path.resolve(strict=True) != path:
+            raise _PNGFailure(_UNAVAILABLE)
+        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+        with os.fdopen(os.open(path, flags), 'rb') as stream:
+            before = os.fstat(stream.fileno())
+            if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
+                    or before.st_nlink != 1 or before.st_mode & 0o022
+                    or not 0 < before.st_size <= 5_000_000):
+                raise _PNGFailure(_UNAVAILABLE)
+            blob = stream.read(before.st_size + 1)
+            after = os.fstat(stream.fileno())
+            named = path.lstat()
+            fields = ('st_dev', 'st_ino', 'st_mode', 'st_uid', 'st_nlink', 'st_size',
+                      'st_mtime_ns', 'st_ctime_ns')
+            if (len(blob) != before.st_size or hashlib.sha256(blob).hexdigest() != pin
+                    or any(getattr(before, field) != getattr(after, field)
+                           or getattr(before, field) != getattr(named, field) for field in fields)):
+                raise _PNGFailure(_UNAVAILABLE)
+
+
+def _native_function(library, name, result, *parameters):
+    function = getattr(library, name)
+    function.restype, function.argtypes = result, parameters
+    return function
+
+
+def _libraries():
+    lept = ctypes.CDLL(str(_PREFIX / _LEPT))
+    tess = ctypes.CDLL(str(_PREFIX / _TESS))
+    ptr, integer, text = ctypes.c_void_p, ctypes.c_int, ctypes.c_char_p
+    function = _native_function
+    pix_api = SimpleNamespace(
+        read=function(lept, 'pixReadMem', ptr, text, ctypes.c_size_t),
+        width=function(lept, 'pixGetWidth', integer, ptr),
+        height=function(lept, 'pixGetHeight', integer, ptr),
+        depth=function(lept, 'pixGetDepth', integer, ptr),
+        stride=function(lept, 'pixGetWpl', integer, ptr),
+        data=function(lept, 'pixGetData', ctypes.POINTER(ctypes.c_uint32), ptr),
+        delete=function(lept, 'pixDestroy', None, ctypes.POINTER(ptr)),
+    )
+    tess_api = SimpleNamespace(
+        create=function(tess, 'TessBaseAPICreate', ptr),
+        init=function(tess, 'TessBaseAPIInit3', integer, ptr, text, text),
+        page_mode=function(tess, 'TessBaseAPISetPageSegMode', None, ptr, integer),
+        image=function(tess, 'TessBaseAPISetImage2', None, ptr, ptr),
+        rect=function(tess, 'TessBaseAPISetRectangle', None, ptr, integer, integer, integer, integer),
+        reset=function(tess, 'TessBaseAPIClearAdaptiveClassifier', None, ptr),
+        recognize=function(tess, 'TessBaseAPIRecognize', integer, ptr, ptr),
+        tsv=function(tess, 'TessBaseAPIGetTsvText', ptr, ptr, integer),
+        free=function(tess, 'TessDeleteText', None, ptr),
+        delete=function(tess, 'TessBaseAPIDelete', None, ptr),
+    )
+    return pix_api, tess_api
+
+
+def _pixels(api, pixel, width, height):
+    if (api.width(pixel), api.height(pixel), api.depth(pixel), api.stride(pixel)) != (
+            width, height, 32, width):
+        raise _PNGFailure(_IMAGE)
+    data = api.data(pixel)
+    if not data:
+        raise _PNGFailure(_IMAGE)
+
+    def dark(word):
+        red, green, blue = (word >> 24) & 255, (word >> 16) & 255, (word >> 8) & 255
+        return 77 * red + 150 * green + 29 * blue < 128 * 256
+
+    return [bytes(dark(data[start + x]) for x in range(width))
+            for start in range(0, width * height, width)]
+
+
+def _observe(data, width, height, *, headers_only=False):
+    pix_api, tess = _libraries()
+    pixel = pix_api.read(data, len(data))
+    if not pixel:
+        raise _PNGFailure(_IMAGE)
+    handle = None
+    try:
+        rows, columns, cells = _grid(_pixels(pix_api, pixel, width, height))
+        if headers_only:
+            cells = cells[:columns]
+        handle = tess.create()
+        if not handle or tess.init(handle, os.fsencode(_PREFIX / _MODELS), b'rus+eng') != 0:
+            raise _PNGFailure(_UNAVAILABLE)
+        tess.page_mode(handle, 7)  # One text line per ruled cell.
+        tess.image(handle, pixel)
+        for cell in cells:
+            left, top, right, bottom = cell['box']
+            tess.reset(handle)
+            tess.rect(handle, left, top, right - left, bottom - top)
+            if tess.recognize(handle, None) != 0:
+                raise _PNGFailure(_FAILED)
+            native = tess.tsv(handle, 0)
+            if not native:
+                raise _PNGFailure(_FAILED)
+            try:
+                cell['words'] = _parse_tsv(ctypes.string_at(native), cell['box'])
+            finally:
+                tess.free(native)
+        return {'width': width, 'height': height, 'rows': rows, 'columns': columns, 'cells': cells}
+    finally:
+        if handle:
+            tess.delete(handle)
+        pix_api.delete(ctypes.byref(ctypes.c_void_p(pixel)))
+
+
+def _child(*, headers_only=False):
+    host_netns = os.environ.get('FRIDAY_HOST_NETNS')
+    if (not host_netns or host_netns == os.readlink('/proc/self/ns/net')
+            or Path.cwd() != Path('/work')):
+        return 1
+    os.sched_setaffinity(0, sorted(os.sched_getaffinity(0))[:2])
+    for key, limit in ((resource.RLIMIT_AS, 768 * 1024**2), (resource.RLIMIT_CPU, 12),
+                       (resource.RLIMIT_FSIZE, _OUTPUT_LIMIT), (resource.RLIMIT_CORE, 0),
+                       (resource.RLIMIT_NOFILE, 64)):
+        resource.setrlimit(key, (limit, limit))
+    try:
+        with Path('/input.png').open('rb') as stream:
+            data = stream.read(_MAX_BYTES + 1)
+        width, height = _png_size(data)
+        _check_toolchain()
+        payload = _observe(data, width, height, headers_only=headers_only)
+    except _PNGFailure as failure:
+        payload = {'error': str(failure)}
+    except UnicodeError:
+        payload = {'error': _INVALID_OUTPUT}
+    except OSError:
+        payload = {'error': _UNAVAILABLE}
+    result = json.dumps(payload, ensure_ascii=False, allow_nan=False, separators=(',', ':')).encode()
+    if len(result) > _OUTPUT_LIMIT:
+        result = b'{"error":"local_ocr_invalid_output"}'
+    _write_private(Path('/work/result.json'), result)
+    return 0
+
+
+if __name__ == '__main__' and sys.argv[1:] in (['--child'], ['--child-headings']):
+    raise SystemExit(_child(headers_only=sys.argv[1] == '--child-headings'))
