+def _ruled_header_options(grid):
+    """Use the same observed selector rules for discovery and XLSX projection."""
+    from collections import Counter
+
+    headers = [cell for cell in grid['cells'] if cell['row'] == 1]
+    names = [cell['words'][0]['text'].removesuffix(',') if cell['words'] else None
+             for cell in headers]
+    counts = Counter(names)
+    options = []
+    for cell, name in zip(headers, names):
+        if not name or not 1 <= len(name) <= 40 or not name.isalpha():
+            selector, state = None, 'UNRESOLVED'
+        elif counts[name] != 1:
+            selector, state = None, 'AMBIGUOUS'
+        elif cell['words'][0]['confidence'] < 80:
+            selector, state = None, 'UNRESOLVED'
+        else:
+            selector, state = name, 'OCR_SELECTOR_CANDIDATE'
+        options.append({**cell, 'selector':selector, 'selector_status':state})
+    return options
+
+
+def _ruled_call():
+    from agent.web_call_context import _current, same_web_authority
+
+    call = _current.get()
+    if call is None or not same_web_authority(call):
+        raise ScopeDenied()
+    return call
+
+
+def _ruled_ocr_error(call, error):
+    code = str(error)
+    if code == 'local_ocr_cleanup_unconfirmed':
+        if hasattr(call, 'agent'):
+            call.agent._friday_reply_effect_unknown = True
+        effect = 'unknown'
+    else:
+        allowed = {'png_ruled_table_layout_unsupported','png_ruled_table_image_unsupported',
+                   'local_ocr_timeout','local_ocr_failed','local_ocr_unavailable',
+                   'local_ocr_authority','local_ocr_custody_busy','local_ocr_invalid_output'}
+        if code not in allowed:
+            code = 'local_ocr_failed'
+        effect = 'none'
+    return _encode({'success':False,'error':code,'effect_disposition':effect})
+
+
+def read_ruled_headings(cap, relative):
+    """Read the first physical row with the original native call and owned PNG."""
+    from tools.scoped_pdf_ocr import LocalOCRFailure
+    from tools.scoped_png_table import extract_ruled_png
+
+    call = _ruled_call()
