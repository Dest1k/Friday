+def create_ruled_table(cap, fd, leaf, relative, content):
+    """Create one provisional whole grid or numeric projection from an owned ruled PNG."""
+    import re
+    import os
+    from tools.scoped_pdf_ocr import LocalOCRFailure
+    from tools.scoped_png_table import extract_ruled_png
+    from hermes_cli.friday_workspace_xlsx_table import (
+        create_document, render_document, parse, TableRefused,
+    )
+
+    call = _ruled_call()
+    _check_parent(cap, fd, relative)
+    try:
+        os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError:
+        pass
+    else:
+        return _encode({'success':False,'error':'document_already_exists','path':relative})
+    def refuse(code):
+        return _encode({'success':False,'error':code,'effect_disposition':'none'})
+    try:
+        spec = parse(content)
+    except TableRefused:
+        return refuse('png_ruled_table_invalid_spec')
+    if not isinstance(spec, dict) or set(spec) not in (
+            {'source','source_sha256'}, {'source','source_sha256','columns'}):
+        return refuse('png_ruled_table_invalid_spec')
+    whole_grid = 'columns' not in spec
+    source = _path(spec['source'])
+    expected, selected = spec['source_sha256'], spec.get('columns')
+    if (PurePosixPath(source).suffix.lower() != '.png'
+            or not isinstance(expected, str) or not re.fullmatch(r'[0-9a-f]{64}', expected)):
+        return refuse('png_ruled_table_invalid_spec')
+    if not whole_grid and (not isinstance(selected, list) or not 1 <= len(selected) <= 8
+            or any(not isinstance(item, dict) or set(item) != {'heading','type'}
+                   or not isinstance(item['heading'], str) or not 1 <= len(item['heading']) <= 40
+                   or not item['heading'].isalpha() or item['type'] not in ('integer','decimal_comma')
+                   for item in selected)
+            or len({item['heading'] for item in selected}) != len(selected)):
+        return refuse('png_ruled_table_invalid_spec')
+    data, identity = _source(cap, source)
+    if hashlib.sha256(data).hexdigest() != expected:
+        return refuse('png_ruled_table_source_changed')
+    sources = [(source, data, identity)]
+    try:
+        check(cap)
+        grid = extract_ruled_png(data)
+    except LocalOCRFailure as error:
+        return _ruled_ocr_error(call, error)
+    check(cap)
+    _verify(cap, sources)
+    if whole_grid:
+        values, provenance, unresolved, uncertain_headers = _whole_ruled_draft(grid, expected)
+        if sum(cell['row'] > 1 for cell in unresolved) == (grid['rows'] - 1) * grid['columns']:
+            return refuse('png_ruled_table_no_body_candidate')
+    else:
+        count = grid['rows']
+        cells = {(item['row'],item['column']):item for item in grid['cells']}
+        observed = {item['selector']:item['column'] for item in _ruled_header_options(grid) if item['selector']}
+        if any(item['heading'] not in observed for item in selected):
+            return refuse('png_ruled_table_heading_unsupported')
+        columns = [observed[item['heading']] for item in selected]
+        patterns = {'integer':r'-?(?:0|[1-9][0-9]{0,14})',
+                    'decimal_comma':r'-?(?:0|[1-9][0-9]{0,12}),[0-9]{2}'}
+        values, unresolved = [], []
+        provenance = [
+            ['OCR draft: verify every candidate from the source.', '', '', '', '', '', '', '', '', '', ''],
+            ['Source SHA-256',expected,'Header text and units are not verified.', '', '', '', '', '', '', '', ''],
+            ['Output row','Output column','Source row','Source column','Left','Top',
+             'Right (exclusive)','Bottom (exclusive)','State','Raw OCR','Requested heading'],
+        ]
+        for i, c in enumerate(columns, 1):
+            header = cells[1,c]
+            provenance.append([0,i,1,c,*header['box'],'HEADER_CANDIDATE',
+                               ' '.join(word['text'] for word in header['words']),selected[i-1]['heading']])
+        for r in range(2, count + 1):
+            row = []
+            for i, c in enumerate(columns, 1):
+                item = cells[r,c]
+                words = item['words']
+                raw = ' '.join(word['text'] for word in words)
+                kind = selected[i-1]['type']
+                if len(words) == 1 and words[0]['confidence'] >= 80 and re.fullmatch(patterns[kind],raw):
+                    row.append({'type':'decimal','value':raw.replace(',','.')})
+                    status = 'UNVERIFIED_OCR_CANDIDATE'
+                else:
+                    row.append('[НЕРАЗБОРЧИВО]')
+                    status = 'UNRESOLVED'
+                    unresolved.append({'row':r-1,'column':i,'source_box':item['box']})
+                provenance.append([r-1,i,r,c,*item['box'],status,raw,selected[i-1]['heading']])
+            values.append(row)
+        if not any(isinstance(cell,dict) for row in values for cell in row):
+            return refuse('png_ruled_table_no_numeric_candidate')
+    draft = {'name':'OCR draft','rows':values}
+    if whole_grid:
+        draft['column_widths'] = [
+            min(80,max(16, max(len(cell) if isinstance(cell,str) else 0 for cell in column) + 8))
+            for column in zip(*values)]
+    try:
+        sheets, tables, names = create_document({'sheets':[
+            draft,{'name':'Source evidence','rows':provenance}]})
+        encoded = render_document(sheets, checkpoint=lambda:check(cap), tables=tables, names=names)
+    except TableRefused:
+        return refuse('png_ruled_table_output_unsupported')
+    facts = {'source_sha256':expected,'rows':len(values),'columns':len(values[0]),
+        'unresolved_cells':unresolved,'provenance_sheet':'Source evidence',
+        'numeric_values_verified':False,'heading_and_unit_fidelity_verified':False}
+    if whole_grid:
+        facts.update(projection='whole_grid', uncertain_headers=uncertain_headers,
+                     column_types_verified=False)
+    estimate = dict(facts,success=True,path=relative,format='png_ruled_table_xlsx',
+                    scope='own_user_workspace',create_only=True,verified=True,
+                    bytes_written=len(encoded),sha256=hashlib.sha256(encoded).hexdigest())
+    budget = _inline_budget()
+    if not _fits(estimate,budget):
+        return refuse('capacity') if whole_grid else _capacity(budget)
+    _verify(cap, sources)
+    result = json.loads(_create_bytes(cap,fd,leaf,relative,encoded,
+        output_format='png_ruled_table_xlsx',verify_source=lambda:_verify(cap,sources)))
+    if result.get('success'):
+        result.update(facts)
+    return _encode(result)
