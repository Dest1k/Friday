+    data, identity = _source(cap, relative)
+    try:
+        grid = extract_ruled_png(data, headers_only=True)
+    except LocalOCRFailure as error:
+        return _ruled_ocr_error(call, error)
+    check(cap)
+    _verify(cap, [(relative, data, identity)])
+    result = {'success':True, 'scope':'own_user_workspace', 'path':relative,
+        'source_sha256':hashlib.sha256(data).hexdigest(),
+        'source_geometry':[grid['width'], grid['height']],
+        'physical_rows':grid['rows'], 'physical_columns':grid['columns'],
+        'pixel_box_convention':'source [left,top,right,bottom) half-open',
+        'headers':_ruled_header_options(grid),
+        'body_ocr_performed':False, 'full_headings_verified':False,
+        'column_types_verified':False, 'currency_and_units_verified':False}
+    # Ambiguity is assessed across the full first row; never return a silent
