+def _whole_ruled_draft(grid, source_sha256):
+    """Keep every physical cell; type only bounded unambiguous numeral syntax."""
+    import re
+    from unicodedata import category
+
+    unresolved_marker = '[НЕРАЗБОРЧИВО]'
+    unverified_header = '[ЗАГОЛОВОК НЕ ПОДТВЕРЖДЁН]'
+    unverified_fragment = '[ФРАГМЕНТ НЕ ПОДТВЕРЖДЁН]'
+    reserved = (unresolved_marker, unverified_header, unverified_fragment)
+    integer = r'-?(?:0|[1-9][0-9]{0,14})'
+    decimal_comma = r'-?(?:0|[1-9][0-9]{0,12}),[0-9]{2}'
+    values = [[] for _ in range(grid['rows'])]
+    provenance = [
+        ['OCR draft: verify every candidate from the source.', '', '', '', '', '', '', '', '', '', ''],
+        ['Source SHA-256',source_sha256,'Header text, units and column roles are not verified.', '', '', '', '', '', '', '', ''],
+        ['Output row','Output column','Source row','Source column','Left','Top',
+         'Right (exclusive)','Bottom (exclusive)','State','Raw OCR (unverified)',''],
+    ]
+    unresolved_cells = []
+    uncertain_headers = []
+    for cell in grid['cells']:
+        row, column, words = cell['row'], cell['column'], cell['words']
+        raw = ' '.join(word['text'] for word in words)
+        good = bool(words) and all(word['confidence'] >= 80 for word in words)
+        observed_text = any(ch.isalnum() for ch in raw)
+        coords = {'row':row,'column':column,'source_box':cell['box']}
+        value = unresolved_marker
+        if row == 1:
+            value = unverified_header
+            state = 'UNRESOLVED_HEADER'
+            if words and words[0]['confidence'] >= 80:
+                first = words[0]['text']
+                # Do not interpret a lone letter after a separator as a unit.
+                # Actual observed symbols or complete text stay literal OCR candidates.
+                ambiguous_suffix = first.endswith(',') and (len(words) == 1 or any(
+                    len(word['text']) == 1 and word['text'].isalpha() for word in words[1:]))
+                has_label = observed_text or any(category(ch) in ('Sc','Sm','So') for ch in raw)
+                if good and has_label and not ambiguous_suffix:
+                    value = raw + ' [OCR]'
+                    state = 'UNVERIFIED_OCR_HEADER'
+                elif first.removesuffix(',').isalpha():
+                    value = first + ' ' + unverified_fragment
+                    state = 'UNRESOLVED_HEADER_SUFFIX'
+            uncertain_headers.append({**coords,'status':state})
+        elif not good or not observed_text:
+            state = 'UNRESOLVED'
+        elif len(words) == 1 and (re.fullmatch(integer,raw) or re.fullmatch(decimal_comma,raw)):
+            value = {'type':'decimal','value':raw.replace(',','.')}
+            state = 'UNVERIFIED_OCR_NUMERIC'
+        else:
+            # Preserve text, leading zeros, unfamiliar separators and any formula-
+            # looking tokens as inert strings. No expression can become a formula.
+            value = '[OCR] ' + raw if raw in reserved or raw.startswith('[OCR] ') else raw
+            state = 'UNVERIFIED_OCR_TEXT'
+        if state in ('UNRESOLVED', 'UNRESOLVED_HEADER'):
+            unresolved_cells.append(coords)
+        values[row-1].append(value)
+        provenance.append([row,column,row,column,*cell['box'],state,raw,''])
+    return values, provenance, unresolved_cells, uncertain_headers
+
