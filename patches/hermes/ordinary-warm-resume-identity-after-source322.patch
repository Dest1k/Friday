+@pytest.mark.parametrize("anchor", ["uid", "coalesced", "legacy"])
+def test_warm_resume_and_branch_keep_unflushed_turn_with_identical_reply(tmp_path, anchor):
+    from agent.message_metadata import ABSORBED_MESSAGE_UIDS
+    from hermes_state import SessionDB
+
+    user_uid, blank_uid, saved_uid, pending_uid, new_reply_uid = (str(i) * 32 for i in range(1, 6))
+    reply = "The line is recorded."
+    pending = {"role": "user", "content": "Add the accessibility desk.", "message_uid": pending_uid}
+    new_reply = {"role": "assistant", "content": reply, "message_uid": new_reply_uid}
+    with contextlib.closing(SessionDB(db_path=tmp_path / "state.db")) as db:
+        db.create_session("s1", source="tui")
+        db.append_message("s1", "user", "Set the seating line.", message_uid=user_uid)
+        if anchor == "coalesced":
+            db.append_message("s1", "assistant", "", message_uid=blank_uid)
+        row = db.append_message("s1", "assistant", reply, message_uid=saved_uid, finish_reason="stop")
+        if anchor == "legacy":
+            db._conn.execute("UPDATE messages SET message_uid = NULL WHERE id = ?", (row,))
+        model_history, display_history = db.get_resume_conversations("s1")
+        persisted_uid = None if anchor == "legacy" else saved_uid
+        assert display_history[-1].get("message_uid") == persisted_uid
+        if anchor == "coalesced":
+            assert model_history[-1]["message_uid"] == blank_uid
+            assert saved_uid in model_history[-1][ABSORBED_MESSAGE_UIDS]
+        else:
+            assert model_history[-1].get("message_uid") == persisted_uid
+
+        history = [*model_history, pending, new_reply]
+        live = server._live_visible_history({"session_key": "s1"}, db, history)
+        assert live == [*display_history, pending, new_reply]
+
+        session = {"history": history, "history_lock": threading.RLock()}
+        branch = server._branch_source_history(db, session, "s1")
+        assert [item.get("message_uid") for item in branch] == [user_uid, persisted_uid, pending_uid, new_reply_uid]
+
+
+def test_reconcile_display_uses_legacy_text_only_for_incomparable_identities():
+    saved = {"role": "assistant", "content": "Recorded.", "message_uid": "saved"}
+    other = dict(saved, message_uid="distinct")
+    pending = {"role": "user", "content": "Tail"}
+    legacy = dict(saved, message_uid=None)
+    assert server._reconcile_display_with_live([saved], [other, pending]) == [saved]
+    assert server._reconcile_display_with_live([saved], [legacy, pending]) == [saved, pending]
+    assert server._reconcile_display_with_live([saved], [saved, pending, legacy]) == [saved, pending, legacy]
+
+    persisted = dict(legacy, _row_id=4, _db_persisted=True, timestamp=10.0)
+    later = dict(other, _row_id=6, _db_persisted=True, timestamp=11.0)
+    assert server._reconcile_display_with_live([persisted], [persisted, pending, later]) == [persisted, pending, later]
 
 
