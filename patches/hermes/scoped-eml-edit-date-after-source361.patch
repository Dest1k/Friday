+def _edit_eml_date(data, spec, checkpoint):
+    old = _eml_date(spec['old_value'])
+    new = _eml_date(spec['new_value'])
+    if old == new:
+        _fail('no_op')
+    match = _header_separator(data)
+    header = data[:match.start()]
+    lines = header.splitlines(keepends=True)
+    found = []
+    offset = 0
+    for index, line in enumerate(lines):
+        raw = line.rstrip(b'\r\n')
+        start, end = offset, offset + len(line)
+        offset = end
+        if raw.lower().startswith(b'date:'):
+            colon = raw.find(b':')
+            value_start = colon + 1
+            while value_start < len(raw) and raw[value_start:value_start + 1] in (b' ', b'\t'):
+                value_start += 1
+            value = raw[value_start:]
+            if index + 1 < len(lines) and lines[index + 1][:1] in (b' ', b'\t'):
+                _fail('unsupported_date_folding')
+            found.append((start, end, value, raw[:value_start], line[len(raw):]))
+    if len(found) != 1:
+        _fail('date_target_not_unique')
+    start, end, value, prefix, ending = found[0]
+    if value != old.encode('ascii'):
+        _fail('precondition_mismatch')
+    # Verify the actual parsed source Date and raw header through the existing
+    # Source361 readback before accepting the target.
+    _read_eml(data, checkpoint, expected_date=old)
+    message = BytesParser(policy=policy.default).parsebytes(data, headersonly=True)
+    if (message.get_content_type() in ('multipart/signed', 'multipart/encrypted',
+                                        'application/pkcs7-mime', 'application/pkcs7-signature',
+                                        'application/x-pkcs7-mime', 'application/x-pkcs7-signature')
+            or any(name.lower() in EML_INTEGRITY_HEADERS for name in message.keys())):
+        _fail('unsupported_date_edit_target')
+    output = data[:start] + prefix + new.encode('ascii') + ending + data[end:]
+    if len(output) > MAX_BYTES:
+        _fail('output_limit')
+    _checkpoint(checkpoint)
+    _read_eml(output, checkpoint, expected_date=new)
+    return output
+
