+def _writer_roundtrip_source(word, checkpoint):
+    # Exact passive metadata emitted by Writer for this bounded structured
+    # DOCX profile. Text and table values are checked by the usual inventory.
+    package = word.pkg
+    stock = {
+        'word/settings.xml': ('settings', 'wordprocessingml.settings',
+                              '76a170254663378c1f09c71f1efc532b38c16388ba851f5f47bedb4c9cb9cdbf'),
+        'word/theme/theme1.xml': ('theme', 'theme',
+                                  '8c817dba7260b1c6e49fc7937dd857b5f42d834bc8c33769d788ea824cb2c29f'),
+        'word/styles.xml': ('styles', 'wordprocessingml.styles',
+                            '15a4e1eac55d9daa74d8c2b4fc3986f121f2172cf00a31397f3e677ad96f6523'),
+        'word/numbering.xml': ('numbering', 'wordprocessingml.numbering',
+                               '26ce28a2f539b8c00ee191c8f4c9af9eec055513e16416d7d5ea4059cf98a2af'),
+        'word/fontTable.xml': ('fontTable', 'wordprocessingml.fontTable',
+                               '5c05b4701b8e543609a75ad8f68c51baf76d57bb6e3b5acd79fa2ff3bf840c23'),
+    }
+    for name, (relationship, content_type, digest) in stock.items():
+        _tick(checkpoint)
+        kind = R + '/' + relationship
+        links = [(owner, selected, target) for owner, rows in package.relationships.items()
+                 for selected, target in rows.values() if target == name or selected == kind]
+        if (links != [('word/document.xml', kind, name)]
+                or package.types.get(name) != 'application/vnd.openxmlformats-officedocument.' + content_type + '+xml'
+                or hashlib.sha256(package.parts.get(name, b'')).hexdigest() != digest):
+            return False
+    document_part = 'word/document.xml'
+    expected_parts = set(stock) | {
+        document_part, 'word/_rels/document.xml.rels', '_rels/.rels',
+        'docProps/core.xml', 'docProps/app.xml', '[Content_Types].xml',
+    }
+    if set(package.parts) != expected_parts:
+        return False
+    raw = package.parts[document_part]
+    without_declaration = re.sub(rb'\A<\?xml[ \t\r\n][^?]*\?>', b'', raw, count=1)
+    if b'<?' in without_declaration:
+        return False
+    namespaces = {}
+    for event, value in iterparse(BytesIO(raw), events=('start-ns', 'start')):
+        if event == 'start':
+            break
+        prefix, namespace = value
+        namespaces[prefix] = namespace
+    if any(namespaces.get(prefix) != expected for prefix, expected in {
+            'w14': 'http://schemas.microsoft.com/office/word/2010/wordml',
+            'wp14': 'http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing',
+            'w15': 'http://schemas.microsoft.com/office/word/2012/wordml',
+    }.items()):
+        return False
+    projection = []
+    for node in package.xml[document_part].iter():
+        _tick(checkpoint)
+        projection.append((node.tag, len(node), sorted(node.attrib.items()),
+                           None if node.tag == q(W, 't') else node.text, node.tail))
+    body = json.dumps(projection, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
+    return hashlib.sha256(body).hexdigest() == '8f48e2b142080d9c9f089241b05d17259acaaf2573249e48397ead51d97ab116'
