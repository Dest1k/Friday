+def make_heading_inventory(roundtrip, nested_outline):
+    c = conversion
+    parser = c._ODF.__new__(c._ODF)
+    parser._writer_roundtrip = roundtrip
+    parser.native_output = True
+    checked = []
+
+    def style(name, family):
+        checked.append((name, family))
+
+    parser.style = style
+    parser.paragraph = lambda node, **context: (node.get(c.q(c.T, 'outline-level')), context)
+    prefix = f'xmlns:t="{c.T}" xmlns:s="{c.S}"'
+    levels = ''.join(
+        f'<t:list-level-style-number t:level="{level}" t:style-name="Label{level}" s:num-format="">'
+        '<s:list-level-properties t:list-level-position-and-space-mode="label-alignment">'
+        '<s:list-level-label-alignment t:label-followed-by="nothing"/>'
+        '</s:list-level-properties></t:list-level-style-number>'
+        for level in (1, 2)
+    )
+    parser.list_styles = {
+        'Numbering': ElementTree.fromstring(f'<t:list-style {prefix} s:name="Numbering">{levels}</t:list-style>')
+    }
+    wrapper = ElementTree.fromstring(
+        f'<t:list {prefix} t:style-name="Numbering"><t:list-item><t:list><t:list-item>'
+        f'<t:h t:outline-level="{nested_outline}">Second heading</t:h>'
+        '</t:list-item></t:list></t:list-item></t:list>'
+    )
+    return parser, wrapper, checked
+
+
+def test_verified_writer_roundtrip_consumes_both_empty_heading_levels():
+    parser, wrapper, checked = make_heading_inventory(True, 2)
+    assert parser.empty_heading_list(wrapper) == (
+        '2', {'empty_list': 'Numbering', 'list_level': '2'}
+    )
+    assert checked == [('Label1', 'text'), ('Label2', 'text')]
+
+
+@pytest.mark.parametrize(('roundtrip', 'level'), [(False, 2), (True, 3)])
+def test_nested_empty_heading_must_match_verified_writer_shape(roundtrip, level):
+    parser, wrapper, _ = make_heading_inventory(roundtrip, level)
+    with pytest.raises(conversion.WordConversionError):
+        parser.empty_heading_list(wrapper)
