+"""Verify signed Telegram Mini App data before protected ODT reads a body."""
+
+import base64
+import json
+import math
+import re
+import time
+from urllib.parse import parse_qsl
+
+from cryptography.exceptions import InvalidSignature
+from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
+
+from hermes_cli.friday_product_access import profile_name
+
+
+_AUTH_SCHEME = b'TelegramMiniApp '
+_MAX_CREDENTIAL_BYTES = 4096
+_MAX_TELEGRAM_ID = (1 << 52) - 1
+_PRODUCTION_PUBLIC_KEY = bytes.fromhex(
+    'e7bf03a2fa4602af4580703d88dda5bb59f32ed8b02a56c187fe7d34caed242d'
+)
+_FIELD_NAME = re.compile(r'[a-z][a-z0-9_]{0,63}')
+_BAD_PERCENT_ESCAPE = re.compile(r'%(?![0-9a-fA-F]{2})')
+_SIGNATURE = re.compile(r'[A-Za-z0-9_-]{86}(?:==)?')
+_TIMESTAMP = re.compile(r'[1-9][0-9]{0,10}')
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError('duplicate Telegram user field')
+        result[key] = value
+    return result
+
+
+def _reject_constant(_value):
+    raise ValueError('invalid Telegram user field')
+
+
+def _telegram_id(value):
+    return type(value) is int and 1 <= value <= _MAX_TELEGRAM_ID
+
+
+def build_telegram_verifier(transport_profile, bot_id, *, max_age_seconds, clock=time.time):
+    """Bind the verifier to one production bot and transport profile.
+
+    This returns a Telegram principal only. The native session and its one-use
+    ticket still authorize each document operation.
+    """
+    profile_name(transport_profile)
+    if (not _telegram_id(bot_id) or type(max_age_seconds) is not int
+            or not 0 < max_age_seconds < 10**11 or not callable(clock)):
+        raise ValueError('invalid Telegram proof configuration')
+    key = Ed25519PublicKey.from_public_bytes(_PRODUCTION_PUBLIC_KEY)
+    signing_prefix = f'{bot_id}:WebAppData\n'
+    bot = str(bot_id)
+
+    def verify(credential):
+        if (type(credential) is not bytes or len(credential) > _MAX_CREDENTIAL_BYTES
+                or not credential.startswith(_AUTH_SCHEME)):
+            return None
+        try:
+            query = credential[len(_AUTH_SCHEME):].decode('ascii')
+            if any(not 33 <= ord(char) <= 126 for char in query) or _BAD_PERCENT_ESCAPE.search(query):
+                return None
+            fields = {}
+            for name, value in parse_qsl(query, keep_blank_values=True, strict_parsing=True,
+                                         encoding='utf-8', errors='strict', max_num_fields=48):
+                if (not _FIELD_NAME.fullmatch(name) or name in fields
+                        or any(char in value for char in '\r\n\0')):
+                    return None
+                fields[name] = value
+            timestamp = fields.get('auth_date', '')
+            encoded_signature = fields.pop('signature', '')
+            fields.pop('hash', None)
+            if not _TIMESTAMP.fullmatch(timestamp) or not _SIGNATURE.fullmatch(encoded_signature):
+                return None
+            canonical = encoded_signature.rstrip('=')
+            signature = base64.urlsafe_b64decode(canonical + '==')
+            if base64.urlsafe_b64encode(signature).decode('ascii').rstrip('=') != canonical:
+                return None
+            signed = signing_prefix + '\n'.join(f'{name}={fields[name]}' for name in sorted(fields))
+            key.verify(signature, signed.encode('utf-8'))
+            now = clock()
+            if type(now) not in (int, float) or not math.isfinite(now):
+                return None
+            age = now - int(timestamp)
+            if not 0 <= age <= max_age_seconds:
+                return None
+            user = json.loads(fields['user'], object_pairs_hook=_unique_object,
+                              parse_constant=_reject_constant)
+            if type(user) is not dict or not _telegram_id(user.get('id')):
+                return None
+            return 'telegram', transport_profile, bot, str(user['id'])
+        except (InvalidSignature, KeyError, OverflowError, RecursionError, ValueError):
+            return None
+
+    return verify
