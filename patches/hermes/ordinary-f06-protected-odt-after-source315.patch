+def _encode_edit(edit):
+    if type(edit) is not dict or set(edit) != {'old_text', 'new_text'}:
+        raise ODFPasswordError('odf_edit_schema')
+    old, new = edit['old_text'], edit['new_text']
+    if (type(old) is not str or not 0 < len(old) <= _MAX_EDIT_BYTES
+            or type(new) is not str or len(new) > _MAX_EDIT_BYTES):
+        raise ODFPasswordError('odf_native_edit_refused')
+    try:
+        old_bytes, new_bytes = old.encode('utf-8'), new.encode('utf-8')
+    except UnicodeError:
+        raise ODFPasswordError('odf_native_edit_refused') from None
+    if len(old_bytes) > _MAX_EDIT_BYTES or len(new_bytes) > _MAX_EDIT_BYTES:
+        raise ODFPasswordError('odf_native_edit_refused')
+    return old_bytes, new_bytes
