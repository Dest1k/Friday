+
+def _exchange(process, fields, deadline, checkpoint):
+    """Bound output and write fields separately so the owned password stays mutable."""
+    output = bytearray()
+    limit = _RESPONSE.size + MAX_BYTES + _MAX_METADATA
+    with selectors.DefaultSelector() as selector:
+        for stream in (process.stdin, process.stdout):
+            os.set_blocking(stream.fileno(), False)
+        selector.register(process.stdin, selectors.EVENT_WRITE)
+        selector.register(process.stdout, selectors.EVENT_READ)
+        pieces = iter(memoryview(field) for field in fields if field)
+        field = next(pieces)
+        sent = 0
+        while selector.get_map():
+            checkpoint()
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise ODFPasswordError('odf_codec_timeout')
+            for key, _ in selector.select(min(.05, remaining)):
+                if key.fileobj is process.stdin:
+                    try:
+                        sent += os.write(key.fd, field[sent:sent + _CHUNK])
+                    except BrokenPipeError:
+                        field = None
+                    except BlockingIOError:
+                        continue
+                    if field is not None and sent == len(field):
+                        field, sent = next(pieces, None), 0
+                    if field is None:
+                        selector.unregister(key.fileobj)
+                        process.stdin.close()
+                else:
+                    try:
+                        chunk = os.read(key.fd, min(_CHUNK, limit + 1 - len(output)))
+                    except BlockingIOError:
+                        continue
+                    if not chunk:
+                        selector.unregister(key.fileobj)
+                    else:
+                        output.extend(chunk)
+                        if len(output) > limit:
+                            raise ODFPasswordError('odf_codec_invalid_frame')
+    return output
+
+
+def _read_metadata(raw, operation):
+    metadata = json.loads(raw)
+    if type(metadata) is not dict:
+        raise ValueError()
+    modern = metadata.get('modern_profile') == _PROFILE
+    if operation == _READ:
+        expected = dict(encrypted=True, decrypted_for_read_only=True)
+        if modern:
+            expected.update(modern_profile=_PROFILE, password_verification='AEAD_TAG_MATCHED',
+                            data_integrity_verified=True, encryption_authenticity=_AUTHENTICITY,
+                            encrypted_members=1, algorithms=[AES_GCM])
+        else:
+            count = metadata.get('encrypted_members')
+            algorithms = metadata.get('algorithms')
+            if (type(count) is not int or not 1 <= count <= 64 or type(algorithms) is not list
+                    or not algorithms or any(type(name) is not str for name in algorithms)
+                    or algorithms != sorted(set(algorithms))
+                    or not set(algorithms) <= (set(AES_NAMES) | BLOWFISH)):
+                raise ValueError()
