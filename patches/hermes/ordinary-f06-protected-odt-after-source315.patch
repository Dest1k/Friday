@@ -0,0 +1,305 @@
+"""Callback-only confirmation for already authorized native F06 intents.
+
+The caller owns the original retained approval, the active owner lookup and the
+private ticket handoff. This path keeps neither credentials nor issued tickets.
+"""
+import asyncio
+from dataclasses import dataclass
+import inspect
+import json
+import re
+import secrets
+import time
+
+
+_NAMESPACE = "f06"
+_MAX_PENDING = 128
+_NONCE = re.compile(r"[A-Za-z0-9_-]{24}")
+_REFUSED = "Подтверждение F06 недоступно."
+_APPROVED = "Действие F06 подтверждено."
+
+
+@dataclass(slots=True, repr=False)
+class _Prompt:
+    authority: object
+    adapter: object
+    bot: object
+    transport_generation: int
+    loop: object
+    accept_ticket: object
+    on_cancel: object
+    offer_miniapp: object
+    nonce: str
+    deadline: float
+    label: str
+    card_id: str | None = None
+    claiming: bool = False
+
+    @property
+    def chat_id(self):
+        return self.authority.publication.chat_id
+
+    @property
+    def thread_id(self):
+        return self.authority.publication.thread_id
+
+    @property
+    def upload_message(self):
+        return self.authority.publication.upload_message
+
+    @property
+    def runtime_profile(self):
+        return self.authority.approval.binding.profile
+
+    @property
+    def actor_id(self):
+        return self.authority.approval.binding.principal[3]
+
+    @property
+    def key(self):
+        # Ordinary sc: payloads only resolve string keys in the same map.
+        return (_NAMESPACE, self.nonce)
+
+    def _bound(self):
+        return (asyncio.get_running_loop() is self.loop and self.adapter._bot is self.bot
+                and self.adapter._polling_generation == self.transport_generation
+                and self.adapter._slash_confirm_state.get(self.key) is self
+                and time.monotonic() < self.deadline)
+
+    def available(self):
+        return not self.claiming and self._bound()
+
+    def _matches_card(self, message, *, edited=False):
+        from telegram import Message
+        from hermes_cli.friday_protected_odt import COPY
+
+        if type(message) is not Message:
+            return False
+        sender, reply = message.from_user, message.reply_to_message
+        return (message.get_bot() is self.bot and message.chat.type == "private"
+                and message.business_connection_id is None and message.forward_origin is None
+                and message.via_bot is None and (edited or message.edit_date is None)
+                and str(message.chat.id) == self.chat_id
+                and (self.adapter._effective_message_thread_id(message) or "") == self.thread_id
+                and sender is not None and sender.is_bot is True
+                and str(sender.id) == self.authority.approval.binding.principal[2]
+                and type(reply) is Message and str(reply.message_id) == self.upload_message
+                and reply.chat.id == message.chat.id and reply.get_bot() is self.bot
+                and reply.business_connection_id is None
+                and type(message.message_id) is int and message.message_id > 0
+                and str(message.message_id) != self.upload_message
+                and (self.authority.approval.operation != COPY or message.text == self.label))
+
+    def mark_sent(self, adapter, message):
+        """Bind only the message actually returned from the stock bot send."""
+        if adapter is not self.adapter or self.card_id is not None or not self.available() or not self._matches_card(message):
+            raise ValueError("f06_prompt_receipt_refused")
+        self.card_id = str(message.message_id)
+
+    def callback_source(self, query, cb):
+        """Read the exact actor and card before touching confirmation state."""
+        if (not self.available() or self.card_id is None
+                or query.from_user.is_bot is not False or str(query.from_user.id) != self.actor_id
+                or not self._matches_card(query.message) or str(query.message.message_id) != self.card_id
+                or str(cb["chat_id"]) != self.chat_id):
+            return None
+        if self.adapter._is_callback_user_authorized(
+                self.actor_id, chat_id=self.chat_id, chat_type="private",
+                thread_id=self.thread_id or None, user_name=cb["user_name"]) is not True:
+            return None
+        source = self.adapter.build_source(
+            chat_id=self.chat_id, chat_type="dm", user_id=self.actor_id,
+            is_bot=False, thread_id=self.thread_id or None,
+        )
+        if self.adapter._canonicalize(source) is None:
+            return None
+        return source
+
+    def resolve(self, choice, source):
+        """Run the exact claim without yielding on the owning Gateway loop."""
+        from hermes_cli.friday_protected_odt import IntakeRefused
+
+        if not self.available() or not self.authority.current(fresh_source=source) or not self.available():
+            return _REFUSED
+        state = self.adapter._slash_confirm_state
+        if choice == "cancel":
+            del state[self.key]
+            if self.on_cancel is not None:
+                self.on_cancel()
+            return "Подтверждение F06 отменено."
+        # The only state-changing authority below this fence is the exact
+        # existing one-use owner. Synchronous reentry also cannot claim twice.
+        self.claiming = True
+        binding = self.authority.approval.binding
+        owner = self.authority.owner
+        ticket = None
+        handed_off = consumed = False
+        try:
+            from hermes_cli.friday_user_scope import current
+
+            with self.authority.runner._profile_scope_for_source(self.authority.source):
+                if (current(required=True) is not self.authority.publication.owner
+                        or not self.authority._turn_current() or not self._bound()
+                        or state is not self.adapter._slash_confirm_state):
+                    return _REFUSED
+                try:
+                    ticket = owner.issue(self.authority.approval)
+                except IntakeRefused:
+                    return _REFUSED
+                if (not self.authority._turn_current() or not self._bound()
+                        or state is not self.adapter._slash_confirm_state):
+                    return _REFUSED
+                del state[self.key]
+                consumed = True
+                handed_off = self.accept_ticket(binding, ticket) is True
+                return _APPROVED if handed_off else _REFUSED
+        finally:
+            try:
+                if ticket is not None and not handed_off:
+                    try:
+                        owner.cancel(binding, ticket)
+                    finally:
+                        if consumed and self.on_cancel is not None:
+                            self.on_cancel()
+            finally:
+                self.claiming = False
+
+
+def _display_literal(value):
+    rendered = json.dumps(value, ensure_ascii=False)
+    return "".join(char if char.isprintable() else json.dumps(char)[1:-1] for char in rendered)
+
+
+def _prompt_label(authority):
+    from hermes_cli.friday_protected_odt import COPY, READ
+
+    raw_name = authority.event.raw_message.document.file_name
+    if (type(raw_name) is not str or not 0 < len(raw_name) <= 255
+            or not raw_name.isprintable() or "/" in raw_name or "\\" in raw_name):
+        return None
+    if authority.approval.operation == READ:
+        return f"Прочитать защищённый ODT «{raw_name}»?"
+    if authority.approval.operation == COPY:
+        approval = authority.approval
+        label = "\n".join((
+            f"Создать зашифрованную копию ODT {_display_literal(raw_name)}?",
+            f"Сохранить в {_display_literal(approval.destination)}",
+            f"Заменить {_display_literal(approval.old_text)}",
+            f"На {_display_literal(approval.new_text)}",
+            "Пароль вводится в защищённой форме после подтверждения.",
+        ))
+        # Telegram limits message length after HTML entities are parsed.
+        if len(label.encode("utf-16-le")) <= 8192:
+            return label
+    return None
+
+
+async def register_confirmation(runner, adapter, event, approval, owner, *, owner_is_current,
+                                accept_ticket, on_cancel=None, offer_miniapp=None):
+    """Send one exact confirmation card for an already authorized protected intent.
+
+    Both provided callbacks are synchronous trusted gateway wiring. The ticket
+    callback only hands the value to the private consumer for this binding.
+    """
+    from gateway.ordinary_f06_authority import capture
+    from hermes_cli.friday_protected_odt import TTL_SECONDS
+
+    if (not callable(accept_ticket) or not callable(owner_is_current)
+            or inspect.iscoroutinefunction(accept_ticket) or inspect.iscoroutinefunction(owner_is_current)
+            or (offer_miniapp is not None and not inspect.iscoroutinefunction(offer_miniapp))
+            or (on_cancel is not None and (not callable(on_cancel) or inspect.iscoroutinefunction(on_cancel)))):
+        return False
+    authority = capture(runner, adapter, event, approval, owner, owner_is_current)
+    if authority is None:
+        return False
+    label = _prompt_label(authority)
+    bot = adapter._bot
+    transport_generation = getattr(adapter, "_polling_generation", None)
+    if label is None or bot is None or type(transport_generation) is not int or transport_generation < 0:
+        return False
+    now = time.monotonic()
+    loop = asyncio.get_running_loop()
+    state = adapter._slash_confirm_state
+    pending = []
+    for key, record in tuple(state.items()):
+        if type(record) is not _Prompt:
+            continue
+        transport_replaced = (record.loop is loop and
+                              (record.bot is not bot or record.transport_generation != transport_generation))
+        if not record.claiming and (now >= record.deadline or transport_replaced):
+            del state[key]
+        else:
+            pending.append(record)
+    if (len(pending) >= _MAX_PENDING
+            or any(record.authority.session_key == authority.session_key or record.authority.owner is owner
+                   for record in pending)):
+        return False
+    prompt = _Prompt(authority, adapter, bot, transport_generation, loop, accept_ticket,
+                     on_cancel, offer_miniapp, secrets.token_urlsafe(18), now + TTL_SECONDS, label)
+    if prompt.key in state:
+        return False
+    state[prompt.key] = prompt
+    accepted = False
+    try:
+        sent = await adapter.send_f06_confirmation(prompt)
+        accepted = (prompt.available() and sent.success is True
+                    and prompt.card_id is not None and sent.message_id == prompt.card_id
+                    and authority.current())
+        return accepted
+    finally:
+        if not accepted and state.get(prompt.key) is prompt:
+            del state[prompt.key]
+
+
+def revoke_confirmation(adapter, owner, approval):
+    """Remove only the prompt owned by this exact terminating operation."""
+    loop = asyncio.get_running_loop()
+    state = adapter._slash_confirm_state
+    for key, record in tuple(state.items()):
+        if (type(record) is _Prompt and record.loop is loop and record.adapter is adapter
+                and record.authority.owner is owner and record.authority.approval is approval
+                and state.get(key) is record):
+            del state[key]
+            return True
+    return False
+
+
+def _native_callback(adapter, update, query):
+    from telegram import CallbackQuery, Message, Update
+
+    try:
+        bot = adapter._bot
+        return (bot is not None and type(update) is Update and type(query) is CallbackQuery
+                and update.callback_query is query and update.get_bot() is bot and query.get_bot() is bot
+                and type(update.update_id) is int and update.update_id >= 0
+                and type(query.id) is str and bool(query.id) and query.inline_message_id is None
+                and type(query.message) is Message and update.effective_message is query.message
+                and update.effective_user is query.from_user
+                and type(query.data) is str)
+    except (AttributeError, RuntimeError, TypeError, ValueError):
+        return False
+
+
+async def handle_callback(adapter, update, query, cb):
+    """Handle the private F06 prefix from the existing registered SDK dispatcher."""
+    if not _native_callback(adapter, update, query):
+        return
+    parts = query.data.split(":")
+    if len(parts) != 3 or parts[0] != _NAMESPACE or parts[1] not in ("confirm", "cancel") or not _NONCE.fullmatch(parts[2]):
+        return
