+def _approval_from_turn(runner, adapter, event, operation, destination, old_text, new_text):
+    if type(operation) is not str or operation not in (READ, COPY):
+        return None
+    if operation == READ and any(value is not None for value in (destination, old_text, new_text)):
+        return None
+    if operation == COPY and not matches_copy_action(event, destination, old_text, new_text):
+        return None
