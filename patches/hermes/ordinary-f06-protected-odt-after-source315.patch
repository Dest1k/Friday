+"""Same-origin Mini App page for the exact protected ODT submission."""
+
+from base64 import b64encode
+from hashlib import sha256
+
+
+PAGE_PATH = '/protected-odt/'
+_STYLE = """:root { color-scheme: light dark; font: 1rem/1.5 system-ui, sans-serif; }
+body { margin: 0; padding: 1.5rem 1rem; }
+main { max-inline-size: 40rem; margin-inline: auto; }
+h1 { font-size: 1.4rem; margin: 0 0 1rem; }
+label, input, button { display: block; font: inherit; }
+input { box-sizing: border-box; inline-size: 100%; padding: .55rem .75rem; margin-block: .35rem .8rem; }
+button { padding: .5rem .9rem; }
+pre { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
+"""
+_SCRIPT = r"""(() => {
+    const form = document.querySelector('form');
+    const password = document.querySelector('#password');
+    const button = document.querySelector('button');
+    const status = document.querySelector('[role="status"]');
+    const result = document.querySelector('pre');
+    const launch = new URLSearchParams(location.hash.slice(1)).getAll('tgWebAppData');
+    let authorization = launch.length === 1 && /^[!-~]{1,4079}$/.test(launch[0])
+        ? 'TelegramMiniApp ' + launch[0] : '';
+    launch.fill('');
+    try {
+        history.replaceState(null, '', location.pathname);
+    } catch {
+        authorization = '';
+    }
+
+    const encoder = new TextEncoder();
+    let request;
+    let closed = false;
+    const reopen = 'Откройте Mini App из подтверждения в Telegram.';
+    const uncertain = 'Результат не подтверждён. Проверьте состояние в Telegram.';
+    status.textContent = authorization ? '' : reopen;
+    password.disabled = button.disabled = !authorization;
+    try {
+        const bridge = window.TelegramWebviewProxy;
+        const event = JSON.stringify({eventType: 'web_app_ready', eventData: ''});
+        if (typeof bridge?.postEvent === 'function') {
+            bridge.postEvent('web_app_ready', '');
+        } else if (window.parent !== window) {
+            window.parent.postMessage(event, 'https://web.telegram.org');
+        } else if (typeof window.external?.notify === 'function') {
+            window.external.notify(event);
+        }
+    } catch {
+        // Readiness contains no credentials. The page still serves its normal form.
+    }
+
+    function post(path, headers, body) {
+        return fetch(path, {
+            method: 'POST', headers, body, credentials: 'omit', cache: 'no-store',
+            redirect: 'error', signal: request.signal
+        });
+    }
+
+    form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (!authorization || request || closed) return;
+        const secret = encoder.encode(password.value);
+        password.value = '';
+        if (secret.length === 0 || secret.length > 1024) {
+            secret.fill(0);
+            status.textContent = 'Введите пароль длиной до 1024 байт.';
+            return;
+        }
+
+        const headers = {Authorization: authorization};
+        let payload;
+        authorization = '';
+        request = new AbortController();
+        password.disabled = button.disabled = true;
+        status.textContent = 'Проверяем пароль…';
+
+        try {
+            const response = await post('/v1/protected-odt/ticket', headers);
+            if (response.status !== 200) {
+                if (!closed) status.textContent = reopen;
+                return;
+            }
+            const ticket = (await response.json()).ticket;
+            if (typeof ticket !== 'string' || !/^[A-Za-z0-9_-]{43}$/.test(ticket)) {
+                if (!closed) status.textContent = reopen;
+                return;
+            }
+
+            payload = new Uint8Array(44 + secret.length);
+            payload.set(encoder.encode(ticket), 0);
+            payload[43] = 10;
+            payload.set(secret, 44);
+            secret.fill(0);
+            headers['Content-Type'] = 'application/vnd.friday.protected-odt';
+            const reply = await post('/v1/protected-odt/submit', headers, payload);
+            if (closed) return;
+            if (reply.status === 422) {
+                status.textContent = 'Пароль отклонён. Запросите новое подтверждение в Telegram.';
+                return;
+            }
+            if (reply.status !== 202) {
+                status.textContent = uncertain;
+                return;
+            }
+            const value = await reply.json();
+            if (closed) return;
+            if (value.status === 'accepted' && typeof value.content === 'string'
+                    && typeof value.partial === 'boolean') {
+                status.textContent = value.partial ? 'Показана часть документа.' : 'Документ открыт.';
+                result.textContent = value.content;
+                result.hidden = false;
+            } else if (value.status === 'accepted' && Object.keys(value).length === 1) {
+                status.textContent = 'Зашифрованная копия доставлена в Telegram.';
+            } else {
+                status.textContent = uncertain;
+            }
+        } catch {
+            if (!closed) status.textContent = uncertain;
+        } finally {
+            secret.fill(0);
+            payload?.fill(0);
+            delete headers.Authorization;
+        }
+    });
+
+    addEventListener('pagehide', () => {
+        closed = true;
+        request?.abort();
+        authorization = password.value = result.textContent = '';
+        password.disabled = button.disabled = result.hidden = true;
+        status.textContent = reopen;
+    });
+})();
+""".removeprefix('\\\n')
+
+_DOCUMENT = f"""<!doctype html>
+<html lang="ru">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Защищённый документ</title>
+<style>{_STYLE}</style>
+<main>
+<h1>Защищённый документ</h1>
+<form autocomplete="off">
+<label for="password">Пароль документа</label>
