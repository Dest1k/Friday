+"""Retain an already authorized exact F06 intent for Telegram confirmation.
+
+The caller supplies the original admitted turn and the live native owner
+locator. An attachment publication alone grants no authority to register a
+confirmation or issue a ticket.
+"""
+
+from dataclasses import dataclass, replace
+from hashlib import sha256
+
+from gateway.ordinary_f06_intent import matches_copy_action
+from gateway.run_inbound_media import read_published_odt_input, verify_published_odt_input
+from gateway.session_identity import identity_of
+from gateway.turn_lease import TurnLeaseToken
+from hermes_cli.friday_protected_odt import Approval, Binding, COPY, NativeODTOwner
+from hermes_cli.friday_user_scope import _same_scope, current, guard_tool, workspace_document
+from tools.scoped_odf_password import ODFPasswordError, prepare_read
+
+
+def guard_operation(operation, source, destination):
+    guard_tool("read_file", {"path": source}, execution=False)
+    if operation == COPY:
+        guard_tool("write_file", {"path": destination, "format": "odf_password_edit"}, execution=False)
+
+
+def _password_required(approval, evidence):
+    data, relative, identity = workspace_document(str(evidence.path), with_identity=True)
+    if (relative, identity, sha256(data).hexdigest()) != (approval.source, evidence.source_identity, evidence.sha256):
+        return False
+    try:
+        prepare_read(data, "odt", None)
+    except ODFPasswordError as error:
+        return error.args == ("odf_password_required",)
+    return False
+
+
+def _source_route(source):
+    return (
+        source.platform, source.user_id, source.chat_id, source.chat_type, source.thread_id or "",
+        source.scope_id, source.profile, source.user_id_alt, source.chat_id_alt,
+        source.is_bot, source.role_authorized, source.delivered_via_upstream_relay,
+    )
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class _Authority:
+    runner: object
+    adapter: object
+    event: object
+    source: object
+    approval: Approval
+    owner: NativeODTOwner
+    publication: object
+    session_key: str
+    _owner_is_current: object
+    _identity: object
+    _route: tuple
+    _raw_message: object
+    _raw_document: object
+    _raw_leaf: str
+    _state: object
+    _turn: object
+    _agent: object
+    _lease: TurnLeaseToken
+    _generation: int
+    _active_marker: str
+    _intent: Approval
+
+    def _turn_current(self):
+        lease = self._lease
+        event = self.event
+        state = self.runner._peek_session_state(self.session_key)
+        if (state is not self._state or state.turn is not self._turn
+                or state.turn.agent is not self._agent or state.turn.event is not event
+                or state.persistent.run_generation != self._generation or lease.generation != self._generation
+                or state.turn.lease_tokens.get(self._generation) is not lease
+                or lease.owner_key != self.session_key or lease.session_id != self._intent.binding.session_id
+                or lease.released is not False or lease.lease.holder is not lease
+                or not lease.lease.lock.locked()
+                or event.source is not self.source or event.raw_message is not self._raw_message
+                or event.raw_message.document is not self._raw_document
+                or self._raw_document.file_name != self._raw_leaf
+                or event.message_id != self.publication.upload_message
+                or getattr(event, "_gateway_active_turn_session_key", None) != self.session_key
+                or getattr(event, "_gateway_active_turn_token", None) != self._active_marker
+                or self.approval != self._intent
+                or self.adapter.gateway_runner is not self.runner
+                or self._owner_is_current(self.owner, self.approval.binding) is not True):
+            return False
+
+        if self._intent.operation == COPY and not matches_copy_action(
+            event, self._intent.destination, self._intent.old_text, self._intent.new_text,
+        ):
+            return False
+        entry = self.runner.session_store.lookup_by_session_key(self.session_key)
+        return (entry is not None and entry.session_key == self.session_key
+                and entry.session_id == lease.session_id and entry.active_turn_token == self._active_marker)
+
+    def _authorized(self, source, *, original):
+        identity = identity_of(source)
+        if (identity is None or identity != self._identity or identity.adapter() is not self.adapter
+                or (original and identity is not self._identity)
+                or identity.transport_inferred or not identity.multiplexed
+                or _source_route(source) != self._route
+                or self.runner._intake_adapter_for(source) is not self.adapter
+                or self.runner._session_key_for_source(source) != self.session_key
+                or self.runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True):
+            return False
+
+        cap = getattr(source, "_friday_user_scope", None)
+        if (original and cap is not self.publication.owner) or not _same_scope(cap, self.publication.owner):
+            return False
+        binding = self._intent.binding
+        with self.runner._profile_scope_for_source(source):
+            if (current(required=True) is not cap
+                    or (cap.principal, cap.profile, cap.admission_generation, cap.directory_identity)
+                    != (binding.principal, binding.profile, binding.admission_generation, binding.home_identity)):
+                return False
+            guard_operation(self._intent.operation, self._intent.source, self._intent.destination)
+            return True
+
+    def current(self, fresh_source=None) -> bool:
+        """Revalidate before sending a prompt and before consuming its native callback."""
+        def authorized():
+            return (self._turn_current() and self._authorized(self.source, original=True)
+                    and (fresh_source is None or self._authorized(fresh_source, original=False)))
+
+        try:
+            return (authorized()
+                    and verify_published_odt_input(self.event, self.publication, still_current=self._turn_current)
+                    and authorized() and self._turn_current())
+        except Exception:  # health: allow BLE001 -- Scope and SDK failures may contain private request data.
+            return False
+
+
+def capture(runner, adapter, event, approval, owner, owner_is_current) -> _Authority | None:
+    """Capture the trusted caller's approval while its stock turn owns the original upload.
+
+    The live owner predicate receives the exact owner and Binding. It must
+    locate the current native owner and match the Binding's owner generation.
+    That generation is independent of the gateway turn lease generation.
+    """
+    try:
+        if (type(approval) is not Approval or type(approval.binding) is not Binding
+                or type(owner) is not NativeODTOwner or not callable(owner_is_current)):
+            return None
+        approval.check_shape()
+        if approval.operation == COPY and not matches_copy_action(
+            event, approval.destination, approval.old_text, approval.new_text,
+        ):
+            return None
+        binding = approval.binding
+        if (type(binding.session_id) is not str or not binding.session_id
+                or type(binding.owner_generation) is not str or not binding.owner_generation
+                or owner_is_current(owner, binding) is not True):
+            return None
+        source = event.source
+        identity = identity_of(source)
+        route = _source_route(source)
+        raw_message = event.raw_message
+        raw_document = getattr(raw_message, "document", None)
+        raw_leaf = getattr(raw_document, "file_name", None)
+        if (identity is None or identity.adapter() is not adapter or type(raw_leaf) is not str or not raw_leaf
+                or source.platform.value != "telegram" or source.chat_type != "dm"
+                or source.user_id != source.chat_id or source.is_bot or source.delivered_via_upstream_relay
+                or runner._intake_adapter_for(source) is not adapter
+                or adapter.gateway_runner is not runner
+                or runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True):
+            return None
+
+        key = runner._session_key_for_source(source)
+        state = runner._peek_session_state(key)
+        if not key or state is None or state.turn.event is not event or state.turn.agent is None:
+            return None
+        turn = state.turn
+        generation = state.persistent.run_generation
+        lease = turn.lease_tokens.get(generation)
+        marker = getattr(event, "_gateway_active_turn_token", None)
+        if (type(generation) is not int or generation < 1
+                or type(lease) is not TurnLeaseToken or lease.generation != generation
+                or lease.session_id != binding.session_id or lease.owner_key != key
+                or lease.released is not False or lease.lease.holder is not lease or not lease.lease.lock.locked()
+                or type(marker) is not str or not marker
+                or getattr(event, "_gateway_active_turn_session_key", None) != key):
+            return None
+
+        with runner._profile_scope_for_source(source):
+            cap = current(required=True)
+            if cap is not getattr(source, "_friday_user_scope", None):
+                return None
+            guard_operation(approval.operation, approval.source, approval.destination)
+            publication = read_published_odt_input(event)
+            if publication is None or publication.owner is not cap:
+                return None
+
+            evidence = publication.evidence
+            expected_binding = Binding(cap.principal, cap.profile, publication.chat_id, lease.session_id,
+                                       binding.owner_generation, cap.admission_generation, cap.directory_identity)
+            if (binding != expected_binding
+                    or (source.chat_id, source.thread_id or "", event.message_id)
+                    != (publication.chat_id, publication.thread_id, publication.upload_message)
+                    or type(publication.file_id) is not str or not publication.file_id
+                    or (approval.upload_message, approval.file_unique_id, approval.source,
+                        approval.source_sha256, approval.file_identity)
+                    != (publication.upload_message, publication.file_unique_id,
+                        evidence.path.relative_to(cap.home / "workspace").as_posix(),
+                        evidence.sha256, evidence.source_identity)
+                    or not _password_required(approval, evidence)):
+                return None
+
+        retained = _Authority(runner, adapter, event, source, approval, owner, publication, key,
+                              owner_is_current, identity, route, raw_message, raw_document, raw_leaf,
+                              state, turn, turn.agent, lease, generation, marker,
+                              replace(approval, binding=replace(binding)))
+        return retained if retained.current() else None
+    except Exception:  # health: allow BLE001 -- This optional boundary fails closed without exposing request data.
+        return None
