+        cap = current(required=True)
+        if cap is not source._friday_user_scope:
+            return None
+        paths = event.media_urls
+        if type(paths) is not list or len(paths) != 1 or type(paths[0]) is not str:
+            return None
+        path = Path(paths[0])
+        relative = path.relative_to(cap.home / "workspace").as_posix()
+        guard_operation(operation, relative, destination)
+        publication = read_published_odt_input(event)
+        if publication is None or publication.owner is not cap or publication.evidence.path != path:
