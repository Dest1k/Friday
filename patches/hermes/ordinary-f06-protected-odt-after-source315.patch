+            active()
+            argv = _argv()
+            with custody.lock:
+                if self._stop_requested.is_set() or custody.settled or custody.process is not None:
+                    raise ODFPasswordError('odf_codec_stopped')
+                if time.monotonic() >= expires:
+                    raise ODFPasswordError('odf_codec_timeout')
+                process = custody.process = subprocess.Popen(
+                    argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                    close_fds=True, start_new_session=True, cwd='/', env={})
+            output = _exchange(process, (header, data, secret, old, new), expires, active)
+            while True:
+                active()
+                remaining = expires - time.monotonic()
+                if remaining <= 0:
+                    raise ODFPasswordError('odf_codec_timeout')
+                with custody.lock:
+                    if custody.settled:
+                        raise ODFPasswordError('odf_codec_stopped')
+                    exit_state = os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOWAIT | os.WNOHANG)
+                    if exit_state is not None:
+                        # Observe exit while the pid is still reserved. Custody kills
+                        # remaining group members and does the one authoritative reap.
+                        if exit_state.si_code != os.CLD_EXITED or exit_state.si_status != 0:
+                            raise ODFPasswordError('odf_codec_failed')
+                        break
+                time.sleep(min(.01, remaining))
+        except (OSError, ImportError):
+            raise ODFPasswordError('odf_codec_unavailable') from None
+        finally:
+            # A duplicate run failed before acquiring this handle's child.
+            if process is not None:
+                try:
+                    if self._settle()['status'] != 'QUIESCENT':
+                        raise CodecStopUnconfirmed('odt_codec_unsettled')
+                finally:
+                    process.stdin.close()
+                    process.stdout.close()
+        active()
+        if time.monotonic() >= expires + _STOP_RESERVE:
+            raise ODFPasswordError('odf_codec_timeout')
+        return _decode_response(output, operation)
+
+
+def _json(metadata):
+    return json.dumps(metadata, ensure_ascii=True, separators=(',', ':'), sort_keys=True).encode('ascii')
+
+
+def _read_request(stream, secret):
+    magic, operation, size, password_size, old_size, new_size = _REQUEST.unpack(stream.read(_REQUEST.size))
+    if (magic != _MAGIC or operation not in (_READ, _COPY) or not 0 < size <= MAX_BYTES
+            or not 0 < password_size <= _MAX_PASSWORD or old_size > _MAX_EDIT_BYTES
+            or new_size > _MAX_EDIT_BYTES or (operation == _READ and (old_size or new_size))
+            or (operation == _COPY and old_size == 0)):
+        raise ValueError()
+    data = stream.read(size)
+    secret.extend(bytes(password_size))
+    if len(data) != size or stream.readinto(secret) != password_size or 0 in secret:
+        raise ValueError()
+    old, new = stream.read(old_size), stream.read(new_size)
+    if (len(old) != old_size or len(new) != new_size or stream.read(1)):
+        raise ValueError()
+    return operation, data, old.decode('utf-8'), new.decode('utf-8')
+
+
+def _worker():
+    import resource
+
+    resource.setrlimit(resource.RLIMIT_CPU, (12, 13))
+    resource.setrlimit(resource.RLIMIT_AS, (512 * 1024 * 1024,) * 2)
+    resource.setrlimit(resource.RLIMIT_NOFILE, (64, 64))
+    resource.setrlimit(resource.RLIMIT_FSIZE, (0, 0))
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    from tools.scoped_odf_password import encrypted_edit, prepare_read
+
+    secret = bytearray()
+    operation = 0
+    try:
+        operation, data, old, new = _read_request(sys.stdin.buffer, secret)
+        try:
+            password = secret.decode('utf-8')
+        except UnicodeError:
+            raise ODFPasswordError('odf_password_invalid') from None
+        if operation == _READ:
+            payload, metadata = prepare_read(data, 'odt', password)
+            if metadata.get('encrypted') is not True:
+                status, payload, meta = _UNENCRYPTED, b'', b''
+            else:
+                status, meta = _OK, _json(metadata)
+        else:
+            edit = {'old_text': old, 'new_text': new}
+            _encode_edit(edit)
+            payload, metadata = encrypted_edit(data, 'odt', password, edit)
+            status, meta = _OK, _json(metadata)
+        if len(payload) > MAX_BYTES or len(meta) > _MAX_METADATA:
+            raise ODFPasswordError('odf_output_limit')
+    except ODFPasswordError as error:
+        code = error.args[0]
+        status, payload, meta = _REFUSED, (code if code in _CODES else 'odf_codec_failed').encode('ascii'), b''
+    except (struct.error, ValueError):
+        status, payload, meta = _REFUSED, b'odf_codec_invalid_frame', b''
+    except Exception:
+        status, payload, meta = _REFUSED, b'odf_codec_failed', b''
+    finally:
+        secret[:] = bytes(len(secret))
+    stream = sys.stdout.buffer
+    stream.write(_RESPONSE.pack(_MAGIC, operation, status, len(payload), len(meta)))
+    stream.write(payload)
+    stream.write(meta)
+    stream.flush()
+
+
+if __name__ == '__main__':
+    _worker()
