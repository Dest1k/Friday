+def _literal_edit(value):
+    # The native ODF renderer normalizes CR; reject it to preserve the exact edit.
+    return all(char in "\t\n" or 32 <= ord(char) <= 0xD7FF
+               or 0xE000 <= ord(char) <= 0xFFFD or 0x10000 <= ord(char) <= 0x10FFFF
+               for char in value)
+
