+BUSY = "Дождитесь завершения текущей операции и заново отправьте защищённый ODT."
+_ODT_MIME = "application/vnd.oasis.opendocument.text"
+_COPY_FIELDS = {"destination", "old_text", "new_text"}
+_COPY_PREFIX = "/f06 copy "
+
+
+@dataclass(frozen=True, slots=True)
+class _Caption:
+    event_id: int
+    adapter: object = field(repr=False)
+    polling_generation: int
+    update_id: int
+    message: object = field(repr=False)
+    document: object = field(repr=False)
+    file_version: tuple | None = field(repr=False)
+    caption: str = field(repr=False)
+    action: tuple | None = field(repr=False)
+
