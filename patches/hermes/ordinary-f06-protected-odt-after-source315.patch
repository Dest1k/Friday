+    from gateway.ordinary_f06_session import claim_receipt
+    from hermes_cli.friday_protected_odt import NativeODTOwner, READ
+    from hermes_cli.friday_protected_odt_http import ReadDelivery, ReadResult, Receipt, Status
+
+    if (type(owner) is not NativeODTOwner or type(receipt) is not Receipt
+            or receipt.status is not Status.ACCEPTED or type(receipt.result) is not ReadResult):
+        return None
+    operation = claim_receipt(runner, receipt, owner=owner)
+    if operation is None:
