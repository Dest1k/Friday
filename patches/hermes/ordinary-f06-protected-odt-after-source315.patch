+        if receipt['status'] == 'QUIESCENT':
+            return receipt
+        return {'status': 'STOP_UNCONFIRMED', 'reason': 'odt_codec_unsettled'}
+
+    def run_read(self, data, secret, *, deadline, checkpoint, clock=time.monotonic):
+        return self._run(_READ, data, secret, (), deadline, checkpoint, clock)
+
+    def run_copy(self, data, secret, edit, *, deadline, checkpoint, clock=time.monotonic):
+        return self._run(_COPY, data, secret, _encode_edit(edit), deadline, checkpoint, clock)
+
+    def _run(self, operation, data, secret, edit, deadline, checkpoint, clock):
+        if type(data) is not bytes or not 0 < len(data) <= MAX_BYTES:
+            raise ODFPasswordError('odf_input_limit')
