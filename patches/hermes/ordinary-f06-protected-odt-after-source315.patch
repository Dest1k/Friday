+    source = event.source
+    identity = identity_of(source)
+    if (source.platform.value != "telegram" or source.chat_type != "dm"
+            or source.user_id != source.chat_id or source.is_bot or event.internal
+            or source.delivered_via_upstream_relay
+            or identity is None or identity.adapter() is not adapter
+            or not identity.multiplexed or identity.transport_inferred
+            or adapter.gateway_runner is not runner or runner._intake_adapter_for(source) is not adapter
+            or runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True):
+        return None
+
+    key = runner._session_key_for_source(source)
+    state = runner._peek_session_state(key)
+    if state is None or state.turn.event is not event or state.turn.agent is None:
+        return None
+    generation = state.persistent.run_generation
+    lease = state.turn.lease_tokens.get(generation)
+    entry = runner.session_store.lookup_by_session_key(key)
+    marker = getattr(event, "_gateway_active_turn_token", None)
+    if (type(generation) is not int or generation < 1 or type(lease) is not TurnLeaseToken
+            or lease.generation != generation or lease.owner_key != key
+            or lease.released is not False or lease.lease.holder is not lease or not lease.lease.lock.locked()
+            or entry is None or entry.session_id != lease.session_id
+            or type(marker) is not str or not marker or entry.active_turn_token != marker
+            or getattr(event, "_gateway_active_turn_session_key", None) != key):
+        return None
