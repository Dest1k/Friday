+"""Ownership of the confirmed F06 reset across the existing store offload."""
+import asyncio
+from threading import Lock
+
+
+def pending_reset(runner, key):
+    lookup = getattr(runner, "_peek_session_state", None)
+    state = lookup(key) if callable(lookup) else None
+    reservation = getattr(getattr(state, "persistent", None), "_friday_odt_reset", None)
+    return reservation if type(reservation) is ResetReservation else None
+
+
+class ResetReservation:
+    def __init__(self, runner, event, key, binding, state):
+        self.runner, self.event, self.key, self.state = runner, event, key, state
+        self.adapter, _, self.guard, self.task = binding
+        self.binding = binding
+        self.generation = runner._current_session_run_generation(key)
+        self.predecessor = runner.session_store._entries.get(key)
+        self.session_id = getattr(self.predecessor, "session_id", None)
+        self.active_turn_token = getattr(self.predecessor, "active_turn_token", None)
+        self.predecessor_fifo = tuple(state.conversation.queued_events)
+        self._lock = Lock()
+        self._cancelled = False
+        self._claimed = False
+
+    @classmethod
+    def acquire(cls, runner, event, key):
+        binding = getattr(event, "_friday_session_command", None)
+        if type(binding) is not tuple or len(binding) != 4:
+            return None
+        adapter, bound_key, guard, task = binding
+        if (bound_key != key or task is not asyncio.current_task()
+                or adapter is not runner._intake_adapter_for(event.source)
+                or adapter.gateway_runner is not runner
+                or adapter._active_sessions.get(key) is not guard):
+            return None
+        state = runner._peek_session_state(key)
+        if state is None or pending_reset(runner, key) is not None:
+            return None
+        reservation = cls(runner, event, key, binding, state)
+        state.persistent._friday_odt_reset = reservation
+        return reservation
+
+    def is_current(self):
+        return (not self._cancelled and self.adapter.gateway_runner is self.runner
+                and self.adapter._active_sessions.get(self.key) is self.guard
+                and getattr(self.event, "_friday_session_command", None) is self.binding
+                and pending_reset(self.runner, self.key) is self
+                and self.runner._is_session_run_current(self.key, self.generation))
+
+    def claim_commit(self):
+        """Called under the store lock immediately before its first reset write."""
+        with self._lock:
+            if self._cancelled or self._claimed or not self.is_current():
+                return False
+            self._claimed = True
+            return True
+
+    def accepted_fifo(self):
+        predecessor_ids = {id(event) for event in self.predecessor_fifo}
+        return [event for event in self.state.conversation.queued_events
+                if id(event) not in predecessor_ids and getattr(event, "_gateway_accepted", False) is True]
+
+    async def settle(self, coroutine):
+        """Keep the command reserved until the offloaded write and its tail settle."""
+        effect = asyncio.create_task(coroutine)
+        cancellation = None
+        try:
+            while True:
+                try:
+                    result = await asyncio.shield(effect)
+                    break
+                except asyncio.CancelledError as exc:
+                    if effect.cancelled():
+                        raise
+                    cancellation = exc
+                    with self._lock:
+                        if not self._claimed:
+                            self._cancelled = True
+            if cancellation is not None:
+                raise cancellation
+            return result
+        except Exception:
+            if cancellation is not None:
+                raise cancellation
+            raise
+        finally:
+            # The adapter still owns the command guard after the reservation
+            # is removed. Once writes can have started, it must drain forward.
+            with self._lock:
+                self.guard._friday_odt_reset_claimed = self._claimed
+            if getattr(self.state.persistent, "_friday_odt_reset", None) is self:
+                del self.state.persistent._friday_odt_reset
