+"""HTTP protocol for a separately qualified Telegram ODT intake channel.
+
+The caller owns listener/TLS and body-log policy, verifies the Telegram proof,
+and supplies the current native session scope, settled worker and receipt sink.
+This module opens no listeners and imports no agent or web-framework code.
+"""
+
+import asyncio
+from collections.abc import Awaitable, Callable
+from contextlib import AbstractContextManager
+from dataclasses import dataclass
+from enum import StrEnum
+from inspect import isawaitable
+import json
+import math
+import re
+from threading import Event, Lock
+
+from hermes_cli.friday_protected_odt import Binding, NativeODTOwner
+
+
+PATH = '/v1/protected-odt/submit'
+TICKET_PATH = '/v1/protected-odt/ticket'
+MINIAPP_PATH = '/protected-odt/'
+MEDIA = b'application/vnd.friday.protected-odt'
+TICKET_BYTES = 43
+MAX_BODY = TICKET_BYTES + 1 + 1024
+READ_SECONDS = 3.0
+RECEIPT_SECONDS = 35.0
+Principal = tuple[str, str, str, str]
+
+
+class Status(StrEnum):
+    ACCEPTED = 'accepted'
+    REJECTED = 'credential_rejected'
+    REFUSED = 'operation_refused'
+    RECONCILE = 'reconcile'
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class ReadResult:
+    content: str
+    partial: bool
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class CopyResult:
+    path: str
+    sha256: str
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class Receipt:
+    original_route: Binding
+    ticket: str
+    status: Status
+    result: ReadResult | CopyResult | None = None
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class NativeSession:
+    owner: NativeODTOwner
+    enter_scope: Callable[[], AbstractContextManager]
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class ReadDelivery:
+    still_current: Callable[[], bool]
+    finish: Callable[[bool], None]
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class ProtectedChannel:
+    origin: bytes
+    verify_telegram: Callable[[bytes], Principal | None]
+    find_native_session: Callable[[Principal], NativeSession | None]
+    # Must return only after invoke settles or is proved to have never started.
+    run_owned: Callable[[Callable[[], None]], Awaitable[None]]
+    # A synchronous sink must be nonblocking. An asynchronous sink owns its
+    # cancellation, native custody and settlement within the configured deadline.
+    accept_receipt: Callable[[Receipt], bool | Awaitable[bool]]
+    receipt_seconds: float = RECEIPT_SECONDS
+    # This synchronous callback runs on the native Gateway owner loop.
+    take_native_ticket: Callable[[Principal, 'ProtectedChannel'], str | None] | None = None
+    # Optional projection into this authenticated POST response only.
+    accept_read: Callable[[NativeODTOwner, Receipt], ReadDelivery | None] | None = None
+
+    def miniapp_url(self):
+        if self.ready() and callable(self.take_native_ticket):
+            return self.origin.decode('ascii') + MINIAPP_PATH
+        return None
+
+    def ready(self):
+        if type(self.receipt_seconds) not in (int, float):
+            return False
+        try:
+            finite_budget = math.isfinite(self.receipt_seconds)
+        except OverflowError:
+            return False
+        return (type(self.origin) is bytes and
+                re.fullmatch(rb'https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?', self.origin) is not None
+                and finite_budget and self.receipt_seconds > 0
+                and all(callable(part) for part in (self.verify_telegram, self.find_native_session,
+                                                    self.run_owned, self.accept_receipt))
+                and (self.accept_read is None or callable(self.accept_read)))
+
+
+_RECEIPT_HTTP_STATUS = {
+    Status.ACCEPTED: 202, Status.REJECTED: 422, Status.REFUSED: 409, Status.RECONCILE: 503,
+}
+
+
+_REQUEST_REFUSALS = {
+    400: 'invalid_request', 403: 'forbidden', 408: 'request_timeout', 409: 'receipt_unavailable',
+    413: 'body_too_large', 415: 'unsupported_media_type', 431: 'headers_too_large',
+}
+
+
+class _Refused(Exception):
+    def __init__(self, status):
+        self.status = status
+
+
+def _header_values(scope):
+    headers = {}
+    raw = scope.get('headers', ())
+    if len(raw) > 48 or sum(len(name) + len(value) for name, value in raw) > 12288:
+        raise _Refused(431)
+    for name, value in raw:
+        name = name.lower()
+        if name not in {b'origin', b'authorization', b'content-type', b'content-length',
+                        b'content-encoding'}:
+            continue
+        if name in headers:
+            raise _Refused(400)
+        headers[name] = value
+    return headers
+
+
+def _same_origin_credential(headers, origin):
+    if headers.get(b'origin') != origin:
+        raise _Refused(403)
+    credential = headers.get(b'authorization', b'')
+    if not 0 < len(credential) <= 4096:
+        raise _Refused(403)
+    return credential
+
+
+def _verified_principal(channel, credential):
+    principal = channel.verify_telegram(credential)
+    if (type(principal) is not tuple or len(principal) != 4 or principal[0] != 'telegram'
+            or not all(type(part) is str and part for part in principal)):
+        raise _Refused(403)
+    return principal
+
+
+def _check_headers(headers, origin):
+    credential = _same_origin_credential(headers, origin)
+    if headers.get(b'content-type') != MEDIA or b'content-encoding' in headers:
+        raise _Refused(415)
+    length = headers.get(b'content-length')
+    if length is not None:
+        if re.fullmatch(rb'[0-9]{1,4}', length) is None:
+            raise _Refused(400)
+        length = int(length)
+        if length > MAX_BODY:
+            raise _Refused(413)
+        if length <= TICKET_BYTES + 1:
+            raise _Refused(400)
+    return credential, length
+
+
+async def _read_body(receive, body, length):
+    async with asyncio.timeout(READ_SECONDS):
+        for _ in range(MAX_BODY + 1):
+            event = await receive()
+            if event['type'] == 'http.disconnect':
+                return False
+            if event['type'] != 'http.request':
+                raise _Refused(400)
+            chunk = event.get('body', b'')
+            size = len(body) + len(chunk)
+            if size > MAX_BODY:
+                raise _Refused(413)
+            if length is not None and size > length:
+                raise _Refused(400)
+            body.extend(chunk)
+            if not event.get('more_body', False):
+                if length is not None and size != length:
+                    raise _Refused(400)
+                return True
+    raise _Refused(400)
+
+
+def _parse_body(body):
+    if (len(body) <= TICKET_BYTES + 1 or body[TICKET_BYTES] != 10
+            or re.fullmatch(rb'[A-Za-z0-9_-]{43}', memoryview(body)[:TICKET_BYTES]) is None):
+        raise _Refused(400)
+    ticket = body[:TICKET_BYTES].decode('ascii')
+    del body[:TICKET_BYTES + 1]
+    if 0 in body:
+        raise _Refused(400)
+    try:
+        body.decode('utf-8')
+    except UnicodeError:
+        raise _Refused(400) from None
+    return ticket
+
+
+def _format_receipt(binding, ticket, answer):
+    if type(answer) is not dict or answer.get('effect_disposition') == 'unknown':
+        return Receipt(binding, ticket, Status.RECONCILE)
+    if answer.get('success') is True:
+        if answer.get('format') == 'odf_password_edit':
+            path, sha256 = answer.get('path'), answer.get('sha256')
+            if (type(path) is str and path and type(sha256) is str
+                    and re.fullmatch(r'[a-f0-9]{64}', sha256) is not None):
+                return Receipt(binding, ticket, Status.ACCEPTED, CopyResult(path, sha256))
+        elif type(answer.get('content')) is str and type(answer.get('partial')) is bool:
+            return Receipt(binding, ticket, Status.ACCEPTED, ReadResult(answer['content'], answer['partial']))
+        return Receipt(binding, ticket, Status.RECONCILE)
+    if answer.get('reason') == 'odf_password_rejected_or_corrupt':
+        return Receipt(binding, ticket, Status.REJECTED)
+    return Receipt(binding, ticket, Status.REFUSED)
+
+
