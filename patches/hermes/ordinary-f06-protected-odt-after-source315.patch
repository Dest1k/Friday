@@ -0,0 +1,375 @@
+"""One owned ODT invocation. Authentication and user confirmation are external."""
+
+from contextlib import contextmanager
+from dataclasses import dataclass
+from hashlib import sha256
+import json
+from pathlib import PurePosixPath
+import secrets
+from threading import Event, Lock, RLock
+import time
+
+
+READ = 'read'
+COPY = 'create_encrypted_copy'
+TTL_SECONDS = 120
+_REFUSALS = frozenset({'odt_intake_unavailable', 'odt_scope_refused', 'odt_source_changed',
+                       'odt_input_refused', 'odt_encryption_required'})
+
+
+class IntakeRefused(RuntimeError):
+    pass
+
+
+def need(condition, code):
+    if not condition:
+        raise IntakeRefused(code)
+
+
+@dataclass(frozen=True, slots=True)
+class Binding:
+    principal: tuple
+    profile: str
+    chat_id: str
+    session_id: str
+    owner_generation: str
+    admission_generation: int
+    home_identity: tuple
+
+
+@dataclass(frozen=True, slots=True)
+class Approval:
+    binding: Binding
+    upload_message: str
+    file_unique_id: str
+    source: str
+    source_sha256: str
+    file_identity: tuple
+    operation: str
+    destination: str | None = None
+    old_text: str | None = None
+    new_text: str | None = None
+
+    def check_shape(self):
+        def path(value):
+            return (type(value) is str and value and '\0' not in value
+                    and str(PurePosixPath(value)) == value and not PurePosixPath(value).is_absolute()
+                    and all(not part.startswith('.') for part in PurePosixPath(value).parts)
+                    and PurePosixPath(value).suffix.lower() == '.odt')
+
+        need(path(self.source) and type(self.file_identity) is tuple and len(self.file_identity) == 9
+             and all(type(item) is int for item in self.file_identity)
+             and type(self.source_sha256) is str and len(self.source_sha256) == 64
+             and all(char in '0123456789abcdef' for char in self.source_sha256)
+             and bool(self.upload_message) and bool(self.file_unique_id), 'odt_scope_refused')
+        if self.operation == READ:
+            need(self.destination is None and self.old_text is None and self.new_text is None, 'odt_scope_refused')
+        else:
+            leaf = PurePosixPath(self.destination).name if path(self.destination) else ''
+            need(self.operation == COPY and leaf and self.destination != self.source
+                 and len(leaf) <= 255 and all(ord(char) >= 32 and char != '\\' for char in leaf)
+                 and type(self.old_text) is str and bool(self.old_text) and type(self.new_text) is str,
+                 'odt_scope_refused')
+
+
+class _Invocation:
+    __slots__ = ('owner', 'ticket', 'approval', 'deadline', '_secret', 'cancelled', 'commit_attempted', '_request_stopped', '_codec', '_codec_unsettled')
+
+    def __init__(self, owner, ticket, approval, deadline, secret, request_stopped=None):
+        self.owner, self.ticket, self.approval = owner, ticket, approval
+        self.deadline, self._secret = deadline, secret
+        self._request_stopped = request_stopped
+        self.cancelled = self.commit_attempted = self._codec_unsettled = False
+        self._codec = owner._codec_factory() if owner._codec_factory is not None else None
+
+    def _check_active_locked(self):
+        need(self.owner._active is self and not self.cancelled and not self.owner.stop_requested
+             and (self._request_stopped is None or not self._request_stopped.is_set()), 'odt_intake_unavailable')
+        need(self.owner._clock() < self.deadline, 'odt_intake_unavailable')
+
+    def _checkpoint_locked(self, cap):
+        from hermes_cli.friday_workspace_revision import check
+
+        self._check_active_locked()
+        binding = self.approval.binding
+        need((cap.principal, cap.profile, cap.admission_generation, cap.directory_identity)
+             == (binding.principal, binding.profile, binding.admission_generation, binding.home_identity)
+             and self.owner._authorize(self.approval) is True, 'odt_scope_refused')
+        check(cap)
+        self._check_active_locked()
+
+    def checkpoint(self, cap):
+        with self.owner._lock:
+            self._checkpoint_locked(cap)
+
+    def check_tool(self, cap, name, args):
+        self.checkpoint(cap)
+        need((self.approval.operation == READ and name == 'read_file'
+              and args == {'path': self.approval.source})
+             or (self.approval.operation == COPY and name == 'write_file'
+                 and args == {'path': self.approval.destination, 'format': 'odf_password_edit'}),
+             'odt_scope_refused')
+
+    def check_source(self, source):
+        data, path, identity = source
+        need((path, identity) == (self.approval.source, self.approval.file_identity)
+             and sha256(data).hexdigest() == self.approval.source_sha256, 'odt_source_changed')
+
+    def password(self):
+        need(0 < len(self._secret) <= 1024 and 0 not in self._secret, 'odt_input_refused')
+        try:
+            return self._secret.decode('utf-8')
+        except UnicodeError:
+            raise IntakeRefused('odt_input_refused') from None
+
+    def decrypt_odt(self, cap, data, document_format):
+        from tools.scoped_odf_password import prepare_read
+
+        if self._codec is None:
+            return prepare_read(data, document_format, self.password(), checkpoint=lambda: self.checkpoint(cap))
+        need(document_format == 'odt', 'odt_scope_refused')
+        return self._run_codec(self._codec.run_read, data, checkpoint=lambda: self.checkpoint(cap))
+
+    def edit_odt(self, data, document_format, edit, checkpoint):
+        from tools.scoped_odf_password import encrypted_edit
+
+        if self._codec is None:
+            return encrypted_edit(data, document_format, self.password(), edit, checkpoint=checkpoint)
+        need(document_format == 'odt', 'odt_scope_refused')
+        return self._run_codec(self._codec.run_copy, data, edit, checkpoint=checkpoint)
+
+    def _run_codec(self, operation, data, *args, checkpoint):
+        from tools.scoped_odt_codec import CodecStopUnconfirmed
+
+        try:
+            return operation(data, self._secret, *args, deadline=self.deadline,
+                             checkpoint=checkpoint, clock=self.owner._clock)
+        except CodecStopUnconfirmed:
+            self._codec_unsettled = True
+            raise
+
+    def finish_read(self, cap, *, succeeded):
+        from hermes_cli.friday_user_scope import _workspace_document_snapshot
+
+        with self.owner._lock:
+            self._checkpoint_locked(cap)
+            if succeeded:
+                source = cap.home / 'workspace' / self.approval.source
+                snapshot = _workspace_document_snapshot(cap, str(source), with_identity=True)
+                self.check_source(snapshot)
+            self._check_active_locked()
+
+    @contextmanager
+    def commit(self, cap, verify_files):
+        with self.owner._lock:
+            self._checkpoint_locked(cap)
+            verify_files()
+            self._checkpoint_locked(cap)
+            self.commit_attempted = True
+            yield
+
+
+class NativeODTOwner:
+    """One slot per authenticated native session owner, with serialized stop/commit."""
+
+    def __init__(self, authorize, *, clock=time.monotonic, codec_factory=None,
+                 _post_result=None, _on_io_release=None):
+        self._authorize = authorize
+        self._codec_factory = codec_factory
+        self._post_result = _post_result
+        self._on_io_release = _on_io_release
+        self._clock = clock
+        self._lock = RLock()
+        self._http_request_lock = Lock()
+        self._http_submission_lock = Lock()
