+    if caption == "/f06 read":
+        return READ, None, None, None
+    if not caption.startswith(_COPY_PREFIX) or len(caption) > 1024:
+        return None
+    try:
+        if len(caption.encode("utf-16-le")) > 2048:
+            return None
+        fields = json.loads(caption[len(_COPY_PREFIX):], object_pairs_hook=_unique_fields)
+    except (ValueError, RecursionError):
+        return None
+    if (type(fields) is not dict or set(fields) != _COPY_FIELDS
+            or any(type(value) is not str for value in fields.values())):
+        return None
+    destination, old_text, new_text = (fields[key] for key in ("destination", "old_text", "new_text"))
+    if (not destination or not destination.isprintable() or "\\" in destination
+            or not old_text or old_text == new_text
+            or not _literal_edit(old_text) or not _literal_edit(new_text)):
+        return None
+    path = PurePosixPath(destination)
+    if (path.is_absolute() or path.as_posix() != destination or path.suffix.lower() != ".odt"
+            or any(part.startswith(".") or len(part.encode("utf-8")) > 255 for part in path.parts)):
+        return None
+    return COPY, destination, old_text, new_text
