+odf_output_limit odf_package_expansion_limit odf_partial_encryption_unsupported
+odf_password_format_unsupported odf_password_invalid odf_password_rejected_or_corrupt
+odf_password_required odf_root_encryption_unsupported odf_source_not_encrypted
+odf_start_key_unsupported odf_zip_encryption_or_special_member odf_codec_invalid_frame
