diff --git a/gateway/trueconf_access.py b/gateway/trueconf_access.py
new file mode 100644
--- /dev/null
+++ b/gateway/trueconf_access.py
@@ -0,0 +1,167 @@
+"""Exact TrueConf transport identity and profile-scoped gateway access."""
+from dataclasses import dataclass
+from hashlib import sha256
+import ipaddress
+import json
+import re
+from urllib.parse import urlsplit
+
+PLATFORM = "trueconf"
+TOKEN_ENV = "TRUECONF_CHATBOT_TOKEN"
+PASSWORD_ENVS = ("TRUECONF_USERNAME", "TRUECONF_PASSWORD")
+CLIENT_ID_ENV = "TRUECONF_CLIENT_ID"
+CREDENTIAL_SETS = (frozenset({TOKEN_ENV}), frozenset(PASSWORD_ENVS),
+                   frozenset((*PASSWORD_ENVS, CLIENT_ID_ENV)))
+CHANNEL_ENVS = frozenset().union(*CREDENTIAL_SETS)
+_SECRET_CONFIG_KEYS = frozenset({"password", "token", "api_key", "secret", "bot_token", "app_secret"}) | {
+    name.lower() for name in CHANNEL_ENVS
+}
+_ID = re.compile(r"[A-Za-z0-9#][A-Za-z0-9._@+#=-]{0,255}")
+_SCOPE = re.compile(r"tc-[a-f0-9]{64}")
+_HOST = re.compile(r"[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?")
+
+
+def valid_id(value: object) -> bool:
+    return isinstance(value, str) and _ID.fullmatch(value) is not None
+
+
+def valid_scope(value: object) -> bool:
+    return isinstance(value, str) and _SCOPE.fullmatch(value) is not None
+
+
+def _id_set(extra: dict, key: str) -> frozenset[str]:
+    values = extra.get(key, [])
+    if not isinstance(values, list) or not all(valid_id(value) for value in values):
+        raise ValueError("invalid_trueconf_id_list")
+    return frozenset(values)
+
+
+def _server_url(value: object) -> str:
+    if (not isinstance(value, str) or len(value) > 512
+            or any(ord(c) <= 32 or ord(c) >= 127 for c in value)
+            or any(c in value for c in ("\\", "?", "#", "%"))):
+        raise ValueError("invalid_trueconf_server")
+    try:
+        url = urlsplit(value)
+        host = url.hostname
+        port = url.port
+    except ValueError:
+        raise ValueError("invalid_trueconf_server") from None
+    # The Bot Connector appends its own API paths to the configured server origin.
+    if (url.scheme != "https" or not host or url.username is not None or url.password is not None
+            or url.path not in {"", "/"} or port == 0 or url.netloc.endswith(":")):
+        raise ValueError("invalid_trueconf_server")
+    if ":" in host:
+        try:
+            host = f"[{ipaddress.IPv6Address(host).compressed}]"
+        except ValueError:
+            raise ValueError("invalid_trueconf_server") from None
+    elif _HOST.fullmatch(host) is None or ".." in host:
+        raise ValueError("invalid_trueconf_server")
+    return f"https://{host}" + (f":{port}" if port is not None and port != 443 else "")
+
+
+@dataclass(frozen=True)
+class TrueConfAccess:
+    enabled: bool
+    server_url: str
+    account_id: str
+    account_role: str
+    scope_id: str
+    allowed_user_ids: frozenset[str]
+    allowed_group_ids: frozenset[str]
+    allowed_dm_chat_ids: frozenset[str]
+    tester_user_id: str | None
+    tester_chat_id: str | None
+    dm_admin_ids: frozenset[str]
+    group_admin_ids: frozenset[str]
+
+    @classmethod
+    def from_config(cls, config, *, require_enabled: bool = True) -> "TrueConfAccess":
+        extra = getattr(config, "extra", None)
+        enabled = getattr(config, "enabled", False)
+        if (type(enabled) is not bool or not isinstance(extra, dict)
+                or getattr(config, "token", None) is not None or getattr(config, "api_key", None) is not None):
+            raise ValueError("invalid_trueconf_config")
+        if any(str(key).lower() in _SECRET_CONFIG_KEYS for key in extra):
+            raise ValueError("trueconf_secret_requires_scoped_env")
+        account = extra.get("account_id")
+        role = extra.get("account_role")
+        if not valid_id(account) or role not in ("product", "tester"):
+            raise ValueError("invalid_trueconf_account")
+        if require_enabled and (not enabled or role != "product"):
+            raise ValueError("trueconf_product_adapter_disabled")
+        if enabled and role == "tester":
+            raise ValueError("trueconf_tester_is_separate")
+        server = _server_url(extra.get("server_url"))
+        allowed_users = _id_set(extra, "allowed_user_ids")
+        allowed_groups = _id_set(extra, "allowed_group_ids")
+        allowed_dms = _id_set(extra, "allowed_dm_chat_ids")
+        dm_admins = _id_set(extra, "allow_admin_from")
+        group_admins = _id_set(extra, "group_allow_admin_from")
+        peer, peer_chat = extra.get("tester_user_id"), extra.get("tester_chat_id")
+        if ((peer is not None or peer_chat is not None)
+                and (not valid_id(peer) or not valid_id(peer_chat) or peer == account)):
+            raise ValueError("invalid_trueconf_tester_peer")
+        if role == "tester" and (allowed_users or allowed_groups or allowed_dms or dm_admins or group_admins):
+            raise ValueError("invalid_trueconf_tester_grants")
+        fingerprint = json.dumps((server, account), separators=(",", ":")).encode()
+        scope = f"tc-{sha256(fingerprint).hexdigest()}"
+        return cls(enabled, server, account, role, scope, allowed_users, allowed_groups, allowed_dms,
+                   peer, peer_chat, dm_admins, group_admins)
+
+    def admits(self, user_id: str, chat_id: str, is_group: bool, is_bot: bool) -> bool:
+        if (not self.enabled or self.account_role != "product" or not valid_id(user_id)
+                or not valid_id(chat_id) or user_id == self.account_id):
+            return False
+        if self.tester_user_id is not None and user_id == self.tester_user_id:
+            return not is_group and chat_id == self.tester_chat_id
+        if is_bot or user_id not in self.allowed_user_ids or chat_id == self.tester_chat_id:
+            return False
+        if is_group:
+            return chat_id in self.allowed_group_ids
+        return not self.allowed_dm_chat_ids or chat_id in self.allowed_dm_chat_ids
+
+    def allows_chat(self, chat_id: str, is_group: bool) -> bool:
+        if not self.enabled or self.account_role != "product" or not valid_id(chat_id):
+            return False
+        if is_group:
+            return chat_id != self.tester_chat_id and chat_id in self.allowed_group_ids
+        return chat_id == self.tester_chat_id or chat_id in self.allowed_dm_chat_ids
+
+    def permits_user_role(self, user_id: str, role: str) -> bool:
+        """Eligibility for recording a native product role, before chat admission."""
+        if self.account_role != "product" or not valid_id(user_id) or user_id == self.account_id:
+            return False
+        if user_id == self.tester_user_id:
+            return role == "user"
+        if user_id not in self.allowed_user_ids:
+            return False
+        return role == "user" or (role == "admin" and user_id in self.dm_admin_ids | self.group_admin_ids)
+
+
+def access_for_source(config, source) -> TrueConfAccess | None:
+    try:
+        access = TrueConfAccess.from_config(config)
+    except ValueError:
+        return None
+    return access if access.scope_id == getattr(source, "scope_id", None) else None
+
+
+def profile_config(config: dict):
+    """The operator-facing YAML block for a TrueConf account."""
+    from gateway.config import PlatformConfig
+
+    platforms = config.get("platforms")
+    raw = platforms.get(PLATFORM) if isinstance(platforms, dict) else None
+    if raw is None:
+        return None
+    if not isinstance(raw, dict) or type(raw.get("enabled", False)) is not bool:
+        raise ValueError("invalid_trueconf_config")
+    return PlatformConfig.from_dict(raw)
+
+
+def profile_access(*, require_enabled: bool = True) -> TrueConfAccess | None:
+    from hermes_cli.config import load_config_storage_readonly
+    config = profile_config(load_config_storage_readonly())
+    return None if config is None else TrueConfAccess.from_config(config, require_enabled=require_enabled)
