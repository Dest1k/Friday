+from hermes_constants import get_hermes_home, mkdir_under_hermes_home
+from utils import AtomicWriteUncertainError, atomic_json_write, fsync_directory
+
+if TYPE_CHECKING:
+    from .trueconf_client import IngressDelivery
+
+logger = logging.getLogger(__name__)
+_MAX_RECEIPTS = 20_000
+_MAX_RECENT_ROUTES = 2_000
+_MEDIA_TYPES = {
+    "image": MessageType.PHOTO,
+    "video": MessageType.VIDEO,
+    "audio": MessageType.AUDIO,
+    "voice": MessageType.VOICE,
+    "document": MessageType.DOCUMENT,
+}
+
+
+@dataclass(frozen=True)
+class Attachment:
+    file_id: str
+    name: str | None
+    size: int
+    mime_type: str = ""
+    kind: str = "document"
+
+
+@dataclass(frozen=True)
+class Incoming:
+    chat_id: str
+    message_id: str
+    sender_id: str
+    is_group: bool
+    is_bot: bool
+    text: str = ""
+    reply_to: str | None = None
+    addressed: bool = False
+    attachments: tuple[Attachment, ...] = ()
+    delivery: IngressDelivery | None = None
+
+
+@dataclass(frozen=True)
+class Acknowledgement:
+    state: str
+    message_id: str | None = None
+    chat_id: str | None = None
+
+
+class Wire(Protocol):
+    async def connect(self) -> bool: ...
+    def events(self) -> AsyncIterator[Incoming]: ...
+    async def close(self) -> None: ...
+    async def send_text(self, chat_id: str, text: str, *, reply_to: str | None) -> Acknowledgement: ...
+    async def send_file(
+        self, chat_id: str, path: Path, *, caption: str | None, reply_to: str | None
+    ) -> Acknowledgement: ...
+    async def download_file(self, file_id: str, target: Path, *, max_bytes: int) -> None: ...
+
+
+def _rejected(reason: str) -> SendResult:
+    return SendResult(False, error=reason, error_kind="forbidden", retryable=False)
+
+
+def _unknown() -> SendResult:
+    # BasePlatformAdapter only retries operations with a safe retry classification.
+    return SendResult(False, error="trueconf_delivery_unknown", error_kind="unknown", retryable=False)
+
+
+def _file_name(name: str) -> str:
+    if (not isinstance(name, str) or not 0 < len(name.encode("utf-8")) <= 220
+            or name.strip() != name or name in (".", "..") or "/" in name or "\\" in name
+            or any(ord(ch) < 32 or ord(ch) == 127 for ch in name)):
+        raise ValueError("trueconf_invalid_file_name")
+    return name
+
+
+def _owned_read(path: Path, limit: int, *, expected_size: int | None = None) -> bytes:
+    info = path.lstat()
+    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+            or info.st_nlink != 1 or not 0 <= info.st_size <= limit
+            or expected_size is not None and info.st_size != expected_size):
+        raise ValueError("trueconf_invalid_file_identity")
+    with open(path, "rb", opener=lambda name, flags: os.open(name, flags | os.O_NOFOLLOW)) as stream:
+        if os.fstat(stream.fileno()) != info:
+            raise ValueError("trueconf_file_replaced")
+        data = stream.read(limit + 1)
+        if len(data) != info.st_size or os.fstat(stream.fileno()) != info or path.lstat() != info:
+            raise ValueError("trueconf_file_changed")
+    return data
+
+
+class TrueConfAdapter(BasePlatformAdapter):
+    supports_inchannel_continuable = True
+
+    def __init__(self, config: PlatformConfig, *, wire: Wire | None = None):
+        super().__init__(config, Platform(PLATFORM))
+        self.access = TrueConfAccess.from_config(config)
+        self._wire = wire
+        self._recv_task: asyncio.Task | None = None
+        self._receive_context = None
+        self._routes: OrderedDict[str, bool] = OrderedDict()
+        self._sent: OrderedDict[tuple[str, str], None] = OrderedDict()
+        self.cache_root = get_hermes_home() / "cache"
+        self._receipt_path = get_hermes_home() / "trueconf" / self.access.scope_id / "inbound.json"
+        self._receipts: set[str] = set()
+
+    def _load_receipts(self) -> None:
+        parent = self._receipt_path.parent
+        home = parent.parent.parent
+        mkdir_under_hermes_home(home)
+        for directory in (parent.parent, parent):
+            directory.mkdir(mode=0o700, exist_ok=True)
+            self._receipt_directory(directory)
+        for directory in (parent, parent.parent, home):
+            fsync_directory(directory, strict=True)
+        try:
+            payload = json.loads(_owned_read(self._receipt_path, 2 * 1024 * 1024))
+        except FileNotFoundError:
+            payload = []
+        if (not isinstance(payload, list) or len(payload) > _MAX_RECEIPTS
+                or not all(isinstance(key, str) and len(key) == 64
+                           and all(ch in "0123456789abcdef" for ch in key) for key in payload)):
+            raise ValueError("trueconf_receipt_state_invalid")
+        self._receipts = set(payload)
+
+    @staticmethod
+    def _receipt_directory(path: Path) -> tuple[int, int]:
+        info = path.lstat()
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
+                or info.st_mode & 0o077 or path.resolve(strict=True) != path):
+            raise ValueError("trueconf_receipt_directory")
+        return info.st_dev, info.st_ino
+
+    def _record_receipt(self, key: str) -> None:
+        if len(self._receipts) >= _MAX_RECEIPTS:
+            raise ValueError("trueconf_receipt_capacity_reached")
+        # Preserve prior IDs across reconnect or process restart. A crash after this
+        # boundary is an unknown handoff, so it never replays the same operation.
+        new_receipts = self._receipts | {key}
+        directory = self._receipt_path.parent
+        identity = self._receipt_directory(directory)
+
+        def guard() -> None:
+            if self._receipt_directory(directory) != identity or self._receipt_path.is_symlink():
+                raise ValueError("trueconf_receipt_directory_changed")
+
+        atomic_json_write(self._receipt_path, sorted(new_receipts), mode=0o600,
+                          fsync_dir=True, commit_guard=guard)
+        self._receipts = new_receipts
+
+    async def _commit_receipt(self, key: str) -> None:
+        writing = asyncio.create_task(asyncio.to_thread(self._record_receipt, key))
+        try:
+            await asyncio.shield(writing)
+        except asyncio.CancelledError:
+            # Keep account ownership until an already started write settles.
+            while not writing.done():
+                try:
+                    await asyncio.shield(writing)
+                except asyncio.CancelledError:
+                    continue
+            writing.result()
+            raise
+
+    async def connect(self, *, is_reconnect: bool = False) -> bool:
+        if self._recv_task is not None or self._running:
+            return False
+        if not self._acquire_platform_lock("trueconf-account", self.access.scope_id, "TrueConf account",
+                                           allow_same_process=False):
+            return False
+        opened = False
+        try:
+            await asyncio.to_thread(self._load_receipts)
+            if self._wire is None:
+                from .transport import create_wire
+                self._wire = create_wire(self.config, self.access)
+            if await self._wire.connect() is not True:
+                self._set_fatal_error("trueconf_connect", "TrueConf authentication failed", retryable=True)
+                return False
+            opened = True
+            self._mark_connected()
+            self._receive_context = copy_context()
+            self.on_gateway_adapter_registered()
+            return True
+        except Exception:
+            self._set_fatal_error("trueconf_connect", "TrueConf connection unavailable", retryable=True)
+            return False
+        finally:
+            if not opened:
+                try:
+                    if self._wire is not None:
+                        await self._wire.close()
+                finally:
+                    self._release_platform_lock()
+
+    def on_gateway_adapter_registered(self) -> None:
+        if not self._running or self._recv_task is not None:
+            return
+        runner = self.gateway_runner
+        if runner is not None and runner.adapters.get(self.platform) is not self:
+            profile_adapters = getattr(runner, "_profile_adapters", {})
+            if not any(adapters.get(self.platform) is self for adapters in profile_adapters.values()):
+                return
+        self._recv_task = asyncio.create_task(self._receive(), name="trueconf-receive",
+                                              context=self._receive_context)
+        self._receive_context = None
+
+    async def disconnect(self) -> None:
+        self._mark_disconnected()
+        recv, self._recv_task = self._recv_task, None
+        self._receive_context = None
+        try:
+            await cancel_task(recv)
+            if self._wire is not None:
+                await self._wire.close()
+        finally:
+            self._release_platform_lock()
+
+    async def _receive(self) -> None:
+        try:
+            async for message in self._wire.events():
+                if not self._running:
+                    return
+                await self._accept(message)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning("TrueConf receive stopped (%s)", type(exc).__name__)
+        if self._running:
+            self._set_fatal_error("trueconf_disconnected", "TrueConf receive connection lost", retryable=True)
+            await self._notify_fatal_error()
+
+    def _authorizes(self, source) -> bool:
+        if self.gateway_runner is not None:
+            return self.gateway_runner._is_user_authorized_for_source(source) is True
+        return self._is_sender_authorized(source.user_id, source.chat_type, source.chat_id, is_bot=source.is_bot) is True
+
+    @staticmethod
+    async def _settle_delivery(delivery, persist):
+        from .trueconf_client import TrueConfError
+
+        persistence_error = None
+
+        async def save(key):
+            nonlocal persistence_error
+            try:
+                return await persist(key)
+            except (OSError, ValueError, AtomicWriteUncertainError, TrueConfError) as exc:
+                persistence_error = exc
+                raise
+
+        try:
+            return await delivery.accept(save)
+        except TrueConfError as exc:
+            if exc.reason != "ingress_persistence_failed" or persistence_error is None:
+                raise
+            raise persistence_error from None
+
+    async def _accept(self, item: Incoming) -> None:
+        from .trueconf_client import IngressAckError, IngressKey, IngressReceipt, TrueConfError
+
+        if (not isinstance(item, Incoming) or not valid_id(item.message_id)
+                or not isinstance(item.text, str) or type(item.is_bot) is not bool
+                or type(item.is_group) is not bool or len(item.attachments) > 10
+                or not valid_id(item.chat_id) or not valid_id(item.sender_id)):
+            return
+        expected = IngressKey(self.access.server_url, self.access.account_id, item.chat_id, item.message_id)
+        delivery = item.delivery
+        if delivery is not None and delivery.key != expected:
+            raise ValueError("trueconf_ingress_scope_mismatch")
+        key = sha256(json.dumps((item.chat_id, item.message_id), separators=(",", ":")).encode()).hexdigest()
+        discard_key = sha256(f"discard:{key}".encode()).hexdigest()
+        if key in self._receipts or discard_key in self._receipts:
+            if delivery is not None:
+                async def duplicate(actual: IngressKey) -> IngressReceipt:
+                    if actual != expected:
+                        raise ValueError("trueconf_ingress_scope_mismatch")
+                    return IngressReceipt(actual, "DUPLICATE")
+
+                await delivery.accept(duplicate)
+            return
+        own_reply = (item.chat_id, item.reply_to) in self._sent if valid_id(item.reply_to) else False
+        allowed = self.access.admits(item.sender_id, item.chat_id, item.is_group, item.is_bot)
+        addressed = not item.is_group or item.addressed is True or own_reply
+        if not allowed or not addressed:
+            # A reply to an unknown group message may have targeted this bot before restart.
+            if delivery is not None and (not allowed or not valid_id(item.reply_to)):
+                async def discard(actual: IngressKey) -> IngressReceipt:
+                    if actual != expected:
+                        raise ValueError("trueconf_ingress_scope_mismatch")
+                    await self._commit_receipt(discard_key)
+                    return IngressReceipt(actual, "DISCARDED")
+
+                try:
+                    await self._settle_delivery(delivery, discard)
+                except (OSError, ValueError):
+                    logger.warning("TrueConf policy decision held before durable settlement")
+            return
+        chat_type = "group" if item.is_group else "dm"
+        source = self.build_source(item.chat_id, chat_type=chat_type, user_id=item.sender_id,
+                                   scope_id=self.access.scope_id, message_id=item.message_id, is_bot=item.is_bot)
+        if self.gateway_runner is not None:
+            from gateway.session_identity import canonical_identity
+            if canonical_identity(source, runner=self.gateway_runner, adapter=self) is None:
+                return
+        if source.profile_route_rejected or not self._authorizes(source):
+            return
+        source._trueconf_ingress = Ingress(self.access.scope_id, item.chat_id, item.sender_id,
+                                           item.message_id, chat_type)
+        if not item.text and not item.attachments:
+            return
+        self._routes[item.chat_id] = item.is_group
+        self._routes.move_to_end(item.chat_id)
+        if len(self._routes) > _MAX_RECENT_ROUTES:
+            self._routes.popitem(last=False)
+        media = []
+
+        async def persist(actual: IngressKey) -> IngressReceipt:
+            nonlocal media
+            if actual != expected:
+                raise ValueError("trueconf_ingress_scope_mismatch")
+            media = await self._cache_attachments(item.attachments)
+            if not self._running or not self._authorizes(source):
+                raise ValueError("trueconf_ingress_admission_changed")
+            await self._commit_receipt(key)
+            return IngressReceipt(actual, "NEW")
+
+        try:
+            if delivery is None:
+                await persist(expected)
+            else:
+                try:
+                    await self._settle_delivery(delivery, persist)
+                except IngressAckError as exc:
+                    # The message is already durably ours. Reconnect may replay the frame,
+                    # but its receipt guarantees no second dispatch.
+                    if exc.receipt != IngressReceipt(expected, "NEW"):
+                        raise
+        except (asyncio.CancelledError, AtomicWriteUncertainError):
+            for cached, _, _ in media:
+                Path(cached.path).unlink(missing_ok=True)
+            raise
+        except (OSError, ValueError, TrueConfError):
+            for cached, _, _ in media:
+                Path(cached.path).unlink(missing_ok=True)
+            logger.warning("TrueConf message held before gateway admission")
+            return
+        event = MessageEvent(
+            text=item.text, source=source, user_id=item.sender_id, message_id=item.message_id,
+            message_type=media[0][1] if media else MessageType.TEXT,
+            media_urls=[cached.path for cached, _, _ in media],
+            media_types=[cached.media_type for cached, _, _ in media],
+            media_text_inlined=[False] * len(media),
+            reply_to_message_id=item.reply_to if valid_id(item.reply_to) else None,
+            reply_to_is_own_message=own_reply, reply_expected=True,
+        )
+        event._trueconf_files = tuple(receipt for _, _, receipt in media)
+        event._preserve_native_origin = True
+        await self.handle_message(event)
+
+    async def _cache_attachments(self, attachments: tuple[Attachment, ...]) -> list:
+        if not attachments:
+            return []
+        limit = get_inbound_media_max_bytes()
+        limit = limit if limit > 0 else DEFAULT_INBOUND_MEDIA_MAX_BYTES
+        from gateway.run_inbound_media import READABLE_ATTACHMENT_BYTES
+        total = 0
+        cached = []
+        try:
+            with TemporaryDirectory(dir=self._receipt_path.parent) as temp:
+                for index, file in enumerate(attachments):
+                    nameless_voice = file.name is None and file.kind == "voice"
+                    name = "" if nameless_voice else _file_name(file.name)
+                    if (not valid_id(file.file_id) or type(file.size) is not int
+                            or not 0 <= file.size <= READABLE_ATTACHMENT_BYTES
+                            or (total := total + file.size) > limit):
+                        raise ValueError("trueconf_file_budget")
+                    target = Path(temp) / str(index)
+                    await self._wire.download_file(file.file_id, target, max_bytes=file.size)
+                    data = await asyncio.to_thread(_owned_read, target, file.size, expected_size=file.size)
+                    kind = "audio" if file.kind == "voice" else file.kind
+                    mime_type = file.mime_type
+                    if file.kind == "voice" and mime_type.startswith("voice/"):
+                        mime_type = "audio/" + mime_type.removeprefix("voice/")
+                    result = await cache_media_bytes_async(data, filename=name, mime_type=mime_type,
+                                                           default_kind=kind,
+                                                           directory_guard=self._guard_cache_directory)
+                    if result is None:
+                        raise ValueError("trueconf_invalid_media")
+                    message_type = _MEDIA_TYPES.get("voice" if file.kind == "voice" else result.kind,
+                                                    MessageType.DOCUMENT)
+                    if nameless_voice:
+                        name = "voice" + Path(result.path).suffix
+                    receipt = FileReceipt(file.file_id, name, result.path,
+                                          result.content["size_bytes"], result.content["sha256"])
+                    cached.append((result, message_type, receipt))
+                    await asyncio.to_thread(self._sync_cache_file, receipt)
+        except BaseException:
+            for result, _, _ in cached:
+                Path(result.path).unlink(missing_ok=True)
+            raise
+        return cached
+
+    def permits_cache_path(self, path: Path) -> bool:
+        return self._permits_cache_directory(path.parent) and not path.name.startswith(".")
+
+    def _permits_cache_directory(self, directory: Path) -> bool:
+        home = self.cache_root.parent
+        return directory in (
+            self.cache_root / "documents", self.cache_root / "images",
+            self.cache_root / "audio", self.cache_root / "videos",
+            home / "document_cache", home / "image_cache", home / "audio_cache", home / "video_cache",
+        )
+
+    def _guard_cache_directory(self, directory: Path) -> None:
+        if not self._permits_cache_directory(directory) or directory.resolve() != directory:
+            raise ValueError("trueconf_file_cache_scope_unproved")
+        if directory.exists():
+            self._receipt_directory(directory)
+
+    def _sync_cache_file(self, receipt: FileReceipt) -> None:
+        path = Path(receipt.cache_path)
+        if not self.permits_cache_path(path):
+            raise ValueError("trueconf_file_cache_scope_unproved")
+        directory = path.parent
+        identity = self._receipt_directory(directory)
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        try:
+            info = os.fstat(fd)
+            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                    or info.st_nlink != 1 or info.st_mode & 0o077 or info.st_size != receipt.size):
+                raise ValueError("trueconf_file_cache_unproved")
+            with os.fdopen(os.dup(fd), "rb") as cached:
+                if sha256(cached.read(receipt.size + 1)).hexdigest() != receipt.sha256:
+                    raise ValueError("trueconf_file_cache_digest_changed")
+            os.fsync(fd)
+            fsync_directory(directory, strict=True)
+            fsync_directory(directory.parent, strict=True)
+            if self._receipt_directory(directory) != identity or path.lstat() != info:
+                raise ValueError("trueconf_file_cache_changed")
+        finally:
+            os.close(fd)
+
+    def _can_send(self, chat_id: str, reply_to: str | None) -> bool:
+        return bool(self._running and valid_id(chat_id) and (reply_to is None or valid_id(reply_to))
+                    and (chat_id in self._routes or self.access.allows_chat(chat_id, False)
+                         or self.access.allows_chat(chat_id, True)))
+
+    def _result(self, chat_id: str, acknowledgement: Acknowledgement) -> SendResult:
+        if isinstance(acknowledgement, Acknowledgement):
+            if (acknowledgement.state == "ack" and acknowledgement.chat_id == chat_id
+                    and valid_id(acknowledgement.message_id)):
+                key = (chat_id, acknowledgement.message_id)
+                self._sent[key] = None
+                self._sent.move_to_end(key)
+                if len(self._sent) > _MAX_RECENT_ROUTES:
+                    self._sent.popitem(last=False)
+                return SendResult(True, message_id=acknowledgement.message_id)
+            if acknowledgement.state == "rejected":
+                return _rejected("trueconf_delivery_rejected")
+        return _unknown()
+
+    def _send_retry_is_final(self, result: SendResult) -> bool:
+        return result.error_kind in {"unknown", "forbidden"} or super()._send_retry_is_final(result)
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None) -> SendResult:
+        if not self._can_send(chat_id, reply_to):
+            return _rejected("trueconf_route_denied")
+        try:
+            result = await self._wire.send_text(chat_id, content, reply_to=reply_to)
+        except Exception:
+            return _unknown()
+        return self._result(chat_id, result)
+
+    async def deliver_scoped_document(self, source, file_path, *, caption=None, file_name=None) -> SendResult:
+        from gateway.trueconf_custody import admitted_route
+        from hermes_cli.friday_user_scope import (
+            ScopeDenied, current, guard_gateway_reply, ordinary_file_source, workspace_document,
+        )
+        try:
+            cap = current(required=True)
+            route, owner = admitted_route(source, cap)
+            if ordinary_file_source() is not source or owner is not self:
+                raise ScopeDenied()
+            guard_binding = getattr(source, "_friday_document_guard", None)
+            run_binding = getattr(source, "_friday_document_run", None)
+            if not guard_binding or not run_binding:
+                raise ScopeDenied()
+
+            def check_current():
+                cap.check()
+                admitted_route(source, cap)
+                key, guard = guard_binding
+                run_key, generation = run_binding
+                if (not self._running or self._active_sessions.get(key) is not guard or guard.is_set()
+                        or getattr(source, "_friday_document_guard", None) is not guard_binding
+                        or getattr(source, "_friday_document_run", None) is not run_binding
+                        or not self.gateway_runner._is_session_run_current(run_key, generation)):
+                    raise ScopeDenied()
+
+            if caption is not None:
+                guarded, blocked = guard_gateway_reply(source, caption)
+                if blocked or guarded != caption:
+                    return _rejected("trueconf_document_caption_rejected")
+            check_current()
+            limit = get_inbound_media_max_bytes()
+            data, relative = await asyncio.to_thread(
+                workspace_document, file_path, max_bytes=limit if limit > 0 else DEFAULT_INBOUND_MEDIA_MAX_BYTES)
+            name = _file_name(file_name or Path(relative).name)
+            identity = (route.scope, route.chat, route.message, relative)
+            key = sha256(json.dumps(identity, separators=(",", ":")).encode()).hexdigest()
+            attempt = self._receipt_path.parent / ("delivery-" + key + ".json")
+            with TemporaryDirectory(dir=attempt.parent) as directory:
+                private = Path(directory) / name
+                with open(private, "xb", opener=lambda path, flags: os.open(path, flags, 0o600)) as stream:
+                    stream.write(data)
+                check_current()
+                # Reserve durably before the one SDK send. A crash before the ACK
+                # update consumes this exact turn-and-artifact obligation.
+                try:
+                    with open(attempt, "x", opener=lambda path, flags: os.open(path, flags, 0o600)) as stream:
+                        json.dump({"state": "UNKNOWN", "artifact_sha256": sha256(data).hexdigest()}, stream)
+                        stream.flush()
+                        os.fsync(stream.fileno())
+                except FileExistsError:
+                    return _unknown()
+                parent = os.open(attempt.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+                try:
+                    os.fsync(parent)
+                finally:
+                    os.close(parent)
+                check_current()
+                try:
+                    result = self._result(route.chat, await self._wire.send_file(
+                        route.chat, private, caption=caption, reply_to=route.message, before_dispatch=check_current))
+                    state = "ACK" if result.success else "UNKNOWN" if result.error_kind == "unknown" else "REJECTED"
+                    atomic_json_write(attempt, {"state": state, "message_id": result.message_id,
+                                                "artifact_sha256": sha256(data).hexdigest()},
+                                      mode=0o600, fsync_dir=True)
+                    return result
+                except Exception:
+                    return _unknown()
+        except (ScopeDenied, OSError, ValueError):
+            return _rejected("trueconf_document_scope_refused")
+
+    async def send_document(self, chat_id, file_path, caption=None, file_name=None,
+                            reply_to=None, metadata=None, **kwargs) -> SendResult:
+        from hermes_cli.friday_user_scope import ScopeDenied, ordinary_file_source
+        try:
+            source = ordinary_file_source()
+        except ScopeDenied:
+            return _rejected("trueconf_document_scope_refused")
+        if source is not None:
+            if chat_id != source.chat_id or reply_to not in (None, source.message_id):
+                return _rejected("trueconf_document_scope_refused")
+            return await self.deliver_scoped_document(source, file_path, caption=caption, file_name=file_name)
+        if not self._can_send(chat_id, reply_to):
+            return _rejected("trueconf_route_denied")
+        verified = self.validate_media_delivery_path(file_path, (metadata or {}).get("session_key", ""))
+        if not verified:
+            return _rejected("trueconf_file_path_denied")
+        try:
+            name = _file_name(file_name or Path(verified).name)
+            limit = get_inbound_media_max_bytes()
+            payload = await asyncio.to_thread(_owned_read, Path(verified), limit if limit > 0 else DEFAULT_INBOUND_MEDIA_MAX_BYTES)
+        except (OSError, ValueError):
+            return _rejected("trueconf_file_read_denied")
+        with TemporaryDirectory(dir=self._receipt_path.parent) as temp:
+            target = Path(temp) / name
+            with open(target, "xb", opener=lambda path, flags: os.open(path, flags, 0o600)) as stream:
+                stream.write(payload)
+            try:
+                result = await self._wire.send_file(chat_id, target, caption=caption, reply_to=reply_to)
+            except Exception:
+                return _unknown()
+        return self._result(chat_id, result)
+
+    async def send_image_file(self, chat_id, image_path, caption=None, reply_to=None, metadata=None):
+        return await self.send_document(chat_id, image_path, caption, reply_to=reply_to, metadata=metadata)
+
+    async def send_video(self, chat_id, video_path, caption=None, reply_to=None, metadata=None, **kwargs):
+        return await self.send_document(chat_id, video_path, caption, reply_to=reply_to, metadata=metadata)
+
+    async def send_voice(self, chat_id, audio_path, caption=None, reply_to=None, metadata=None):
+        return await self.send_document(chat_id, audio_path, caption, reply_to=reply_to, metadata=metadata)
+
+    async def get_chat_info(self, chat_id: str) -> dict:
+        group = self._routes.get(chat_id, self.access.allows_chat(chat_id, True))
+        return {"name": chat_id, "type": "group" if group else "dm"}
+
+
+def _requirements() -> bool:
+    return importlib.util.find_spec(f"{__package__}.transport") is not None
+
+
+def _configured(config: PlatformConfig) -> bool:
+    try:
+        TrueConfAccess.from_config(config)
+        return True
+    except ValueError:
+        return False
+
+
+def register(ctx) -> None:
+    ctx.register_platform(
+        name=PLATFORM, label="TrueConf", adapter_factory=TrueConfAdapter,
+        check_fn=_requirements, validate_config=_configured, is_connected=_configured,
+        requires_explicit_enablement=True, pii_safe=True, allow_update_command=False,
+    )
