+++ b/plugins/platforms/trueconf/transport.py
@@ -0,0 +1,189 @@
+"""Use the official Connector wire contract for a single scoped gateway account."""
+
+from __future__ import annotations
+
+from html.parser import HTMLParser
+import json
+import ssl
+import time
+
+import httpx
+
+from agent.secret_scope import get_secret
+from gateway.trueconf_access import valid_id
+
+from .adapter import Acknowledgement, Attachment, Incoming
+from .trueconf_client import AccessToken, TrueConfClient
+
+_MAX_TOKEN_REPLY = 16_384
+
+
+class _PlainText(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.parts: list[str] = []
+
+    def handle_starttag(self, tag, attrs):
+        if tag in {"br", "p", "li", "div", "blockquote", "pre"}:
+            self.parts.append("\n")
+
+    def handle_endtag(self, tag):
+        if tag in {"p", "li", "div", "blockquote", "pre"}:
+            self.parts.append("\n")
+
+    def handle_data(self, data):
+        self.parts.append(data)
+
+
+def _text(text: str | None, mode: str | None) -> str:
+    if not text or mode != "html":
+        return text or ""
+    plain = _PlainText()
+    plain.feed(text)
+    plain.close()
+    return "".join(plain.parts).strip()
+
+
+async def _token_post(http, origin: str, path: str, payload: dict) -> dict:
+    try:
+        async with http.stream("POST", origin + path, json=payload) as response:
+            if response.status_code not in {200, 201}:
+                raise ValueError("trueconf_oauth_rejected")
+            data = bytearray()
+            async for chunk in response.aiter_bytes(chunk_size=4096):
+                data.extend(chunk)
+                if len(data) > _MAX_TOKEN_REPLY:
+                    raise ValueError("trueconf_oauth_reply_size")
+        value = json.loads(data)
+        if not isinstance(value, dict):
+            raise ValueError("trueconf_oauth_reply")
+        return value
+    except (httpx.HTTPError, UnicodeError, ValueError):
+        raise ValueError("trueconf_oauth_exchange_failed") from None
+
+
+class ConnectorWire:
+    def __init__(self, native: TrueConfClient, access):
+        self.native = native
+        self.access = access
+
+    async def connect(self) -> bool:
+        actual = await self.native.connect(receive_unread=True)
+        if actual != self.access.account_id:
+            return False
+        from hermes_cli.friday_credential_admission import channel_identity, managed
+        if managed():
+            channel_identity("trueconf", self.access.scope_id)
+        return True
+
+    async def close(self) -> None:
+        await self.native.close()
+
+    async def events(self):
+        async for delivery in self.native.deliveries():
+            event = delivery.event
+            if (not valid_id(event.sender_id) or not valid_id(event.chat_id)
+                    or not valid_id(event.message_id)):
+                continue
+            kind = event.chat_kind
+            if kind not in {"direct", "group"}:
+                # Older Connector notifications may omit chat metadata. Confirm the chat
+                # via the authenticated same-server API, never derive it from sender ID.
+                if (event.sender_id not in self.access.allowed_user_ids
+                        and event.sender_id != self.access.tester_user_id):
+                    continue
+                chat = await self.native.get_chat(event.chat_id)
+                kind = {1: "direct", 2: "group"}.get(chat.get("chatType"))
+            if kind not in {"direct", "group"}:
+                continue
+            text = _text(event.text, event.parse_mode)
+            marker = "@" + self.access.account_id
+            addressed = text.startswith(marker + " ") or text.startswith(marker + "\n")
+            if addressed:
+                text = text[len(marker):].lstrip()
+            media = []
+            for value in event.attachments:
+                # Connector VoiceContent has no filename. Its file identity is still required.
+                if (value.file_id is None or value.size is None
+                        or (value.name is None and value.kind != "voice")):
+                    break
+                media.append(Attachment(value.file_id, value.name, value.size,
+                                        value.mime_type or "", value.kind))
+            if len(media) != len(event.attachments):
+                continue
+            yield Incoming(
+                chat_id=event.chat_id, message_id=event.message_id, sender_id=event.sender_id,
+                is_group=kind == "group", is_bot=event.sender_type != 1, text=text,
+                reply_to=event.reply_id, addressed=addressed, attachments=tuple(media),
+                delivery=delivery,
+            )
+
+    async def send_text(self, chat_id, text, *, reply_to):
+        result = await self.native.send_text(chat_id, text, reply_to=reply_to, parse_mode="markdown")
+        return Acknowledgement(result.status.lower(), result.message_id, chat_id)
+
+    async def send_file(self, chat_id, path, *, caption, reply_to, before_dispatch=None):
+        # Connector has a file caption but no reply ID on sendFile. Any accompanying
+        # text goes through sendMessage and keeps its own native quote.
+        result = await self.native.send_file(chat_id, path, caption=caption, before_dispatch=before_dispatch)
+        return Acknowledgement(result.status.lower(), result.message_id, chat_id)
+
+    async def download_file(self, file_id, target, *, max_bytes):
+        await self.native.download_file(file_id, target, max_bytes=max_bytes, expected_size=max_bytes)
+
+
+def create_wire(config, access):
+    from hermes_cli.friday_ordinary_gateway import trueconf_managed_tls
+
+    context = trueconf_managed_tls(config, access)
+    user = get_secret("TRUECONF_USERNAME")
+    password = get_secret("TRUECONF_PASSWORD")
+    app_id = get_secret("TRUECONF_CLIENT_ID")
+    token = get_secret("TRUECONF_CHATBOT_TOKEN")
+    if context is None:
+        context = ssl.create_default_context()
+        ca = config.extra.get("tls_ca_file")
+        if ca:
+            context.load_verify_locations(cafile=ca)
+    setup = dict(expected_user_id=access.account_id, ssl_context=context, durable_ingress=True)
+    if token:
+        if user or password or app_id:
+            raise ValueError("trueconf_one_auth_method_required")
+
+        async def configured_token() -> AccessToken:
+            expires_at = config.extra.get("token_expires_at")
+            if type(expires_at) is not int or expires_at <= time.time():
+                raise ValueError("trueconf_expired_configuration_token")
+            return AccessToken(token, expires_at)
+
+        setup["token_provider"] = configured_token
+    elif not user or not password:
+        raise ValueError("trueconf_account_credentials_missing")
+    elif app_id:
+        async def oauth_token() -> AccessToken:
+            origin = access.server_url
+            async with httpx.AsyncClient(verify=context, trust_env=False, follow_redirects=False, timeout=10) as http:
+                grant = await _token_post(http, origin, "/api/v4/oauth2/token", {
+                    "client_id": app_id, "grant_type": "password", "username": user, "password": password,
+                })
+                bearer = grant.get("access_token")
+                if not isinstance(bearer, str) or not bearer:
+                    raise ValueError("trueconf_invalid_oauth_access_token")
+                code = await _token_post(http, origin, "/bridge/api/client/v1/auth/web_rest_api_token",
+                                         {"client_id": user, "token": bearer})
+                authorization = code.get("authorization_code")
+                if not isinstance(authorization, str) or not authorization:
+                    raise ValueError("trueconf_missing_oauth_code")
+                bridge = await _token_post(http, origin, "/bridge/api/client/v1/auth/token", {
+                    "client_id": user, "grant_type": "authorization_code", "code": authorization,
+                })
+            jwt, expires_ms = bridge.get("access_token"), bridge.get("expires_in")
+            if (bridge.get("token_type") != "JWT" or not isinstance(jwt, str) or not jwt
+                    or type(expires_ms) is not int or expires_ms <= time.time() * 1000):
+                raise ValueError("trueconf_invalid_connector_token")
+            return AccessToken(jwt, expires_ms / 1000)
+
+        setup["token_provider"] = oauth_token
+    else:
+        setup.update(username=user, password=password)
+    return ConnectorWire(TrueConfClient(access.server_url, **setup), access)
