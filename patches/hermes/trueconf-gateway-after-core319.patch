+++ b/gateway/trueconf_custody.py
@@ -0,0 +1,54 @@
+"""Scope-bound attachment receipts from the receiving TrueConf adapter."""
+
+from dataclasses import dataclass
+from pathlib import Path
+
+from gateway.session_identity import identity_of
+from hermes_cli.friday_user_scope import ScopeDenied
+
+
+@dataclass(frozen=True)
+class Ingress:
+    scope: str
+    chat: str
+    user: str
+    message: str
+    chat_type: str
+
+
+@dataclass(frozen=True)
+class FileReceipt:
+    file_id: str
+    name: str
+    cache_path: str
+    size: int
+    sha256: str
+
+
+def admitted_route(source, cap):
+    identity = identity_of(source)
+    adapter = identity.adapter() if identity is not None else None
+    access = getattr(adapter, "access", None)
+    route = getattr(source, "_trueconf_ingress", None)
+    if (type(route) is not Ingress or access is None or identity.transport_inferred
+            or not identity.multiplexed or identity.runtime_home != cap.home
+            or identity.authorization_home != cap.authorization_home
+            or identity.transport_profile != cap.principal[1]
+            or source.platform.value != "trueconf" or source.thread_id not in (None, "")
+            or route.scope != source.scope_id or route.scope != access.scope_id
+            or cap.principal[0] != "trueconf" or cap.principal[2:] != (route.scope, route.user)
+            or (route.chat, route.user, route.message, route.chat_type)
+            != (source.chat_id, source.user_id, source.message_id, source.chat_type)
+            or not access.admits(route.user, route.chat, route.chat_type == "group", source.is_bot)):
+        raise ScopeDenied()
+    cap.check()
+    return route, adapter
+
+
+def recovery_route(source, cap):
+    route, _ = admitted_route(source, cap)
+    return {"transport_profile": cap.principal[1], "runtime_profile": cap.profile,
+            "bot_id": route.scope,
+            "source": {"platform": "trueconf", "chat_type": route.chat_type,
+                       "chat_id": route.chat, "user_id": route.user, "message_id": route.message,
+                       "thread_id": None, "profile": cap.profile}}
