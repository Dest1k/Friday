+"""Own-workspace native EPUB3 creation and preserving new-copy editing."""
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_epub import EPUBError
+from tools.scoped_epub_write import create_epub, edit_epub, _object
+
+
+def execute(cap, fd, leaf, path, content, operation):
+    _check_parent(cap, fd, path)
+    if Path(path).suffix.lower() != '.epub' or leaf != Path(path).name:
+        raise ScopeDenied()
+    try:
+        os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError:
+        pass
+    else:
+        return json.dumps({'success': False, 'error': 'document_already_exists', 'effect_disposition': 'none'})
+    source = original = identity = relative = None
+    preservation = None
+    try:
+        check(cap)
+        if operation == 'epub_create':
+            rendered = create_epub(content, checkpoint=lambda: check(cap))
+        elif operation == 'epub_edit':
+            spec = _object(content)
+            required = {'source', 'source_sha256', 'chapter', 'resource', 'paragraph', 'old_text', 'new_text', 'modified'}
+            if set(spec) != required:
+                raise EPUBError('epub_edit_schema')
+            raw = spec['source']
+            digest = spec['source_sha256']
+            if type(raw) is not str or not raw or len(raw) > 4096 or '\x00' in raw:
+                raise ScopeDenied()
+            if type(digest) is not str or len(digest) != 64 or any(c not in '0123456789abcdef' for c in digest):
+                raise EPUBError('epub_source_hash_required')
+            root = cap.home / 'workspace'
+            source = Path(raw)
+            if not source.is_absolute():
+                source = root / source
+            try:
+                relative = source.relative_to(root)
+            except ValueError:
+                raise ScopeDenied() from None
+            if (source.suffix.lower() != '.epub' or not relative.parts or
+                    any(p in ('.', '..') or p.startswith('.') for p in relative.parts) or
+                    relative.as_posix() == path):
+                raise ScopeDenied()
+            original, _, identity = workspace_document(str(source), with_identity=True)
+            if hashlib.sha256(original).hexdigest() != digest:
+                raise EPUBError('epub_source_hash_mismatch')
+            rendered, preservation = edit_epub(original, spec, checkpoint=lambda: check(cap))
+        else:
+            raise ScopeDenied()
+        check(cap)
+    except EPUBError as error:
+        return json.dumps({'success': False, 'error': 'epub_operation_refused',
+                           'reason': str(error), 'effect_disposition': 'none'})
+    verify = None
+    if source is not None:
+        def verify():
+            check(cap)
+            current, _, current_identity = workspace_document(str(source), with_identity=True)
+            if current != original or current_identity != identity:
+                raise ScopeDenied()
+    result = json.loads(_create_bytes(cap, fd, leaf, path, rendered,
+        output_format='epub', verify_source=verify))
+    if result.get('success'):
+        result.update(rendered=False, native_format=True, native_profile='bounded_EPUB3_OCF_XHTML_text',
+                      visual_validation=False, external_resources=False)
+        if source is not None:
+            result.update(source=relative.as_posix(), source_sha256=hashlib.sha256(original).hexdigest(),
+                          source_unchanged=True, replacements=1, **preservation)
+    return json.dumps(result, ensure_ascii=False)
