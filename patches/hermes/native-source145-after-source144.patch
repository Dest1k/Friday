+"""Scoped native fixed-page text creation and source-hash-bound copy edits."""
+import hashlib
+import json
+import os
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_communication import _object
+from hermes_cli.friday_workspace_zip import _source, _verify, _path
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_xps import XPSError
+from tools.scoped_xps_write import create_xps, edit_xps
+
+
+def execute(cap, fd, leaf, relative, content, operation):
+    _check_parent(cap, fd, relative)
+    suffix = PurePosixPath(relative).suffix.lower()
+    if suffix not in ('.xps', '.oxps') or operation not in ('xps_create','xps_edit'):
+        raise ScopeDenied()
+    try:
+        os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+    except FileNotFoundError:
+        pass
+    else:
+        raise ScopeDenied()
+    spec = _object(content)
+    check(cap)
+    sources = []
+    try:
+        if operation == 'xps_create':
+            data = create_xps(spec, suffix[1:], checkpoint=lambda:check(cap))
+        else:
+            if type(spec) is not dict or set(spec) != {'source','source_sha256','page','line','old_text','new_text'}:
+                raise ScopeDenied()
+            source = _path(spec['source'])
+            digest = spec['source_sha256']
+            if (source == relative or PurePosixPath(source).suffix.lower() != suffix
+                    or type(digest) is not str or len(digest) != 64
+                    or any(c not in '0123456789abcdef' for c in digest)):
+                raise ScopeDenied()
+            original, identity = _source(cap, source)
+            if hashlib.sha256(original).hexdigest() != digest:
+                raise ScopeDenied()
+            sources = [(source, original, identity)]
+            data = edit_xps(original, {k:spec[k] for k in ('page','line','old_text','new_text')},
+                            suffix[1:], checkpoint=lambda:check(cap))
+    except XPSError as exc:
+        return json.dumps(dict(success=False,error='xps_write_refused',reason=exc.code,
+                               effect_disposition='none'))
+    check(cap)
+    _verify(cap, sources)
+    result = json.loads(_create_bytes(cap, fd, leaf, relative, data,
+        output_format=suffix[1:], verify_source=lambda:_verify(cap, sources)))
+    if result.get('success'):
+        result.update(native_format=True, fixed_page_text_profile=True,
+                      embedded_font=True, font_substitution=False,
+                      rendered=False, application_interoperability_verified=False)
+        if sources:
+            result.update(source=sources[0][0],source_sha256=spec['source_sha256'],
+                          source_unchanged=True,selected_page=spec['page'],selected_line=spec['line'],
+                          replacements=1,untargeted_part_payloads_preserved=True,
+                          untargeted_local_records_preserved=True)
+    return json.dumps(result,ensure_ascii=False)
