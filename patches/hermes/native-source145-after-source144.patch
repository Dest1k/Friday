+"""Own-user create-only VDX publication and hash-bound preserving Text copies."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _source, _verify, _path, _inline_budget, _fits, _capacity, _encode
+from tools.scoped_vdx import VDXError
+from tools.scoped_vdx_write import create_vdx, edit_vdx, parse_request
+
+
+def execute(cap, fd, leaf, relative, content, operation):
+    _check_parent(cap, fd, relative)
+    if PurePosixPath(relative).suffix.lower() != '.vdx' or PurePosixPath(relative).name != leaf or operation not in ('vdx_create','vdx_text_edit'):
+        raise ScopeDenied()
+    checkpoint = lambda: check(cap)
+    sources = []
+    try:
+        if operation == 'vdx_create':
+            data = create_vdx(content, checkpoint=checkpoint)
+        else:
+            spec = parse_request(content, checkpoint)
+            if type(spec) is not dict or set(spec) != {'source','source_sha256','page_id','shape_id','old_text','new_text'}:
+                raise ScopeDenied()
+            source = _path(spec['source'])
+            if PurePosixPath(source).suffix.lower() != '.vdx' or source == relative:
+                raise ScopeDenied()
+            original, identity = _source(cap, source)
+            sources = [(source,original,identity)]
+            data = edit_vdx(original, {'expected_sha256':spec['source_sha256'], 'page_id':spec['page_id'],
+                'shape_id':spec['shape_id'], 'old_text':spec['old_text'], 'new_text':spec['new_text']}, checkpoint=checkpoint)
+    except VDXError as error:
+        return _encode({'success':False,'error':'vdx_operation_refused','reason':error.code,'effect_disposition':'none'})
+    receipt = {'operation':operation, 'profile':'visio_2003_core', 'rendered':False,
+               'visio_interoperability':'NOT_TESTED', 'dynamic_glue':'NOT_TESTED',
+               'source_unchanged':True, 'other_bytes_preserved':bool(sources),
+               'source_sha256':hashlib.sha256(sources[0][1]).hexdigest() if sources else None}
+    estimate = dict(receipt,success=True,path=relative,format='vdx',scope='own_user_workspace',
+                    create_only=True,verified=True,bytes_written=len(data),sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate,_inline_budget()):
+        return _capacity(_inline_budget())
+    _verify(cap,sources)
+    answer=json.loads(_create_bytes(cap,fd,leaf,relative,data,output_format='vdx',
+                                   verify_source=lambda: _verify(cap,sources)))
+    if answer.get('success'): answer.update(receipt)
+    return _encode(answer)
