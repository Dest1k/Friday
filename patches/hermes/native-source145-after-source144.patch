+"""Native XPS/OpenXPS text pages with pinned embedded OpenType font.
+
+ECMA-388 9.1.7, 10.6 and 12.1. This deliberately narrow profile has explicit
+pages and one left-to-right Glyphs run per line. No arbitrary markup, external
+resources, font substitution, rendering or general-layout editing.
+"""
+from __future__ import annotations
+
+import hashlib
+import io
+import struct
+import zipfile
+from xml.etree import ElementTree as ET
+
+from tools import scoped_xps as read
+from tools.scoped_pdf_report_font import _font, PDFReportError, FONT_SHA256
+
+FONT = 'Resources/Fonts/DejaVuSans.ttf'
+SEQUENCE = 'FixedDocumentSequence.fdseq'
+DOCUMENT = 'Documents/1/FixedDocument.fdoc'
+MAX_PAGES = 32
+MAX_LINES = 40
+MAX_TEXT = 60000
+SIZE = 16
+WIDTH, HEIGHT = 816, 1056
+LEFT, TOP, STEP = 48, 64, 24
+
+
+def fail(code):
+    raise read.XPSError(code)
+
+
+def xml_bytes(root):
+    return ET.tostring(root, encoding='utf-8', xml_declaration=True)
+
+
+def checked_font():
+    try:
+        font = _font()
+    except PDFReportError:
+        fail('xps_write_font_unavailable')
+    # Embedding is permitted only with the expected unmodified font and its
+    # verified license. Reject restricted or bitmap-only embedding flags.
+    if hashlib.sha256(font['data']).hexdigest() != FONT_SHA256:
+        fail('xps_write_font_identity')
+    data = font['data']
+    tables = {data[12+i*16:16+i*16]:struct.unpack_from('>II', data, 20+i*16)
+              for i in range(struct.unpack_from('>H', data, 4)[0])}
+    if b'OS/2' not in tables:
+        fail('xps_write_font_embedding')
+    offset, length = tables[b'OS/2']
+    if length < 10 or struct.unpack_from('>H', data, offset+8)[0] != 0:
+        fail('xps_write_font_embedding')
+    return font
+
+
+def line_text(value, font):
+    if type(value) is not str or not value or len(value) > 1024:
+        fail('xps_write_line_schema')
+    if any(ord(char) not in font['chars'] for char in value):
+        fail('xps_write_unsupported_character')
+    width = sum(font['chars'][ord(char)][1] for char in value)*SIZE/1000
+    if width > WIDTH-2*LEFT:
+        fail('xps_write_line_overflow')
+    return value
+
+
+def checked_spec(spec, font):
+    if type(spec) is not dict or set(spec) != {'pages'}:
+        fail('xps_write_create_schema')
+    pages = spec['pages']
+    if type(pages) is not list or not 1 <= len(pages) <= MAX_PAGES:
+        fail('xps_write_page_limit')
+    total = 0
+    for page in pages:
+        if type(page) is not list or not 1 <= len(page) <= MAX_LINES:
+            fail('xps_write_line_limit')
+        for value in page:
+            read.tick(None)
+            line_text(value, font)
+            total += len(value.encode('utf-8'))
+            if total > MAX_TEXT:
+                fail('xps_write_text_limit')
+    return pages
+
+
+def page_bytes(lines, namespace):
+    root = ET.Element(read.q(namespace, 'FixedPage'),
+                      {'Width':str(WIDTH), 'Height':str(HEIGHT),
+                       read.q(read.XML, 'lang'):'und'})
+    for index, line in enumerate(lines):
+        # Markup-extension escape is distinct from ordinary XML escaping.
+        value = '{}'+line if line.startswith('{') else line
+        ET.SubElement(root, read.q(namespace, 'Glyphs'),
+                      {'FontUri':'/'+FONT, 'FontRenderingEmSize':str(SIZE),
+                       'OriginX':str(LEFT), 'OriginY':str(TOP+index*STEP),
+                       'Fill':'#FF000000', 'UnicodeString':value})
+    return xml_bytes(root)
+
+
+def part_map(pages, format, font):
+    if format not in read.NS:
+        fail('xps_write_format')
+    ns = read.NS[format]
+    types = ET.Element(read.q(read.CT, 'Types'))
+    ET.SubElement(types, read.q(read.CT, 'Default'),
+                  {'Extension':'rels', 'ContentType':read.REL_MIME})
+    for path, kind in [(FONT, 'application/vnd.ms-opentype'),
+                       (SEQUENCE, read.TYPES['sequence']),
+                       (DOCUMENT, read.TYPES['document'])]:
+        ET.SubElement(types, read.q(read.CT, 'Override'),
+                      {'PartName':'/'+path, 'ContentType':kind})
+    seq = ET.Element(read.q(ns, 'FixedDocumentSequence'))
+    ET.SubElement(seq, read.q(ns, 'DocumentReference'), {'Source':'/'+DOCUMENT})
+    doc = ET.Element(read.q(ns, 'FixedDocument'))
+    root_rel = ET.Element(read.q(read.REL, 'Relationships'))
+    ET.SubElement(root_rel, read.q(read.REL, 'Relationship'),
+                  {'Id':'R1','Type':ns+'/fixedrepresentation','Target':'/'+SEQUENCE})
+    parts = {FONT:font['data'], SEQUENCE:xml_bytes(seq), '_rels/.rels':xml_bytes(root_rel)}
+    for index, lines in enumerate(pages, 1):
+        path = f'Documents/1/Pages/{index}.fpage'
+        ET.SubElement(types, read.q(read.CT, 'Override'),
+                      {'PartName':'/'+path, 'ContentType':read.TYPES['page']})
+        ET.SubElement(doc, read.q(ns, 'PageContent'), {'Source':'/'+path})
+        rel = ET.Element(read.q(read.REL, 'Relationships'))
+        ET.SubElement(rel, read.q(read.REL, 'Relationship'),
+                      {'Id':'R1', 'Type':ns+'/required-resource','Target':'/'+FONT})
+        parts[path] = page_bytes(lines, ns)
+        parts[f'Documents/1/Pages/_rels/{index}.fpage.rels'] = xml_bytes(rel)
+    parts[DOCUMENT] = xml_bytes(doc)
+    parts['[Content_Types].xml'] = xml_bytes(types)
+    return parts
+
+
+def archive_bytes(parts):
+    stream = io.BytesIO()
+    with zipfile.ZipFile(stream, 'w', compression=zipfile.ZIP_DEFLATED,
+                         compresslevel=6) as archive:
+        for name, value in parts.items():
+            info = zipfile.ZipInfo(name, (1980,1,1,0,0,0))
+            info.compress_type = zipfile.ZIP_DEFLATED
+            info.external_attr = 0o100600 << 16
+            archive.writestr(info, value, compresslevel=6)
+    data = stream.getvalue()
+    if len(data) > 1_000_000:
+        fail('xps_write_output_limit')
+    return data
+
+
+def create_xps(spec, format='xps', *, checkpoint=None):
+    read.tick(checkpoint)
+    font = checked_font()
+    pages = checked_spec(spec, font)
+    for _ in pages:
+        read.tick(checkpoint)
+    data = archive_bytes(part_map(pages, format, font))
+    read.extract_xps(data, format, checkpoint=checkpoint)
+    return data
+
+
+def edit_xps(data, spec, format='xps', *, checkpoint=None):
+    """Change one complete line in our validated fixed-page profile only."""
+    if (type(spec) is not dict or set(spec) != {'page','line','old_text','new_text'}
+            or type(spec['page']) is not int or type(spec['line']) is not int):
+        fail('xps_write_edit_schema')
+    read.tick(checkpoint)
+    font = checked_font()
+    old = line_text(spec['old_text'], font)
+    new = line_text(spec['new_text'], font)
+    if old == new:
+        fail('xps_write_noop')
+    read.extract_xps(data, format, checkpoint=checkpoint)
+    parts, _, roots, _ = read.load(data, format, checkpoint)
+    ns = read.NS[format]
+    if DOCUMENT not in roots:
+        fail('xps_write_profile_required')
+    pages = []
+    for index, reference in enumerate(roots[DOCUMENT],1):
+        read.tick(checkpoint)
+        path = f'Documents/1/Pages/{index}.fpage'
+        if reference.get('Source') != '/'+path or path not in roots:
+            fail('xps_write_profile_required')
+        lines = []
+        for node in roots[path]:
+            if node.tag != read.q(ns,'Glyphs') or node.get('UnicodeString') is None:
+                fail('xps_write_profile_required')
+            value = node.get('UnicodeString')
+            lines.append(value[2:] if value.startswith('{}') else value)
+        pages.append(lines)
+    checked_spec({'pages':pages}, font)
+    # Exact recognized XML parts and the original complete font. This rejects
+    # arbitrary page geometry, Indices, clipping, marks, links and hidden parts.
+    if parts != part_map(pages, format, font):
+        fail('xps_write_profile_required')
+    page, line = spec['page']-1, spec['line']-1
+    if not 0 <= page < len(pages) or not 0 <= line < len(pages[page]):
+        fail('xps_write_location')
+    if pages[page][line] != old:
+        fail('xps_write_stale_text')
+    pages[page][line] = new
+    checked_spec({'pages':pages}, font)
+    path = f'Documents/1/Pages/{page+1}.fpage'
+    # Reuse the independently accepted bounded ZIP record-preserving editor.
+    # Only this page XML changes; all other payload and local records remain.
+    from tools.scoped_legacy_openoffice_write import _rewrite
+    from tools.scoped_legacy_openoffice import LegacyOpenOfficeError
+    try:
+        result = _rewrite(data, {path:page_bytes(pages[page], ns)}, checkpoint)
+    except LegacyOpenOfficeError:
+        fail('xps_write_zip_profile')
+    read.extract_xps(result, format, checkpoint=checkpoint)
+    return result
+
+
+GUIDANCE = 'XPS/OXPS: xps_create creates a NEW fixed-page text file using exactly {"pages":[["First line","Second line"],["Next page"]]}. Native embedded unmodified DejaVuSans, explicit US Letter 816x1056 pages, 16-unit left-to-right lines, no automatic wrapping. 1..32 pages, 1..40 nonempty lines per page; bounded Latin/Cyrillic characters. xps_edit creates a NEW same-format copy using exactly {"source":"before.xps","source_sha256":"<read_file hash>","page":1,"line":1,"old_text":"First line","new_text":"Changed"}. Only this exact fixed-page text profile is editable; arbitrary existing XPS/OXPS layout refuses. One complete selected line changes; other part payloads/local records are preserved. No overwrite, conversion, font substitution, rendering or application-interoperability claim. '
