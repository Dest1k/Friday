+def _check_deflate_window(stream, max_distance, checkpoint):
+    # zlib has verified the dictionary-free stream, output and checksum. Some
+    # builds permit distances above CINFO, so scan RFC 1951 codes for that limit.
+    bits = _DeflateBits(stream)
+    final = False
+    while not final:
+        _checkpoint(checkpoint)
+        final = bits.read(1)
+        block_type = bits.read(2)
+        if block_type == 0:
+            bits.position = (bits.position + 7) & ~7
+            length = bits.read(16)
+            bits.position += 16 + 8 * length  # Skip NLEN and the stored bytes.
+            if bits.position > bits.limit:
+                _fail('invalid_photo')
+            continue
+        if block_type == 1:
+            literals, distances = _DEFLATE_FIXED_LITERALS, _DEFLATE_FIXED_DISTANCES
+        elif block_type == 2:
+            literals, distances = _deflate_dynamic_tables(bits)
+        else:
+            _fail('invalid_photo')
+        tokens = 0
+        while True:
+            if tokens == 256:
+                _checkpoint(checkpoint)
+                tokens = 0
+            symbol = bits.symbol(literals)
+            tokens += 1
+            if symbol < 256:
+                continue
+            if symbol == 256:
+                break
+            if 265 <= symbol <= 284:
+                bits.read((symbol - 261) // 4)
+            distance_code = bits.symbol(distances)
+            if distance_code < 4:
+                distance = 1 + distance_code
+            else:
+                extra = distance_code // 2 - 1
+                distance = 1 + ((2 + (distance_code % 2)) << extra) + bits.read(extra)
+            if distance > max_distance:
+                _fail('invalid_photo')
+    if ((bits.position + 7) & ~7) != bits.limit:
+        _fail('invalid_photo')
 
 
