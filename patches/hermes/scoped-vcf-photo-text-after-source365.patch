+class _DeflateBits:
+    def __init__(self, stream):
+        self.data = stream
+        self.position = 16  # Skip the zlib header.
+        self.limit = (len(stream) - 4) * 8  # Exclude the Adler-32 trailer.
+
+    def read(self, width):
+        start, offset = divmod(self.position, 8)
+        self.position += width
+        if self.position > self.limit:
+            _fail('invalid_photo')
+        end = (self.position + 7) // 8
+        return (int.from_bytes(self.data[start:end], 'little') >> offset) & ((1 << width) - 1)
+
+    def symbol(self, table):
+        codes, max_width = table
+        # Huffman codes are transmitted most-significant bit first. The leading
+        # 1 keeps prefixes of different widths distinct in the lookup table.
+        prefix = 1
+        for _ in range(max_width):
+            prefix = (prefix << 1) | self.read(1)
+            symbol = codes.get(prefix)
+            if symbol is not None:
+                return symbol
+        _fail('invalid_photo')
+
+
+def _deflate_huffman(lengths):
+    counts = [0] * 16
+    for width in lengths:
+        if width:
+            counts[width] += 1
+    next_codes = [0] * 16
+    for width in range(1, 16):
+        next_codes[width] = (next_codes[width - 1] + counts[width - 1]) << 1
+    codes = {}
+    for symbol, width in enumerate(lengths):
+        if width:
+            codes[(1 << width) | next_codes[width]] = symbol
+            next_codes[width] += 1
+    return codes, max(lengths)
+
+
+_DEFLATE_FIXED_LITERALS = _deflate_huffman([8] * 144 + [9] * 112 + [7] * 24 + [8] * 8)
+_DEFLATE_FIXED_DISTANCES = _deflate_huffman([5] * 32)
+
+
+def _deflate_dynamic_tables(bits):
+    literal_count = bits.read(5) + 257
+    distance_count = bits.read(5) + 1
+    code_count = bits.read(4) + 4
+    code_lengths = [0] * 19
+    code_order = (16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15)
+    for symbol in code_order[:code_count]:
+        code_lengths[symbol] = bits.read(3)
+    code_table = _deflate_huffman(code_lengths)
+    lengths = []
+    total = literal_count + distance_count
+    while len(lengths) < total:
+        symbol = bits.symbol(code_table)
+        if symbol < 16:
+            lengths.append(symbol)
+        elif symbol == 16 and lengths:
+            lengths.extend([lengths[-1]] * (3 + bits.read(2)))
+        elif symbol == 17:
+            lengths.extend([0] * (3 + bits.read(3)))
+        elif symbol == 18:
+            lengths.extend([0] * (11 + bits.read(7)))
+        else:
+            _fail('invalid_photo')
+    if len(lengths) != total:
+        _fail('invalid_photo')
+    return _deflate_huffman(lengths[:literal_count]), _deflate_huffman(lengths[literal_count:])
+
