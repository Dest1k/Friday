+    new_value = "в 20:15 по местному времени"
+    parser = BytesParser(policy=policy.default)
+    original_body = parser.parsebytes(original).get_payload(decode=True)
+    assert old_value.encode() not in original
+    assert original_body.count(old_value.encode()) == 1
+
+    edited = edit_communication(
+        original, {"field": "body", "old_value": old_value, "new_value": new_value}, "eml"
+    )
+
+    assert edited.startswith(_HEADERS)
+    assert parser.parsebytes(edited).get_payload(decode=True) == original_body.replace(
+        old_value.encode(), new_value.encode(), 1
+    )
+
+    subject = edit_communication(original, {
+        "old_value": "Окно сверки: лаборатория «Незабудка»",
+        "new_value": "Сверка завершена: лаборатория «Незабудка»",
+    }, "eml")
+    assert str(parser.parsebytes(subject)["Subject"]) == "Сверка завершена: лаборатория «Незабудка»"
+    assert subject.split(b"\r\n\r\n", 1)[1] == _TARGET_LINE + _TAIL
+
