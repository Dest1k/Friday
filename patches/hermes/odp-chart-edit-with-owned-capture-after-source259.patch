+def replace_chart_svm(prepared, fresh_svm, *, mime_type, data_type):
+    """Synchronize only the linked fallback with bytes from the caller's verified capture."""
+    _require(type(prepared) is PreparedChartEdit and type(prepared.binding) is ChartBinding
+             and type(prepared.data) is bytes, 'capture_binding')
+    _require(type(fresh_svm) is bytes and mime_type == GDI and data_type == '[]byte'
+             and 61 <= len(fresh_svm) <= _MAX_SVM_BYTES, 'capture_format')
+    bound = prepared.binding
+    _require(sha256(prepared.data).hexdigest() == bound.candidate_sha256, 'capture_binding')
+    infos, parts, selected = _source_chart(prepared.data, bound.slide)
+    # Verify the candidate and complete vector. The caller retains edit-intent
+    # provenance (including the target index); the fallback belongs to the
+    # whole selected chart and is never selected by this index.
+    _require(type(bound.target_index) is int and 0 <= bound.target_index < len(selected.values)
+             and _binding(prepared.data, bound.slide, selected, bound.target_index) == bound, 'capture_binding')
+    _svm(fresh_svm)
+    if parts[bound.replacement_part] == fresh_svm:
+        return prepared.data
+    changes = {bound.replacement_part: fresh_svm}
+    result = _rewrite(infos, parts, changes)
+    _, after, _ = _source_chart(result, bound.slide)
+    _proof_rewrite(parts, after, changes)
+    return result
