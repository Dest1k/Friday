+                    result = replace_chart_svm(prepared, fresh, mime_type=mime_type, data_type=data_type)
+                else:
+                    result = edit_profile(original, format, request['edit'])
                 details['preserving_edit'] = True
             else:
                 result = _convert(cap, original, format, target)
