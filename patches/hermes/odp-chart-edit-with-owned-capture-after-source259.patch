diff --git a/hermes_cli/friday_workspace_odp_chart_capture.py b/hermes_cli/friday_workspace_odp_chart_capture.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/friday_workspace_odp_chart_capture.py
@@ -0,0 +1,392 @@
+"""Capture the preferred graphic of one owned, validated ODP chart."""
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import runpy
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+from uuid import uuid4
+
+_PREFIX = '/opt/friday-document-toolchain'
+_PROGRAM = _PREFIX + '/root/usr/lib/libreoffice/program'
+_PYTHON_HOME = _PROGRAM + '/python-core-3.12.13'
+_DOCUMENT = Path('/work/input.odp')
+_BINDING = Path('/work/binding.json')
+_OUT = Path('/work/out')
+_CHART_CLASS = bytes.fromhex('12dcae26281f416fa234c3086127382e')
+_CHART_IMPL = 'com.sun.star.comp.chart2.ChartModel'
+_MIME = 'application/x-openoffice-gdimetafile;windows_formatname="GDIMetaFile"'
+_DATA_TYPE = '[]byte'
+_MAX_SVM_BYTES = 32768
+_MAX_BINDING_BYTES = 65536
+_BINDING_FIELDS = (
+    'candidate_sha256', 'slide', 'chart_part', 'replacement_part', 'frame_name',
+    'series', 'categories', 'values', 'target_index',
+)
+_DECIMAL = re.compile(r'-?(?:[0-9]{1,15})(?:\.[0-9]{1,12})?\Z')
+
+
+def _require(condition):
+    if not condition:
+        raise ValueError('odp_chart_capture_contract')
+
+
+def _sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _json(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode('utf-8')
+
+
+def _expected_values(binding):
+    _require(type(binding) is dict and set(binding) == set(_BINDING_FIELDS))
+    _require(re.fullmatch('[a-f0-9]{64}', binding['candidate_sha256']) is not None)
+    _require(type(binding['slide']) is int and 1 <= binding['slide'] <= 200)
+    for name in ('chart_part', 'replacement_part', 'frame_name', 'series'):
+        text = binding[name]
+        _require(type(text) is str and 0 < len(text.encode('utf-8')) <= 1024 and '\x00' not in text)
+    categories, values = binding['categories'], binding['values']
+    _require(type(categories) is list and type(values) is list and 1 <= len(categories) == len(values) <= 128)
+    _require(all(type(item) is str and 0 < len(item.encode('utf-8')) <= 256 and '\x00' not in item for item in categories))
+    _require(len(set(categories)) == len(categories))
+    _require(type(binding['target_index']) is int and 0 <= binding['target_index'] < len(values))
+    _require(all(type(item) is str and _DECIMAL.fullmatch(item) for item in values))
+    numbers = tuple(float(item) for item in values)
+    _require(all(map(math.isfinite, numbers)))
+    return tuple(categories), numbers
+
+
+def _argv(work, toolchain):
+    from hermes_cli.friday_workspace_presentation import _argv as presentation_argv
+
+    argv = presentation_argv(work, toolchain, 'odp_pptx')
+    rest = ['/usr/bin/python3', '-I', '-B', '-S', '/renderer.py', '--render', 'odp_pptx']
+    _require(argv[-len(rest):] == rest)
+    argv[-len(rest):] = [_PROGRAM + '/python.bin', '-B', '-S', '-s', '-P', '/renderer.py']
+    boundary = argv.index('--remount-ro')
+    argv[boundary:boundary] = [
+        '--ro-bind', str(work/'binding.json'), str(_BINDING),
+        '--ro-bind', str(work/'profile_helper.py'), '/profile_helper.py',
+        '--setenv', 'PYTHONHOME', _PYTHON_HOME,
+        '--setenv', 'PYTHONPATH', f'{_PROGRAM}:{_PYTHON_HOME}/lib:{_PYTHON_HOME}/lib/lib-dynload',
+        '--setenv', 'URE_BOOTSTRAP', f'vnd.sun.star.pathname:{_PROGRAM}/fundamentalrc',
+        '--setenv', 'LD_LIBRARY_PATH', f'{_PROGRAM}:{_PREFIX}/root/usr/lib/x86_64-linux-gnu',
+        '--setenv', 'LANG', 'C.UTF-8',
+        '--setenv', 'LC_ALL', 'C.UTF-8',
+    ]
+    return argv
+
+
+def _read_capture(work, request):
+    from hermes_cli.friday_workspace_pdf import _private_bytes
+
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    root = os.open(work, flags)
+    output = None
+    try:
+        output = os.open('out', flags, dir_fd=root)
+        for descriptor in (root, output):
+            info = os.fstat(descriptor)
+            _require(info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) == 0o700)
+        _require(set(os.listdir(output)) == {'chart.svm', 'capture.json'})
+        fresh = _private_bytes(output, 'chart.svm', _MAX_SVM_BYTES)
+        reported = _private_bytes(output, 'capture.json', 4096)
+    finally:
+        if output is not None:
+            os.close(output)
+        os.close(root)
+    _require(len(fresh) >= 61 and reported == _json(_proof(request, fresh)))
+    return fresh
+
+
+def _proof(request, fresh):
+    return dict(binding_sha256=_sha(request), fresh_sha256=_sha(fresh), bytes=len(fresh),
+                mime_type=_MIME, data_type=_DATA_TYPE, chart_model=_CHART_IMPL,
+                document_closed=True, owned_office_reaped=True, office_binary_identity_verified=True)
+
+
+def _mark_cleanup_unknown():
+    from agent.web_call_context import _current
+    call = _current.get()
+    if call is not None and hasattr(call, 'agent'):
+        call.agent._friday_reply_effect_unknown = True
+
+
+def capture_chart_svm(cap, prepared):
+    """Return fresh bytes after the originating native child has closed."""
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli import friday_workspace_presentation
+    from hermes_cli.friday_workspace_pdf import ExportRefused, _run, _toolchain
+    from hermes_cli.friday_workspace_revision import check
+
+    check(cap)
+    work = None
+    settled = True
+    try:
+        binding = {name: getattr(prepared.binding, name) for name in _BINDING_FIELDS}
+        binding['categories'] = list(binding['categories'])
+        binding['values'] = list(binding['values'])
+        _expected_values(binding)
+        _require(type(prepared.data) is bytes and 0 < len(prepared.data) <= 1_000_000)
+        _require(_sha(prepared.data) == binding['candidate_sha256'])
+        request = _json(binding)
+        _require(0 < len(request) <= _MAX_BINDING_BYTES)
+        toolchain = _toolchain(family='presentation')
+        work = Path(tempfile.mkdtemp(prefix='friday-odp-chart-'))
+        for name in ('out', 'home', 'tmp'):
+            (work/name).mkdir(mode=0o700)
+        for name, data in (('input.odp', prepared.data), ('binding.json', request),
+                           ('renderer.py', Path(__file__).read_bytes()),
+                           ('profile_helper.py', Path(friday_workspace_presentation.__file__).read_bytes())):
+            with os.fdopen(os.open(work/name, os.O_WRONLY|os.O_CREAT|os.O_EXCL, 0o600), 'wb') as output:
+                output.write(data)
+        check(cap)
+        _run(cap, _argv(work, toolchain), work)
+        check(cap)
+        fresh = _read_capture(work, request)
+        check(cap)
+        return fresh, _MIME, _DATA_TYPE
+    except (ScopeDenied, TimeoutError):
+        raise
+    except ExportRefused as error:
+        if str(error) == 'renderer_cleanup_unconfirmed':
+            settled = False
+        raise
+    except (OSError, TypeError, ValueError) as error:
+        raise ExportRefused('odp_chart_capture_refused') from error
+    finally:
+        if work is not None and settled:
+            try:
+                shutil.rmtree(work)
+            except OSError:
+                _mark_cleanup_unknown()
+                raise ExportRefused('renderer_cleanup_unconfirmed') from None
+
+
+def _one_object(doc, binding):
+    count = 0
+    selected = None
+    budget = 4096
+
+    def walk(shape, slide, direct, depth):
+        nonlocal count, selected, budget
+        budget -= 1
+        _require(depth <= 12 and budget >= 0)
+        if shape.supportsService('com.sun.star.drawing.GroupShape'):
+            for index in range(shape.getCount()):
+                walk(shape.getByIndex(index), slide, False, depth+1)
+            return
+        properties = shape.getPropertySetInfo()
+        if not properties.hasPropertyByName('EmbeddedObjectNoNewClient'):
+            return
+        obj = shape.getPropertyValue('EmbeddedObjectNoNewClient')
+        if obj is None:
+            return
+        count += 1
+        _require(count == 1 and direct and slide == binding['slide'])
+        _require(properties.hasPropertyByName('Name') and shape.getPropertyValue('Name') == binding['frame_name'])
+        _require(_bytes(obj.getClassID()) == _CHART_CLASS)
+        selected = obj
+
+    pages = doc.getDrawPages()
+    _require(binding['slide'] <= pages.getCount() <= 200)
+    for index in range(pages.getCount()):
+        page = pages.getByIndex(index)
+        for offset in range(page.getCount()):
+            walk(page.getByIndex(offset), index+1, True, 0)
+        notes = page.getNotesPage()
+        for offset in range(notes.getCount()):
+            walk(notes.getByIndex(offset), None, False, 0)
+    _require(count == 1 and selected is not None)
+    return selected
+
+
+def _bytes(value):
+    raw = getattr(value, 'value', value)
+    _require(type(raw) is bytes)
+    return raw
+
+
+def _check_data(model, binding, expected):
+    categories, numbers = expected
+    data = model.getData()
+    _require(tuple(data.getColumnDescriptions()) == (binding['series'],))
+    _require(tuple(data.getRowDescriptions()) == categories)
+    rows = tuple(data.getData())
+    _require(len(rows) == len(numbers) and all(len(row) == 1 for row in rows))
+    observed = tuple(row[0] for row in rows)
+    _require(all(type(item) is float and math.isfinite(item) for item in observed))
+    _require(observed == numbers)
+
+
+def _graphic(doc, uno, binding, expected):
+    selected = _one_object(doc, binding)
+    links = selected.queryInterface(uno.getTypeByName('com.sun.star.embed.XLinkageSupport'))
+    _require(links is not None and not links.isLink())
+    loaded = uno.getConstantByName('com.sun.star.embed.EmbedStates.LOADED')
+    running = uno.getConstantByName('com.sun.star.embed.EmbedStates.RUNNING')
+    state = selected.getCurrentState()
+    _require(state in (loaded, running))
+    if state == loaded:
+        selected.changeState(running)
+    _require(selected.getCurrentState() == running and not links.isLink())
+    model = selected.getComponent()
+    _require(model is not None and model.getImplementationName() == _CHART_IMPL)
+    _require(model.hasInternalDataProvider())
+    _require(model.getPropertySetInfo().hasPropertyByName('AddIn') and model.getPropertyValue('AddIn') is None)
+    _check_data(model, binding, expected)
+    endpoint = model.queryInterface(uno.getTypeByName('com.sun.star.embed.XVisualObject'))
+    _require(endpoint is not None)
+    mode = uno.getConstantByName('com.sun.star.embed.Aspects.MSOLE_CONTENT')
+    _require(type(mode) is int and mode == 1)
+    graphic = endpoint.getPreferredVisualRepresentation(mode)
+    _require(graphic.Flavor.MimeType == _MIME and graphic.Flavor.DataType == uno.getTypeByName(_DATA_TYPE))
+    fresh = _bytes(graphic.Data)
+    _require(61 <= len(fresh) <= _MAX_SVM_BYTES)
+    _require(selected.getCurrentState() == running and selected.getComponent() == model and not links.isLink())
+    _check_data(model, binding, expected)
+    return fresh
+
+
+def _limited_file(path, limit):
+    with path.open('rb') as stream:
+        raw = stream.read(limit+1)
+    _require(0 < len(raw) <= limit)
+    return raw
+
+
+def _component():
+    import resource
+    import uno
+    import unohelper
+    import pyuno
+    from com.sun.star.connection import NoConnectException
+    from com.sun.star.task import XInteractionHandler
+
+    _require(all(Path(module.__file__).resolve().parent == Path(_PROGRAM) for module in (uno, unohelper, pyuno)))
+    os.umask(0o077)
+    os.sched_setaffinity(0, sorted(os.sched_getaffinity(0))[:2])
+    for key, limit in ((resource.RLIMIT_AS, 2*1024**3), (resource.RLIMIT_CPU, 35),
+                       (resource.RLIMIT_FSIZE, 16*1024**2), (resource.RLIMIT_CORE, 0),
+                       (resource.RLIMIT_NOFILE, 128)):
+        resource.setrlimit(key, (limit, limit))
+
+    request = _limited_file(_BINDING, _MAX_BINDING_BYTES)
+    binding = json.loads(request)
+    _require(request == _json(binding))
+    expected = _expected_values(binding)
+    _require(_sha(_limited_file(_DOCUMENT, 1_000_000)) == binding['candidate_sha256'])
+    abort_type = uno.getTypeByName('com.sun.star.task.XInteractionAbort')
+
+    class AbortOnly(unohelper.Base, XInteractionHandler):
+        interrupted = False
+
+        def handle(self, request):
+            self.interrupted = True
+            for choice in request.getContinuations():
+                abort = choice.queryInterface(abort_type)
+                if abort is not None:
+                    abort.select()
+                    return
+            raise ValueError('odp_chart_interaction_refused')
+
+    def prop(name, value):
+        item = uno.createUnoStruct('com.sun.star.beans.PropertyValue')
+        item.Name, item.Value = name, value
+        return item
+
+    bootstrap = uno.getComponentContext()
+    resolver = bootstrap.ServiceManager.createInstanceWithContext('com.sun.star.bridge.UnoUrlResolver', bootstrap)
+    pipe = 'frw-odp-chart-' + uuid4().hex
+    command = [_PROGRAM+'/soffice.bin', '--headless', '--norestore', '--nodefault', '--nofirststartwizard',
+               '-env:UserInstallation=file:///work/home/profile', f'--accept=pipe,name={pipe};urp;']
+    env = dict(PATH='/usr/bin:/bin', HOME='/work/home', TMPDIR='/work/tmp', LANG='C.UTF-8',
+               LC_ALL='C.UTF-8', SAL_USE_VCLPLUGIN='svp', XDG_CACHE_HOME='/work/home/cache',
+               XDG_CONFIG_HOME='/work/home/config', XDG_RUNTIME_DIR='/work/tmp',
+               URE_BOOTSTRAP=f'vnd.sun.star.pathname:{_PROGRAM}/fundamentalrc',
+               LD_LIBRARY_PATH=f'{_PROGRAM}:{_PREFIX}/root/usr/lib/x86_64-linux-gnu')
+    deadline = time.monotonic() + 35
+    # The presentation bank requests a restart on its first extension-cache
+    # initialization. Use its existing document-free trusted preparation.
+    profile = runpy.run_path('/profile_helper.py')['_prepare_presentation_profile']
+    profile(_PROGRAM, env, deadline)
+    executable = Path(command[0]).stat()
+    process = subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL)
+    desktop = doc = None
+    try:
+        end = min(deadline, time.monotonic()+12)
+        while True:
+            try:
+                remote = resolver.resolve(f'uno:pipe,name={pipe};urp;StarOffice.ComponentContext')
+                break
+            except NoConnectException:
+                _require(process.poll() is None and time.monotonic() < end)
+                time.sleep(0.04)
+        live = Path(f'/proc/{process.pid}/exe').stat()
+        _require(process.poll() is None and (live.st_dev, live.st_ino) == (executable.st_dev, executable.st_ino))
+        desktop = remote.ServiceManager.createInstanceWithContext('com.sun.star.frame.Desktop', remote)
+        handler = AbortOnly()
+        never = uno.getConstantByName('com.sun.star.document.MacroExecMode.NEVER_EXECUTE')
+        no_update = uno.getConstantByName('com.sun.star.document.UpdateDocMode.NO_UPDATE')
+        _require(type(never) is int and type(no_update) is int and never == no_update == 0)
+        args = tuple(prop(name, value) for name, value in (
+            ('ReadOnly', True), ('Hidden', True), ('Silent', True),
+            ('MacroExecutionMode', uno.Any('short', never)), ('UpdateDocMode', uno.Any('short', no_update)),
+            ('InteractionHandler', handler),
+        ))
+        url = _DOCUMENT.as_uri()
+        doc = desktop.loadComponentFromURL(url, '_blank', 0, args)
+        _require(doc is not None and not handler.interrupted and doc.isReadonly() and doc.getURL() == url)
+        _require(doc.supportsService('com.sun.star.presentation.PresentationDocument') and not doc.isModified())
+        fresh = _graphic(doc, uno, binding, expected)
+        _require(not handler.interrupted and doc.isReadonly() and doc.getURL() == url and not doc.isModified())
+        doc.close(True)
+        doc = None
+        _require(desktop.terminate())
+        desktop = None
+        _require(process.wait(timeout=5) == 0)
+        _require(_limited_file(_BINDING, _MAX_BINDING_BYTES) == request)
+        _require(_sha(_limited_file(_DOCUMENT, 1_000_000)) == binding['candidate_sha256'])
+        with (_OUT/'chart.svm').open('xb') as blob:
+            blob.write(fresh)
+        with (_OUT/'capture.json').open('xb') as report:
+            report.write(_json(_proof(request, fresh)))
+    finally:
+        try:
+            if doc is not None:
+                doc.dispose()
+            if desktop is not None:
+                desktop.terminate()
+        finally:
+            if process.poll() is None:
+                process.terminate()
+                try:
+                    process.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=2)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 1 or Path.cwd() != Path('/work') or not sys.dont_write_bytecode:
+        raise SystemExit(2)
+    try:
+        _component()
+    except Exception as error:
+        trace = error.__traceback__
+        locations = []
+        while trace is not None:
+            code = trace.tb_frame.f_code
+            if code.co_filename == __file__:
+                locations.append([code.co_name, trace.tb_lineno])
+            trace = trace.tb_next
+        sys.stderr.write(_json(dict(error=type(error).__name__, local_sites=locations)).decode()+'\n')
+        raise SystemExit(1) from None
