+"""Pure edits for one locally bound bar chart in a passive ODP.
+
+The caller owns workspace custody, the same-call ChartModel observation, and
+publication. This module never opens a path or starts a renderer.
+"""
+
+from dataclasses import dataclass
+from decimal import Decimal
+from hashlib import sha256
+from io import BytesIO
+import math
+import re
+from xml.etree import ElementTree as ET
+
+from tools.scoped_presentation import CH, DR, O, PR, T, TB, XL, Package, PresentationError, q
+from tools.scoped_presentation_generated_odp import GDI, _manifest, _resources, _svm, _xml_profile
+from tools.scoped_presentation_layout import _length, _patch, _spans, require_title_preimage
+from tools.scoped_presentation_odp_text_source import source_parts
+from tools.scoped_presentation_text import edit_text
+from tools.scoped_presentation_variants import _namespaces
+from tools.scoped_presentation_write import PresentationRefused, _odp_structure, _rewrite, _xml, decimal, text
+
+_SVG = 'urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0'
+_STYLE = 'urn:oasis:names:tc:opendocument:xmlns:style:1.0'
+_FO = 'urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0'
+_NUM = 'urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0'
+_META = 'urn:oasis:names:tc:opendocument:xmlns:meta:1.0'
+_LO = 'urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0'
+_OO = 'http://openoffice.org/2010/chart'
+_CELL = q(TB, 'table-cell')
+_DISPLAY = q(T, 'p')
+_VALUE = q(O, 'value')
+_TYPE = q(O, 'value-type')
+_EXTERNAL_DATA = q(_LO, 'external-data')
+_MAX_ROWS = 64
+_MAX_SVM_BYTES = 32768
+_VALUE_TOKEN = re.compile(rb'\soffice:value\s*=\s*(["\'])([^"\']*)\1')
+_ACTIVE_NAMESPACES = tuple('{' + uri + '}' for uri in (
+    'urn:oasis:names:tc:opendocument:xmlns:form:1.0',
+    'urn:oasis:names:tc:opendocument:xmlns:script:1.0',
+    'http://openoffice.org/2000/script',
+    'http://www.w3.org/2002/xforms',
+    'http://www.w3.org/2001/xml-events',
+    'http://www.w3.org/2001/SMIL20/',
+    'urn:oasis:names:tc:opendocument:xmlns:smil-compatible:1.0',
+    'urn:oasis:names:tc:opendocument:xmlns:animation:1.0',
+))
+_GEOMETRY = {q(_SVG, part) for part in ('width', 'height', 'x', 'y')}
+_STYLE_REF = {q(CH, 'style-name')}
+
+# This is a chart subdocument profile. The presentation, theme and notes keep
+# their existing passive package guards. No other chart kinds or import modes
+# are implied by the editing surface.
+_CHART_ATTRIBUTES = {
+    q(O, 'document-content'): {q(O, 'version')},
+    q(O, 'automatic-styles'): set(), q(O, 'body'): set(), q(O, 'chart'): set(),
+    q(CH, 'chart'): {q(CH, 'class'), q(XL, 'href'), q(XL, 'type')} | _STYLE_REF | _GEOMETRY,
+    q(CH, 'title'): _STYLE_REF | _GEOMETRY,
+    q(CH, 'plot-area'): _STYLE_REF | _GEOMETRY,
+    q(CH, 'coordinate-region'): _GEOMETRY,
+    q(CH, 'axis'): {q(CH, 'dimension'), q(CH, 'name'), q(_OO, 'axis-type')} | _STYLE_REF,
+    q(_OO, 'date-scale'): set(),
+    q(CH, 'categories'): {q(TB, 'cell-range-address')},
+    q(CH, 'grid'): {q(CH, 'class')} | _STYLE_REF,
+    q(CH, 'series'): {q(CH, name) for name in ('class', 'label-cell-address', 'values-cell-range-address')} | _STYLE_REF,
+    q(CH, 'data-point'): {q(CH, 'repeated')},
+    q(CH, 'wall'): _STYLE_REF, q(CH, 'floor'): _STYLE_REF,
+    q(TB, 'table'): {q(TB, 'name')},
+    q(TB, 'table-header-columns'): set(), q(TB, 'table-columns'): set(),
+    q(TB, 'table-column'): set(), q(TB, 'table-header-rows'): set(),
+    q(TB, 'table-rows'): set(), q(TB, 'table-row'): set(), _CELL: {_TYPE, _VALUE},
+    _DISPLAY: set(), q(T, 'span'): {q(T, 'style-name')},
+    q(_STYLE, 'style'): {q(_STYLE, name) for name in ('data-style-name', 'family', 'name')},
+    q(_STYLE, 'graphic-properties'): {q(DR, name) for name in ('fill', 'fill-color', 'stroke')} |
+                                     {q(_SVG, name) for name in ('stroke-color', 'stroke-width')},
+    q(_STYLE, 'text-properties'): {q(_FO, name) for name in ('color', 'font-family', 'font-size', 'font-weight')} |
+                                  {q(_STYLE, name) for name in ('font-size-asian', 'font-size-complex',
+                                       'font-weight-asian', 'font-weight-complex', 'text-position')},
+    q(_STYLE, 'chart-properties'): {q(CH, name) for name in (
+        'auto-position', 'auto-size', 'axis-position', 'display-label', 'gap-width', 'include-hidden-cells',
+        'interval-minor-divisor', 'label-arrangement', 'link-data-style-to-source', 'logarithmic',
+        'reverse-direction', 'tick-mark-position', 'treat-empty-cells')} |
+        {_EXTERNAL_DATA, q(_LO, 'try-staggering-first'), q(_STYLE, 'rotation-angle'), q(T, 'line-break')},
+    q(_NUM, 'number-style'): {q(_STYLE, 'name')},
+    q(_NUM, 'date-style'): {q(_STYLE, 'name')} | {q(_NUM, name) for name in ('automatic-order', 'country', 'language')},
+    q(_NUM, 'number'): {q(_NUM, 'min-integer-digits')},
+    q(_NUM, 'text'): set(),
+    **{q(_NUM, tag): {q(_NUM, 'style')} for tag in ('day', 'month', 'year')},
+}
+
+
+@dataclass(frozen=True)
+class ChartBinding:
+    candidate_sha256: str
+    slide: int
+    chart_part: str
+    replacement_part: str
+    frame_name: str
+    series: str
+    categories: tuple[str, ...]
+    values: tuple[str, ...]
+    target_index: int
+
+
+@dataclass(frozen=True)
+class PreparedChartEdit:
+    data: bytes
+    binding: ChartBinding
+
+
+@dataclass(frozen=True)
+class _Selection:
+    slides: list
+    chart_part: str
+    replacement_part: str
+    frame: ET.Element
+    chart_root: ET.Element
+    series: str
+    categories: tuple[str, ...]
+    values: tuple[str, ...]
+    value_cells: tuple[ET.Element, ...]
+
+
+def _require(condition, reason):
+    if not condition:
+        raise PresentationRefused('odp_chart_' + reason)
+
+
+def _request_text(value, *, limit=4000, empty=False):
+    try:
+        return text(value, limit=limit, empty=empty)
+    except UnicodeError:
+        raise PresentationRefused('odp_chart_invalid_text') from None
+
+
+def _children(node, *tags):
+    _require(tuple(child.tag for child in node) == tags, 'structure')
+    return tuple(node)
+
+
+def _chart_styles(automatic, plot_style):
+    names = {}
+    for style in automatic:
+        name = style.get(q(_STYLE, 'name'))
+        _require(name and name not in names, 'style')
+        names[name] = style
+        if style.tag == q(_STYLE, 'style'):
+            _require(style.get(q(_STYLE, 'family')) in ('chart', 'text'), 'style')
+            allowed = {q(_STYLE, tag) for tag in ('chart-properties', 'graphic-properties', 'text-properties')}
+        elif style.tag == q(_NUM, 'number-style'):
+            allowed = {q(_NUM, 'number')}
+        else:
+            _require(style.tag == q(_NUM, 'date-style'), 'style')
+            allowed = {q(_NUM, tag) for tag in ('day', 'month', 'year', 'text')}
+        _require(all(child.tag in allowed and not len(child) for child in style), 'style')
+        if style.tag == q(_STYLE, 'style'):
+            _require(len({child.tag for child in style}) == len(style), 'style')
+    _require(plot_style in names and names[plot_style].tag == q(_STYLE, 'style')
+             and names[plot_style].get(q(_STYLE, 'family')) == 'chart', 'style')
+    return names[plot_style].find(q(_STYLE, 'chart-properties'))
+
+
+def _plain_cell(cell, kind):
+    paragraph, = _children(cell, _DISPLAY)
+    _require(not len(paragraph), 'cell')
+    if kind == 'empty':
+        _require(not cell.attrib and not paragraph.text, 'cell')
+        return ''
+    _require(cell.get(_TYPE) == kind, 'cell')
+    value = paragraph.text
+    if kind == 'string':
+        _require(set(cell.attrib) == {_TYPE}, 'cell')
+        return text(value, limit=256)
+    _require(set(cell.attrib) == {_TYPE, _VALUE} and value == cell.get(_VALUE), 'display_value')
+    decimal(value)
+    return value
+
+
+def _local_table(table, series, category_axis, data_point):
+    header_cols, data_cols, header_rows, data_rows = _children(
+        table, *(q(TB, name) for name in ('table-header-columns', 'table-columns', 'table-header-rows', 'table-rows')))
+    for cols in (header_cols, data_cols):
+        column, = _children(cols, q(TB, 'table-column'))
+        _children(column)
+    header, = _children(header_rows, q(TB, 'table-row'))
+    corner, label = _children(header, _CELL, _CELL)
+    _plain_cell(corner, 'empty')
+    series_name = _plain_cell(label, 'string')
+    name = table.get(q(TB, 'name'), '')
+    _require(re.fullmatch(r'[A-Za-z_][A-Za-z0-9_-]{0,63}', name) and 1 <= len(data_rows) <= _MAX_ROWS, 'table')
+    last = len(data_rows) + 1
+    _require(series.get(q(CH, 'label-cell-address')) == f'{name}.$B$1'
+             and series.get(q(CH, 'values-cell-range-address')) == f'{name}.$B$2:.$B${last}'
+             and category_axis.get(q(TB, 'cell-range-address')) == f'{name}.$A$2:.$A${last}'
+             and data_point.get(q(CH, 'repeated')) == str(len(data_rows)), 'local_ranges')
+    categories, values, cells = [], [], []
+    for row in data_rows:
+        _require(row.tag == q(TB, 'table-row'), 'cell')
+        category, cell = _children(row, _CELL, _CELL)
+        categories.append(_plain_cell(category, 'string'))
+        values.append(_plain_cell(cell, 'float'))
+        cells.append(cell)
+    _require(len(set(categories)) == len(categories), 'category_ambiguous')
+    return series_name, tuple(categories), tuple(values), tuple(cells)
+
+
+def _chart(raw, document):
+    root = _xml(raw)
+    # QName-valued chart:class must be bound at its point of use. A
+    # declaration in a sibling style does not bind it in the chart body.
+    root_namespaces = {}
+    for event, binding in ET.iterparse(BytesIO(raw), events=('start-ns', 'start')):
+        if event == 'start':
+            break
+        prefix, uri = binding
+        root_namespaces[prefix] = uri
+    _require(root_namespaces.get('chart') == CH and root_namespaces.get('office') == O, 'namespace')
+    _namespaces(raw)  # Refuse any disguised nested rebindings.
+    for node in root.iter():
+        _require(node.tag in _CHART_ATTRIBUTES and set(node.attrib) <= _CHART_ATTRIBUTES[node.tag], 'chart_xml')
+        _require(not (node.tail or '').strip() and (
+            node.tag in (_DISPLAY, q(T, 'span'), q(_NUM, 'text')) or not (node.text or '').strip()), 'chart_xml')
+    _require(root.tag == q(O, 'document-content'), 'structure')
+    automatic, body = _children(root, q(O, 'automatic-styles'), q(O, 'body'))
+    office_chart, = _children(body, q(O, 'chart'))
+    chart, = _children(office_chart, q(CH, 'chart'))
+    _require(chart.get(q(CH, 'class')) == 'chart:bar' and chart.get(q(XL, 'href')) == '.'
+             and chart.get(q(XL, 'type')) == 'simple', 'kind')
+    title, plot, table = _children(chart, q(CH, 'title'), q(CH, 'plot-area'), q(TB, 'table'))
+    title_text, = _children(title, _DISPLAY)
+    if len(title_text):
+        span, = _children(title_text, q(T, 'span'))
+        _children(span)
+    coord, x_axis, y_axis, series, wall, floor = _children(
+        plot, *(q(CH, tag) for tag in ('coordinate-region', 'axis', 'axis', 'series', 'wall', 'floor')))
+    date_scale, category_axis = _children(x_axis, q(_OO, 'date-scale'), q(CH, 'categories'))
+    grid, = _children(y_axis, q(CH, 'grid'))
+    for node in (coord, date_scale, category_axis, grid, wall, floor):
+        _children(node)
+    _require(x_axis.get(q(CH, 'dimension')) == 'x' and x_axis.get(q(_OO, 'axis-type')) in (None, 'auto')
+             and y_axis.get(q(CH, 'dimension')) == 'y' and q(_OO, 'axis-type') not in y_axis.attrib
+             and grid.get(q(CH, 'class')) == 'major' and series.get(q(CH, 'class')) == 'chart:bar', 'kind')
+    data_point, = _children(series, q(CH, 'data-point'))
+    _children(data_point)
+    props = _chart_styles(automatic, plot.get(q(CH, 'style-name')))
+    for node in root.iter():
+        if _EXTERNAL_DATA in node.attrib:
+            # Import provenance on the selected plot style, not a link or provider.
+            _require(node is props and re.fullmatch(r'ppt/embeddings/[A-Za-z0-9_ -]{1,72}\.xlsx',
+                                                     node.get(_EXTERNAL_DATA)), 'external_data')
+    foreign_chart = ('{' + CH + '}', '{' + _OO + '}')
+    for subdoc in document:
+        for node in subdoc.iter():
+            _require(node.tag != q(O, 'forms') and not node.tag.startswith(_ACTIVE_NAMESPACES)
+                     and not any(name.startswith(_ACTIVE_NAMESPACES) for name in node.attrib), 'active_context')
+            _require(_EXTERNAL_DATA not in node.attrib and not node.tag.startswith(foreign_chart)
+                     and not any(name.startswith(foreign_chart) for name in node.attrib), 'other_chart_context')
+    return root, _local_table(table, series, category_axis, data_point)
+
+
+def _auxiliary(parts, object_name):
+    styles = parts.get(object_name + '/styles.xml')
+    if styles is not None:
+        root = _xml(styles)
+        _require(root.tag == q(O, 'document-styles') and set(root.attrib) <= {q(O, 'version')}, 'object_auxiliary')
+        section, = _children(root, q(O, 'styles'))
+        _require(not section.attrib and not len(section) and not (section.text or '').strip(), 'object_auxiliary')
+    meta = parts.get(object_name + '/meta.xml')
+    if meta is not None:
+        root = _xml(meta)
+        _require(root.tag == q(O, 'document-meta') and set(root.attrib) <= {q(O, 'version')}, 'object_auxiliary')
+        section, = _children(root, q(O, 'meta'))
+        generator, = _children(section, q(_META, 'generator'))
+        _require(not section.attrib and not generator.attrib and not len(generator), 'object_auxiliary')
+
+
+def _source_chart(data, slide):
+    infos, parts = source_parts(data)
+    _, slides = _odp_structure(infos, parts)
+    _require(type(slide) is int and 1 <= slide <= len(slides), 'slide')
+    try:
+        pkg = Package(data)
+        objects = _manifest(pkg)
+        _xml_profile(pkg, objects)
+        _resources(pkg, objects)
+    except PresentationError as error:
+        raise PresentationRefused(str(error)) from None
+    _require(len(objects) == 1, 'object')
+    object_name, = objects
+    chart_part = object_name + '/content.xml'
+    replacement = 'ObjectReplacements/' + object_name
+    _require(replacement in parts, 'replacement')
+    page = slides[slide - 1]
+    _require(page.get(q(PR, 'visibility')) in (None, 'visible') and page.get(q(DR, 'display')) is None, 'slide')
+    all_objects = [(name, node) for name, root in pkg.xml.items() for node in root.iter(q(DR, 'object'))]
+    frames = [frame for frame in page if frame.tag == q(DR, 'frame') and frame.find(q(DR, 'object')) is not None]
+    _require(len(all_objects) == 1 and all_objects[0][0] == 'content.xml' and len(frames) == 1, 'object')
+    frame, = frames
+    frame_attrs = _GEOMETRY | {q(DR, key) for key in ('name', 'style-name', 'text-style-name', 'layer')}
+    frame_name = frame.get(q(DR, 'name'))
+    _require(set(frame.attrib) <= frame_attrs and frame.get(q(DR, 'layer')) in (None, 'layout')
+             and frame_name and sum(node.get(q(DR, 'name')) == frame_name for node in page.iter()) == 1, 'frame')
+    text(frame_name, limit=256)
+    geometry = {field: _length(frame.get(q(_SVG, field))) for field in ('width', 'height', 'x', 'y')}
+    _require(geometry['width'] > 0 and geometry['height'] > 0, 'frame')
+    graphics = [style for root in pkg.xml.values() for style in root.iter(q(_STYLE, 'style'))
+                if style.get(q(_STYLE, 'family')) == 'graphic'
+                and style.get(q(_STYLE, 'name')) == frame.get(q(DR, 'style-name'))]
+    _require(len(graphics) == 1, 'aspect')
+    props = graphics[0].findall(q(_STYLE, 'graphic-properties'))
+    _require(len(props) == 1 and props[0].get(q(DR, 'ole-draw-aspect')) == '1', 'aspect')
+    obj, image = _children(frame, q(DR, 'object'), q(DR, 'image'))
+    link = {q(XL, 'type'): 'simple', q(XL, 'show'): 'embed', q(XL, 'actuate'): 'onLoad'}
+    _require(obj.attrib == {**link, q(XL, 'href'): './' + object_name}
+             and image.attrib == {**link, q(XL, 'href'): './' + replacement} and not len(image)
+             and len(obj) <= 1, 'object_link')
+    _auxiliary(parts, object_name)
+    chart_root, table = _chart(parts[chart_part], [root for name, root in pkg.xml.items() if name != chart_part])
+    return infos, parts, _Selection(slides, chart_part, replacement, frame, chart_root, *table)
+
+
+def _chart_bytes(raw, root, cell, replacement):
+    paragraph, = _children(cell, _DISPLAY)
+    begin, _, opening_end, empty = _spans(raw, root, _CELL)[cell]
+    matches = list(_VALUE_TOKEN.finditer(raw[begin:opening_end]))
+    _require(not empty and len(matches) == 1 and matches[0][2] == cell.get(_VALUE).encode('ascii'), 'value_span')
+    low, high = matches[0].span(2)
+    _, end, text_begin, empty = _spans(raw, root, _DISPLAY)[paragraph]
+    text_end = raw.rfind(b'</', text_begin, end)
+    _require(not empty and text_end >= text_begin and raw[text_begin:text_end] == paragraph.text.encode('ascii'), 'value_span')
+    value = replacement.encode('ascii')
+    changed = _patch(raw, [(begin + low, begin + high, value), (text_begin, text_end, value)])
+    cell.set(_VALUE, replacement)
+    paragraph.text = replacement
+    _require(ET.tostring(_xml(changed)) == ET.tostring(root), 'value_span')
+    return changed
+
+
+def _proof_rewrite(before, after, changes):
+    _require(list(before) == list(after) and all(
+        actual == changes.get(name, before[name]) for name, actual in after.items()), 'package_delta')
+
+
+def _binding(data, slide, selected, index):
+    return ChartBinding(sha256(data).hexdigest(), slide, selected.chart_part, selected.replacement_part,
+                        selected.frame.get(q(DR, 'name')), selected.series, selected.categories, selected.values, index)
+
+
+def prepare_odp_chart_edit(data, spec):
+    """Prepare one chart edit and an optional whole title in a single staged ODP."""
+    keys = {'slide', 'chart'}
+    _require(type(spec) is dict and set(spec) in (keys, keys | {'title'}), 'schema')
+    slide, chart = spec['slide'], spec['chart']
+    _require(type(chart) is dict and set(chart) == {'series', 'category', 'old_value', 'new_value'}, 'schema')
+    series = _request_text(chart['series'], limit=256)
+    category = _request_text(chart['category'], limit=256)
+    old, new = decimal(chart['old_value']), decimal(chart['new_value'])
+    previous_float, new_float = float(old), float(new)
+    _require(old != new and previous_float != new_float
+             and all(math.isfinite(value) and Decimal(str(value)) == number
+                     for value, number in ((previous_float, old), (new_float, new))), 'numeric_precision')
+    infos, original, selected = _source_chart(data, slide)
+    _require(series == selected.series and category in selected.categories, 'target')
+    index = selected.categories.index(category)
+    _require(decimal(selected.values[index]) == old, 'old_value')
+    changes = {selected.chart_part: _chart_bytes(original[selected.chart_part], selected.chart_root,
+                                                 selected.value_cells[index], chart['new_value'])}
+    if 'title' in spec:
+        title = spec['title']
+        fields = {'old_text', 'new_text'}
+        _require(type(title) is dict and set(title) in (fields, fields | {'layout'})
+                 and title['old_text'] != title['new_text'], 'title_schema')
+        _request_text(title['old_text'])
+        _request_text(title['new_text'], empty=True)
+        require_title_preimage(selected.slides[slide - 1], title['old_text'], ooxml=False)
+        titled = edit_text(data, 'odp', {**title, 'slide': slide, 'role': 'slide'})
+        _, title_parts, title_selection = _source_chart(titled, slide)
+        title_change = {'content.xml': title_parts['content.xml']}
+        _proof_rewrite(original, title_parts, title_change)
+        require_title_preimage(title_selection.slides[slide - 1], title['new_text'], ooxml=False)
+        changes.update(title_change)
+    staged = _rewrite(infos, original, changes)
+    _, final, post = _source_chart(staged, slide)
+    _proof_rewrite(original, final, changes)
+    values = selected.values[:index] + (chart['new_value'],) + selected.values[index + 1:]
+    _require(post.chart_part == selected.chart_part and post.replacement_part == selected.replacement_part
+             and ET.tostring(post.frame) == ET.tostring(selected.frame)
+             and post.series == series and post.categories == selected.categories and post.values == values, 'postimage')
+    return PreparedChartEdit(staged, _binding(staged, slide, post, index))
+
