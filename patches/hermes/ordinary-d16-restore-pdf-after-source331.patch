+    require(selection.phase != "pdf" or data.startswith(b"%PDF-"), "d16_followon_pdf_output_required")
+
+    def current():
+        cap.check()
+        return (time.monotonic() < min(bound.cutoff, ingress.claim.expires_monotonic)
+                and ingress._d16_followon_cutoff is bound and record.event_ref() is event
+                and _current_writer(selected, source, writer)
+                and getattr(source, "_friday_document_run", None) is run
+                and getattr(source, "_friday_document_turn", None) is turn
+                and getattr(source, "_friday_document_session_id", None) == session
+                and event._gateway_active_turn_token == turn[1]
+                and getattr(source, "_friday_user_scope", None) is cap)
+
+    pinned_source = selection.verify_files(cap.home, still_current=current)
+    identity, directories = workspace_pin(cap.home, relative, digest, len(data), still_current=current)
+    require(identity == output_identity, "d16_followon_output_snapshot_changed")
+    output = {"state": "DELIVERED", "kind": "document", "sha256": digest, "bytes": len(data),
+              "file_name": name, "bot_id": sdk["bot_id"], "chat_id": sdk["actor_id"],
+              "thread_id": None, "reply_to": sdk["native_message_id"]}
