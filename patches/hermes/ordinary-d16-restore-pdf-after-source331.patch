+    predecessor = FollowonSource(selection.phase, session, selection.previous_generation,
+                                 selection.previous_delivery_row, pinned_source["path"],
+                                 tuple(pinned_source["source_identity"]),
+                                 tuple(map(tuple, pinned_source["source_directories"])),
+                                 selection.previous_output_path, selection.previous_output_sha256)
+    verify_followon_output_before_delivery(ingress, run, sdk, predecessor, relative, output,
+                                           current=current, deadline=stop)
+
+
+
+    def transport_check():
+        remaining = stop - time.monotonic()
+        require(current() and remaining > 0, "d16_followon_original_delivery_deadline")
+        return remaining
+
+    attempt = DocumentAttempt(ingress, record, source, run, turn, session, relative, output, _scope(cap),
+                              record_slot="d16_followon_delivery", output_identity=identity,
+                              output_directories=directories, transport_check=transport_check)
+    record.d16_followon_delivery = attempt
+    return attempt
