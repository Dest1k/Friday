index 0000000000000000000000000000000000000000..429aa062ac8ffefe9d988f811eb2f9ab8feeaca1
--- /dev/null
+++ b/gateway/d16_followon_custody.py
@@ -0,0 +1,294 @@
+"""Project the exact native restore or PDF turn onto its authenticated predecessor."""
+
+from contextlib import closing
+from dataclasses import dataclass
+from hashlib import sha256
+import json
+from pathlib import Path, PurePosixPath
+import re
+import sqlite3
+import stat
+import time
+
+from .d16_seed_custody import OUTPUT_NAME as SEED_OUTPUT_NAME
+from .d16_seed_custody import SOURCE_BYTES, SOURCE_NAME, SOURCE_SHA256, _tool_path, _uid
+from .ordinary_d05_turn import _object, _relative_docx
+from .s08_document_custody import require
+from .s08_session_fence import _sqlite_identity
+
+
+OUTPUT_NAMES = {"restore": SOURCE_NAME, "pdf": "D16-Veresk-84-original.pdf"}
+TEXT_PAYLOAD_DOMAIN = b"friday.telegram.payload.v1\x00text\x00"
+_DELIVERY_FIELD = "friday_file_delivery_observation"
+_MESSAGE_FIELDS = (
+    "id,role,message_uid,platform_message_id,display_metadata,content,timestamp,tool_calls,"
+    "tool_call_uids,tool_call_uid,tool_call_id,tool_name,effect_disposition,display_kind,active,compacted"
+)
+_MAX_TURN_ROWS = 134
+_SHA256 = re.compile(r"[0-9a-f]{64}")
+_ORIGINAL_ARCHIVE = re.compile(r"received/telegram_[0-9a-f]{64}_" + re.escape(SOURCE_NAME))
+
+
+@dataclass(frozen=True, slots=True)
+class FollowonSource:
+    """Source and prior turn selected by the protected receiver before arming."""
+
+    phase: str
+    session_id: str
+    turn_generation: int
+    delivery_row_id: int
+    relative: str
+    identity: tuple[int, ...]
+    directories: tuple[tuple[int, int], ...]
+    previous_output_relative_path: str
+    previous_output_sha256: str
+
+
+def _file_identity(value, size):
+    return (type(value) is tuple and len(value) == 9
+            and all(type(item) is int and item >= 0 for item in value)
+            and value[1] > 0 and value[2] == size and stat.S_ISREG(value[5])
+            and value[5] & 0o077 == 0 and value[6] == 1)
+
+
+def _directories(value, count):
+    return (type(value) is tuple and len(value) == count
+            and all(type(item) is tuple and len(item) == 2
+                    and all(type(part) is int and part >= 0 for part in item)
+                    and item[1] > 0 for item in value))
+
+
+def _delivered_previous(db, sid, predecessor, user_id):
+    previous = db.execute(
+        "SELECT role,display_kind,content,display_metadata,active,compacted FROM messages "
+        "WHERE session_id=? AND id=?", (sid, predecessor.delivery_row_id),
+    ).fetchone()
+    require(previous is not None and previous["role"] == "assistant"
+            and previous["display_kind"] == "hidden" and previous["content"] == ""
+            and previous["active"] == 1 and previous["compacted"] == 0,
+            "d16_followon_predecessor_row_changed")
+    metadata = _object(previous["display_metadata"])
+    require(set(metadata) == {_DELIVERY_FIELD}, "d16_followon_predecessor_row_changed")
+    observed = metadata[_DELIVERY_FIELD]
+    require(type(observed) is dict and set(observed) == {"path", "sha256", "state"}
+            and (observed["path"], observed["sha256"], observed["state"])
+            == (predecessor.previous_output_relative_path, predecessor.previous_output_sha256, "DELIVERED"),
+            "d16_followon_predecessor_delivery_changed")
+    if predecessor.phase == "restore":
+        require(PurePosixPath(_relative_docx(observed["path"])).name == SEED_OUTPUT_NAME
+                and _SHA256.fullmatch(observed["sha256"]) and observed["sha256"] != SOURCE_SHA256,
+                "d16_followon_predecessor_seed_delivery_changed")
+    else:
+        require((observed["path"], observed["sha256"]) == (predecessor.relative, SOURCE_SHA256),
+                "d16_followon_predecessor_restore_delivery_changed")
+    require(db.execute(
+        "SELECT 1 FROM messages WHERE session_id=? AND id>? AND id<? AND role='user' LIMIT 1",
+        (sid, predecessor.delivery_row_id, user_id),
+    ).fetchone() is None, "d16_followon_intervening_user")
+
+
+def _output_path(value, workspace, expected):
+    require(type(value) is str and value in (expected, (workspace / expected).as_posix()),
+            "d16_followon_write_path_changed")
+    return expected
+
+
+def _tool_rows(rows, predecessor, workspace, output, receipt):
+    """Verify each canonical tool occurrence and join the native write result to delivery."""
+    cursor, total_lines = (1, 0), None
+    read_rows, write_row, occurrences = [], None, set()
+    for call_row, row in zip(rows[::2], rows[1::2], strict=True):
+        (call,) = json.loads(call_row["tool_calls"])
+        call_id, name = call["id"], call["function"]["name"]
+        occurrence = _object(call_row["tool_call_uids"])[call_id]
+        require(call_row["role"] == "assistant" and row["role"] == "tool"
+                and (name, call_id) == (row["tool_name"], row["tool_call_id"])
+                and _uid(occurrence) and occurrence == row["tool_call_uid"]
+                and occurrence not in occurrences and row["effect_disposition"] is None,
+                "d16_followon_exact_canonical_tool_pair")
+        occurrences.add(occurrence)
+        args = _object(call["function"]["arguments"])
+        result = _object(row["content"])
+        require(result["success"] is True and result["scope"] == "own_user_workspace",
+                "d16_followon_native_tool_failed")
+        if name == "read_file":
+            require(write_row is None and cursor is not None
+                    and {"path"} <= args.keys() <= {"path", "offset", "char_offset", "limit"}
+                    and _tool_path(args["path"], workspace) == result["path"] == predecessor.relative
+                    and (args.get("offset", 1), args.get("char_offset", 0)) == cursor
+                    and result["source_sha256"] == SOURCE_SHA256 and result["format"] == "docx"
+                    and result["extracted_document"] is True, "d16_followon_original_read_changed")
+            following = result["next_offset"], result["next_char_offset"]
+            total = result["total_lines"]
+            require(type(total) is int and 0 < total <= 100000 and total_lines in (None, total)
+                    and all(type(value) is int for value in following)
+                    and cursor < following <= (total + 1, 0) and 0 <= following[1] <= 1000000
+                    and result["partial"] is (following != (total + 1, 0)), "d16_followon_read_cursor")
+            cursor, total_lines = (following if result["partial"] else None), total
+            read_rows.append(row["id"])
+            continue
+
+        require(write_row is None and (cursor is None or not read_rows) and name == "write_file"
+                and set(args) == {"path", "format", "content"}
+                and _output_path(args["path"], workspace, output) == result["path"]
+                and result["source"] == predecessor.relative and result["source_sha256"] == SOURCE_SHA256
+                and result["sha256"] == receipt["sha256"] and type(result["bytes_written"]) is int
+                and result["bytes_written"] == receipt["bytes"]
+                and all(result[key] is True for key in ("verified", "create_only", "source_unchanged")),
+                "d16_followon_native_write_changed")
+        spec = _object(args["content"])
+        spec["source"] = _tool_path(spec.get("source"), workspace)
+        if predecessor.phase == "restore":
+            require(args["format"] == "docx_copy" and result["format"] == "docx"
+                    and result["copy_mode"] == "byte_exact" and result["byte_identical"] is True
+                    and receipt["sha256"] == SOURCE_SHA256 and receipt["bytes"] == SOURCE_BYTES
+                    and spec == {"source": predecessor.relative, "source_sha256": SOURCE_SHA256},
+                    "d16_followon_original_copy_changed")
+        else:
+            require(args["format"] == "docx_pdf" and result["format"] == "pdf"
+                    and result["export_mode"] == "docx_pdf"
+                    and receipt["sha256"] != SOURCE_SHA256 and spec == {"source": predecessor.relative},
+                    "d16_followon_original_pdf_changed")
+        write_row = row["id"]
+    require(write_row is not None, "d16_followon_native_write_missing")
+    return read_rows, write_row
+
+
+def _validate_user(user, sdk):
+    user_metadata = _object(user["display_metadata"]) if user["display_metadata"] else {}
+    text = user["content"]
+    require(user["role"] == "user" and user["platform_message_id"] == sdk["native_message_id"]
+            and user["timestamp"] == sdk["date"] and user["display_kind"] in (None, "")
+            and type(text) is str and 0 < len(text) <= 16384
+            and sha256(TEXT_PAYLOAD_DOMAIN + text.encode("utf-8")).hexdigest() == sdk["text_sha256"]
+            and not {"friday_direct_upload", "friday_attachment_presentations"} & user_metadata.keys(),
+            "d16_followon_native_text_row_changed")
+
+
+def verify_followon_output_before_delivery(ingress, run, sdk, predecessor, output, receipt, *, current, deadline):
+    """Confirm the native write for these bytes before reserving a delivery."""
+    runner = ingress.adapter.gateway_runner
+    home = Path(ingress.scope["runtime_home"])
+    key, generation = run
+    require(key == ingress.scope["session_key"] and type(generation) is int
+            and generation == predecessor.turn_generation + 1,
+            "d16_followon_preflight_session_changed")
+    path = home / "state.db"
+    deadline = min(deadline, time.monotonic() + 0.12)
+    require(current(), "d16_followon_preflight_not_current")
+    identity = _sqlite_identity(path)
+    with closing(sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=0)) as db:
+        db.set_progress_handler(lambda: int(time.monotonic() >= deadline), 100)
+        db.execute("PRAGMA query_only=ON")
+        db.execute("BEGIN")
+        require(db.execute("PRAGMA journal_mode").fetchone() == ("wal",),
+                "d16_followon_preflight_wal_required")
+        db.row_factory = sqlite3.Row
+        rows = db.execute(
+            f"SELECT {_MESSAGE_FIELDS} FROM messages WHERE session_id=? AND id>? ORDER BY id LIMIT ?",
+            (predecessor.session_id, predecessor.delivery_row_id, _MAX_TURN_ROWS),
+        ).fetchall()
+        users = [index for index, row in enumerate(rows) if row["role"] == "user"]
+        require(len(rows) < _MAX_TURN_ROWS and len(users) == 1,
+                "d16_followon_preflight_current_user_required")
+        user, *tail = rows[users[0]:]
+        require(all(row["active"] == 1 and row["compacted"] == 0 and _uid(row["message_uid"])
+                    for row in (user, *tail))
+                and len({row["message_uid"] for row in (user, *tail)}) == len(tail) + 1,
+                "d16_followon_preflight_turn_rows_changed")
+        _validate_user(user, sdk)
+        _delivered_previous(db, predecessor.session_id, predecessor, user["id"])
+        tool_rows = []
+        for row in tail:
+            if row["role"] == "tool" or row["tool_calls"] not in (None, "", "[]"):
+                tool_rows.append(row)
+            else:
+                metadata = _object(row["display_metadata"]) if row["display_metadata"] else {}
+                require(row["role"] == "assistant" and _DELIVERY_FIELD not in metadata,
+                        "d16_followon_preflight_existing_delivery")
+        _tool_rows(tool_rows, predecessor, PurePosixPath(home) / "workspace", output, receipt)
+    require(time.monotonic() < deadline and _sqlite_identity(path) == identity and current()
+            and runner._is_session_run_current(key, generation), "d16_followon_preflight_turn_changed")
+
+
+def project_followon_rows(attempt, sdk, predecessor, phase, db, fence, *, deadline):
+    """Join the exact USER row with the stock delivery journal and WAL row."""
+    receipt, journal, stamp, delivered_id, delivered_uid = attempt.candidate
+    sid, user_id = fence["session_id"], fence["user_row_id"]
+    key, generation = attempt.run
+    ingress = attempt.ingress
+    runner = ingress.adapter.gateway_runner
+    workspace = PurePosixPath(ingress.scope["runtime_home"]) / "workspace"
+    output = attempt.relative
+    require(type(predecessor) is FollowonSource and phase in OUTPUT_NAMES and predecessor.phase == phase
+            and key == ingress.scope["session_key"] and sid == attempt.session_id == predecessor.session_id
+            and type(predecessor.turn_generation) is int and predecessor.turn_generation > 0
+            and type(generation) is int and generation == predecessor.turn_generation + 1
+            and type(predecessor.delivery_row_id) is int and 0 < predecessor.delivery_row_id < user_id
+            and user_id < delivered_id <= fence["terminal_row_id"]
+            and time.monotonic() < deadline and runner._is_session_run_current(key, generation),
+            "d16_followon_current_session_chain_required")
+    require(_file_identity(predecessor.identity, SOURCE_BYTES)
+            and _directories(predecessor.directories, 2 if phase == "restore" else 1)
+            and (_ORIGINAL_ARCHIVE.fullmatch(predecessor.relative) if phase == "restore"
+                 else predecessor.relative == SOURCE_NAME),
+            "d16_followon_original_source_custody_required")
+    require(output == OUTPUT_NAMES[phase] and receipt == attempt.output | {"message_id": receipt["message_id"]}
+            and receipt["state"] == "DELIVERED" and receipt["kind"] == "document"
+            and receipt["file_name"] == output and receipt["reply_to"] == sdk["native_message_id"]
+            and receipt["bot_id"] == sdk["bot_id"] and receipt["chat_id"] == sdk["actor_id"]
+            and receipt["thread_id"] is None and receipt["message_id"] != sdk["native_message_id"]
+            and type(receipt["bytes"]) is int and 0 < receipt["bytes"] <= 1_000_000
+            and _SHA256.fullmatch(receipt["sha256"]) and _SHA256.fullmatch(journal)
+            and _file_identity(attempt.output_identity, receipt["bytes"])
+            and _directories(attempt.output_directories, 1)
+            and attempt.output_directories[0] == predecessor.directories[0]
+            and attempt.output_identity[:2] != predecessor.identity[:2],
+            "d16_followon_native_delivery_identity_changed")
+    _delivered_previous(db, sid, predecessor, user_id)
+
+    rows = db.execute(
+        f"SELECT {_MESSAGE_FIELDS} FROM messages WHERE session_id=? AND id BETWEEN ? AND ? ORDER BY id LIMIT ?",
+        (sid, user_id, fence["terminal_row_id"], _MAX_TURN_ROWS),
+    ).fetchall()
+    require(5 <= len(rows) < _MAX_TURN_ROWS and rows[0]["id"] == user_id and rows[-1]["id"] == fence["terminal_row_id"]
+            and all(row["active"] == 1 and row["compacted"] == 0 and _uid(row["message_uid"])
+                    for row in rows) and len({row["message_uid"] for row in rows}) == len(rows),
+            "d16_followon_native_transcript_bounds")
+    user, *tail = rows
+    _validate_user(user, sdk)
+
+    tool_rows, unknown_id, terminal_seen = [], None, False
+    for row in tail:
+        if row["role"] == "tool" or row["tool_calls"] not in (None, "", "[]"):
+            require(unknown_id is None and row["id"] < delivered_id, "d16_followon_late_tool_row")
+            tool_rows.append(row)
+            continue
+        require(row["role"] == "assistant", "d16_followon_unrelated_turn_row")
+        metadata = _object(row["display_metadata"]) if row["display_metadata"] else {}
+        if row["id"] != delivered_id and _DELIVERY_FIELD not in metadata:
+            continue
+        state = "DELIVERED" if row["id"] == delivered_id else "UNKNOWN"
+        require(row["display_kind"] == "hidden" and row["content"] == ""
+                and metadata == {_DELIVERY_FIELD: {"path": output, "sha256": receipt["sha256"], "state": state}},
+                "d16_followon_native_attachment_row_changed")
+        if state == "DELIVERED":
+            require(unknown_id is not None and row["message_uid"] == delivered_uid and row["timestamp"] == stamp,
+                    "d16_followon_native_attachment_journal_mismatch")
+            terminal_seen = True
+        else:
+            require(unknown_id is None and row["id"] < delivered_id, "d16_followon_other_attachment_attempt")
+            unknown_id = row["id"]
+    require(terminal_seen, "d16_followon_native_attachment_row_missing")
+    reads, write = _tool_rows(tool_rows, predecessor, workspace, output, receipt)
+    require(time.monotonic() < deadline and runner._is_session_run_current(key, generation),
+            "d16_followon_native_turn_changed")
+    return {
+        "session_id": sid, "turn_generation": generation, "user_row_id": user_id,
+        "read_row_ids": reads, "write_row_id": write,
+        "source": {"path": predecessor.relative, "sha256": SOURCE_SHA256, "size_bytes": SOURCE_BYTES},
+        "native_document": receipt, "output_relative_path": output,
+        "output_identity": list(attempt.output_identity),
+        "output_directories": [list(item) for item in attempt.output_directories],
+        "delivery_row_id": delivered_id, "native_journal_sha256": journal,
+    }
diff --git a/gateway/d16_followon_native.py b/gateway/d16_followon_native.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b92a70bdb76c529ea4ab0f4625efb990b8abe8e
--- /dev/null
+++ b/gateway/d16_followon_native.py
@@ -0,0 +1,334 @@
+"""Selected plain-text SDK and own-workspace witnesses for D16 follow-on settlement."""
+
+from dataclasses import dataclass
+from hashlib import sha256
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+from datetime import datetime
+import time
+
+from .d16_seed_custody import SOURCE_BYTES, SOURCE_NAME, SOURCE_SHA256
+from .run_inbound_media import _absolute_directory, _directory_identity, _file_identity, _owned, _verified_bytes
+from .s08_document_custody import require
+
+
+PHASES = {
+    "d10ba83aabaa03e621eba1d8fcc91d1f8274ff7934e1ad6ed8cb3efd4591dffa": "restore",
+    "4e0adec6e3b2763bd972c2c4e5c7eac0091ccd08b8825760a94f6922d87e0fa1": "pdf",
+}
+OUTPUT = {"restore": SOURCE_NAME, "pdf": "D16-Veresk-84-original.pdf"}
+PROOF_SCHEMA = "frw.Root.D16FollowOn.retained-predecessor.v1"
+TERMINAL_SCHEMA = "frw.gateway.d16-followon-native-settlement.v1"
+ROUTE_FIELDS = ("session_key", "source_profile", "transport_profile", "runtime_profile")
+_DISALLOWED = ("message_thread_id", "reply_to_message", "external_reply", "edit_date", "media_group_id",
+               "forward_origin", "sender_chat", "via_bot", "business_connection_id", "caption", "photo",
+               "document", "audio", "animation", "video", "voice", "video_note", "sticker", "location",
+               "contact", "poll", "dice", "venue", "game", "story", "paid_media", "invoice")
+_ORIGINAL = re.compile(r"received/telegram_[0-9a-f]{64}_" + re.escape(SOURCE_NAME))
+
+
+def text_sha256(text):
+    return sha256(b"friday.telegram.payload.v1\x00text\x00" + text.encode("utf-8")).hexdigest()
+
+
+def _positive(value):
+    return type(value) is int and 0 < value < 2**63
+
+
+def _plain(fields):
+    return (fields.get("is_topic_message") in (None, False)
+            and all(fields.get(name) is None for name in _DISALLOWED))
+
+
+def text_ack(run, ack, scenario):
+    if run["sent_api_ack_reference"]["representation"] == "botapi-wire-envelope-json":
+        ack = ack["result"]
+    step, = scenario["steps"]
+    require(set(step) == {"request", "observe"} and _plain(ack)
+            and ack["text"] == step["request"] and _positive(ack["date"]),
+            "d16_followon_exact_original_text_ack")
+    return {"date": ack["date"], "text_sha256": text_sha256(ack["text"])}
+
+
+@dataclass(frozen=True, slots=True)
+class SelectedText:
+    sdk: dict
+    observed_monotonic: float
+    raw: object
+    update: object
+
+    @classmethod
+    def capture(cls, ingress, update, event):
+        from telegram import Chat, Message, Update, User
+
+        bot = ingress.bot
+        actor = ingress.claim.user_id
+        selection = ingress.claim.selected_d16_followon
+        require(type(update) is Update and type(update.message) is Message
+                and update.get_bot() is bot and update.message is event.raw_message,
+                "d16_followon_original_sdk_update")
+        message = update.message
+        user, chat = message.from_user, message.chat
+        fields = {name: getattr(message, name, None) for name in _DISALLOWED}
+        fields.update(photo=message.photo or None, is_topic_message=message.is_topic_message)
+        require(type(user) is User and type(chat) is Chat
+                and all(value.get_bot() is bot for value in (message, user, chat))
+                and _positive(actor) and _positive(bot.id) and actor != bot.id
+                and bot is ingress.adapter._bot and bot.id == ingress.scope["bot_id"]
+                and user.id == chat.id == actor and user.is_bot is True and chat.type == "private"
+                and _positive(update.update_id) and _positive(message.message_id)
+                and type(event.platform_update_id) is int and type(event._ingress_update_id) is int
+                and event.platform_update_id == event._ingress_update_id == update.update_id
+                and event.message_type.value == "text" and event.message_id == str(message.message_id)
+                and event.reply_to_message_id is None and not event.internal and not event._ingress_merged
+                and _plain(fields) and type(message.text) is str and text_sha256(message.text) == selection.text_sha256
+                and type(message.date) is datetime and message.date.utcoffset() is not None
+                and message.date.microsecond == 0, "d16_followon_exact_sdk_text")
+        date = int(message.date.timestamp())
+        require(_positive(date), "d16_followon_sdk_date")
+        sdk = {"update_id": str(update.update_id), "native_message_id": str(message.message_id),
+               "bot_id": str(bot.id), "actor_id": str(actor), "date": date,
+               "text_sha256": selection.text_sha256}
+        return cls(sdk, time.monotonic(), message, update)
+
+    def is_original(self, ingress, event):
+        return (self.raw is event.raw_message and self.update is not None
+                and self.capture(ingress, self.update, event).sdk == self.sdk)
+
+
+def match_text(sdk, message, payload):
+    return (message["media"] == [] and tuple(message[key] for key in (
+                "platform_update_id", "message_id", "bot_id", "user_id", "chat_id", "thread_id",
+                "reply_to_message_id")) == (sdk["update_id"], sdk["native_message_id"], sdk["bot_id"],
+                                          sdk["actor_id"], sdk["actor_id"], "", "")
+            and payload == {"kind": "text", "date": sdk["date"], "sha256": sdk["text_sha256"]})
+
+
+def _identity(value, n):
+    return type(value) in (tuple, list) and len(value) == n and all(
+        type(part) is int and part >= 0 for part in value)
+
+
+def workspace_pin(home, relative, sha256_hex, size, *, still_current):
+    """Read only the selected archive or exact root output and pin its physical identity."""
+    path = PurePosixPath(relative)
+    require(str(path) == relative and (relative in OUTPUT.values() or _ORIGINAL.fullmatch(relative))
+            and _positive(size) and size <= 1000000
+            and type(sha256_hex) is str and re.fullmatch(r"[0-9a-f]{64}", sha256_hex)
+            and still_current(), "d16_followon_exact_workspace_target")
+    root = Path(home) / "workspace"
+    descriptor = _absolute_directory(root)
+    child = None
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    try:
+        directories = (_directory_identity(os.fstat(descriptor)),)
+        if len(path.parts) == 2:
+            child = os.open(path.parts[0], flags, dir_fd=descriptor)
+            _owned(os.fstat(child), directory=True)
+            directories += (_directory_identity(os.fstat(child)),)
+        file = _verified_bytes(descriptor, path.parts, {"size_bytes": size, "sha256": sha256_hex},
+                               capture_path=root / path)
+        named = _absolute_directory(root)
+        try:
+            require(_directory_identity(os.fstat(named)) == directories[0]
+                    and (child is None or _directory_identity(os.stat(
+                        path.parts[0], dir_fd=named, follow_symlinks=False)) == directories[1])
+                    and _file_identity(os.stat(path.name, dir_fd=child if child is not None else named,
+                                               follow_symlinks=False)) == file.source_identity
+                    and still_current(), "d16_followon_workspace_or_deadline_changed")
+        finally:
+            os.close(named)
+        return file.source_identity, directories
+    finally:
+        if child is not None:
+            os.close(child)
+        os.close(descriptor)
+
+
+def verify_workspace(home, pin, *, still_current):
+    identity, directories = workspace_pin(home, pin["path"], pin["sha256"], pin["size_bytes"],
+                                          still_current=still_current)
+    require(list(identity) == pin["source_identity"] and [list(item) for item in directories] == pin["source_directories"],
+            "d16_followon_workspace_identity_changed")
+    return identity, directories
+
+
+def pin_from_turn(turn):
+    delivery = turn["native_document"]
+    return {"path": turn["output_relative_path"], "sha256": delivery["sha256"], "size_bytes": delivery["bytes"],
+            "source_identity": turn["output_identity"], "source_directories": turn["output_directories"]}
+
+
+@dataclass(frozen=True, slots=True)
+class FollowonSelection:
+    run_id: str
+    scenario_sha256: str
+    text_sha256: str
+    proof_json: bytes
+    ref_json: bytes
+    previous_generation: int
+    previous_delivery_row: int
+    previous_output_path: str
+    previous_output_sha256: str
+
+    @property
+    def phase(self):
+        return PHASES[self.scenario_sha256]
+
+    def proof(self):
+        return json.loads(self.proof_json)
+
+    def reference(self):
+        return json.loads(self.ref_json)
+
+    def check_route(self, scope, *, actor):
+        conversation = self.proof()["conversation"]
+        require(conversation["route"] == {key: scope[key] for key in ROUTE_FIELDS}
+                and conversation["actor_id"] == str(actor) and conversation["bot_id"] == str(scope["bot_id"])
+                and conversation["thread_id"] is None, "d16_followon_previous_conversation_changed")
+
+    def verify_files(self, home, *, still_current):
+        proof = self.proof()
+        original = proof["original"]
+        verify_workspace(home, original, still_current=still_current)
+        restore = proof["restore"]
+        if restore is None:
+            return original
+        selected = pin_from_turn(restore)
+        verify_workspace(home, selected, still_current=still_current)
+        return selected
+
+
+def selected_delivery(adapter, source):
+    from .ordinary_dm_ingress import _ingress
+
+    ingress = _ingress(adapter)
+    mark = getattr(source, "_friday_d16_followon_ingress", None)
+    if mark is None:
+        if ingress is not None and source is ingress._receipt_source:
+            require(getattr(ingress.claim, "selected_d16_followon", None) is None,
+                    "d16_followon_delivery_ingress_stamp_missing")
+        return None
+    require(ingress is not None and type(mark) is tuple and len(mark) == 2 and mark[0] is ingress._seal,
+            "d16_followon_delivery_ingress_stamp_changed")
+    update = mark[1]
+    selection = getattr(ingress.claim, "selected_d16_followon", None)
+    record = ingress._built.get(update)
+    require(selection is not None and record is not None and record.d16_followon_native is not None
+            and source is ingress._receipt_source and update in ingress._commits,
+            "d16_followon_uncommitted_delivery_update")
+    return ingress, record, selection
+
+
+def _current_writer(selected, source, writer):
+    ingress, record, selection = selected
+    event = record.event_ref()
+    wire = ingress._wire()
+    update = int(record.d16_followon_native.sdk["update_id"])
+    return (writer is not None and not writer.cancelling()
+            and record.writer_task is not None and record.writer_task() is writer and not record.settled
+            and ingress.adapter._session_tasks.get(ingress.scope["session_key"]) is writer
+            and event is not None and event.source is source and event.platform_update_id == update
+            and source is ingress._receipt_source and ingress._built.get(update) is record
+            and update in ingress._commits and ingress.claim.selected_d16_followon is selection
+            and wire is not None and wire["state"] == "OPEN" and tuple(wire["target_update_ids"]) == (update,))
+
+
+async def wait_followon_cutoff(selected, source):
+    """Wait on the original sender proof while the exact writer remains admitted."""
+    import asyncio
+
+    ingress, record, _ = selected
+    writer = asyncio.current_task()
+    require(_current_writer(selected, source, writer), "d16_followon_original_writer_required")
+    if ingress._d16_followon_cutoff is None:
+        deadline = min(ingress.claim.expires_monotonic, record.d16_followon_native.observed_monotonic + 180)
+        async with asyncio.timeout_at(deadline):
+            await ingress._d16_followon_ready.wait()
+    require(ingress._d16_followon_cutoff is not None and _current_writer(selected, source, writer),
+            "d16_followon_original_cutoff_unavailable")
+
+
+def observe_followon_delivery(selected, source, cap, route, relative, name, data, output_identity):
+    """Bind the already authorized document attempt to the native journal callback."""
+    import asyncio
+
+    from .d16_followon_custody import FollowonSource, verify_followon_output_before_delivery
+    from .d16_seed_custody import DocumentAttempt
+    from .run_attachment_presentation import _scope
+
+    ingress, record, selection = selected
+    writer = asyncio.current_task()
+    if record.d16_followon_attempted:
+        record.d16_followon_delivery = None
+        raise ValueError("d16_followon_second_document_attempt")
+    record.d16_followon_attempted = True
+    bound = ingress._d16_followon_cutoff
+    event = record.event_ref()
+    candidate = record.d16_followon_native
+    run, turn = source._friday_document_run, source._friday_document_turn
+    sdk = candidate.sdk
+    session = source._friday_document_session_id
+    proof = selection.proof()
+    require(_current_writer(selected, source, writer) and candidate.is_original(ingress, event)
+            and bound is not None and bound.run_id == selection.run_id
+            and bound.ack_started <= candidate.observed_monotonic < bound.cutoff
+            and all(sdk[key] == value for key, value in bound.sender.items())
+            and run[0] == turn[0] == ingress.scope["session_key"]
+            and turn[1] and turn[1] == event._gateway_active_turn_token
+            and session == proof["conversation"]["session_id"]
+            and getattr(source, "_friday_user_scope", None) is cap
+            and (str(cap.home), str(cap.authorization_home), cap.profile) == (
+                ingress.scope["runtime_home"], ingress.scope["authorization_home"], ingress.scope["runtime_profile"])
+            and relative == name == OUTPUT[selection.phase] and 0 < len(data) <= 1000000
+            and route["bot_id"] == sdk["bot_id"] and route["runtime_profile"] == cap.profile
+            and route["transport_profile"] == ingress.scope["transport_profile"]
+            and tuple(route["source"][key] for key in
+                      ("platform", "chat_type", "user_id", "chat_id", "thread_id", "message_id")) ==
+                ("telegram", "dm", sdk["actor_id"], sdk["actor_id"], None, sdk["native_message_id"]),
+            "d16_followon_native_document_attempt_unproved")
+    digest = sha256(data).hexdigest()
+    require(selection.phase != "restore" or (digest, len(data)) == (SOURCE_SHA256, SOURCE_BYTES),
