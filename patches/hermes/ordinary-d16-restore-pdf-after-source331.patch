+def _previous(control, prior, authority, route, schema, phase_sha):
+    require(prior["run_id"] in authority["history"]
+            and authority["history"][prior["run_id"]]["sha256"] == prior["run_sha256"]
+            and authority["history"][prior["run_id"]]["status"] == "EVIDENCE_READY",
+            "d16_followon_previous_run_not_in_retained_history")
+    terminal, terminal_path = control.doc(prior["terminal"], name="receiver-terminal-native.json")
+    intent, intent_path = control.doc(terminal["intent"], name="receiver-terminal-intent.json")
+    request, request_path = control.doc(prior["finalize_request"], name="receiver-control-finalize.json")
+    reply, reply_path = control.doc(prior["finalize_reply"], name="receiver-finalize-reply.json")
+    request_schema = ("frw.gateway.d16-seed-owned-receiver-control.v1" if schema == SEED_TERMINAL
+                      else "frw.gateway.d16-followon-owned-receiver-control.v1")
+    require(terminal["schema"] == schema and terminal["run_id"] == prior["run_id"]
+            and terminal["scenario_sha256"] == phase_sha and terminal["route"] == route
+            and terminal["no_retry"] is True
+            and terminal_path.parent == intent_path.parent == request_path.parent == reply_path.parent
+            and intent["run_id"] == prior["run_id"] and intent["scenario_sha256"] == phase_sha
+            and intent["run"]["sha256"] == prior["run_sha256"] and intent["no_retry"] is True
+            and request["schema"] == request_schema and request["operator"] == "Root"
+            and request["action"] == "finalize" and request["proof"] == terminal["intent"]
+            and _now(request["created_monotonic"]) and _now(request["expires_monotonic"])
+            and request["created_monotonic"] < request["expires_monotonic"]
+            and reply == {"accepted": True, "query_id": request["query_id"], "action": "finalize",
+                          "state": "RECEIVER_CLOSED_RETAINED", "receipt": prior["terminal"]},
+            "d16_followon_previous_terminal_or_retirement_changed")
+    return terminal
+
+
+def _selection(control, intent, driver, scenario):
+    authority, _ = control.doc(driver["authority"], limit=_RUN_JSON_LIMIT)
+    reference = driver["d16_followon_predecessor"]
+    require(reference == authority["d16_followon_predecessor"], "d16_followon_protected_predecessor_required")
+    proof, _ = control.doc(reference, name="d16-followon-predecessor.json")
+    phase_sha = intent["scenario_sha256"]
+    phase = PHASES[phase_sha]
+    require(set(proof) == {"schema", "phase", "scenario_sha256", "conversation", "original", "seed", "restore", "no_retry"}
+            and proof["schema"] == PROOF_SCHEMA and proof["phase"] == phase and proof["scenario_sha256"] == phase_sha
+            and proof["no_retry"] is True, "d16_followon_wrong_predecessor_phase")
+    conversation, original, seed, restore = (proof[key] for key in ("conversation", "original", "seed", "restore"))
+    route = conversation["route"]
+    require(set(conversation) == {"route", "session_id", "actor_id", "bot_id", "thread_id"}
+            and conversation["bot_id"] == str(scenario["peer_id"]) and conversation["actor_id"] == str(scenario["tester_id"])
+            and conversation["thread_id"] is None
+            and set(original) == {"path", "sha256", "size_bytes", "source_identity", "source_directories"}
+            and original["sha256"] == SOURCE_SHA256 and original["size_bytes"] == SOURCE_BYTES
+            and _ORIGINAL.fullmatch(original["path"]) and _identity(original["source_identity"], 9)
+            and len(original["source_directories"]) == 2
+            and all(_identity(tuple(item), 2) for item in original["source_directories"]),
+            "d16_followon_original_archive_or_conversation_invalid")
+    previous_fields = {"run_id", "run_sha256", "terminal", "finalize_request", "finalize_reply"}
+    require(set(seed) == previous_fields and seed["run_id"] != intent["run_id"],
+            "d16_followon_exact_original_seed")
+    base = _previous(control, seed, authority, route, SEED_TERMINAL, SEED_SHA)
+    turn = base["d16_turn"]
+    require(turn["session_id"] == conversation["session_id"]
+            and base["d16_sdk"]["actor_id"] == conversation["actor_id"] and base["d16_sdk"]["bot_id"] == conversation["bot_id"]
+            and turn["source"]["file_name"] == SOURCE_NAME
+            and {key: turn["source"][key] for key in ("path", "sha256", "size_bytes")}
+                == {key: original[key] for key in ("path", "sha256", "size_bytes")}
+            and base["d16_source_identity"] == original["source_identity"]
+            and base["d16_source_directories"] == original["source_directories"],
+            "d16_followon_exact_original_archive_terminal_required")
+    if phase == "restore":
+        require(restore is None, "d16_followon_restore_requires_immediate_seed")
+    else:
+        require(type(restore) is dict and set(restore) == previous_fields | {"native_document",
+                    "output_relative_path", "output_identity", "output_directories", "turn_generation", "delivery_row_id"}
+                and restore["run_id"] not in (intent["run_id"], seed["run_id"]), "d16_followon_pdf_requires_restore")
+        restore_sha = next(s for s, name in PHASES.items() if name == "restore")
+        prior = _previous(control, restore, authority, route, TERMINAL_SCHEMA, restore_sha)["d16_followon"]
+        require(prior["phase"] == "restore" and prior["original"] == original
+                and prior["turn"]["session_id"] == conversation["session_id"]
+                and prior["sdk"]["actor_id"] == conversation["actor_id"] and prior["sdk"]["bot_id"] == conversation["bot_id"]
+                and all(prior["turn"][key] == value for key, value in restore.items()
+                        if key not in previous_fields), "d16_followon_foreign_restore_result")
+        seed_proof, _ = control.doc(prior["predecessor"], name="d16-followon-predecessor.json")
+        require(seed_proof == dict(proof, phase="restore", scenario_sha256=restore_sha, restore=None),
+                "d16_followon_restore_must_descend_from_exact_seed")
+        restored = pin_from_turn(restore)
+        require(restored["path"] == SOURCE_NAME and restored["sha256"] == SOURCE_SHA256
+                and restored["size_bytes"] == SOURCE_BYTES and _identity(restored["source_identity"], 9)
+                and restored["source_identity"] != original["source_identity"]
+                and restored["source_directories"] == original["source_directories"][:1]
+                and restore["native_document"]["state"] == "DELIVERED"
+                and restore["turn_generation"] == turn["turn_generation"] + 1
+                and restore["delivery_row_id"] > turn["delivery_row_id"],
+                "d16_followon_exact_restored_original_required")
+        turn = prior["turn"]
+    require(_positive(turn["turn_generation"]) and _positive(turn["delivery_row_id"]),
+            "d16_followon_native_predecessor_order_unproved")
+    return FollowonSelection(intent["run_id"], phase_sha, text_sha256(scenario["steps"][0]["request"]),
+                             _encode(proof), _encode(reference), turn["turn_generation"], turn["delivery_row_id"],
+                             turn["output_relative_path"], turn["native_document"]["sha256"])
+
+
+def _original_cutoff(cutoff, verified, scenario):
+    run = verified["run"]
+    sent = text_ack(run, verified["ack"], scenario)
+    before, after = verified["ack_monotonic"]
+    require(cutoff == after + 180, "d16_followon_original_cutoff_changed")
+    proof = {"ack": run["sent_api_ack_reference"], "window": run["sent_window_reference"],
+             "clock": verified["original_clock"], "wall_cutoff": run["capture_until"],
+             "task": run["sent_task_reference"]}
+    return BoundCutoff(run["id"], cutoff, run["sent_message_id"], sent, before, sha256(_encode(proof)).hexdigest())
+
+
+class D16FollowonReceiverControl(ReceiverControl):
