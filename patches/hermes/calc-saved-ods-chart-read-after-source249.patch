+def _calc_notify_ranges(value):
+    if not value:
+        fail('chart_or_external_link_structure')
+    # A pair of doubled quotes toggles twice without splitting the name.
+    quoted = False
+    start = 0
+    ranges = []
+    for index, char in enumerate(value):
+        if char == "'":
+            quoted = not quoted
+        elif char == ' ' and not quoted:
+            ranges.append(_odf_range(value[start:index]))
+            start = index + 1
+    if quoted:
+        fail('chart_or_external_link_structure')
+    return ranges + [_odf_range(value[start:])]
