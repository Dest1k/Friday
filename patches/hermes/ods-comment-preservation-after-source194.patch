+def _tag_end(raw, start):
+    # A literal '>' inside a quoted attribute is not the end of its tag.
+    quote = None
+    for offset in range(start, len(raw)):
+        char = raw[offset]
+        if quote is not None:
+            if char == quote: quote = None
+        elif char in (34, 39): quote = char
+        elif char == 62: return offset + 1
+    fail('cell_span_invalid')
+
+
+def _edited_cell_content(raw, display):
+    """Keep comments at unambiguous cell/paragraph boundaries, byte for byte.
+
+    The caller has already checked expanded names and plain paragraph content.
+    Namespace processing is deliberately off for this inherited-prefix fragment.
+    Comments between old text runs or among multiple paragraphs have no unique
+    position in a replacement scalar; refuse those rather than relocate them.
+    """
+    parser = expat.ParserCreate()
+    depth = 0; paragraphs = []; events = []; comments = 0
+    body_begin = body_end = None; outside_text = False
+    def begin(name, attrs):
+        nonlocal depth, body_begin
+        depth += 1
+        offset = parser.CurrentByteIndex
+        if depth == 1: body_begin = _tag_end(raw, offset)
+        elif depth == 2: paragraphs.append([offset, _tag_end(raw, offset), None])
+        else: fail('unsupported_target_content')
+    def end(name):
+        nonlocal depth, body_end
+        offset = parser.CurrentByteIndex
+        if depth == 2:
+            start, opening, _ = paragraphs[-1]
+            paragraphs[-1][2] = opening if raw[start:opening].rstrip().endswith(b'/>') else _tag_end(raw, offset)
+        elif depth == 1: body_end = offset
+        depth -= 1
+    def text(value):
+        nonlocal outside_text
+        if depth == 2 and value: events.append(('text', value))
+        elif depth == 1 and value.strip(): outside_text = True
+    def comment(value):
+        nonlocal comments
+        comments += 1
+        offset = parser.CurrentByteIndex
+        finish = raw.find(b'-->', offset) + 3
+        if finish < offset + 7: fail('cell_span_invalid')
+        if depth == 2: events.append(('comment', raw[offset:finish]))
+        elif depth != 1: fail('unsupported_target_content')
+    def refuse(*args): fail('active_xml')
+    parser.StartElementHandler = begin; parser.EndElementHandler = end
+    parser.CharacterDataHandler = text; parser.CommentHandler = comment
+    parser.StartDoctypeDeclHandler = refuse; parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    try: parser.Parse(raw, True)
+    except expat.ExpatError: fail('invalid_xml')
+    literal = _literal(display).encode()
+    if not comments: return b'<text:p>' + literal + b'</text:p>'
+    if len(paragraphs) != 1 or outside_text: fail('unsupported_target_content')
+    texts = [i for i, (kind, _) in enumerate(events) if kind == 'text']
+    if events and not texts: fail('unsupported_target_content')
+    first = texts[0] if texts else len(events)
+    last = texts[-1] if texts else len(events)
+    if any(kind == 'comment' and first < i < last for i, (kind, _) in enumerate(events)):
+        fail('unsupported_target_content')
+    before = b''.join(value for kind, value in events[:first] if kind == 'comment')
+    after = b''.join(value for kind, value in events[last + 1:] if kind == 'comment')
+    start, opening, finish = paragraphs[0]
+    return (raw[body_begin:start] + b'<text:p>' + before + literal + after + b'</text:p>'
+            + raw[finish:body_end])
+
