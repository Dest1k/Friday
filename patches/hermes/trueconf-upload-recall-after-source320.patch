+def _trueconf_matching_files(cap, names):
+    from itertools import islice
+    from hermes_cli.friday_user_scope import ScopeDenied, workspace_document
+
+    verified = {}
+    # Recheck the bytes before presenting a retained proof as current. Limit
+    # filesystem work to the same number of files the sidecar can publish.
+    for key, name in islice(names.items(), 32):
+        path, sha256, size = key
+        try:
+            data, relative = workspace_document(str(cap.home / "workspace" / path), max_bytes=size)
+        except ScopeDenied:
+            continue
+        if relative == path and len(data) == size and hashlib.sha256(data).hexdigest() == sha256:
+            verified[key] = name
+    return verified
 
 
