+"""Read-only, bounded ODF text revisions and annotations.
+
+ODF 1.3 part 3 sections 5.5 and 14.1-14.4 define the stored layers. Only
+non-overlapping, single-paragraph literal insertions/deletions are projected.
+A projection is a view, never acceptance/rejection or an edit of source bytes.
+"""
+from __future__ import annotations
+
+from tools.scoped_presentation import q
+
+O = 'urn:oasis:names:tc:opendocument:xmlns:office:1.0'
+T = 'urn:oasis:names:tc:opendocument:xmlns:text:1.0'
+TB = 'urn:oasis:names:tc:opendocument:xmlns:table:1.0'
+DC = 'http://purl.org/dc/elements/1.1/'
+META = 'urn:oasis:names:tc:opendocument:xmlns:meta:1.0'
+XML = 'http://www.w3.org/XML/1998/namespace'
+MAX_ITEMS = 4096
+MAX_CHARS = 100_000
+MARKS = {q(T, name) for name in ('change', 'change-start', 'change-end')}
+REVIEW = MARKS | {q(T, 'tracked-changes'), q(T, 'changed-region'),
+                 q(O, 'annotation'), q(O, 'annotation-end')}
+INLINE = {q(T, name) for name in ('span', 'a')}
+EMPTY = {q(T, name) for name in ('bookmark', 'bookmark-start', 'bookmark-end',
+    'reference-mark', 'reference-mark-start', 'reference-mark-end', 'soft-page-break')}
+PARAS = {q(T, 'p'), q(T, 'h')}
+FLOW = {q(O, 'text')} | {q(T, name) for name in ('section', 'list', 'list-item', 'list-header')} | {
+    q(TB, name) for name in ('table', 'table-row', 'table-cell', 'table-header-rows',
+                            'table-rows', 'table-row-group')}
+
+
+def present(package, checkpoint=None):
+    for root in package.xml.values():
+        for index, node in enumerate(root.iter()):
+            if index % 64 == 0 and checkpoint is not None:
+                checkpoint()
+            if node.tag in REVIEW:
+                return True
+    return False
+
+
+def extract_layers(package, checkpoint=None):
+    from tools.scoped_odt import ODTError, _count
+
+    def fail(code):
+        raise ODTError(code)
+
+    def tick():
+        if checkpoint is not None:
+            checkpoint()
+
+    def bounded(value):
+        if len(value) > MAX_CHARS:
+            fail('review_text_limit')
+        return value
+
+    def identifier(value):
+        if not value or len(value) > 256 or any(c.isspace() or ord(c) < 32 for c in value):
+            fail('invalid_review_id')
+        return value
+
+    def local(tag):
+        return tag.rsplit('}', 1)[-1]
+
+    parents, paths = {}, {package.body: '/office:text'}
+    for root in package.xml.values():
+        for i, parent in enumerate(root.iter()):
+            if i % 64 == 0:
+                tick()
+            counts = {}
+            for node in parent:
+                parents[node] = parent
+                counts[node.tag] = counts.get(node.tag, 0) + 1
+                if parent in paths:
+                    prefix = 'text' if node.tag.startswith('{' + T + '}') else 'office' if node.tag.startswith('{' + O + '}') else 'table' if node.tag.startswith('{' + TB + '}') else 'other'
+                    paths[node] = paths[parent] + '/' + prefix + ':' + local(node.tag) + '[' + str(counts[node.tag]) + ']'
+    gaps, main_gaps = set(), set()
+
+    def gap(code, main=True):
+        gaps.add(code)
+        if main:
+            main_gaps.add(code)
+
+    def ancestors(node):
+        parent = parents.get(node)
+        while parent is not None:
+            yield parent
+            parent = parents.get(parent)
+
+    def location(node):
+        return {'path': paths.get(node), 'body_paragraph': pnum.get(node)}
+
+    def literal(node):
+        """Literal inline text only; report unprojected fields/objects, no execution."""
+        parts = []
+        size = 0
+        complete = True
+        def add(value):
+            nonlocal size
+            if value:
+                size += len(value)
+                if size > MAX_CHARS:
+                    fail('review_text_limit')
+                parts.append(value)
+        def walk(item, top=False):
+            nonlocal complete
+            tick()
+            if item.tag == q(T, 's'):
+                if len(item) or (item.text or '').strip():
+                    complete = False
+                add(' ' * _count(item.get(q(T, 'c'), '1'), MAX_CHARS))
+            elif item.tag in (q(T, 'tab'), q(T, 'line-break')):
+                if len(item) or (item.text or '').strip():
+                    complete = False
+                add('\t' if item.tag == q(T, 'tab') else '\n')
+            elif item.tag in EMPTY:
+                if len(item) or (item.text or '').strip():
+                    complete = False
+            elif top or item.tag in INLINE:
+                add(item.text)
+                for child in item:
+                    walk(child)
+                    add(child.tail)
+            else:
+                complete = False
+        walk(node, True)
+        return ''.join(parts), complete
+
