+        size += count
+        if size > MAX_JSON:
+            return 1
+        chunks.append(C.string_at(data, count))
+        return 0
+    writer = callback(receive)
+    if _checked(lib, handle, 'qpdf_write_json', 2, writer, None, 0, 0, b'', None):
+        raise PDFAnnotationError('pdf_malformed_or_unsupported')
+    graph = json.loads(b''.join(chunks))['qpdf'][1]
+    if len(graph) > 4096:
+        raise PDFAnnotationError('pdf_profile_unsupported')
+    forbidden = {'/A', '/AA', '/OpenAction', '/JS', '/JavaScript', '/XFA', '/Names',
+        '/EmbeddedFiles', '/EF', '/AF', '/Collection', '/Perms', '/ByteRange', '/Encrypt',
+        '/RichMediaContent', '/RichMediaSettings', '/PieceInfo', '/PresSteps', '/OPI',
+        '/Ref', '/Alternates', '/OC', '/OCProperties', '/StructTreeRoot', '/SigFlags'}
+    def token(value):
+        seen = set()
+        while _ref(value):
+            if value in seen or len(seen) >= 32:
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            seen.add(value)
+            value = _resolve(graph, value)
+        return value
+    def validate(node, depth=0):
+        if depth > 64:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        if type(node) is dict:
+            if (set(node) & forbidden or token(node.get('/Type')) in ('/Filespec', '/EmbeddedFile', '/Action', '/Sig', '/OCG', '/OCMD')
+                    or token(node.get('/Subtype')) in ('/PS', '/FileAttachment', '/RichMedia', '/Movie', '/Sound', '/Screen', '/3D')
+                    or token(node.get('/FT')) == '/Sig' or '/S' in node and token(node.get('/Type')) == '/Action'):
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            # Catch action dictionaries even without /Type; /S is legitimate in some unrelated objects.
+            if token(node.get('/S')) in ('/JavaScript', '/Launch', '/URI', '/GoTo', '/GoToR', '/GoToE', '/SubmitForm', '/ResetForm', '/ImportData', '/Rendition', '/RichMediaExecute', '/SetOCGState', '/Sound', '/Movie', '/Named', '/Hide', '/SetState', '/Thread'):
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            for val in node.values():
+                validate(val, depth + 1)
+        elif type(node) is list:
+            for val in node:
+                validate(val, depth + 1)
+    validate(graph)
+    total = 0
+    for key, node in graph.items():
+        if 'stream' not in node:
+            continue
+        stream = node['stream']
+        if set(stream['dict']) & {'/F', '/FFilter', '/FDecodeParms'}:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        object_id, generation, _ = key.removeprefix('obj:').split()
+        oh = _checked(lib, handle, 'qpdf_get_object_by_id', int(object_id), int(generation))
+        buf, length, filtered = C.c_void_p(), C.c_size_t(), C.c_int()
+        try:
+            if _checked(lib, handle, 'qpdf_oh_get_stream_data', oh, 0, C.byref(filtered), C.byref(buf), C.byref(length)):
+                raise PDFAnnotationError('pdf_malformed_or_unsupported')
+            total += length.value
+            if total > 4 * MAX_BYTES:
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            stream['raw_sha256'] = hashlib.sha256(C.string_at(buf, length.value)).hexdigest()
+            stream['dict'].pop('/Length', None)
+        finally:
+            lib.qpdf_oh_free_buffer(C.byref(buf))
+    return graph
+
+
+def _ref(value):
+    import re
+    return type(value) is str and re.fullmatch(r'[1-9][0-9]* [0-9]+ R', value) is not None
+
+
+def _resolve(graph, value, *, stream=False):
+    if _ref(value):
+        node = graph.get('obj:' + value)
+        if type(node) is not dict or ('stream' if stream else 'value') not in node:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        return node['stream' if stream else 'value']
+    if stream:
+        raise PDFAnnotationError('pdf_profile_unsupported')
+    return value
+
+
+ICON_SIZE = 18
+ICON_STREAM = (b'q\n1 .86 .2 rg\n.5 .5 17 17 re f\n0 0 0 RG\n.7 w\n'
+               b'.5 .5 17 17 re S\n3 13 m 15 13 l S\n3 9 m 15 9 l S\n'
+               b'3 5 m 11 5 l S\nQ\n')
+ICON_DICTIONARY = {'/Type': '/XObject', '/Subtype': '/Form', '/FormType': 1,
+                   '/BBox': [0, 0, ICON_SIZE, ICON_SIZE], '/Resources': {}}
+
+
+def _text(value):
+    import unicodedata
+    if (type(value) is not str or not 1 <= len(value) <= MAX_TEXT
+            or any(unicodedata.category(c) in ('Cc', 'Cs') and c != '\n' for c in value)):
+        return False
+    try:
+        return len(value.encode('utf-8')) <= 8192
+    except UnicodeError:
+        return False
+
+
+def request(content):
+    import math, re
+    def pairs(rows):
+        result = {}
+        for key, value in rows:
+            if key in result:
+                raise ValueError()
+            result[key] = value
+        return result
+    try:
+        if type(content) is not str or len(content.encode('utf-8')) > 64_000:
+            raise ValueError()
+        spec = json.loads(content, object_pairs_hook=pairs)
+        if (type(spec) is not dict or set(spec) != {'source', 'source_sha256', 'annotations'}
+                or type(spec['source']) is not str or not 1 <= len(spec['source'].encode('utf-8')) <= 512
+                or type(spec['source_sha256']) is not str
+                or not re.fullmatch('[0-9a-f]{64}', spec['source_sha256'])
+                or type(spec['annotations']) is not list
+                or not 1 <= len(spec['annotations']) <= MAX_ANNOTATIONS):
+            raise ValueError()
+        for row in spec['annotations']:
+            if (type(row) is not dict or set(row) != {'page', 'x', 'y', 'text'}
+                    or type(row['page']) is not int or not 1 <= row['page'] <= MAX_PAGES
+                    or any(type(row[k]) not in (int, float) or not math.isfinite(row[k])
+                           or abs(row[k]) > 20_000 for k in ('x', 'y'))
+                    or not _text(row['text'])):
+                raise ValueError()
+        return spec
+    except (ValueError, UnicodeError, RecursionError, OverflowError):
+        raise PDFAnnotationError('pdf_request_invalid') from None
+
+
+def process(cap, data, annotations):
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _private_read, LocalOCRFailure
+    if type(data) is not bytes or not 0 < len(data) <= MAX_BYTES:
+        raise PDFAnnotationError('pdf_input_limit')
+    spec = request(json.dumps(dict(source='input.pdf', source_sha256=hashlib.sha256(data).hexdigest(),
+                                   annotations=annotations)))
+    try:
+        library = Path(LIBRARY).resolve(strict=True)
+        info = library.stat()
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+            raise PDFAnnotationError('pdf_engine_unavailable')
+    except OSError:
+        raise PDFAnnotationError('pdf_engine_unavailable') from None
+    check(cap)
+    work = Path(tempfile.mkdtemp(prefix='friday-pdf-comments-'))
+    try:
+        work.chmod(0o700)
+        for name, value in {'runner.py': Path(__file__).read_bytes(), 'input0.pdf': data,
+                'request.json': json.dumps(spec, separators=(',', ':')).encode()}.items():
+            (work / name).write_bytes(value)
+            (work / name).chmod(0o600)
+        _run(cap, work, 1)
+        result = json.loads(_private_read(work / 'result.json', 64_000))
+        if type(result) is dict and set(result) == {'error'}:
+            allowed = {'pdf_malformed_or_unsupported', 'pdf_profile_unsupported', 'pdf_page_limit',
+                       'pdf_page_out_of_range', 'pdf_coordinates_out_of_bounds', 'pdf_output_limit',
+                       'pdf_engine_unavailable', 'pdf_verification_failed', 'pdf_request_invalid'}
+            raise PDFAnnotationError(result['error'] if result['error'] in allowed else 'pdf_engine_failed')
+        if (type(result) is not dict or set(result) != {'annotations', 'pages', 'engine', 'profile', 'appearance'}
+                or result['annotations'] != annotations or result['engine'] != 'libqpdf-12.3.2'
+                or result['profile'] != 'native_Text_comments_Unicode'
+                or result['appearance'] != 'vector_icon_generated_and_reparsed'
+                or type(result['pages']) is not int or not 1 <= result['pages'] <= MAX_PAGES):
+            raise PDFAnnotationError('pdf_verification_failed')
+        output = _private_read(work / 'output.pdf', MAX_BYTES)
+        if not output.startswith(b'%PDF-') or not output.rstrip().endswith(b'%%EOF'):
+            raise PDFAnnotationError('pdf_verification_failed')
+        check(cap)
+        return output, result
+    except (OSError, LocalOCRFailure, json.JSONDecodeError):
+        raise PDFAnnotationError('pdf_engine_failed') from None
+    finally:
+        try:
+            shutil.rmtree(work)
+        except OSError:
+            from agent.web_call_context import _current
+            call = _current.get()
+            if call is not None and hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFAnnotationError('pdf_cleanup_unconfirmed') from None
+
+
+def _check_annotation(graph, reference, page_ref):
+    """Validate the common annotation structure before preserving it verbatim."""
+    import math
+    annotation = _resolve(graph, reference)
+    if (type(annotation) is not dict or annotation.get('/Type', '/Annot') != '/Annot'
+            or annotation.get('/P', page_ref) != page_ref):
+        raise PDFAnnotationError('pdf_profile_unsupported')
+    def numbers(value, count):
+        return (type(value) is list and len(value) == count
+                and all(type(x) in (int, float) and math.isfinite(x) and abs(x) <= 20_000 for x in value))
+    rectangle = _resolve(graph, annotation.get('/Rect'))
+    if not numbers(rectangle, 4) or rectangle[0] >= rectangle[2] or rectangle[1] >= rectangle[3]:
+        raise PDFAnnotationError('pdf_profile_unsupported')
+    for key in ('/Contents', '/T', '/Subj', '/NM', '/M'):
+        if key in annotation:
+            text = _resolve(graph, annotation[key])
+            if type(text) is not str or not text.startswith(('u:', 'b:')):
+                raise PDFAnnotationError('pdf_profile_unsupported')
+    if '/F' in annotation:
+        flags = _resolve(graph, annotation['/F'])
+        if type(flags) is not int or not 0 <= flags <= 1023:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+    if '/AP' in annotation:
+        appearance = _resolve(graph, annotation['/AP'])
+        if type(appearance) is not dict or '/N' not in appearance or set(appearance) - {'/N', '/R', '/D'}:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        for entry in appearance.values():
+            node = graph.get('obj:' + entry) if _ref(entry) else None
+            variants = [entry] if type(node) is dict and 'stream' in node else _resolve(graph, entry)
+            if type(variants) is dict:
+                if not variants or any(type(k) is not str or not k.startswith('/') for k in variants):
+                    raise PDFAnnotationError('pdf_profile_unsupported')
+                variants = list(variants.values())
+            if type(variants) is not list:
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            for stream_ref in variants:
+                stream = _resolve(graph, stream_ref, stream=True)
+                dictionary = stream['dict']
+                if (dictionary.get('/Type', '/XObject') != '/XObject' or dictionary.get('/Subtype') != '/Form'
+                        or not numbers(_resolve(graph, dictionary.get('/BBox')), 4)):
+                    raise PDFAnnotationError('pdf_profile_unsupported')
+                box = _resolve(graph, dictionary['/BBox'])
+                if box[0] >= box[2] or box[1] >= box[3]:
+                    raise PDFAnnotationError('pdf_profile_unsupported')
+                if '/Matrix' in dictionary and not numbers(_resolve(graph, dictionary['/Matrix']), 6):
+                    raise PDFAnnotationError('pdf_profile_unsupported')
+                if '/Resources' in dictionary and type(_resolve(graph, dictionary['/Resources'])) is not dict:
+                    raise PDFAnnotationError('pdf_profile_unsupported')
+    return annotation
+
+
+def _profile(lib, C, callback, handle):
+    import math
+    if _checked(lib, handle, 'qpdf_is_encrypted') or _checked(lib, handle, 'qpdf_check_pdf'):
+        raise PDFAnnotationError('pdf_profile_unsupported')
+    count = _checked(lib, handle, 'qpdf_get_num_pages')
+    if not 1 <= count <= MAX_PAGES:
+        raise PDFAnnotationError('pdf_page_limit')
+    graph = _objects(lib, C, callback, handle)
+    rows = []
+    seen_annots = set()
+    for number in range(count):
+        page = _checked(lib, handle, 'qpdf_get_page_n', number)
+        ref = f"{_checked(lib, handle, 'qpdf_oh_get_object_id', page)} {_checked(lib, handle, 'qpdf_oh_get_generation', page)} R"
+        value = _resolve(graph, ref)
+        inherited, ancestors, current = {}, set(), value
+        for _ in range(32):
+            if type(current) is not dict:
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            for key in ('/MediaBox', '/CropBox', '/Rotate'):
+                if key not in inherited and key in current:
+                    inherited[key] = _resolve(graph, current[key])
+            parent = current.get('/Parent')
+            if parent is None:
+                break
+            if not _ref(parent) or parent in ancestors:
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            ancestors.add(parent)
+            current = _resolve(graph, parent)
+        else:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        media = inherited.get('/MediaBox')
+        crop = inherited.get('/CropBox', media)
+        for box in (media, crop):
+            if (type(box) is not list or len(box) != 4
+                    or any(type(x) not in (int, float) or not math.isfinite(x) or abs(x) > 20_000 for x in box)
+                    or not box[0] < box[2] or not box[1] < box[3]):
+                raise PDFAnnotationError('pdf_profile_unsupported')
+        if (type(inherited.get('/Rotate', 0)) is not int or inherited.get('/Rotate', 0) != 0
+                or type(value.get('/UserUnit', 1)) not in (int, float) or value.get('/UserUnit', 1) != 1):
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        bounds = [max(media[0], crop[0]), max(media[1], crop[1]), min(media[2], crop[2]), min(media[3], crop[3])]
+        if bounds[0] >= bounds[2] or bounds[1] >= bounds[3]:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        annots = _resolve(graph, value.get('/Annots', []))
+        if type(annots) is not list or len(annots) > 256:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        for item in annots:
+            if not _ref(item) or item in seen_annots:
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            annotation = _check_annotation(graph, item, ref)
+            if (type(annotation) is not dict or annotation.get('/Type', '/Annot') != '/Annot'
+                    or annotation.get('/Subtype') not in ('/Text', '/Link', '/FreeText', '/Line', '/Square',
+                        '/Circle', '/Polygon', '/PolyLine', '/Highlight', '/Underline', '/Squiggly',
+                        '/StrikeOut', '/Stamp', '/Caret', '/Ink', '/Popup', '/Widget')):
+                raise PDFAnnotationError('pdf_profile_unsupported')
+            seen_annots.add(item)
+        rows.append(dict(ref=ref, bounds=bounds, annotations=annots, present='/Annots' in value))
+    return graph, rows
+
+
+def _digest(graph, pages, original_counts=None):
+    """Full reachable graph, with only the specifically appended annotations masked.
+
+    Normalize /Annots arrays to values in both snapshots, so qpdf's direct versus
+    indirect array representation cannot hide a change to any old annotation.
+    Raw stream digests cover content, fonts, images and existing appearances.
+    """
+    page_map = {row['ref']: (index, row) for index, row in enumerate(pages)}
+    seen = {}
+    def walk(value, depth=0):
+        if depth > 64:
+            raise PDFAnnotationError('pdf_profile_unsupported')
+        if _ref(value):
+            if value in seen:
+                return {'ref': seen[value]}
+            seen[value] = len(seen)
+            node = graph['obj:' + value]
+            if value in page_map:
+                index, row = page_map[value]
+                page = dict(node['value'])
+                count, present = ((len(row['annotations']), row['present']) if original_counts is None
+                                  else original_counts[index])
+                if present:
+                    page['/Annots'] = row['annotations'][:count]
+                else:
+                    page.pop('/Annots', None)
+                node = {'value': page}
+            return walk(node, depth + 1)
+        if type(value) is dict:
+            return {key: walk(value[key], depth + 1) for key in sorted(value)}
+        if type(value) is list:
+            return [walk(item, depth + 1) for item in value]
+        return value
+    trailer = {key: value for key, value in graph['trailer']['value'].items()
+               if key not in ('/Size', '/ID', '/Prev', '/XRefStm')}
+    return hashlib.sha256(json.dumps(walk(trailer), sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def _hex_text(text):
+    return '<' + (b'\xfe\xff' + text.encode('utf-16-be')).hex() + '>'
+
+
+def _number(value):
+    # PDF numeric syntax has no exponent form. Decimal(str()) preserves the
+    # JSON/Python finite value while spelling even tiny coordinates legally.
+    from decimal import Decimal
+    return format(Decimal(str(value)), 'f')
+
+
+def _annotation_dictionary(row, page_ref, name):
+    return {'/Type': '/Annot', '/Subtype': '/Text', '/Rect': [row['x'], row['y'], row['x'] + ICON_SIZE, row['y'] + ICON_SIZE],
+            '/Contents': 'u:' + row['text'], '/P': page_ref, '/F': 4,
+            '/Name': '/Comment', '/Open': False, '/C': [1, .86, .2], '/Border': [0, 0, 0], '/NM': 'u:' + name}
+
+
+def _child():
+    import resource
+    os.umask(0o077)
+    os.sched_setaffinity(0, sorted(os.sched_getaffinity(0))[:2])
+    for kind, limit in ((resource.RLIMIT_AS, 1024**3), (resource.RLIMIT_CPU, CPU_SECONDS),
+            (resource.RLIMIT_FSIZE, 8_000_000), (resource.RLIMIT_CORE, 0),
+            (resource.RLIMIT_NOFILE, 64), (resource.RLIMIT_NPROC, 16)):
+        resource.setrlimit(kind, (limit, limit))
+    handles = []
+    lib, C, callback = _library()
+    def create(path):
+        handle = C.c_void_p(lib.qpdf_init())
+        handles.append(handle)
+        if not handle:
+            raise PDFAnnotationError('pdf_engine_unavailable')
+        _checked(lib, handle, 'qpdf_silence_errors')
+        _checked(lib, handle, 'qpdf_set_suppress_warnings', 1)
+        _checked(lib, handle, 'qpdf_set_attempt_recovery', 0)
+        if _checked(lib, handle, 'qpdf_read', path, None):
+            raise PDFAnnotationError('pdf_malformed_or_unsupported')
+        return handle
+    try:
+        spec = request(Path('/work/request.json').read_text())
+        handle = create(b'/work/input0.pdf')
+        graph, pages = _profile(lib, C, callback, handle)
+        before = _digest(graph, pages)
+        counts = [(len(page['annotations']), page['present']) for page in pages]
+        grouped = {}
+        for index, row in enumerate(spec['annotations']):
+            if row['page'] > len(pages):
+                raise PDFAnnotationError('pdf_page_out_of_range')
+            page = pages[row['page'] - 1]
+            x0, y0, x1, y1 = page['bounds']
+            if not x0 <= row['x'] <= x1 - ICON_SIZE or not y0 <= row['y'] <= y1 - ICON_SIZE:
+                raise PDFAnnotationError('pdf_coordinates_out_of_bounds')
+            name = 'friday-comment-' + hashlib.sha256((spec['source_sha256'] + ':' + str(index)).encode()).hexdigest()[:32]
+            grouped.setdefault(row['page'] - 1, []).append((row, name))
+        for page_index, rows in grouped.items():
+            page = pages[page_index]
+            oid, gen, _ = page['ref'].split()
+            page_handle = _checked(lib, handle, 'qpdf_get_object_by_id', int(oid), int(gen))
+            annots = _checked(lib, handle, 'qpdf_oh_new_array')
+            for ref in page['annotations']:
+                old_id, old_gen, _ = ref.split()
+                _checked(lib, handle, 'qpdf_oh_append_item', annots,
+                         _checked(lib, handle, 'qpdf_get_object_by_id', int(old_id), int(old_gen)))
+            for row, name in rows:
+                normal = _checked(lib, handle, 'qpdf_oh_new_stream')
+                null = _checked(lib, handle, 'qpdf_oh_new_null')
+                _checked(lib, handle, 'qpdf_oh_replace_stream_data', normal, ICON_STREAM, len(ICON_STREAM), null, null)
+                normaldict = _checked(lib, handle, 'qpdf_oh_get_dict', normal)
+                values = _checked(lib, handle, 'qpdf_oh_parse', b'<< /Type /XObject /Subtype /Form /FormType 1 /BBox [0 0 18 18] /Resources << >> >>')
+                for key in (b'/Type', b'/Subtype', b'/FormType', b'/BBox', b'/Resources'):
+                    _checked(lib, handle, 'qpdf_oh_replace_key', normaldict, key,
+                             _checked(lib, handle, 'qpdf_oh_get_key', values, key))
+                rect = ' '.join(_number(x) for x in (row['x'], row['y'], row['x'] + ICON_SIZE, row['y'] + ICON_SIZE))
+                dictionary = (f'<< /Type /Annot /Subtype /Text /Rect [{rect}] /Contents {_hex_text(row["text"])} '
+                    f'/F 4 /Name /Comment /Open false /C [1 .86 .2] /Border [0 0 0] /NM {_hex_text(name)} >>').encode('ascii')
+                annotation = _checked(lib, handle, 'qpdf_make_indirect_object',
+                                      _checked(lib, handle, 'qpdf_oh_parse', dictionary))
+                # qpdf_oh_parse does not resolve indirect references. Attach the
+                # already-owned page handle through the native object API.
+                _checked(lib, handle, 'qpdf_oh_replace_key', annotation, b'/P', page_handle)
+                ap = _checked(lib, handle, 'qpdf_oh_parse', b'<< >>')
+                _checked(lib, handle, 'qpdf_oh_replace_key', ap, b'/N', normal)
+                _checked(lib, handle, 'qpdf_oh_replace_key', annotation, b'/AP', ap)
+                _checked(lib, handle, 'qpdf_oh_append_item', annots, annotation)
+            _checked(lib, handle, 'qpdf_oh_replace_key', page_handle, b'/Annots', annots)
+        if _checked(lib, handle, 'qpdf_init_write', b'/work/output.pdf'):
+            raise PDFAnnotationError('pdf_engine_failed')
+        _checked(lib, handle, 'qpdf_set_minimum_pdf_version', b'1.4')
+        for name, arg in [('qpdf_set_stream_data_mode', 1), ('qpdf_set_decode_level', 0),
+                         ('qpdf_set_compress_streams', 0), ('qpdf_set_object_stream_mode', 1)]:
+            _checked(lib, handle, name, arg)
+        if _checked(lib, handle, 'qpdf_write'):
+            raise PDFAnnotationError('pdf_engine_failed')
+        if not 0 < Path('/work/output.pdf').stat().st_size <= MAX_BYTES:
+            raise PDFAnnotationError('pdf_output_limit')
+        verify = create(b'/work/output.pdf')
+        outgraph, outpages = _profile(lib, C, callback, verify)
+        if len(outpages) != len(pages) or _digest(outgraph, outpages, counts) != before:
+            raise PDFAnnotationError('pdf_verification_failed')
+        for index, page in enumerate(outpages):
+            expected_rows = grouped.get(index, [])
+            if len(page['annotations']) != counts[index][0] + len(expected_rows):
+                raise PDFAnnotationError('pdf_verification_failed')
+            for ref, (row, name) in zip(page['annotations'][counts[index][0]:], expected_rows):
+                value = dict(_resolve(outgraph, ref))
+                ap = _resolve(outgraph, value.pop('/AP', None))
+                if (value != _annotation_dictionary(row, page['ref'], name)
+                        or type(ap) is not dict or set(ap) != {'/N'}):
+                    raise PDFAnnotationError('pdf_verification_failed')
+                normal = _resolve(outgraph, ap['/N'], stream=True)
+                if normal['dict'] != ICON_DICTIONARY or normal['raw_sha256'] != hashlib.sha256(ICON_STREAM).hexdigest():
+                    raise PDFAnnotationError('pdf_verification_failed')
+        Path('/work/result.json').write_text(json.dumps(dict(annotations=spec['annotations'], pages=len(pages),
+            engine='libqpdf-12.3.2', profile='native_Text_comments_Unicode', appearance='vector_icon_generated_and_reparsed')))
+    finally:
+        for handle in reversed(handles):
+            lib.qpdf_cleanup(C.byref(handle))
