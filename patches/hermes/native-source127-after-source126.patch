+        value = {}
+        for tag, key in ((q(DC, 'creator'), 'author'), (q(DC, 'date'), 'date'),
+                         (q(META, 'creator-initials'), 'initials'), (q(META, 'date-string'), 'date_string')):
+            matches = node.findall(tag)
+            if len(matches) > 1 or any(len(n) for n in matches):
+                fail('ambiguous_review_attribution')
+            value[key] = bounded(matches[0].text or '') if matches else None
+        return value
+
+    paragraphs = []
+    for index, node in enumerate(package.body.iter()):
+        if index % 64 == 0:
+            tick()
+        if node.tag not in PARAS:
