+"""Bounded native Unicode PDF text comments in a networkless qpdf sandbox."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+
+MAX_BYTES = 1_000_000
+MAX_PAGES = 32
+MAX_ANNOTATIONS = 32
+MAX_TEXT = 2048
+MAX_JSON = 8_000_000
+WALL_SECONDS = 40
+CPU_SECONDS = 30
+LIBRARY = '/usr/lib/x86_64-linux-gnu/libqpdf.so.30'
+
+
+class PDFAnnotationError(ValueError):
+    pass
+
+
+def _argv(work, count):
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--as-pid-1',
+            '--cap-drop', 'ALL', '--clearenv', '--ro-bind', '/usr', '/usr']
+    for name in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / name
+        if path.exists():
+            target = path.resolve()
+            if not target.is_relative_to('/usr'):
+                raise PDFAnnotationError('pdf_engine_unavailable')
+            argv += ['--symlink', str(target), '/' + name]
+    argv += ['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
+             '--bind', str(work), '/work']
+    for name in ['runner.py', 'request.json'] + [f'input{i}.pdf' for i in range(count)]:
+        argv += ['--ro-bind', str(work / name), '/work/' + name]
+    argv += ['--chdir', '/work', '--remount-ro', '/', '--',
+             '/usr/bin/python3', '-I', '-B', '-S', '/work/runner.py', '--child']
+    return argv
+
+
+def _run(cap, work, count):
+    from agent.web_call_context import _current, same_web_authority
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    if call is None or not same_web_authority(call):
+        raise PDFAnnotationError('native_deadline_required')
+    custody = _Custody()
+    bound = False
+    deadline = min(call.deadline(), time.monotonic() + WALL_SECONDS)
+    try:
+        with call.turn.lock:
+            check(cap)
+            call.check()
+            if call.session is not None or call.registry is not None:
+                raise PDFAnnotationError('pdf_custody_busy')
+            if time.monotonic() >= deadline:
+                raise PDFAnnotationError('pdf_timeout')
+            call.session = call.registry = custody
+            call.turn.calls.add(custody)
+            bound = True
+            custody.process = subprocess.Popen(_argv(work, count), cwd=work,
+                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                close_fds=True, start_new_session=True,
+                env={'PATH': '/usr/bin:/bin', 'LANG': 'C.UTF-8'})
+        while custody.process.poll() is None:
+            check(cap)
+            call.check()
+            if not same_web_authority(call):
+                raise PDFAnnotationError('pdf_authority_changed')
+            if time.monotonic() >= deadline:
+                raise PDFAnnotationError('pdf_timeout')
+            try:
+                custody.process.wait(timeout=min(.05, max(.001, deadline - time.monotonic())))
+            except subprocess.TimeoutExpired:
+                pass
+        check(cap)
+        call.check()
+        if custody.process.returncode != 0:
+            raise PDFAnnotationError('pdf_engine_failed')
+    finally:
+        receipt = custody.stop()
+        with call.turn.lock:
+            if bound and receipt['status'] == 'QUIESCENT':
+                if call.session is not custody or call.registry is not custody:
+                    receipt = {'status': 'STOP_UNCONFIRMED'}
+                else:
+                    call.session = call.registry = None
+                    call.turn.calls.discard(custody)
+        if receipt['status'] != 'QUIESCENT':
+            if hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise PDFAnnotationError('pdf_cleanup_unconfirmed')
+
+
+def _library():
