index 0000000000000000000000000000000000000000..fbf1b3e654b37258112ce244544fef618ec5d0ce
--- /dev/null
+++ b/gateway/x02_acceptance.py
@@ -0,0 +1,298 @@
+"""Persist the original protected upload and its delivered summary together."""
+
+import asyncio
+from dataclasses import dataclass
+from hashlib import sha256
+from pathlib import Path
+from sqlite3 import Error as DatabaseError
+from types import SimpleNamespace
+import time
+
+from cryptography.exceptions import InvalidTag
+
+from agent.message_metadata import mint_uid
+from gateway.run_attachment_presentation import (
+    _current_metadata, attachment_display_metadata,
+)
+from gateway.upload_anchor import (
+    AnchorUnavailable,
+    _MAX_METADATA,
+    _PLATFORM_MESSAGE,
+    _RECEIPT_COLUMNS,
+    _ROW_SQL,
+    _SESSION_SQL,
+    _current_entry,
+    _file,
+    _object,
+    _read_snapshot,
+    _route,
+    _snapshot_progress,
+)
+from hermes_cli.friday_user_scope import current as current_scope, workspace_document
+from hermes_state import SessionDB
+from hermes_state_messages import _INSERT_MESSAGE_SQL
+
+
+_SUMMARY_SQL = f"""SELECT {_RECEIPT_COLUMNS} FROM messages
+    WHERE session_id = ? AND id = ?
+    AND role = 'assistant' AND observed = 0 AND _compressed_summary = 0 AND display_kind IS NULL
+    AND ((active = 1 AND compacted = 0) OR (active = 0 AND compacted = 1))"""
+_MESSAGE_IDS_SQL = """SELECT id FROM messages
+    WHERE session_id = ? AND platform_message_id = ? ORDER BY id LIMIT 2"""
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class AcceptedSummaryReceipts:
+    principal: tuple
+    profile: str
+    admission_generation: int
+    home_identity: tuple
+    session_key: str
+    predecessor_id: str
+    upload_row_id: int
+    upload_uid: str
+    upload_message_id: str
+    upload_metadata_sha256: str
+    summary_row_id: int
+    summary_uid: str
+    summary_message_id: str
+    summary_metadata_sha256: str
+    file_name: str
+    file_sha256: str
+    file_size: int
+    file_identity: tuple
+
+
+def _require(condition):
+    if not condition:
+        raise AnchorUnavailable()
+
+
+def _delivered_summary_id(operation, delivered, expected_text):
+    from gateway.ordinary_archive_input import _miniapp_reply_matches
+    from telegram import Message
+
+    selection = operation.selection
+    raw, bot = selection.message, selection.caption.bot
+    _require(type(delivered) is Message and type(expected_text) is str and expected_text.strip()
+             and "\0" not in expected_text and len(expected_text.encode("utf-16-le")) <= 8192)
+    author, reply = delivered.from_user, delivered.reply_to_message
+    _require(delivered.get_bot() is bot and author is not None
+             and author.is_bot is True and author.id == bot.id
+             and delivered.chat.type == "private" and delivered.chat.id == raw.chat.id
+             and delivered.text == expected_text and type(delivered.message_id) is int
+             and raw.message_id < delivered.message_id and delivered.caption is None
+             and delivered.document is None and delivered.sender_chat is None
+             and delivered.message_thread_id is None and delivered.direct_messages_topic is None
+             and delivered.business_connection_id is None and delivered.forward_origin is None
+             and delivered.via_bot is None and delivered.edit_date is None
+             and _miniapp_reply_matches(selection, reply, bot)
+             and reply.chat.id == raw.chat.id and reply.message_id == raw.message_id)
+    message_id = str(delivered.message_id)
+    _require(_PLATFORM_MESSAGE.fullmatch(message_id))
+    return message_id
+
+
+def _active_session(conn, operation, route):
+    cap = operation.cap
+    row = conn.execute(_SESSION_SQL, (_MAX_METADATA, _MAX_METADATA, operation.session_id)).fetchone()
+    account = {"schema": "friday.account_origin.v1", "platform": cap.principal[0],
+               "transport_profile": cap.principal[1], "account_id": cap.principal[2]}
+    _require(row is not None and row["ended_at"] is None and row["end_reason"] is None
+             and row["profile_name"] == cap.profile and row["session_key"] == operation.key
+             and (row["config_bytes"] or 0) <= _MAX_METADATA
+             and tuple(row[name] for name in ("source", "user_id", "chat_id", "chat_type", "thread_id")) == route
+             and _object(row["origin_json"]).get("friday_account_origin") == account)
+    return tuple(row)
+
+
+def _pin(row, message_id, metadata):
+    _require(row is not None and row["platform_message_id"] == message_id
+             and type(row["message_uid"]) is str and bool(row["message_uid"])
+             and row["active"] == 1 and row["compacted"] == 0
+             and row["metadata"] == metadata)
+    return row["message_uid"], sha256(row["metadata"].encode("utf-8")).hexdigest()
+
+
+def _put_message(db, conn, session_id, role, message_id, metadata, *, uid=None):
+    message = {"platform_message_id": message_id, "display_metadata": metadata, "message_uid": uid or mint_uid()}
+    params = db._message_row_params(session_id, role, message, None, time.time(), keep_reasoning=False)
+    row_id = conn.execute(_INSERT_MESSAGE_SQL, params).lastrowid
+    db._bump_session_counters(conn, session_id, 1, 0, unit=True)
+    return row_id
+
+
+def commit_accepted_summary(operation, delivered, *, expected_text, current, projection=None, member_path=None):
+    """Record one native SDK reply from the authorized original continuation.
+
+    The caller supplies the verified Message returned by its actual send.
+    The protected browser confirmation is checked here. Case factual grading
+    happens outside this boundary. A None result never authorizes another send.
+    """
+    from gateway.ordinary_archive_input import _ProtectedInput
+    from gateway.ordinary_archive_issuer import _ReadOperation, _ReadSelection, operation_for_event
+    from gateway.x02_quote_evidence import (
+        QUOTE_EVIDENCE_KEY, open_quote_envelope, project_identity, quote_evidence_key, seal_quote_evidence,
+    )
+
+    try:
+        _require(type(operation) is _ReadOperation and asyncio.current_task() is operation.task)
+        form, selection, cap = operation._protected_input, operation.selection, operation.cap
+        _require(type(form) is _ProtectedInput and type(selection) is _ReadSelection
+                 and form.operation is operation and current == form._current)
+        event, source = selection.event, operation.source
+        _require(getattr(event, "_friday_archive_summary_delivery", None) == "DELIVERED")
+        summary_id = _delivered_summary_id(operation, delivered, expected_text)
+        upload_id, deadline = selection.caption.message_id, selection.deadline
+        _require(upload_id == operation.approval.upload_message == source.message_id == event.message_id
+                 and _PLATFORM_MESSAGE.fullmatch(upload_id))
+        store, route = operation.runner.session_store, _route(source)
+
+        def authority():
+            _require(time.monotonic() < deadline and asyncio.current_task() is operation.task
+                     and form._read_running and form._read_accepted and form._launch_acknowledged
+                     and not operation.owner._stopped.is_set()
+                     and form.receipt.get("success") is True and form.receipt.get("effect_disposition") == "none"
+                     and current_scope(required=True) is cap and current() is True
+                     and operation_for_event(event) is operation
+                     and operation.runner.session_store is store)
+
+        authority()
+        db = store._db_for_key(operation.key)
+        _require(type(db) is SessionDB and Path(db.db_path) == cap.home / "state.db"
+                 and db._conn is not None and db._db_file_identity is not None)
+        db_identity = db._db_file_identity
+        upload = attachment_display_metadata(event, _current_metadata(event, source, cap))
+        upload_raw = db._encode_display_metadata(upload)
+        name = selection.caption.file_name
+        file = _file((upload_id, None, None, None, upload_raw), cap, name)
+        approval = operation.approval
+        _require(file["path"] == approval.source and file["sha256"] == approval.source_sha256
+                 and operation.path == str(cap.home / "workspace" / file["path"])
+                 and file["size_bytes"] == selection.caption.file_size and file["size_bytes"] > 0)
+        def verify_file():
+            data, relative, identity = workspace_document(
+                operation.path, max_bytes=file["size_bytes"], with_identity=True)
+            _require(relative == file["path"] and len(data) == file["size_bytes"]
+                     and identity == approval.file_identity and sha256(data).hexdigest() == file["sha256"])
+            return identity
+
+        identity = verify_file()
+        sid = operation.session_id
+        ctx = SimpleNamespace(session_id=sid, session_key=operation.key)
+        custody = {
+            "schema": "friday.x02.summary-custody.v1",
+            "principal": list(cap.principal), "profile": cap.profile,
+            "admission_generation": cap.admission_generation, "home_identity": list(cap.directory_identity),
+            "archive_identity": list(identity), "archive_size_bytes": file["size_bytes"],
+            "summary_text_sha256": sha256(expected_text.encode("utf-8")).hexdigest(),
+        }
+        def current_key_owner():
+            authority()
+            return True
+
+        quote_key = quote_evidence_key(cap, create=True, current=current_key_owner) if member_path is not None else None
+        retained_metadata = None
+
+        def summary_metadata(upload_row_id, upload_pin, carrier=None):
+            upload_uid, upload_sha = upload_pin
+            metadata = {
+                "friday_x02_accepted_summary": {
+                    "schema": "friday.x02.accepted-summary.v1", "source_session_id": sid,
+                    "upload_row_id": upload_row_id, "upload_uid": upload_uid, "upload_message_id": upload_id,
+                    "upload_metadata_sha256": upload_sha, "archive_sha256": file["sha256"],
+                    "summary_message_id": summary_id,
+                },
+                "friday_x02_summary_custody": custody,
+            }
+            if carrier is not None:
+                metadata[QUOTE_EVIDENCE_KEY] = carrier
+            return metadata
+
+        def verify(conn, upload_row_id, summary_row_id):
+            _require(upload_row_id < summary_row_id)
+            base = _active_session(conn, operation, route)
+            user = conn.execute(_ROW_SQL, (_MAX_METADATA, sid, upload_row_id)).fetchone()
+            upload_pin = _pin(user, upload_id, upload_raw)
+            _require(_file(tuple(user), cap, name) == file)
+            carrier = None if retained_metadata is None else retained_metadata.get(QUOTE_EVIDENCE_KEY)
+            raw = db._encode_display_metadata(summary_metadata(upload_row_id, upload_pin, carrier))
+            summary = conn.execute(_SUMMARY_SQL, (_MAX_METADATA, sid, summary_row_id)).fetchone()
+            summary_pin = _pin(summary, summary_id, raw)
+            return base, upload_pin, summary_pin
+
+        def write_pair(conn):
+            nonlocal retained_metadata
+            # The writer lock and BEGIN IMMEDIATE are already held. Never call
+            # a blocking store lookup from this SQL transaction.
+            def fast_current():
+                return (time.monotonic() < deadline and db._db_file_identity == db_identity
+                     and form._stopped_at is None and not operation.guard.is_set()
+                     and not operation.owner._stopped.is_set() and not operation.call.turn.stopped.is_set()
+                     and _current_entry(store, ctx, cap, route).active_turn_token == operation.marker)
+
+            _require(fast_current())
+            entry = _current_entry(store, ctx, cap, route)
+            _active_session(conn, operation, route)
+            db._check_transcript_write_guards(conn, sid, None, reject_active_turn_lease=True,
+                                              reject_active_compression_lock=True)
+            original = conn.execute(_MESSAGE_IDS_SQL, (sid, upload_id)).fetchall()
+            sent = conn.execute(_MESSAGE_IDS_SQL, (sid, summary_id)).fetchall()
+            if original or sent:
+                _require(len(original) == len(sent) == 1)
+                upload_row_id, summary_row_id = original[0]["id"], sent[0]["id"]
+                summary = conn.execute(_SUMMARY_SQL, (_MAX_METADATA, sid, summary_row_id)).fetchone()
+                _require(summary is not None)
+                retained_metadata = _object(summary["metadata"])
+                carrier = retained_metadata.get(QUOTE_EVIDENCE_KEY)
+                if carrier is not None:
+                    context = open_quote_envelope(
+                        quote_key, carrier, session_key=operation.key,
+                        link=retained_metadata["friday_x02_accepted_summary"], custody=custody,
+                        summary_uid=summary["message_uid"],
+                    )
+                    _require(context["project"] == project_identity(selection.caption.project)
+                             and context["member"]["path"] == member_path
+                             and context["member"] in projection["members"])
+            else:
+                upload_row_id = _put_message(db, conn, sid, "user", upload_id, upload)
+                user = conn.execute(_ROW_SQL, (_MAX_METADATA, sid, upload_row_id)).fetchone()
+                upload_pin = _pin(user, upload_id, upload_raw)
+                summary_uid = mint_uid()
+                metadata = summary_metadata(upload_row_id, upload_pin)
+                carrier = None if quote_key is None else seal_quote_evidence(
+                    quote_key, operation, projection, member_path,
+                    link=metadata["friday_x02_accepted_summary"], custody=custody,
+                    summary_uid=summary_uid, current=fast_current,
+                )
+                retained_metadata = summary_metadata(upload_row_id, upload_pin, carrier)
+                summary_row_id = _put_message(db, conn, sid, "assistant", summary_id, retained_metadata, uid=summary_uid)
+            snapshot = verify(conn, upload_row_id, summary_row_id)
+            _require(time.monotonic() < deadline and _current_entry(store, ctx, cap, route) is entry
+                     and entry.active_turn_token == operation.marker and not operation.guard.is_set()
+                     and not operation.owner._stopped.is_set() and not operation.call.turn.stopped.is_set())
+            return upload_row_id, summary_row_id, snapshot
+
+        # Serialize acceptance with the protected form's cross-thread STOP.
+        # Use a nonblocking route lookup inside the SQLite transaction.
+        authority()
+        with form._lock:
+            patience = min(deadline - time.monotonic(), 1.0)
+            _require(patience > 0)
+            upload_row_id, summary_row_id, snapshot = db._execute_write(write_pair, patience_s=patience)
+        authority()
+        stop = min(deadline, time.monotonic() + 0.25)
+        with _read_snapshot(db, stop, _snapshot_progress(stop)) as conn:
+            _require(verify(conn, upload_row_id, summary_row_id) == snapshot)
+        _require(verify_file() == identity)
+        authority()
+        _require(db._conn is not None and db._db_file_identity == db_identity and not db._db_file_was_replaced())
+        _, (upload_uid, upload_sha), (summary_uid, summary_sha) = snapshot
+        return AcceptedSummaryReceipts(
+            cap.principal, cap.profile, cap.admission_generation, cap.directory_identity, operation.key, sid,
+            upload_row_id, upload_uid, upload_id, upload_sha, summary_row_id, summary_uid, summary_id,
+            summary_sha, name, file["sha256"], file["size_bytes"], identity,
+        )
+    except (ArithmeticError, AttributeError, DatabaseError, InvalidTag, KeyError, OSError,
+            RuntimeError, TypeError, ValueError):
+        return None
diff --git a/gateway/x02_followup.py b/gateway/x02_followup.py
