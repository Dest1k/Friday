@@ -0,0 +1,219 @@
+"""Deliver one exact accepted X-02 upload through its direct, native reset successor.
+
+The native reset readback supplies one exact acceptance from the existing store.
+This module registers no model tool, handler or persistent store.
+"""
+
+import asyncio
+from dataclasses import dataclass
+from hashlib import sha256
+import math
+from sqlite3 import Error as DatabaseError
+from types import SimpleNamespace
+import time
+
+from gateway.platforms.base import SendResult
+from gateway.run_plugin_delivery import _ordinary_authority, deliver_ordinary_document
+from gateway.upload_anchor import (
+    AnchorUnavailable,
+    _current_entry,
+    _file,
+    _MAX_METADATA,
+    _object,
+    _PLATFORM_MESSAGE,
+    _read_snapshot,
+    _RECEIPT_COLUMNS,
+    _route,
+    _ROW_SQL,
+    _selector,
+    _SESSION_SQL,
+    _snapshot_progress,
+)
+from hermes_cli.friday_user_scope import workspace_document
+from gateway.x02_reset_provider import _native_new_id, _owned_db, read_accepted_reset_original
+
+
+_SUMMARY_SQL = f"""SELECT {_RECEIPT_COLUMNS} FROM messages
+    WHERE session_id = ? AND id = ? AND role = 'assistant'
+    AND observed = 0 AND _compressed_summary = 0 AND display_kind IS NULL
+    AND ((active = 1 AND compacted = 0) OR (active = 0 AND compacted = 1))"""
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class _AcceptedOriginal:
+    """Internal handoff from the trusted accepted-summary and native /new owner."""
+
+    principal: tuple
+    profile: str
+    admission_generation: int
+    home_identity: tuple
+    session_key: str
+    predecessor_id: str
+    successor_id: str
+    reset_message_id: str
+    upload_row_id: int
+    upload_uid: str
+    upload_message_id: str
+    upload_metadata_sha256: str
+    summary_row_id: int
+    summary_uid: str
+    summary_message_id: str
+    summary_metadata_sha256: str
+    file_name: str
+    file_sha256: str
+    file_size: int
+    file_identity: tuple
+
+
+def _require(condition):
+    if not condition:
+        raise AnchorUnavailable()
+
+
+def _read_session(connection, session_id, cap, key, route):
+    row = connection.execute(_SESSION_SQL, (_MAX_METADATA, _MAX_METADATA, session_id)).fetchone()
+    account = {
+        "schema": "friday.account_origin.v1", "platform": cap.principal[0],
+        "transport_profile": cap.principal[1], "account_id": cap.principal[2],
+    }
+    _require(row is not None and row["profile_name"] == cap.profile and row["session_key"] == key
+             and tuple(row[name] for name in ("source", "user_id", "chat_id", "chat_type", "thread_id")) == route
+             and _object(row["origin_json"]).get("friday_account_origin") == account
+             and (row["config_bytes"] or 0) <= _MAX_METADATA)
+    return row
+
+
+def _check_receipt(row, uid, message_id, metadata_sha256):
+    _require(row is not None and type(uid) is str and bool(uid) and row["message_uid"] == uid
+             and row["platform_message_id"] == message_id and type(row["metadata"]) is str
+             and sha256(row["metadata"].encode("utf-8")).hexdigest() == metadata_sha256)
+
+
+def _read_predecessor(db, cap, route, accepted, deadline):
+    stop = min(deadline, time.monotonic() + 0.25)
+    with _read_snapshot(db, stop, _snapshot_progress(stop)) as connection:
+        before = _read_session(connection, accepted.predecessor_id, cap, accepted.session_key, route)
+        after = _read_session(connection, accepted.successor_id, cap, accepted.session_key, route)
+        config = _object(after["model_config"])
+        started = connection.execute(
+            "SELECT started_at FROM sessions WHERE id = ?", (after["id"],)
+        ).fetchone()["started_at"]
+        _require(before["ended_at"] is not None and before["ended_at"] == started
+                 and before["end_reason"] == "session_reset"
+                 and after["ended_at"] is None and after["end_reason"] is None
+                 and after["parent_session_id"] == config.get("_reset_from") == before["id"]
+                 and _native_new_id(connection, after, before["id"], cap) == accepted.reset_message_id)
+        upload = connection.execute(
+            _ROW_SQL, (_MAX_METADATA, before["id"], accepted.upload_row_id)
+        ).fetchone()
+        summary = connection.execute(
+            _SUMMARY_SQL, (_MAX_METADATA, before["id"], accepted.summary_row_id)
+        ).fetchone()
+        _check_receipt(upload, accepted.upload_uid, accepted.upload_message_id, accepted.upload_metadata_sha256)
+        _check_receipt(summary, accepted.summary_uid, accepted.summary_message_id, accepted.summary_metadata_sha256)
+        linked_summary = _object(summary["metadata"]).get("friday_x02_accepted_summary")
+        _require(linked_summary == {
+            "schema": "friday.x02.accepted-summary.v1", "source_session_id": before["id"],
+            "upload_row_id": accepted.upload_row_id, "upload_uid": accepted.upload_uid,
+            "upload_message_id": accepted.upload_message_id,
+            "upload_metadata_sha256": accepted.upload_metadata_sha256,
+            "archive_sha256": accepted.file_sha256, "summary_message_id": accepted.summary_message_id,
+        })
+        file = _file(tuple(upload), cap, accepted.file_name)
+        _require(file["sha256"] == accepted.file_sha256 and file["size_bytes"] == accepted.file_size)
+        return tuple(before), tuple(after), started, tuple(upload), tuple(summary), file
+
+
+async def deliver_x02_original(adapter, source, *, deadline, caption=None,
+                               expected_original=None, still_current=None):
+    """Use the fresh owned delivery state and its exact reset-scoped witness."""
+    unavailable = SendResult(success=False, error="x02_original_unavailable")
+    try:
+        paired = caption is not None
+        if paired:
+            _require(type(expected_original) is _AcceptedOriginal
+                     and callable(still_current) and still_current() is True)
+        else:
+            _require(expected_original is None and still_current is None)
+        _require(type(deadline) in (int, float) and math.isfinite(deadline) and time.monotonic() < deadline)
+        cap, runner, _, _, check_origin = _ordinary_authority(adapter, source)
+        route = _route(source)
+        _require(route[:2] == ("telegram", cap.principal[3])
+                 and source.chat_type == "dm" and source.chat_id == source.user_id
+                 and not source.thread_id and not source.is_bot and not source.delivered_via_upstream_relay)
+        key, _ = source._friday_document_guard
+        sid = source._friday_document_session_id
+        mark = source._friday_document_turn
+        _require(source._friday_document_run[0] == mark[0] == key and type(mark[1]) is str and bool(mark[1]))
+        accepted = read_accepted_reset_original(adapter, source, sid, deadline=deadline)
+        if paired:
+            _require(accepted == expected_original)
+        _require(type(accepted) is _AcceptedOriginal
+                 and (accepted.principal, accepted.profile, accepted.admission_generation, accepted.home_identity)
+                 == (cap.principal, cap.profile, cap.admission_generation, cap.directory_identity)
+                 and accepted.session_key == key and accepted.successor_id == sid
+                 and accepted.predecessor_id != sid)
+        _selector({
+            "source_session_id": accepted.predecessor_id, "native_row_id": accepted.upload_row_id,
+            "file_name": accepted.file_name,
+        })
+        ids = (accepted.upload_message_id, accepted.summary_message_id, accepted.reset_message_id, source.message_id)
+        _require(all(type(value) is str and _PLATFORM_MESSAGE.fullmatch(value) for value in ids))
+        upload_id, summary_id, reset_id, current_id = map(int, ids)
+        _require(upload_id < summary_id < reset_id < current_id
+                 and type(accepted.summary_row_id) is int and accepted.upload_row_id < accepted.summary_row_id < 2**63
+                 and type(accepted.file_size) is int and accepted.file_size > 0
+                 and type(accepted.file_identity) is tuple and len(accepted.file_identity) == 9
+                 and all(type(value) is int for value in accepted.file_identity)
+                 and accepted.file_name.lower().endswith(".zip"))
+        store = runner.session_store
+        db = _owned_db(store, cap)
+        db_identity = db._db_file_identity
+        ctx = SimpleNamespace(session_key=key, session_id=sid)
+
+        def current_entry():
+            if paired:
+                _require(still_current() is True)
+            check_origin()
+            _require(time.monotonic() < deadline and runner.session_store is store
+                     and source._friday_document_session_id == sid
+                     and source._friday_document_turn is mark
+                     and db._conn is not None and db._db_file_identity == db_identity
+                     and not db._db_file_was_replaced())
+            latest = read_accepted_reset_original(adapter, source, sid, deadline=deadline)
+            _require(type(latest) is _AcceptedOriginal and latest == accepted)
+            entry = _current_entry(store, ctx, cap, route)
+            _require(entry.active_turn_token == mark[1] and time.monotonic() < deadline)
+            return entry
+
+        entry = current_entry()
+        original = _read_predecessor(db, cap, route, accepted, deadline)
+        file = original[-1]
+        path = str(cap.home / "workspace" / file["path"])
+
+        def authority():
+            _require(current_entry() is entry)
+            _require(_read_predecessor(db, cap, route, accepted, deadline) == original)
+            data, relative, identity = workspace_document(path, max_bytes=accepted.file_size, with_identity=True)
+            _require(relative == file["path"] and len(data) == accepted.file_size
+                     and identity == accepted.file_identity and sha256(data).hexdigest() == accepted.file_sha256)
+            _require(_read_predecessor(db, cap, route, accepted, deadline) == original
+                     and current_entry() is entry)
+
+        authority()
+    except (ArithmeticError, AttributeError, DatabaseError, OSError, RuntimeError, TypeError, ValueError):
+        return unavailable
+    # The stock ledger remains the sole record of any delivery effect.
+    # A late or detached result cannot authorize the continuation or a retry.
+    try:
+        async with asyncio.timeout(max(0.0, deadline - time.monotonic())):
+            result = await deliver_ordinary_document(
+                adapter, source, path, file_name=accepted.file_name,
+                expected_sha256=accepted.file_sha256, authority_check=authority,
+                caption=caption, exact_archive_ack=paired,
+            )
+            if result.success:
+                authority()
+            return result
+    except (ArithmeticError, AttributeError, DatabaseError, OSError, RuntimeError, TypeError, ValueError):
+        return SendResult(success=False, error="document_delivery_UNKNOWN")
