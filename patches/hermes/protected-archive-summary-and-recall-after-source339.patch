index 0000000000000000000000000000000000000000..e1c5b6b343f4a233284e6fe70a3bad27749cdb04
--- /dev/null
+++ b/gateway/x02_reset_provider.py
@@ -0,0 +1,270 @@
+"""Read a unique X-02 acceptance pair on one native /new edge."""
+
+import asyncio
+from dataclasses import dataclass
+from hashlib import sha256
+import json
+import math
+from pathlib import Path
+import re
+from sqlite3 import Error as DatabaseError
+from types import SimpleNamespace
+import time
+
+from gateway.admitted_ingress import admitted_ingress
+from gateway.run_plugin_delivery import _ordinary_authority
+from gateway.session_identity import identity_of
+from gateway.session_persistence import _DB_UNPINNED
+from gateway.upload_anchor import (
+    AnchorUnavailable, DIRECT_UPLOAD_KEY, _current_entry, _file, _MAX_METADATA, _object,
+    _PLATFORM_MESSAGE, _read_snapshot, _RECEIPT_COLUMNS, _route, _ROW_SQL, _snapshot_progress,
+)
+from hermes_cli.friday_user_scope import current, workspace_document
+from hermes_state import SessionDB
+
+
+_NATIVE_NEW = "friday_x02_native_new"
+_SUMMARY = "friday_x02_accepted_summary"
+_CUSTODY = "friday_x02_summary_custody"
+_SHA = re.compile("[0-9a-f]{64}")
+_ERRORS = (ArithmeticError, AttributeError, DatabaseError, KeyError, OSError, RuntimeError, TypeError, ValueError)
+_ACCEPTED_ROWS = f"""SELECT id, {_RECEIPT_COLUMNS}, content IS NULL AS content_free
+    FROM messages WHERE session_id = ? AND role = 'assistant' AND observed = 0
+    AND _compressed_summary = 0 AND display_kind IS NULL
+    AND ((active = 1 AND compacted = 0) OR (active = 0 AND compacted = 1))
+    AND CASE
+        WHEN display_metadata IS NULL THEN 0
+        WHEN typeof(display_metadata) != 'text' OR length(CAST(display_metadata AS BLOB)) > ? THEN 1
+        WHEN NOT json_valid(display_metadata) THEN 1
+        ELSE json_type(display_metadata, '$.{_SUMMARY}') IS NOT NULL
+             OR json_type(display_metadata, '$.{_CUSTODY}') IS NOT NULL
+    END ORDER BY id LIMIT 2"""
+_ID_ROWS = """SELECT id FROM messages
+    WHERE session_id = ? AND platform_message_id = ? ORDER BY id LIMIT 2"""
+
+
+@dataclass(frozen=True, slots=True, repr=False)
+class _NativeNew:
+    source: object
+    cap: object
+    session_key: str
+    predecessor_id: str
+    message_id: str
+    update_id: str
+
+
+def _need(condition):
+    if not condition:
+        raise AnchorUnavailable()
+
+
+def _valid_id(value):
+    return type(value) is str and _PLATFORM_MESSAGE.fullmatch(value) is not None
+
+
+def _scope_record(cap):
+    return {
+        "principal": list(cap.principal), "profile": cap.profile,
+        "admission_generation": cap.admission_generation, "home_identity": list(cap.directory_identity),
+    }
+
+
+def capture_native_new(runner, event, source, session_key, predecessor):
+    """Capture only the original literal SDK command at the authorized slash seam."""
+    from gateway.platforms.base import MessageType
+    from telegram import Message
+
+    try:
+        cap = current()
+        raw = event.raw_message
+        identity = identity_of(source)
+        adapter = identity.adapter() if identity is not None else None
+        if (cap is None or predecessor is None or adapter is None
+                or type(raw) is not Message or raw.text != "/new" or event.text != "/new"
+                or event.message_type is not MessageType.COMMAND or event.internal or event._ingress_merged
+                or event.source is not source or source.chat_type != "dm" or source.thread_id
+                or source.chat_id != source.user_id or source.is_bot or source.delivered_via_upstream_relay
+                or raw.edit_date is not None or raw.forward_origin is not None or raw.reply_to_message is not None
+                or raw.caption is not None or raw.document is not None
+                or runner._is_user_authorized_for_source(source, allow_adapter_delegation=False) is not True):
+            return None
+        proof = admitted_ingress(event, source, session_key)
+        if proof is None:
+            return None
+        message = proof["message"]
+        message_id, update_id = message["message_id"], message["platform_update_id"]
+        if (proof["platform"] != "telegram" or proof["session_key"] != session_key
+                or proof["transport_profile"] != cap.principal[1] or proof["runtime_profile"] != cap.profile
+                or (message["bot_id"], message["user_id"]) != cap.principal[2:]
+                or message["chat_id"] != cap.principal[3] or message["thread_id"]
+                or message["media"] or message["reply_to_message_id"]
+                or raw.get_bot() is not adapter._bot
+                or raw.chat.type != "private" or raw.from_user is None or raw.from_user.is_bot
+                or str(raw.from_user.id) != str(raw.chat.id) or str(raw.chat.id) != source.chat_id
+                or not _valid_id(message_id) or not _valid_id(update_id)
+                or message_id != str(raw.message_id) or message_id != event.message_id
+                or message_id != source.message_id or update_id != str(event.platform_update_id)):
+            return None
+        return _NativeNew(source, cap, session_key, predecessor.session_id, message_id, update_id)
+    except _ERRORS:
+        return None
+
+
+def bind_native_new_origin(create_kwargs, witness, *, cap, source, session_key, predecessor_id):
+    """Attach the proof to the existing managed-session insert under its route lock."""
+    if (type(witness) is not _NativeNew or witness.source is not source or witness.cap is not cap
+            or witness.session_key != session_key or witness.predecessor_id != predecessor_id
+            or witness.message_id != source.message_id):
+        return
+    origin = _object(create_kwargs["origin_json"])
+    origin[_NATIVE_NEW] = {
+        "schema": "friday.x02.native-new.v1", "message_id": witness.message_id,
+        "update_id": witness.update_id, "predecessor_id": predecessor_id,
+        "successor_id": create_kwargs["session_id"], **_scope_record(cap),
+    }
+    create_kwargs["origin_json"] = json.dumps(origin)
+
+
+def _native_new_id(connection, successor, predecessor_id, cap):
+    origin = _object(successor["origin_json"])
+    proof = origin.get(_NATIVE_NEW)
+    if type(proof) is not dict:
+        raise AnchorUnavailable()
+    message_id, update_id = proof.get("message_id"), proof.get("update_id")
+    row = connection.execute(
+        "SELECT generation FROM conversation_generations WHERE source = ? AND session_key = ?",
+        (successor["source"], successor["session_key"]),
+    ).fetchone()
+    generation = proof.get("conversation_generation")
+    _need(row is not None and type(generation) is int and generation > 0 and generation == row["generation"]
+          and _valid_id(message_id) and _valid_id(update_id) and proof == {
+        "schema": "friday.x02.native-new.v1", "message_id": message_id, "update_id": update_id,
+        "predecessor_id": predecessor_id, "successor_id": successor["id"],
+        "conversation_generation": generation, **_scope_record(cap),
+    })
+    return message_id
+
+
+def _owned_db(store, cap):
+    path = cap.home / "state.db"
+    db = store._pinned_db()
+    if db is _DB_UNPINNED:
+        cache = store._db_handle_cache
+        if not cache.lock.acquire(blocking=False):
+            raise AnchorUnavailable()
+        try:
+            db = cache.handles.get(path)
+        finally:
+            cache.lock.release()
+    _need(type(db) is SessionDB and Path(db.db_path) == path and db._conn is not None
+          and db._db_file_identity is not None and not db._db_file_was_replaced())
+    return db
+
+
+def _accepted_pair(connection, predecessor, cap, reset_message_id, inbound):
+    sid = predecessor["id"]
+    rows = connection.execute(
+        _ACCEPTED_ROWS, (_MAX_METADATA, sid, _MAX_METADATA)
+    ).fetchall()
+    _need(len(rows) == 1)
+    summary = rows[0]
+    metadata = _object(summary["metadata"])
+    pair, custody = metadata.get(_SUMMARY), metadata.get(_CUSTODY)
+    _need(type(pair) is dict and type(custody) is dict)
+    upload_id = pair.get("upload_row_id")
+    upload_message_id, summary_message_id = pair.get("upload_message_id"), summary["platform_message_id"]
+    _need(type(upload_id) is int and 0 < upload_id < summary["id"]
+          and all(_valid_id(value) for value in (upload_message_id, summary_message_id, reset_message_id, inbound))
+          and int(upload_message_id) < int(summary_message_id) < int(reset_message_id) < int(inbound))
+    upload = connection.execute(_ROW_SQL, (_MAX_METADATA, sid, upload_id)).fetchone()
+    _need(upload is not None and upload["platform_message_id"] == upload_message_id
+          and all(type(row["message_uid"]) is str and row["message_uid"] for row in (upload, summary)))
+    for row_id, message_id in ((upload_id, upload_message_id), (summary["id"], summary_message_id)):
+        ids = connection.execute(_ID_ROWS, (sid, message_id)).fetchall()
+        _need([row["id"] for row in ids] == [row_id])
+
+    upload_metadata = _object(upload["metadata"])
+    name = upload_metadata[DIRECT_UPLOAD_KEY]["file"]["file_name"]
+    file = _file(tuple(upload), cap, name)
+    upload_sha = sha256(upload["metadata"].encode("utf-8")).hexdigest()
+    _need(name.lower().endswith(".zip") and pair == {
+        "schema": "friday.x02.accepted-summary.v1", "source_session_id": sid,
+        "upload_row_id": upload_id, "upload_uid": upload["message_uid"],
+        "upload_message_id": upload_message_id, "upload_metadata_sha256": upload_sha,
+        "archive_sha256": file["sha256"], "summary_message_id": summary_message_id,
+    })
+    identity = custody.get("archive_identity")
+    body_sha = custody.get("summary_text_sha256")
+    _need(type(identity) is list and len(identity) == 9 and all(type(value) is int for value in identity)
+          and summary["content_free"] == 1 and type(body_sha) is str and _SHA.fullmatch(body_sha)
+          and type(custody.get("archive_size_bytes")) is int and custody == {
+              "schema": "friday.x02.summary-custody.v1", **_scope_record(cap),
+              "archive_identity": identity, "archive_size_bytes": file["size_bytes"],
+              "summary_text_sha256": body_sha,
+          })
+    return upload_id, upload, upload_sha, summary, file, tuple(identity)
+
+
+def read_accepted_reset_original(adapter, source, successor_id, *, deadline):
+    """Return the CI witness for one exact pair under the owned successor turn."""
+    from gateway.x02_original_recall import _AcceptedOriginal, _read_session
+
+    try:
+        _need(type(deadline) in (int, float) and math.isfinite(deadline) and time.monotonic() < deadline)
+        cap, runner, _, _, check_origin = _ordinary_authority(adapter, source)
+        route = _route(source)
+        _need(route[:2] == ("telegram", cap.principal[3]) and source.chat_type == "dm"
+              and source.chat_id == source.user_id and not source.thread_id)
+        key, _ = source._friday_document_guard
+        mark = source._friday_document_turn
+        _need(source._friday_document_run[0] == mark[0] == key and type(mark[1]) is str and bool(mark[1]))
+        task = asyncio.current_task()
+        store = runner.session_store
+        ctx = SimpleNamespace(session_key=key, session_id=successor_id)
+        _need(task is not None)
+        db = _owned_db(store, cap)
+        db_identity = db._db_file_identity
+
+        def checkpoint(entry=None):
+            check_origin()
+            _need(runner.session_store is store and source._friday_document_session_id == successor_id
+                  and source._friday_document_turn is mark and adapter._session_tasks.get(key) is task
+                  and asyncio.current_task() is task and not task.cancelling()
+                  and _owned_db(store, cap) is db and db._db_file_identity == db_identity)
+            observed = _current_entry(store, ctx, cap, route)
+            _need((entry is None or observed is entry) and observed.active_turn_token == mark[1]
+                  and time.monotonic() < deadline)
+            return observed
+
+        entry = checkpoint()
+        stop = min(deadline, time.monotonic() + 0.25)
+        with _read_snapshot(db, stop, _snapshot_progress(stop)) as connection:
+            after = _read_session(connection, successor_id, cap, key, route)
+            predecessor_id = after["parent_session_id"]
+            _need(type(predecessor_id) is str and predecessor_id and predecessor_id != successor_id)
+            before = _read_session(connection, predecessor_id, cap, key, route)
+            reset_id = _native_new_id(connection, after, predecessor_id, cap)
+            started = connection.execute("SELECT started_at FROM sessions WHERE id = ?", (successor_id,)).fetchone()
+            _need(before["end_reason"] == "session_reset" and before["ended_at"] is not None
+                  and before["ended_at"] == started["started_at"]
+                  and after["ended_at"] is None and after["end_reason"] is None
+                  and _object(after["model_config"]).get("_reset_from") == predecessor_id)
+            upload_id, upload, upload_sha, summary, file, file_identity = _accepted_pair(
+                connection, before, cap, reset_id, source.message_id,
+            )
+        checkpoint(entry)
+        archive_path = str(cap.home / "workspace" / file["path"])
+        raw, relative, identity = workspace_document(archive_path, max_bytes=file["size_bytes"], with_identity=True)
+        _need(relative == file["path"] and len(raw) == file["size_bytes"]
+              and identity == file_identity and sha256(raw).hexdigest() == file["sha256"])
+        checkpoint(entry)
+        return _AcceptedOriginal(
+            cap.principal, cap.profile, cap.admission_generation, cap.directory_identity,
+            key, predecessor_id, successor_id, reset_id,
+            upload_id, upload["message_uid"], upload["platform_message_id"], upload_sha,
+            summary["id"], summary["message_uid"], summary["platform_message_id"],
+            sha256(summary["metadata"].encode("utf-8")).hexdigest(),
+            file["file_name"], file["sha256"], file["size_bytes"], file_identity,
+        )
+    except _ERRORS:
+        return None
