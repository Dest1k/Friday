+"""One encrypted source member for the protected X-02 follow-up.
+
+The native owner supplies a key under the admitted user scope. The caller may attach the
+envelope to the existing content-free accepted summary row in the same write.
+Only the authorized current native successor can open it.
+"""
+
+import asyncio
+from base64 import b64decode, urlsafe_b64encode
+from contextlib import suppress
+from hashlib import sha256
+import json
+import math
+import os
+import re
+from secrets import compare_digest, token_bytes
+from sqlite3 import Error as DatabaseError
+import stat
+import time
+
+from cryptography.exceptions import InvalidTag
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+from gateway.admitted_ingress import admitted_ingress
+from gateway.run_inbound_media import _file_identity, _owned
+from gateway.run_plugin_delivery import _ordinary_authority
+from gateway.upload_anchor import _MAX_METADATA, _object, _read_snapshot, _snapshot_progress
+from gateway.x02_reset_provider import _owned_db, _scope_record, _valid_id, read_accepted_reset_original
+from hermes_cli.friday_user_scope import current as current_scope
+from hermes_cli.home_data_layout import X02_QUOTE_KEY_DIRECTORY
+
+
+QUOTE_EVIDENCE_KEY = "friday_x02_quote_evidence"
+_SCHEMA = "friday.x02.quote-evidence.v2"
+_SUMMARY = "friday_x02_accepted_summary"
+_CUSTODY = "friday_x02_summary_custody"
+_SHA = re.compile(r"[0-9a-f]{64}")
+_MEMBER_LIMIT = 16 * 1024
+_PAYLOAD_LIMIT = 24 * 1024
+_KEY_FILE = "key.v1"
+_KEY_PREFIX = b"friday.x02.quote-key.v1\0"
+_KEY_BYTES = 32
+_KEY_DIGEST_BYTES = 32
+_ERRORS = (ArithmeticError, AttributeError, DatabaseError, InvalidTag, KeyError, OSError,
+           RuntimeError, TypeError, ValueError)
+_SUMMARY_CONTENT_FREE_SQL = """SELECT content IS NULL AS content_free
+    FROM messages WHERE session_id = ? AND id = ?"""
+
+
+class _QuoteEvidenceKey:
+    __slots__ = ("_cipher", "_binding")
+
+    def __init__(self, material, binding):
+        self._cipher = AESGCM(material)
+        self._binding = binding
+
+
+def _need(condition):
+    if not condition:
+        raise ValueError("x02_quote_evidence_unavailable")
+
+
+def _digest(value):
+    return type(value) is str and _SHA.fullmatch(value) is not None
+
+
+def _json(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False,
+                      allow_nan=False).encode("utf-8")
+
+
+def _key_binding(cap):
+    return sha256(_json({
+        **_scope_record(cap), "binding": cap.binding, "home": str(cap.home),
+        "authority_home": str(cap.authorization_home),
+    })).digest()
+
+
+def _check_key_file(fd, name, item, size):
+    info = os.fstat(item)
+    _owned(info)
+    _need(stat.S_IMODE(info.st_mode) == 0o600 and info.st_size == size)
+    named = os.stat(name, dir_fd=fd, follow_symlinks=False)
+    _need(_file_identity(info) == _file_identity(named))
+    return _file_identity(info)
+
+
+def _read_key_file(fd, prefix, check):
+    size = len(prefix) + _KEY_BYTES + _KEY_DIGEST_BYTES
+    item = os.open(_KEY_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
+    try:
+        before = _check_key_file(fd, _KEY_FILE, item, size)
+        with os.fdopen(item, "rb", closefd=False) as stream:
+            record = stream.read(size + 1)
+        check()
+        _need(before == _check_key_file(fd, _KEY_FILE, item, size) and len(record) == size)
+        payload, checksum = record[:-_KEY_DIGEST_BYTES], record[-_KEY_DIGEST_BYTES:]
+        _need(payload.startswith(prefix) and compare_digest(sha256(payload).digest(), checksum))
+        return payload[len(prefix):]
+    except FileNotFoundError:
+        # A key that disappeared during the read is never eligible for creation.
+        raise ValueError("x02_quote_key_drifted") from None
+    finally:
+        os.close(item)
+
+
+def _create_key_file(homefd, fd, prefix, check, current):
+    from hermes_cli.friday_workspace_revision import _move
+
+    staged = ".stage-" + token_bytes(16).hex()
+    item = os.open(staged, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
+    try:
+        key = AESGCM.generate_key(bit_length=256)
+        payload = prefix + key
+        record = payload + sha256(payload).digest()
+        with os.fdopen(item, "wb", closefd=False) as stream:
+            stream.write(record)
+            stream.flush()
+            os.fsync(item)
+        before = _check_key_file(fd, staged, item, len(record))
+        _need(current() is True)
+        check()
+        _need(before == _check_key_file(fd, staged, item, len(record)))
+        _move(fd, staged, fd, _KEY_FILE)
+        os.fsync(fd)
+        os.fsync(homefd)
+        _need(current() is True)
+        check()
+        expected = _check_key_file(fd, _KEY_FILE, item, len(record))
+        # Linux rename updates ctime. Pin the other attributes across the move.
+        _need(expected[:4] == before[:4] and expected[5:] == before[5:])
+        return key
+    finally:
+        try:
+            with suppress(FileNotFoundError):
+                named = os.stat(staged, dir_fd=fd, follow_symlinks=False)
+                held = os.fstat(item)
+                if (named.st_dev, named.st_ino) == (held.st_dev, held.st_ino):
+                    os.unlink(staged, dir_fd=fd)
+        finally:
+            os.close(item)
+
+
+def quote_evidence_key(cap, *, create=False, current=None):
+    """Read the active principal's key, or provision it from the original owner turn.
+
+    For create=True, current is the native original task/deadline/STOP predicate.
+    Call outside any SQLite writer lock. The reader is strictly read-only.
+    """
+    from hermes_cli.friday_skill_io import _directory
+
+    try:
+        _need(type(create) is bool and current_scope(required=True) is cap)
+        _need(not create or callable(current) and current() is True)
+        binding = _key_binding(cap)
+        prefix = _KEY_PREFIX + binding
+        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+        with _directory(cap.home) as (homefd, check_home):
+            try:
+                fd = os.open(X02_QUOTE_KEY_DIRECTORY, flags, dir_fd=homefd)
+            except FileNotFoundError:
+                if not create:
+                    return None
+                _need(current() is True)
+                check_home()
+                with suppress(FileExistsError):
+                    os.mkdir(X02_QUOTE_KEY_DIRECTORY, 0o700, dir_fd=homefd)
+                fd = os.open(X02_QUOTE_KEY_DIRECTORY, flags, dir_fd=homefd)
+            try:
+                def check():
+                    check_home()
+                    _need(current_scope(required=True) is cap and _key_binding(cap) == binding)
+                    directory = os.fstat(fd)
+                    _owned(directory, directory=True)
+                    named = os.stat(X02_QUOTE_KEY_DIRECTORY, dir_fd=homefd, follow_symlinks=False)
+                    _need(stat.S_IMODE(directory.st_mode) == 0o700
+                          and stat.S_ISDIR(named.st_mode)
+                          and (directory.st_dev, directory.st_ino) == (named.st_dev, named.st_ino))
+
+                check()
+                try:
+                    material = _read_key_file(fd, prefix, check)
+                except FileNotFoundError:
+                    if not create:
+                        return None
+                    _need(current() is True)
+                    material = _create_key_file(homefd, fd, prefix, check, current)
+                _need(not create or current() is True)
+                return _QuoteEvidenceKey(material, binding)
+            finally:
+                os.close(fd)
+    except _ERRORS:
+        return None
+
+
+def _binary(value, limit):
+    _need(type(value) is str and 0 < len(value) <= (limit + 2) // 3 * 4)
+    raw = b64decode(value, altchars=b"-_", validate=True)
+    _need(len(raw) <= limit and urlsafe_b64encode(raw).decode("ascii") == value)
+    return raw
+
+
+def _aad(key, link, custody, summary_uid):
+    return _json({"schema": _SCHEMA, "session_key": key, "accepted_summary": link,
+                  "custody": custody, "summary_uid": summary_uid})
+
+
+def _source_member(member):
+    from hermes_cli.friday_workspace_zip import _path
+
+    _need(type(member) is dict and set(member) == {"path", "sha256", "bytes", "text"})
+    path, text, size, expected = (member[name] for name in ("path", "text", "bytes", "sha256"))
+    _need(type(path) is str and _path(path) == path and type(text) is str
+          and 0 < len(text) <= _MEMBER_LIMIT and "\0" not in text
+          and type(size) is int and 0 < size <= _MEMBER_LIMIT and _digest(expected))
+    data = text.encode("utf-8")
+    if size == len(data) + 3:
+        data = b"\xef\xbb\xbf" + data
+    _need(len(data) == size and sha256(data).hexdigest() == expected)
+    return dict(member)
+
+
+def project_identity(project):
+    _need(type(project) is str and 0 < len(project) <= 80)
+    return " ".join(project.casefold().split())
+
+
+def _find_member(projection, member_path):
+    members = [row for row in projection["members"] if type(row) is dict and row.get("path") == member_path]
+    _need(len(members) == 1)
+    return _source_member(members[0])
+
+
+def open_quote_envelope(key, carrier, *, session_key, link, custody, summary_uid):
+    _need(type(key) is _QuoteEvidenceKey and type(carrier) is dict
+          and set(carrier) == {"schema", "nonce", "ciphertext"} and carrier["schema"] == _SCHEMA)
+    nonce = _binary(carrier["nonce"], 12)
+    ciphertext = _binary(carrier["ciphertext"], _PAYLOAD_LIMIT + 16)
+    _need(len(nonce) == 12 and len(ciphertext) > 16)
+    raw = key._cipher.decrypt(nonce, ciphertext, _aad(session_key, link, custody, summary_uid))
+    context = _object(raw.decode("utf-8"))
+    _need(set(context) == {"project", "member"} and project_identity(context["project"]) == context["project"])
+    return {"project": context["project"], "member": _source_member(context["member"])}
+
+
+def seal_quote_evidence(key, operation, projection, member_path, *, link, custody, summary_uid, current):
+    """Seal the one current source member selected by the original summary owner.
+
+    Call with the original native protected projection, after a genuine summary
+    ACK, with the durable UID reserved for the accepted summary row. Failure yields no envelope.
+    """
+    from gateway.ordinary_archive_issuer import _ReadOperation, operation_for_event
+    from hermes_cli.friday_protected_archive import EncryptedZipRead
+
+    try:
+        _need(type(key) is _QuoteEvidenceKey and type(operation) is _ReadOperation
+              and type(operation.approval) is EncryptedZipRead and callable(current)
+              and type(summary_uid) is str and 0 < len(summary_uid) <= 512)
+        cap, event = operation.cap, operation.selection.event
+        _need(key._binding == _key_binding(cap))
+        approval, form = operation.approval, operation._protected_input
+
+        def owned():
+            _need(current() is True and asyncio.current_task() is operation.task
+                  and current_scope(required=True) is cap
+                  and operation_for_event(event) is operation and operation._protected_input is form
+                  and form._read_running and form._read_accepted and form._launch_acknowledged
+                  and form.receipt == {"success": True, "effect_disposition": "none"}
+                  and time.monotonic() < operation.selection.deadline)
+
+        owned()
+        _need(type(projection) is dict and set(projection) == {"source", "source_sha256", "members"}
+              and projection["source"] == approval.source and projection["source_sha256"] == approval.source_sha256
+              and type(projection["members"]) is list and 0 < len(projection["members"]) <= 128
+              and type(member_path) is str)
+        _need(type(link) is dict and set(link) == {
+            "schema", "source_session_id", "upload_row_id", "upload_uid", "upload_message_id",
+            "upload_metadata_sha256", "archive_sha256", "summary_message_id",
+        } and link["schema"] == "friday.x02.accepted-summary.v1"
+            and link["source_session_id"] == operation.session_id
+            and link["archive_sha256"] == approval.source_sha256
+            and type(link["upload_row_id"]) is int and link["upload_row_id"] > 0
+            and type(link["upload_uid"]) is str and 0 < len(link["upload_uid"]) <= 512
+            and _digest(link["upload_metadata_sha256"])
+            and link["upload_message_id"] == approval.upload_message and _valid_id(link["upload_message_id"])
+            and _valid_id(link["summary_message_id"])
+            and int(link["upload_message_id"]) < int(link["summary_message_id"]))
+        body_sha = custody.get("summary_text_sha256")
+        _need(type(custody) is dict and _digest(body_sha) and custody == {
+            "schema": "friday.x02.summary-custody.v1", **_scope_record(cap),
+            "archive_identity": list(approval.file_identity),
+            "archive_size_bytes": operation.selection.caption.file_size,
+            "summary_text_sha256": body_sha,
+        })
+        data = _json({"project": project_identity(operation.selection.caption.project),
+                      "member": _find_member(projection, member_path)})
+        _need(len(data) <= _PAYLOAD_LIMIT)
+        nonce = token_bytes(12)
+        ciphertext = key._cipher.encrypt(nonce, data, _aad(operation.key, link, custody, summary_uid))
+        owned()
+        return {"schema": _SCHEMA, "nonce": urlsafe_b64encode(nonce).decode("ascii"),
+                "ciphertext": urlsafe_b64encode(ciphertext).decode("ascii")}
+    except _ERRORS:
+        return None
+
+
+def read_quote_evidence(key, adapter, event, successor_id, *, deadline, current):
+    """Open source context only in the authorized exact follow-up task."""
+    from gateway.x02_original_recall import _SUMMARY_SQL, _check_receipt
+
+    try:
+        _need(type(key) is _QuoteEvidenceKey and callable(current)
+              and type(deadline) in (int, float) and math.isfinite(deadline) and time.monotonic() < deadline
+              and current() is True)
+        source = event.source
+        cap, runner, _, _, check_origin = _ordinary_authority(adapter, source)
