+def _pax_path(name):
+    body = b' path=' + name.encode('utf-8') + b'\n'
+    length = len(body) + 1
+    while len(str(length)) + len(body) != length:
+        length = len(str(length)) + len(body)
+    return str(length).encode('ascii') + body
