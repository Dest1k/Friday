+def _ustar_name(name):
+    if not name.isascii():
+        return None
+    if len(name) <= 100:
+        return name, ''
+    for i in range(len(name)-1, -1, -1):
+        if name[i] == '/' and 0 < i <= 155 and 0 < len(name)-i-1 <= 100:
+            return name[i+1:], name[:i]
+    return None
+
