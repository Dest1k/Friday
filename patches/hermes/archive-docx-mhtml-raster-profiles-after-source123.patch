+def _role(package, owner, kind, target):
+    if kind in _ROLE_PROFILES:
+        expected_owner, mime, ns, tag = _ROLE_PROFILES[kind]
+        root = package.xml.get(target)
+        if owner != expected_owner or package.types[target] != mime or root is None or root.tag != _q(ns,tag):
+            _fail('unsupported_part_profile')
+    elif kind == R+'/customXml':
+        if owner != MAIN or package.types[target] != 'application/xml':
+            _fail('unsupported_part_profile')
+    elif kind == R+'/customXmlProps':
+        root = package.xml.get(target)
+        if (package.types.get(owner) != 'application/xml'
+                or package.types[target] != 'application/vnd.openxmlformats-officedocument.customXmlProperties+xml'
+                or root is None or root.tag != _q('http://schemas.openxmlformats.org/officeDocument/2006/customXml','datastoreItem')):
+            _fail('unsupported_part_profile')
+    elif kind == PKG+'/metadata/thumbnail':
+        if owner or package.types[target] not in ('image/png','image/jpeg'):
+            _fail('unsupported_part_profile')
+
