+def _inspect(data, checkpoint):
+    package = _Package(data, 'docx', checkpoint)
+    if package.active or package.macro: _fail('active_content')
+    _plain_profile_xml(package)
+    for name, mime in package.types.items():
+        if mime not in _PASSIVE_TYPES: _fail('unsupported_part_type')
+        if (mime == 'application/xml' or mime.endswith('+xml')) and name not in package.xml:
+            _fail('unsupported_xml_part_name')
+    for owner, rows in package.relationships.items():
+        for kind, target in rows.values():
+            if kind == IMAGE_REL:
+                if owner != MAIN or not target.startswith('word/media/'):
+                    _fail('unsupported_image_reference')
+            elif kind not in _GLOBAL_RELS:
+                _fail('unsupported_relationship')
+            else:
+                _role(package, owner, kind, target)
+    for name, root in package.xml.items():
+        for node in root.iter():
+            if node.tag in {_q(W,n) for n in ('fldChar','instrText','fldSimple','altChunk','object','control')}:
+                _fail('active_or_field_content')
+            if name != MAIN and any(_split(attr)[0] == R for attr in node.attrib):
+                _fail('unsupported_global_reference')
+    # Every package part must be reachable from the root relationship graph.
+    reached = {TYPES}
+    pending = ['']
+    while pending:
+        owner = pending.pop()
+        relname = '_rels/.rels' if not owner else posixpath.join(posixpath.dirname(owner), '_rels', posixpath.basename(owner)+'.rels')
+        if relname in package.parts: reached.add(relname)
+        for kind, target in package.relationships.get(owner, {}).values():
+            if target not in reached:
+                reached.add(target); pending.append(target)
+    if set(package.parts) != reached: _fail('unsupported_orphan_part')
+    embeds, ids = _main(package, checkpoint)
+    images = {rid:target for rid,(kind,target) in package.relationships.get(MAIN,{}).items() if kind == IMAGE_REL}
+    if set(embeds) != set(images): _fail('unsupported_image_reference')
+    for target in set(images.values()):
+        _tick(checkpoint)
+        _image(package.parts[target], package.types[target])
+    if any(name.startswith('word/media/') and name not in images.values() for name in package.parts):
+        _fail('unsupported_image_reference')
+    return package, images, ids
