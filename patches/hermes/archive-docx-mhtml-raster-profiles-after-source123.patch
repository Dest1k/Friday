+def merge(first: bytes, second: bytes, *, checkpoint=None) -> bytes:
+    """Merge two validated compatible DOCX byte packages into new DOCX bytes.
+
+    Input identity/path/CAS and atomic publication belong to the scoped caller.
+    Equal bytes in two distinct source files are allowed. Checkpoint exceptions
+    propagate unchanged so caller cancellation/stop handling remains authoritative.
+    """
+    try:
+        left, images1, ids1 = _inspect(first, checkpoint)
+        right, images2, ids2 = _inspect(second, checkpoint)
+        _compatible(left, right, images1, images2)
+        document = deepcopy(left.xml[MAIN])
+        body = document.find(_q(W,'body'))
+        section = body[-1]; body.remove(section)
+        rels = deepcopy(left.xml.get(RELS))
+        if rels is None: rels = ET.Element(_q(PKG,'Relationships'))
+        types = deepcopy(left.xml[TYPES])
+        occupied = {name.casefold() for name in left.parts}
+        rids = set(left.relationships.get(MAIN,{}))
+        added = {}
+        ridmap = {}
+        targetmap = {}
+        for index, (rid, target) in enumerate(images2.items(), 1):
+            _tick(checkpoint)
+            newrid = 'fridayMerge' + str(index)
+            while newrid in rids: newrid += '_'
+            rids.add(newrid); ridmap[rid] = newrid
+            if target not in targetmap:
+                extension = '.png' if right.types[target] == 'image/png' else '.jpeg'
+                newname = 'word/media/friday-merge-' + str(index) + extension
+                while newname.casefold() in occupied:
+                    newname = newname[:-len(extension)] + '_' + extension
