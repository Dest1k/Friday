+def _compatible(first, second, images1, images2):
+    selected = {MAIN, RELS, TYPES}
+    shared1 = {name:raw for name,raw in first.parts.items() if name not in selected and name not in images1.values()}
+    shared2 = {name:raw for name,raw in second.parts.items() if name not in selected and name not in images2.values()}
+    if shared1 != shared2 or any(first.types[n] != second.types[n] for n in shared1):
+        _fail('incompatible_shared_parts')
+    rel1 = {rid:row for rid,row in first.relationships.get(MAIN,{}).items() if row[0] != IMAGE_REL}
+    rel2 = {rid:row for rid,row in second.relationships.get(MAIN,{}).items() if row[0] != IMAGE_REL}
+    if rel1 != rel2: _fail('incompatible_document_relationships')
+    if ET.tostring(first.body[-1]) != ET.tostring(second.body[-1]):
+        _fail('incompatible_section_profile')
