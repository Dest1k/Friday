+def encode_tar(rows: list[tuple[str, bool, bytes]], format: str) -> bytes:
+    """Create deterministic inert USTAR/PAX and verify the complete round trip."""
+    format = normalize_format(format)
+    if format == 'tar.zst' and _zstd is None:
+        _fail('tar_codec_unavailable')
+    rows = _validate_rows(rows)
