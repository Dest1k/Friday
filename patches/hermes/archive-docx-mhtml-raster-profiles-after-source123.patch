+    except _CODEC_ERRORS:
+        _fail('tar_compression_invalid')
+    if len(encoded) > MAX_BYTES:
+        _fail('tar_size_limit')
+    if decode_tar(encoded, format) != rows:
+        _fail('tar_payload_invalid')
+    return encoded
