+"""Bounded local raster inspection and explicit single-frame transformations.
+
+No vision/OCR claim, network, file access, external codecs or metadata execution.
+Every input frame is decoded and accounted for before a derivative is returned.
+Only pixel modes losslessly representable as RGBA8 are accepted.
+Derivatives normalize EXIF orientation and intentionally contain pixels only.
+"""
+from io import BytesIO
+import hashlib
+import warnings
+
+MAX_BYTES = 1_000_000
+MAX_PIXELS = 16_000_000
+MAX_FRAMES = 32
+FORMATS = {'jpg': 'JPEG', 'jpeg': 'JPEG', 'png': 'PNG', 'tif': 'TIFF',
+           'tiff': 'TIFF', 'webp': 'WEBP', 'bmp': 'BMP', 'gif': 'GIF'}
+OUTPUTS = frozenset(FORMATS) - {'gif'}
+PIXEL_MODES = frozenset(('1', 'L', 'LA', 'P', 'PA', 'RGB', 'RGBA', 'RGBX'))
+
+
+class RasterError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def _fail(code):
+    raise RasterError(code) from None
+
+
+def _pillow():
+    try:
+        from PIL import Image, ImageOps
+    except ImportError:
+        _fail('image_codec_unavailable')
+    return Image, ImageOps
+
+
+def _validate(data, format):
+    if type(data) is not bytes or not 1 <= len(data) <= MAX_BYTES:
+        _fail('image_input_limit')
+    if type(format) is not str or format not in FORMATS:
+        _fail('image_format_unsupported')
+
+
+def _opened(data, format):
+    Image, _ = _pillow()
+    image = Image.open(BytesIO(data), formats=list(set(FORMATS.values())))
+    if image.format != FORMATS[format]:
+        image.close()
+        _fail('image_format_mismatch')
+    return image
+
+
+def _frames(data, format, selected=None):
+    Image, ImageOps = _pillow()
+    _validate(data, format)
+    with warnings.catch_warnings():
+        warnings.simplefilter('error', Image.DecompressionBombWarning)
+        with _opened(data, format) as initial:
+            initial.verify()
+        with _opened(data, format) as image:
+            count = getattr(image, 'n_frames', 1)
+            if type(count) is not int or not 1 <= count <= MAX_FRAMES:
+                _fail('image_frame_limit')
+            if selected is not None and (type(selected) is not int or not 1 <= selected <= count):
+                _fail('image_frame_invalid')
+            total = 0
+            rows = []
+            chosen = None
+            for i in range(count):
+                image.seek(i)
+                width, height = image.size
+                # Pillow exposes oriented TIFF geometry before load(), unlike
+                # JPEG/PNG. Keep physical IFD dimensions distinct from pixels.
+                if image.format == 'TIFF':
+                    width = image.tag_v2.get(256)
+                    height = image.tag_v2.get(257)
+                    bits = image.tag_v2.get(258, (1,))
+                    bits = bits if isinstance(bits, tuple) else (bits,)
+                    if any(type(v) is not int or not 1 <= v <= 8 for v in bits):
+                        _fail('image_pixel_mode_unsupported')
+                # RGB 16-bit PNG is reduced to RGB8 by Pillow before exposing
+                # mode. Refuse that reduction as well as high-precision modes.
+                if (image.mode not in PIXEL_MODES
+                        or image.format == 'PNG' and data[24] > 8):
+                    _fail('image_pixel_mode_unsupported')
+                if type(width) is not int or type(height) is not int:
+                    _fail('image_pixel_limit')
+                total += width * height
+                if width < 1 or height < 1 or total > MAX_PIXELS:
+                    _fail('image_pixel_limit')
+                orientation = image.getexif().get(274, 1)
+                if type(orientation) is not int or orientation not in range(1, 9):
+                    _fail('image_orientation_unsupported')
+                image.load()
+                if image.mode not in PIXEL_MODES:
+                    _fail('image_pixel_mode_unsupported')
+                normalized = ImageOps.exif_transpose(image).convert('RGBA')
+                pixels = normalized.tobytes()
+                rows.append(dict(frame=i + 1, width=normalized.width, height=normalized.height,
+                    stored_width=width, stored_height=height, orientation=orientation,
+                    pixel_sha256=hashlib.sha256(pixels).hexdigest()))
+                if selected == i + 1:
+                    chosen = normalized.copy()
+                normalized.close()
+            return rows, chosen
+
+
+def inspect_raster(data, format):
+    try:
+        rows, _ = _frames(data, format)
+        return dict(format=format, frames=rows, total_frames=len(rows),
+            source_sha256=hashlib.sha256(data).hexdigest(),
+            coverage='all_decoded_frame_geometry_and_pixels_only',
+            vision_performed=False, ocr_performed=False, orientation_normalized=True)
+    except RasterError:
+        raise
+    except Exception:
+        _fail('image_decode_failed')
+
+
+def transform_raster(data, input_format, output_format, *, frame, rotation=0, crop=None):
+    """Return one explicitly selected oriented frame, with optional crop/rotation."""
+    _validate(data, input_format)
+    if output_format not in OUTPUTS:
+        _fail('image_output_format_unsupported')
+    if type(rotation) is not int or rotation not in (0, 90, 180, 270):
+        _fail('image_rotation_invalid')
+    image = None
+    try:
+        rows, image = _frames(data, input_format, selected=frame)
+        if crop is not None:
+            if (type(crop) is not list or len(crop) != 4
+                    or any(type(v) is not int for v in crop)):
+                _fail('image_crop_invalid')
+            left, top, right, bottom = crop
+            if not (0 <= left < right <= image.width and 0 <= top < bottom <= image.height):
+                _fail('image_crop_invalid')
+            changed = image.crop((left, top, right, bottom))
+            image.close()
+            image = changed
+        if rotation:
+            # User-facing rotation is clockwise in degrees, without interpolation.
+            Image, _ = _pillow()
+            method = {90: Image.Transpose.ROTATE_270, 180: Image.Transpose.ROTATE_180,
+                      270: Image.Transpose.ROTATE_90}[rotation]
+            changed = image.transpose(method)
+            image.close()
+            image = changed
+        target = FORMATS[output_format]
+        if target in ('JPEG', 'BMP'):
+            if image.getextrema()[3] != (255, 255):
+                _fail('image_alpha_not_supported')
+            changed = image.convert('RGB')
+            image.close()
+            image = changed
+        # Copy only pixels: no active/original EXIF, ICC, text, or location metadata.
+        Image, _ = _pillow()
+        clean = Image.frombytes(image.mode, image.size, image.tobytes())
+        try:
+            output = BytesIO()
+            options = {'lossless': True, 'exact': True} if target == 'WEBP' else {}
+            if target == 'JPEG':
+                options = {'quality': 95, 'subsampling': 0}
+            clean.save(output, format=target, **options)
+            encoded = output.getvalue()
+            if len(encoded) > MAX_BYTES:
+                _fail('image_output_limit')
+            check = inspect_raster(encoded, output_format)
+            if check['total_frames'] != 1 or (check['frames'][0]['width'], check['frames'][0]['height']) != clean.size:
+                _fail('image_output_verification_failed')
+            expected = hashlib.sha256(clean.convert('RGBA').tobytes()).hexdigest()
+            lossy = target == 'JPEG'
+            if not lossy and check['frames'][0]['pixel_sha256'] != expected:
+                _fail('image_output_verification_failed')
+            return encoded, dict(input_frames=rows, selected_frame=frame,
+                rotation_clockwise=rotation, crop=crop, output=check,
+                pixel_lossy=lossy, metadata_preserved=False,
+                metadata_policy='pixels_only; EXIF_orientation_applied; other_metadata_omitted')
+        finally:
+            clean.close()
+    except RasterError:
+        raise
+    except Exception:
+        _fail('image_transform_failed')
+    finally:
+        if image is not None:
+            image.close()
