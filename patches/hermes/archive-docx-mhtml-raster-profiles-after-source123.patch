+        if local != 't' and (node.text or '').strip(): _fail('unsupported_body_text')
+        if (node.tail or '').strip(): _fail('unsupported_body_text')
+    style_kinds = {R+'/styles', 'http://schemas.microsoft.com/office/2007/relationships/stylesWithEffects'}
+    style_parts = {}
+    for kind,target in package.relationships.get(MAIN,{}).values():
+        if kind in style_kinds:
+            if kind in style_parts: _fail('unsupported_style_profile')
+            style_parts[kind] = target
+    if not style_parts:
+        _style_numbering(None, used)
+    for target in style_parts.values():
+        styles = package.xml.get(target)
+        if styles is None or styles.tag != _q(W,'styles'):
+            _fail('unsupported_style_profile')
