+"""Bounded, deterministic native single-file compression; bytes in, bytes out.
+
+One complete gzip, bzip2, XZ or Zstandard stream is accepted. The shared TAR
+decoder supplies strict EOF/trailing-data checks and bounded codec memory.
+No paths, archive members, filesystem access, subprocesses or external codecs.
+"""
+from __future__ import annotations
+
+import bz2
+import gzip
+import lzma
+import zlib
+
+from tools.scoped_tar import TarError, decompress_stream
+
+try:
+    from compression import zstd as _zstd
+except ImportError:
+    _zstd = None
+
+MAX_BYTES = 1_000_000
+FORMATS = frozenset({'gzip', 'bzip2', 'xz', 'zstd'})
+ALIASES = {'gz': 'gzip', 'bz2': 'bzip2', 'zst': 'zstd'}
+CODES = frozenset({
+    'stream_format_unsupported', 'stream_codec_unavailable',
+    'stream_input_invalid', 'stream_size_limit', 'stream_compression_invalid',
+})
+_CODEC_ERRORS = (ValueError, OSError, EOFError, zlib.error, lzma.LZMAError) + (
+    (_zstd.ZstdError,) if _zstd is not None else ())
+_TAR_ERROR_CODES = {
+    'tar_format_unsupported': 'stream_format_unsupported',
+    'tar_codec_unavailable': 'stream_codec_unavailable',
+    'tar_input_invalid': 'stream_input_invalid',
+    'tar_size_limit': 'stream_size_limit',
+    'tar_compression_invalid': 'stream_compression_invalid',
+}
+
+
+class StreamError(ValueError):
+    """A fixed safe code without input content or codec exception details."""
+
+    def __init__(self, code):
+        self.code = code if type(code) is str and code in CODES else 'stream_input_invalid'
+        super().__init__(self.code)
+
+
+def _fail(code):
+    raise StreamError(code) from None
+
+
+def normalize_format(format: str) -> str:
+    if type(format) is not str:
+        _fail('stream_format_unsupported')
+    format = ALIASES.get(format.lower(), format.lower())
+    if format not in FORMATS:
+        _fail('stream_format_unsupported')
+    return format
+
+
+def _validate(data: bytes, format: str) -> str:
+    format = normalize_format(format)
+    if type(data) is not bytes:
+        _fail('stream_input_invalid')
+    if len(data) > MAX_BYTES:
+        _fail('stream_size_limit')
+    if format == 'zstd' and _zstd is None:
+        _fail('stream_codec_unavailable')
+    return format
+
+
+def encode_stream(data: bytes, format: str) -> bytes:
+    """Encode at most 1 MB; refuse encoded output larger than 1 MB.
+
+    Gzip has zero mtime and no filename. Other codecs contain no timestamps;
+    Zstandard uses one thread and includes content size and a checksum.
+    """
+    format = _validate(data, format)
+    try:
+        if format == 'gzip':
+            encoded = gzip.compress(data, compresslevel=9, mtime=0)
+        elif format == 'bzip2':
+            encoded = bz2.compress(data, compresslevel=9)
+        elif format == 'xz':
+            encoded = lzma.compress(data, format=lzma.FORMAT_XZ,
+                                    check=lzma.CHECK_CRC64, preset=6)
+        else:
+            encoded = _zstd.compress(data, options={
+                _zstd.CompressionParameter.compression_level: 3,
+                _zstd.CompressionParameter.nb_workers: 0,
+                _zstd.CompressionParameter.content_size_flag: 1,
+                _zstd.CompressionParameter.checksum_flag: 1,
+            })
+    except _CODEC_ERRORS:
+        _fail('stream_compression_invalid')
+    if len(encoded) > MAX_BYTES:
+        _fail('stream_size_limit')
+    return encoded
+
+
+def decode_stream(data: bytes, format: str) -> bytes:
+    """Decode exactly one stream to at most 1 MB, refusing trailing bytes.
+
+    The shared decoder's temporary output is bounded at 2 MB, XZ codec memory
+    at 64 MiB and Zstandard history at 8 MiB. No partially decoded bytes escape.
+    """
+    format = _validate(data, format)
+    try:
+        decoded = decompress_stream(data, 'bz2' if format == 'bzip2' else format)
+    except TarError as exc:
+        _fail(_TAR_ERROR_CODES.get(exc.code, 'stream_compression_invalid'))
+    if len(decoded) > MAX_BYTES:
+        _fail('stream_size_limit')
+    return decoded
