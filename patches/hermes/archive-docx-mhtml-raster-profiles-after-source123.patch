+def _plain_profile_xml(package):
+    for name in [TYPES] + [n for n in package.xml if n.endswith('.rels')]:
+        root = package.xml.get(name)
+        if root is None:
+            continue
+        if b'<!--' in package.parts[name]:
+            _fail('unsupported_profile_markup')
+        expected = CT if name == TYPES else PKG
+        if root.attrib or (root.text or '').strip():
+            _fail('unsupported_profile_markup')
+        for node in root:
+            ns, local = _split(node.tag)
+            allowed = ({'Default': {'Extension', 'ContentType'}, 'Override': {'PartName', 'ContentType'}}
+                       if name == TYPES else {'Relationship': {'Id', 'Type', 'Target', 'TargetMode'}})
+            if (ns != expected or local not in allowed or set(node.attrib) - allowed[local]
+                    or len(node) or (node.text or '').strip() or (node.tail or '').strip()):
+                _fail('unsupported_profile_markup')
