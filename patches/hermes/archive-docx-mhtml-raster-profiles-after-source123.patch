+def _main(package, checkpoint):
+    root = package.xml[MAIN]
+    if b'<!--' in package.parts[MAIN]:
+        _fail('unsupported_document_markup')
+    if root.attrib or len(root) != 1 or root[0] is not package.body:
+        _fail('unsupported_document_markup')
+    body = package.body
+    if body.attrib or not len(body) or body[-1].tag != _q(W, 'sectPr'):
+        _fail('unsupported_section_profile')
+    if sum(n.tag == _q(W, 'sectPr') for n in root.iter()) != 1:
+        _fail('unsupported_section_profile')
+    if any(n.tag not in {_q(W,'p'), _q(W,'tbl'), _q(W,'sectPr')} for n in body):
+        _fail('unsupported_body_content')
+    used = {}
+    embeds = []
+    ids = set()
+    for count, node in enumerate(root.iter()):
+        if count % 128 == 0: _tick(checkpoint)
+        ns, local = _split(node.tag)
+        if ns == W:
+            if local == 'numPr': _fail('unsupported_numbering_use')
+            if local not in _W_TAGS: _fail('unsupported_body_markup')
+            if local in ('pStyle', 'rStyle', 'tblStyle'):
+                kind = {'pStyle':'paragraph', 'rStyle':'character', 'tblStyle':'table'}[local]
+                used.setdefault(node.get(_q(W, 'val'), ''), set()).add(kind)
+            for attr in node.attrib:
+                ans, name = _split(attr)
+                if ans == XML and name == 'space' and local == 't' and node.get(attr) in ('preserve','default'):
+                    continue
+                if ans != W or name not in _W_ATTRS: _fail('unsupported_body_attribute')
+            children = list(node)
+            names = [n.tag for n in children]
+            if local == 'p' and (any(t not in {_q(W,'pPr'), _q(W,'r')} for t in names)
+                    or names.count(_q(W,'pPr')) > 1 or (_q(W,'pPr') in names and names[0] != _q(W,'pPr'))):
+                _fail('unsupported_paragraph_content')
+            if local == 'r' and (any(t not in {_q(W,n) for n in ('rPr','t','tab','br','cr','noBreakHyphen','softHyphen','drawing')} for t in names)
+                    or names.count(_q(W,'rPr')) > 1 or (_q(W,'rPr') in names and names[0] != _q(W,'rPr'))):
+                _fail('unsupported_run_content')
+            if local == 'drawing' and names != [_q(WP,'inline')]: _fail('unsupported_drawing')
+            if local in ('tbl', 'tr', 'tc'):
+                prop = {'tbl':'tblPr', 'tr':'trPr', 'tc':'tcPr'}[local]
+                allowed = {'tbl': {'tblPr','tblGrid','tr'}, 'tr':{'trPr','tc'}, 'tc':{'tcPr','p','tbl'}}[local]
+                if any(_split(t)[0] != W or _split(t)[1] not in allowed for t in names):
+                    _fail('unsupported_table_content')
+                if names.count(_q(W,prop)) > 1 or (_q(W,prop) in names and names[0] != _q(W,prop)):
+                    _fail('unsupported_table_content')
+                if local == 'tbl' and (not any(t == _q(W,'tr') for t in names)
+                        or names.count(_q(W,'tblGrid')) > 1
+                        or (_q(W,'tblGrid') in names and names.index(_q(W,'tblGrid')) > names.index(_q(W,'tr')))):
+                    _fail('unsupported_table_content')
+                if local == 'tr' and not any(t == _q(W,'tc') for t in names): _fail('unsupported_table_content')
+                if local == 'tc' and (not names or names[-1] != _q(W,'p')): _fail('unsupported_table_content')
+            structural = {'document','body','p','r','tbl','tr','tc','drawing'}
+            if local not in structural:
+                allowed = _W_CHILDREN.get(local, set())
+                if any(_split(t)[0] != W or _split(t)[1] not in allowed for t in names):
+                    _fail('unsupported_property_content')
+            if local == 't' and children: _fail('unsupported_body_markup')
+            if local in ('t','tab','br','cr','noBreakHyphen','softHyphen') and local != 't' and children:
+                _fail('unsupported_run_content')
+        elif (ns, local) in _DRAW_ATTRS:
+            for attr in node.attrib:
+                ans, name = _split(attr)
+                if (ns,local) == (A,'blip') and attr == _q(R,'embed'): continue
+                if ans or name not in _DRAW_ATTRS[(ns,local)]: _fail('unsupported_drawing_attribute')
+            expected = _DRAW_CHILDREN.get((ns,local), [])
+            actual = [_split(n.tag) for n in node]
+            if (any(t not in expected for t in actual) or len(actual) != len(set(actual))
+                    or [expected.index(t) for t in actual] != sorted(expected.index(t) for t in actual)):
+                _fail('unsupported_drawing')
+            required = {
+                (WP,'inline'): {(WP,'extent'), (WP,'docPr'), (A,'graphic')},
+                (A,'graphic'): {(A,'graphicData')}, (A,'graphicData'): {(PIC,'pic')},
+                (PIC,'pic'): {(PIC,'nvPicPr'), (PIC,'blipFill'), (PIC,'spPr')},
+                (PIC,'nvPicPr'): {(PIC,'cNvPr'), (PIC,'cNvPicPr')},
+                (PIC,'blipFill'): {(A,'blip'), (A,'stretch')},
+                (A,'stretch'): {(A,'fillRect')},
+            }.get((ns,local), set())
+            if not required <= set(actual): _fail('unsupported_drawing')
+            if (ns,local) == (A,'graphicData') and node.get('uri') != PIC: _fail('unsupported_drawing')
+            if (ns,local) == (A,'prstGeom') and node.get('prst') != 'rect': _fail('unsupported_drawing')
+            if (ns,local) == (A,'blip'):
+                rid = node.get(_q(R,'embed'))
+                if not rid: _fail('unsupported_image_reference')
+                embeds.append(rid)
+            if (ns,local) in ((WP,'docPr'), (PIC,'cNvPr')):
+                value = node.get('id','')
+                if not re.fullmatch(r'[0-9]{1,10}', value) or int(value) > 2**31-1:
+                    _fail('unsupported_picture_id')
+                if ns == WP:
