+def _image(raw, mime):
+    """Structural signature check without image decoders or unbounded inflate."""
+    if mime == 'image/png':
+        if not raw.startswith(b'\x89PNG\r\n\x1a\n'):
+            _fail('invalid_image')
+        offset = 8
+        kinds = []
+        compressed = []
+        decoded_size = row_size = height = None
+        while offset < len(raw):
+            if offset + 12 > len(raw): _fail('invalid_image')
+            size = int.from_bytes(raw[offset:offset+4], 'big')
+            kind = raw[offset+4:offset+8]
+            end = offset + 12 + size
+            if end > len(raw) or not re.fullmatch(b'[A-Za-z]{4}', kind): _fail('invalid_image')
+            payload = raw[offset+8:offset+8+size]
+            if zlib.crc32(kind + payload) & 0xffffffff != int.from_bytes(raw[end-4:end], 'big'):
+                _fail('invalid_image')
+            if kind == b'IHDR':
+                if kinds or size != 13: _fail('invalid_image')
+                width, height, depth, color, compression, filtering, interlace = struct.unpack('>IIBBBBB', payload)
+                depths = {0:{1,2,4,8,16}, 2:{8,16}, 3:{1,2,4,8}, 4:{8,16}, 6:{8,16}}
+                if (not 1 <= width <= 8192 or not 1 <= height <= 8192
+                        or width * height > 4_194_304 or depth not in depths.get(color, set())
+                        or compression or filtering or interlace != 0):
+                    _fail('unsupported_image')
+                channels = {0:1, 2:3, 3:1, 4:2, 6:4}[color]
+                row_size = (width * channels * depth + 7) // 8 + 1
+                decoded_size = height * row_size
+            elif kind == b'IEND':
+                if size or end != len(raw) or b'IDAT' not in kinds: _fail('invalid_image')
+            elif kind == b'IDAT':
+                if not kinds or (b'IDAT' in kinds and kinds[-1] != b'IDAT'):
+                    _fail('invalid_image')
+                compressed.append(payload)
+            elif kind == b'PLTE':
+                if b'PLTE' in kinds or b'IDAT' in kinds or not 3 <= size <= 768 or size % 3:
+                    _fail('invalid_image')
+            elif kind[0] < 97 and kind not in (b'PLTE', b'IDAT'):
+                _fail('unsupported_image')
+            kinds.append(kind)
+            offset = end
+        if not kinds or kinds[0] != b'IHDR' or kinds[-1] != b'IEND': _fail('invalid_image')
+        if color == 3 and b'PLTE' not in kinds: _fail('invalid_image')
+        try:
+            decoder = zlib.decompressobj()
+            decoded = decoder.decompress(b''.join(compressed), decoded_size + 1)
+        except zlib.error:
+            _fail('invalid_image')
+        if (len(decoded) != decoded_size or not decoder.eof or decoder.unused_data
+                or decoder.unconsumed_tail or any(decoded[n*row_size] > 4 for n in range(height))):
+            _fail('invalid_image')
+    elif mime == 'image/jpeg':
+        # Word's checked-in native template JPEG has one NUL padding byte.
+        # Retain the source bytes, allowing only bounded zero padding after EOI.
+        unpadded = raw.rstrip(b'\x00')
+        if len(raw) - len(unpadded) > 16: _fail('invalid_image')
+        raw = unpadded
+        if not raw.startswith(b'\xff\xd8') or not raw.endswith(b'\xff\xd9'):
+            _fail('invalid_image')
+        # Markers before the first scan prove the native JPEG framing/dimensions.
+        offset = 2
+        found = False
+        while offset < len(raw) - 2:
+            if raw[offset] != 255: _fail('invalid_image')
+            while offset < len(raw) and raw[offset] == 255: offset += 1
+            if offset >= len(raw): _fail('invalid_image')
+            marker = raw[offset]; offset += 1
+            if marker in (0, 0xD8, 0xD9) or 0xD0 <= marker <= 0xD7: _fail('invalid_image')
+            if offset + 2 > len(raw): _fail('invalid_image')
+            size = int.from_bytes(raw[offset:offset+2], 'big')
+            if size < 2 or offset + size > len(raw): _fail('invalid_image')
+            if marker in (0xC0, 0xC1, 0xC2):
+                if size < 8: _fail('invalid_image')
+                height = int.from_bytes(raw[offset+3:offset+5], 'big')
+                width = int.from_bytes(raw[offset+5:offset+7], 'big')
+                if not 1 <= width <= 8192 or not 1 <= height <= 8192 or width*height > 16_777_216:
+                    _fail('unsupported_image')
+                found = True
+            if marker == 0xDA:
+                if not found or offset + size >= len(raw) - 2: _fail('invalid_image')
+                break
+            offset += size
+        else:
+            _fail('invalid_image')
+    else:
+        _fail('unsupported_image')
+
