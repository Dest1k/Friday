+"""Owner-private D13 settlement from the exact running Telegram acquisition."""
+
+import asyncio
+from contextlib import ExitStack, contextmanager
+from contextvars import copy_context
+from enum import Enum
+from functools import partial
+from hashlib import sha256
+import json
+import math
+import os
+from pathlib import Path
+import stat
+from threading import Event
+import time
+from uuid import uuid4
+
+from gateway.d02_receiver_control import (
+    _encode, _hex, _kernel, _private_bytes, _unique, _work_identity, _write_private,
+)
+
+_INTENT = "friday.telegram.d13-stop-intent.v1"
+_RECORD = "friday.telegram.d13-writer-settlement.v1"
+_READY = "friday.telegram.d13-writer-settlement-ready.v1"
+_MAX_FILE = 1024 * 1024
+_HOLD_FIELD = "external_word_hold_update_ids"
+_SOURCE_ROLES = (
+    "hermes_cli/friday_ordinary_gateway.py",
+    "plugins/platforms/telegram/adapter.py",
+    "plugins/platforms/telegram/d13_writer_settlement.py",
+    "plugins/platforms/telegram/receipt_writer_lease.py",
+    "plugins/platforms/telegram/update_admission.py",
+)
+_RETIRING = set()
+
+
+class SettlementRetiring(RuntimeError):
+    """An owner-directed retirement already fences this receiving bot."""
+
+
+class WriterSettlementResult(Enum):
+    NO_INTENT = "no_intent"
+    PROVISIONAL = "provisional"
+    UNPROVED = "unproved"
+    CANCELLED = "cancelled"
+
+
+def _require(condition):
+    if not condition:
+        raise ValueError("d13_writer_settlement_unproved")
+
+
+def _identity(item):
+    return {field: getattr(item, "st_" + field) for field in
+            ("dev", "ino", "mode", "uid", "nlink", "size", "mtime_ns", "ctime_ns")}
+
+
+def _descriptor(path, fd):
+    _require(fd is not None and path.resolve(strict=True) == path)
+    opened = os.fstat(fd)
+    _require(stat.S_ISREG(opened.st_mode) and opened.st_uid == os.getuid()
+             and opened.st_nlink == 1 and stat.S_IMODE(opened.st_mode) == 0o600
+             and _identity(opened) == _identity(path.lstat()))
+    return _identity(opened)
+
+
+def _deployment(home):
+    # The ordinary native startup already proves the complete source inventory.
+    # Recheck the authority and executable roles used by this acquisition.
+    from hermes_cli.friday_dashboard_owner import read_owned
+
+    def digest(path, limit):
+        return sha256(_private_bytes(path, read_owned, limit)).hexdigest()
+
+    raw = _private_bytes(home / "FRIDAY-INSTALL.json", read_owned, _MAX_FILE)
+    marker = json.loads(raw, object_pairs_hook=_unique)
+    receipt_path = home / "hermes-agent.source.json"
+    receipt = _private_bytes(receipt_path, read_owned, 8 * _MAX_FILE)
+    pin = sha256(receipt).hexdigest()
+    phase = marker["ordinary_gateway"]
+    _require(marker["home"] == str(home) and marker["source"] == str(home / "hermes-agent")
+             and marker["source_receipt_sha256"] == phase["source_receipt_sha256"] == pin)
+    rows = json.loads(receipt, object_pairs_hook=_unique)["files"]
+    roles = {}
+    for role in _SOURCE_ROLES:
+        data = read_owned(home / "hermes-agent" / role)
+        roles[role] = sha256(data).hexdigest()
+        _require(roles[role] == rows[role]["sha256"] and len(data) == rows[role]["bytes"])
+
+    raw_profile = _private_bytes(home / "FRIDAY-PROFILE.json", read_owned, _MAX_FILE)
+    profile_pin = sha256(raw_profile).hexdigest()
+    _require(profile_pin == phase["profile_sha256"])
+    profile = json.loads(raw_profile, object_pairs_hook=_unique)["profile"]
+    _require(type(profile) is str and bool(profile))
+    credentials = (home / ".env").lstat()
+    _require(stat.S_ISREG(credentials.st_mode) and credentials.st_uid == os.getuid()
+             and credentials.st_nlink == 1 and not credentials.st_mode & 0o077)
+    return {
+        "authorization_home": str(home), "transport_profile": profile,
+        "source_receipt_sha256": pin, "source_roles": roles, "marker_sha256": sha256(raw).hexdigest(),
+        "profile_sha256": profile_pin, "configuration_sha256": digest(home / "config.yaml", _MAX_FILE),
+        "credential_identity": _identity(credentials),
+    }
+
+
+def _invocation():
+    from hermes_cli.friday_ordinary_gateway import receiver_invocation
+
+    invocation = receiver_invocation()
+    if invocation is None:
+        return None
+    kernel = _kernel(os.getpid())
+    _require(invocation["pid"] == kernel["pid"] and invocation["birth_ticks"] == kernel["start_time"]
+             and invocation["boot_id"] == kernel["boot_id"]
+             and Path("/proc/self/cgroup").read_text().splitlines() == ["0::" + invocation["cgroup"]])
+    return invocation
+
+
+def bind(lease):
+    from agent.secret_scope import current_secret_scope, current_secret_scope_home
+    from gateway.config import PLATFORM_TOKEN_ENV_NAMES, Platform
+    from hermes_cli.friday_credential_admission import CredentialDenied, owned_values
+    from hermes_cli.friday_dashboard_owner import SOURCE
+
+    home = lease.receipt_path.parent
+    if home != SOURCE.parent:
+        return None
+    scope = (home, lease.bot_id)
+    if scope in _RETIRING:
+        raise SettlementRetiring("d13_owner_stop_already_settled")
+    try:
+        invocation = _invocation()
+        if invocation is None:
+            return None
+        deployment = _deployment(home)
+        token_name = PLATFORM_TOKEN_ENV_NAMES[Platform.TELEGRAM]
+        token = lease.adapter.config.token
+        _require(current_secret_scope_home() == str(home)
+                 and (current_secret_scope() or {}).get(token_name) == token
+                 and owned_values(home).get(token_name) == token
+                 and _identity((home / ".env").lstat()) == deployment["credential_identity"])
+        return WriterSettlement(home, scope, invocation, deployment)
+    except (OSError, ValueError, TypeError, KeyError, CredentialDenied):
+        # The forward holding gate remains active. An unbound acquisition
+        # cannot produce an owner handoff.
+        return None
+
+
+def _intent(work, *, missing_ok=False):
+    from hermes_cli.friday_dashboard_owner import read_owned
+
+    path = work / "stop-intent.json"
+    if missing_ok:
+        _require(work.resolve() == work)
+        try:
+            directory = work.lstat()
+        except FileNotFoundError:
+            return None
+        _require(stat.S_ISDIR(directory.st_mode) and directory.st_uid == os.getuid()
+                 and stat.S_IMODE(directory.st_mode) == 0o700)
+        try:
+            path.lstat()
+        except FileNotFoundError:
+            return None
+    raw = _private_bytes(path, read_owned, 65536)
+    value = json.loads(raw, object_pairs_hook=_unique)
+    _require(type(value) is dict and raw == _encode(value)
+             and set(value) == {"schema", "nonce", "invocation", "deployment", "bot_id",
+                                "issued_monotonic_ns", "deadline_monotonic_ns"}
+             and value["schema"] == _INTENT and _hex(value["nonce"], 32))
+    return value, sha256(raw).hexdigest()
+
+
+def written_receipt_identity(path):
+    """Pin the file created by the actual native receipt executor."""
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
+    try:
+        return _descriptor(path, fd)
+    finally:
+        os.close(fd)
+
+
+@contextmanager
+def _read_receipt(path, expected, written):
+    # The producer supports the forward transition with at least one proved
+    # hold. Missing, unknown or empty prior state has no implicit enrollment.
+    from .update_admission import RECEIPT_TTL_SECONDS
+
+    cutoff = time.time() - RECEIPT_TTL_SECONDS
+    _require(bool(expected) and all(type(stamp) is float and math.isfinite(stamp) and stamp > cutoff
+                                   for stamp in expected.values()))
+    parent = path.parent
+    _require(parent.resolve(strict=True) == parent)
+    directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    try:
+        parent_id = _work_identity(os.fstat(directory))
+        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
+        try:
+            identity = _descriptor(path, fd)
+            _require(identity == written and 0 < identity["size"] <= _MAX_FILE)
+            with os.fdopen(fd, "rb", closefd=False) as stream:
+                raw = stream.read(identity["size"] + 1)
+            rows = json.loads(raw, object_pairs_hook=_unique)
+            _require(type(rows) is dict and set(rows) == {"update_ids", _HOLD_FIELD}
+                     and type(rows["update_ids"]) is dict and type(rows[_HOLD_FIELD]) is dict
+                     and rows[_HOLD_FIELD] == expected
+                     and all(uid.isascii() and uid.isdecimal() and type(stamp) is float
+                             for uid, stamp in rows[_HOLD_FIELD].items()))
+            os.fsync(fd)
+            os.fsync(directory)
+            _require(len(raw) == identity["size"] and _descriptor(path, fd) == identity
+                     and _work_identity(parent.lstat()) == parent_id)
+            yield {"path": str(path), "identity": identity, "parent": parent_id,
+                   "sha256": sha256(raw).hexdigest(), "protected": expected}
+            _require(_descriptor(path, fd) == identity and _work_identity(parent.lstat()) == parent_id)
+        finally:
+            os.close(fd)
+    finally:
+        os.close(directory)
+
+
+def _leases(lease):
+    from gateway.status import _get_scope_lock_path
+    from .receipt_writer_lease import _fingerprint
+
+    identity = lease.adapter._platform_lock_identity
+    token_path = lease.legacy_path
+    _require(bool(identity) and identity == lease.adapter.config.token
+             and _get_scope_lock_path("telegram-bot-token", identity) == token_path
+             and _fingerprint(token_path) == lease.legacy_fingerprint)
+    receipt_path = lease.receipt_path
+    return {
+        "token": _descriptor(token_path.with_name(token_path.name + ".receipt-lease"), lease.token_fd),
+        "receipt": _descriptor(receipt_path.with_name(receipt_path.name + ".receipt-lease"), lease.path_fd),
+    }
+
+
+def _revoke_marker(name, directory, fd):
+    try:
+        opened = os.fstat(fd)
+        try:
+            entry = os.stat(name, dir_fd=directory, follow_symlinks=False)
+        except FileNotFoundError:
+            return
+        if (entry.st_dev, entry.st_ino) == (opened.st_dev, opened.st_ino):
+            os.unlink(name, dir_fd=directory)
+            os.fsync(directory)
+    except OSError as error:
+        raise RuntimeError("d13_settlement_marker_revocation_unproved") from error
+
+
+class WriterSettlement:
+    def __init__(self, home, scope, invocation, deployment):
+        self.scope = scope
+        self.work = home / "preparation/ordinary-gateway/d13-settlement"
+        self.invocation = invocation
+        self.deployment = deployment
+        self.nonce = uuid4().hex
+        self.acquired_ns = time.monotonic_ns()
+        self.cancelled = Event()
+        self.result = None
+        self.pending_marker = None
+
+    def cancel(self):
+        self.result = WriterSettlementResult.CANCELLED
+        self.cancelled.set()
+
+    def fail(self):
+        if self.result is not WriterSettlementResult.CANCELLED:
+            self.result = WriterSettlementResult.UNPROVED
+        self.cancelled.set()
+
+    def accept_pending_marker(self):
+        _, descriptors, deadline = self.pending_marker
+        if self.cancelled.is_set() or time.monotonic_ns() >= deadline:
+            self.fail()
+            return False
+        self.pending_marker = None
+        descriptors.close()
+        self.result = WriterSettlementResult.PROVISIONAL
+        return True
+
+    def revoke_pending_marker(self, loop):
+        marker, descriptors, _ = self.pending_marker
+
+        def revoke():
+            with descriptors:
+                _revoke_marker(*marker)
+
+        worker = loop.run_in_executor(None, revoke)
+        self.pending_marker = None
+        return worker
+
+    async def _filesystem(self, function, *args):
+        work = asyncio.get_running_loop().run_in_executor(None, copy_context().run, function, *args)
+        # Task cancellation cannot end physical custody. Keep awaiting the
+        # same executor operation even if cancellation is requested again.
+        while not work.done():
+            try:
+                await asyncio.shield(work)
+            except asyncio.CancelledError:
+                self.cancel()
+        if work.cancelled():
+            raise RuntimeError("d13_settlement_filesystem_return_unproved")
+        return work.result()
+
+    async def produce(self, lease, expected):
+        from .receipt_writer_lease import ReceiptWriterBusy
+
+        try:
+            observed = await self._filesystem(partial(_intent, self.work, missing_ok=True))
+            if observed is None:
+                if asyncio.current_task().cancelling():
+                    raise asyncio.CancelledError
+                if not self.cancelled.is_set():
+                    self.result = WriterSettlementResult.NO_INTENT
+                return self.result
+            intent, intent_pin = observed
+            issued = intent["issued_monotonic_ns"]
+            deadline = intent["deadline_monotonic_ns"]
+            _require(type(issued) is type(deadline) is int and issued < deadline
+                     and lease.ready and lease.native_stop_proved and type(lease.stop_started_ns) is int
+                     and self.acquired_ns <= issued <= lease.stop_started_ns <= time.monotonic_ns() < deadline
+                     and intent["invocation"] == self.invocation
+                     and intent["deployment"] == self.deployment and intent["bot_id"] == lease.bot_id
+                     and not self.cancelled.is_set())
+            # This scope may no longer acquire a successor in the retiring
+            # process, including another token for the same bot.
+            _RETIRING.add(self.scope)
+            staged = await self._filesystem(self._capture, lease, expected, intent, intent_pin)
+            _require(not self.cancelled.is_set() and time.monotonic_ns() < deadline)
+            marker, descriptors = await self._filesystem(self._commit, lease, expected, intent, intent_pin, staged)
+        except (OSError, ValueError, TypeError, KeyError, ReceiptWriterBusy):
+            self.fail()
+        else:
+            # The initiating disconnect owns the final disposition. Keep
+            # the exact marker open until it consumes the worker's result.
+            if self.cancelled.is_set() or time.monotonic_ns() >= deadline:
+                self.fail()
+                with descriptors:
+                    await self._filesystem(_revoke_marker, *marker)
+            else:
+                self.pending_marker = marker, descriptors, deadline
+        if asyncio.current_task().cancelling():
+            raise asyncio.CancelledError
+        return self.result
+
+    def _check(self, lease, intent, intent_pin):
+        _require(not self.cancelled.is_set() and time.monotonic_ns() < intent["deadline_monotonic_ns"]
+                 and self.work.resolve(strict=True) == self.work and _intent(self.work) == (intent, intent_pin)
+                 and _invocation() == self.invocation and _deployment(self.scope[0]) == self.deployment)
+        return _leases(lease), _work_identity(self.work.lstat())
+
+    def _capture(self, lease, expected, intent, intent_pin):
+        leases, directory = self._check(lease, intent, intent_pin)
+        with _read_receipt(lease.receipt_path, expected, lease.written_receipt) as receipt:
+            _require(not self.cancelled.is_set() and time.monotonic_ns() < intent["deadline_monotonic_ns"])
+            value = {
+                "schema": _RECORD, "intent_sha256": intent_pin, "operation_nonce": intent["nonce"],
+                "invocation": self.invocation, "deployment": self.deployment, "bot_id": lease.bot_id,
+                "acquisition_nonce": self.nonce, "acquired_monotonic_ns": self.acquired_ns,
+                "stop_started_monotonic_ns": lease.stop_started_ns,
+                "settled_monotonic_ns": time.monotonic_ns(),
+                "leases": leases, "receipt": receipt,
+            }
+            ref = _write_private(self.work, intent["nonce"] + ".data.json", value, directory)
+        return ref, receipt, leases, directory
+
+    def _commit(self, lease, expected, intent, intent_pin, staged):
+        from hermes_cli.friday_dashboard_owner import read_owned
+
+        ref, receipt, leases, identity = staged
+        _require(self._check(lease, intent, intent_pin) == (leases, identity))
+        raw = _private_bytes(Path(ref["path"]), read_owned, _MAX_FILE)
+        _require(len(raw) == ref["bytes"] and sha256(raw).hexdigest() == ref["sha256"])
+        deadline = intent["deadline_monotonic_ns"]
+        name = intent["nonce"] + ".settled.json"
+        with ExitStack() as descriptors:
+            directory = os.open(self.work, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
+            descriptors.callback(os.close, directory)
+            _require(_work_identity(os.fstat(directory)) == identity)
