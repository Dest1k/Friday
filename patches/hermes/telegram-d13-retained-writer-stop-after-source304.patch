+"""Exact acquisition fence for Telegram intake and its physical receipt writer."""
+
+import asyncio
+import os
+import stat
+
+
+class ReceiptWriterBusy(RuntimeError):
+    """The prior token or receipt writer still owns its acquisition."""
+
+
+def _take(path):
+    # A persistent inode is the rendezvous. Never unlink a flock sidecar.
+    import fcntl
+
+    parent = path.parent
+    parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    info = parent.lstat()
+    if (not parent.is_absolute() or parent.resolve() != parent or not stat.S_ISDIR(info.st_mode)
+            or info.st_uid != os.getuid() or info.st_mode & 0o022):
+        raise ReceiptWriterBusy("telegram_receipt_lease_directory")
+    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
+    try:
+        before = os.fstat(fd)
+        if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid()
+                or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600):
+            raise ReceiptWriterBusy("telegram_receipt_lease_identity")
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as error:
+            raise ReceiptWriterBusy("telegram_receipt_writer_already_owned") from error
+        after = path.lstat()
+        if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
+            raise ReceiptWriterBusy("telegram_receipt_lease_changed")
+        return fd
+    except BaseException:
+        os.close(fd)
+        raise
+
+
+def _fingerprint(path):
+    info = path.lstat()
+    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
+        raise ReceiptWriterBusy("telegram_legacy_lock_identity")
+    return info.st_dev, info.st_ino, info.st_ctime_ns, info.st_mtime_ns, info.st_size
+
+
+def validate_receipt_path(path):
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return
+    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+            or info.st_nlink != 1 or info.st_mode & 0o022):
+        raise ReceiptWriterBusy("telegram_unsafe_receipt_path")
+
+
+class ReceiptWriterLease:
+    def __init__(self, adapter, token):
+        from gateway.status import _get_scope_lock_path
+
+        self.adapter = adapter
+        self.loop = asyncio.get_running_loop()
+        self.application = None
+        self.ready = False
+        self.bot_id = None
+        self.closing = False
+        self.ordinary_drain = False
+        self.startup_done = asyncio.Event()
+        self.transport_closed = False
+        self.transport_unproved = False
+        self.write_failed = False
+        self.failed = False
+        self.legacy_fingerprint = None
+        self.claims = 0
+        self.writer = None
+        self.written_receipt = None
+        self.stop_task = None
+        self.stop_started_ns = None
+        self.native_stop_proved = False
+        self.d13_registered = False
+        self.settlement = None
+        self.settlement_task = None
+        self.settlement_waiter_pending = False
+        self.settlement_returned = False
+        self.settlement_revocation = None
+        self.path_fd = None
