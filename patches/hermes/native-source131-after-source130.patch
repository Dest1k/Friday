+"""Create-only own-workspace ODG/FODG publication; no source is consumed."""
+import json
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_odg import ODGError
+from tools.scoped_odg_write import create_diagram, ODGCreateError
+
+
+def create(cap, fd, leaf, path, content):
+    _check_parent(cap, fd, path)
+    format = Path(path).suffix.lower().lstrip('.')
+    if format not in ('odg', 'fodg') or Path(path).name != leaf:
+        raise ScopeDenied()
+    try:
+        data = create_diagram(content, format, checkpoint=lambda: check(cap))
+    except (ODGCreateError, ODGError) as error:
+        return json.dumps({'success': False, 'error': 'diagram_create_refused',
+                           'reason': error.code, 'effect_disposition': 'none'})
+    return _create_bytes(cap, fd, leaf, path, data, output_format=format)
