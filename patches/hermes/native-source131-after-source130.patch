+"""Bounded native ODG/FODG creation from explicit geometry and IDREFs.
+
+Only rect/ellipse nodes and straight, explicitly attached connectors are supported.
+Coordinates are millimetres (JSON numbers or decimal strings, <=3 places). No
+source import, automatic layout, inferred topology, external resource or rendering.
+"""
+from __future__ import annotations
+
+import io
+import json
+import re
+import stat
+import zipfile
+from decimal import Context, Decimal, localcontext
+from xml.etree import ElementTree as ET
+
+from tools.scoped_odg import O, D, T, S, M, SVG, XML, MIME, extract_diagram
+from tools.scoped_presentation import q
+
+FO = 'urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0'
+MAX_INPUT = 100_000
+MAX_OUTPUT = 1_000_000
+MAX_PAGES = 16
+MAX_NODES = 256
+MAX_CONNECTORS = 512
+MAX_LABEL = 4096
+MAX_TEXT = 32768
+MAX_EXTENT = Decimal('1000')
+SIDES = {'top': 4, 'right': 5, 'bottom': 6, 'left': 7}
+ARROWS = {'none', 'start', 'end', 'both'}
+GUIDANCE = ('Native editable diagrams: format=diagram_create with a NEW .odg or .fodg path. '
+    'Content is exactly {"pages":[{"name":"Flow","width_mm":210,"height_mm":297,"nodes":'
+    '[{"id":"start","shape":"rect","label":"Start","x_mm":10,"y_mm":10,"width_mm":40,"height_mm":20},'
+    '{"id":"end","shape":"ellipse","label":"End","x_mm":100,"y_mm":10,"width_mm":40,"height_mm":20}],'
+    '"connectors":[{"id":"edge","start":"start","end":"end","start_side":"right","end_side":"left","label":"Next","arrow":"end"}]}]}. '
+    'Page fields and node fields are required; connectors may be empty. Connector label and arrow are optional, default empty and none. '
+    'Shapes are rect/ellipse; connector sides top/right/bottom/left select explicit editable midpoint glue points. '
+    'Straight connectors use exact same-page node IDs; arrow is none/start/end/both with a geometric triangle marker. '
+    'Coordinates/dimensions are nonnegative millimetres as JSON numbers or decimal strings, at most 3 fractional digits, '
+    'no exponent; dimensions must be positive and nodes must fit inside the page. Maximum page extent 1000mm, '
+    '16 pages, 256 total nodes, 512 total connectors, 4096 UTF-8 bytes per label, 32768 total text bytes, 100000 input bytes. '
+    'IDs are globally unique ASCII letters/digits/underscore/dot/hyphen, starting with a letter or underscore, max64. '
+    'No unknown keys, source imports, inferred business semantics, automatic routing/layout, source edits, conversion, '
+    'rendering or Visio writing. Native read_file verifies stored labels, geometry, connector IDs and declared direction; '
+    'visual fit, typography and layout require separate acceptance. ')
+
+
+
+class ODGCreateError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def _fail(code):
+    raise ODGCreateError(code)
+
+
+def _tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+def _keys(value, required, optional=()):
+    if type(value) is not dict or not set(required) <= value.keys() or value.keys() - set(required) - set(optional):
+        _fail('unsupported_or_missing_fields')
+
+
+def _text(value, *, name=False):
+    if type(value) is not str:
+        _fail('label_type')
+    if any((ord(c) < 32 and c not in '\n\t') or 0x7f <= ord(c) <= 0x9f
+           or 0xd800 <= ord(c) <= 0xdfff or ord(c) & 0xffff in (0xfffe, 0xffff)
+           for c in value):
+        _fail('invalid_label_character')
+    if len(value.encode('utf-8')) > (128 if name else MAX_LABEL):
+        _fail('label_limit')
+    if name and (not value.strip() or '\n' in value or '\t' in value):
+        _fail('invalid_page_name')
+    return value
+
+
+def _id(value):
+    if type(value) is not str or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_.-]{0,63}', value):
+        _fail('invalid_id')
+    return value
+
+
+def _number(value):
+    # Applied while parsing JSON, before constructing any Decimal exponent.
+    if len(value) > 16 or not re.fullmatch(r'-?(?:0|[1-9][0-9]{0,3})(?:\.[0-9]{1,3})?', value):
+        _fail('coordinate_syntax_or_precision')
+    return Decimal(value)
+
+
+def _mm(value, *, positive=False):
+    if type(value) is str:
+        value = _number(value)
+    if type(value) is not Decimal or not value.is_finite() or value.is_signed() or value > MAX_EXTENT or (positive and value <= 0):
+        _fail('coordinate_range')
+    return value
+
+
+def _parse(content, checkpoint):
+    if type(content) is not str or len(content) > MAX_INPUT:
+        _fail('input_limit_or_type')
+    try:
+        if len(content.encode('utf-8')) > MAX_INPUT:
+            _fail('input_limit_or_type')
+    except UnicodeEncodeError:
+        _fail('invalid_label_character')
+    # A shallow contract needs no attacker-controlled deep JSON allocation.
+    depth = 0; quoted = False; escaped = False
+    for index, char in enumerate(content):
+        if index % 1024 == 0:
+            _tick(checkpoint)
+        if quoted:
+            if escaped: escaped = False
+            elif char == '\\': escaped = True
+            elif char == '"': quoted = False
+        elif char == '"': quoted = True
+        elif char in '[{':
+            depth += 1
+            if depth > 6: _fail('json_depth')
+        elif char in ']}': depth -= 1
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result: _fail('duplicate_json_key')
+            result[key] = value
+        return result
+    try:
+        spec = json.loads(content, object_pairs_hook=pairs, parse_int=_number,
+                          parse_float=_number, parse_constant=lambda _: _fail('nonfinite_number'))
+    except (ValueError, RecursionError) as error:
+        if isinstance(error, ODGCreateError): raise
+        _fail('malformed_json')
+    _keys(spec, {'pages'})
+    if type(spec['pages']) is not list or not 1 <= len(spec['pages']) <= MAX_PAGES:
+        _fail('page_limit')
+    ids = set(); names = set(); node_count = 0; edge_count = 0; text_bytes = 0
+    for page in spec['pages']:
+        _tick(checkpoint)
+        _keys(page, {'name', 'width_mm', 'height_mm', 'nodes', 'connectors'})
+        page['name'] = _text(page['name'], name=True)
+        if page['name'] in names: _fail('duplicate_page_name')
+        names.add(page['name']); text_bytes += len(page['name'].encode('utf-8'))
+        width = page['width_mm'] = _mm(page['width_mm'], positive=True)
+        height = page['height_mm'] = _mm(page['height_mm'], positive=True)
+        if type(page['nodes']) is not list or not page['nodes']:
+            _fail('nodes_required')
+        if type(page['connectors']) is not list:
+            _fail('connectors_type')
+        node_count += len(page['nodes']); edge_count += len(page['connectors'])
+        if node_count > MAX_NODES or edge_count > MAX_CONNECTORS: _fail('object_limit')
+        local_nodes = {}
+        for node in page['nodes']:
+            _tick(checkpoint)
+            _keys(node, {'id', 'shape', 'label', 'x_mm', 'y_mm', 'width_mm', 'height_mm'})
+            node_id = _id(node['id'])
+            if node_id in ids: _fail('duplicate_id')
+            ids.add(node_id); local_nodes[node_id] = node
+            if node['shape'] not in ('rect', 'ellipse'): _fail('unsupported_shape')
+            node['label'] = _text(node['label']); text_bytes += len(node['label'].encode('utf-8'))
+            for key in ('x_mm', 'y_mm', 'width_mm', 'height_mm'):
+                node[key] = _mm(node[key], positive=key in ('width_mm', 'height_mm'))
+            if node['x_mm'] + node['width_mm'] > width or node['y_mm'] + node['height_mm'] > height:
+                _fail('node_outside_page')
+        for edge in page['connectors']:
+            _tick(checkpoint)
+            _keys(edge, {'id', 'start', 'end', 'start_side', 'end_side'}, {'label', 'arrow'})
+            edge_id = _id(edge['id'])
+            if edge_id in ids: _fail('duplicate_id')
+            ids.add(edge_id)
+            for end in ('start', 'end'):
+                if _id(edge[end]) not in local_nodes: _fail('dangling_or_cross_page_connector')
+                if type(edge[end + '_side']) is not str or edge[end + '_side'] not in SIDES:
+                    _fail('unsupported_connector_side')
+            edge['label'] = _text(edge.get('label', '')); text_bytes += len(edge['label'].encode('utf-8'))
+            edge['arrow'] = edge.get('arrow', 'none')
+            if type(edge['arrow']) is not str or edge['arrow'] not in ARROWS: _fail('unsupported_arrow')
+            if _point(local_nodes[edge['start']], edge['start_side']) == _point(local_nodes[edge['end']], edge['end_side']):
+                _fail('zero_length_connector')
+        if text_bytes > MAX_TEXT: _fail('total_text_limit')
+    return spec
+
+
+def _fmt(value):
+    result = format(value, 'f').rstrip('0').rstrip('.') if '.' in format(value, 'f') else format(value, 'f')
+    return result or '0'
+
+
+def _length(value):
+    return _fmt(value) + 'mm'
+
+
+def _point(node, side, *, relative=False):
+    w, h = node['width_mm'], node['height_mm']
+    x, y = {'top': (w / 2, Decimal(0)), 'right': (w, h / 2),
+            'bottom': (w / 2, h), 'left': (Decimal(0), h / 2)}[side]
+    return (x, y) if relative else (node['x_mm'] + x, node['y_mm'] + y)
+
+
+def _child(parent, ns, name, attributes=None):
+    return ET.SubElement(parent, q(ns, name), attributes or {})
+
+
+def _label(parent, label):
+    # Every space/tab is explicit: preserve leading/repeated/trailing whitespace.
+    for line in label.split('\n'):
+        p = _child(parent, T, 'p', {q(T, 'style-name'): 'Label'})
+        last = None
+        for token in re.findall(r' +|\t|[^ \t]+', line):
+            if token[0] == ' ':
+                last = _child(p, T, 's', {q(T, 'c'): str(len(token))})
+            elif token == '\t':
+                last = _child(p, T, 'tab')
+            elif last is None:
+                p.text = (p.text or '') + token
+            else:
+                last.tail = (last.tail or '') + token
+
+
+def _style_sections(parent, pages, checkpoint):
+    styles = _child(parent, O, 'styles')
+    _child(styles, D, 'marker', {q(D, 'name'): 'Triangle', q(SVG, 'viewBox'): '0 0 20 30',
+                                 q(SVG, 'd'): 'M 10 0 L 20 30 L 0 30 Z'})
+    label = _child(styles, S, 'style', {q(S, 'name'): 'Label', q(S, 'family'): 'paragraph'})
+    _child(label, S, 'paragraph-properties', {q(FO, 'text-align'): 'center'})
+    _child(label, S, 'text-properties', {q(FO, 'font-size'): '10pt', q(FO, 'color'): '#000000'})
+    node = _child(styles, S, 'style', {q(S, 'name'): 'Node', q(S, 'family'): 'graphic'})
+    _child(node, S, 'graphic-properties', {q(D, 'fill'): 'solid', q(D, 'fill-color'): '#ffffff',
+        q(D, 'stroke'): 'solid', q(SVG, 'stroke-color'): '#000000', q(SVG, 'stroke-width'): '0.2mm',
+        q(D, 'textarea-vertical-align'): 'middle', q(D, 'auto-grow-height'): 'false', q(D, 'auto-grow-width'): 'false'})
+    for arrow in sorted(ARROWS):
+        style = _child(styles, S, 'style', {q(S, 'name'): 'Edge_' + arrow, q(S, 'family'): 'graphic'})
+        attrs = {q(D, 'fill'): 'none', q(D, 'stroke'): 'solid', q(SVG, 'stroke-color'): '#000000', q(SVG, 'stroke-width'): '0.2mm'}
+        for end in ('start', 'end'):
+            if arrow in (end, 'both'):
+                attrs[q(D, 'marker-' + end)] = 'Triangle'
+                attrs[q(D, 'marker-' + end + '-width')] = '3mm'
+        _child(style, S, 'graphic-properties', attrs)
+    # Share the style consumed by content.xml as a common named style.
+    # styles.xml automatic styles serve styles defined within that file.
+    dp = _child(styles, S, 'style', {q(S, 'name'): 'DrawingPage', q(S, 'family'): 'drawing-page'})
+    _child(dp, S, 'drawing-page-properties', {q(D, 'fill'): 'none'})
+    auto = _child(parent, O, 'automatic-styles')
+    for index, page in enumerate(pages, 1):
+        _tick(checkpoint)
+        layout = _child(auto, S, 'page-layout', {q(S, 'name'): 'PageLayout' + str(index)})
+        _child(layout, S, 'page-layout-properties', {q(FO, 'page-width'): _length(page['width_mm']),
+            q(FO, 'page-height'): _length(page['height_mm']), q(FO, 'margin'): '0mm',
+            q(S, 'print-orientation'): 'landscape' if page['width_mm'] > page['height_mm'] else 'portrait'})
+    masters = _child(parent, O, 'master-styles')
+    for index in range(1, len(pages) + 1):
+        _child(masters, S, 'master-page', {q(S, 'name'): 'Master' + str(index), q(S, 'page-layout-name'): 'PageLayout' + str(index)})
+
+
+def _drawing(parent, pages, checkpoint):
+    body = _child(parent, O, 'body'); drawing = _child(body, O, 'drawing')
+    for index, page in enumerate(pages, 1):
+        item = _child(drawing, D, 'page', {q(D, 'name'): page['name'], q(D, 'style-name'): 'DrawingPage', q(D, 'master-page-name'): 'Master' + str(index)})
+        nodes = {node['id']: node for node in page['nodes']}
+        for node in page['nodes']:
+            _tick(checkpoint)
+            shape = _child(item, D, node['shape'], {q(XML, 'id'): node['id'], q(D, 'style-name'): 'Node',
+                **{q(SVG, key): _length(node[key + '_mm']) for key in ('x', 'y', 'width', 'height')}})
+            for side, identifier in SIDES.items():
+                x, y = _point(node, side, relative=True)
+                _child(shape, D, 'glue-point', {q(D, 'id'): str(identifier), q(D, 'align'): 'top-left',
+                    q(SVG, 'x'): _length(x), q(SVG, 'y'): _length(y)})
+            _label(shape, node['label'])
