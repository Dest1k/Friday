+    def _delivery_boot_sweep_begin(self):
+        """Current-process evidence only; a new start invalidates every prior observation.
+
+        No disk success receipt is written or restored. The existing authenticated
+        loop projection binds this generation to its answering PID/birth/boot.
+        """
+        generation = uuid.uuid4().hex
+        self._delivery_boot_sweep_observation = dict(
+            schema="frw.gateway.delivery-boot-sweep.v1", scope="full_boot",
+            start_generation=generation, start_monotonic=time.monotonic(),
+            startup_outcome="running", claim_outcome="not_run", enabled=None,
+            sweep_outcome="not_run", returned_success=False,
+            sweep_started_monotonic=None, sweep_finished_monotonic=None,
+            target_scope_sha256=None, target_count=None,
+            resume_clear="not_run", failure_phase=None,
+            startup_finished_monotonic=None,
+        )
+        self._delivery_boot_sweep_entered = (generation, threading.Event())
+        return generation
+
+    def _delivery_boot_sweep_update(self, generation, **fields):
+        current = getattr(self, "_delivery_boot_sweep_observation", None)
+        if generation is not None and current is not None and current["start_generation"] == generation:
+            # Replace, never mutate: the readonly loop projection takes a coherent copy.
+            self._delivery_boot_sweep_observation = dict(current, **fields)
+
+    def _delivery_boot_sweep_readonly(self):
+        current = getattr(self, "_delivery_boot_sweep_observation", None)
+        if current is None:
+            return None
+        entered = getattr(self, "_delivery_boot_sweep_entered", None)
+        if entered is None or entered[0] != current["start_generation"]:
+            raise RuntimeError("delivery_boot_sweep_generation_unavailable")
+        result = dict(current, entered=entered[1].is_set(),
+                      failed_resume_latch=getattr(self, "_delivery_resume_recovery_failed", False))
+        if current is not self._delivery_boot_sweep_observation:
+            raise RuntimeError("delivery_boot_sweep_projection_racing")
+        return result
+
+    @staticmethod
+    def _delivery_boot_target_scope(targets):
+        # Only a domain-separated commitment to platform/profile labels is exposed;
+        # no chat IDs, paths, content, arguments or credential material.
+        rows = sorted([list(target) for target in targets], key=lambda row: (row[0], row[1] or ""))
+        raw = json.dumps(rows, ensure_ascii=True, separators=(",", ":")).encode("ascii")
+        return hashlib.sha256(b"frw.delivery-target-scope.v1\0" + raw).hexdigest()
 
