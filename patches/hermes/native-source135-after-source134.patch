+            if len(node) or len(_tokens(node.text or '')) != 1:
+                fail('pdf_bbox_invalid')
+            bounds = _bounds(node, width, height)
+            words.append(dict(text=node.text, bounds=bounds))
+            total += 1
+            if total > MAX_WORDS:
+                fail('pdf_word_limit')
+        if not words:
+            fail('pdf_blank_or_unextractable_page')
