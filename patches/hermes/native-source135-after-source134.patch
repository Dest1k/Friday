+"""Three source-bound native Office-to-PDF commands; DOCX export is unchanged.
+
+Uses the established document toolchain, authenticated native process custody,
+revision checks and create-only publisher. No user-supplied command or filter.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+
+OFFICE = '/opt/friday-document-toolchain/root/usr/lib/libreoffice/program/soffice'
+# SinglePageSheets is a fixed Calc export policy: all each-sheet contents must
+# fit one searchable page and pass the independent source/value/geometry oracle.
+CALC_FILTER = 'pdf:calc_pdf_Export:{"SinglePageSheets":{"type":"boolean","value":"true"},"ExportFormFields":{"type":"boolean","value":"false"}}'
+OPERATIONS = {'odt_pdf': ('odt', 'pdf:writer_pdf_Export'),
+              'xlsx_pdf': ('xlsx', CALC_FILTER), 'ods_pdf': ('ods', CALC_FILTER)}
+MAX_OUTPUT = 1_000_000
+MAX_EVIDENCE = 4_000_000
+LIBRARY = '/usr/lib/x86_64-linux-gnu/libqpdf.so.30'
+
+
+def _request(content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ScopeDenied()
+            result[key] = value
+        return result
+    if not isinstance(content, str) or len(content) > 8192:
+        raise ScopeDenied()
+    try:
+        result = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    if (type(result) is not dict or set(result) != {'source', 'source_sha256'} or
+            not isinstance(result['source'], str) or not 1 <= len(result['source']) <= 4096 or
+            '\x00' in result['source'] or not isinstance(result['source_sha256'], str) or
+            re.fullmatch('[0-9a-f]{64}', result['source_sha256']) is None):
+        raise ScopeDenied()
+    return result
+
+
+def _office_command(operation):
+    if operation not in OPERATIONS:
+        raise ValueError('pdf_operation_unsupported')
+    source, filter_name = OPERATIONS[operation]
+    return [OFFICE, '--headless', '--norestore', '--nodefault', '--nolockcheck',
+            '--nofirststartwizard', '-env:UserInstallation=file:///work/home/profile',
+            '--convert-to', filter_name, '--outdir', '/work/out', '/work/input.' + source]
+
+
+def _argv(work, toolchain, operation):
+    # Keep this adapter local; the existing DOCX renderer is not widened.
+    from hermes_cli.friday_workspace_pdf import _PREFIX, ExportRefused
+    if operation not in OPERATIONS:
+        raise ExportRefused('pdf_operation_unsupported')
+    source = OPERATIONS[operation][0]
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--new-session',
+            '--as-pid-1', '--cap-drop', 'ALL', '--clearenv', '--ro-bind', '/usr', '/usr']
+    for alias in ('bin', 'sbin', 'lib', 'lib64'):
+        item = Path('/') / alias
+        if item.exists():
+            target = item.resolve()
+            if not target.is_relative_to('/usr'):
+                raise ExportRefused('renderer_unavailable')
+            argv += ['--symlink', str(target), str(item)]
+    argv += ['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp', '--dir', '/opt',
+             '--ro-bind', str(toolchain), _PREFIX,
+             '--ro-bind', '/usr/share', _PREFIX + '/.host-share',
+             '--ro-bind', str(toolchain / 'share-merged'), '/usr/share', '--dir', '/etc']
+    for item in ('/etc/fonts', '/etc/ld.so.cache', '/var/cache/fontconfig'):
+        if Path(item).exists():
+            argv += ['--ro-bind', item, item]
+    argv += ['--bind', str(work), '/work',
+             '--ro-bind', str(work / ('input.' + source)), '/work/input.' + source,
+             '--ro-bind', str(work / 'renderer.py'), '/renderer.py',
+             '--chdir', '/work', '--remount-ro', '/', '--',
+             '/usr/bin/python3', '-I', '-B', '-S', '/renderer.py', '--render', operation]
+    return argv
+
+
+def _parser_available():
+    from hermes_cli.friday_workspace_pdf import ExportRefused
+    try:
+        for path in ('/usr/bin/pdfinfo', '/usr/bin/pdftotext', LIBRARY, FREETYPE):
+            resolved = Path(path).resolve(strict=True)
+            info = resolved.stat()
+            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
+                raise ExportRefused('pdf_engine_unavailable')
+    except OSError:
+        raise ExportRefused('pdf_engine_unavailable') from None
+
+
+def _read_output(work, expected_source_sha):
+    from hermes_cli.friday_workspace_pdf import _private_bytes, ExportRefused
+    root = output = None
+    try:
+        root = os.open(work, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        output = os.open('out', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=root)
+        for fd in (root, output):
+            info = os.fstat(fd)
+            if info.st_uid != os.getuid() or info.st_mode & 0o077:
+                raise ExportRefused('invalid_pdf_output')
+        if os.listdir(output) != ['input.pdf']:
+            raise ExportRefused('invalid_pdf_output')
+        pdf = _private_bytes(output, 'input.pdf', MAX_OUTPUT)
+        if not pdf.startswith(b'%PDF-') or not pdf.rstrip().endswith(b'%%EOF'):
+            raise ExportRefused('invalid_pdf_output')
+        info = _private_bytes(root, 'pdfinfo', 8192)
+        bbox = _private_bytes(root, 'bbox.xhtml', MAX_EVIDENCE)
+        receipt = json.loads(_private_bytes(root, 'validated.json', MAX_EVIDENCE))
+        if (type(receipt) is not dict or set(receipt) != {'source_sha256', 'pdf_sha256', 'structure'} or
+                receipt['source_sha256'] != expected_source_sha or
+                receipt['pdf_sha256'] != hashlib.sha256(pdf).hexdigest()):
+            raise ExportRefused('invalid_pdf_output')
+        return pdf, info, bbox, receipt['structure']
+    except (OSError, ValueError, RecursionError):
+        raise ExportRefused('invalid_pdf_output') from None
+    finally:
+        if output is not None:
+            os.close(output)
+        if root is not None:
+            os.close(root)
+
+
+def render(cap, data, operation):
+    from hermes_cli.friday_workspace_pdf import _run, _toolchain, ExportRefused
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_document_pdf import preflight, verify
+    if operation not in OPERATIONS:
+        raise ExportRefused('pdf_operation_unsupported')
+    check(cap)
+    plan = preflight(data, OPERATIONS[operation][0], checkpoint=lambda: check(cap))
+    _parser_available()
+    toolchain = _toolchain()
+    work = Path(tempfile.mkdtemp(prefix='friday-document-pdf-'))
+    try:
+        work.chmod(0o700)
+        for name in ('out', 'home', 'tmp'):
+            (work / name).mkdir(mode=0o700)
+        for name, value in (('input.' + OPERATIONS[operation][0], data),
+                            ('renderer.py', Path(__file__).read_bytes())):
+            (work / name).write_bytes(value)
+            (work / name).chmod(0o600)
+        _run(cap, _argv(work, toolchain, operation), work)
+        pdf, info, bbox, structure = _read_output(work, plan['source_sha256'])
+        details = verify(plan, info, bbox, structure, checkpoint=lambda: check(cap))
+        check(cap)
+        return pdf, dict(details, office_filter=OPERATIONS[operation][1],
+                         source_sha256=plan['source_sha256'], runtime_qualified=False)
+    finally:
+        try:
+            shutil.rmtree(work)
+        except OSError:
+            from agent.web_call_context import _current
+            call = _current.get()
+            if call is not None and hasattr(call, 'agent'):
+                call.agent._friday_reply_effect_unknown = True
+            raise ExportRefused('renderer_cleanup_unconfirmed') from None
+
+
+def create_pdf(cap, fd, leaf, path, content, operation):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_pdf import ExportRefused
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_document_pdf import DocumentPDFError
+    if (operation not in OPERATIONS or not isinstance(path, str) or
+            Path(path).suffix.lower() != '.pdf' or Path(path).name != leaf):
+        raise ScopeDenied()
+    try:
+        check(cap)
+        _check_parent(cap, fd, path)
+        request = _request(content)
+        try:
+            os.stat(leaf, dir_fd=fd, follow_symlinks=False)
+        except FileNotFoundError:
+            pass
+        else:
+            return json.dumps(dict(success=False, error='document_already_exists', effect_disposition='none'))
+        source, relative, data, identity = _read_source(request['source'], cap, '.' + OPERATIONS[operation][0])
+        if relative == path:
+            raise ScopeDenied()
+        if hashlib.sha256(data).hexdigest() != request['source_sha256']:
+            raise DocumentPDFError('source_hash_mismatch')
+        output, details = render(cap, data, operation)
+        check(cap)
+        return _publish(cap, fd, leaf, path, output, 'pdf', (source, data, identity),
+                        dict(details, source=relative, source_unchanged=True, export_mode=operation,
+                             native_editable=False, macros_executed=False))
+    except ScopeDenied:
+        raise
+    except (DocumentPDFError, ExportRefused) as error:
+        unknown = str(error) == 'renderer_cleanup_unconfirmed'
+        return json.dumps(dict(success=False, error='document_pdf_refused', reason=str(error),
+                               effect_disposition='unknown' if unknown else 'none'))
+    except (OSError, RuntimeError, TimeoutError):
+        return json.dumps(dict(success=False, error='document_pdf_stopped', effect_disposition='none'))
+
+
+def _pdf_structure(path):
+    """Read only inside the bounded networkless child; native qpdf, no repair."""
+    import ctypes as C
+    lib = C.CDLL(LIBRARY)
+    ptr, integer, string = C.c_void_p, C.c_int, C.c_char_p
+    signatures = {
+        'qpdf_get_qpdf_version': (string, []), 'qpdf_init': (ptr, []),
+        'qpdf_cleanup': (None, [C.POINTER(ptr)]),
+        'qpdf_silence_errors': (None, [ptr]),
+        'qpdf_set_suppress_warnings': (None, [ptr, integer]),
+        'qpdf_set_attempt_recovery': (None, [ptr, integer]),
+        'qpdf_has_error': (integer, [ptr]), 'qpdf_more_warnings': (integer, [ptr]),
+        'qpdf_get_error': (ptr, [ptr]),
+        'qpdf_read': (integer, [ptr, string, string]),
+        'qpdf_is_encrypted': (integer, [ptr]), 'qpdf_check_pdf': (integer, [ptr]),
+        'qpdf_get_num_pages': (integer, [ptr]),
+    }
+    for name, (result, args) in signatures.items():
+        getattr(lib, name).restype, getattr(lib, name).argtypes = result, args
+    if lib.qpdf_get_qpdf_version() != b'12.3.2':
+        raise ValueError('pdf_engine_unavailable')
+    handle = ptr(lib.qpdf_init())
+    if not handle:
+        raise ValueError('pdf_engine_unavailable')
+    try:
+        lib.qpdf_silence_errors(handle)
+        lib.qpdf_set_suppress_warnings(handle, 1)
+        lib.qpdf_set_attempt_recovery(handle, 0)
+        if lib.qpdf_read(handle, os.fsencode(path), None) or lib.qpdf_is_encrypted(handle):
+            raise ValueError('invalid_pdf_output')
+        if lib.qpdf_check_pdf(handle) or lib.qpdf_has_error(handle) or lib.qpdf_more_warnings(handle):
+            raise ValueError('invalid_pdf_output')
+        pages = lib.qpdf_get_num_pages(handle)
+        if not 1 <= pages <= 64:
