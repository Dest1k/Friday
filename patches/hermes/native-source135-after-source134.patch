+def _visible_content(visibility, pages, geometry, checkpoint):
+    """Bind native paint proof to extracted words, with conservative ink clearance.
+
+    The admitted Base14 glyphs fit within one em of their advance/line box.
+    Whole-run clearance is deliberately stricter than normal typesetting; it
+    avoids claiming that separate painted runs cannot obscure one another.
+    """
+    if type(visibility) is dict and visibility.get('profile')==TRUSTED_PROFILE:
+        return _trusted_visible_content(visibility,pages,geometry,checkpoint)
+    if (type(visibility) is not dict or set(visibility) != {'profile', 'pages'} or
+            visibility['profile'] != VISIBLE_PROFILE or type(visibility['pages']) is not list or
+            len(visibility['pages']) != len(pages)):
+        fail('pdf_visibility_unproven')
+    for proof, words, (width, height) in zip(visibility['pages'], pages, geometry):
+        _tick(checkpoint)
+        if (type(proof) is not dict or set(proof) != {'width', 'height', 'runs'} or
+                type(proof['width']) not in (int, float) or type(proof['height']) not in (int, float) or
+                not math.isfinite(proof['width']) or not math.isfinite(proof['height']) or
+                abs(proof['width'] - width) > .01 or abs(proof['height'] - height) > .01 or
+                type(proof['runs']) is not list or not 1 <= len(proof['runs']) <= 4096):
+            fail('pdf_visibility_unproven')
+        offset, guards = 0, []
+        for run in proof['runs']:
+            _tick(checkpoint)
+            if (type(run) is not dict or set(run) != {'words', 'font_size'} or
+                    type(run['words']) is not list or not 1 <= len(run['words']) <= MAX_WORDS or
+                    any(type(w) is not str or not w or any(ord(c) < 33 or ord(c) > 126 for c in w)
+                        for w in run['words']) or type(run['font_size']) not in (int, float) or
+                    not 8 <= run['font_size'] <= 72):
+                fail('pdf_visibility_unproven')
+            selected = words[offset:offset+len(run['words'])]
+            if [w['text'] for w in selected] != run['words']:
+                fail('pdf_painted_text_disagreement')
+            if len({w['line'] for w in selected}) != 1:
+                fail('pdf_painted_text_disagreement')
+            em = run['font_size']
+            x0 = min(w['bounds'][0] for w in selected) - em
+            y0 = min(w['bounds'][1] for w in selected) - em
+            x1 = max(w['bounds'][2] for w in selected) + em
+            y1 = max(w['bounds'][3] for w in selected) + em
+            if x0 < 0 or y0 < 0 or x1 > width or y1 > height:
+                fail('pdf_visible_ink_clearance_unproven')
+            guards.append((x0, y0, x1, y1))
+            offset += len(selected)
+        if offset != len(words):
+            fail('pdf_painted_text_disagreement')
+        active = []
+        for guard in sorted(guards, key=lambda b: b[1]):
+            _tick(checkpoint)
+            active = [b for b in active if b[3] > guard[1]]
+            if len(active) > 64:
+                fail('pdf_visible_ink_clearance_unproven')
+            if any(min(guard[2], b[2]) > max(guard[0], b[0]) for b in active):
+                fail('pdf_visible_ink_clearance_unproven')
+            active.append(guard)
+
+def _cell_matches(cell, tokens):
+    if cell['kind'] == 'string':
+        return tokens == cell['value']
+    if len(tokens) != 1:
+        return False
+    token = tokens[0]
+    if cell['kind'] == 'boolean':
+        return token == ('TRUE' if cell['value'] else 'FALSE')
+    if cell['kind'] == 'date':
+        value = date.fromisoformat(cell['value'])
+        return token in (value.isoformat(), value.strftime('%d.%m.%Y'))
+    if cell['kind'] == 'number':
+        if not re.fullmatch(r'[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]{1,3})?', token):
+            return False
+        try:
+            return Decimal(token) == Decimal(cell['value'])
+        except InvalidOperation:
+            return False
+    return False
+
+
+def verify(plan, info, bbox, structure, *, checkpoint=None):
+    """Check independent native parser evidence before create-only publication."""
+    facts = pdf_info(info)
+    pages, geometry = bbox_pages(bbox, checkpoint=checkpoint, with_geometry=True)
+    if (type(structure) is not dict or set(structure) != {'pages', 'engine', 'visibility'} or
+            structure['engine'] != 'libqpdf-12.3.2' or type(structure['pages']) is not int or
+            structure['pages'] != facts['pages'] or len(pages) != facts['pages']):
+        fail('pdf_parser_disagreement')
+    _visible_content(structure['visibility'], pages, geometry, checkpoint)
+    evidence = []
+    if plan['source'] == 'odt':
+        actual = [word['text'] for page in pages for word in page]
+        if actual != plan['words']:
+            fail('pdf_text_changed_missing_or_extra')
+        matched = dict(text_words=len(actual))
+    else:
+        if len(pages) != len(plan['sheets']):
+            fail('pdf_sheet_page_count_changed')
+        for page_id, (cells, words) in enumerate(zip(plan['sheets'], pages)):
+            offset = 0
+            row_lines = {}
+            for cell in cells:
+                _tick(checkpoint)
+                count = len(cell['value']) if cell['kind'] == 'string' else 1
+                selected = words[offset:offset+count]
+                if not _cell_matches(cell, [word['text'] for word in selected]):
+                    fail('pdf_cell_changed_missing_or_extra')
+                if len({w['line'] for w in selected}) != 1:
+                    fail('pdf_wrapped_cell_unsupported')
+                line = selected[0]['line']
+                if cell['row'] in row_lines and row_lines[cell['row']] != line:
+                    fail('pdf_source_row_split')
+                if cell['row'] not in row_lines and row_lines and line <= max(row_lines.values()):
+                    fail('pdf_source_rows_merged_or_reordered')
+                row_lines[cell['row']] = line
+                evidence.append((page_id+1, cell['row'], cell['column'], offset, count,
+                                 [w['bounds'] for w in selected]))
+                offset += count
+            if offset != len(words):
+                fail('pdf_extra_cell_or_page_text')
+        matched = dict(matched_cells=len(evidence), text_words=sum(map(len, pages)))
+    _tick(checkpoint)
+    return dict(profile=PROFILE, pages=len(pages), searchable_text_verified=True,
+                cell_values_verified=plan['source'] != 'odt',
+                formula_results_verified=plan['source_counts'].get('formula_cells', 0),
+                source_semantic_sha256=plan['source_semantic_sha256'],
+                evidence_sha256=hashlib.sha256(json.dumps(evidence if evidence else
+                    [[(w['text'], w['bounds']) for w in p] for p in pages],
+                    ensure_ascii=False, separators=(',', ':')).encode()).hexdigest(),
+                visible_text_verified=True, visible_profile=structure['visibility']['profile'],
+                visual_fidelity_verified=False, layout_limits=LAYOUT_LIMITS,
+                **plan['source_counts'], **matched)
