+        # for a spreadsheet). Unsupported wraps and columns fail the oracle.
+        lines = []
+        active = []
+        for word in sorted(words, key=lambda w: (w['bounds'][1], w['bounds'][0])):
+            x0, y0, x1, y1 = word['bounds']
+            active = [line for line in active if line['y1'] >= y0]
+            if len(active) > 64:
+                fail('pdf_ambiguous_text_layout')
+            matches = [line for line in active if
+                       min(line['y1'], y1) - max(line['y0'], y0) >= .5 * min(line['y1']-line['y0'], y1-y0)]
+            if len(matches) > 1:
+                fail('pdf_ambiguous_text_layout')
+            if matches:
+                line = matches[0]
+                line['words'].append(word)
+                line['y0'], line['y1'] = min(line['y0'], y0), max(line['y1'], y1)
+            else:
+                line = dict(y0=y0, y1=y1, words=[word])
+                lines.append(line)
+                active.append(line)
+        ordered = []
+        previous_bottom = None
+        for line_id, line in enumerate(sorted(lines, key=lambda ln: ln['y0'])):
+            # Distinct visual rows may overlap by less than the grouping
+            # threshold above.  They still cannot be accepted as separate,
+            # readable source rows; reject overlapping vertical bands too.
+            if previous_bottom is not None and line['y0'] < previous_bottom - .5:
+                fail('pdf_overlapping_text')
+            previous_bottom = line['y1']
+            row = sorted(line['words'], key=lambda w: w['bounds'][0])
+            for index, word in enumerate(row):
+                if index and word['bounds'][0] < row[index-1]['bounds'][2] - .5:
+                    fail('pdf_overlapping_text')
+                word['line'] = line_id
+                ordered.append(word)
+        result.append(ordered)
+    return (result, geometry) if with_geometry else result
+
