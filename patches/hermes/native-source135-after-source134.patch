+    if len(body) != 1 or body[0].tag != q('doc'):
+        fail('pdf_bbox_invalid')
+    pages = list(body[0])
+    if not 1 <= len(pages) <= MAX_PAGES or any(p.tag != q('page') for p in pages):
+        fail('pdf_page_limit')
