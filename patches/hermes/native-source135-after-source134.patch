+def _trusted_visible_content(visibility, pages, geometry, checkpoint):
+    if set(visibility)!={'profile','pages'} or type(visibility['pages']) is not list or len(visibility['pages'])!=len(pages):
+        fail('pdf_visibility_unproven')
+    for proof,words,(width,height) in zip(visibility['pages'],pages,geometry):
+        _tick(checkpoint)
+        if (type(proof) is not dict or set(proof)!={'width','height','runs'} or
+                any(type(proof[k]) not in (int,float) or not math.isfinite(proof[k]) for k in ('width','height')) or
+                abs(proof['width']-width)>.01 or abs(proof['height']-height)>.01 or
+                type(proof['runs']) is not list or not 1<=len(proof['runs'])<=4096):
+            fail('pdf_visibility_unproven')
+        offset=0;all_ink=[]
+        for run in proof['runs']:
+            _tick(checkpoint)
+            if (type(run) is not dict or set(run)!={'words','font_size','ink'} or
+                    type(run['words']) is not list or not 1<=len(run['words'])<=MAX_WORDS or
+                    type(run['ink']) is not list or len(run['ink'])!=len(run['words']) or
+                    type(run['font_size']) not in (int,float) or not math.isfinite(run['font_size']) or not 8<=run['font_size']<=72):
+                fail('pdf_visibility_unproven')
+            selected=words[offset:offset+len(run['words'])]
+            if [w['text'] for w in selected]!=run['words'] or len({w['line'] for w in selected})!=1:
+                fail('pdf_painted_text_disagreement')
+            for text,boxes,word in zip(run['words'],run['ink'],selected):
+                if type(text) is not str or not text or len(text)>8192 or type(boxes) is not list or len(boxes)!=len(text):
+                    fail('pdf_visibility_unproven')
+                for b in boxes:
+                    if (type(b) is not list or len(b)!=4 or any(type(v) not in (int,float) or not math.isfinite(v) for v in b) or
+                            not 0<=b[0]<b[2]<=width or not 0<=b[1]<b[3]<=height):
+                        fail('pdf_visibility_unproven')
+                    w=word['bounds']
+                    # Poppler's metric box may be slightly narrower than real
+                    # overhangs; allow one tenth em while still binding position.
+                    tolerance=run['font_size']*.1
+                    if b[0]<w[0]-tolerance or b[1]<w[1]-tolerance or b[2]>w[2]+tolerance or b[3]>w[3]+tolerance:
+                        fail('pdf_painted_geometry_disagreement')
+                    all_ink.append(b)
+            offset+=len(selected)
+        if offset!=len(words):fail('pdf_painted_text_disagreement')
+        active=[]
+        for b in sorted(all_ink,key=lambda b:b[1]):
+            _tick(checkpoint)
+            active=[a for a in active if a[3]>b[1]+.001]
+            if len(active)>4096 or any(min(a[2],b[2])>max(a[0],b[0])+.001 and min(a[3],b[3])>max(a[1],b[1])+.001 for a in active):
+                fail('pdf_overlapping_glyphs')
+            active.append(b)
