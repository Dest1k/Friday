+"""Source and PDF evidence oracle for three fixed native Office exports.
+
+No document is reconstructed here. Inputs pass the existing strict conversion
+inventories and the genuine package is rendered by the family-local adapter.
+The PDF contract requires a separately attested restricted visible text profile,
+then searchable ordered text, or one complete scalar sheet per page. Typography, exact whitespace, pagination and metadata are not retained.
+"""
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import hashlib
+import json
+import math
+import re
+from xml.etree import ElementTree as ET
+
+MAX_PAGES = 64
+MAX_EVIDENCE = 4_000_000
+MAX_WORDS = 20_000
+MAX_SHEETS = 16
+XHTML = 'http://www.w3.org/1999/xhtml'
+PROFILE = 'native_office_visible_pdf_v3'
+VISIBLE_PROFILE = 'base14_black_text_v1'
+TRUSTED_PROFILE = 'trusted_embedded_glyphs_v1'
+LAYOUT_LIMITS = (
+    'ODT: single-column visual reading order, ordered text including table cells; '
+    'whitespace and paragraph/table boundaries are not preserved as PDF semantics. '
+    'XLSX/ODS: each visible nonempty sheet occupies exactly one PDF page in source '
+    'order; scalar values and independently recomputed supported formula results '
+    'must appear in source row/column order, with one unwrapped line per source '
+    'row. No hidden/nonprinted sheets, empty cells carrying text, print ranges, '
+    'headers/footers, extra page text, cropped/overlapping or missing words. '
+    'Visible PDF support admits the former restricted unembedded Base14 ASCII '
+    'profile, Type0/Identity-H CIDFontType2 and restricted one-byte symbolic '
+    'TrueType fonts whose complete declared '
+    'Unicode repertoire matches one fixed trusted TrueType face, including '
+    'outlines, metrics and any used hint programs. Embedded glyph ink is black, '
+    '8–72pt, with positive axis-aligned transforms; only bounded spacing, '
+    'rectangular clipping and white path paint are admitted. Nonwhite path '
+    'paint, including table rules, requires source geometry proof and refuses. '
+    'The proof requires full-em clip/paint clearance and rejects intersecting '
+    'glyph boxes. Validated passive metadata, page tags and MCID/Artifact '
+    'wrappers may preserve the same paint; semantic replacement, images, forms, '
+    'transparency, annotations and optional content remain unsupported. Native paint-order words '
+    'must agree with Poppler. General Office producer compatibility, CFF/fonts '
+    'outside the fixed inventory, shaping/ligatures and visual fidelity remain '
+    'NOT qualified. '
+    'PDF is a derivative; formulas, editable structure and metadata remain in '
+    'the unchanged source, not in the PDF.'
+)
+
+
+class DocumentPDFError(ValueError):
+    """Only finite public refusal codes; never user text or parser diagnostics."""
+
+
+def fail(code):
+    raise DocumentPDFError(code)
+
+
+def _tick(checkpoint):
+    if checkpoint is not None:
+        checkpoint()
+
+
+def _tokens(value):
+    if not isinstance(value, str):
+        fail('pdf_text_profile_unsupported')
+    # These can change shaping, reading order or extraction without a visible
+    # text equivalent. Do not silently normalize them away.
+    if any(ord(c) < 32 and c not in '\t\r\n' or
+           ord(c) in (0x7f, 0xad, 0x200b, 0x200c, 0x200d, 0x2060, 0xfeff) or
+           0x202a <= ord(c) <= 0x202e or 0x2066 <= ord(c) <= 0x2069
+           for c in value):
+        fail('pdf_text_profile_unsupported')
+    return value.split()
+
+
+def preflight(data, source, *, checkpoint=None):
+    """Return private source expectations; never a substitute for native export."""
+    if source not in ('odt', 'xlsx', 'ods'):
+        fail('pdf_source_format_unsupported')
+    _tick(checkpoint)
+    if source == 'odt':
+        from tools.scoped_word_conversion import inventory, WordConversionError
+        try:
+            blocks = inventory(data, 'odt', checkpoint=checkpoint)
+        except WordConversionError as error:
+            raise DocumentPDFError(str(error)) from None
+        paragraphs = [p for b in blocks for p in ([b] if b['type'] != 'table' else
+                      [p for row in b['rows'] for cell in row for p in cell])]
+        words = [word for p in paragraphs for word in _tokens(p['text'])]
+        if not words or len(words) > MAX_WORDS:
+            fail('pdf_text_capacity_or_empty')
+        canonical = json.dumps(blocks, ensure_ascii=False, sort_keys=True, separators=(',', ':')).encode()
+        plan = dict(source=source, words=words, source_semantic_sha256=hashlib.sha256(canonical).hexdigest(),
+                    source_counts=dict(paragraphs=len(paragraphs),
+                        tables=sum(b['type'] == 'table' for b in blocks),
+                        cells=sum(len(row) for b in blocks if b['type'] == 'table' for row in b['rows'])))
+    else:
+        from tools.scoped_spreadsheet_conversion import inventory, evaluate, ConversionRefused
+        from tools.scoped_ods import Spreadsheet, TB, q
+        try:
+            book = inventory(data, source, checkpoint=checkpoint)
+            # Native Office recalculates, but stale source caches cannot serve as
+            # evidence that it exported the intended values. Require valid caches.
+            values = evaluate(book, checkpoint=checkpoint, check_cache=True)
+            if source == 'ods':
+                physical = Spreadsheet(data, 'ods', checkpoint)
+                if any(sheet.get(q(TB, 'print')) in ('false', '0') for sheet in physical.sheets):
+                    fail('pdf_nonprinted_sheet_unsupported')
+        except ConversionRefused as error:
+            raise DocumentPDFError(str(error)) from None
+        if not 1 <= len(book.sheets) <= MAX_SHEETS:
+            fail('pdf_sheet_limit')
+        sheets = []
+        for name, cells in book.sheets:
+            _tick(checkpoint)
+            if not cells:
+                fail('pdf_empty_sheet_unsupported')
+            rows = []
+            for r, c, cell in cells:
+                _tick(checkpoint)
+                if cell.kind == 'string':
+                    value = _tokens(cell.value)
+                    if not value:
+                        fail('pdf_empty_string_cell_unsupported')
+                    if len(value) > 128 or any(len(t) > 256 for t in value):
+                        fail('pdf_cell_text_limit')
+                elif cell.kind == 'number':
+                    value = format(values[(name, r, c)], 'f')
+                elif cell.kind in ('date', 'boolean'):
+                    value = cell.value
+                else:
+                    fail('pdf_cell_type_unsupported')
+                rows.append(dict(row=r, column=c, kind=cell.kind, value=value))
+            sheets.append(rows)
+        plan = dict(source=source, sheets=sheets, source_semantic_sha256=book.digest(),
+                    source_counts=book.counts())
+    plan['source_sha256'] = hashlib.sha256(data).hexdigest()
+    _tick(checkpoint)
+    return plan
+
+
+def pdf_info(data):
+    if not isinstance(data, bytes) or not 0 < len(data) <= 8192:
+        fail('pdf_info_invalid')
+    fields = {}
+    for name, pattern in (
+        ('pages', rb'^Pages:\s+([1-9][0-9]*)\s*$'),
+        ('encrypted', rb'^Encrypted:\s+(no)\s*$'),
+        ('javascript', rb'^JavaScript:\s+(no)\s*$'),
+        ('form', rb'^Form:\s+(none)\s*$'),
+        ('version', rb'^PDF version:\s+(1\.[0-7]|2\.0)\s*$'),
+    ):
+        matches = re.findall(pattern, data, re.M)
+        # A metadata-injected second field must fail, including an invalid value.
+        label = {'pages': b'Pages', 'encrypted': b'Encrypted', 'javascript': b'JavaScript',
+                 'form': b'Form', 'version': b'PDF version'}[name]
+        if len(matches) != 1 or len(re.findall(rb'^' + re.escape(label) + rb':', data, re.M)) != 1:
+            fail('pdf_info_invalid')
+        fields[name] = matches[0].decode('ascii')
+    fields['pages'] = int(fields['pages'])
+    if fields['pages'] > MAX_PAGES:
+        fail('pdf_page_limit')
+    return fields
+
+
+def _number(raw):
+    try:
+        value = float(raw)
+    except (TypeError, ValueError):
+        fail('pdf_bbox_invalid')
+    if not math.isfinite(value):
+        fail('pdf_bbox_invalid')
+    return value
+
+
+def _bounds(node, width, height):
+    if set(node.attrib) != {'xMin', 'yMin', 'xMax', 'yMax'}:
+        fail('pdf_bbox_invalid')
+    x0, y0, x1, y1 = (_number(node.get(k)) for k in ('xMin', 'yMin', 'xMax', 'yMax'))
+    if not (0 <= x0 < x1 <= width + .5 and 0 <= y0 < y1 <= height + .5):
+        fail('pdf_cropped_or_invalid_text')
+    return x0, y0, x1, y1
+
+
+def bbox_pages(data, *, checkpoint=None, with_geometry=False):
+    if not isinstance(data, bytes) or not 0 < len(data) <= MAX_EVIDENCE:
+        fail('pdf_bbox_limit')
+    if b'<!ENTITY' in data.upper() or b'<![' in data:
+        fail('pdf_bbox_invalid')
+    # Poppler emits this inert XHTML declaration. ET never fetches external DTDs.
+    doctypes = re.findall(rb'<!DOCTYPE[^>]*>', data, re.I)
+    if doctypes and (len(doctypes) != 1 or doctypes[0] !=
+        b'<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">'):
+        fail('pdf_bbox_invalid')
