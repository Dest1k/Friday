@@ -0,0 +1,161 @@
+"""Internal settlement and single-buffer protected receipt join for the owned D02 arm."""
+
+import asyncio
+from hashlib import sha256
+from importlib import import_module
+import json
+import math
+from pathlib import Path
+import time
+
+from gateway import pairing
+from gateway.d02_receiver_state import check_receiver_state
+from gateway.session_identity import identity_of
+from hermes_cli import friday_product_access as access, friday_user_scope as scope
+from hermes_constants import get_hermes_home
+
+_ROUTE = ("session_key", "source_profile", "transport_profile", "runtime_profile")
+
+
+def encode_closed_wire(wire):
+    return (json.dumps(wire, sort_keys=True, ensure_ascii=True, allow_nan=False) + "\n").encode("utf-8")
+
+
+def _unknown(reason):
+    return {"state": "UNKNOWN", "reason": reason, "observations": None}
+
+
+def _number(value):
+    return type(value) in (int, float) and 0 <= value < 2**63 and math.isfinite(value)
+
+
+def _current_adapter(adapter):
+    runner = adapter.gateway_runner
+    return runner is not None and runner.adapters.get(adapter.platform) is adapter
+
+
+def _snapshot(adapter, arm, claim_sha256, wire_sha256, revision, cutoff):
+    evidence = arm.ingress
+    if (asyncio.get_running_loop() is not arm.claim.loop
+            or getattr(adapter, "_ordinary_dm_wire_arm", None) is not arm
+            or not _current_adapter(adapter) or arm.window._cutoff != cutoff):
+        raise ValueError("d02_dispatch_owner_or_cutoff_changed")
+    data = adapter._ordinary_dm_wire_ingress_readback(claim_sha256)
+    if data is None or data["state"] != "OBSERVED_PENDING_CALLER_CLOSURE":
+        raise ValueError("d02_dispatch_outcomes_unavailable")
+    raw = encode_closed_wire(data["wire"])
+    if data["revision"] != revision or sha256(raw).hexdigest() != wire_sha256:
+        raise ValueError("d02_dispatch_wire_or_revision_changed")
+    ids = data["wire"]["target_update_ids"]
+    if not ids or data["held_update_ids"]:
+        raise ValueError("d02_dispatch_empty_or_held")
+    if (len(data["committed_pairs"]) != len(ids)
+            or any((evidence._built[update].handoff, evidence._built[update].settled)
+                   != ("returned", True) for update in ids)):
+        raise ValueError("d02_native_dispatch_unsettled")
+    key = evidence.scope["session_key"]
+    if (key in adapter._pending_messages or key in adapter._text_debounce or key in adapter._active_sessions
+            or key in adapter._session_tasks):
+        raise ValueError("d02_selected_session_still_owned_or_pending")
+    return data, raw
+
+
+def _exact_route(adapter, evidence, options, scenario):
+    source = evidence._receipt_source
+    identity = identity_of(source)
+    selected = evidence.scope
+    tester = str(evidence.claim.user_id)
+    principal = options["principal"]
+    home = Path(selected["authorization_home"])
+    profile = selected["runtime_profile"]
+    routed = Path(selected["runtime_home"])
+    if (identity is None or identity.transport_inferred or identity.adapter() is not adapter
+            or not evidence._selected_source(source) or (source.profile or "") != selected["source_profile"]
+            or identity.authorization_home != home or identity.runtime_home != routed
+            or routed != home / "profiles" / profile
+            or identity.transport_profile != selected["transport_profile"] or identity.runtime_profile != profile
+            or options["profile"] != profile
+            or (principal["platform"], principal["transport_profile"], principal["account_id"], principal["user_id"])
+            != ("telegram", selected["transport_profile"], str(selected["bot_id"]), tester)
+            or (scenario["tester_id"], scenario["peer_id"]) != (evidence.claim.user_id, selected["bot_id"])
+            or scenario["max_updates"] != evidence.claim.max_updates):
+        raise ValueError("d02_dispatch_routed_scope_changed")
+    return home, profile, routed, principal
+
+
+def _storage_signature(state):
+    directory = state.directory_storage_readonly
+    return tuple((entry.st_dev, entry.st_ino, entry.st_uid, entry.st_mode, entry.st_nlink,
+                  entry.st_size, entry.st_mtime_ns, entry.st_ctime_ns)
+                 for entry in (path.lstat() for path in (
+                     directory, directory / ".state.json.lock", directory / "state.json")))
+
+
+def join_settled_ordinary_dm(adapter, *, claim_sha256, wire_sha256, disposition_revision, cutoff,
+                             options, scenario, transport_deadline):
+    """Return private matcher inputs at a protected boundary already authenticated by Root.
+
+    Invoke synchronously on the owning loop. Keep the returned receipt pairs in
+    the existing private evidence path. This function neither retires the arm
+    nor decides an ACK match, authorizes an effect, or writes anything.
+    """
+    if (type(disposition_revision) is not int or disposition_revision < 0
+            or not _number(cutoff) or not _number(transport_deadline)):
+        return _unknown("d02_invalid_dispatch_join_binding")
+    try:
+        arm = adapter._ordinary_dm_wire_arm
+        if (arm is None or arm.ingress is None or type(claim_sha256) is not str
+                or arm.claim.claim_sha256 != claim_sha256):
+            return _unknown("d02_exact_dispatch_arm_required")
+        deadline = min(transport_deadline, arm.claim.expires_monotonic, time.monotonic() + 2)
+        if time.monotonic() >= deadline:
+            return _unknown("d02_dispatch_join_expired")
+        before, raw = _snapshot(adapter, arm, claim_sha256, wire_sha256, disposition_revision, cutoff)
+        evidence = arm.ingress
+        admissions = before["admissions"]
+        if admissions is not evidence._admissions or admissions is None:
+            return _unknown("d02_exact_routed_writer_required")
+        home, profile, routed, principal = _exact_route(adapter, evidence, options, scenario)
+        package, separator, name = type(admissions).__module__.rpartition(".")
+        if not separator or name != "admission":
+            return _unknown("d02_exact_routed_writer_package_required")
+        consumer = import_module(".d02_wire_receipts", package)
+        state = admissions.state
+
+        def read_verified(selected_state, bound):
+            if selected_state is not state:
+                raise ValueError("d02_routed_writer_state_changed")
+            data, observed = check_receiver_state(
+                home, profile=profile, expected_principal=principal, rights=options["rights"],
+                state=state, access=access, scope=scope, pairing=pairing, phase="post_dispatch",
+                deadline=bound,
+            )
+            return data, observed["routed"]
+
+        with scope.authority(routed):
+            if Path(get_hermes_home()) != routed:
+                return _unknown("d02_receipt_join_home_not_bound")
+            storage = _storage_signature(state)
+            joined = consumer.read_closed_wire_receipts(
+                admissions, wire_bytes=raw, wire_sha256=wire_sha256, generation=arm.claim.generation,
+                armed_at=arm.armed_monotonic, cutoff=cutoff, expires=arm.claim.expires_monotonic,
+                scenario=scenario, route={key: evidence.scope[key] for key in _ROUTE},
+                committed_pairs=before["committed_pairs"], held_update_ids=before["held_update_ids"],
+                lock_deadline=deadline, _protected_reader=read_verified,
+            )
+            if _storage_signature(state) != storage:
+                return _unknown("d02_routed_store_changed_during_join")
+        after, final_raw = _snapshot(adapter, arm, claim_sha256, wire_sha256, disposition_revision, cutoff)
+        _exact_route(adapter, evidence, options, scenario)
+        if (time.monotonic() >= deadline or admissions.state is not state
+                or after["admissions"] is not admissions or before["committed_pairs"] != after["committed_pairs"]
+                or final_raw != raw):
+            return _unknown("d02_dispatch_join_drift")
+        if joined["state"] != "WIRE_RECEIPT_PAIRS_RESOLVED":
+            return _unknown("d02_protected_pairs_unresolved")
+        return {"state": "D02_NATIVE_DISPATCH_SETTLED_PAIRS_RESOLVED", "reason": None,
+                "claim_sha256": claim_sha256, "generation": arm.claim.generation,
+                "wire_sha256": wire_sha256, "disposition_revision": disposition_revision,
+                "store_identity": joined["store_identity"], "observations": joined["observations"]}
+    except (OSError, RuntimeError, ValueError, AttributeError, TypeError, KeyError, IndexError, ImportError):
+        return _unknown("d02_native_dispatch_or_protected_join_unproved")
