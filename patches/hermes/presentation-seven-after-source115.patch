+def drawing_text(node):
+    paragraphs = []; size = 0
+    for paragraph in node.iter(q(A, 'p')):
+        chunks = []
+        for part in paragraph.iter():
+            value = part.text or '' if part.tag == q(A, 't') else '\n' if part.tag == q(A, 'br') else '\t' if part.tag == q(A, 'tab') else ''
+            size += len(value.encode('utf-8'))
+            if size > 500_000: refuse('native_text_limit')
+            chunks.append(value)
+        paragraphs.append(''.join(chunks))
+    return '\n'.join(paragraphs)
+
