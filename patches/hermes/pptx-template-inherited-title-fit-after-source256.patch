+    local_text = title.find(text_path)
+    bare_body, bare_list, para = ('{%s}%s' % (A, name) for name in ('bodyPr', 'lstStyle', 'p'))
+    if (title_ph is None or title_ph.attrib != {'type': 'title'} or local_style is None or
+            local_style.attrib or len(local_style) or local_text is None or
+            [node.tag for node in local_text] != [bare_body, bare_list, para] or
+            any(node.attrib or len(node) for node in local_text[:2])):
+        return None
+    paragraph = local_text[2]
+    run_tag, text_tag = ('{%s}%s' % (A, name) for name in ('r', 't'))
+    if paragraph.attrib or len(paragraph) != 1 or paragraph[0].tag != run_tag:
+        return None
+    run = paragraph[0]
+    if run.attrib or len(run) != 1 or run[0].tag != text_tag or len(run[0]) or run[0].text != value:
+        return None
+
+    try:
+        _, chain, master, master_name = _text_chain(parts, owner, title)
+    except PresentationRefused:
+        return None  # Preserve the existing unchanged-text behavior outside this profile.
+    if len(chain) != 3:
+        return None
+    layout_title, master_title = chain[1:]
+    inherited = layout_title.find(text_path)
+    layout_box = layout_title.find('{%s}spPr' % P)
+    layout_body = inherited.find(bare_body) if inherited is not None else None
+    layout_list = inherited.find(bare_list) if inherited is not None else None
+    if (layout_box is None or layout_box.attrib or len(layout_box) or
+            layout_body is None or layout_body.attrib or len(layout_body) or
+            layout_list is None or layout_list.attrib or len(layout_list)):
+        return None
+    master_text = master_title.find(text_path)
+    master_body = master_text.find(bare_body) if master_text is not None else None
+    master_list = master_text.find(bare_list) if master_text is not None else None
+    if (master_body is None or master_body.attrib != {
+            'vert': 'horz', 'lIns': '91440', 'rIns': '91440', 'tIns': '45720',
+            'bIns': '45720', 'rtlCol': '0', 'anchor': 'ctr'} or
+            len(master_body) != 1 or master_body[0].tag != '{%s}normAutofit' % A or
+            master_body[0].attrib or len(master_body[0]) or
+            master_list is None or master_list.attrib or len(master_list)):
+        return None
+
+    inherited_overrides = {'{%s}%s' % (A, tag) for tag in ('pPr', 'defRPr', 'rPr', 'endParaRPr')}
+    for parent in (inherited, master_text):
+        for node in parent.iter():
+            if node.tag not in inherited_overrides:
+                continue
+            if (node.tag not in ('{%s}rPr' % A, '{%s}endParaRPr' % A) or len(node) or
+                    node.attrib.keys() - {'lang', 'smtClean'}):
+                return None
+
+    style = master.find('{%s}txStyles/{%s}titleStyle' % (P, P))
+    level_tag = '{%s}lvl1pPr' % A
+    if style is None or len(style) != 1 or style[0].tag != level_tag or style[0].attrib != {
+            'algn': 'ctr', 'defTabSz': '457200', 'rtl': '0', 'eaLnBrk': '1',
+            'latinLnBrk': '0', 'hangingPunct': '1'}:
+        return None
+    level = style[0]
+    if ([node.tag for node in level] != ['{%s}spcBef' % A, '{%s}buNone' % A, '{%s}defRPr' % A] or
+            len(level[0]) != 1 or level[0][0].tag != '{%s}spcPct' % A or level[0][0].attrib != {'val': '0'}):
+        return None
+    defaults = level[2]
+    if (defaults.attrib != {'sz': '4400', 'kern': '1200'} or
+            [node.tag for node in defaults] != ['{%s}%s' % (A, tag)
+                                                for tag in ('solidFill', 'latin', 'ea', 'cs')] or
+            defaults[1].attrib != {'typeface': '+mj-lt'}):
+        return None
+    links = [item for item in _rels(parts, _relpath(master_name)).values()
+             if item.get('Type') == R + '/theme']
+    if len(links) != 1:
+        return None
+    theme = _xml(parts[_resolve(master_name, links[0].get('Target', ''))])
+    major = theme.find('{%s}themeElements/{%s}fontScheme/{%s}majorFont' % (A, A, A))
+    latin = major.findall('{%s}latin' % A) if major is not None else []
+    if (len(latin) != 1 or latin[0].get('typeface') != 'Calibri' or
+            any(item.get('script') == 'Cyrl' for item in major.findall('{%s}font' % A))):
+        return None
+
+    title_box = _plain_box(master_title)
+    body_box = _plain_box(body)
+    body_properties = body.find(text_path + '/' + bare_body)
+    if (title_box is None or body_box is None or body.find(ph_path) is not None or
+            body_properties is None or body_properties.attrib != {'wrap': 'none'} or
+            len(body_properties) != 1 or body_properties[0].tag != '{%s}spAutoFit' % A or
+            body_properties[0].attrib or len(body_properties[0])):
+        return None
+    x, y, width, height = title_box
+    bx, by, bw, bh = body_box
+    if not (min(width, height, bw, bh) > 0 and x < bx + bw and bx < x + width and y < by < y + height):
+        return None
+    inner_width = width - 14.4
+    if advance * 44 <= inner_width:
+        return None
+
+    # Leave width for kerning/rounding and keep a 1.3-em line box above the
+    # lower slot's inset text area. Keep the inherited center anchor and box.
+    center = y + height / 2
