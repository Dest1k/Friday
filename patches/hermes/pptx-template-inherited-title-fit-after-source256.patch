+def _title_advance(value):
+    units = 0
+    for character in value:
+        point = ord(character)
+        if 32 <= point <= 126:
+            units += _TITLE_ASCII_ADVANCES[point - 32]
+        elif 0x410 <= point <= 0x44f:
+            units += _TITLE_CYRILLIC_ADVANCES[point - 0x410]
+        elif character in _TITLE_YO_ADVANCES:
+            units += _TITLE_YO_ADVANCES[character]
+        else:
+            return None
+    return units / 2048
+
+
+def _plain_box(shape):
+    transform = shape.find('{%s}spPr/{%s}xfrm' % (P, A))
+    if transform is None or transform.attrib:
+        return None
+    offset = transform.find('{%s}off' % A)
+    extent = transform.find('{%s}ext' % A)
+    if offset is None or extent is None:
+        return None
+    raw = (offset.get('x'), offset.get('y'), extent.get('cx'), extent.get('cy'))
+    if any(not value or not value.isascii() or not value.isdecimal() or len(value) > 9 for value in raw):
+        return None
+    return tuple(int(value) / 12700 for value in raw)
+
+
+def _unchanged_title_size(parts, owner, title, body, value):
+    """Fit a wrapping inherited Calibri title over a direct, lower body slot."""
+    advance = _title_advance(value)
+    if not advance:
+        return None
+    ph_path = '{%s}nvSpPr/{%s}nvPr/{%s}ph' % (P, P, P)
+    text_path = '{%s}txBody' % P
+    title_ph = title.find(ph_path)
