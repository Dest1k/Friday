diff --git a/gateway/ordinary_f04_bridge.py b/gateway/ordinary_f04_bridge.py
new file mode 100644
--- /dev/null
+++ b/gateway/ordinary_f04_bridge.py
@@ -0,0 +1,621 @@
+"""Bounded opt-in F04 ownership evidence on existing gateway lifecycles.
+
+This is host metadata only. Root authentication/current-rights/source/kernel checks
+belong to the existing control projection. No user text, model input, files, queue,
+network send, timer, or lifecycle is created by this module.
+"""
+from __future__ import annotations
+
+from contextvars import ContextVar
+from copy import deepcopy
+import hashlib
+import json
+import math
+from pathlib import Path
+import re
+import time
+
+_REQUEST = 'frw.gateway.f04-owned-request.v1'
+_CAPABILITY = 'ordinary-f04-owned-ingress-stop-terminal.v1'
+_MAX_RECORDS = 8
+_MAX_BYTES = 1_000_000
+_CURRENT = ContextVar('ordinary_f04_host_target', default=None)
+
+
+def canonical_sha256(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
+                                     allow_nan=False).encode('utf-8')).hexdigest()
+
+
+def _hex(value):
+    return isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value) is not None
+
+
+def _string(value, maximum=256, *, empty=False):
+    return (isinstance(value, str) and (empty or bool(value)) and len(value) <= maximum
+            and value == value.strip() and not any(ord(c) < 32 for c in value))
+
+
+def _number(value):
+    return type(value) in (int, float) and math.isfinite(value)
+
+
+def _decimal(value, *, signed=False, empty=False):
+    if empty and value == '':
+        return True
+    return (isinstance(value, str) and len(value) <= 32 and value.isascii()
+            and (value.lstrip('-').isdecimal() if signed else value.isdecimal())
+            and str(int(value)) == value and (int(value) != 0 if signed else int(value) > 0))
+
+
+def capability():
+    return {'schema': 'frw.gateway.f04-owned-capability.v1', 'capability': _CAPABILITY,
+            'request_schema': _REQUEST, 'implementation_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+            'original_own_ingress': True, 'verified_samebyte': True,
+            'typed_ctx_lease': True, 'retained_terminal': True,
+            'native_id_namespace': 'native.telegram', 'tester_id_namespace': 'tester.telegram',
+            'max_records': _MAX_RECORDS, 'max_attachment_bytes': _MAX_BYTES,
+            'max_outer_seconds': 600, 'max_metadata_seconds': 720, 'root_authenticated_by': 'existing-control-projection'}
+
+
+def _base(request):
+    if not isinstance(request, dict):
+        raise ValueError('f04_request_shape')
+    fields = {'schema', 'scope_id', 'source_receipt_sha256', 'metadata_created_monotonic', 'metadata_expires_monotonic', 'selector'}
+    if set(request) - (fields | {'tester_ack', 'binding_sha256', 'target', 'ordinary_clock'}) or not fields <= set(request):
+        raise ValueError('f04_request_fields')
+    base = {key: deepcopy(request[key]) for key in fields}
+    selector = base['selector']
+    if (base['schema'] != _REQUEST or not isinstance(base['scope_id'], str)
+            or re.fullmatch(r'root-f04-[A-Za-z0-9_-]{1,80}', base['scope_id']) is None
+            or not _hex(base['source_receipt_sha256'])
+            or not _number(base['metadata_created_monotonic']) or not _number(base['metadata_expires_monotonic'])
+            or not base['metadata_created_monotonic'] < base['metadata_expires_monotonic'] <= base['metadata_created_monotonic'] + 720
+            or not isinstance(selector, dict)
+            or set(selector) != {'principal', 'input', 'caption_sha256', 'window', 'tester'}):
+        raise ValueError('f04_selector_shape')
+    principal = selector['principal']
+    if (not isinstance(principal, dict) or set(principal) != {
+            'platform', 'transport_profile', 'runtime_profile', 'bot_id', 'user_id', 'chat_id', 'thread_id'}
+            or principal['platform'] != 'telegram'
+            or not all(_string(principal[k], 128) for k in ('transport_profile', 'runtime_profile'))
+            or not all(_decimal(principal[k]) for k in ('bot_id', 'user_id'))
+            or not _decimal(principal['chat_id'], signed=True)
+            or not _decimal(principal['thread_id'], empty=True)):
+        raise ValueError('f04_principal_shape')
+    content, window, tester = selector['input'], selector['window'], selector['tester']
+    if (not isinstance(content, dict) or set(content) != {'sha256', 'size_bytes'}
+            or not _hex(content['sha256']) or type(content['size_bytes']) is not int
+            or not 0 <= content['size_bytes'] <= _MAX_BYTES or not _hex(selector['caption_sha256'])
+            or not isinstance(window, dict) or set(window) != {'not_before_monotonic', 'not_after_monotonic'}
+            or not all(_number(window[k]) for k in window)
+            or not window['not_before_monotonic'] < window['not_after_monotonic'] <= base['metadata_expires_monotonic']
+            or not isinstance(tester, dict) or set(tester) != {'namespace', 'send_commitment_sha256'}
+            or tester['namespace'] != 'tester.telegram' or not _hex(tester['send_commitment_sha256'])):
+        raise ValueError('f04_content_window_tester_shape')
+    committed = deepcopy(base)
+    committed['selector'].pop('tester')
+    if tester['send_commitment_sha256'] != canonical_sha256(committed):
+        raise ValueError('f04_send_commitment')
+    return base
+
+
+def _records(runner, *, create=False):
+    value = getattr(runner, '_ordinary_f04_host_records', None)
+    if value is None and create:
+        value = {}
+        runner._ordinary_f04_host_records = value
+    return value if isinstance(value, dict) else {}
+
+
+def arm(runner, request):
+    base = _base(request)
+    now = time.monotonic()
+    window = base['selector']['window']
+    if (set(request) != set(base) or not base['metadata_created_monotonic'] <= now < base['metadata_expires_monotonic']
+            or now - base['metadata_created_monotonic'] > 120
+            or not now <= window['not_before_monotonic'] < window['not_after_monotonic'] <= base['metadata_expires_monotonic']):
+        raise ValueError('f04_arm_future_bound')
+    records = _records(runner, create=True)
+    if base['scope_id'] in records:
+        raise ValueError('f04_arm_already_exists')
+    # No live record evicts; expired bounded evidence may be replaced on a NEW arm.
+    if len(records) >= _MAX_RECORDS:
+        expired = [key for key, row in records.items() if now > row['base']['metadata_expires_monotonic']]
+        for key in expired:
+            disarm(runner, records[key]['base'])
+            del records[key]
+            if len(records) < _MAX_RECORDS:
+                break
+    if len(records) >= _MAX_RECORDS:
+        raise ValueError('f04_host_metadata_full')
+    records[base['scope_id']] = {'base': base, 'request_sha256': canonical_sha256(base),
+        'candidates': [], 'error': None, 'artifacts': [], 'cancel': None, 'disarmed': False}
+    return {'schema': 'frw.gateway.f04-owned-arm.v1', 'state': 'ARMED',
+            'scope_id': base['scope_id'], 'selector_sha256': canonical_sha256(base['selector']),
+            'request_sha256': canonical_sha256(base)}
+
+
+def _record(runner, request):
+    base = _base(request)
+    row = _records(runner).get(base['scope_id'])
+    if row is None or row['base'] != base:
+        raise ValueError('f04_unarmed_or_selector_changed')
+    if row['error'] is not None:
+        raise ValueError(row['error'])
+    return row
+
+
+def _source_principal(source):
+    cap = getattr(source, '_friday_user_scope', None)
+    if cap is None:
+        return None
+    return {'platform': cap.principal[0], 'transport_profile': cap.principal[1],
+            'runtime_profile': cap.profile, 'bot_id': cap.principal[2], 'user_id': cap.principal[3],
+            'chat_id': source.chat_id, 'thread_id': source.thread_id or ''}
+
+
+def _lease_dict(token):
+    return {'session_id': token.session_id, 'owner_key': token.owner_key,
+            'generation': token.generation, 'released': token.released}
+
+
+def mark_original_event(event):
+    """Called only by the actual SDK event constructor; never deserialized."""
+    event._ordinary_f04_original_stamp = (event.raw_message, event.platform_update_id, time.monotonic())
+
+
+def bind_turn(runner, event, source, session_entry, quick_key, generation):
+    """Called after actual acquire; never interrupts ordinary preparation on error."""
+    _CURRENT.set(None)
+    selected = []
+    try:
+        now = time.monotonic()
+        stamp = getattr(event, '_ordinary_f04_original_stamp', None)
+        ingress_at = stamp[2] if isinstance(stamp, tuple) and len(stamp) == 3 else now
+        principal = _source_principal(source)
+        selected = [row for row in _records(runner).values()
+                    if not row['disarmed'] and now <= row['base']['metadata_expires_monotonic']
+                    and row['base']['selector']['principal'] == principal
+                    and row['base']['selector']['window']['not_before_monotonic'] <= ingress_at
+                    <= row['base']['selector']['window']['not_after_monotonic']]
+        if not selected:
+            return
+        if len(selected) != 1:
+            raise ValueError('f04_overlapping_observation_windows')
+        row = selected[0]
+        state = runner._peek_session_state(quick_key)
+        token = None if state is None else state.turn.lease_tokens.get(generation)
+        if (not isinstance(stamp, tuple) or len(stamp) != 3 or stamp[0] is not event.raw_message
+                or stamp[1] != event.platform_update_id or not _number(stamp[2])
+                or stamp[2] > now or event.internal or event._ingress_merged or event.raw_message is None
+                or source is not event.source or type(generation) is not int or generation <= 0
+                or state is None or state.persistent.run_generation != generation
+                or state.turn.event is not event or token is None
+                or token.session_id != session_entry.session_id or token.owner_key != quick_key
+                or token.generation != generation or token.released is not False
+                or token.lease.holder is not token or not token.lease.lock.locked()
+                or session_entry.session_key != quick_key):
+            raise ValueError('f04_original_event_lease_required')
+        if len(row['candidates']) >= 2:
+            raise ValueError('f04_multiple_ingress')
+        adapter = runner._delivery_adapter_for(source)
+        delivery_guard = getattr(adapter, '_active_sessions', {}).get(quick_key)
+        target = {'row': row, 'runner': runner, 'event': event, 'source': source, 'token': token,
+                  'session_id': session_entry.session_id, 'session_key': quick_key,
+                  'generation': generation, 'bound_monotonic': now, 'ingress_monotonic': ingress_at, 'ctx': None, 'ctx_fields': None,
+                  'receipt': None, 'dispatch_finalized': False, 'worker_done': None,
+                  'executor_task': None, 'worker_ctx': None, 'worker_settled': False,
+                  'delivery_guard': delivery_guard, 'lease_before': _lease_dict(token)}
+        row['candidates'].append(target)
+        if len(row['candidates']) != 1:
+            raise ValueError('f04_multiple_ingress')
+        event._ordinary_f04_host_target = target
+        _CURRENT.set(target)
+    except Exception:
+        for row in selected:
+            row['error'] = 'f04_original_event_binding_rejected'
+
+
+def capture_verified_ingress(event, proof, staged):
+    """Consume only the actual custody consumer's immutable verified byte values.
+
+    ``staged`` comes from _rehome_user_attachments AFTER _verified_bytes and
+    cap.check. No receipt path is opened here, and file bytes are never retained.
+    """
+    target = getattr(event, '_ordinary_f04_host_target', None)
+    if not isinstance(target, dict):
+        return
+    row = target['row']
+    if row['disarmed']:
+        return
+    try:
+        if target['event'] is not event or target['receipt'] is not None:
+            raise ValueError('f04_duplicate_custody_hook')
+        selector = row['base']['selector']
+        message = proof['message']
+        principal = {'platform': proof['platform'], 'transport_profile': proof['transport_profile'],
+                     'runtime_profile': proof['runtime_profile'], **{key: message[key] for key in
+                         ('bot_id', 'user_id', 'chat_id', 'thread_id')}}
+        raw = event.raw_message
+        caption = raw.caption if raw.caption is not None else raw.text
+        caption = caption if caption is not None else ''
+        media = message['media']
+        if (event.internal or event._ingress_merged or raw is None or raw.document is None
+                or principal != selector['principal'] or proof.get('source_profile') not in ('', principal['runtime_profile'])
+                or not isinstance(caption, str) or hashlib.sha256(caption.encode('utf-8')).hexdigest() != selector['caption_sha256']
+                or len(staged) != 1 or len(media) != 1 or len(event.media_urls) != 1):
+            raise ValueError('f04_original_own_document_required')
+        raw_path, _, data, content, receipt = staged[0]
+        item = media[0]
+        origin = item['origin']
+        if (type(data) is not bytes or item.get('local_reference') != raw_path
+                or content != selector['input'] or item.get('content') != content
+                or receipt.get('content') != content
+                or receipt.get('origin') != {k: v for k, v in origin.items() if k != 'thread_id'}
+                or len(data) != content['size_bytes'] or hashlib.sha256(data).hexdigest() != content['sha256']
+                or origin['message_id'] != message['message_id']
+                or message['message_id'] != str(event.message_id)
+                or origin['file_id'] != raw.document.file_id or origin['file_unique_id'] != raw.document.file_unique_id
+                or (origin.get('declared_bytes') is not None and origin['declared_bytes'] != len(data))):
+            raise ValueError('f04_verified_own_bytes_required')
+        target['receipt'] = {'schema': 'frw.gateway.f04-original-own-ingress.v1',
+            'namespace': 'native.telegram', 'principal': principal,
+            'message_id': message['message_id'], 'platform_update_id': message['platform_update_id'],
+            'reply_to_message_id': message['reply_to_message_id'],
+            'input': deepcopy(content), 'caption_sha256': selector['caption_sha256'],
+            'origin_sha256': canonical_sha256(origin), 'source_receipt_sha256': row['base']['source_receipt_sha256'],
+            'observed_monotonic': target['ingress_monotonic'], 'verified_by': 'run_inbound_media._verified_bytes'}
+    except Exception:
+        row['error'] = 'f04_verified_original_ingress_rejected'
+
+
+def observe_context(runner, ctx):
+    target = _CURRENT.get()
+    if not isinstance(target, dict) or target['runner'] is not runner:
+        candidates = [item for row in _records(runner).values() if not row['disarmed']
+                      for item in row['candidates'] if item['session_key'] == ctx.session_key
+                      and item['generation'] == ctx.run_generation and not item['dispatch_finalized']]
+        target = candidates[0] if len(candidates) == 1 else None
+    if target is None or target['row']['disarmed']:
+        return
+    try:
+        state = runner._peek_session_state(target['session_key'])
+        if (state is None or state.turn.ctx is not ctx or state.turn.event is not target['event']
+                or ctx.session_key != target['session_key'] or ctx.session_id != target['session_id']
+                or ctx.run_generation != target['generation']
+                or str(ctx.inbound_message_id) != str(target['event'].message_id)
+                or state.turn.lease_tokens.get(target['generation']) is not target['token']):
+            raise ValueError('f04_ctx_binding')
+        if ((target['ctx'] is not None and target['ctx'] is not ctx)
+                or (target['worker_ctx'] is not None and target['worker_ctx'] is not ctx)):
+            raise ValueError('f04_ctx_replacement')
+        target['ctx'] = ctx
+        target['ctx_fields'] = {'session_id': ctx.session_id, 'session_key': ctx.session_key,
+                                'run_generation': ctx.run_generation,
+                                'inbound_message_id': str(ctx.inbound_message_id)}
+    except Exception:
+        target['row']['error'] = 'f04_ctx_binding_rejected'
+
+
+def observe_worker(runner, ctx, worker):
+    """Retain the existing executor completion witnesses, never create/wait work."""
+    try:
+        candidates = [item for row in _records(runner).values() if not row['disarmed']
+                      for item in row['candidates'] if item['session_key'] == ctx.session_key
+                      and item['generation'] == ctx.run_generation and not item['dispatch_finalized']]
+        if not candidates:
+            return
+        if len(candidates) != 1:
+            raise ValueError('f04_unique_worker_target')
+        target = candidates[0]
+        if (ctx.session_id != target['session_id'] or str(ctx.inbound_message_id) != str(target['event'].message_id)
+                or worker.executor_task is None or not callable(getattr(worker.executor_task, 'done', None))
+                or not callable(getattr(worker.worker_done, 'is_set', None))
+                or target['worker_done'] is not None or target['executor_task'] is not None
+                or (target['ctx'] is not None and target['ctx'] is not ctx)):
+            raise ValueError('f04_actual_worker_required')
+        target['worker_done'], target['executor_task'] = worker.worker_done, worker.executor_task
+        target['worker_ctx'] = ctx
+    except Exception:
+        for row in _records(runner).values():
+            for item in row['candidates']:
+                if item['session_key'] == getattr(ctx, 'session_key', None) and item['generation'] == getattr(ctx, 'run_generation', None):
+                    row['error'] = 'f04_worker_binding_rejected'
+
+
+def _worker_settled(target):
+    if target['worker_done'] is not None and target['executor_task'] is not None:
+        return (target['worker_done'].is_set() and target['executor_task'].done()
+                and not target['executor_task'].cancelled())
+    return target['worker_settled'] is True
+
+
+def _candidate(row):
+    if len(row['candidates']) != 1:
+        raise ValueError('f04_unique_original_ingress_required')
+    target = row['candidates'][0]
+    if target['receipt'] is None:
+        raise ValueError('f04_verified_ingress_not_available')
+    return target
+
+
+def _native_target(target, observation, *, live):
+    token, ctx, event = target['token'], target['ctx'], target['event']
+    fields = target['ctx_fields']
+    if fields is None:
+        raise ValueError('f04_actual_ctx_not_retained')
+    user = observation.get('latest_user_row')
+    if (not isinstance(user, dict) or set(user) != {'id', 'platform_message_id'}
+            or type(user['id']) is not int or user['id'] <= 0
+            or str(user['platform_message_id']) != target['receipt']['message_id']
+            or fields['session_key'] != target['session_key'] or fields['session_id'] != target['session_id']
+            or fields['run_generation'] != target['generation']
+            or fields['inbound_message_id'] != target['receipt']['message_id']
+            or token.session_id != target['session_id'] or token.owner_key != target['session_key']
+            or token.generation != target['generation']):
+        raise ValueError('f04_ctx_user_lease_changed')
+    result = {'namespace': 'native.telegram', 'session_id': target['session_id'],
+              'session_key': target['session_key'], 'generation': target['generation'],
+              'event_message_id': target['receipt']['message_id'],
+              'ctx_inbound_message_id': fields['inbound_message_id'], 'ctx_generation': fields['run_generation'],
+              'lease': deepcopy(target['lease_before']),
+              'latest_user_row': {'id': user['id'], 'platform_message_id': str(user['platform_message_id'])}}
+    if live:
+        state = target['runner']._peek_session_state(target['session_key'])
+        if (ctx is None or state is None or state.turn.ctx is not ctx or state.turn.event is not event
+                or {'session_id': ctx.session_id, 'session_key': ctx.session_key,
+                    'run_generation': ctx.run_generation, 'inbound_message_id': str(ctx.inbound_message_id)} != fields
+                or state.persistent.run_generation != target['generation']
+                or state.turn.lease_tokens.get(target['generation']) is not token
+                or token.released is not False or token.lease.holder is not token
+                or not token.lease.lock.locked()
+                or observation.get('generation') != target['generation']
+                or observation.get('ctx_generation') != ctx.run_generation
+                or str(observation.get('ctx_inbound_message_id')) != result['ctx_inbound_message_id']
+                or str(observation.get('event_message_id')) != result['event_message_id']
+                or observation.get('turn_tokens') != [result['lease']]):
+            raise ValueError('f04_live_target_changed')
+    return result
+
+
+def _ack(request):
+    ack = request.get('tester_ack')
+    if (not isinstance(ack, dict) or set(ack) != {'namespace', 'send_message_id', 'ack_sha256'}
+            or ack['namespace'] != 'tester.telegram' or not _decimal(ack['send_message_id'])
+            or not _hex(ack['ack_sha256'])):
+        raise ValueError('f04_genuine_tester_ack_required')
+    return deepcopy(ack)
+
+
+def _clock(request, row, target):
+    clock = request.get('ordinary_clock')
+    if (not isinstance(clock, dict) or set(clock) != {'origin_monotonic', 'deadline_monotonic', 'clock_sha256'}
+            or not _number(clock['origin_monotonic']) or not _number(clock['deadline_monotonic'])
+            or not _hex(clock['clock_sha256'])
+            or not row['base']['metadata_created_monotonic'] <= clock['origin_monotonic']
+            <= target['receipt']['observed_monotonic'] <= clock['deadline_monotonic']
+            <= clock['origin_monotonic'] + 600
+            or not clock['origin_monotonic'] < clock['deadline_monotonic'] <= row['base']['metadata_expires_monotonic']):
+        raise ValueError('f04_genuine_original_clock_required')
+    return deepcopy(clock)
+
+
+def readonly(runner, request, observation):
+    row = _record(runner, request)
+    if not row['candidates'] or row['candidates'][0]['receipt'] is None:
+        if 'target' in request or 'binding_sha256' in request:
+            raise ValueError('f04_bound_target_missing')
+        return {'schema': 'frw.gateway.f04-owned-current.v1', 'state': 'WAITING',
+                'scope_id': row['base']['scope_id'], 'request_sha256': row['request_sha256']}
+    target = _candidate(row)
+    actual = _native_target(target, observation, live=not target['dispatch_finalized'])
+    ack = _ack(request)
+    clock = _clock(request, row, target)
+    binding = {'request_sha256': row['request_sha256'], 'ingress_receipt_sha256': canonical_sha256(target['receipt']),
+               'target': actual, 'tester_ack': ack, 'ordinary_clock': clock}
+    binding_sha = canonical_sha256(binding)
+    if ('binding_sha256' in request or 'target' in request) and (
+            request.get('binding_sha256') != binding_sha or request.get('target') != actual):
+        raise ValueError('f04_bound_request_changed')
+    return {'schema': 'frw.gateway.f04-owned-current.v1', 'state': 'BOUND',
+            'scope_id': row['base']['scope_id'], 'request_sha256': row['request_sha256'],
+            'ingress_receipt': deepcopy(target['receipt']), 'binding_sha256': binding_sha,
+            'target': actual, 'tester_ack': ack, 'ordinary_clock': clock, 'artifact_proofs': deepcopy(row['artifacts']),
+            'stop_selector': deepcopy(observation.get('stop_selector'))}
+
+
+def validate_cancel_binding(runner, request, snapshot):
+    row = _record(runner, request)
+    if 'target' not in request or 'binding_sha256' not in request:
+        raise ValueError('f04_cancel_exact_bound_request_required')
+    result = readonly(runner, request, snapshot)
+    target = _candidate(row)
+    if (row['disarmed'] or result['state'] != 'BOUND' or target['dispatch_finalized'] or row['cancel'] is not None
+            or time.monotonic() >= request['ordinary_clock']['deadline_monotonic']):
+        raise ValueError('f04_cancel_terminal_or_deadline')
+    _native_target(target, snapshot, live=True)
+    return True
+
+
+def mark_cancelled(runner, request, generation_after, status):
+    row = _record(runner, request)
+    target = _candidate(row)
+    binding = {'request_sha256': row['request_sha256'],
+               'ingress_receipt_sha256': canonical_sha256(target['receipt']),
+               'target': request.get('target'), 'tester_ack': _ack(request),
+               'ordinary_clock': _clock(request, row, target)}
