+MAGIC = b'Visio (TM) Drawing\r\n\0'
+MAX_POINTERS = 16384
+MAX_CHUNKS = 50000
+MAX_DEPTH = 32
+MAX_BLOCK = 16_000_000
+MAX_EXPANDED = 32_000_000
