+# SPDX-License-Identifier: MPL-2.0
+"""Bounded inert binary Visio stored text reader (v11 only).
+
+CFB allocation checks are specialized from the accepted DOC/PPT readers.
+Existing DOC/XLS/PPT boundaries are unchanged.
+Only physical stored shape/text records are reported, with exact binary locations.
+No rendering, ShapeSheet evaluation, inheritance, external links or execution.
+"""
+from __future__ import annotations
+import json
+import struct
+
+MAX_INPUT = 4_000_000
+MAX_DIRECTORY = 256
+FREE = 0xFFFFFFFF
+END = 0xFFFFFFFE
+FAT = 0xFFFFFFFD
+DIF = 0xFFFFFFFC
+VISIO_CLSIDS = (bytes.fromhex('141a020000000000c000000000000046'),
+                bytes.fromhex('131a020000000000c000000000000046'))
+STREAMS = frozenset(('VisioDocument', 'VisioInformation', '\x01CompObj',
+                     '\x05SummaryInformation', '\x05DocumentSummaryInformation'))
+
+class VSDBinaryError(ValueError):
+    """Fixed content-free refusal code."""
+
+
+def _fail(code):
+    raise VSDBinaryError(code)
+
+def _u16(data, at):
+    return struct.unpack_from('<H', data, at)[0]
+
+
+def _u32(data, at):
+    return struct.unpack_from('<I', data, at)[0]
+
+
+def _words(data):
+    return struct.unpack('<' + 'I' * (len(data) // 4), data)
+
+
+class _CFB:
+    def __init__(self, data):
+        if len(data) < 512 or data[:8] != bytes.fromhex('d0cf11e0a1b11ae1'):
+            _fail('cfb_signature')
+        self.data = data
+        version = _u16(data, 26)
+        shift = _u16(data, 30)
+        if (data[8:24] != b'\0' * 16 or _u16(data, 24) != 0x003E or version not in (3, 4)
+                or _u16(data, 28) != 0xFFFE or shift != (9 if version == 3 else 12)
+                or _u16(data, 32) != 6 or data[34:40] != b'\0' * 6
+                or _u32(data, 56) != 4096):
+            _fail('cfb_header')
+        self.sector_size = 1 << shift
+        if (len(data) % self.sector_size or len(data) < self.sector_size * 3
+                or any(data[512:self.sector_size])):
+            _fail('cfb_geometry')
+        self.sectors = len(data) // self.sector_size - 1
+        self.used = set()
+        ndir, nfat = _u32(data, 40), _u32(data, 44)
+        nmini, ndif = _u32(data, 64), _u32(data, 72)
+        if ((version == 3 and ndir != 0) or not 1 <= nfat <= self.sectors
+                or nmini > self.sectors or ndif > self.sectors):
+            _fail('cfb_allocation_count')
+        fat_ids = []
+        saw_free = False
+
+        def add_fat_ids(items):
+            nonlocal saw_free
+            for sid in items:
+                if sid == FREE:
+                    saw_free = True
+                else:
+                    if saw_free or len(fat_ids) >= nfat:
+                        _fail('cfb_difat_count')
+                    self._claim(sid)
+                    fat_ids.append(sid)
+
+        add_fat_ids(_words(data[76:512]))
+        dif_ids = []
+        sid = _u32(data, 68)
+        for _ in range(ndif):
+            self._claim(sid)
+            dif_ids.append(sid)
+            items = _words(self._sector(sid))
