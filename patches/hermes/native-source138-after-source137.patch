+            if name in ('fill', 'stroke') and not re.fullmatch(r'none|[A-Za-z]{1,32}|#[0-9a-fA-F]{3}(?:[0-9a-fA-F]{3})?(?:[0-9a-fA-F]{2})?', value):
+                fail('svg_paint_unsupported')
+            if name == 'transform':
+                # Only numeric static transform functions, never references/CSS.
+                # Require separators between number tokens. Optional separators
+                # inside a repeated NUMBER let malformed long numbers split in
+                # exponentially many ways, blocking deadline checkpoints.
+                if len(value) > 4096 or re.sub(r'(?:matrix|translate|scale|rotate|skewX|skewY)\s*\(\s*' + NUMBER + r'(?:[\s,]+' + NUMBER + r')*\s*\)', '', value).strip():
+                    fail('svg_transform_unsupported')
+            if name == 'd' and (len(value) > MAX_TEXT or re.search(r'[^MmZzLlHhVvCcSsQqTtAa0-9eE+.,\s-]', value)):
+                fail('svg_path_unsupported')
+            if any(c in value for c in '<>\0'):
+                fail('svg_attribute_unsupported')
+        own_text = node.text or ''
+        tail = node.tail or ''
+        if kind not in ('text', 'tspan', 'title', 'desc') and own_text.strip():
+            fail('svg_unattached_text')
+        if parent not in ('text', 'tspan') and tail.strip():
+            fail('svg_unattached_text')
+        text_bytes += len(own_text.encode('utf-8')) + len(tail.encode('utf-8'))
+        if text_bytes > MAX_TEXT:
+            fail('svg_text_limit')
+        row = {'ordinal': len(rows) + 1, 'element': kind, 'parent_ordinal': parent_ordinal,
+               'attributes': attrs}
+        if kind in ('text', 'tspan', 'title', 'desc'):
+            row['stored_text'] = own_text
+        if parent in ('text', 'tspan') and tail:
+            row['stored_tail'] = tail
+        rows.append(row)
+        # Container kind is recorded, not a visual stacking/inheritance result.
+        stack.extend((child, depth + 1, kind, row['ordinal']) for child in reversed(list(node)))
+    tick(checkpoint)
+    return root, rows
+
+
+class SVGText(str):
+    def __new__(cls, text, metadata):
+        instance = super().__new__(cls, text)
+        instance.extraction_metadata = metadata
+        return instance
+
+
+def extract_svg(data, *, checkpoint=None):
+    root, rows = _load(data, checkpoint)
+    metadata = {'format': 'svg', 'profile': 'bounded_static_svg',
+                'elements': len(rows), 'source_sha256': hashlib.sha256(data).hexdigest(),
+                'semantic_status': 'PARTIAL',
+                'coverage': 'stored_element_attributes_and_text_only',
+                'rendered': False, 'vision': False, 'visible_text_proven': False,
+                'resources_loaded': False, 'scripts_executed': False,
+                'geometry_interpretation': 'UNKNOWN', 'font_availability': 'UNKNOWN',
+                'limitations': ['No CSS, animation, external resources, use, images or foreign objects.',
+                                'Stored text may be hidden; no appearance, inherited style or visual meaning is proven.']}
+    encoded = lambda v: json.dumps(v, ensure_ascii=True, sort_keys=True, separators=(',', ':'))
+    text = '[SVG ' + encoded(metadata) + ']\n' + ''.join('[OBJECT ' + encoded(r) + ']\n' for r in rows)
+    if len(text.encode()) > MAX_OUTPUT:
+        fail('svg_output_limit')
+    tick(checkpoint)
+    return SVGText(text, metadata)
+
+
+def create_svg(payload, *, checkpoint=None):
+    if type(payload) is not dict or set(payload) != {'width', 'height', 'shapes'}:
+        fail('svg_create_schema')
+    width = numeric(payload['width'], positive=True)
+    height = numeric(payload['height'], positive=True)
+    shapes = payload['shapes']
+    if type(shapes) is not list or not 1 <= len(shapes) <= 256:
+        fail('svg_create_shape_limit')
+    rows = ['<svg xmlns="' + NS + '" width="' + width + '" height="' + height + '" viewBox="0 0 ' + width + ' ' + height + '">']
+    required = {'rect': {'x', 'y', 'width', 'height'}, 'circle': {'cx', 'cy', 'r'},
+                'line': {'x1', 'y1', 'x2', 'y2'}, 'text': {'x', 'y', 'text'}}
+    for shape in shapes:
+        tick(checkpoint)
+        if type(shape) is not dict or type(shape.get('type')) is not str or shape['type'] not in required:
+            fail('svg_create_shape_schema')
+        kind = shape['type']
+        if not required[kind] <= shape.keys() or set(shape) - (required[kind] | {'type', 'id', 'fill', 'stroke', 'stroke_width', 'font_size'}):
+            fail('svg_create_shape_schema')
+        attrs = {}
+        for key, value in shape.items():
+            if key in ('type', 'text'):
+                continue
+            name = key.replace('_', '-')
+            attrs[name] = plain(value) if key in ('id', 'fill', 'stroke') else numeric(value, positive=key in ('width', 'height', 'r', 'font_size', 'stroke_width'))
+        attr_text = ''.join(' ' + key + '=' + quoteattr(value) for key, value in attrs.items())
+        rows.append('<' + kind + attr_text + '>' + escaped_text(shape['text']) + '</text>' if kind == 'text' else '<' + kind + attr_text + '/>')
+    result = ('\n'.join(rows) + '\n</svg>\n').encode()
+    _load(result, checkpoint)
+    return result
+
+
+def edit_svg(data, payload, *, checkpoint=None):
+    """One exact leaf-text replacement, preserving all other source bytes."""
+    if type(payload) is not dict or set(payload) != {'id', 'old_text', 'new_text', 'expected_sha256'}:
+        fail('svg_edit_schema')
+    root, _ = _load(data, checkpoint)
+    if payload['expected_sha256'] != hashlib.sha256(data).hexdigest():
+        fail('svg_source_changed')
+    target = payload['id'];old = plain(payload['old_text']);new = plain(payload['new_text'])
+    if type(target) is not str or not ID.fullmatch(target) or not old or old == new:
+        fail('svg_edit_target')
+    nodes = [n for n in root.iter() if n.get('id') == target]
+    if len(nodes) != 1 or nodes[0].tag != '{' + NS + '}text' or len(nodes[0]) or nodes[0].text != old:
+        fail('svg_edit_target')
+    parser = expat.ParserCreate(namespace_separator='}')
+    stack = [];span = []
+    def start(name, attrs):
+        stack.append((attrs.get('id') == target, parser.CurrentByteIndex))
+    def end(name):
+        found, offset = stack.pop()
+        if found:
+            # Quoted attribute values may contain >; scan the actual end tag.
+            match = re.match(rb'<(?:[^>\'\"]|\'[^\']*\'|\"[^\"]*\")*>', data[offset:])
+            if not match:
+                fail('svg_edit_span')
+            span.append((offset + match.end(), parser.CurrentByteIndex))
+    parser.StartElementHandler = start;parser.EndElementHandler = end
+    try:
+        parser.Parse(data, True)
+    except expat.ExpatError:
+        fail('svg_edit_span')
+    if len(span) != 1:
+        fail('svg_edit_span')
+    start, end = span[0]
+    if start > end or b'<' in data[start:end]:
+        fail('svg_edit_markup_unsupported')
+    result = data[:start] + escaped_text(new).encode('utf-8') + data[end:]
+    verified, _ = _load(result, checkpoint)
+    if next(n for n in verified.iter() if n.get('id') == target).text != new:
+        fail('svg_edit_text_mismatch')
+    tick(checkpoint)
+    return result
