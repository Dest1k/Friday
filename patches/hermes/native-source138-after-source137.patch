+def _inflate(data, checkpoint=None):
+    """Visio's 4 KiB ring LZ stream; finite, strict, no system decompressor."""
+    ring = bytearray(4096)
+    output = bytearray()
+    at = pos = 0
+    while at < len(data):
+        if at % 1024 < 18:
+            _tick(checkpoint)
+        flag = data[at]
+        at += 1
+        if at == len(data):
+            _fail('visio_compression_truncated')
+        for bit in range(8):
+            if at == len(data):
+                break
+            if flag & (1 << bit):
+                count = 1
+                value = data[at]
+                at += 1
+                ring[pos & 4095] = value
+                output.append(value)
+            else:
+                _need(data, at, 2)
+                low, high = data[at:at + 2]
+                at += 2
+                count = (high & 15) + 3
+                pointer = ((high & 240) << 4) | low
+                pointer = pointer - 4078 if pointer > 4078 else pointer + 18
+                if len(output) + count > MAX_BLOCK:
+                    _fail('visio_expanded_block_limit')
+                for index in range(count):
+                    value = ring[(pointer + index) & 4095]
+                    ring[(pos + index) & 4095] = value
+                    output.append(value)
+            pos += count
+            if len(output) > MAX_BLOCK:
+                _fail('visio_expanded_block_limit')
