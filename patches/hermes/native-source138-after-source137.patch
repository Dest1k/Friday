+"""Own-workspace SVG creation and source-bound leaf-text copy edits."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _source, _verify, _path, _inline_budget, _fits, _capacity, _encode
+
+
+def create_or_edit(cap, fd, leaf, relative, content, operation):
+    from tools.scoped_svg import SVGError, create_svg, edit_svg
+    _check_parent(cap, fd, relative)
+    if PurePosixPath(relative).suffix.lower() != '.svg' or operation not in ('svg_create', 'svg_text_edit'):
+        raise ScopeDenied()
+    if type(content) is not str or len(content.encode('utf-8')) > 100000:
+        raise ScopeDenied()
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ScopeDenied()
+            result[key] = value
+        return result
+    try:
+        spec = json.loads(content, object_pairs_hook=unique)
+    except (ValueError, RecursionError):
+        raise ScopeDenied() from None
+    sources = []
+    checkpoint = lambda: check(cap)
+    try:
+        if operation == 'svg_create':
+            data = create_svg(spec, checkpoint=checkpoint)
+        else:
+            if type(spec) is not dict or set(spec) != {'source', 'source_sha256', 'id', 'old_text', 'new_text'}:
+                raise ScopeDenied()
+            source = _path(spec['source'])
+            if PurePosixPath(source).suffix.lower() != '.svg' or source == relative:
+                raise ScopeDenied()
+            original, identity = _source(cap, source)
+            sources = [(source, original, identity)]
+            data = edit_svg(original, {'id': spec['id'], 'old_text': spec['old_text'],
+                'new_text': spec['new_text'], 'expected_sha256': spec['source_sha256']}, checkpoint=checkpoint)
+    except SVGError as error:
+        return _encode({'success': False, 'error': 'svg_operation_refused', 'reason': str(error), 'effect_disposition': 'none'})
+    receipt = {'source_sha256': hashlib.sha256(sources[0][1]).hexdigest() if sources else None,
+               'operation': operation, 'rendered': False, 'resources_loaded': False,
+               'source_unchanged': True, 'other_bytes_preserved': bool(sources)}
+    estimate = dict(receipt, success=True, path=relative, format='svg', scope='own_user_workspace',
+                    create_only=True, verified=True, bytes_written=len(data), sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate, _inline_budget()):
+        return _capacity(_inline_budget())
+    _verify(cap, sources)
+    answer = json.loads(_create_bytes(cap, fd, leaf, relative, data, output_format='svg',
+                                    verify_source=lambda: _verify(cap, sources)))
+    if answer.get('success'):
+        answer.update(receipt)
+    return _encode(answer)
