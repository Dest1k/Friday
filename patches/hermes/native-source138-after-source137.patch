+class _Reader:
+    def __init__(self, data, checkpoint):
+        self.data = data
+        self.checkpoint = checkpoint
+        self.pointer_count = self.chunk_count = self.label_total = self.expanded = 0
+        self.cache = {}
+        self.spans = {}
+        self.active = set()
+        self.pages = []
+        self.masters = []
+        self.shapes = []
+        self.shape_keys = set()
+        self.kinds = {}
