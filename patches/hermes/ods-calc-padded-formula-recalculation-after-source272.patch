+def _calc_value_names(raw, indices, checkpoint):
+    """Resolve the lexical cache attribute and the formula namespace in scope."""
+    if not indices:
+        return {}
+    parser = expat.ParserCreate(namespace_separator='}')
+    parser.namespace_prefixes = True
+    bindings = []
+    names = {}
+    index = 0
+    cell_names = {TB + '}table-cell', TB + '}covered-table-cell'}
+    cache_prefix = O + '}value}'
+
+    def open_namespace(prefix, uri):
+        if prefix == 'of':
+            bindings.append(uri)
+
+    def close_namespace(prefix):
+        if prefix == 'of':
+            bindings.pop()
+
+    def start(name, attrs):
+        nonlocal index
+        if '}'.join(name.split('}', 2)[:2]) not in cell_names:
+            return
+        if index % 64 == 0:
+            tick(checkpoint)
+        if index in indices:
+            if not bindings or bindings[-1] != OF:
+                fail('formula_cell_namespace_binding')
+            for attr in attrs:
+                if attr.startswith(cache_prefix):
+                    names[index] = (attr[len(cache_prefix):] + ':value').encode('utf-8')
+                    break
+        index += 1
+
+    def refuse(*args):
+        fail('active_xml')
+
+    parser.StartNamespaceDeclHandler = open_namespace
+    parser.EndNamespaceDeclHandler = close_namespace
+    parser.StartElementHandler = start
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    try:
+        parser.Parse(raw, True)
+    except expat.ExpatError:
+        fail('invalid_xml')
+    if names.keys() != indices:
+        fail('formula_cell_cache_attribute')
+    return names
+
