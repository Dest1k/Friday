+def _calc_formula_cell(fragment, node, value, cache_name):
+    if any(key.startswith('{' + CALCEXT + '}') and key != _CALC_TYPE for key in node.attrib):
+        fail('formula_cell_calc_extension')
+    if node.attrib.keys() - _CALC_FORMULA_ATTRIBUTES:
+        fail('formula_cell_calc_attributes')
+
+    opening = _tag_end(fragment, 0)
+    position = re.match(rb'<[^ \t\r\n<>/]+', fragment).end()
+    cache = None
+    for attr in _XML_ATTRIBUTE.finditer(fragment, position, opening - 1):
+        if attr.start() != position:
+            fail('formula_cell_cache_attribute')
+        position = attr.end()
+        if attr[1] == cache_name:
+            cache = attr.span(2 if attr[2] is not None else 3)
+    if (cache is None or _XML_SPACE.fullmatch(fragment, position, opening - 1) is None
+            or fragment[cache[0]:cache[1]] != node.get(q(O, 'value')).encode('utf-8')):
+        fail('formula_cell_cache_attribute')
+
+    paragraph = _XML_SPACE.match(fragment, opening).end()
+    if not fragment.startswith(b'<', paragraph):
+        fail('formula_cell_content')
+    text = _tag_end(fragment, paragraph)
+    close = fragment.find(b'<', text)
+    if close < 0 or not fragment.startswith(b'</', close):
+        fail('formula_cell_content')
+    display = _CACHE_TEXT.fullmatch(fragment, text, close)
+    end_paragraph = _tag_end(fragment, close)
+    closing = _XML_SPACE.match(fragment, end_paragraph).end()
+    if (display is None or not fragment.startswith(b'</', closing)
+            or _tag_end(fragment, closing) != len(fragment)):
+        fail('formula_cell_content')
+
+    # Preserve all declarations, prefixes, quotes, whitespace and other bytes.
+    number = value.encode('ascii')
+    return (fragment[:cache[0]] + number + fragment[cache[1]:display.start(1)]
+            + number + fragment[display.end(1):])
+
