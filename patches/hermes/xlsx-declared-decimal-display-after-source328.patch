+def _localized_decimal_styles(styles):
+    """Map explicit cell styles for the supported ungrouped decimal formats."""
+    known_children = {q(S, name) for name in (
+        'numFmts', 'fonts', 'fills', 'borders', 'cellStyleXfs', 'cellXfs',
+        'cellStyles', 'dxfs', 'tableStyles', 'colors',
+    )}
+    if styles is None or any(node.tag not in known_children for node in styles):
+        return {}
+    formats = styles.findall(q(S, 'numFmts'))
+    cell_styles = styles.findall(q(S, 'cellXfs'))
+    base_styles = styles.findall(q(S, 'cellStyleXfs'))
+    if (len(formats) != 1 or len(cell_styles) != 1 or len(base_styles) != 1
+            or len(base_styles[0]) != 1 or base_styles[0][0].tag != q(S, 'xf')
+            or base_styles[0][0].get('numFmtId', '0') != '0'):
+        return {}
+    ids = re.compile(r'[0-9]{1,10}')
+    declarations = []
+    for node in formats[0]:
+        number = node.get('numFmtId', '')
+        if node.tag != q(S, 'numFmt') or len(node) or not ids.fullmatch(number):
+            return {}
+        declarations.append((int(number), node.get('formatCode', '').lower()))
+    if any(node.tag != q(S, 'xf') for node in cell_styles[0]):
+        return {}
+    counts = Counter(number for number, _ in declarations)
+    separators = {'[$-0419]0.00': ',', '[$-0409]0.00': '.'}
+    supported = {
+        number: (code, separators[code]) for number, code in declarations
+        if 164 <= number <= 4294967295 and counts[number] == 1 and code in separators
+    }
+    result = {}
+    for index, style in enumerate(cell_styles[0]):
+        number = style.get('numFmtId', '')
+        if (ids.fullmatch(number)
+                and style.get('xfId') == '0' and style.get('applyNumberFormat') in ('1', 'true')
+                and style.get('quotePrefix', '0') in ('0', 'false') and not len(style)
+                and int(number) in supported):
+            result[str(index)] = supported[int(number)]
+    return result
+
