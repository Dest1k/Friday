+"""Preserve leading table-header rows in the scoped Word conversion inventory."""
+from xml.etree import ElementTree
+
+import pytest
+
+from tools import scoped_word_conversion as conversion
+
+
+def read_table(parser_type, xml):
+    parser = parser_type.__new__(parser_type)
+    parser.state = conversion._Inventory(None)
+    parser.paragraph = lambda node, **kwargs: parser.state.paragraph("".join(node.itertext()))
+    if parser_type is conversion._ODF:
+        parser.style = lambda name, family: None
+    else:
+        parser.styles = {}
+        parser._empty_numbering_property = lambda node: False
+    return parser.table(ElementTree.fromstring(xml))
+
+
+def odf_row(text):
+    return f"<t:table-row><t:table-cell><x:p>{text}</x:p></t:table-cell></t:table-row>"
+
+
+def odf_table(*rows):
+    return (
+        f'<t:table xmlns:t="{conversion.TB}" xmlns:x="{conversion.T}">'
+        '<t:table-column/>' + "".join(rows) + "</t:table>"
+    )
+
+
+def odf_header(*rows):
+    return "<t:table-header-rows>" + "".join(rows) + "</t:table-header-rows>"
+
+
+def word_row(text, header=""):
+    props = f"<w:trPr>{header}</w:trPr>" if header else ""
+    return f"<w:tr>{props}<w:tc><w:p><w:r><w:t>{text}</w:t></w:r></w:p></w:tc></w:tr>"
+
+
+def word_table(*rows):
+    return f'<w:tbl xmlns:w="{conversion.W}">' + "".join(rows) + "</w:tbl>"
+
+
+def test_read_odf_and_word_headers_as_the_same_leading_rows():
+    odf = odf_table(odf_header(odf_row("Name"), odf_row("ID")), odf_row("01"))
+    word = word_table(
+        word_row("Name", "<w:tblHeader/>"),
+        word_row("ID", '<w:tblHeader w:val="true"/>'),
+        word_row("01", '<w:tblHeader w:val="false"/>'),
+    )
+    before = read_table(conversion._ODF, odf)
+    after = read_table(conversion._Word, word)
+    assert before == after
+    assert before["header_rows"] == 2
+    assert [row[0][0]["text"] for row in before["rows"]] == ["Name", "ID", "01"]
+
+
+def test_absent_or_explicitly_disabled_word_header_keeps_plain_inventory():
+    odf = odf_table(odf_row("Name"), odf_row("01"))
+    word = word_table(word_row("Name", '<w:tblHeader w:val="0"/>'), word_row("01"))
+    expected = {
+        "type": "table",
+        "rows": [
+            [[{"type": "paragraph", "text": "Name"}]],
+            [[{"type": "paragraph", "text": "01"}]],
+        ],
+    }
+    assert read_table(conversion._ODF, odf) == expected
+    assert read_table(conversion._Word, word) == expected
+
+
+@pytest.mark.parametrize(
+    ("parser_type", "xml"),
+    [
+        (conversion._ODF, odf_table(odf_row("01"), odf_header(odf_row("Name")))),
+        (conversion._ODF, odf_table(odf_header(odf_row("Name")), odf_header(odf_row("ID")))),
+        (conversion._ODF, odf_table(odf_header(), odf_row("01"))),
+        (conversion._Word, word_table(word_row("01"), word_row("Name", "<w:tblHeader/>"))),
+        (conversion._Word, word_table(word_row("Name", "<w:tblHeader/><w:tblHeader/>"))),
+        (conversion._Word, word_table(word_row("Name", '<w:tblHeader w:val="maybe"/>'))),
+    ],
+)
+def test_reject_ambiguous_table_headers(parser_type, xml):
+    with pytest.raises(conversion.WordConversionError):
+        read_table(parser_type, xml)
