+"""Bounded passive AbiWord XML profile, based on the AbiWord native importer.
+
+Stored text, not rendered/visible text. No DTD, entities, resource objects,
+fields, revisions or external resolution. Creation is a minimal plain document;
+editing replaces only one complete plain section paragraph in a new UTF-8 copy.
+"""
+from __future__ import annotations
+import json
+import re
+from xml.etree import ElementTree as ET
+from xml.parsers import expat
+from xml.sax.saxutils import escape
+
+AWML = 'http://www.abisource.com/awml.dtd'
+XML = 'http://www.w3.org/XML/1998/namespace'
+MAX_INPUT = 1_000_000
+MAX_TEXT = 800_000
+MAX_NODES = 25_000
+MAX_DEPTH = 64
+MAX_ITEMS = 2_000
+_CHILDREN = {
+    'abiword': {'metadata', 'styles', 'pagesize', 'section', 'history', 'ignoredwords', 'rdf'},
+    'section': {'p', 'table'}, 'p': {'c', 'br'}, 'c': {'c', 'br'}, 'br': set(),
+    'table': {'cell'}, 'cell': {'p'}, 'metadata': {'m'}, 'm': set(),
+    'styles': {'s'}, 's': set(), 'pagesize': set(), 'history': {'version'},
+    'version': set(), 'ignoredwords': {'iw'}, 'iw': set(), 'rdf': set(),
+}
+_ATTRS = {
+    'abiword': {'version', 'fileformat', 'template', 'styles', 'props', 'xid-max'},
+    'section': {'props', 'xid'}, 'p': {'props', 'style', 'xid', 'id'},
+    'c': {'props', 'style'}, 'br': set(), 'table': {'props', 'xid'},
+    'cell': {'props', 'xid'}, 'metadata': set(), 'm': {'key'},
+    'styles': set(), 's': {'type', 'name', 'basedon', 'followedby', 'props'},
+    'pagesize': {'pagetype', 'orientation', 'width', 'height', 'units', 'page-scale'},
+    'history': {'version', 'edit-time', 'last-saved', 'uid'},
+    'version': {'id', 'started', 'uid', 'auto', 'top-xid'},
+    'ignoredwords': set(), 'iw': set(), 'rdf': set(),
+}
+
+class ABWError(ValueError):
+    def __init__(self, code): self.code = code; super().__init__(code)
+
+class _Text(str):
+    def __new__(cls, text, metadata):
+        value = super().__new__(cls, text); value.extraction_metadata = metadata; return value
+
+def fail(code): raise ABWError(code)
+def tick(checkpoint):
+    if checkpoint is not None: checkpoint()
+
+def _text(value, *, nonempty=False):
+    if not isinstance(value, str) or len(value) > 100_000: fail('abw_text_type_or_limit')
+    if any(not (ord(c) == 9 or 0x20 <= ord(c) <= 0xd7ff or 0xe000 <= ord(c) <= 0xfffd
+                or 0x10000 <= ord(c) <= 0x10ffff) for c in value): fail('abw_single_line_xml_text_required')
+    if '\u2028' in value or '\u2029' in value: fail('abw_single_line_xml_text_required')
+    if len(value.encode('utf-8')) > 100_000 or nonempty and not value.strip(): fail('abw_text_limit_or_empty')
+    return value
+
+def object_spec(content):
+    if not isinstance(content, str) or len(content) > MAX_INPUT: fail('abw_json_type_or_limit')
+    def pairs(rows):
+        result = {}
+        for key, value in rows:
+            if key in result: fail('abw_duplicate_json_key')
+            result[key] = value
+        return result
+    try: value = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError): fail('abw_invalid_json')
+    if not isinstance(value, dict): fail('abw_json_object_required')
+    return value
+
+def _load(data, checkpoint=None):
+    if not isinstance(data, bytes) or not data or len(data) > MAX_INPUT: fail('abw_input_limit')
+    # The UTF-16 profile requires a BOM; do not silently guess an encoding from
+    # arbitrary binary bytes. Expat independently checks declaration consistency.
+    physical = 'utf-16le' if data.startswith(b'\xff\xfe') else 'utf-16be' if data.startswith(b'\xfe\xff') else 'utf-8'
+    if b'\x00' in data[:4] and physical == 'utf-8': fail('abw_encoding_requires_utf16_bom')
+    parser = expat.ParserCreate(namespace_separator='}')
+    parser.buffer_text = True
+    root = None; namespace = None; stack = []; spans = {}; state = {'nodes': 0, 'text': 0, 'encoding': physical, 'declaration': None}
+    def deny(*args): fail('abw_dtd_entity_or_processing_instruction_forbidden')
+    parser.StartDoctypeDeclHandler = deny
+    parser.EntityDeclHandler = deny
+    parser.ExternalEntityRefHandler = deny
+    parser.ProcessingInstructionHandler = deny
+    parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)
+    def declaration(version, encoding, standalone):
+        if version != '1.0': fail('abw_xml_version_unsupported')
+        enc = (encoding or 'utf-8').lower().replace('_', '-')
+        if enc not in ('utf-8', 'utf8', 'utf-16', 'utf-16le', 'utf-16be'): fail('abw_encoding_unsupported')
+        if physical == 'utf-8' and enc.startswith('utf-16'): fail('abw_encoding_requires_utf16_bom')
+        state['declaration'] = enc
+    parser.XmlDeclHandler = declaration
+    def start(expanded, attrs):
+        nonlocal root, namespace
+        ns, name = expanded.rsplit('}', 1) if '}' in expanded else ('', expanded)
+        if name not in _CHILDREN or ns not in ('', AWML): fail('abw_namespace_or_element_unsupported')
+        state['nodes'] += 1
+        if state['nodes'] > MAX_NODES or len(stack) >= MAX_DEPTH: fail('abw_structure_limit')
+        if state['nodes'] % 64 == 1: tick(checkpoint)
+        if len(attrs) > 32: fail('abw_attribute_limit')
+        for key, value in attrs.items():
+            if key == XML + '}space':
+                if value not in ('default', 'preserve'): fail('abw_xml_space_unsupported')
+            elif key not in _ATTRS[name]: fail('abw_attribute_unsupported')
+            if key == 'props' and re.search(r'(?:url\s*\(|(?:href|src|script|revision)\s*:)', value, re.I):
+                fail('abw_active_or_resource_property_unsupported')
+        if stack:
+            if ns != namespace or name not in _CHILDREN[stack[-1].tag]: fail('abw_invalid_child_structure')
+        elif root is not None or name != 'abiword': fail('abw_root_required')
+        else: namespace = ns
+        node = ET.Element(name, attrs)
+        if stack: stack[-1].append(node)
+        else: root = node
+        spans[node] = [parser.CurrentByteIndex, None]; stack.append(node)
+    def end(name):
+        node = stack.pop(); spans[node][1] = parser.CurrentByteIndex
+    def chars(value):
+        state['text'] += len(value)
+        if state['text'] > MAX_TEXT: fail('abw_text_limit')
+        if not stack:
+            if value.strip(): fail('abw_text_outside_root')
+            return
+        node = stack[-1]
+        if len(node): node[-1].tail = (node[-1].tail or '') + value
+        else: node.text = (node.text or '') + value
+    parser.StartElementHandler = start; parser.EndElementHandler = end; parser.CharacterDataHandler = chars
+    try:
+        for offset in range(0, len(data), 8192):
+            tick(checkpoint); parser.Parse(data[offset:offset+8192], False)
+        parser.Parse(b'', True)
+    except (expat.ExpatError, UnicodeError, LookupError): fail('abw_xml_malformed_or_encoding')
+    if root is None or root.get('fileformat') not in ('1.0', '1.1') or 'version' not in root.attrib:
+        fail('abw_root_version_or_fileformat_required')
+    if root.get('template', 'false') != 'false': fail('abw_template_unsupported')
+    for name in ('metadata', 'styles', 'pagesize', 'history', 'ignoredwords', 'rdf'):
+        if len(root.findall(name)) > 1: fail('abw_duplicate_document_container')
+    sections = root.findall('section')
+    if not sections or any(not len(n) for n in sections): fail('abw_section_content_required')
+    for node in root.iter():
+        if node.tag not in ('p', 'c', 'm', 'iw') and ((node.text or '').strip() or any((c.tail or '').strip() for c in node)):
+            fail('abw_unstructured_text')
+        if node.tag == 'table' and not len(node): fail('abw_empty_table')
+        if node.tag == 'cell' and not len(node): fail('abw_cell_paragraph_required')
+    items = sum(n.tag in ('p', 'cell') for n in root.iter())
+    if items > MAX_ITEMS: fail('abw_item_limit')
+    return root, spans, state
+
+def _paragraph(node):
+    # XML-normalized stored text is retained; explicit AbiWord <br/> is LF.
+    out = [node.text or '']
+    for child in node:
+        out.append('\n' if child.tag == 'br' else _paragraph(child))
+        out.append(child.tail or '')
+    return ''.join(out)
+
+def _cell_position(node):
+    props = {}
+    for item in node.get('props', '').split(';'):
+        if not item.strip(): continue
+        key, sep, value = item.partition(':')
+        if not sep or key.strip() in props: fail('abw_cell_properties_ambiguous')
+        props[key.strip()] = value.strip()
+    result = []
+    for key in ('left-attach', 'right-attach', 'top-attach', 'bot-attach'):
+        value = props.get(key, '')
+        if not re.fullmatch(r'0|[1-9][0-9]{0,2}', value): fail('abw_cell_position_required')
+        result.append(int(value))
+    left, right, top, bottom = result
+    if not (left < right <= 256 and top < bottom <= 256): fail('abw_cell_position_limit')
+    return result
+
+def extract_abw(data, *, checkpoint=None):
+    root, _, state = _load(data, checkpoint)
+    out = []; paragraphs = tables = cells = 0
+    for index, section in enumerate(root.findall('section'), 1):
+        out.append('[Section ' + str(index) + ']')
+        for block in section:
+            tick(checkpoint)
+            if block.tag == 'p':
+                out.append(_paragraph(block)); paragraphs += 1
+            else:
+                tables += 1; out.append('[Table ' + str(tables) + ']'); occupied = set()
+                for cell in block:
+                    left, right, top, bottom = _cell_position(cell)
+                    points = {(r, c) for r in range(top, bottom) for c in range(left, right)}
+                    if occupied & points: fail('abw_overlapping_cells')
+                    occupied.update(points)
+                    out.append(f'[Cell left={left} right={right} top={top} bottom={bottom}]')
+                    cells += 1
+                    for paragraph in cell: out.append(_paragraph(paragraph)); paragraphs += 1
+    text = '\n'.join(out)
+    if len(text.encode('utf-8')) > MAX_TEXT: fail('abw_output_text_limit')
+    meta = {'format': 'abw', 'native_container': True, 'semantic_status': 'PARTIAL',
+        'coverage': 'stored_section_paragraph_and_table_cell_text; not_rendered_or_visible_text',
+        'validation': 'bounded_native_XML_profile_not_full_AbiWord_validation',
+        'fileformat': root.get('fileformat'), 'xml_encoding': state['encoding'],
+        'sections': len(root.findall('section')), 'paragraphs': paragraphs, 'tables': tables, 'cells': cells,
+        'elements': state['nodes'], 'external_resources_loaded': False,
+        'formatting_history_metadata_ignored': True,
+        'limitations': 'No DTD/entities/PI, fields, links, images, embedded data, lists, revisions, notes, frames, templates or compressed ABW; no layout or application validation.'}
+    tick(checkpoint)
+    return _Text(text, meta)
+
+def create_abw(content, *, checkpoint=None):
+    spec = object_spec(content)
+    if set(spec) != {'paragraphs'}: fail('abw_create_schema')
+    paragraphs = spec['paragraphs']
+    if not isinstance(paragraphs, list) or not 1 <= len(paragraphs) <= MAX_ITEMS: fail('abw_paragraph_limit')
+    parts = []
+    for paragraph in paragraphs:
+        tick(checkpoint); parts.append('<p>' + escape(_text(paragraph)) + '</p>')
+    data = ('<?xml version="1.0" encoding="UTF-8"?>\n<abiword xmlns="' + AWML +
+        '" version="Friday native ABW" fileformat="1.0" template="false" xml:space="preserve">\n<section>' +
+        ''.join(parts) + '</section>\n</abiword>\n').encode('utf-8')
+    if len(data) > MAX_INPUT: fail('abw_output_limit')
+    extract_abw(data, checkpoint=checkpoint)
+    return data
+
+def edit_abw(data, old, new, *, checkpoint=None):
+    old = _text(old, nonempty=True); new = _text(new, nonempty=True)
+    if old == new: fail('abw_no_change')
+    root, spans, state = _load(data, checkpoint)
+    # Validate tables too before preserving the document into a new path.
+    extract_abw(data, checkpoint=checkpoint)
+    if state['encoding'] not in ('utf-8', 'utf8'): fail('abw_edit_requires_utf8')
+    try: data.decode('utf-8-sig')
+    except UnicodeError: fail('abw_edit_requires_utf8')
+    matches = [n for n in root.iter('p') if _paragraph(n) == old]
+    if len(matches) != 1: fail('abw_target_not_unique_full_paragraph')
+    target = matches[0]; parents = {c: n for n in root.iter() for c in n}
+    if len(target) or parents[target].tag != 'section': fail('abw_edit_plain_section_paragraph_only')
+    start, end = spans[target]; quote = None; begin = None
+    for pos in range(start, end):
+        c = data[pos]
+        if quote is not None:
+            if c == quote: quote = None
+        elif c in (34, 39): quote = c
+        elif c == 62: begin = pos + 1; break
+    if begin is None or b'<' in data[begin:end]: fail('abw_edit_complex_lexical_content')
+    changed = data[:begin] + escape(new).encode('utf-8') + data[end:]
+    if len(changed) > MAX_INPUT: fail('abw_output_limit')
+    parsed, _, _ = _load(changed, checkpoint)
+    if not any(_paragraph(n) == new for n in parsed.findall('section/p')): fail('abw_edit_verification_failed')
+    tick(checkpoint)
+    return changed
