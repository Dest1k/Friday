+"""Own-user create-only DIF/SLK native files with complete scalar validation."""
+import json
+from pathlib import Path
+
+
+def execute(cap, fd, leaf, path, content, *, operation):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _check_parent
+    from hermes_cli.friday_workspace_presentation import _read_source, _publish
+    from tools.scoped_dif_sylk import request, create, edit, TableError
+    try:
+        check(cap);_check_parent(cap,fd,path)
+        if operation not in ('dif_create','dif_edit','slk_create','slk_edit'):
+            raise TableError('table_operation_unsupported')
+        format, action = operation.split('_')
+        if Path(path).suffix.lower() != '.'+format:
+            raise TableError('table_output_suffix')
+        spec = request(content);source_state = None
+        if action == 'create':
+            output,facts = create(spec,format,checkpoint=lambda:check(cap))
+        else:
+            if not isinstance(spec.get('source'),str):
+                raise TableError('table_edit_schema')
+            source,relative,data,identity = _read_source(spec['source'],cap,'.'+format)
+            output,facts = edit(data,spec,format,checkpoint=lambda:check(cap))
+            source_state = source,data,identity;facts['source'] = relative
+        check(cap)
+        return _publish(cap,fd,leaf,path,output,format,source_state,facts)
+    except ScopeDenied:
+        raise
+    except TableError as error:
+        return json.dumps(dict(success=False,error='table_operation_refused',reason=error.code,effect_disposition='none'))
+    except (OSError,RuntimeError,TimeoutError):
+        return json.dumps(dict(success=False,error='table_operation_stopped',effect_disposition='none'))
