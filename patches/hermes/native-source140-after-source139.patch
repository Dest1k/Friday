@@ -0,0 +1,437 @@
+"""Bounded inert ASCII DIF and SYLK literal tables, without an Office engine.
+
+DIF supports one TABLE/VECTORS/TUPLES/DATA section and complete BOT rows.
+SYLK supports CALCOOO32 and WXL literal C records, optional declared B bounds,
+and a narrow passive P/F/O metadata grammar. No formula, link or macro record.
+Cells expose native string/number types; numeric tokens are never floats.
+Edits replace one complete scalar token and preserve every unrelated byte.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import time
+
+MAX_BYTES = 1_000_000
+MAX_REQUEST = 200_000
+MAX_ROWS = 512
+MAX_COLS = 64
+MAX_CELLS = 4096
+MAX_STRING = 8192
+MAX_TEXT = 200_000
+MAX_SECONDS = 5
+NUMBER = re.compile(r'[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[Ee][+-]?[0-9]+)?\Z')
+UINT = re.compile(r'[1-9][0-9]{0,5}\Z')
+SHA = re.compile(r'[0-9a-f]{64}\Z')
+
+READ_GUIDANCE = ('DIF/SLK: bounded ASCII native literal tables. Read returns typed CELL records with one-based row/column, exact numeric token strings and source hash. '
+    'DIF requires one complete TABLE/VECTORS/TUPLES/DATA section; empty quoted cells are native empty strings, not inferred null. '
+    'SLK supports CALCOOO32/WXL literal records and a narrow passive formatting subset; absent cells remain absent, never zero or empty. '
+    'Dimensions identify declared bounds or observed maximum coordinates. Display formats are not applied; dates/booleans are not inferred. '
+    'Formulas, macros, DDE/external records, unsupported metadata, ambiguous coordinates, duplicate cells, non-ASCII encodings and incomplete files refuse. No engine or network runs. ')
+WRITE_GUIDANCE = ('DIF/SLK use NEW same-profile paths. dif_create content is exactly {encoding:"ascii",table:"Sheet1",rows:[[...]]}; '
+    'slk_create content is exactly {encoding:"ascii",rows:[[...]]}. Rows are rectangular and nonempty; a cell is a literal string or {type:"number",value:"1200.50"}. '
+    'Numbers require exact decimal/exponent strings, never JSON floats. Strings including leading =,+,-,@ remain literal native strings; ASCII printable characters only. '
+    'dif_edit/slk_edit content is exactly {source,source_sha256,row,column,expected,value}; expected/value are the same typed cells as creation. '
+    'One existing cell changes, preserving its native type and all unrelated bytes into a NEW .dif/.slk. Use the exact source hash and cell token from read_file. '
+    'No overwrite, formula evaluation, rendering, type inference, arbitrary conversion, insertion or deletion. ')
+
+
+class TableError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def fail(code):
+    raise TableError(code)
+
+
+def _guard(checkpoint):
+    end = time.monotonic() + MAX_SECONDS
+    def check():
+        if checkpoint is not None:
+            checkpoint()
+        if time.monotonic() > end:
+            fail('table_deadline')
+    check()
+    return check
+
+
+def _object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            fail('table_duplicate_key')
+        result[key] = value
+    return result
+
+
+def request(content):
+    if not isinstance(content, str) or len(content) > MAX_REQUEST:
+        fail('table_request_limit')
+    try:
+        if len(content.encode('utf-8')) > MAX_REQUEST:
+            fail('table_request_limit')
+        result = json.loads(content, object_pairs_hook=_object,
+                            parse_constant=lambda _: fail('table_request_schema'))
+    except TableError:
+        raise
+    except (ValueError, UnicodeError, RecursionError):
+        fail('table_request_schema')
+    if not isinstance(result, dict):
+        fail('table_request_schema')
