+"""Bounded CAB 1.3 byte decoder: NONE and MSZIP, without host I/O.
+
+MS-CAB sections 2/3 and MS-MCI define the envelope, checksum and MSZIP
+32 KiB block history. This deliberately supports only a single cabinet,
+ordinary files, no reserved extensions, and contiguous fully described data.
+The caller provides its existing cancellation/deadline/capability checkpoint.
+No archive attributes are applied and no payload can execute here.
+"""
+import struct
+import unicodedata
+import zlib
+
+MAX_BYTES = 1_000_000
+MAX_ENTRIES = 128
+MAX_BLOCKS = 1024
+MAX_RATIO = 200
+RATIO_FLOOR = 65536
+MAX_DEPTH = 16
+
+
+class CABCodecError(ValueError):
+    """Finite public refusal code; no untrusted diagnostics."""
+
+
+def _fail(code='cab_invalid_archive'):
+    raise CABCodecError(code)
+
+
+def _checksum(data):
+    value = 0
+    full = len(data) & ~3
+    for (word,) in struct.iter_unpack('<I', data[:full]):
+        value ^= word
+    # MS-CAB 3.1 reverses the residual bytes before padding with zeroes.
+    return value ^ int.from_bytes(data[full:], 'big')
+
+
+def _name(raw, attrs):
+    try:
+        value = raw.decode('utf-8' if attrs & 0x80 else 'ascii', 'strict').replace('\\', '/')
+    except UnicodeError:
+        _fail('cab_name_encoding_unsupported')
+    parts = value.split('/')
+    if (not value or len(raw) > 256 or len(parts) > MAX_DEPTH
+            or value != unicodedata.normalize('NFC', value)
+            or any(unicodedata.category(c).startswith('C') for c in value)
+            or any(c in value for c in ':<>"|?*')
+            or any(not p or p in ('.', '..') or p.endswith((' ', '.'))
+                   or len(p.encode('utf-8')) > 255 for p in parts)):
+        _fail('cab_invalid_name')
+    reserved = {'con', 'prn', 'aux', 'nul'} | {f'{s}{i}' for s in ('com', 'lpt') for i in range(1, 10)}
+    if any(p.split('.')[0].casefold() in reserved for p in parts):
+        _fail('cab_invalid_name')
+    return value
+
+
+def read_cab_bytes(data, *, checkpoint=lambda: None):
+    """Return (relative_name, bytes) pairs after validating the whole archive.
+
+    Checksum zero means checksum absent per MS-CAB; nonzero checksums must
+    match. File and folder ranges must be contiguous, ordered, non-overlapping,
+    and exhaust the cabinet and decoded folder data. Unsupported profiles are
+    refused rather than partially extracted.
+    """
+    checkpoint()
+    if type(data) is not bytes or len(data) > MAX_BYTES:
+        _fail('cab_byte_limit')
+    if len(data) < 36:
+        _fail()
+    sig, r1, size, r2, files_at, r3, minor, major, nf, ne, flags, setid, index = struct.unpack_from('<4sIIIII BBHHHHH', data)
+    if sig != b'MSCF' or size != len(data) or r1 or r2 or r3 or (major, minor) != (1, 3):
+        _fail()
+    if flags & 3 or index:
+        _fail('cab_multivolume_archive')
+    if flags:
+        _fail('cab_reserved_extension_unsupported')
+    if not 1 <= ne <= MAX_ENTRIES or not 1 <= nf <= MAX_ENTRIES:
+        _fail('cab_entry_limit')
+    if files_at != 36 + 8 * nf or files_at > len(data):
+        _fail()
+    folders = []
+    block_count = 0
+    for n in range(nf):
+        start, count, method = struct.unpack_from('<IHH', data, 36 + 8*n)
+        if method not in (0, 1):
+            _fail('cab_compression_unsupported')
+        if not count or count > MAX_BLOCKS - block_count:
+            _fail('cab_block_limit')
+        block_count += count
+        folders.append((start, count, method))
+    pos = files_at
+    entries = []
+    names = set()
+    folder_ends = [0] * nf
+    last_folder = -1
+    for _ in range(ne):
+        checkpoint()
+        if pos + 16 > len(data):
+            _fail()
+        length, offset, folder, date, time, attrs = struct.unpack_from('<IIHHHH', data, pos)
+        pos += 16
+        if folder >= 0xfffd:
+            _fail('cab_multivolume_archive')
+        if folder >= nf or folder < last_folder:
+            _fail()
+        if attrs & 0x40:
+            _fail('cab_executable_member')
+        if attrs & ~0xa7:
+            _fail('cab_special_member')
+        end = data.find(b'\0', pos, min(pos + 257, len(data)))
+        if end < 0:
+            _fail('cab_invalid_name')
+        name = _name(data[pos:end], attrs)
+        pos = end + 1
+        folded = name.casefold()
+        if folded in names:
+            _fail('cab_invalid_name')
+        names.add(folded)
+        if offset != folder_ends[folder] or length > MAX_BYTES - offset:
+            _fail('cab_invalid_file_range')
+        folder_ends[folder] = offset + length
+        entries.append((name, folder, offset, length))
+        last_folder = folder
+    for name in names:
+        parts = name.split('/')
+        if any('/'.join(parts[:i]) in names for i in range(1, len(parts))):
+            _fail('cab_invalid_name')
+    if sum(folder_ends) > MAX_BYTES:
+        _fail('cab_byte_limit')
+    decoded = []
+    total_output = 0
+    total_packed = 0
+    for i, (start, count, method) in enumerate(folders):
+        checkpoint()
+        if start != pos:
+            _fail('cab_overlapping_or_unaccounted_data')
+        output = bytearray()
+        history = b''
+        for _ in range(count):
+            checkpoint()
+            if pos + 8 > len(data):
+                _fail()
+            csum, packed, unpacked = struct.unpack_from('<IHH', data, pos)
+            header = data[pos+4:pos+8]
+            pos += 8
+            if not unpacked:
+                _fail('cab_multivolume_archive')
+            if unpacked > 32768 or not packed or packed > 32768 + 12 or pos + packed > len(data):
+                _fail()
+            if total_output + unpacked > MAX_BYTES or len(output) + unpacked > folder_ends[i]:
+                _fail('cab_byte_limit')
+            payload = data[pos:pos+packed]
+            pos += packed
+            if csum and csum != (_checksum(payload) ^ _checksum(header)):
+                _fail('cab_data_checksum')
+            if method == 0:
+                if packed != unpacked:
+                    _fail('cab_compression_inconsistent')
+                block = payload
+            else:
+                if not payload.startswith(b'CK'):
+                    _fail('cab_compression_inconsistent')
+                try:
+                    inflater = zlib.decompressobj(-15, zdict=history) if history else zlib.decompressobj(-15)
+                    block = inflater.decompress(payload[2:], unpacked + 1)
+                    if (len(block) != unpacked or not inflater.eof
+                            or inflater.unused_data or inflater.unconsumed_tail):
+                        _fail('cab_compression_inconsistent')
+                except zlib.error:
+                    _fail('cab_compression_inconsistent')
+                history = (history + block)[-32768:]
+            total_output += unpacked
+            total_packed += packed
+            if total_output > max(RATIO_FLOOR, total_packed * MAX_RATIO):
+                _fail('cab_ratio_limit')
+            output.extend(block)
+            checkpoint()
+        if len(output) != folder_ends[i]:
+            _fail('cab_invalid_file_range')
+        decoded.append(bytes(output))
+    if pos != len(data):
+        _fail('cab_overlapping_or_unaccounted_data')
+    result = [(name, decoded[folder][offset:offset+size]) for name, folder, offset, size in entries]
+    checkpoint()
+    return result
