+def _workbook_layout(sheets):
+    """Measured, unwrapped text. There is one page per source sheet."""
+    width, height = WORKBOOK_PAGE_SIZE
+    size, spacing, padding = WORKBOOK_FONT_SIZE, WORKBOOK_SPACING, 11.0
+    pages = []
+    for sheet in sheets:
+        metrics = [[_measure(cell, size, spacing=spacing) for cell in row] for row in sheet]
+        widths = [max(right - left for left, _, right, _, _ in column) + 2 * padding
+                  for column in zip(*metrics, strict=True)]
+        if sum(widths) > width - 2 * MARGIN:
+            raise PDFReportError('pdf_text_does_not_fit')
+        page = []
+        for index, (row, boxes) in enumerate(zip(sheet, metrics, strict=True)):
+            baseline = height - MARGIN - size - index * WORKBOOK_ROW_HEIGHT
+            x = MARGIN
+            for cell, column_width, (left, bottom, _, top, _) in zip(row, widths, boxes, strict=True):
+                if cell:
+                    if baseline + bottom < MARGIN or baseline + top > height - MARGIN:
+                        raise PDFReportError('pdf_text_does_not_fit')
+                    page.append(dict(kind='text', text=cell, x=x + padding - left,
+                                     baseline=baseline, size=size, spacing=spacing))
+                x += column_width
+        if not page:
+            raise PDFReportError('pdf_text_does_not_fit')
+        pages.append(page)
+    return pages
