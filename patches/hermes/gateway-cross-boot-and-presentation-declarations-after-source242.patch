+            return False
+        alive = _pid_incarnation_matches(record.pid, None)
+        if alive is not True:
+            return alive
+        ticks = _read_linux_start_ticks(record.pid)
+        if ticks is not None and ticks != record.start_time:
+            return False
+        return True if boot_id is not None and ticks is not None else None
+
+    # Protocol-v1 publishers without a boot ID may have recorded either the
+    # canonical start value or only the wall-clock creation time.
+    alive = _pid_incarnation_matches(record.pid, None)
+    if alive is not True:
+        return alive
+    if record.start_time is None:
+        return (_pid_incarnation_matches(record.pid, record.create_time)
+                if record.create_time is not None else None)
+    from gateway.status import get_process_start_time
+
+    current = get_process_start_time(record.pid)
+    if current is None:
