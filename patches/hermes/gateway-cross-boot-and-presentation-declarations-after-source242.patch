+def _valid_linux_boot_id(value: Any) -> bool:
+    return isinstance(value, str) and len(value) == 36 and _LINUX_BOOT_ID.fullmatch(value) is not None
+
+
+def _read_linux_boot_id() -> Optional[str]:
+    """Read the kernel's bounded boot UUID."""
+    try:
+        with Path("/proc/sys/kernel/random/boot_id").open("rb") as stream:
+            value = stream.read(38).decode("ascii").removesuffix("\n")
+    except (OSError, UnicodeDecodeError):
+        return None
+    return value if _valid_linux_boot_id(value) else None
+
+
+def _read_linux_start_ticks(pid: int) -> Optional[int]:
+    """Read field 22 in /proc/PID/stat without falling back to epoch centiseconds."""
+    try:
+        with Path(f"/proc/{pid}/stat").open("rb") as stream:
+            raw = stream.read(4097)
+        # The command can contain spaces and parentheses. starttime is index 19 after comm.
+        prefix, separator, tail = raw.rpartition(b") ")
+        if len(raw) > 4096 or not separator or not prefix.startswith(f"{pid} (".encode("ascii")):
+            return None
+        ticks = tail.split()[19]
+        if 0 < len(ticks) <= 20 and ticks.isdigit():
+            return int(ticks) or None
+    except (OSError, IndexError):
+        pass
+    return None
+
+
+def _linux_gateway_incarnation_matches(record: HostRecord) -> Optional[bool]:
+    if record.boot_id is not None:
+        boot_id = _read_linux_boot_id()
