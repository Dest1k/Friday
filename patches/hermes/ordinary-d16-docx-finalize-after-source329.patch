@@ -1,6 +1,7 @@
 """Internal settlement and single-buffer protected receipt join for the owned D02 arm."""
 
 import asyncio
+from contextlib import nullcontext
 from hashlib import sha256
 from importlib import import_module
 import json
@@ -92,6 +93,45 @@ def _storage_signature(state):
                      directory, directory / ".state.json.lock", directory / "state.json")))
 
 
+def _retained_d16_scope(arm, wire, home, profile, routed, principal):
+    selected = getattr(arm.claim, "selected_d16_seed", None)
+    if selected is None:
+        return None
+    from gateway.d16_seed_custody import SCENARIO_SHA256
+
+    evidence = arm.ingress
+    original = evidence._d16_seed_cutoff
+    updates = wire["target_update_ids"]
+    if (original is None or selected != (SCENARIO_SHA256, original.run_id)
+            or original.cutoff != arm.window._cutoff or len(updates) != 1):
+        raise ValueError("d16_exact_receipt_scope_unproved")
