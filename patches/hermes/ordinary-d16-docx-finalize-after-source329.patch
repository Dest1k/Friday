index 0000000000000000000000000000000000000000..ba97e45cf4b9e5c0acd1f7bdd5e920f7e30c3b1c
--- /dev/null
+++ b/gateway/d16_seed_receiver_control.py
@@ -0,0 +1,129 @@
+"""Protected settlement of only the exact D16 seed edit."""
+
+from dataclasses import dataclass
+from functools import partial
+from hashlib import sha256
+import time
+
+from .d02_receiver_control import ReceiverControl, _encode, _ordinary_receiver_verb, require
+from .d16_seed_custody import CAPTION_SHA256, SCENARIO_SHA256, TERMINAL_SCHEMA, match_document, project_rows
+from .run_inbound_media import verify_published_d16_seed_input
+from .s08_session_fence import project_session_fence
+
+
+@dataclass(frozen=True, slots=True)
+class BoundCutoff:
+    run_id: str
+    cutoff: float
+    sender_message_id: int
+    sender: dict
+    ack_started: float
+    proof_sha256: str
+
+
+def _sender(run, ack, scenario):
+    sender = ReceiverControl._ordinary_document_ack(run, ack, scenario, "d16_exact_original_document_ack")
+    require(sender["caption_sha256"] == CAPTION_SHA256 and type(sender["date"]) is int
+            and 0 < sender["date"] < 2**63, "d16_exact_original_document_ack")
+    return sender
+
+
+def _original_cutoff(cutoff, verified, scenario):
+    run = verified["run"]
+    sender = _sender(run, verified["ack"], scenario)
+    before, after = verified["ack_monotonic"]
+    require(cutoff == after + 180, "d16_original_cutoff_clock_changed")
+    proof = {
+        "ack": run["sent_api_ack_reference"], "window": run["sent_window_reference"],
+        "clock": verified["original_clock"], "wall_cutoff": run["capture_until"],
+        "task": run["sent_task_reference"],
+    }
+    return BoundCutoff(run["id"], cutoff, run["sent_message_id"], sender, before,
+                       sha256(_encode(proof)).hexdigest())
+
+
+class D16SeedReceiverControl(ReceiverControl):
+    request_schema = "frw.gateway.d16-seed-owned-receiver-control.v1"
+    options_schema = "frw.Root.D16Seed.receiver-options.v1"
+    driver_schema = "frw.Root.D16Seed.owned-ordinary-driver.v1"
+    exact_phases = frozenset((SCENARIO_SHA256,))
+    terminal_schema = TERMINAL_SCHEMA
+    strict_terminal_extra = True
+
+    def _wire_options(self, intent):
+        return {"selected_d16_seed": (SCENARIO_SHA256, intent["run_id"])}
+
+    @staticmethod
+    def _check_ack_window(run, ack, window, scenario):
+        ReceiverControl._check_ack_window(run, ack, window, scenario)
+        _sender(run, ack, scenario)
+
+    def _bind_terminal_cutoff(self, arm, window, cutoff, verified):
+        ingress = arm.ingress
+        run = verified["run"]
+        binding = _original_cutoff(cutoff, verified, run["scenario"])
+        wire = ingress._wire()
+        require(arm.claim.selected_d16_seed == (SCENARIO_SHA256, binding.run_id)
+                and arm.window is window is ingress.window and ingress._d16_seed_cutoff is None
+                and wire is not None and wire["state"] == "OPEN" and time.monotonic() < cutoff,
+                "d16_exact_open_cutoff_required")
+        window.bind_cutoff(cutoff)
+        ingress._d16_seed_cutoff = binding
+
+    def _terminal_extra(self, arm, route, scenario, joined, verified, deadline):
+        ingress = arm.ingress
+        wire = ingress._wire()
+        require(wire is not None and wire["state"] == "LOCAL_WIRE_CLOSED"
+                and ingress._settlement_state() == "SETTLED"
+                and len(wire["target_update_ids"]) == len(joined["observations"]) == 1,
+                "d16_exact_closed_singleton_required")
+        bound = ingress._d16_seed_cutoff
+        run = verified["run"]
+        require(bound is not None and arm.claim.selected_d16_seed == (SCENARIO_SHA256, bound.run_id)
+                and bound == _original_cutoff(arm.window._cutoff, verified, scenario)
+                and wire["empty_boundary"][0] >= bound.cutoff,
+                "d16_original_cutoff_or_ack_changed")
+        update, = wire["target_update_ids"]
+        record = ingress._built[update]
+        candidate, publication, delivery = (record.d16_seed_native, record.d16_seed_publication,
+                                             record.d16_seed_delivery)
+        require(candidate is not None and publication is not None and candidate.raw is None
+                and delivery is not None and delivery.candidate is not None
+                and bound.ack_started <= candidate.observed_monotonic < bound.cutoff
+                and all(candidate.sdk[key] == value for key, value in bound.sender.items()),
+                "d16_original_ack_sdk_document_or_delivery_missing")
+        (receipt, raw_caption), = joined["observations"]
+        message, sdk = receipt["message"], candidate.sdk
+        require(sdk["update_id"] == str(update) and raw_caption == candidate.caption()
+                and receipt["platform"] == "telegram" and receipt["chat_type"] == "dm"
+                and all(receipt[key] == value for key, value in route.items())
+                and match_document(sdk, message)
+                and message["media"][0]["local_reference"] == str(publication.evidence.path)
+                and sdk["date"] <= delivery.candidate[2] <= run["capture_until"],
+                "d16_exact_durable_route_pair_required")
+
+        def current():
+            return (time.monotonic() < deadline and ingress._wire() == wire
+                    and ingress._settlement_state() == "SETTLED" and ingress._d16_seed_cutoff is bound
+                    and record.d16_seed_delivery is delivery)
+
+        require(current() and verify_published_d16_seed_input(publication, still_current=current),
+                "d16_original_publication_identity_changed")
+        _, turn = project_session_fence(ingress.adapter.gateway_runner, ingress.scope, receipt,
+            started=sdk["date"], cutoff=run["capture_until"], deadline=deadline,
+            project=partial(project_rows, delivery, sdk, publication))
+        require(current(), "d16_exact_terminal_state_changed")
+        return {
+            "d16_sender_ack": run["sent_api_ack_reference"],
+            "d16_sender_message_id": str(bound.sender_message_id),
+            "d16_receiver_update_id": sdk["update_id"],
+            "d16_receiver_message_id": sdk["native_message_id"],
+            "d16_sdk": sdk,
+            "d16_source_identity": list(publication.evidence.source_identity),
+            "d16_source_directories": [list(identity) for identity in publication.directories],
+            "d16_turn": turn,
+        }
+
+
+def ordinary_d16_seed_receiver_verb(runner, loop):
+    return _ordinary_receiver_verb(runner, loop, control_type=D16SeedReceiverControl)
