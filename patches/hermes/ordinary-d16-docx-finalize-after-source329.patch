index 0000000000000000000000000000000000000000..0f810cbce4c669f8c27656b1d44785bf1ad50748
--- /dev/null
+++ b/gateway/d16_seed_custody.py
@@ -0,0 +1,291 @@
+"""Observe one exact D16 upload and its existing native document writer."""
+
+import asyncio
+from dataclasses import dataclass
+from hashlib import sha256
+from pathlib import PurePosixPath
+import re
+import time
+
+from .ordinary_d05_turn import _object, _relative_docx
+from .s08_document_custody import capture_document, require
+
+SCENARIO_SHA256 = "9357988c9b0e47e0609c6ef642eb2528da80ba43f734127cc2195dc83df5e034"
+SOURCE_SHA256 = "b773d35520fdf8ed4e65980e941349ca7c9fa9a1ba040fedf83bb498197142cc"
+SOURCE_BYTES = 3134
+SOURCE_NAME = "D16-Veresk-84-original.docx"
+SOURCE_MIME = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
+OUTPUT_NAME = "D16-Veresk-84-edit.docx"
+CAPTION_SHA256 = "9b086ad9397db855fe57815e02ce87b52ed782f4096ec48b534b6786d47a1371"
+TERMINAL_SCHEMA = "frw.gateway.d16-seed-native-settlement.v1"
+
+
+@dataclass(frozen=True, slots=True)
+class SelectedSeed:
+    sdk: dict
+    observed_monotonic: float
+    raw: object
+    update: object
+
+    @classmethod
+    def capture(cls, ingress, update, event):
+        sdk = capture_document(ingress.adapter, update, event, actor=ingress.claim.user_id,
+                               bot_id=ingress.scope["bot_id"], source_bytes=SOURCE_BYTES)
+        require((sdk["file_name"], sdk["mime_type"], sdk["caption_sha256"])
+                == (SOURCE_NAME, SOURCE_MIME, CAPTION_SHA256), "d16_exact_sdk_document")
+        return cls(sdk, time.monotonic(), event.raw_message, update)
+
+    def is_original(self, ingress, event):
+        return (self.raw is event.raw_message and self.update is not None
+                and self.capture(ingress, self.update, event).sdk == self.sdk)
+
+    def caption(self):
+        return {"kind": "caption", "date": self.sdk["date"], "sha256": self.sdk["caption_sha256"]}
+
+
+def match_document(sdk, message):
+    media = message["media"]
+    if (len(media) != 1 or tuple(message[field] for field in (
+            "platform_update_id", "message_id", "bot_id", "user_id", "chat_id", "thread_id",
+            "reply_to_message_id")) != (sdk["update_id"], sdk["native_message_id"], sdk["bot_id"],
+                                       sdk["actor_id"], sdk["actor_id"], "", "")):
+        return False
+    item = media[0]
+    origin = item["origin"]
+    return (item["mime_type"] == sdk["mime_type"]
+            and item["content"] == {"sha256": SOURCE_SHA256, "size_bytes": SOURCE_BYTES}
+            and all(origin[key] == message[key] for key in ("bot_id", "chat_id", "thread_id", "message_id"))
+            and all(origin[key] == sdk[key] for key in ("file_id", "file_unique_id", "declared_bytes")))
+
+
+def selected_publication(event, message):
+    from .ordinary_dm_ingress import _ingress
+    from .session_identity import identity_of
+
+    if getattr(event, "_ordinary_dm_ingress_stamp", None) is None:
+        return False
+    try:
+        identity = identity_of(event.source)
+        ingress = _ingress(identity.adapter()) if identity is not None else None
+        if ingress is None or getattr(ingress.claim, "selected_d16_seed", None) is None:
+            return False
+        update = ingress.select(event, event.source, identity, ingress.scope["session_key"])
+        candidate = ingress._built[update].d16_seed_native if update is not None else None
+        return candidate is not None and candidate.is_original(ingress, event) and match_document(candidate.sdk, message)
+    except (AttributeError, KeyError, RuntimeError, TypeError, ValueError):
+        return False
+
+
+@dataclass(slots=True)
+class DocumentAttempt:
+    ingress: object
+    record: object
+    source: object
+    run: tuple
+    turn: tuple
+    session_id: str
+    relative: str
+    output: dict
+    scope: dict
+    candidate: tuple | None = None
+
+    def capture(self, receipt, native_candidate, stamp, row_identity, check):
+        """Called only after the stock delivery journal and hidden row commit."""
+        from hermes_cli.friday_native_state import encoded
+
+        try:
+            session, row, uid = row_identity
+            selection = sha256(encoded([self.scope["principal"], self.relative])).hexdigest()
+            require(self.record.d16_seed_delivery is self and self.candidate is None
+                    and self.record.writer_task() is asyncio.current_task() and not self.record.settled
+                    and self.source._friday_document_run is self.run
+                    and self.source._friday_document_turn is self.turn
+                    and self.source._friday_document_session_id == self.session_id == session
+                    and time.monotonic() < self.ingress.claim.expires_monotonic
+                    and type(row) is int and row > 0 and _uid(uid)
+                    and type(receipt) is dict and set(receipt) == self.output.keys() | {"message_id"}
+                    and all(receipt[name] == value for name, value in self.output.items())
+                    and re.fullmatch(r"[1-9][0-9]{0,30}", receipt["message_id"])
+                    and receipt["message_id"] != receipt["reply_to"]
+                    and native_candidate == encoded({"selection": selection, "receipt": receipt}),
+                    "d16_original_writer_changed")
+            check()
+            self.candidate = dict(receipt), sha256(native_candidate).hexdigest(), stamp, row, uid
+        except (AttributeError, KeyError, OSError, RuntimeError, TypeError, ValueError):
+            self.record.d16_seed_delivery = None
+
+
+def observe_document_attempt(adapter, source, cap, route, relative, name, data):
+    """Observe one native reply attempt without granting or changing delivery authority."""
+    from .ordinary_dm_ingress import _ingress
+    from .run_attachment_presentation import _scope
+
+    ingress = _ingress(adapter)
+    if ingress is None or getattr(ingress.claim, "selected_d16_seed", None) is None:
+        return None
+    try:
+        if source is not ingress._receipt_source:
+            return None
+        wire = ingress._wire()
+        update, = wire["target_update_ids"]
+        record = ingress._built[update]
+        if record.d16_seed_attempted:
+            record.d16_seed_delivery = None
+            return None
+        record.d16_seed_attempted = True
+        run, turn = source._friday_document_run, source._friday_document_turn
+        event = record.event_ref()
+        sdk = record.d16_seed_native.sdk
+        require(record.writer_task is not None and record.writer_task() is asyncio.current_task()
+                and not record.settled and update in ingress._commits
+                and event is not None and event.source is source
+                and record.d16_seed_native.is_original(ingress, event)
+                and record.d16_seed_publication is not None
+                and run[0] == turn[0] == ingress.scope["session_key"]
+                and turn[1] and turn[1] == event._gateway_active_turn_token
+                and str(cap.home) == ingress.scope["runtime_home"]
+                and str(cap.authorization_home) == ingress.scope["authorization_home"]
+                and cap.profile == ingress.scope["runtime_profile"]
+                and PurePosixPath(_relative_docx(relative)).name == OUTPUT_NAME == name
+                and 0 < len(data) <= 1048576
+                and route["bot_id"] == sdk["bot_id"] and route["runtime_profile"] == cap.profile
+                and route["transport_profile"] == ingress.scope["transport_profile"]
+                and tuple(route["source"][key] for key in
+                          ("platform", "chat_type", "user_id", "chat_id", "thread_id", "message_id"))
+                == ("telegram", "dm", sdk["actor_id"], sdk["actor_id"], None, sdk["native_message_id"]),
+                "d16_original_document_writer_required")
+        output = {"state": "DELIVERED", "kind": "document", "sha256": sha256(data).hexdigest(),
+                  "bytes": len(data), "file_name": name, "bot_id": sdk["bot_id"],
+                  "chat_id": sdk["actor_id"], "thread_id": None, "reply_to": sdk["native_message_id"]}
+        attempt = DocumentAttempt(ingress, record, source, run, turn, source._friday_document_session_id,
+                                  relative, output, _scope(cap))
+        record.d16_seed_delivery = attempt
+        return attempt
+    except (AttributeError, KeyError, RuntimeError, TypeError, ValueError):
+        return None
+
+
+def _uid(value):
+    return type(value) is str and re.fullmatch(r"[0-9a-f]{32}", value) is not None
+
+
+def _tool_path(value, workspace):
+    require(type(value) is str and 0 < len(value) <= 4096, "d16_tool_path_required")
+    path = PurePosixPath(value)
+    if path.is_absolute():
+        require(path.is_relative_to(workspace), "d16_tool_path_outside_workspace")
+        path = path.relative_to(workspace)
+    return _relative_docx(path.as_posix())
+
+
+def _tool_rows(rows, relative, output_path, receipt, workspace):
+    """Project only paired ordinary canonical rows and the exact seed edit."""
+    import json
+
+    text_edit = {"source": relative, "old_text": "VERESK84-APRIL-12", "new_text": "VERESK84-APRIL-19"}
+    located_edit = dict(text_edit, source_sha256=SOURCE_SHA256, paragraph=3)
+    cursor, total_lines, read_rows, edit = (1, 0), None, [], None
+    for call_row, tool in zip(rows[::2], rows[1::2], strict=True):
+        call, = json.loads(call_row["tool_calls"])
+        call_id, name = call["id"], call["function"]["name"]
+        occurrence = _object(call_row["tool_call_uids"])[call_id]
+        require(call_row["role"] == "assistant" and tool["role"] == "tool"
+                and name == tool["tool_name"] and call_id == tool["tool_call_id"]
+                and _uid(occurrence) and occurrence == tool["tool_call_uid"]
+                and tool["effect_disposition"] is None, "d16_exact_canonical_tool_pair")
+        args, result = _object(call["function"]["arguments"]), _object(tool["content"])
+        require(result["success"] is True and result["scope"] == "own_user_workspace",
+                "d16_ordinary_tool_result_required")
+        if name == "read_file":
+            require(edit is None and cursor is not None and {"path"} <= args.keys() <=
+                    {"path", "offset", "char_offset", "limit"}
+                    and _tool_path(args["path"], workspace) == result["path"] == relative
+                    and (args.get("offset", 1), args.get("char_offset", 0)) == cursor
+                    and result["source_sha256"] == SOURCE_SHA256 and result["format"] == "docx"
+                    and result["extracted_document"] is True, "d16_exact_source_read_required")
+            following = (result["next_offset"], result["next_char_offset"])
+            total = result["total_lines"]
+            require(type(total) is int and 0 < total <= 100000 and total_lines in (None, total)
+                    and all(type(value) is int for value in following)
+                    and cursor < following <= (total + 1, 0) and 0 <= following[1] <= 1000000
+                    and result["partial"] is (following != (total + 1, 0)), "d16_source_read_cursor")
+            cursor, total_lines = (following if result["partial"] else None), total
+            read_rows.append(tool["id"])
+        else:
+            require(edit is None and cursor is None and read_rows and name == "write_file"
+                    and set(args) == {"path", "format", "content"}
+                    and _tool_path(args["path"], workspace) == result["path"] == output_path
+                    and type(result["replacements"]) is int and result["replacements"] == 1
+                    and result["source"] == relative and result["source_sha256"] == SOURCE_SHA256
+                    and result["sha256"] == receipt["sha256"] != SOURCE_SHA256
+                    and type(result["bytes_written"]) is int and result["bytes_written"] == receipt["bytes"]
+                    and all(result[key] is True for key in
+                            ("verified", "create_only", "source_unchanged", "unchanged_parts_preserved")),
+                    "d16_exact_seed_edit_required")
+            spec = _object(args["content"])
+            spec["source"] = _tool_path(spec.get("source"), workspace)
+            if args["format"] == "word_located_edit":
+                require(result["format"] == "word_located_edit" and spec == located_edit
+                        and type(result["paragraph"]) is int and result["paragraph"] == 3,
+                        "d16_exact_located_edit_required")
+            else:
+                require(args["format"] == "docx_edit" and result["format"] == "docx"
+                        and result["edit_mode"] == "exact_text" and spec == text_edit,
+                        "d16_exact_text_edit_required")
+            edit = tool["id"]
+    require(edit is not None, "d16_native_edit_missing")
+    return read_rows, edit
+
+
+def project_rows(delivery, sdk, publication, db, fence, *, deadline):
+    """Join the receiving USER row, ordinary tools and the native DELIVERED row."""
+    ingress = delivery.ingress
+    receipt, journal, stamp, delivered_id, delivered_uid = delivery.candidate
+    sid = fence["session_id"]
+    runner = ingress.adapter.gateway_runner
+    cap = publication.owner
+    relative = publication.evidence.path.relative_to(cap.home / "workspace").as_posix()
+    require(re.fullmatch(r"received/telegram_[0-9a-f]{64}_[A-Za-z0-9_.-]{1,80}\.docx", relative)
+            and time.monotonic() < deadline and sid == delivery.session_id
+            and runner._is_session_run_current(*delivery.run)
+            and fence["user_row_id"] < delivered_id <= fence["terminal_row_id"],
+            "d16_current_terminal_rows_required")
+    rows = db.execute(
+        "SELECT id,role,message_uid,platform_message_id,display_metadata,content,timestamp,tool_calls,"
+        "tool_call_uids,tool_call_uid,tool_call_id,tool_name,effect_disposition,display_kind,active,compacted "
+        "FROM messages WHERE session_id=? AND id BETWEEN ? AND ? ORDER BY id LIMIT 134",
+        (sid, fence["user_row_id"], fence["terminal_row_id"]),
+    ).fetchall()
+    require(4 <= len(rows) < 134 and rows[-1]["id"] == fence["terminal_row_id"]
+            and all(row["active"] == 1 and row["compacted"] == 0 and _uid(row["message_uid"])
+                    for row in rows) and len({row["message_uid"] for row in rows}) == len(rows),
+            "d16_exact_native_transcript_bounds")
+    user, *tail = rows
+    expected_upload = {"schema": "friday.ordinary-direct-upload.v1", "scope": delivery.scope,
+                       "source_message_id": sdk["native_message_id"],
+                       "file": {"path": relative, "file_name": SOURCE_NAME, "sha256": SOURCE_SHA256,
+                                "size_bytes": SOURCE_BYTES}}
+    require(user["role"] == "user" and user["platform_message_id"] == sdk["native_message_id"]
+            and _object(user["display_metadata"])["friday_direct_upload"] == expected_upload,
+            "d16_native_user_archive_mismatch")
+    visible = []
+    terminal_seen = False
+    for row in tail:
+        if row["id"] == delivered_id:
+            require(row["role"] == "assistant" and row["display_kind"] == "hidden" and row["content"] == ""
+                    and row["message_uid"] == delivered_uid and row["timestamp"] == stamp
+                    and _object(row["display_metadata"]) == {"friday_file_delivery_observation": {
+                        "path": delivery.relative, "sha256": receipt["sha256"], "state": "DELIVERED"}},
+                    "d16_native_delivery_row_mismatch")
+            terminal_seen = True
+        if row["role"] == "tool" or row["tool_calls"] not in (None, "", "[]"):
+            require(not terminal_seen, "d16_unrelated_late_tool_row")
+            visible.append(row)
+        else:
+            require(row["role"] == "assistant", "d16_unrelated_native_turn_row")
+    require(terminal_seen, "d16_native_delivery_row_missing")
+    reads, edit = _tool_rows(visible, relative, delivery.relative, receipt, cap.home / "workspace")
+    return {"session_id": sid, "turn_generation": delivery.run[1], "user_row_id": user["id"],
+            "read_row_ids": reads, "edit_row_id": edit, "source": expected_upload["file"],
+            "native_document": receipt, "output_relative_path": delivery.relative, "delivery_row_id": delivered_id,
+            "native_journal_sha256": journal}
