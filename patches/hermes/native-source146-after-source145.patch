+"""Bounded, hash-bound ODG/FODG plain-label copy edits.
+
+Only one explicitly addressed direct page object is changed. XML outside its
+paragraph interiors and every other uncompressed package member are retained.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import io
+import json
+import re
+import zipfile
+from xml.parsers import expat
+from xml.sax.saxutils import escape
+
+from tools.scoped_odg import D, T, XML, ODGError, _load, _label, extract_diagram
+from tools.scoped_odg_write import _text
+from tools.scoped_presentation import q
+
+MAX_BYTES = 1_000_000
+GUIDANCE = ('diagram_text_edit creates a NEW .odg/.fodg copy of the same type using '
+    'exactly {source,source_sha256,page,object_id,old_text,new_text}. page is one-based; '
+    'object_id is the exact local XML/draw ID returned by read_file. Only UTF-8 XML '
+    'and direct page rect/ellipse/connector objects with prefixed plain paragraphs '
+    'are supported; new_text '
+    'must retain the number of newline-separated paragraphs. Whole old_text must '
+    'match, may repeat in other objects, and must be nonempty. All other XML bytes '
+    'and uncompressed package members/descriptive ZIP metadata are retained; '
+    'compressed ZIP bytes and encoding flags may change. Rich text, groups, text boxes, '
+    'self-closing paragraphs, comments/processing instructions in edited XML, '
+    'templates, active/external content, no-ops, overwrite and conversion refuse. '
+    'Original stays unchanged; source hash, own workspace, cancellation and CAS '
+    'are checked. This is a stored label edit; no rendering or visual-fit claim. ')
+
+
+def fail(code):
+    raise ODGError('odg_edit_' + code)
+
+
+def parse_request(content):
+    if type(content) is not str or len(content) > 20000:
+        fail('request_limit')
+    try:
+        if len(content.encode('utf-8')) > 20000:
+            fail('request_limit')
+        def pairs(items):
+            result = {}
+            for key, value in items:
+                if key in result:
+                    fail('duplicate_key')
+                result[key] = value
+            return result
+        spec = json.loads(content, object_pairs_hook=pairs,
+                          parse_constant=lambda _: fail('nonfinite'))
+    except (ValueError, RecursionError, UnicodeError) as error:
+        if isinstance(error, ODGError):
+            raise
+        fail('invalid_request')
+    return _validate_spec(spec)
+
+
+def _validate_spec(spec):
+    if type(spec) is not dict or set(spec) != {
+            'source', 'source_sha256', 'page', 'object_id', 'old_text', 'new_text'}:
+        fail('request_fields')
+    source = spec['source']
+    if type(source) is not str or not source or len(source) > 512:
+        fail('source')
+    try:
+        if len(source.encode('utf-8')) > 512:
+            fail('source')
+    except UnicodeError:
+        fail('source')
+    if type(spec['page']) is not int or not 1 <= spec['page'] <= 200:
+        fail('page')
+    if type(spec['object_id']) is not str or not re.fullmatch(r'[A-Za-z_][\w.:-]{0,255}', spec['object_id']):
+        fail('object_id')
+    if type(spec['source_sha256']) is not str or not re.fullmatch('[0-9a-f]{64}', spec['source_sha256']):
+        fail('source_hash')
+    # The existing creator's XML character and UTF-8 size rules apply here too.
+    from tools.scoped_odg_write import ODGCreateError
+    try:
+        _text(spec['old_text']); _text(spec['new_text'])
+    except ODGCreateError as error:
+        fail(error.code)
+    if not spec['old_text'] or spec['old_text'] == spec['new_text']:
+        fail('no_change')
+    if len(spec['old_text'].split('\n')) != len(spec['new_text'].split('\n')):
+        fail('paragraph_count')
+    return dict(spec)
+
+
+def _selection(drawing, spec):
+    pages = list(drawing)
+    if spec['page'] > len(pages):
+        fail('page_missing')
+    matches = [n for n in pages[spec['page'] - 1]
+               if spec['object_id'] in (n.get(q(XML, 'id')), n.get(q(D, 'id')))]
+    if len(matches) != 1 or matches[0].tag not in {q(D, s) for s in ('rect', 'ellipse', 'connector')}:
+        fail('object_missing_or_unsupported')
+    target = matches[0]
+    paragraphs = target.findall(q(T, 'p'))
+    if not paragraphs or any(n.tag.startswith(q(T, '')) and n.tag != q(T, 'p') for n in target):
+        fail('paragraph_structure')
+    for p in paragraphs:
+        if set(p.attrib) - {q(T, 'style-name'), q(XML, 'space')}:
+            fail('paragraph_attributes')
+        for n in p:
+            if n.tag not in {q(T, 's'), q(T, 'tab')} or len(n) or n.text:
+                fail('rich_text')
+            if set(n.attrib) - ({q(T, 'c')} if n.tag == q(T, 's') else set()):
+                fail('rich_text_attributes')
+    text, unknown = _label(target)
+    if unknown or text != spec['old_text'] or len(paragraphs) != len(text.split('\n')):
+        fail('text_mismatch')
+    return target
+
+
+def _xml_edit(data, spec, checkpoint):
+    try:
+        data.decode('utf-8-sig')
+    except UnicodeError:
+        fail('xml_encoding')
+    declaration = re.match(rb'\xef\xbb\xbf|', data).end()
+    if data[declaration:].startswith(b'<?xml'):
+        head = data[declaration:data.find(b'?>') + 2]
+        encoding = re.search(rb'encoding\s*=\s*[\x22\x27]([^\x22\x27]+)', head)
+        if encoding and encoding[1].lower() not in (b'utf-8', b'utf8'):
+            fail('xml_encoding')
+    parser = expat.ParserCreate(namespace_separator='}')
+    stack = []; spans = []; page = 0
+    def start(name, attrs):
+        nonlocal page
+        if checkpoint:
+            checkpoint()
+        if name == D + '}page':
+            page += 1
+        selected = (name in {D + '}' + k for k in ('rect', 'ellipse', 'connector')}
+                    and stack and stack[-1][0] == D + '}page'
+                    and page == spec['page']
+                    and spec['object_id'] in (attrs.get(XML + '}id'), attrs.get(D + '}id')))
+        paragraph = name == T + '}p' and stack and stack[-1][2]
+        stack.append((name, parser.CurrentByteIndex, selected, paragraph))
+    def end(name):
+        _, offset, _, paragraph = stack.pop()
+        if paragraph:
