+"""Own-workspace hash-bound native drawing label copy publication."""
+import hashlib
+import json
+from pathlib import PurePosixPath
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_revision import check
+from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+from hermes_cli.friday_workspace_zip import _source, _verify, _path, _encode, _inline_budget, _fits, _capacity
+from tools.scoped_odg import ODGError
+from tools.scoped_odg_edit import parse_request, edit_diagram
+
+
+def create_edit(cap, fd, leaf, relative, content):
+    _check_parent(cap, fd, relative)
+    format = PurePosixPath(relative).suffix.lower().lstrip('.')
+    if format not in ('odg', 'fodg') or PurePosixPath(relative).name != leaf:
+        raise ScopeDenied()
+    try:
+        spec = parse_request(content)
+        source = _path(spec['source'])
+        if source == relative or PurePosixPath(source).suffix.lower() != '.' + format:
+            raise ScopeDenied()
+        original, identity = _source(cap, source)
+        sources = [(source, original, identity)]
+        data = edit_diagram(original, spec, format, checkpoint=lambda: check(cap))
+    except ODGError as error:
+        return _encode(dict(success=False, error='diagram_text_edit_refused', reason=error.code, effect_disposition='none'))
+    receipt = dict(operation='diagram_text_edit', source_sha256=hashlib.sha256(original).hexdigest(),
+                   source_unchanged=True, other_member_payloads_preserved=True,
+                   other_xml_bytes_preserved=True, rendered=False)
+    estimate = dict(receipt, success=True, path=relative, format=format, scope='own_user_workspace',
+                    create_only=True, verified=True, bytes_written=len(data), sha256=hashlib.sha256(data).hexdigest())
+    if not _fits(estimate, _inline_budget()):
+        return _capacity(_inline_budget())
+    _verify(cap, sources)
+    answer = json.loads(_create_bytes(cap, fd, leaf, relative, data, output_format=format,
+                                     verify_source=lambda: _verify(cap, sources)))
+    if answer.get('success'):
+        answer.update(receipt)
+    return _encode(answer)
