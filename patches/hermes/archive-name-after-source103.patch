+            if (not isinstance(params,dict) or set(params)!=fields
+                    or params['schema']!='frw.Root.s05-owned-native-stop.v1' or params['text']!='/stop'
+                    or re.fullmatch(r'root-(?:s05|s07)-[a-f0-9]{12}',params['operation_id'] or '')is None):
