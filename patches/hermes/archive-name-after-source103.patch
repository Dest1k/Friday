+            or getattr(registry_module, 'process_registry', None) is not registry
+            or runner._peek_session_state(KEY) is not state
+            or runner.session_store._entries.get(KEY) is not entry or entry.session_id != SID
+            or (state is not None and (state.turn is not turn or state.persistent is not persistent
+                or persistent.run_generation != generation or state.conversation is not conversation))
+            or (turn is not None and (turn.agent is not active_agent or turn.ctx is not ctx
+                or turn.event is not event))
