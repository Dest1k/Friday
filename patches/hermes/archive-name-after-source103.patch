+    if type(generation) is not int or generation < 0:
+        raise RuntimeError('native_generation_shape')
+    maps = [runner.adapters, *runner._profile_adapters.values()]
+    adapters = list({id(a): a for mapping in maps for a in mapping.values()}.values())
+    if not adapters or any(not hasattr(a, '_pending_messages') or not hasattr(a, '_active_sessions') for a in adapters):
+        raise RuntimeError('native_adapter_queue_introspection_unavailable')
+    pending = sum(KEY in a._pending_messages for a in adapters)
+    active_adapters = sum(KEY in a._active_sessions for a in adapters)
+    adapter_generations = [getattr(a._active_sessions[KEY], '_hermes_run_generation', None)
+                           for a in adapters if KEY in a._active_sessions]
+    tokens = [] if turn is None else [dict(session_id=t.session_id, owner_key=t.owner_key,
+        generation=t.generation, released=t.released) for t in turn.lease_tokens.values()]
+    ctx = None if turn is None else turn.ctx
+    event = None if turn is None else turn.event
+    registry_module = sys.modules.get('tools.process_registry')
+    registry = None if registry_module is None else getattr(registry_module, 'process_registry', None)
+    if registry is None:
+        raise RuntimeError('native_existing_registry_unavailable')
+    # The existing loop has no await here; also reject any owner/scope change
+    # observed while bounded worker locks are acquired.
+    active_agent = None if turn is None else turn.agent
+    event_id = None if event is None else str(event.message_id)
+    ctx_fields = None if ctx is None else (ctx.inbound_message_id, ctx.run_generation)
+    # One locked custody window preserves legacy coverage and exact own-call joins.
+    own_web, web = _own_web_inflight(active_agent,
+                                    registry, generation, event)
