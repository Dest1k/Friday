+                _cancel_compare(runner,expected,home,params['source_receipt_sha256'],params['rights_sha256'])
+                state=runner._peek_session_state(KEY);event=state.turn.event;source=event.source
+                if runner._check_slash_access(source,'stop')is not None:
+                    raise RuntimeError('ordinary_stop_access_changed')
