+This is a codec, not a product authority/cancellation adapter: its caller retains
+the existing workspace checks and original native call deadline/stop boundary.
+"""
+import base64
+import io
+import json
+import lzma
+import os
+from pathlib import Path
+import selectors
+import signal
+import stat
+import subprocess
+import sys
+import time
