+def _checked_root_intent(pin):
+    import json
+    import stat
+    path=Path(pin['path'])
+    if not path.is_absolute() or any(p.is_symlink() for p in (path,*path.parents)):
+        raise RuntimeError('root_intent_path')
+    info=path.stat();parent=path.parent.stat()
+    if (info.st_uid!=os.getuid() or info.st_nlink!=1 or stat.S_IMODE(info.st_mode)!=0o600
+            or parent.st_uid!=os.getuid() or stat.S_IMODE(parent.st_mode)!=0o700):
+        raise RuntimeError('root_intent_custody')
+    raw=path.read_bytes()
+    if len(raw)>65536 or hashlib.sha256(raw).hexdigest()!=pin['sha256']:
+        raise RuntimeError('root_intent_changed')
+    return json.loads(raw)
