+def snapshot(runner):
+    # _peek deliberately does not allocate/create session state.
+    state = runner._peek_session_state(KEY)
+    entry = runner.session_store._entries.get(KEY)
+    if entry is None or entry.session_id != SID:
+        raise RuntimeError('exact_current_ordinary_route_required')
