+                if (root_intent['plan']['operation_id']!=params['operation_id'] or root_intent['current']['owned_turn']!=params['owned_turn']
+                        or root_intent.get('rights_sha256')!=params['rights_sha256']
+                        or root_intent.get('literal')!='/stop' or root_intent.get('no_retry')is not True
+                        or root_intent['authority']['operator']!='Root'
+                        or root_intent['plan']['boot_id']!=params['boot_id']
+                        or not time.monotonic()<params['deadline_monotonic']<=root_intent['plan']['deadline_monotonic']):
+                    raise RuntimeError('exact_root_intent_owner_join')
