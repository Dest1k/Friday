+
+def ordinary_turn_readonly_verb(runner, loop):
+    def handler(params):
+        if params != {'session_key': KEY, 'session_id': SID}:
+            return {'accepted': False, 'error': 'exact_ordinary_scope_required'}
+        async def read_on_loop():
+            # No await between native owner/generation/token/pending reads.
+            return snapshot(runner)
+        try:
+            future = asyncio.run_coroutine_threadsafe(read_on_loop(), loop)
+            return {'accepted': True, 'snapshot': future.result(timeout=1.5)}
+        except concurrent.futures.TimeoutError:
+            return {'accepted': False, 'error': 'native_projection_timeout'}
+        except Exception:
+            return {'accepted': False, 'error': 'native_projection_unavailable'}
+    return handler
