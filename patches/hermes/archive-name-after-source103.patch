+            or (None if ctx is None else (ctx.inbound_message_id, ctx.run_generation)) != ctx_fields):
+        raise RuntimeError('ordinary_scope_projection_racing')
+    fields = Path('/proc/self/stat').read_text().rsplit(')', 1)[1].split()
+    return dict(schema='frw.gateway.ordinary-turn-readonly.v1', read_only=True,
+        answering_pid=os.getpid(), birth_ticks=int(fields[19]),
+        boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+        observed_monotonic=time.monotonic(), implementation_sha256=CODE_SHA,
+        session_id=SID, session_key=KEY, generation=generation,
+        active=turn is not None and turn.agent is not None,
+        active_session_keys=sorted(active_keys), turn_tokens=tokens,
+        event_message_id=None if event is None else str(event.message_id),
+        ctx_inbound_message_id=None if ctx is None else ctx.inbound_message_id,
+        ctx_generation=None if ctx is None else ctx.run_generation,
+        pending_messages=pending, active_adapters=active_adapters,
+        adapter_generations=adapter_generations,
+        queued_events=0 if conversation is None else len(conversation.queued_events),
+        pending_command=persistent is not None and persistent.pending_command_text is not None,
+        approvals=persistent is not None and persistent.approvals is not None,
