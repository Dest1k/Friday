+    from hermes_cli import friday_product_access as access
+    expected_access=dict(platform='telegram',transport_profile='default',account_id='8751854128',user_id='8812646969',enabled=True,role='user',generation=2)
+    selected=access.current_access().get('users',{}).get('b21d67fc1b4ccce97241421bf86e3bc7416064133f7afd0822e6734ac6d5eef5')
+    if selected!=expected_access:
+        raise RuntimeError('ordinary_enabled_user_G2_changed')
+    paths=dict(root_config=home/'config.yaml',profile_config=home/'profiles'/PROFILE/'config.yaml',
+        scope_marker=home/'profiles'/PROFILE/'.friday-user-scope.json',
+        plugin_state=home/'plugin-data/agent-plugin-friday_rework-877e6505/state.json')
+    if set(rights)!=set(paths):raise RuntimeError('exact_current_rights_pins')
+    for key,path in paths.items():
+        if any(p.is_symlink()for p in(path,*path.parents))or hashlib.sha256(path.read_bytes()).hexdigest()!=rights[key]:
+            raise RuntimeError('current_rights_source_CAS_changed')
+    current=snapshot(runner)
+    leases,users,route,delegations=_leases_and_user(home)
+    own=expected['owned_turn']
+    if (current['answering_pid']!=own['gateway_pid'] or current['birth_ticks']!=own['gateway_birth']
+            or current['boot_id']!=expected['boot_id'] or current['session_id']!=own['session_id']
+            or current['session_key']!=own['session_key'] or current['generation']!=own['generation']
+            or current['ctx_generation']!=own['generation'] or current['active']is not True
+            or current['active_session_keys']!=[KEY] or current['pending_messages']!=0
+            or current['queued_events']!=0 or current['pending_command']is not False
+            or current['approvals']is not False or current['active_adapters']!=1
+            or current['live_owned_delegations']or current['durable_pending_delegations']or delegations
+            or current['adapter_generations']!=[own['generation']]
+            or current['turn_tokens']!=[dict(session_id=SID,owner_key=KEY,generation=own['generation'],released=False)]
+            or [row for group in leases for row in group]!=[own['lease']]
+            or len(route)!=1
+            or hashlib.sha256((json.dumps(json.loads(route[0][0]),ensure_ascii=True,sort_keys=True)+'\n').encode()).hexdigest()!=own['route_sha256']
+            or len(users)!=1 or users[0]['id']!=own['own_user_row_id']
+            or str(users[0]['platform_message_id'])!=str(current['ctx_inbound_message_id'])
+            or str(users[0]['platform_message_id'])!=str(current['event_message_id'])
+            or time.monotonic()>=expected['deadline_monotonic']
+            or hashlib.sha256((home/'hermes-agent.source.json').read_bytes()).hexdigest()!=source_sha):
+        raise RuntimeError('current_own_generation_lease_birth_request_CAS_conflict')
+    return current
