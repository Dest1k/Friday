+def _leases_and_user(home):
+    """Existing SQLite stores, read-only connections, no native writer construction."""
+    import json
+    import sqlite3
+    from urllib.parse import quote
+    values=[];delegations=[]
+    if any(p.is_symlink()for p in(home,*home.parents)):
+        raise RuntimeError('native_home_link')
+    for path in (home/'state.db', home/'profiles'/PROFILE/'state.db'):
+        if any(p.is_symlink()for p in(path,*path.parents)):
+            raise RuntimeError('native_store_link')
+        from contextlib import closing
+        with closing(sqlite3.connect('file:'+quote(str(path),safe='/')+'?mode=ro',uri=True,timeout=0.5)) as db:
+            db.row_factory=sqlite3.Row
+            values.append([dict(row) for row in db.execute('SELECT * FROM session_turn_leases')])
+            delegations.extend(dict(row)for row in db.execute(
+                'SELECT delegation_id,state,delivery_state FROM async_delegations WHERE (origin_session=? OR parent_session_id=?) AND (state IN (?,?,?) OR delivery_state IN (?,?,?))',
+                (KEY,SID,'running','stalling','finalizing','pending','claimed','deferred')))
+            if path.parent.name==PROFILE:
+                users=[dict(row) for row in db.execute('SELECT id,platform_message_id FROM messages WHERE session_id=? AND role=? ORDER BY id DESC LIMIT 1',(SID,'user'))]
+    with closing(sqlite3.connect('file:'+quote(str(home/'state.db'),safe='/')+'?mode=ro',uri=True,timeout=0.5))as db:
+        route=db.execute('SELECT entry_json FROM gateway_routing WHERE scope=? AND session_key=?',(str(home/'sessions'),KEY)).fetchall()
+    return values,users,route,delegations
