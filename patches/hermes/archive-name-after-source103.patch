+CPU_SECONDS = 4
+MEMORY_BYTES = 384 * 1024 * 1024
+_WIRE_MAX = 2_200_000
+_MAGIC = b'7z\xbc\xaf\x27\x1c'
+_CODES = frozenset(('invalid_limits', 'invalid_members', 'invalid_name',
+    'duplicate_member', 'path_collision', 'byte_limit', 'entry_limit',
+    'invalid_archive', 'encrypted_archive', 'unsupported_archive',
+    'special_member', 'resource_limit', 'worker_failed', 'cleanup_unconfirmed',
+    'codec_unavailable', 'unsupported_codec', 'containment_unavailable'))
+
+
+class CodecUnavailable(RuntimeError):
+    """Missing/unsupported dependency or unavailable Linux containment."""
+
+
+class CodecRefused(ValueError):
+    """Short finite reason code; no member names or dependency diagnostics."""
+
+
+def _limits(max_bytes, max_entries):
+    if (type(max_bytes) is not int or not 1 <= max_bytes <= MAX_BYTES or
+            type(max_entries) is not int or not 1 <= max_entries <= MAX_ENTRIES):
+        raise CodecRefused('invalid_limits')
+
+
+def _name(name, directory=False):
+    if type(name) is not str or not name or '\\' in name or ':' in name:
+        raise CodecRefused('invalid_name')
+    try:
+        raw = name.encode('utf-8', 'strict')
+    except UnicodeError:
+        raise CodecRefused('invalid_name') from None
+    if len(raw) > MAX_NAME_BYTES or any(ord(c) < 32 or ord(c) == 127 for c in name):
+        raise CodecRefused('invalid_name')
