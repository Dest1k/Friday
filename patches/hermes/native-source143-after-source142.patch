+"""Bounded native OpenOffice.org 1.0 creation and literal new-copy correction.
+
+No Office process, conversion, formulas, active content or template instantiation.
+Preserving edits change one complete plain text leaf in content.xml. ZIP member
+metadata and every unselected member payload are checked, not merely assumed.
+"""
+from __future__ import annotations
+
+import io
+import json
+import math
+import re
+import struct
+import zipfile
+import zlib
+from xml.sax.saxutils import escape, quoteattr
+from xml.etree import ElementTree as ET
+from xml.parsers import expat
+
+from tools import scoped_legacy_openoffice as read
+
+MAX_BYTES = 1_000_000
+MAX_INPUT = 100_000
+S = 'http://openoffice.org/2000/style'
+F = 'http://www.w3.org/1999/XSL/Format'
+SVG = 'http://www.w3.org/2000/svg'
+NS = {'office': read.O, 'text': read.T, 'table': read.TB, 'draw': read.D,
+      'presentation': read.P, 'style': S, 'fo': F, 'svg': SVG}
+
+
+def fail(code):
+    read.fail(code)
+
+
+def object_spec(content):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                fail('legacy_duplicate_json_key')
+            result[key] = value
+        return result
+    if not isinstance(content, str):
+        fail('legacy_input_limit')
+    try:
+        size = len(content.encode('utf-8'))
+    except UnicodeError:
+        fail('legacy_plain_text_required')
+    if size > MAX_INPUT:
+        fail('legacy_input_limit')
+    try:
+        value = json.loads(content, object_pairs_hook=pairs,
+                           parse_constant=lambda _: fail('legacy_nonfinite_value'))
+    except (ValueError, RecursionError, UnicodeError):
+        fail('legacy_invalid_json')
+    if type(value) is not dict:
+        fail('legacy_object_required')
+    return value
+
+
+def literal(value, *, nonempty=False):
+    if (type(value) is not str or (nonempty and not value)
+            or any(ord(c) < 32 or 0xD800 <= ord(c) <= 0xDFFF
+                   or (ord(c) & 0xFFFF) in (0xFFFE, 0xFFFF) for c in value)
+            or len(value.encode('utf-8')) > MAX_INPUT):
+        fail('legacy_plain_text_required')
+    # XML collapses ordinary whitespace in text. Refuse instead of claiming
+    # roundtrip equality; explicit whitespace elements are outside this writer.
+    if value.startswith(' ') or value.endswith(' ') or '  ' in value:
+        fail('legacy_unsupported_whitespace')
+    return value
+
+
+def text(value):
+    return escape(literal(value))
+
+
+def _xml(kind, family, inner):
+    namespaces = ''.join(' xmlns:' + k + '=' + quoteattr(v) for k, v in NS.items())
+    return ('<?xml version="1.0" encoding="UTF-8"?>\n<office:' + kind + namespaces
+            + ' office:version="1.0" office:class="' + family + '">' + inner
+            + '</office:' + kind + '>').encode('utf-8')
+
+
+def _rows(rows, scalar, budget):
+    if type(rows) is not list or not 1 <= len(rows) <= 512:
+        fail('legacy_rows_limit')
+    width = None
+    result = []
+    for row in rows:
+        if type(row) is not list or not 1 <= len(row) <= 64:
+            fail('legacy_columns_limit')
+        if width is None:
+            width = len(row)
+        if len(row) != width:
+            fail('legacy_rectangular_rows_required')
+        budget[0] += len(row)
+        if budget[0] > 4096:
+            fail('legacy_cell_limit')
+        result.append('<table:table-row>' + ''.join(scalar(v) for v in row) + '</table:table-row>')
+    return '<table:table-column table:number-columns-repeated="' + str(width) + '"/>' + ''.join(result)
+
+
+def _cell(value):
+    if value is None:
+        return '<table:table-cell/>'
+    if type(value) is str:
+        return '<table:table-cell table:value-type="string"><text:p>' + text(value) + '</text:p></table:table-cell>'
+    if type(value) is bool:
+        v = 'true' if value else 'false'
+        return '<table:table-cell table:value-type="boolean" table:boolean-value="' + v + '"><text:p>' + v + '</text:p></table:table-cell>'
+    if type(value) in (int, float):
+        if (type(value) is float and not math.isfinite(value)) or abs(value) > 10**15:
+            fail('legacy_numeric_limit')
+        v = str(value)
+        if len(v) > 32:
+            fail('legacy_numeric_limit')
+        return '<table:table-cell table:value-type="float" table:value="' + v + '"><text:p>' + v + '</text:p></table:table-cell>'
+    fail('legacy_literal_scalar_required')
+
+
+def _styles(family):
+    page = ('<style:page-master style:name="pm1"><style:properties fo:page-width="'
+            + ('28cm' if family == 'presentation' else '21cm') + '" fo:page-height="'
+            + ('21cm' if family == 'presentation' else '29.7cm') + '" style:print-orientation="'
+            + ('landscape' if family == 'presentation' else 'portrait')
+            + '" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2cm" fo:margin-right="2cm"/>'
+            + '<style:header-style/><style:footer-style/></style:page-master>')
+    common = ('<office:styles><style:default-style style:family="paragraph"><style:properties '
+              'fo:font-family="Liberation Sans" fo:font-size="12pt"/></style:default-style>'
+              '<style:style style:name="Standard" style:family="paragraph"/>'
+              '<style:style style:name="Heading" style:family="paragraph" style:parent-style-name="Standard">'
+              '<style:properties fo:font-size="18pt" fo:font-weight="bold"/></style:style>')
+    if family == 'presentation':
+        common += ('<style:style style:name="Title" style:family="presentation"><style:properties '
+                   'draw:stroke="none" draw:fill="none" fo:font-size="28pt"/></style:style>'
+                   '<style:style style:name="Outline" style:family="presentation"><style:properties '
+                   'draw:stroke="none" draw:fill="none" fo:font-size="18pt"/></style:style>')
+    common += '</office:styles><office:automatic-styles>' + page + '</office:automatic-styles><office:master-styles>'
+    if family == 'presentation':
+        common += '<draw:layer-set><draw:layer draw:name="layout"/></draw:layer-set>'
+    common += '<style:master-page style:name="Standard" style:page-master-name="pm1"/></office:master-styles>'
+    return _xml('document-styles', family, common)
+
+
+def create_legacy(content, format, *, checkpoint=None):
+    if type(format) is not str or format not in read.PROFILES:
+        fail('legacy_unsupported_format')
+    spec = object_spec(content)
+    family, mime = read.PROFILES[format]
+    read.tick(checkpoint)
+    cells = [0]
+    auto = ''
+    if family == 'text':
+        if set(spec) != {'blocks'} or type(spec['blocks']) is not list or not 1 <= len(spec['blocks']) <= 2000:
+            fail('legacy_text_schema')
+        pieces = []
+        for index, block in enumerate(spec['blocks']):
+            read.tick(checkpoint)
+            if type(block) is not dict:
+                fail('legacy_text_schema')
+            kind = block.get('type')
+            if kind == 'paragraph' and set(block) == {'type', 'text'}:
+                pieces.append('<text:p text:style-name="Standard">' + text(block['text']) + '</text:p>')
+            elif kind == 'heading' and set(block) == {'type', 'text', 'level'} and type(block['level']) is int and 1 <= block['level'] <= 10:
+                pieces.append('<text:h text:style-name="Heading" text:level="' + str(block['level']) + '">' + text(block['text']) + '</text:h>')
+            elif kind == 'table' and set(block) == {'type', 'rows'}:
+                rows = block['rows']
+                if (type(rows) is not list or any(type(row) is not list for row in rows)
+                        or any(type(v) is not str for row in rows for v in row)):
+                    fail('legacy_text_table_strings_required')
+                pieces.append('<table:table table:name="Table' + str(index + 1) + '">' + _rows(block['rows'], _cell, cells) + '</table:table>')
+            else:
+                fail('legacy_text_schema')
+        body = ''.join(pieces)
+    elif family == 'spreadsheet':
+        if set(spec) != {'sheets'} or type(spec['sheets']) is not list or not 1 <= len(spec['sheets']) <= 8:
+            fail('legacy_sheets_schema')
+        names, pieces = set(), []
+        auto = '<style:style style:name="Sheet" style:family="table" style:master-page-name="Standard"><style:properties table:display="true"/></style:style>'
+        for sheet in spec['sheets']:
+            read.tick(checkpoint)
+            if type(sheet) is not dict or set(sheet) != {'name', 'rows'}:
+                fail('legacy_sheets_schema')
+            name = literal(sheet['name'], nonempty=True)
+            if len(name) > 31 or any(c in name for c in '[]:*?/\\') or name.casefold() in names:
+                fail('legacy_sheet_name')
+            names.add(name.casefold())
+            pieces.append('<table:table table:name=' + quoteattr(name) + ' table:style-name="Sheet">' + _rows(sheet['rows'], _cell, cells) + '</table:table>')
+        body = ''.join(pieces)
+    else:
+        if set(spec) != {'slides'} or type(spec['slides']) is not list or not 1 <= len(spec['slides']) <= 64:
+            fail('legacy_slides_schema')
+        pieces, paragraphs = [], 0
+        for index, slide in enumerate(spec['slides'], 1):
+            read.tick(checkpoint)
+            if type(slide) is not dict or set(slide) != {'title', 'paragraphs'} or type(slide['paragraphs']) is not list or len(slide['paragraphs']) > 128:
+                fail('legacy_slides_schema')
+            paragraphs += len(slide['paragraphs']) + 1
+            if paragraphs > 2000:
+                fail('legacy_paragraph_limit')
+            pieces.append('<draw:page draw:name="Slide' + str(index) + '" draw:id="' + str(index)
+                          + '" draw:master-page-name="Standard"><draw:text-box draw:layer="layout" presentation:class="title" '
+                          'presentation:style-name="Title" svg:x="2cm" svg:y="1cm" svg:width="24cm" svg:height="3cm">'
+                          '<text:p>' + text(slide['title']) + '</text:p></draw:text-box>'
+                          '<draw:text-box draw:layer="layout" presentation:class="outline" presentation:style-name="Outline" '
+                          'svg:x="2cm" svg:y="5cm" svg:width="24cm" svg:height="14cm">'
+                          + ''.join('<text:p>' + text(p) + '</text:p>' for p in slide['paragraphs']) + '</draw:text-box></draw:page>')
+        body = ''.join(pieces)
+    parts = {'mimetype': mime.encode('ascii'),
+             'content.xml': _xml('document-content', family, '<office:font-decls/><office:automatic-styles>' + auto + '</office:automatic-styles><office:body>' + body + '</office:body>'),
+             'styles.xml': _styles(family),
+             'meta.xml': _xml('document-meta', family, '<office:meta/>'),
+             'settings.xml': _xml('document-settings', family, '<office:settings/>')}
+    manifest = '<?xml version="1.0" encoding="UTF-8"?><manifest:manifest xmlns:manifest="' + read.M + '"><manifest:file-entry manifest:full-path="/" manifest:media-type="' + mime + '"/>'
+    manifest += ''.join('<manifest:file-entry manifest:full-path="' + name + '" manifest:media-type="text/xml"/>' for name in parts if name.endswith('.xml'))
+    parts['META-INF/manifest.xml'] = (manifest + '</manifest:manifest>').encode()
+    out = io.BytesIO()
+    with zipfile.ZipFile(out, 'w') as archive:
+        for name, value in parts.items():
+            read.tick(checkpoint)
+            info = zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0))
+            info.compress_type = zipfile.ZIP_STORED if name == 'mimetype' else zipfile.ZIP_DEFLATED
+            info.external_attr = 0o100600 << 16
+            archive.writestr(info, value)
+    result = out.getvalue()
+    if len(result) > MAX_BYTES:
+        fail('legacy_output_limit')
+    read.extract_legacy(result, format, checkpoint=checkpoint)
+    return result
+
+
+def _metadata(info):
+    return (info.filename, info.date_time, info.compress_type, info.comment, info.extra,
+            info.create_system, info.create_version, info.extract_version, info.reserved,
+            info.volume, info.internal_attr, info.external_attr, info.flag_bits)
+
+
+def _rewrite(data, changed, checkpoint):
+    """Classic ZIP only: preserve local records except the selected payload.
+
+    Recalculate CRC/sizes/central offsets; preserve descriptor signature policy,
+    local/central extra fields, flags, order, comments and all other metadata.
+    No ZIP64, SFX, padding, unsupported flags, split disks or trailing records.
+    """
+    with zipfile.ZipFile(io.BytesIO(data)) as archive:
+        infos = archive.infolist()
+        local_order = sorted(infos, key=lambda x: x.header_offset)
+        start = archive.start_dir
+        if not local_order or local_order[0].header_offset != 0:
+            fail('legacy_zip_layout_unsupported')
+        out = bytearray()
+        offsets, sizes = {}, {}
+        for index, info in enumerate(local_order):
+            read.tick(checkpoint)
+            begin = info.header_offset
+            end = local_order[index + 1].header_offset if index + 1 < len(local_order) else start
+            raw = data[begin:end]
+            if len(raw) < 30 or raw[:4] != b'PK\x03\x04' or info.flag_bits & ~0x0808:
+                fail('legacy_zip_layout_unsupported')
+            signature, version, flags, compression, tm, dt, crc, compressed, size, name_len, extra_len = struct.unpack_from('<4s5H3I2H', raw)
+            head = 30 + name_len + extra_len
+            if flags != info.flag_bits or compression != info.compress_type or head > len(raw):
+                fail('legacy_zip_layout_unsupported')
+            extra = raw[30 + name_len:head]
+            pos = 0
+            while pos < len(extra):
+                if pos + 4 > len(extra): fail('legacy_zip_layout_unsupported')
+                tag, length = struct.unpack_from('<HH', extra, pos)
+                if tag == 1 or pos + 4 + length > len(extra): fail('legacy_zip_layout_unsupported')
+                pos += 4 + length
+            payload_end = head + info.compress_size
+            descriptor = raw[payload_end:]
+            if flags & 8:
+                if any(value not in (0, expected) for value, expected in zip(
+                        (crc, compressed, size), (info.CRC, info.compress_size, info.file_size))):
+                    fail('legacy_zip_layout_unsupported')
+                signed = descriptor[:4] == b'PK\x07\x08'
+                if len(descriptor) != (16 if signed else 12) or struct.unpack('<III', descriptor[4:] if signed else descriptor) != (info.CRC, info.compress_size, info.file_size):
+                    fail('legacy_zip_layout_unsupported')
+            elif descriptor or (crc, compressed, size) != (info.CRC, info.compress_size, info.file_size):
+                fail('legacy_zip_layout_unsupported')
+            offsets[info.filename] = len(out)
+            if info.filename in changed:
+                value = changed[info.filename]
+                packed = value
+                if compression == zipfile.ZIP_DEFLATED:
+                    compressor = zlib.compressobj(6, zlib.DEFLATED, -15)
+                    packed = compressor.compress(value) + compressor.flush()
+                new_crc, new_size, new_compressed = zlib.crc32(value), len(value), len(packed)
+                header = bytearray(raw[:head])
+                struct.pack_into('<III', header, 14, new_crc if not flags & 8 or crc else 0,
+                                 new_compressed if not flags & 8 or compressed else 0,
+                                 new_size if not flags & 8 or size else 0)
+                if flags & 8:
+                    descriptor = (b'PK\x07\x08' if signed else b'') + struct.pack('<III', new_crc, new_compressed, new_size)
+                out.extend(header + packed + descriptor)
+                sizes[info.filename] = (new_crc, new_compressed, new_size)
+            else:
+                out.extend(raw)
+            if len(out) > MAX_BYTES: fail('legacy_output_limit')
+        new_start = len(out)
+        cursor = start
+        for info in infos:
+            if data[cursor:cursor + 4] != b'PK\x01\x02' or cursor + 46 > len(data):
+                fail('legacy_zip_layout_unsupported')
+            name_len, extra_len, comment_len, disk = struct.unpack_from('<4H', data, cursor + 28)
+            length = 46 + name_len + extra_len + comment_len
+            entry = bytearray(data[cursor:cursor + length])
+            if len(entry) != length or disk or struct.unpack_from('<I', entry, 42)[0] != info.header_offset:
+                fail('legacy_zip_layout_unsupported')
+            if info.filename in sizes:
+                struct.pack_into('<III', entry, 16, *sizes[info.filename])
+            struct.pack_into('<I', entry, 42, offsets[info.filename])
+            out.extend(entry)
+            cursor += length
+        eocd = data[cursor:]
+        if (len(eocd) < 22 or eocd[:4] != b'PK\x05\x06' or len(eocd) != 22 + len(archive.comment)
+                or struct.unpack_from('<4H', eocd, 4) != (0, 0, len(infos), len(infos))
+                or struct.unpack_from('<II', eocd, 12) != (cursor - start, start)):
+            fail('legacy_zip_layout_unsupported')
+        tail = bytearray(eocd)
+        struct.pack_into('<I', tail, 16, new_start)
+        out.extend(tail)
+        result = bytes(out)
+        if len(result) > MAX_BYTES: fail('legacy_output_limit')
+        with zipfile.ZipFile(io.BytesIO(result)) as after:
+            if archive.comment != after.comment or [_metadata(i) for i in infos] != [_metadata(i) for i in after.infolist()]:
+                fail('legacy_zip_metadata_changed')
+            for info in infos:
+                if after.read(info.filename) != changed.get(info.filename, archive.read(info)):
+                    fail('legacy_zip_payload_changed')
+        return result
+
+
+def _editable(data, format, checkpoint):
+    body, family, _ = read._package(data, format, checkpoint)
+    with zipfile.ZipFile(io.BytesIO(data)) as archive:
+        parts = {i.filename: archive.read(i) for i in archive.infolist() if not i.is_dir()}
+    allowed = {'mimetype', 'content.xml', 'styles.xml', 'meta.xml', 'settings.xml', 'META-INF/manifest.xml', 'Basic/script.xml'}
+    if set(parts) - allowed:
+        fail('legacy_unknown_edit_member')
+    passive_draw = {'page', 'page-thumbnail', 'g', 'text-box', 'rect', 'ellipse', 'circle', 'line',
+                    'polygon', 'polyline', 'path', 'connector', 'caption', 'custom-shape',
+                    'enhanced-geometry', 'equation', 'handle', 'glue-point', 'image-map',
+                    'contour-polygon', 'contour-path', 'description', 'layer-set', 'layer',
+                    'marker', 'gradient', 'hatch', 'stroke-dash', 'opacity'}
+    # Inspect every retained XML part, including metadata, styles, settings and
+    # content outside body. Unknown namespaces cannot establish inert content.
+    element_namespaces = {read.O, read.T, read.TB, read.D, read.P, S, read.M,
+        'http://openoffice.org/2000/meta', 'http://purl.org/dc/elements/1.1/',
+        'http://openoffice.org/2001/config', 'http://openoffice.org/2000/datastyle',
+        'http://openoffice.org/2000/library'}
+    element_prefixes = tuple(read.q(ns, '') for ns in element_namespaces)
+    attribute_prefixes = tuple(read.q(ns, '') for ns in element_namespaces |
+                               {F, SVG, read.XL, 'http://www.w3.org/XML/1998/namespace'})
+    for name, raw in parts.items():
+        if not name.endswith('.xml'):
+            continue
+        root = ET.fromstring(raw)
+        for node in root.iter():
+            if node.tag.startswith('{http://www.w3.org/2000/09/xmldsig#}'):
+                fail('legacy_signed_content_unsupported')
+            if (not node.tag.startswith(element_prefixes)
+                    or any(not attr.startswith(attribute_prefixes) for attr in node.attrib)):
+                fail('legacy_unknown_edit_object')
+            if node.tag in {read.q(read.T, 'script'), read.q(read.TB, 'table-source')} :
+                fail('legacy_active_or_embedded_content')
+            href = node.get(read.q(read.XL, 'href'), '').strip()
+            # Hyperlinks are retained but never opened. Script, executable,
+            # embedded-data and unknown URI schemes are not passive metadata.
+            if ':' in href and href.split(':', 1)[0].lower() not in {'http', 'https', 'mailto'}:
+                fail('legacy_active_link_unsupported')
+            if node.tag.startswith(read.q(read.D, '')) and node.tag.rsplit('}', 1)[-1] not in passive_draw:
+                fail('legacy_unknown_edit_object')
+    # Existing inert read may omit structures; the editor never acts through an
+    # unknown container or unresolved revision even if a text leaf happens to match.
+    if any(n.tag in {read.q(read.T, x) for x in ('tracked-changes', 'change', 'change-start', 'change-end')} for n in body.iter()):
+        fail('legacy_revisions_unsupported')
+    return parts, family
+
+
+def _leaf_spans(raw, checkpoint):
+    parser = expat.ParserCreate(encoding='UTF-8', namespace_separator='}')
+    parser.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)
+    stack, leaves = [], []
+    def start(name, attrs):
+        read.tick(checkpoint)
+        opening = read._START_TAG.match(raw, parser.CurrentByteIndex)
+        node = {'name': name, 'attrs': attrs, 'text': [], 'plain': True,
+                'start': opening.end(), 'ancestors': tuple(stack)}
+        if stack:
+            stack[-1]['plain'] = False
+        stack.append(node)
+    def chars(value):
+        for node in stack:
+            if node['name'] in (read.T + '}p', read.T + '}h'):
+                node['text'].append(value)
+    def special(*args):
+        for node in stack:
+            node['plain'] = False
+    def end(name):
+        node = stack.pop()
+        if name in (read.T + '}p', read.T + '}h'):
+            node['end'] = parser.CurrentByteIndex
+            node['text'] = ''.join(node['text'])
+            leaves.append(node)
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.CharacterDataHandler = chars
+    parser.CommentHandler = special
+    parser.ProcessingInstructionHandler = special
+    parser.StartCdataSectionHandler = special
+    parser.Parse(raw, True)
+    return leaves
+
+
+def _visible_main_leaf(node, family):
+    """Follow the reader's actual main-content traversal, not tag membership.
+
+    A table only exposes direct paragraph/heading children of real cells. Notes,
+    thumbnails, ignored table children and arbitrary nested bodies are excluded.
+    """
+    names = [a['name'] for a in node['ancestors']]
+    if names[:2] != [read.O + '}document-content', read.O + '}body']:
+        return False
+    path = names[2:] + [node['name']]
+    if family == 'presentation':
+        if not path or path.pop(0) != read.D + '}page':
+            return False
+    if family == 'spreadsheet' and (not path or path[0] != read.TB + '}table'):
+        return False
+    containers = {read.T + '}' + n for n in
+                  ('section', 'ordered-list', 'unordered-list', 'list-item', 'list-header')}
+    containers |= {read.D + '}' + n for n in
+                   ('page', 'g', 'text-box', 'rect', 'ellipse', 'custom-shape')}
+    rows = {read.TB + '}' + n for n in ('table-header-rows', 'table-rows', 'table-row-group')}
+    while len(path) > 1:
+        name = path.pop(0)
+        if name == read.TB + '}table':
+            while path and path[0] in rows:
+                path.pop(0)
+            return (len(path) == 3 and path[0] == read.TB + '}table-row'
+                    and path[1] == read.TB + '}table-cell'
+                    and path[2] in (read.T + '}p', read.T + '}h'))
+        if name not in containers:
+            return False
+    return len(path) == 1 and path[0] in (read.T + '}p', read.T + '}h')
+
+
+def edit_legacy(data, format, old, new, *, checkpoint=None):
+    literal(old, nonempty=True)
+    literal(new, nonempty=True)
+    if old == new:
+        fail('legacy_no_change')
+    parts, family = _editable(data, format, checkpoint)
+    raw = parts['content.xml']
+    matches = [n for n in _leaf_spans(raw, checkpoint) if n['text'] == old]
+    if len(matches) != 1:
+        fail('legacy_text_missing_or_ambiguous')
+    node = matches[0]
+    ancestors = node['ancestors']
+    if not node['plain'] or not _visible_main_leaf(node, family):
+        fail('legacy_unsupported_text_leaf')
+    for a in ancestors:
+        if a['name'].startswith(read.TB + '}'):
+            attrs = a['attrs']
