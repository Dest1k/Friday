+def _cell(row, column, style, kind, value, **extra):
+    col = column + 1
+    letters = ''
+    while col:
+        col, rem = divmod(col - 1, 26)
+        letters = chr(65 + rem) + letters
+    return dict(cell=f'{letters}{row + 1}', row=row + 1, column=column + 1,
+                type=kind, value=value, xf_index=style, **extra)
