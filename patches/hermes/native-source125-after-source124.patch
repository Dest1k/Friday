+def _formula(data, at):
+    if at + 10 > len(data):
+        _fail('formula_bounds')
+    # Flags are inert and no expression is evaluated. Validate the bounded token
+    # sublanguage to refuse XLM, external names, external references and UDFs.
+    at += 2
+    count = _u32(data, at)
+    at += 4
+    if not 1 <= count <= 16384 or at + count + 4 > len(data):
+        _fail('formula_bounds')
+    tokens = data[at:at + count]
+    at += count
+    extra = _u32(data, at)
+    at += 4
+    if extra or at != len(data):
+        _fail('formula_extra_unsupported')
+    pos = 0
+    depth = 0
+    while pos < len(tokens):
+        token = tokens[pos]
+        pos += 1
+        if 0x03 <= token <= 0x11:  # binary arithmetic/comparison/reference ops
+            if depth < 2:
+                _fail('formula_stack')
+            depth -= 1
+        elif 0x12 <= token <= 0x15:  # unary plus/minus/percent/parentheses
+            if depth < 1:
+                _fail('formula_stack')
+        elif token == 0x16:  # missing argument
+            depth += 1
+        elif token in (0x1c, 0x1d, 0x1e, 0x1f):
+            n = {0x1c:1, 0x1d:1, 0x1e:2, 0x1f:8}[token]
+            if pos + n > len(tokens):
+                _fail('formula_token_bounds')
+            if token == 0x1d and tokens[pos] not in (0, 1):
+                _fail('formula_literal')
+            if token == 0x1c and tokens[pos] not in _ERRORS:
+                _fail('formula_literal')
+            if token == 0x1f:
+                _number(tokens[pos:pos + n])
+            pos += n
+            depth += 1
+        elif token == 0x17:
+            if pos + 2 > len(tokens):
+                _fail('formula_token_bounds')
+            n = struct.unpack_from('<H', tokens, pos)[0]
+            pos += 2
+            if n > 255 or pos + n * 2 > len(tokens):
+                _fail('formula_token_bounds')
+            try:
+                tokens[pos:pos + n * 2].decode('utf-16le', 'strict')
+            except UnicodeError:
+                _fail('formula_string_encoding')
+            pos += n * 2
+            depth += 1
+        elif token in (0x24, 0x44, 0x64, 0x25, 0x45, 0x65):
+            n = 6 if token & 31 == 4 else 12
+            if pos + n > len(tokens):
+                _fail('formula_token_bounds')
+            if n == 6:
+                row, col = struct.unpack_from('<IH', tokens, pos)
+                if row >= 1048576:
+                    _fail('formula_reference')
+            else:
+                first, last, cfirst, clast = struct.unpack_from('<IIHH', tokens, pos)
+                if not first <= last < 1048576 or (cfirst & 0x3fff) > (clast & 0x3fff):
+                    _fail('formula_reference')
+            pos += n
+            depth += 1
+        elif token == 0x19:
+            if pos + 3 > len(tokens) or tokens[pos] != 0x10 or depth < 1:
+                _fail('formula_attribute_unsupported')
+            pos += 3
+        else:
+            _fail('formula_token_unsupported')
+    if depth != 1:
+        _fail('formula_stack')
+
