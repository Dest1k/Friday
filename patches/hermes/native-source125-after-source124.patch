+"""Own-workspace native PDF pages; existing create-only CAS publication."""
+import hashlib
+import json
+
+
+def create_pages(cap, fd, leaf, relative, content):
+    from hermes_cli.friday_user_scope import ScopeDenied
+    from hermes_cli.friday_workspace_revision import check
+    from hermes_cli.friday_workspace_docx import _check_parent, _create_bytes
+    from hermes_cli.friday_workspace_zip import _path, _source, _verify, _inline_budget, _fits, _capacity, _encode
+    from tools.scoped_pdf_pages import request, assemble, PDFPagesError
+    _check_parent(cap, fd, relative)
+    try:
+        spec = request(content)
+        paths = [_path(s) for s in spec['sources']]
+        if any(not s.lower().endswith('.pdf') for s in paths) or len(set(paths)) != len(paths):
+            raise ScopeDenied()
+        states = [(s, *_source(cap, s)) for s in paths]
+        data, metadata = assemble(cap, [s[1] for s in states], spec['pages'])
+        check(cap)
+        receipt = dict(metadata, sources=paths, sources_unchanged=True,
+            source_sha256=[hashlib.sha256(s[1]).hexdigest() for s in states])
+        budget = _inline_budget()
+        estimate = dict(receipt, success=True, path=relative, format='pdf',
+            scope='own_user_workspace', create_only=True, verified=True,
+            bytes_written=len(data), sha256=hashlib.sha256(data).hexdigest())
+        if not _fits(estimate, budget):
+            return _capacity(budget)
+        _verify(cap, states)
+        result = json.loads(_create_bytes(cap, fd, leaf, relative, data, output_format='pdf',
+                                         verify_source=lambda: _verify(cap, states)))
+        if result.get('success'):
+            result.update(receipt)
+        return _encode(result)
+    except PDFPagesError as error:
+        return _encode(dict(success=False, error='pdf_pages_refused', reason=str(error),
+                            effect_disposition='unknown' if str(error) == 'pdf_cleanup_unconfirmed' else 'none'))
