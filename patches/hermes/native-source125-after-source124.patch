+"""Finite native PDF page assembly in a networkless private namespace.
+
+Uses the installed libqpdf 12.3 C ABI, never a PDF parser implemented here.
+Only plain page documents are accepted. No renderer or raster substitution.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+
+MAX_BYTES = 1_000_000
+MAX_PAGES = 64
+MAX_JSON = 8_000_000
+WALL_SECONDS = 40
+CPU_SECONDS = 30
+LIBRARY = '/usr/lib/x86_64-linux-gnu/libqpdf.so.30'
+
+
+class PDFPagesError(ValueError):
+    pass
+
+
+def request(content):
+    def pairs(items):
+        out = {}
+        for key, value in items:
+            if key in out:
+                raise PDFPagesError('pdf_request_invalid')
+            out[key] = value
+        return out
+    try:
+        if not isinstance(content, str) or len(content.encode('utf-8')) > 16_000:
+            raise PDFPagesError('pdf_request_invalid')
+    except UnicodeError:
+        raise PDFPagesError('pdf_request_invalid') from None
+    try:
+        spec = json.loads(content, object_pairs_hook=pairs)
+    except (ValueError, RecursionError):
+        raise PDFPagesError('pdf_request_invalid') from None
+    if (type(spec) is not dict or set(spec) != {'sources', 'pages'}
+            or type(spec['sources']) is not list or not 1 <= len(spec['sources']) <= 2
+            or any(type(s) is not str or not s for s in spec['sources'])
+            or len(set(spec['sources'])) != len(spec['sources'])
+            or type(spec['pages']) is not list or not 1 <= len(spec['pages']) <= MAX_PAGES):
+        raise PDFPagesError('pdf_request_invalid')
+    try:
+        if any(len(name.encode('utf-8')) > 512 for name in spec['sources']):
+            raise PDFPagesError('pdf_request_invalid')
+    except UnicodeError:
+        raise PDFPagesError('pdf_request_invalid') from None
+    seen = set()
+    for row in spec['pages']:
+        if (type(row) is not dict or set(row) != {'source', 'page', 'rotation'}
+                or type(row['source']) is not int or not 1 <= row['source'] <= len(spec['sources'])
+                or type(row['page']) is not int or not 1 <= row['page'] <= MAX_PAGES
+                or type(row['rotation']) is not int or row['rotation'] not in (0, 90, 180, 270)):
+            raise PDFPagesError('pdf_request_invalid')
+        key = row['source'], row['page']
+        if key in seen:
+            raise PDFPagesError('pdf_duplicate_page_unsupported')
+        seen.add(key)
+    if {r['source'] for r in spec['pages']} != set(range(1, len(spec['sources']) + 1)):
+        raise PDFPagesError('pdf_source_unused')
+    return spec
+
+
+def _argv(work, count):
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--as-pid-1',
+            '--cap-drop', 'ALL', '--clearenv', '--ro-bind', '/usr', '/usr']
+    for name in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / name
+        if path.exists():
+            target = path.resolve()
+            if not target.is_relative_to('/usr'):
+                raise PDFPagesError('pdf_engine_unavailable')
+            argv += ['--symlink', str(target), '/' + name]
+    argv += ['--proc', '/proc', '--dev', '/dev', '--tmpfs', '/tmp',
+             '--bind', str(work), '/work']
+    for name in ['runner.py', 'request.json'] + [f'input{i}.pdf' for i in range(count)]:
+        argv += ['--ro-bind', str(work / name), '/work/' + name]
+    argv += ['--chdir', '/work', '--remount-ro', '/', '--',
+             '/usr/bin/python3', '-I', '-B', '-S', '/work/runner.py', '--child']
+    return argv
+
+
+def _run(cap, work, count):
+    from agent.web_call_context import _current, same_web_authority
+    from hermes_cli.friday_workspace_revision import check
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    if call is None or not same_web_authority(call):
+        raise PDFPagesError('native_deadline_required')
