+"""Inert stored Word review layers; never accept/reject or execute revisions.
+
+Only direct paragraph run insertions/deletions have reconstructed text views.
+Moves, paragraph/table/property revisions and secondary-story revisions remain
+explicit gaps. Comments are read from their real main-part relationship.
+"""
+from __future__ import annotations
+
+import re
+
+from tools.scoped_word_profiles import (
+    W, R, DocumentText, MAX_BYTES, MAX_PARAGRAPHS, _encoded, _fail, _q, _tick,
+)
