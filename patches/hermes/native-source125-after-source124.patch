+def _strings(data, ctx, font_count):
+    records = list(_records(data, ctx))
+    if len(records) < 2 or records[0][1] != 0x9f or records[-1][1:] != (0xa0, b''):
+        _fail('sst_stream')
+    _size(records[0][2], 8)
+    total, unique = struct.unpack('<II', records[0][2])
+    if not unique <= total <= MAX_CELLS or unique > MAX_STRINGS or len(records) != unique + 2:
+        _fail('sst_counts')
+    values = []
+    for _, kind, payload in records[1:-1]:
+        if kind != 0x13:
+            _fail('sst_record_unsupported')
+        values.append(_rich(payload, font_count))
+    return values, total
