+        paragraphs=len(paragraphs),tables=sum(n.tag==_q(W,'tbl') for n in package.body.iter()),
+        main_text_projections_complete=projection_complete,review_layers_complete=not gaps,
+        tracked_changes=len(revisions),comments=len(comments),accepted_or_rejected_revisions=False,
+        macro_enabled_profile=package.format in ('docm','dotm'),macro_project_present=bool(package.vba_parts),
+        macros_executed=False,fields_evaluated=False,
+        coverage='main_body_run_insert_delete_original_and_final_views; traditional_comment_text_and_anchors; stored_only_no_rendering',
+        limitations=sorted(limitations),review_gaps=sorted(gaps))
