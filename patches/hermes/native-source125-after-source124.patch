+"""Inert bounded recalculation of existing native ODS SUM/product formulas."""
+from decimal import Decimal, localcontext
+from io import BytesIO
+import re
+import zipfile
+from xml.sax.saxutils import escape
+
+from tools.scoped_ods import (
+    Spreadsheet, ODSError, O, T, TB, ST, NUM, XL, OF, q, _cell_span, _literal,
+    address, decimal, tick,
+)
+
+
+def fail(code):
+    raise ODSError(code)
+
+
+def _sheet_name(token, current):
+    if token is None:
+        return current
+    return token[1:-1].replace("''", "'") if token.startswith("'") else token
+
+
+def _reference(raw, current):
+    sheet = r"(?:'(?:[^']|'')+'|[A-Za-z_][A-Za-z0-9_.]*)"
+    match = re.fullmatch(r'\$?(' + sheet + r')?\.(\$?[A-Za-z]{1,3}\$?[1-9][0-9]{0,6})', raw)
+    if not match:
+        fail('ods_formula_reference')
+    name = _sheet_name(match[1], current)
+    row, column = address(match[2].replace('$', '').upper())
+    return name, row, column
+
+
+def _formula(raw, current):
+    if not isinstance(raw, str) or len(raw) > 4096:
+        fail('formula_text_limit')
+    multiply = re.fullmatch(r'of:=\[([^\[\]]+)\]\*\[([^\[\]]+)\]', raw)
+    if multiply:
+        return 'multiply', [_reference(multiply[1], current), _reference(multiply[2], current)]
+    total = re.fullmatch(r'of:=SUM\(\[([^\[\]]+):([^\[\]]+)\]\)', raw, re.I)
+    if not total:
+        fail('ods_formula_unsupported')
+    first = _reference(total[1], current)
+    last = _reference(total[2], first[0])
+    if first[0] != last[0] or first[1] > last[1] or first[2] > last[2]:
+        fail('ods_formula_range')
+    width = last[2] - first[2] + 1
+    height = last[1] - first[1] + 1
+    if width * height > 4096:
+        fail('ods_formula_range_limit')
+    return 'sum', [(first[0], r, c) for r in range(first[1], last[1] + 1)
+                   for c in range(first[2], last[2] + 1)]
+
+
+def _inventory(book):
+    values = {}
+    plans = {}
+    count = dependencies = 0
+    for sheet in book.sheets:
+        name = sheet.get(q(TB, 'name'))
+        if sheet.get(q(TB, 'protected'), 'false') != 'false':
+            fail('unsupported_recalculation_input')
+        for row, column, height, width, node, _ in book.cells(sheet):
+            tick(book.checkpoint)
+            count += height * width
+            if count > 4096:
+                fail('ods_recalculate_cell_limit')
+            value = book.value(node)
+            if value.get('covered') or any(node.get(q(TB, field)) for field in ('number-columns-spanned', 'number-rows-spanned', 'content-validation-name', 'protect')):
+                fail('unsupported_recalculation_input')
+            for r in range(row, row + height):
+                for c in range(column, column + width):
+                    values[name, r, c] = value
+            if 'formula' not in value:
+                continue
+            if height != 1 or width != 1 or value.get('covered'):
+                fail('repeated_or_covered_formula')
+            if value['type'] != 'float' or node.tag != q(TB, 'table-cell'):
+                fail('formula_result_type')
+            operation, refs = _formula(value['formula'], name)
+            dependencies += len(refs)
+            if dependencies > 20000:
+                fail('ods_formula_dependency_limit')
+            plans[name, row, column] = operation, refs, node
+    if book.unsupported:
+        fail('unsupported_recalculation_input')
+    if not plans:
+        fail('no_supported_formulas')
+    scalars = {}
+    for key, value in values.items():
+        if key not in plans and value['type'] == 'float':
+            scalars[key] = decimal(value['value'])
+    waiting = {}
+    dependents = {}
+    for key, (_, refs, _) in plans.items():
+        missing = set()
+        for ref in refs:
+            value = values.get(ref)
+            if value is None:
+                fail('ods_formula_value_unavailable')
+            if value['type'] != 'float':
+                fail('ods_formula_nonnumeric_dependency')
+            if ref in plans:
+                missing.add(ref)
+        waiting[key] = len(missing)
+        for ref in missing:
+            dependents.setdefault(ref, set()).add(key)
+    ready = [key for key, count in waiting.items() if not count]
+    with localcontext() as precision:
+        precision.prec = 34
+        while ready:
+            tick(book.checkpoint)
+            key = ready.pop()
+            operation, refs, _ = plans[key]
+            result = scalars[refs[0]] * scalars[refs[1]] if operation == 'multiply' else sum((scalars[ref] for ref in refs), Decimal(0))
+            decimal(str(result))
+            scalars[key] = result
+            for dependent in dependents.get(key, ()):
+                waiting[dependent] -= 1
+                if not waiting[dependent]:
+                    ready.append(dependent)
+    if not plans.keys() <= scalars.keys():
+        fail('ods_formula_cycle')
+    return values, plans, scalars
+
+
+def _formula_cell(node, value):
+    paragraphs = list(node)
+    if len(paragraphs) != 1 or paragraphs[0].tag != q(T, 'p') or paragraphs[0].attrib or len(paragraphs[0]):
+        fail('formula_cell_content')
+    prefixes = {O: 'office', TB: 'table', T: 'text', ST: 'style', NUM: 'number', XL: 'xlink', OF: 'of'}
+    attributes = dict(node.attrib)
+    attributes[q(O, 'value')] = value
+    used = {O, TB, T}
+    rendered = []
+    for key, raw in attributes.items():
+        if key.startswith('{'):
+            uri, local = key[1:].split('}', 1)
+            if uri == 'http://www.w3.org/XML/1998/namespace':
+                prefix = 'xml'
+            elif uri in prefixes:
+                prefix = prefixes[uri]
+                used.add(uri)
+            else:
+                fail('formula_cell_attribute_namespace')
+            name = prefix + ':' + local
+        else:
+            name = key
+        rendered.append(' ' + name + '="' + escape(raw, {'"': '&quot;'}) + '"')
+    declarations = ''.join(' xmlns:' + prefixes[uri] + '="' + uri + '"' for uri in (TB, O, T) if uri in used)
+    declarations += ''.join(' xmlns:' + prefixes[uri] + '="' + uri + '"' for uri in sorted(used - {TB, O, T}))
+    return ('<table:table-cell' + declarations + ''.join(rendered) + '><text:p>' + _literal(value)
+            + '</text:p></table:table-cell>').encode('utf-8')
+
+
+def _rewrite(data, replacements, checkpoint):
+    out = BytesIO()
+    with zipfile.ZipFile(BytesIO(data)) as source, zipfile.ZipFile(out, 'w') as dest:
+        dest.comment = source.comment
+        for info in source.infolist():
+            tick(checkpoint)
+            dest.writestr(info, replacements.get(info.filename, source.read(info)))
+    result = out.getvalue()
+    if len(result) > 1000000:
+        fail('output_limit')
+    return result
+
+
+def recalculate(data, spec, *, checkpoint=None):
+    if not isinstance(spec, dict) or set(spec) != {'source'}:
+        fail('ods_recalculate_schema')
+    book = Spreadsheet(data, checkpoint=checkpoint)
+    if book.unsupported:
+        fail('unsupported_recalculation_input')
+    values, plans, scalars = _inventory(book)
+    root = book.xml['content.xml']
+    cells = [n for n in root.iter() if n.tag in (q(TB, 'table-cell'), q(TB, 'covered-table-cell'))]
+    raw = book.parts['content.xml']
+    replacements = []
+    for key, (_, _, node) in plans.items():
+        number = format(scalars[key], 'f')
+        begin, end = _cell_span(raw, cells.index(node))
+        replacements.append((begin, end, _formula_cell(node, number)))
+    for begin, end, replacement in sorted(replacements, reverse=True):
+        raw = raw[:begin] + replacement + raw[end:]
+    result = _rewrite(data, {'content.xml': raw}, checkpoint)
+    after = Spreadsheet(result, checkpoint=checkpoint)
+    if after.unsupported:
+        fail('recalculation_readback_unsupported')
+    after_values, after_plans, after_scalars = _inventory(after)
+    if set(values) != set(after_values) or set(plans) != set(after_plans):
+        fail('recalculation_cell_identity_mismatch')
+    for key, before in values.items():
+        other = after_values[key]
+        if before.get('formula') != other.get('formula') or before['type'] != other['type']:
+            fail('recalculation_formula_changed')
+        if key not in plans and before['value'] != other['value']:
+            fail('recalculation_unrelated_value_changed')
+        if key in plans and other['value'] != format(scalars[key], 'f'):
+            fail('recalculation_value_mismatch')
+    return result
