+"""Existing source custody and create-only publisher for a numbered Word edit."""
+import hashlib
+import json
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied,workspace_document
+from hermes_cli.friday_workspace_docx import _check_parent,_create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_word_located import edit_paragraph
+from tools.scoped_word_profiles import WordProfileError
+
+
+def create_located_edit(cap,fd,leaf,path,content):
+    _check_parent(cap,fd,path)
+    if Path(path).name!=leaf or Path(path).suffix.lower()not in('.docx','.dotx'):raise ScopeDenied()
+    if not isinstance(content,str)or len(content.encode('utf-8'))>100000:raise ScopeDenied()
+    def pairs(items):
+        result={}
+        for key,value in items:
+            if key in result:raise ScopeDenied()
+            result[key]=value
+        return result
+    try:spec=json.loads(content,object_pairs_hook=pairs)
+    except(ValueError,RecursionError):raise ScopeDenied()from None
+    if not isinstance(spec,dict)or set(spec)!={'source','source_sha256','paragraph','old_text','new_text'}:raise ScopeDenied()
+    expected=spec['source_sha256']
+    if (not isinstance(expected,str)or len(expected)!=64
+            or any(c not in '0123456789abcdef'for c in expected)):raise ScopeDenied()
+    source=spec['source']
+    if not isinstance(source,str)or not source or '\x00'in source:raise ScopeDenied()
+    source=Path(source);root=cap.home/'workspace'
+    if not source.is_absolute():source=root/source
+    try:relative=source.relative_to(root)
+    except ValueError:raise ScopeDenied()from None
+    profile=Path(path).suffix.lower()[1:]
+    if (not relative.parts or any(p in('.','..')or p.startswith('.')for p in relative.parts)
+            or source.suffix.lower()!='.'+profile or relative.as_posix()==path):raise ScopeDenied()
+    data,_,identity=workspace_document(str(source),with_identity=True)
+    source_sha256=hashlib.sha256(data).hexdigest()
+    if source_sha256!=expected:
+        return json.dumps(dict(success=False,error='document_edit_refused',reason='source_hash_mismatch',effect_disposition='none'))
+    try:result=edit_paragraph(data,spec['old_text'],spec['new_text'],spec['paragraph'],profile,checkpoint=lambda:check(cap))
+    except WordProfileError as error:
+        return json.dumps(dict(success=False,error='document_edit_refused',reason=error.code,effect_disposition='none'))
+    def verify():
+        check(cap);current,_,version=workspace_document(str(source),with_identity=True)
+        if current!=data or version!=identity:raise ScopeDenied()
+    answer=json.loads(_create_bytes(cap,fd,leaf,path,result,output_format='word_located_edit',verify_source=verify))
+    if answer.get('success'):
+        answer.update(source=relative.as_posix(),source_sha256=source_sha256,source_unchanged=True,paragraph=spec['paragraph'],replacements=1,unchanged_parts_preserved=True)
+    return json.dumps(answer,ensure_ascii=False)
