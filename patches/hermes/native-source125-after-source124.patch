+def _book(data, rels, ctx):
+    records = list(_records(data, ctx))
+    if len(records) < 5 or records[0][1:] != (0x83, b'') or records[-1][1:] != (0x84, b''):
+        _fail('workbook_stream')
+    sheets = []
+    state = 0
+    stack = []
+    date1904 = False
+    seen = set()
+    views = False
+    for _, kind, payload in records[1:-1]:
+        if _wrappers(kind, payload, stack):
+            continue
+        if kind == 0x8f:
+            _size(payload, 0)
+            if state != 0 or views or stack:
+                _fail('sheet_bundle_order')
+            state = 1
+        elif kind == 0x90:
+            _size(payload, 0)
+            if state != 1 or not sheets or stack:
+                _fail('sheet_bundle_order')
+            state = 2
+        elif kind == 0x9c:
+            if state != 1 or stack or len(payload) < 16:
+                _fail('sheet_bundle')
+            vis, sheet_id = struct.unpack_from('<II', payload)
+            rid, at = _wide(payload, 8, maximum=255, nullable=True)
+            name, at = _wide(payload, at, maximum=31)
+            if (at != len(payload) or vis > 2 or not 1 <= sheet_id <= 65535 or
+                    not name or any(c in name for c in '\x00\x03:\\*?/[]') or
+                    name[0] == "'" or name[-1] == "'" or not rid or '\0' in rid):
+                _fail('sheet_bundle')
+            if rid not in rels or rels[rid][0] != 'worksheet':
+                _fail('worksheet_relationship')
+            sheets.append(dict(name=name, visibility=('visible', 'hidden', 'very_hidden')[vis],
+                               id=sheet_id, rid=rid, part=rels[rid][1]))
+            if len(sheets) > MAX_SHEETS:
+                _fail('sheet_limit')
+        elif kind == 0x87:
+            _size(payload, 0)
+            if views or state or stack:
+                _fail('book_view_order')
+            views = True
+        elif kind == 0x88:
+            _size(payload, 0)
+            if not views or stack:
+                _fail('book_view_order')
+            views = False
+        elif kind == 0x9e:
+            if not views or len(payload) != 29:
+                _fail('book_view_size')
+        elif kind in (0x80, 0x99, 0x9d, 0x9b, 0x817, 0x82b):
+            if state == 1 or views or kind in seen:
+                _fail('workbook_record_order')
+            seen.add(kind)
+            if kind == 0x99:
+                if len(payload) < 12:
+                    _fail('workbook_properties')
+                _, at = _wide(payload, 8, maximum=255)
+                if at != len(payload):
+                    _fail('workbook_properties')
+                date1904 = bool(_u32(payload) & 1)
+            elif kind == 0x9d:
+                _size(payload, 26)
+            elif kind == 0x9b:
+                _size(payload, 1)
+            elif kind == 0x817:
+                _, at = _wide(payload, 0, maximum=4096)
+                if at != len(payload) or not stack or stack[-1] != 0x25:
+                    _fail('absolute_path_record')
+            elif kind == 0x82b:
+                _size(_future(payload), 1)
+                if not stack or stack[-1] != 0x23:
+                    _fail('workbook_extension')
+            elif kind == 0x80:
+                if len(payload) < 16:
+                    _fail('file_version')
+                at = 16
+                for _ in range(4):
+                    _, at = _wide(payload, at, maximum=255)
+                if at != len(payload):
+                    _fail('file_version')
+            ctx.ignored.add(kind)
+        else:
+            _fail('workbook_record_unsupported')
+    if state != 2 or views or stack:
+        _fail('workbook_incomplete')
+    for key in ('id', 'rid', 'part'):
+        if len({s[key] for s in sheets}) != len(sheets):
+            _fail('duplicate_sheet')
+    if len({s['name'].casefold() for s in sheets}) != len(sheets):
+        _fail('duplicate_sheet')
+    if {s['rid'] for s in sheets} != {r for r, (role, _) in rels.items() if role == 'worksheet'}:
+        _fail('unlisted_sheet')
+    return sheets, date1904
