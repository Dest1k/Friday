+
+
+def _path(name):
+    if (not isinstance(name, str) or not name or len(name) > 255 or
+            name.startswith('/') or name.endswith('/') or '\\' in name or
+            any(ord(c) < 33 or ord(c) > 126 for c in name) or
+            any(c in name for c in '%:#?') or
+            any(p in ('', '.', '..') for p in name.split('/'))):
+        _fail('package_path')
+    return name
+
+
+def _target(source, value):
+    if not value or value.startswith('/') or any(c in value for c in '%\\:#?'):
+        _fail('relationship_target')
+    # This narrow profile allows direct relative part names, not dot segments.
+    target = posixpath.join(posixpath.dirname(source), value)
+    return _path(target)
+
+
+def _xml(data):
+    if len(data) > MAX_EXPANDED or b'\x00' in data:
+        _fail('xml_encoding')
+    try:
+        data.decode('utf-8-sig', 'strict')
+    except UnicodeError:
+        _fail('xml_encoding')
+    if re.search(br'<\?xml[^>]*encoding\s*=\s*[\"\'](?!utf-8[\"\'])', data, re.I):
+        _fail('xml_encoding')
+    if re.search(br'<!|<\?(?!xml\s)', data, re.I):
+        _fail('xml_declaration')
+    try:
+        root = ET.fromstring(data)
+    except (ET.ParseError, UnicodeError, LookupError):
+        _fail('xml_malformed')
+    stack = [(root, 0)]
+    count = 0
+    while stack:
+        node, depth = stack.pop()
+        count += 1
+        if depth > 64 or count > 20000 or len(node.attrib) > 64:
+            _fail('xml_limit')
+        stack.extend((child, depth + 1) for child in node)
+    return root
