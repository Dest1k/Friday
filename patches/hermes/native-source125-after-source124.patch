+# Style families contain only rendering data. Counts and complete nesting are
+# checked, but individual style payload semantics are deliberately omitted.
+_STYLE_GROUPS = {0x267:(0x268,0x2c), 0x263:(0x264,0x2b), 0x25b:(0x25c,0x2d),
+                 0x265:(0x266,0x2e), 0x272:(0x273,0x2f), 0x269:(0x26a,0x2f),
+                 0x26b:(0x26c,0x30), 0x1f9:(0x1fa,None)}
+_STYLE_PAIRS = {0x46b:0x46c, 0x476:0x477, 0x830:0x831, 0x832:0x833}
+
+
+def _styles(data, ctx):
+    records = list(_records(data, ctx))
+    if len(records) < 2 or records[0][1:] != (0x116, b'') or records[-1][1:] != (0x117, b''):
+        _fail('styles_stream')
+    wrappers = []
+    group = None
+    nested = []
+    counts = {}
+    formats = set()
+    xfs = []
+    style_ids = []
+    for _, kind, payload in records[1:-1]:
+        if _wrappers(kind, payload, wrappers):
+            continue
+        ctx.ignored.add(kind)
+        if kind in _STYLE_GROUPS:
+            if group is not None or kind in counts or nested or wrappers:
+                _fail('style_group')
+            _size(payload, 4)
+            count = _u32(payload)
+            if count > 8192 or (kind in (0x263, 0x265, 0x272, 0x269) and not count):
+                _fail('style_count')
+            counts[kind] = count
+            group = [kind, count, 0]
+        elif group is not None and kind == _STYLE_GROUPS[group[0]][0]:
+            _size(payload, 0)
+            if wrappers or group[1] != group[2]:
+                _fail('style_count')
+            group = None
+        elif group is not None and kind == _STYLE_GROUPS[group[0]][1]:
+            if wrappers:
+                _fail('style_record_nesting')
+            if kind == 0x2f:
+                _size(payload, 16)
+                xfs.append((group[0], struct.unpack_from('<HHHHH', payload)))
+            elif kind == 0x2b:
+                if len(payload) < 25:
+                    _fail('font_record')
+                _, at = _wide(payload, 21, maximum=255)
+                if at != len(payload):
+                    _fail('font_record')
+            elif kind == 0x2c:
+                if len(payload) < 6:
+                    _fail('format_record')
+                fmt = struct.unpack_from('<H', payload)[0]
+                _, at = _wide(payload, 2, maximum=255)
+                if at != len(payload) or fmt in formats or not 164 <= fmt <= 0xffff:
+                    _fail('format_record')
+                formats.add(fmt)
+            elif kind == 0x2d:
+                # BrtFill has68 bytes plus16 bytes per gradient stop.
+                if len(payload) < 68 or len(payload) != 68 + _u32(payload, 64) * 16:
+                    _fail('fill_record')
+            elif kind == 0x2e:
+                _size(payload, 51)
+            elif kind == 0x30:
+                if len(payload) < 12:
+                    _fail('style_record')
+                _, at = _wide(payload, 8, maximum=255, nullable=True)
+                if at != len(payload):
+                    _fail('style_record')
+                style_ids.append(_u32(payload))
+            group[2] += 1
+        elif kind == 0x401:
+            _size(payload, 0)
+            if group is None or group[0] != 0x263 or not wrappers or wrappers[-1] != 0x25:
+                _fail('known_fonts_record')
+        elif kind in _STYLE_PAIRS:
+            if group is not None or len(nested) >= 4 or not wrappers or wrappers[-1] != 0x23:
+                _fail('style_nesting')
+            if kind in (0x46b, 0x830):
+                _size(_future(payload), 0)
+                if nested:
+                    _fail('style_nesting')
+            else:
+                if nested != ([0x46c] if kind == 0x476 else [0x831]):
+                    _fail('style_nesting')
+                value, at = _wide(_future(payload), 0, maximum=255)
+                if not value or at != len(_future(payload)):
+                    _fail('style_extension_string')
+            nested.append(_STYLE_PAIRS[kind])
+        elif nested and kind == nested[-1]:
+            _size(_future(payload) if kind != 0x1fd else payload, 0)
+            nested.pop()
+        elif kind == 0x1fc:
+            if group is not None or nested or wrappers or len(payload) < 12 or _u32(payload):
+                _fail('custom_table_styles_unsupported')
+            _, at = _wide(payload, 4, maximum=255)
+            _, at = _wide(payload, at, maximum=255)
+            if at != len(payload):
+                _fail('table_style_group')
+            nested.append(0x1fd)
+        else:
+            _fail('styles_record_unsupported')
+    if wrappers or group is not None or nested or not all(k in counts for k in (0x263, 0x25b, 0x265, 0x272, 0x269)):
+        _fail('styles_incomplete')
+    for group_kind, (parent, fmt, font, fill, border) in xfs:
+        if ((group_kind == 0x272 and parent != 0xffff) or
+                (group_kind == 0x269 and parent >= counts[0x272]) or
+                font >= counts[0x263] or fill >= counts[0x25b] or border >= counts[0x265] or
+                (fmt >= 164 and fmt not in formats)):
+            _fail('style_reference')
+    if any(value >= counts[0x272] for value in style_ids):
+        _fail('style_reference')
+    return {'xf':counts[0x269], 'font':counts[0x263]}
