+class _Package:
+    def __init__(self, data, ctx):
+        self.parts = {}
+        self.types = {}
+        self.rels = {}
+        self.used = {'[Content_Types].xml'}
+        # A narrow exact ZIP envelope: no prefix, suffix, spanning, ZIP64,
+        # orphan local members or hidden data between described members.
+        if len(data) < 22 or data[:4] != b'PK\x03\x04' or data[-22:-18] != b'PK\x05\x06':
+            _fail('zip_envelope')
+        signature, disk, cd_disk, disk_entries, entries, cd_size, cd_at, comment = struct.unpack('<4sHHHHIIH', data[-22:])
+        if disk or cd_disk or disk_entries != entries or comment or cd_at + cd_size != len(data) - 22:
+            _fail('zip_envelope')
+        try:
+            archive = zipfile.ZipFile(io.BytesIO(data))
+        except (zipfile.BadZipFile, NotImplementedError, RuntimeError, EOFError, OSError, struct.error, UnicodeError):
+            _fail('invalid_zip')
+        with archive:
+            infos = archive.infolist()
+            if not infos or len(infos) > MAX_PARTS or len(infos) != entries or archive.start_dir != cd_at:
+                _fail('package_parts')
+            names = set()
+            total = 0
+            ordered = sorted(infos, key=lambda item: item.header_offset)
+            expected_at = 0
+            for i, info in enumerate(ordered):
+                ctx.check()  # Outside parser-error handlers: cancellation survives.
+                name = _path(info.filename)
+                if (name.casefold() in names or info.flag_bits & ~0x80e or
+                        (info.flag_bits & 6 and info.compress_type != zipfile.ZIP_DEFLATED)):
+                    _fail('package_duplicate_or_flags')
+                names.add(name.casefold())
+                if info.external_attr >> 16 & 0o170000 not in (0, 0o100000):
+                    _fail('package_member_type')
+                if info.header_offset != expected_at or expected_at + 30 > cd_at:
+                    _fail('zip_member_layout')
+                local = struct.unpack_from('<4sHHHHHIIIHH', data, expected_at)
+                if local[0] != b'PK\x03\x04' or 0xffffffff in local[7:9]:
+                    _fail('zip_member_layout')
+                end = expected_at + 30 + local[9] + local[10] + info.compress_size
+                boundary = ordered[i + 1].header_offset if i + 1 < len(ordered) else cd_at
+                if info.flag_bits & 8:
+                    # Helper verifies the descriptor itself; require exact occupancy.
+                    if boundary - end not in (12, 16):
+                        _fail('zip_member_layout')
+                elif end != boundary:
+                    _fail('zip_member_layout')
+                expected_at = boundary
+                total += info.file_size
+                if total > MAX_EXPANDED:
+                    _fail('expanded_limit')
+                try:
+                    self.parts[name] = read_zip_member(archive, data, info, MAX_EXPANDED)
+                except (zipfile.BadZipFile, NotImplementedError, RuntimeError, EOFError, OSError, struct.error, UnicodeError):
+                    _fail('invalid_zip')
+        if '[Content_Types].xml' not in self.parts or '_rels/.rels' not in self.parts:
+            _fail('package_required_parts')
+        root = _xml(self.parts['[Content_Types].xml'])
+        if root.tag != '{' + CT_NS + '}Types' or root.attrib:
+            _fail('content_types')
+        defaults = {}
+        overrides = {}
+        permitted = set(CT.values()) | {'application/xml'}
+        for node in root:
+            if len(node) or (node.text and node.text.strip()):
+                _fail('content_types')
+            if node.tag == '{' + CT_NS + '}Default' and set(node.attrib) == {'Extension', 'ContentType'}:
+                ext, typ = node.get('Extension'), node.get('ContentType')
+                if not re.fullmatch(r'[a-zA-Z0-9]+', ext) or ext.casefold() in defaults:
+                    _fail('content_types')
+                defaults[ext.casefold()] = typ
+            elif node.tag == '{' + CT_NS + '}Override' and set(node.attrib) == {'PartName', 'ContentType'}:
+                name = node.get('PartName')
+                if not name.startswith('/'):
+                    _fail('content_types')
+                name = _path(name[1:])
+                if name in overrides or name not in self.parts:
+                    _fail('content_types')
+                overrides[name] = node.get('ContentType')
+                typ = node.get('ContentType')
+            else:
+                _fail('content_types')
+            if typ not in permitted:
+                _fail('part_type_unsupported')
+        for name, payload in self.parts.items():
+            if name == '[Content_Types].xml':
+                continue
+            typ = overrides.get(name, defaults.get(name.rsplit('.', 1)[-1].casefold()))
+            if typ is None:
+                _fail('part_type_missing')
+            self.types[name] = typ
+            if name.endswith('.rels'):
+                if typ != CT['rels']:
+                    _fail('relationship_part_type')
+                self.rels[name] = self._relationships(payload, self._source(name))
+
+    @staticmethod
+    def _source(name):
+        if name == '_rels/.rels':
+            return ''
+        parent, _, leaf = name.rpartition('/')
+        if not parent.endswith('/_rels') or not leaf.endswith('.rels'):
+            _fail('relationship_part_path')
+        return posixpath.join(parent[:-6], leaf[:-5])
+
+    def _relationships(self, payload, source):
+        root = _xml(payload)
+        if root.tag != '{' + REL_NS + '}Relationships' or root.attrib:
+            _fail('relationships')
+        result = {}
+        targets = set()
+        for node in root:
+            if (node.tag != '{' + REL_NS + '}Relationship' or len(node) or
+                    (node.text and node.text.strip()) or
+                    not {'Id', 'Type', 'Target'} <= set(node.attrib) or
+                    set(node.attrib) - {'Id', 'Type', 'Target', 'TargetMode'}):
+                _fail('relationships')
+            if node.get('TargetMode', 'Internal') != 'Internal':
+                _fail('external_relationship')
+            rid = node.get('Id')
+            if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_.-]{0,254}', rid) or rid in result:
+                _fail('relationship_id')
+            target = _target(source, node.get('Target'))
+            if target not in self.parts or target in targets:
+                _fail('relationship_missing_or_duplicate')
+            targets.add(target)
+            result[rid] = (node.get('Type'), target)
+        return result
+
+    def relationships(self, source, roles):
+        name = '_rels/.rels' if not source else posixpath.join(posixpath.dirname(source), '_rels', posixpath.basename(source) + '.rels')
+        rels = self.rels.get(name, {})
+        if name in self.parts:
+            self.used.add(name)
+        result = {}
+        for rid, (typ, target) in rels.items():
+            if typ not in roles:
+                _fail('relationship_type_unsupported')
+            role = roles[typ]
+            if self.types[target] != CT[role]:
+                _fail('relationship_content_type')
+            self.used.add(target)
+            result[rid] = (role, target)
+        return result
+
+    def finish(self):
+        if self.used != set(self.parts):
+            _fail('unreferenced_or_unsupported_part')
+
