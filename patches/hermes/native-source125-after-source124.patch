+"""Admitted own-workspace native report creation; no automatic Office launch."""
+import json
+from pathlib import Path
+
+from hermes_cli.friday_user_scope import ScopeDenied
+from hermes_cli.friday_workspace_docx import _check_parent,_create_bytes
+from hermes_cli.friday_workspace_revision import check
+from tools.scoped_word_report import render_report
+from tools.scoped_word_profiles import WordProfileError
+
+
+def create_report(cap,fd,leaf,path,content):
+    _check_parent(cap,fd,path)
+    if Path(path).name!=leaf or Path(path).suffix.lower()!='.docx':raise ScopeDenied()
+    try:data,metadata=render_report(content,checkpoint=lambda:check(cap))
+    except WordProfileError as error:
+        return json.dumps(dict(success=False,error='document_create_refused',reason=error.code,effect_disposition='none'))
+    result=json.loads(_create_bytes(cap,fd,leaf,path,data,output_format='docx_report'))
+    if result.get('success'):result.update(report=metadata)
+    return json.dumps(result,ensure_ascii=False)
