+"""Bounded native ODS column charts with source references and a local cache."""
+from io import BytesIO
+import re
+import zipfile
+from xml.etree import ElementTree as ET
+from xml.parsers import expat
+from xml.sax.saxutils import escape, quoteattr
+
+from tools.scoped_ods import (
+    Spreadsheet, ODSError, O, T, TB, M, ST, XL, q, _literal, address, colname,
+    decimal, tick,
+)
+from tools.scoped_odt import _text
+
+DR = 'urn:oasis:names:tc:opendocument:xmlns:drawing:1.0'
+CH = 'urn:oasis:names:tc:opendocument:xmlns:chart:1.0'
+SVG = 'urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0'
+CHART_MIME = 'application/vnd.oasis.opendocument.chart'
+MAX_POINTS = 128
+
+
+def fail(code):
+    raise ODSError(code)
+
+
+def _input_range(raw):
+    if not isinstance(raw, str) or not re.fullmatch(r'[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}', raw):
+        fail('chart_range_schema')
+    first, last = raw.split(':')
+    r1, c1 = address(first)
+    r2, c2 = address(last)
+    if r2 <= r1 or c2 <= c1 or c2 - c1 + 1 not in (2, 3) or r2 - r1 > MAX_POINTS:
+        fail('chart_range_bounds')
+    return r1, c1, r2, c2
+
+
+def _cell_values(book):
+    result = {}
+    count = 0
+    for sheet in book.sheets:
+        name = sheet.get(q(TB, 'name'))
+        for row, column, height, width, node, _ in book.cells(sheet):
+            tick(book.checkpoint)
+            value = book.value(node)
+            if any(node.get(q(TB, field)) for field in ('number-columns-spanned', 'number-rows-spanned', 'content-validation-name', 'protect')):
+                value['constrained'] = True
+            count += height * width
+            if count > 4096:
+                fail('chart_cell_limit')
+            for r in range(row, row + height):
+                for c in range(column, column + width):
+                    result[name, r, c] = value
+    return result
+
+
+def _sheet_ref(name):
+    return "$'" + name.replace("'", "''") + "'"
+
+
+def _cell_ref(sheet, row, column):
+    return _sheet_ref(sheet) + '.$' + colname(column) + '$' + str(row)
+
+
+def _range_ref(sheet, row1, column, row2):
+    first = _cell_ref(sheet, row1, column)
+    return first if row2 == row1 else first + ':.$' + colname(column) + '$' + str(row2)
+
+
+def _chart_xml(title, sheet_name, r1, c1, r2, c2, values):
+    labels = [values[r1, c][0] for c in range(c1 + 1, c2 + 1)]
+    category_ref = _range_ref(sheet_name, r1 + 1, c1, r2)
+    series = []
+    for column in range(c1 + 1, c2 + 1):
+        series.append(
+            '<chart:series chart:class="chart:bar" chart:values-cell-range-address='
+            + quoteattr(_range_ref(sheet_name, r1 + 1, column, r2))
+            + ' chart:label-cell-address=' + quoteattr(_cell_ref(sheet_name, r1, column)) + '/>'
+        )
+    rows = []
+    for r in range(r1 + 1, r2 + 1):
+        cells = ['<table:table-cell office:value-type="string"><text:p>' + _literal(values[r, c1][0]) + '</text:p></table:table-cell>']
+        for c in range(c1 + 1, c2 + 1):
+            number = format(decimal(values[r, c][0]), 'f')
+            cells.append('<table:table-cell office:value-type="float" office:value="' + number + '"><text:p>' + number + '</text:p></table:table-cell>')
+        rows.append('<table:table-row>' + ''.join(cells) + '</table:table-row>')
+    header = ['<table:table-cell office:value-type="string"><text:p>Category</text:p></table:table-cell>']
+    header += ['<table:table-cell office:value-type="string"><text:p>' + _literal(label) + '</text:p></table:table-cell>' for label in labels]
+    cache = ('<table:table table:name="local-table"><table:table-column table:number-columns-repeated="'
+             + str(c2 - c1 + 1) + '"/><table:table-row>' + ''.join(header) + '</table:table-row>' + ''.join(rows) + '</table:table>')
+    declarations = ('xmlns:office="' + O + '" xmlns:chart="' + CH + '" xmlns:table="' + TB
+                    + '" xmlns:text="' + T + '" xmlns:style="' + ST + '"')
+    return ('<?xml version="1.0" encoding="UTF-8"?><office:document-content ' + declarations + ' office:version="1.3">'
+            '<office:automatic-styles><style:style style:name="plot" style:family="chart">'
+            '<style:chart-properties chart:vertical="false"/></style:style></office:automatic-styles>'
+            '<office:body><office:chart><chart:chart chart:class="chart:bar"><chart:title><text:p>'
+            + _literal(title) + '</text:p></chart:title><chart:plot-area chart:data-source-has-labels="both" chart:style-name="plot">'
+            '<chart:axis chart:dimension="x" chart:name="primary-x"><chart:categories table:cell-range-address='
+            + quoteattr(category_ref) + '/></chart:axis><chart:axis chart:dimension="y" chart:name="primary-y"/>'
+            + ''.join(series) + '</chart:plot-area>' + cache + '</chart:chart></office:chart></office:body></office:document-content>').encode('utf-8')
+
+
+def _insertions(raw, sheet_index, manifest=False):
+    parser = expat.ParserCreate(namespace_separator='}')
+    depth = spreadsheet_depth = target_depth = None
+    tables = 0
+    insertion = None
+    row_groups = {TB + '}' + n for n in ('table-column', 'table-columns', 'table-column-group', 'table-header-columns', 'table-row', 'table-header-rows', 'table-row-group', 'table-rows')}
+    def start(name, attrs):
+        nonlocal depth, spreadsheet_depth, target_depth, tables, insertion
+        depth = 0 if depth is None else depth + 1
+        if name == O + '}spreadsheet':
+            spreadsheet_depth = depth
+        elif spreadsheet_depth is not None and depth == spreadsheet_depth + 1 and name == TB + '}table':
+            if tables == sheet_index:
+                target_depth = depth
+            tables += 1
+        elif target_depth is not None and depth == target_depth + 1 and name in row_groups and insertion is None:
+            insertion = parser.CurrentByteIndex
+    def end(name):
+        nonlocal depth, target_depth, insertion
+        if manifest and name == M + '}manifest':
+            insertion = parser.CurrentByteIndex
+        if target_depth == depth:
+            target_depth = None
+        depth -= 1
+    def refuse(*args):
+        fail('active_xml')
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.StartDoctypeDeclHandler = refuse
+    parser.EntityDeclHandler = refuse
+    parser.ProcessingInstructionHandler = refuse
+    try:
+        parser.Parse(raw, True)
+    except expat.ExpatError:
+        fail('invalid_xml')
+    if insertion is None or (not manifest and tables <= sheet_index):
+        fail('chart_insertion_point')
+    return insertion
+
+
+def _write_package(data, content, manifest, chart_path, chart_xml, checkpoint):
+    out = BytesIO()
+    with zipfile.ZipFile(BytesIO(data)) as source, zipfile.ZipFile(out, 'w') as dest:
+        dest.comment = source.comment
+        for info in source.infolist():
+            tick(checkpoint)
+            payload = source.read(info)
+            if info.filename == 'content.xml':
+                payload = content
+            elif info.filename == 'META-INF/manifest.xml':
+                payload = manifest
+            dest.writestr(info, payload)
+        dest.writestr(chart_path, chart_xml, compress_type=zipfile.ZIP_DEFLATED)
+    result = out.getvalue()
+    if len(result) > 1000000:
+        fail('output_limit')
+    return result
+
+
+def add_chart(data, spec, *, checkpoint=None):
+    if not isinstance(spec, dict) or set(spec) != {'source', 'sheet', 'range', 'title'}:
+        fail('ods_chart_schema')
+    book = Spreadsheet(data, checkpoint=checkpoint)
+    if book.unsupported:
+        fail('unsupported_chart_input')
+    if not isinstance(spec['title'], str) or not spec['title'] or len(spec['title'].encode('utf-8')) > 256:
+        fail('chart_title')
+    _literal(spec['title'])
+    r1, c1, r2, c2 = _input_range(spec['range'])
+    sheets = [s for s in book.sheets if s.get(q(TB, 'name')) == spec['sheet']]
+    if len(sheets) != 1:
+        fail('chart_sheet_not_found')
+    sheet = sheets[0]
+    if sheet.get(q(TB, 'protected'), 'false') != 'false' or sheet.find(q(TB, 'shapes')) is not None:
+        fail('chart_sheet_not_empty_or_protected')
+    cells = _cell_values(book)
+    values = {}
+    for r in range(r1, r2 + 1):
+        for c in range(c1, c2 + 1):
+            value = cells.get((spec['sheet'], r, c))
