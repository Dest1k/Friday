+def _wrappers(kind, payload, stack):
+    if kind in (0x23, 0x25):
+        if len(stack) >= 8:
+            _fail('record_nesting')
+        if kind == 0x23:
+            _size(payload, 4)
+        else:
+            if len(payload) < 2:
+                _fail('alternate_content')
+            count = struct.unpack_from('<H', payload)[0]
+            if not count or len(payload) != 2 + 4 * count:
+                _fail('alternate_content')
+        stack.append(kind)
+        return True
+    if kind in (0x24, 0x26):
+        _size(payload, 0)
+        if not stack or stack.pop() != kind - 1:
+            _fail('record_nesting')
+        return True
+    return False
+
