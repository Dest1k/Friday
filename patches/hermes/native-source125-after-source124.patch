+_SKIP = {'pPr', 'rPr', 'rt', 'proofErr', 'bookmarkStart', 'bookmarkEnd'}
+
+
+def _local(tag):
+    return tag.rsplit('}', 1)[-1] if isinstance(tag, str) else ''
+
+
+def _revision(tag):
+    if not isinstance(tag, str) or not tag.startswith(('{' + W + '}', '{' + W14 + '}')):
+        return False
+    name = _local(tag)
+    return (name in {'ins', 'del', 'delText', 'delInstrText', 'cellIns', 'cellDel',
+                     'cellMerge', 'conflictIns', 'conflictDel', 'numberingChange',
+                     'tblGridChange', 'tblPrExChange'}
+            or name.endswith('PrChange') or name.startswith(('moveFrom', 'moveTo'))
+            or name.startswith('customXml') and 'Range' in name)
+
+
+def has_review_layers(package):
+    return (any(kind == R + '/comments' for kind, _ in
+                package.relationships.get('word/document.xml', {}).values())
+            or any(kind == COMMENT_TYPE for kind in package.types.values())
+            or any(_revision(node.tag) or node.tag in _MARKERS
+                   for root in package.xml.values() for node in root.iter()))
+
+
+def _id(node):
+    value = node.get(_q(W, 'id'))
+    if not isinstance(value, str) or not re.fullmatch(r'0|[1-9][0-9]{0,9}', value):
+        _fail('invalid_review_id')
+    return value
+
