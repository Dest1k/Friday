+def _future(payload):
+    # MS-XLSB §2.1.6 infers FRTBlank when a future payload is below4 bytes.
+    if len(payload) < 4:
+        return payload
+    if payload[:4] != b'\0' * 4:
+        _fail('future_header_unsupported')
+    return payload[4:]
+
