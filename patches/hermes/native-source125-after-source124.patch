+def _rk(data):
+    _size(data, 4)
+    raw = _u32(data)
+    value = (struct.unpack('<i', data)[0] >> 2 if raw & 2 else
+             _number(b'\0' * 4 + struct.pack('<I', raw & 0xfffffffc)))
+    return value / 100 if raw & 1 else value
