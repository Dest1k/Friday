+def _sheet(data, strings, xf_count, ctx):
+    records = list(_records(data, ctx))
+    if len(records) < 4 or records[0][1:] != (0x81, b'') or records[-1][1:] != (0x82, b''):
+        _fail('worksheet_stream')
+    cells = []
+    anchors = {}
+    wrappers = []
+    views = []
+    colinfos = False
+    state = 0
+    row = -1
+    row_spans = []
+    row_cols = []
+    row_count = 0
+    last_col = -1
+    dim = None
+    seen = set()
+
+    def finish_row():
+        actual = {}
+        for column in row_cols:
+            segment = column // 1024
+            actual.setdefault(segment, [column, column])[1] = column
+        if list(actual.values()) != [list(span) for span in row_spans]:
+            _fail('row_span_count_or_bounds')
+
+    for offset, kind, payload in records[1:-1]:
+        if _wrappers(kind, payload, wrappers):
+            continue
+        if kind == 0x91:
+            _size(payload, 0)
+            if state or wrappers or views or colinfos:
+                _fail('sheet_data_order')
+            state = 1
+        elif kind == 0x92:
+            _size(payload, 0)
+            if state != 1 or wrappers:
+                _fail('sheet_data_order')
+            finish_row()
+            state = 2
+        elif kind == 0:
+            if state != 1 or wrappers or len(payload) < 17:
+                _fail('row_header')
+            finish_row()
+            new_row = _u32(payload)
+            n = _u32(payload, 13)
+            if (not row < new_row < 1048576 or n > 16 or len(payload) != 17 + 8 * n or
+                    (payload[11] & 0x40 and _u32(payload, 4) >= xf_count)):
+                _fail('row_header')
+            row = new_row
+            row_count += 1
+            if row_count > MAX_ROWS:
+                _fail('row_limit')
+            row_spans = []
+            row_cols = []
+            last_col = -1
+            for i in range(n):
+                first, last = struct.unpack_from('<II', payload, 17 + 8 * i)
+                if (not first <= last < 16384 or first // 1024 != last // 1024 or
+                        row_spans and row_spans[-1][1] // 1024 >= first // 1024):
+                    _fail('row_span_bounds')
+                row_spans.append((first, last))
+        elif 1 <= kind <= 11:
+            if state != 1 or row < 0 or wrappers or len(payload) < 8:
+                _fail('cell_record_order')
+            column, rawstyle = struct.unpack_from('<II', payload)
+            style = rawstyle & 0xffffff
+            if column >= 16384 or column <= last_col or style >= xf_count:
+                _fail('cell_column_or_style')
+            if not any(first <= column <= last for first, last in row_spans):
+                _fail('cell_outside_row_span')
+            if dim is not None and not (dim[0] <= row <= dim[1] and dim[2] <= column <= dim[3]):
+                _fail('cell_outside_dimension')
+            last_col = column
+            row_cols.append(column)
+            anchors[offset] = (row, column, not row_cols[:-1] or row_cols[-2] // 1024 != column // 1024)
+            ctx.cells += 1
+            if ctx.cells > MAX_CELLS:
+                _fail('cell_limit')
+            if kind == 1:
+                _size(payload, 8)
+                cell = _cell(row, column, style, 'blank', None)
+            elif kind == 2:
+                _size(payload, 12)
+                cell = _cell(row, column, style, 'number', _rk(payload[8:]))
+            elif kind in (3, 4):
+                _size(payload, 9)
+                v = payload[8]
+                if kind == 4:
+                    if v not in (0, 1):
+                        _fail('boolean_value')
+                    typ, v = 'boolean', bool(v)
+                else:
+                    if v not in _ERRORS:
+                        _fail('error_value')
+                    typ, v = 'error', _ERRORS[v]
+                cell = _cell(row, column, style, typ, v)
+            elif kind == 5:
+                _size(payload, 16)
+                cell = _cell(row, column, style, 'number', _number(payload[8:]))
+            elif kind == 6:
+                value, at = _wide(payload, 8)
+                if at != len(payload):
+                    _fail('inline_string_trailing')
+                cell = _cell(row, column, style, 'string', value)
+            elif kind == 7:
+                _size(payload, 12)
+                idx = _u32(payload, 8)
+                if idx >= len(strings):
+                    _fail('sst_reference')
+                ctx.string_refs += 1
+                cell = _cell(row, column, style, 'string', strings[idx])
+            else:
+                if kind == 8:
+                    value, at = _wide(payload, 8)
+                    typ = 'string'
+                elif kind == 9:
+                    if len(payload) < 16:
+                        _fail('formula_bounds')
+                    value = _number(payload[8:16])
+                    at, typ = 16, 'number'
+                else:
+                    if len(payload) < 9:
+                        _fail('formula_bounds')
+                    value = payload[8]
+                    at = 9
+                    if kind == 10:
+                        if value not in (0, 1):
+                            _fail('boolean_value')
+                        value, typ = bool(value), 'boolean'
+                    else:
+                        if value not in _ERRORS:
+                            _fail('error_value')
+                        value, typ = _ERRORS[value], 'error'
+                _formula(payload, at)
+                cell = _cell(row, column, style, 'formula', value, cached_type=typ,
+                             formula='restricted_binary_tokens_not_evaluated',
+                             evaluated=False, cache_freshness='unknown')
+            cells.append(cell)
+        elif kind == 0x94:
+            if state or kind in seen or wrappers or views:
+                _fail('dimension_order')
+            _size(payload, 16)
+            dim = struct.unpack('<IIII', payload)
+            if not (dim[0] <= dim[1] < 1048576 and dim[2] <= dim[3] < 16384):
+                _fail('dimension_bounds')
+            seen.add(kind)
+        elif kind in (0x85, 0x89):
+            if state or wrappers or (kind == 0x85 and views) or (kind == 0x89 and views != [0x85]):
+                _fail('sheet_view_order')
+            if kind == 0x85:
+                _size(payload, 0)
+            elif len(payload) != 30:
+                _fail('sheet_view_size')
+            views.append(kind)
+        elif kind in (0x86, 0x8a):
+            _size(payload, 0)
+            if not views or views.pop() != kind - 1:
+                _fail('sheet_view_order')
+        elif kind == 0x98:
+            if views != [0x85, 0x89] or len(payload) < 36:
+                _fail('selection_record')
+            ctx.ignored.add(kind)
+        elif kind in (0x186, 0x187):
+            _size(payload, 0)
+            if state or views or wrappers or colinfos != (kind == 0x187):
+                _fail('column_info_order')
+            colinfos = kind == 0x186
+        elif kind == 0x3c:
+            _size(payload, 18)
+            if not colinfos:
+                _fail('column_info_order')
+            first, last = struct.unpack_from('<II', payload)
+            if not first <= last < 16384 or _u32(payload, 12) >= xf_count:
+                _fail('column_info_bounds')
+            ctx.ignored.add(kind)
+        elif kind in (0x93, 0x1e5, 0x415, 0x400, 0x217, 0x1dd, 0x1dc):
+            if kind == 0x400:
+                _size(payload, 2)
+                if state != 1 or not wrappers or wrappers[-1] != 0x25:
+                    _fail('row_descent_order')
+            else:
+                if kind in seen:
+                    _fail('duplicate_sheet_record')
+                seen.add(kind)
+                if kind in (0x93, 0x1e5, 0x415) and state:
+                    _fail('sheet_record_order')
+                if kind in (0x217, 0x1dd, 0x1dc) and state != 2:
+                    _fail('sheet_record_order')
+                if kind == 0x93:
+                    if len(payload) < 23 or payload[0] & 0x10:
+                        _fail('dialog_or_sheet_properties')
+                    _, at = _wide(payload, 19, maximum=255)
+                    if at != len(payload):
+                        _fail('sheet_properties')
+                elif kind == 0x1e5:
+                    _size(payload, 12)
+                elif kind == 0x415:
+                    _size(payload, 2)
+                    if not wrappers or wrappers[-1] != 0x25:
+                        _fail('sheet_format_extension')
+                elif kind == 0x217:
+                    _size(payload, 66)
+                elif kind == 0x1dd:
+                    _size(payload, 2)
+                elif kind == 0x1dc:
+                    _size(payload, 48)
+            ctx.ignored.add(kind)
+        else:
+            _fail('worksheet_record_unsupported')
+    if state != 2 or wrappers or views or colinfos:
+        _fail('worksheet_incomplete')
+    return cells, anchors
+
+
+def _index(data, anchors, ctx):
+    records = list(_records(data, ctx))
+    if not records or records[-1][1:] != (0x115, b''):
+        _fail('index_stream')
+    block = None
+    indexed = set()
+    last_end = 0
+    for _, kind, payload in records[:-1]:
+        if kind == 0x2a:
+            if len(payload) < 20:
+                _fail('index_block')
+            first, end = struct.unpack_from('<II', payload)
+            if not last_end <= first < end <= min(first + 32, 1048576):
+                _fail('index_block_bounds')
+            _size(payload, 16 + ((end - first + 32) // 32) * 4)
+            block = (first, end)
+            last_end = end
+        elif kind == 0x28:
+            if block is None or len(payload) < 12:
+                _fail('index_row_order')
+            mask = _u32(payload)
+            base = struct.unpack_from('<Q', payload, 4)[0]
+            count = mask.bit_count()
+            if not mask or mask >> (block[1] - block[0]) or len(payload) < 12 + 2 * count:
+                _fail('index_mask')
+            masks = struct.unpack_from('<' + 'H' * count, payload, 12)
+            if any(not m for m in masks):
+                _fail('index_mask')
+            n = sum(m.bit_count() for m in masks)
+            _size(payload, 12 + 2 * count + 4 * n)
+            at = 12 + 2 * count
+            mi = 0
+            for r in range(32):
+                if not mask & (1 << r):
+                    continue
+                cmask = masks[mi]
+                mi += 1
+                for segment in range(16):
+                    if not cmask & (1 << segment):
+                        continue
+                    offset = base + _u32(payload, at)
+                    at += 4
+                    value = anchors.get(offset)
+                    if value is None or value[0] != block[0] + r or value[1] // 1024 != segment or not value[2] or offset in indexed:
+                        _fail('index_offset')
+                    indexed.add(offset)
+            block = None
+        else:
+            _fail('index_record_unsupported')
+    if indexed != {offset for offset, value in anchors.items() if value[2]}:
+        _fail('index_coverage')
+
+
+def _extract(data, ctx):
+    package = _Package(data, ctx)
+    roots = package.relationships('', {
+        OD_REL + 'officeDocument':'workbook', PKG_REL + 'metadata/core-properties':'core',
+        OD_REL + 'extended-properties':'app'})
+    for role in ('core', 'app'):
+        if sum(r == role for r, _ in roots.values()) > 1:
+            _fail('duplicate_part_role')
+    books = [part for role, part in roots.values() if role == 'workbook']
+    if len(books) != 1:
+        _fail('workbook_relationship')
+    book = books[0]
+    rels = package.relationships(book, {OD_REL + 'worksheet':'worksheet',
+        OD_REL + 'sharedStrings':'strings', OD_REL + 'styles':'styles', OD_REL + 'theme':'theme'})
+    unique = {}
+    for role, part in rels.values():
+        if role != 'worksheet':
+            if role in unique:
+                _fail('duplicate_part_role')
+            unique[role] = part
+    sheets, date1904 = _book(package.parts[book], rels, ctx)
+    style_counts = _styles(package.parts[unique['styles']], ctx) if 'styles' in unique else {'xf':1, 'font':1}
+    xf_count = style_counts['xf']
+    strings, total = _strings(package.parts[unique['strings']], ctx, style_counts['font']) if 'strings' in unique else ([], 0)
+    parsed = []
+    for sheet in sheets:
+        ctx.check()
+        cells, anchors = _sheet(package.parts[sheet['part']], strings, xf_count, ctx)
+        sheetrels = package.relationships(sheet['part'], {MS_REL:'index'})
+        if len(sheetrels) > 1:
+            _fail('duplicate_index')
+        for _, indexpart in sheetrels.values():
+            _index(package.parts[indexpart], anchors, ctx)
+        parsed.append(cells)
+    if ctx.string_refs != total:
+        _fail('sst_reference_count')
+    # XML metadata is inert but still syntax/bounds checked. No XML part is
+    # allowed to carry another relationship graph or a disguised extra part.
+    for role, part in list(roots.values()) + list(rels.values()):
+        if role in ('core', 'app', 'theme'):
+            root = _xml(package.parts[part])
+            expected = {'core':'{http://schemas.openxmlformats.org/package/2006/metadata/core-properties}coreProperties',
+                        'app':'{http://schemas.openxmlformats.org/officeDocument/2006/extended-properties}Properties',
+                        'theme':'{http://schemas.openxmlformats.org/drawingml/2006/main}theme'}[role]
+            if root.tag != expected:
+                _fail('metadata_root')
+    package.finish()
+    metadata = {
+        'format':'xlsb', 'native_type':'OPC/BIFF12',
+        'coverage':'stored_cell_values_and_formula_caches_only',
+        'source_sha256':hashlib.sha256(data).hexdigest(), 'source_bytes':len(data),
+        'formula_evaluation':False, 'formulas_evaluated':False,
+        'formula_cache_freshness':'unknown',
+        'formula_profile':'local arithmetic, literals, references and optimized SUM only; other tokens refused',
+        'security_scope':'external relationships, unknown parts/records and non-profile formula tokens refused; recognized inert layout/style payloads not semantically validated',
+        'date_system':'1904' if date1904 else '1900',
+        'date_display':'not_interpreted; numeric_serials_retained',
+        'sheets':[dict(index=i + 1, name=s['name'], visibility=s['visibility'], cells=len(parsed[i]))
+                  for i, s in enumerate(sheets)],
+        'cell_records':{'included':ctx.cells, 'truncated':False, 'limit':MAX_CELLS},
+        'limits':{'input_bytes':MAX_INPUT, 'expanded_bytes':MAX_EXPANDED, 'parts':MAX_PARTS,
+                  'records':MAX_RECORDS, 'sheets':MAX_SHEETS, 'cells':MAX_CELLS,
+                  'strings':MAX_STRINGS, 'rows_per_sheet':MAX_ROWS, 'columns':16384},
+        'omissions':['formula_expressions', 'styles_and_number_formats', 'visual_layout',
+                     'row_column_visibility', 'rich_string_formatting', 'phonetic_annotations', 'document_properties', 'theme'],
+        'ignored_structural_record_types':[f'{k:04x}' for k in sorted(ctx.ignored)],
+    }
+    lines = [json.dumps({'xlsb_workbook':metadata}, ensure_ascii=True, separators=(',', ':'))]
+    size = len(lines[0])
+    for i, sheet in enumerate(sheets):
+        ctx.check()
+        for cell in parsed[i]:
+            line = json.dumps({'xlsb_cell':dict(sheet=i + 1, sheet_name=sheet['name'],
+                sheet_visibility=sheet['visibility'], **cell)}, ensure_ascii=True, separators=(',', ':'))
+            size += len(line) + 1
+            if size > MAX_TEXT:
+                _fail('extracted_text_limit')
+            lines.append(line)
+    return _Text('\n'.join(lines), metadata)
+
+
+def extract_xlsb(data: bytes, *, checkpoint=None) -> str:
+    """Extract a bounded inert XLSB; preserve exceptions from cancellation checks."""
+    if not isinstance(data, bytes) or not data or len(data) > MAX_INPUT:
+        _fail('input_limit')
+    ctx = _Context(checkpoint)
+    ctx.check()
+    # All parser failures are raised as fixed codes at the point of detection.
+    # In particular no broad exception handler may swallow checkpoint failures.
+    return _extract(data, ctx)
