+                JOIN messages t ON t.id = ? AND t.session_id = u.session_id
+            WHERE u.id = ? AND u.session_id = ? AND u.platform_message_id = ?
+                AND u.role = 'user' AND a.role = 'assistant' AND t.role = 'tool'
+                AND u.active = 1 AND a.active = 1 AND t.active = 1
+                AND u.compacted = 0 AND a.compacted = 0 AND t.compacted = 0
+                AND (t.effect_disposition IS NULL OR t.effect_disposition != 'none')
+                AND NOT EXISTS (SELECT 1 FROM messages newer WHERE newer.session_id = u.session_id
+                                AND newer.role = 'user' AND newer.id > u.id)
+                AND NOT EXISTS (SELECT 1 FROM messages clone WHERE clone.session_id = a.session_id
+                                AND clone.active = 1 AND clone.message_uid = a.message_uid AND clone.id != a.id)
+                AND NOT EXISTS (SELECT 1 FROM messages clone WHERE clone.session_id = t.session_id
+                                AND clone.active = 1 AND clone.message_uid = t.message_uid AND clone.id != t.id)
+                AND NOT EXISTS (SELECT 1 FROM messages clone WHERE clone.session_id = t.session_id
+                                AND clone.active = 1 AND clone.role = 'tool'
+                                AND clone.tool_call_uid = t.tool_call_uid AND clone.id != t.id)
