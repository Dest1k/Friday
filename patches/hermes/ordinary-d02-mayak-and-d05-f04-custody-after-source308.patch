+
+def retired_effect(run, phase, work, claim_sha):
+    return (run in RETIRED_RUNS or phase in RETIRED_PHASES or claim_sha == RETIRED_CLAIM
+            or Path(work).is_relative_to(RETIRED_ROOT))
+
+
+def digest(value):
+    return sha256((json.dumps(value, sort_keys=True, ensure_ascii=True, allow_nan=False) + '\n').encode()).hexdigest()
+
+
+def need(ok, code):
+    if not ok:
+        raise ValueError(code)
+
+
+def check_origin(context, reader):
+    origin_ref = context['origin']
+    need(origin_ref['sha256'] == ORIGIN_SHA, 'D02_MAYAK_FORGED_SOURCE_ORIGIN')
+    origin = reader(origin_ref)
+    need(digest(origin) == ORIGIN_SHA, 'D02_MAYAK_FORGED_SOURCE_ORIGIN')
+    need(origin['scenario']['sha256'] == PHASE_SHA and origin['fixture']['sha256'] == FIXTURE_SHA,
+         'D02_MAYAK_WRONG_SOURCE_PHASE')
+    return origin
+
+
+def check_claim_context(reference, *, driver_ref, authority, contract, scenario, run, work,
+                        read, gateway, options_ref, options, now=None, clock_exists=False):
+    scope = contract['scope']
+    installation = scope['installation']
+    package = Path(driver_ref['path']).parent
+    need(reference == authority.get('d02_successor_context') == scope.get('d02_successor_context')
+         and Path(reference['path']) == package / 'd02-source-context.json',
+         'D02_MAYAK_EXACT_PROTECTED_CONTEXT_REQUIRED')
+    context = read(reference)
+    need(context['schema'] == SCHEMA and context['run_id'] == run == RUN
+         and context['scenario_sha256'] == digest(scenario) == PHASE_SHA
+         and scenario['steps'][0]['input']['sha256'] == FIXTURE_SHA
+         and context['workdir'] == str(work), 'D02_MAYAK_WRONG_SOURCE_PHASE')
+    need(Path(context['origin']['path']) == package / 'source-origin.json',
+         'D02_MAYAK_WRONG_ORIGIN_PATH')
+    check_origin(context, read)
+    boot = authority['boot_id']
+    auth_gateway = {key: authority['gateway'][key] for key in ('pid', 'start_time')}
+    owner_ref = installation['native_owner_observation']
+    owner = read(owner_ref)
+    receipt = installation['metadata_sha256']['receipt']
+    need(context['owner'] == owner_ref
+         and context['gateway'] == installation['gateway'] == dict(auth_gateway, boot_id=boot) == gateway
+         and context['invocation_id'] == owner['invocation_id']
+         and owner['identity'] == gateway
+         and owner['schema'] == 'frw.Root.D02.native-gateway-start-observation.v1'
+         and owner['transport'] == 'unix-peer-credentials'
+         and context['receipt_sha256'] == owner['identify']['friday_owner']['source']['receipt'] == receipt
+         and context['scope_sha256'] == scope['scope_sha256']
+         and context['session_id'] == scope['selected_session_id']
+         and context['cursor'] == contract['cursor']
+         and context['history_sha256'] == digest(authority['history'])
+         and authority.get('ordered_predecessors', {}) == {}, 'D02_MAYAK_STALE_SOURCE_CONTEXT')
+    need(context['created_at'] == authority['created_at'] and context['expires_at'] == authority['expires_at'],
+         'D02_MAYAK_STALE_SOURCE_CONTEXT')
+    start, end = context['created_at'], context['expires_at']
+    need(all(type(value) in (int, float) and math.isfinite(value) for value in (start, end))
+         and 0 < end - start <= 600, 'D02_MAYAK_STALE_SOURCE_CONTEXT')
+    if now is not None:
+        need(not clock_exists, 'D02_MAYAK_EXISTING_FIRST_CLOCK')
+        need(start <= now < end, 'D02_MAYAK_STALE_SOURCE_CONTEXT')
+    check_protected_projection(context, scope, scenario, read=read, options_ref=options_ref, options=options)
+    return context
+
+
+def check_protected_projection(context, scope, scenario, *, read, options_ref, options):
+    reference = context['projection']
+    package = Path(scope['d02_successor_context']['path']).parent
+    need(Path(reference['path']) == package / 'd02-scope-projection.json'
+         and reference['sha256'] == scope['scope_sha256'],
+         'D02_MAYAK_EXACT_RIGHTS_PROJECTION_REQUIRED')
+    need(context['receiver_options'] == options_ref
+         and Path(options_ref['path']).parent == package
+         and options_ref['sha256'] == digest(options),
+         'D02_MAYAK_EXACT_CONTEXT_OPTIONS_REQUIRED')
+    projected = read(reference)
+    check_projection(context, scope, scenario, projected)
+    user, account = str(scenario['tester_id']), str(scenario['peer_id'])
+    rights, pins = projected['rights'], options['rights']
+    principal = dict(platform='telegram', transport_profile='default', account_id=account, user_id=user,
+                     enabled=True, role='user', generation=rights['generation'])
+    root_config, profile_config = projected['config_sha256']
+    need(options['schema'] == OPTIONS_SCHEMA and options['profile'] == 'telegram-bot-' + user
+         and options['principal'] == principal and type(principal['generation']) is int
+         and principal['generation'] > 0 and digest(principal) == rights['access_row_sha256']
+         and pins['source_receipt'] == context['receipt_sha256']
+         and pins['root_config'] == root_config and pins['profile_config'] == profile_config
+         and pins['isolation_binding_sha256'] == rights['binding_sha256']
+         and pins['scope_marker'] == rights['scope_marker_sha256']
+         and pins['active_pairing'] == rights['active_pairing'],
+         'D02_MAYAK_OPTIONS_RIGHTS_PROJECTION_MISMATCH')
+    # Store inode/digest CAS and fresh permission checks remain receiver-owned.
+    return projected
+
+
+def check_projection(context, scope, scenario, observed):
+    need(context['schema'] == SCHEMA and context['run_id'] == RUN
+         and context['scenario_sha256'] == digest(scenario) == observed['phase_sha256'] == PHASE_SHA
+         and observed['source_sha256'] == FIXTURE_SHA
+         and context['scope_sha256'] == scope['scope_sha256'] == digest(observed)
+         and context['gateway'] == observed['native_identity']
+         and context['receipt_sha256'] == observed['metadata_sha256']['receipt']
+         and context['session_id'] == observed['session_id'] == scope['selected_session_id']
+         and context['rights_sha256'] == digest(observed['rights']),
+         'D02_MAYAK_STALE_SOURCE_CONTEXT')
+    return True
