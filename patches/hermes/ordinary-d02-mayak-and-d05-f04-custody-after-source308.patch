+"""Process-local evidence from one selected D05 worker and its canonical commits."""
+
+import asyncio
+from contextvars import ContextVar
+from copy import deepcopy
+from dataclasses import dataclass
+import json
+import math
+from pathlib import Path, PurePosixPath
+import re
+from threading import Lock, get_ident
+import time
+
+SCENARIO_SHA256 = "2a5c503fbe0505cf617f15ddb3c935104b96994173234ab16ea5d948c414c449"
+SOURCE_SHA256 = "724cb13c4fb6a1f3c740e521940e38dbad80b3dabf82ab19568bb86226b981a7"
+SOURCE_BYTES = 5212
+SOURCE_NAME = "D05-Linden-Deadline.docx"
+SOURCE_MIME = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
+OUTPUT_NAME = "D05-Linden-Deadline-Edited.docx"
+_READ_FIELDS = (
+    "success", "path", "scope", "format", "extracted_document", "source_sha256",
+    "total_lines", "partial", "next_offset", "next_char_offset",
+)
+_WRITE_FIELDS = (
+    "success", "format", "path", "scope", "create_only", "verified", "bytes_written", "sha256",
+    "source", "source_sha256", "source_unchanged", "paragraph", "replacements",
+    "unchanged_parts_preserved",
+)
+_TURN = ContextVar("ordinary_d05_selected_turn", default=None)
+
+
+@dataclass(frozen=True, slots=True)
+class WorkerBinding:
+    """Created only by the protected receiver after exact original SDK/publication checks."""
+
+    scenario_sha256: str
+    claim_sha256: str
+    raw_message: object
+    sdk: dict
+    published: object
+    check_publication: object
+    started: float
+    cutoff: float
+    deadline: float
+
+
+def _require(value):
+    if not value:
+        raise ValueError("d05_owned_canonical_turn_unavailable")
+
+
+def _object(raw):
+    def distinct(pairs):
+        result = dict(pairs)
+        _require(len(result) == len(pairs))
+        return result
+
+    _require(type(raw) is str and 0 < len(raw) <= 100000)
+    value = json.loads(raw, object_pairs_hook=distinct)
+    _require(type(value) is dict)
+    return value
+
+
+def _relative_docx(value):
+    _require(type(value) is str and 0 < len(value) <= 4096
+             and all(ord(char) >= 32 and char not in "\\\x7f" for char in value))
+    path = PurePosixPath(value)
+    _require(not path.is_absolute() and path.as_posix() == value and path.name.endswith(".docx")
+             and path.parts and all(not part.startswith(".") for part in path.parts))
+    return value
+
+
+def _uid(value):
+    return type(value) is str and 0 < len(value) <= 256 and all(33 <= ord(c) <= 126 for c in value)
+
+
+def select_worker(evidence, binding, runner, event, source, identity, session_id, key, generation):
+    """Select the original native writer that already owns the exact ingress and gateway lease."""
+    from gateway.run_attachment_presentation import _scope
+    from hermes_cli.friday_user_scope import current
+
+    update = evidence.select(event, source, identity, key)
+    _require(update is not None and type(generation) is int and generation > 0)
+    record = evidence._built[update]
+    state = runner._peek_session_state(key)
+    _require(state is not None and record.writer_task is not None and not record.settled
+             and record.writer_task() is asyncio.current_task() and update in evidence._commits
+             and runner is evidence.adapter.gateway_runner
+             and runner.adapters.get(evidence.adapter.platform) is evidence.adapter
+             and getattr(record, "_d05_selected_worker", None) is None
+             and getattr(evidence, "_xlsx_input", None) is None)
+    pin = binding(event, update)
+    _require(type(pin) is WorkerBinding and pin.scenario_sha256 == SCENARIO_SHA256
+             and pin.claim_sha256 == evidence.claim.claim_sha256 and pin.raw_message is event.raw_message
+             and type(pin.sdk) is dict and pin.sdk.get("update_id") == str(update)
+             and pin.sdk.get("native_message_id") == str(event.message_id)
+             and pin.sdk.get("actor_id") == str(evidence.claim.user_id)
+             and pin.sdk.get("bot_id") == str(evidence.scope["bot_id"])
+             and (pin.sdk.get("file_name"), pin.sdk.get("mime_type"), pin.sdk.get("declared_bytes"))
+             == (SOURCE_NAME, SOURCE_MIME, SOURCE_BYTES)
+             and all(type(value) in (float, int) and math.isfinite(value)
+                     for value in (pin.started, pin.cutoff, pin.deadline))
+             and pin.started <= time.time() <= pin.cutoff
+             and time.monotonic() < min(pin.deadline, evidence.claim.expires_monotonic))
+    cap = current(required=True)
+    _require(cap is getattr(source, "_friday_user_scope", None)
+             and cap.principal == ("telegram", evidence.scope["transport_profile"],
+                                   pin.sdk["bot_id"], pin.sdk["actor_id"])
+             and str(cap.home) == evidence.scope["runtime_home"]
+             and str(cap.authorization_home) == evidence.scope["authorization_home"]
+             and cap.profile == evidence.scope["runtime_profile"])
+    _require(pin.check_publication(event) == pin.published
+             and (pin.published.sha256, pin.published.size_bytes) == (SOURCE_SHA256, SOURCE_BYTES)
+             and pin.published.source_identity)
+    relative = pin.published.path.relative_to(cap.home / "workspace").as_posix()
+    _require(re.fullmatch(r"received/telegram_[0-9a-f]{64}_[A-Za-z0-9_.-]{1,80}\.docx", relative))
+    upload = {
+        "schema": "friday.ordinary-direct-upload.v1", "scope": _scope(cap),
+        "source_message_id": pin.sdk["native_message_id"],
+        "file": {"path": relative, "sha256": SOURCE_SHA256, "size_bytes": SOURCE_BYTES,
+                 "file_name": SOURCE_NAME},
+    }
+    token = state.turn.lease_tokens.get(generation)
+    turn = _SelectedTurn(evidence, record, runner, event, session_id, key, generation, token, cap,
+                         pin, upload)
+    _require(turn._current())
+    record._d05_selected_worker = turn
+    return turn
+
+
+class _SelectedTurn:
+    def __init__(self, evidence, record, runner, event, sid, key, generation, token, cap, pin, upload):
+        self.evidence, self.record, self.runner, self.event = evidence, record, runner, event
+        self.sid, self.key, self.generation, self.token, self.cap = sid, key, generation, token, cap
+        self.pin, self.upload = pin, upload
+        self.lock = Lock()
+        self.worker_thread = self.lease = self.turn_id = self.user = None
+        self.invalid = self.closed = self.completed = False
+        self.answer_response = self.answer_identity = self.delivery_writer = None
