+"""Exact phase-one source context shared by the D02 caller and receiver."""
+
+from hashlib import sha256
+import json
+import math
+from pathlib import Path
+
+ORIGIN_SHA = '3c801861fd6c6d22623a15680d7ec1af2c399efae3a645073bfa45162704ffff'
+PHASE_SHA = '8a567aeecec62ffe04a7dcec95c030346838a8fe710f16a695737d3f5b053bc4'
+FIXTURE_SHA = 'c5b490ccc4d56ca13279f5c3cc55cbf0f72283b60f5612af75987cb1f2b8e8f3'
+RUN = 'root-d02-mayak-structured-phase1-20261123'
+SCHEMA = 'frw.Root.D02.mayak-phase1-source-context.v2'
+RECEIVER_ROLE = 'gateway/d02_mayak_source.py'
+OPTIONS_SCHEMA = 'frw.Root.D02.receiver-options.v1'
+RETIRED_PHASES = frozenset({
+    '088d47d6a8efbf63068bb8fff13c69af05478a20156960811ac1d170db46c4cf',
+    'bab05e12b1465b984bf58acfd8b25507162b31c135dbb3623623951a06b10a05',
+})
+RETIRED_RUNS = frozenset(('root-d02-alt-odt-01-v3-20261121', 'root-d02-alt-odt-02-v3-20261121'))
+RETIRED_ROOT = Path('/home/jericho/.cache/FRW-ASTRA-D02-DISTINCT-R4-OPERATIONS-20261121')
+RETIRED_CLAIM = '31808317666cf399ff2ab0994112c013fee0d05c713a5695a943921a0f1d6bd7'
