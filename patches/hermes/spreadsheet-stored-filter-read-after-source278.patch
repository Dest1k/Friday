+def _table_filter_info(table, node):
+    name, area = table.get('displayName'), table.get('ref', '')
+    if not name:
+        return None
+
+    def corners(ref):
+        first, separator, last = ref.partition(':')
+        return address(first), address(last if separator else first)
+
+    try:
+        start, (bottom, right) = corners(area)
+        filter_start, (filter_bottom, filter_right) = corners(node.get('ref', ''))
+    except ODSError:
+        return None
+    if (filter_start != start or filter_right != right or right < start[1]
+            or not start[0] <= filter_bottom <= bottom):
+        return None
+    if any(child.tag not in (q(S, 'filterColumn'), q(S, 'sortState')) for child in node):
+        return None
+    if any(not child.tag.startswith(f'{{{S}}}') for child in node.iter()):
+        return None
+    columns = set()
+    for child in node.findall(q(S, 'filterColumn')):
+        col = child.get('colId', '')
+        if re.fullmatch(r'[0-9]{1,5}', col) is None:
+            return None
+        index = int(col)
+        if index > right - start[1] or index in columns:
+            return None
+        columns.add(index)
+    return {'name': name, 'range': area}
+
+
+def _xlsx_table_filters(book, checkpoint):
+    """Use declared sheet attachments and already validated internal package parts."""
+    link_counts = Counter(target for rows in book.relationships.values()
+                          for kind, target in rows.values() if kind == R+'/table')
+    name_counts = Counter(book.xml[part].get('displayName', '').casefold()
+                          for part in book.table_parts if part in book.xml)
+    filters = {}
+    gap = 'table_filter_declarations_incomplete'
+    sheets = book.xml['xl/workbook.xml'].find(q(S, 'sheets'))
+    for sheet in sheets:
+        if sheet.get('state', 'visible') in ('hidden', 'veryHidden'):
+            continue
+        tick(checkpoint)
+        part = book.sheet_parts[sheet.get(q(R, 'id'))]
+        groups = book.xml[part].findall(q(S, 'tableParts'))
+        if not groups:
+            continue
+        if len(groups) != 1:
+            book.unsupported.add(gap)
+            continue
+        group = groups[0]
+        ids = [node.get(q(R, 'id')) for node in group.findall(q(S, 'tablePart'))]
+        size = group.get('count', str(len(ids)))
+        if (len(ids) != len(group) or re.fullmatch(r'[0-9]{1,5}', size) is None
+                or int(size) != len(ids)):
+            book.unsupported.add(gap)
+            continue
+        for rid, count in Counter(ids).items():
+            tick(checkpoint)
+            kind, target = book.relationships.get(part, {}).get(rid, (None, None))
+            table = book.xml.get(target)
+            if (count != 1 or kind != R+'/table' or link_counts[target] != 1
+                    or target not in book.table_parts or table is None or table.tag != q(S, 'table')):
+                book.unsupported.add(gap)
+                continue
+            declared = table.findall(q(S, 'autoFilter'))
+            if len(declared) > 1:
+                book.unsupported.add(gap)
+            elif declared and len(declared[0]):
+                info = _table_filter_info(table, declared[0])
+                if info is None or name_counts[info['name'].casefold()] != 1:
+                    book.unsupported.add(gap)
+                else:
+                    filters.setdefault(part, []).append((declared[0], info))
+    return filters
 
 
