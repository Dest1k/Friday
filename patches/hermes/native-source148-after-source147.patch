+"""Bounded HEIF YUV inspection and explicit RGB derivatives in a sandbox.
+
+No codec is loaded in the caller. Only direct 8-bit HEVC items are supported;
+container transforms, ICC, auxiliary/derived items and external references fail.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import selectors
+import shutil
+import stat
+import subprocess
+import tempfile
+import threading
+import time
+
+from tools.scoped_heif_preflight import inspect_heif_container, HeifPreflightError
+
+MAX_BYTES = 1_000_000
+WALL_SECONDS = 18
+VERSIONS = [4066148, 3934308, 590180]
+_LIBRARIES = ('/usr/lib/x86_64-linux-gnu/libavcodec.so.62',
+              '/usr/lib/x86_64-linux-gnu/libavutil.so.60',
+              '/usr/lib/x86_64-linux-gnu/libswscale.so.9',
+              '/usr/lib/x86_64-linux-gnu/libseccomp.so.2')
+_HEX = re.compile('[0-9a-f]{64}\\Z')
+_CODES = set(('heif_codec_version_unsupported heif_codec_unavailable heif_sandbox_unavailable '
+    'heif_worker_failed heif_resource_limit heif_decode_failed heif_pixel_mismatch '
+    'heif_pixel_mode_unsupported heif_pixel_aspect_unsupported heif_side_data_unsupported heif_color_range_unsupported heif_explicit_color_matrix_required '
+    'heif_color_matrix_mismatch heif_multiple_coded_frames_unsupported image_frame_invalid '
+    'image_crop_invalid image_rotation_invalid image_output_format_unsupported image_output_limit '
+    'image_output_verification_failed image_alpha_not_supported image_transform_failed').split())
+
+
+def _fail(code):
+    from tools.scoped_raster import RasterError
+    raise RasterError(code) from None
+
+
+def _trusted(path):
+    original = Path(path)
+    resolved = original.resolve(strict=True)
+    # All system dependencies and every directory in their resolution are root
+    # controlled. No codec/config/plugin path is taken from the input document.
+    for item in (resolved, *resolved.parents):
+        info = item.stat()
+        if info.st_uid != 0 or info.st_mode & 0o022:
+            _fail('heif_codec_unavailable')
+    if not resolved.is_file() or not resolved.is_relative_to('/usr'):
+        _fail('heif_codec_unavailable')
+
+
+def _argv(work):
+    for path in ('/usr/bin/bwrap', '/usr/bin/python3', '/usr/lib/python3/dist-packages/PIL/__init__.py', *_LIBRARIES):
+        _trusted(path)
+    argv = ['/usr/bin/bwrap', '--unshare-all', '--die-with-parent', '--as-pid-1',
+        '--cap-drop', 'ALL', '--clearenv', '--setenv', 'LANG', 'C.UTF-8',
+        '--setenv', 'LC_ALL', 'C.UTF-8', '--ro-bind', '/usr', '/usr']
+    for name in ('bin', 'sbin', 'lib', 'lib64'):
+        path = Path('/') / name
+        if path.exists():
+            target = path.resolve(strict=True)
+            if not target.is_relative_to('/usr'): _fail('heif_codec_unavailable')
+            argv += ['--symlink', str(target), '/' + name]
+    return argv + ['--proc', '/proc', '--remount-ro', '/proc', '--dir', '/tmp',
+        '--ro-bind', str(work), '/work', '--chdir', '/work', '--remount-ro', '/',
+        '--', '/usr/bin/python3', '-I', '-B', '-S', '/work/scoped_heif_worker.py']
+
+
+def _run(work, payload, checkpoint):
+    from agent.web_call_context import _current, same_web_authority
+    from tools.scoped_pdf_ocr import _Custody
+    call = _current.get()
+    custody = _Custody()
+    lock = call.turn.lock if call is not None else threading.RLock()
+    bound = False
+    deadline = time.monotonic() + WALL_SECONDS
+    output = bytearray()
+    position = 0
+    try:
+        with lock:
+            checkpoint()
+            if call is not None:
+                call.check()
+                if not same_web_authority(call): _fail('heif_authority_changed')
+                deadline = min(deadline, call.deadline())
+                if call.session is not None or call.registry is not None: _fail('heif_custody_busy')
+                call.session = call.registry = custody
+                call.turn.calls.add(custody)
+                bound = True
+            if time.monotonic() >= deadline: _fail('heif_resource_limit')
+            try:
+                custody.process = subprocess.Popen(_argv(work), cwd=work,
+                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                    close_fds=True, start_new_session=True,
+                    env={'PATH':'/usr/bin:/bin', 'LANG':'C.UTF-8'})
+            except OSError: _fail('heif_codec_unavailable')
+        process = custody.process
+        for stream in (process.stdin, process.stdout): os.set_blocking(stream.fileno(),False)
+        with selectors.DefaultSelector() as selector:
+            selector.register(process.stdin, selectors.EVENT_WRITE, 'input')
+            selector.register(process.stdout, selectors.EVENT_READ, 'output')
+            while selector.get_map():
+                checkpoint()
+                if call is not None:
+                    call.check()
+                    if not same_web_authority(call): _fail('heif_authority_changed')
+                remaining = deadline - time.monotonic()
+                if remaining <= 0: _fail('heif_resource_limit')
+                for key, _ in selector.select(min(.05,remaining)):
+                    if key.data == 'input':
+                        try: position += os.write(key.fd,payload[position:position+65536])
+                        except BrokenPipeError: _fail('heif_worker_failed')
+                        if position == len(payload):
+                            selector.unregister(process.stdin); process.stdin.close()
+                    else:
+                        chunk = os.read(key.fd,min(65536,MAX_BYTES+1-len(output)))
+                        if not chunk: selector.unregister(process.stdout)
+                        else:
+                            output.extend(chunk)
+                            if len(output)>MAX_BYTES: _fail('heif_resource_limit')
+        while process.poll() is None:
+            checkpoint()
+            if call is not None:
+                call.check()
+                if not same_web_authority(call): _fail('heif_authority_changed')
+            remaining = deadline-time.monotonic()
+            if remaining <= 0: _fail('heif_resource_limit')
+            try: process.wait(timeout=min(.05,remaining))
+            except subprocess.TimeoutExpired: pass
+        checkpoint()
+        if call is not None:
+            call.check()
+            if not same_web_authority(call): _fail('heif_authority_changed')
+        if process.returncode != 0: _fail('heif_worker_failed')
+        return bytes(output)
+    finally:
+        receipt = custody.stop()
+        if custody.process is not None:
+            for stream in (custody.process.stdin,custody.process.stdout):
+                if stream is not None: stream.close()
+        with lock:
+            if bound and receipt['status']=='QUIESCENT':
+                if call.session is not custody or call.registry is not custody:
+                    receipt={'status':'STOP_UNCONFIRMED'}
+                else:
+                    call.session=call.registry=None
+                    call.turn.calls.discard(custody)
+        if receipt['status']!='QUIESCENT':
+            if call is not None and hasattr(call,'agent'): call.agent._friday_reply_effect_unknown=True
+            _fail('heif_cleanup_unconfirmed')
+
+
+def _registry(rows, expected):
+    wanted = [r for r in expected['items'] if r['role'] != 'thumbnail']
+    if type(rows) is not list or len(rows)!=len(wanted): _fail('heif_worker_failed')
+    for index,(row,item) in enumerate(zip(rows,wanted),1):
+        if (type(row) is not dict or row.get('frame')!=index or row.get('item_id')!=item['item_id']
+            or row.get('width')!=item['width'] or row.get('height')!=item['height']
+            or row.get('stored_width')!=item['width'] or row.get('stored_height')!=item['height']
+            or row.get('role')!=item['role'] or row.get('orientation')!=1
+            or row.get('pixel_mode')!='yuv420p8'
+            or row.get('display_aspect_verified') is not False or not _HEX.fullmatch(str(row.get('pixel_sha256')))
+            or row.get('color_range') not in ('limited','full')): _fail('heif_pixel_mismatch')
+        aspect=row.get('pixel_aspect_ratio')
+        if (type(aspect) is not list or len(aspect)!=2 or any(type(x) is not int or not 0 <= x <= 65535 for x in aspect)
+                or aspect[0] and not aspect[1]
+                or row.get('pixel_geometry_policy')!='stored_sample_grid; pixel_aspect_not_applied'):
+            _fail('heif_pixel_mismatch')
+        for key in ('color_matrix_code','color_primaries_code','color_transfer_code'):
+            if type(row.get(key)) is not int or not 0 <= row[key] <= 255: _fail('heif_worker_failed')
+        planes=row.get('planes')
+        if type(planes) is not list or len(planes)!=3: _fail('heif_pixel_mismatch')
+        for n,plane in enumerate(planes):
+            width=item['width'] if n==0 else (item['width']+1)//2
+            height=item['height'] if n==0 else (item['height']+1)//2
+            if (type(plane) is not dict or plane.get('plane')!=('Y','Cb','Cr')[n]
+                    or plane.get('width')!=width or plane.get('height')!=height
+                    or not _HEX.fullmatch(str(plane.get('pixel_sha256')))): _fail('heif_pixel_mismatch')
+
+
+def _response(raw, expected, spec):
+    def pairs(items):
+        result={}
+        for key,value in items:
+            if key in result: _fail('heif_worker_failed')
+            result[key]=value
+        return result
+    try:
+        if not 4 < len(raw) <= MAX_BYTES: _fail('heif_worker_failed')
+        n=int.from_bytes(raw[:4],'big')
+        if not 1 <= n <= 65536 or n > len(raw)-4: _fail('heif_worker_failed')
+        meta=json.loads(raw[4:4+n],object_pairs_hook=pairs); encoded=raw[4+n:]
+        if type(meta) is not dict: _fail('heif_worker_failed')
+        if set(meta)=={'error'}: _fail(meta['error'] if meta['error'] in _CODES else 'heif_worker_failed')
+        if 'frame' not in spec:
+            if encoded or meta.get('source_sha256')!=expected['source_sha256'] or meta.get('decoder_versions')!=VERSIONS:
