+"""Recognize a bounded explicit Windows-1251 declaration without rendering HTML."""
+from dataclasses import dataclass
+from html.parser import HTMLParser
+import re
+
+from codecs import BOM_UTF8
+
+_ALIASES = frozenset({'windows-1251', 'cp1251', 'x-cp1251'})
+_MAX_HEAD_BYTES = 65536
+_DECLARATION_LIMIT = 1024
+_ASCII_SPACE = ' \t\r\n\f'
+_DIRECT = re.compile(
+    r'''<meta[ \t\r\n\f]+charset[ \t\r\n\f]*=[ \t\r\n\f]*'''
+    r'''(?:"([a-z0-9._:-]+)"|'([a-z0-9._:-]+)'|([a-z0-9._:-]+))[ \t\r\n\f]*/?>''',
+    re.ASCII | re.IGNORECASE,
+)
+_ALTERNATE = re.compile(r"""(?:^|;)\s*charset\s*=\s*["']?([a-z0-9._:-]+)""",
+                        re.ASCII | re.IGNORECASE)
+_INERT = frozenset({'title', 'script', 'style', 'template', 'object', 'noscript'})
+_OPAQUE = frozenset({'title', 'script', 'style', 'noscript'})
+_VOID = frozenset({'area','base','br','col','embed','hr','img','input','link',
+                   'meta','param','source','track','wbr'})
+
+
+class HtmlEncodingError(ValueError):
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+@dataclass(frozen=True)
+class LegacyEncoding:
+    codec: str
+    label: str
+    meta_tag: bytes
+    offset: int
+
+
+class _HeadFinished(Exception):
+    pass
+
+
+class _HeadParser(HTMLParser):
+    def __init__(self, source, initial_offset):
+        super().__init__(convert_charrefs=False)
+        self.line_starts = [initial_offset]
+        self.line_starts.extend(initial_offset + i + 1 for i, ch in enumerate(source) if ch == '\n')
+        self.expected = 'html'
+        self.opaque = []
+        self.closed = False
+        self.claims = 0
+        self.saw_legacy = False
+        self.declaration = None
+
+    def _start(self, tag, attrs, self_closing):
+        if self.expected is not None:
+            if tag != self.expected or self_closing:
+                raise _HeadFinished()
+            self.expected = 'head' if tag == 'html' else None
+            return
+        if self.opaque:
+            if self.opaque[-1] in _OPAQUE:
+                return
+            if not self_closing and tag not in _VOID:
+                if len(self.opaque) >= 64:
+                    raise _HeadFinished()
+                self.opaque.append(tag)
+            return
+        if tag in _INERT and not self_closing:
+            self.opaque.append(tag)
+        elif tag == 'meta':
+            self._meta(attrs)
+        elif tag not in ('base', 'link'):
+            raise _HeadFinished()
+
+    def handle_starttag(self, tag, attrs):
+        self._start(tag, attrs, False)
+
+    def handle_startendtag(self, tag, attrs):
+        self._start(tag, attrs, True)
+
+    def handle_endtag(self, tag):
+        if self.opaque:
+            top = self.opaque[-1]
+            if top == tag:
+                self.opaque.pop()
+            elif top not in _OPAQUE:
+                raise _HeadFinished()
+            return
+        if self.expected is None and tag == 'head':
+            self.closed = True
+        raise _HeadFinished()
+
+    def handle_data(self, data):
+        if not self.opaque and data.strip(_ASCII_SPACE):
+            raise _HeadFinished()
+
+    def handle_entityref(self, name):
+        if not self.opaque:
+            raise _HeadFinished()
+
+    handle_charref = handle_entityref
+
+    def _meta(self, attrs):
+        direct = [value or '' for key, value in attrs if key == 'charset']
+        equiv = {value.casefold() for key, value in attrs if key == 'http-equiv' and value}
+        alternate = []
+        if 'content-type' in equiv:
+            for key, value in attrs:
+                if key == 'content' and value:
+                    alternate.extend(_ALTERNATE.findall(value))
+        claims = direct + alternate
+        self.claims += len(claims)
+        self.saw_legacy |= any(value.strip(_ASCII_SPACE).casefold() in _ALIASES for value in claims)
+        raw = self.get_starttag_text()
+        match = _DIRECT.fullmatch(raw) if raw else None
+        if match is None:
+            return
+        label = next(value for value in match.groups() if value is not None)
+        if label.casefold() in _ALIASES:
+            line, column = self.getpos()
+            self.declaration = LegacyEncoding('cp1251', label, raw.encode('latin-1'),
+                                               self.line_starts[line - 1] + column)
+
+
+def explicit_meta_charset(data):
+    """Return one literal declaration within the prefix, or retain the UTF-8 lane."""
+    if type(data) is not bytes or len(data) > 1000000:
+        raise HtmlEncodingError('invalid_html_encoding')
+    if not data:
+        return None
+    bom = len(BOM_UTF8) if data.startswith(BOM_UTF8) else 0
+    source = data[bom:_MAX_HEAD_BYTES].decode('latin-1')
+    parser = _HeadParser(source, bom)
+    try:
+        parser.feed(source)
+        parser.close()
+    except _HeadFinished:
+        pass
+    if not parser.saw_legacy:
+        return None
+    declaration = parser.declaration
+    if bom or parser.claims != 1:
+        raise HtmlEncodingError('conflicting_html_encoding')
+    if (b'\x00' in data or not parser.closed or declaration is None
+            or declaration.offset + len(declaration.meta_tag) > _DECLARATION_LIMIT):
+        raise HtmlEncodingError('invalid_html_encoding')
+    return declaration
+
+
+def read_dispatch(data, suffix):
+    """Select legacy only for a supported declaration; keep strict UTF-8 otherwise."""
+    if suffix not in ('.html', '.htm'):
+        return 'utf8', None
+    try:
+        legacy = explicit_meta_charset(data)
+    except HtmlEncodingError:
+        return 'legacy_error', None
+    return ('legacy', legacy) if legacy is not None else ('utf8', None)
+
+
+def decode_explicit_html(data):
+    legacy = explicit_meta_charset(data)
+    if legacy is None:
+        return None
+    try:
+        return data.decode(legacy.codec)
+    except UnicodeError:
+        raise HtmlEncodingError('invalid_html_encoding') from None
