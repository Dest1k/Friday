+VCF_PHOTO_PROPERTY_PREFIX = 'PHOTO;VALUE=URI;MEDIATYPE=image/png:'
+VCF_PHOTO_URI_PREFIX = 'data:image/png;base64,'
+VCF_PHOTO_MAX_URI = MAX_LOGICAL_LINE_BYTES - len(VCF_PHOTO_PROPERTY_PREFIX)
+VCF_PHOTO_MAX_DECODED = (VCF_PHOTO_MAX_URI - len(VCF_PHOTO_URI_PREFIX)) // 4 * 3
+VCF_PHOTO_MAX_CHUNKS = 64
+VCF_PHOTO_MAX_DIMENSION = 4096
+VCF_PHOTO_MAX_PIXELS = 4_194_304
+VCF_PHOTO_SIGNATURE = b'\x89PNG\r\n\x1a\n'
+VCF_PHOTO_GUIDANCE = (
+    f'Optional photo is one string with the {VCF_PHOTO_URI_PREFIX} prefix and canonical '
+    f'base64. URI <= {VCF_PHOTO_MAX_URI} ASCII bytes including its prefix, decoded PNG '
+    f'1..{VCF_PHOTO_MAX_DECODED} bytes. A static noninterlaced PNG with 8/16-bit samples, colour '
+    f'types 0/2/4/6 and dimensions 1..{VCF_PHOTO_MAX_DIMENSION} each, '
+    f'<= {VCF_PHOTO_MAX_PIXELS} pixels. At most {VCF_PHOTO_MAX_CHUNKS} chunks: '
+    'IHDR, consecutive IDAT, IEND, and optional uncompressed tEXt before or after IDAT. '
+    'All chunk CRCs and the single zlib image stream must be valid. Scanline filters 0..4. '
+    f'It writes {VCF_PHOTO_PROPERTY_PREFIX} followed by the exact URI. Local only, '
+    'with no fetch, render or contact import. Reopen suppresses the PHOTO value. '
+)
+
+
+def _validate_vcf_photo(photo, checkpoint):
+    # Validate the static PNG payload without rendering or fetching it.
+    if (type(photo) is not str or len(photo) > VCF_PHOTO_MAX_URI
+            or not photo.startswith(VCF_PHOTO_URI_PREFIX) or not photo.isascii()):
+        _fail('invalid_photo')
+    payload = photo[len(VCF_PHOTO_URI_PREFIX):]
+    try:
+        decoded = base64.b64decode(payload, validate=True)
+    except (ValueError, binascii.Error):
+        _fail('invalid_photo')
+    if not decoded or len(decoded) > VCF_PHOTO_MAX_DECODED:
+        _fail('invalid_photo')
+    if base64.b64encode(decoded).decode('ascii') != payload:
+        _fail('invalid_photo')
+    if not decoded.startswith(VCF_PHOTO_SIGNATURE):
+        _fail('invalid_photo')
+    position = len(VCF_PHOTO_SIGNATURE)
+    dimensions = None
+    idat = []
+    saw_idat = False
+    idat_done = False
+    saw_iend = False
+    chunk_count = 0
+    while position < len(decoded):
+        _checkpoint(checkpoint)
+        if position + 12 > len(decoded):
+            _fail('invalid_photo')
+        length = struct.unpack('>I', decoded[position:position + 4])[0]
+        if position + 12 + length > len(decoded):
+            _fail('invalid_photo')
+        kind = decoded[position + 4:position + 8]
+        data = decoded[position + 8:position + 8 + length]
+        crc = struct.unpack('>I', decoded[position + 8 + length:position + 12 + length])[0]
+        if zlib.crc32(kind + data) & 0xffffffff != crc:
+            _fail('invalid_photo')
+        chunk_count += 1
+        if chunk_count > VCF_PHOTO_MAX_CHUNKS:
+            _fail('invalid_photo')
+        if dimensions is None and kind != b'IHDR':
+            _fail('invalid_photo')
+        if kind == b'IHDR':
+            if dimensions is not None or length != 13:
+                _fail('invalid_photo')
+            width, height, depth, colour, compression, filter_method, interlace = struct.unpack('>IIBBBBB', data)
+            if (not 1 <= width <= VCF_PHOTO_MAX_DIMENSION
+                    or not 1 <= height <= VCF_PHOTO_MAX_DIMENSION
+                    or width * height > VCF_PHOTO_MAX_PIXELS
+                    or depth not in (8, 16) or colour not in (0, 2, 4, 6)
+                    or compression != 0 or filter_method != 0 or interlace != 0):
+                _fail('invalid_photo')
+            dimensions = (width, height, depth, colour)
+        elif kind == b'IDAT':
+            if idat_done:
+                _fail('invalid_photo')
+            saw_idat = True
+            idat.append(data)
+        elif kind == b'IEND':
+            if length != 0 or position + 12 != len(decoded):
+                _fail('invalid_photo')
+            saw_iend = True
+        elif kind == b'tEXt':
+            keyword, separator, value = data.partition(b'\0')
+            if (not separator or not 1 <= len(keyword) <= 79
+                    or any(byte < 32 or 126 < byte < 161 for byte in keyword)
+                    or keyword.startswith(b' ') or keyword.endswith(b' ') or b'  ' in keyword
+                    or b'\0' in value):
+                _fail('invalid_photo')
+            if saw_idat:
+                idat_done = True
+        else:
+            _fail('invalid_photo')
+        position += 12 + length
+        if saw_iend:
+            break
+    if dimensions is None or not saw_idat or not saw_iend or position != len(decoded):
+        _fail('invalid_photo')
+    width, height, depth, colour = dimensions
+    channels = {0: 1, 2: 3, 4: 2, 6: 4}[colour]
+    stride = 1 + width * channels * (depth // 8)
+    expected = height * stride
+    inflater = zlib.decompressobj()
+    pending = b''.join(idat)
+    produced = 0
+    while not inflater.eof:
+        _checkpoint(checkpoint)
+        try:
+            scanlines = inflater.decompress(pending, min(65_536, expected - produced + 1))
+        except zlib.error:
+            _fail('invalid_photo')
+        pending = inflater.unconsumed_tail
+        if produced + len(scanlines) > expected or inflater.unused_data:
+            _fail('invalid_photo')
+        if any(value > 4 for value in scanlines[(-produced) % stride::stride]):
+            _fail('invalid_photo')
+        produced += len(scanlines)
+        if not inflater.eof and not scanlines and not pending:
+            _fail('invalid_photo')
+    if produced != expected or pending:
+        _fail('invalid_photo')
+
+
