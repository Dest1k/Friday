+    def test_noclobber_does_not_leak_into_remote_session_snapshot(self, tmp_path):
+        from shlex import quote
+        from tools.environments.base_session_env import _wrap_command_script
+
+        snapshot = tmp_path / "env.sh"
+        snapshot.write_text('export R05_TEST_SESSION=retained\n')
+        refreshes = []
+
+        def run_session(command, timeout=None, stdin_data=None):
+            before = snapshot.read_bytes()
+            script = _wrap_command_script(
+                command, quoted_cwd=quote(str(tmp_path)), quoted_snap=quote(str(snapshot)),
+                snap_tmp_template=quote(str(snapshot) + ".XXXXXX"), passthrough_names=(),
+                snapshot_ready=True, cwd_marker="fixture", emit_cwd_marker=False,
+            )
+            result = subprocess.run(["bash", "-c", script], input=stdin_data, capture_output=True,
+                                    text=True, timeout=timeout, check=False)
+            refreshes.append(snapshot.read_bytes() != before)
+            return {"output": result.stdout, "returncode": result.returncode}
+
+        env = MagicMock()
+        env.execute.side_effect = run_session
+        target = tmp_path / "remote" / "first.txt"
+        assert _write_to_sandbox("original", str(target), env)
+        assert refreshes[0] and b"R05_TEST_SESSION=" in snapshot.read_bytes()
+        assert not _write_to_sandbox("later", str(target), env)
+        assert target.read_text(encoding="utf-8") == "original"
+
