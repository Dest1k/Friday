+            raise ValueError('invalid recall page bounds')
+        sql = """WITH
+            first_ids AS (SELECT id FROM messages WHERE session_id = ? AND active = 1 ORDER BY id LIMIT ?),
+            last_ids AS (SELECT id FROM messages WHERE session_id = ? AND active = 1 ORDER BY id DESC LIMIT ?),
+            selected_ids AS (SELECT id FROM first_ids UNION SELECT id FROM last_ids),
+            totals AS (SELECT COUNT(*) AS recall_count FROM messages WHERE session_id = ? AND active = 1)
+            SELECT m.*, totals.recall_count FROM messages m
+            JOIN selected_ids x ON x.id = m.id CROSS JOIN totals ORDER BY m.id"""
+        rows = self._read_all(sql, (session_id, head, session_id, tail, session_id))
