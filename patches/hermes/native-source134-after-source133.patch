+def _macro_numeric_span(raw, cell):
+    """Locate the selected XML text by parser byte offsets, never by tag regex."""
+    parser = expat.ParserCreate(namespace_separator='}')
+    names = [S[1:] + name for name in ('worksheet', 'sheetData', 'row', 'c')]
+    value_path = names + [S[1:] + 'v']
+    path = []
+    selected = False
+    starts = []
+    spans = []
+
+    def start(name, attrs):
+        nonlocal selected
+        path.append(name)
+        if path == names:
+            selected = attrs.get('r') == cell
+        if selected and path == value_path:
+            if attrs:
+                raise ScopeDenied()
+            starts.append(raw.index(b'>', parser.CurrentByteIndex) + 1)
+
+    def end(name):
+        nonlocal selected
+        if selected and path == value_path:
+            if len(starts) != 1:
+                raise ScopeDenied()
+            spans.append((starts[0], parser.CurrentByteIndex))
+        if path == names:
+            selected = False
+        path.pop()
+
+    parser.StartElementHandler = start
+    parser.EndElementHandler = end
+    parser.Parse(raw, True)
+    if len(spans) != 1 or spans[0][0] >= spans[0][1]:
+        raise ScopeDenied()
+    return spans[0]
+
