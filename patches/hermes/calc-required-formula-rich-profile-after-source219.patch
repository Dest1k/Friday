+def refuse(code):
+    raise ODSError('rich_' + code)
+
+
+def attrs(node, allowed):
+    if set(node.attrib) - set(allowed): refuse('attributes_unsupported')
+
+
+def children(node, allowed):
+    if any(n.tag not in set(allowed) for n in node): refuse('structure_unsupported')
+
+
+def one(node, tag, optional=False):
+    found = node.findall(tag)
+    if len(found) != 1:
+        if optional and not found: return None
+        refuse('ambiguous_structure')
+    return found[0]
+
+
+def boolean(value, default=False):
+    if value is None: return default
+    if value in ('1', 'true'): return True
+    if value in ('0', 'false'): return False
+    refuse('boolean_unsupported')
+
+
+def number(raw, low=0, high=1000000):
+    result = decimal(raw)
+    if not low <= result <= high: refuse('number_bounds')
+    return result
+
+
+def integer(raw, low=0, high=MAX_ROWS):
+    if not isinstance(raw, str) or not re.fullmatch(r'[0-9]{1,8}', raw): refuse('integer_unsupported')
+    result = int(raw)
+    if not low <= result <= high: refuse('integer_bounds')
+    return result
+
+
+def text(node, allowed=()):
+    if node is None: return ''
+    attrs(node,allowed)
+    if len(node) or len((node.text or '').encode()) > 4096: refuse('text_unsupported')
+    return node.text or ''
+
+
+def _sheet(raw):
+    if raw.startswith('$'): raw = raw[1:]
+    if raw.startswith("'"):
+        if not raw.endswith("'"): refuse('reference_unsupported')
+        raw = raw[1:-1].replace("''", "'")
+    if not raw or len(raw) > 31 or any(c in raw for c in '[]:*?/\\') or any(ord(c)<32 for c in raw):
+        refuse('reference_unsupported')
+    return raw
+
+
+def rect(raw, kind, current=None):
+    name = r"(?:'(?:[^']|'')+'|[A-Za-z_\u0080-\uffff][A-Za-z0-9_\u0080-\uffff .]*)"
+    cell = r'\$?[A-Z]{1,3}\$?[1-9][0-9]{0,6}'
+    if kind == 'xlsx':
+        match = re.fullmatch(r'(?:(%s)!)?(%s)(?::(?:(%s)!)?(%s))?' % (name,cell,name,cell), raw or '')
+    else:
+        match = re.fullmatch(r'(?:\$?(%s))?\.(%s)(?::(?:\$?(%s))?\.(%s))?' % (name,cell,name,cell), raw or '')
+    if not match: refuse('reference_unsupported')
+    sheet = _sheet(match[1]) if match[1] else current
+    end_sheet = _sheet(match[3]) if match[3] else sheet
+    if sheet is None or sheet != end_sheet: refuse('reference_sheet_unsupported')
+    r1,c1 = address(match[2].replace('$',''))
+    r2,c2 = address((match[4] or match[2]).replace('$',''))
+    if not (r1 <= r2 <= MAX_ROWS and c1 <= c2 <= MAX_COLS): refuse('reference_bounds')
+    return sheet,r1,c1,r2,c2
+
+
+def _cm_exact(raw):
+    match = re.fullmatch(r'(-?[0-9]+(?:\.[0-9]+)?)(cm|mm|in|pt)', raw or '')
+    if not match: refuse('length_unsupported')
+    value = Fraction(Decimal(match[1])) * {'cm':Fraction(1),'mm':Fraction(1,10),'in':Fraction(127,50),'pt':Fraction(127,3600)}[match[2]]
+    if not 0 <= value <= 1000: refuse('length_bounds')
+    return value.numerator,value.denominator
+
+
+def _cm(raw):
+    num,den=_cm_exact(raw)
+    return (Decimal(num)/Decimal(den)).quantize(Decimal('.001'), rounding=ROUND_HALF_UP)
+
+
+def _xwidth(raw):
+    # OOXML character widths use the known source font's 7-pixel max digit.
+    # The scalar source profile independently validates that default font.
+    width = number(raw, 1, 255)
+    pixels = (width * 7 + 5).to_integral_value(rounding=ROUND_HALF_UP)
+    return (pixels * Decimal('2.54') / 96).quantize(Decimal('.001'),rounding=ROUND_HALF_UP)
