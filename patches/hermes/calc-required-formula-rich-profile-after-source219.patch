+def fidelity_report(source,destination,*,source_kind='',target_kind=''):
+    source_kind=source_kind or getattr(source,'source_kind','');target_kind=target_kind or getattr(destination,'source_kind','')
+    native=(source_kind,target_kind)==('xlsx','ods') and getattr(destination,'native_calc_profile',False) is True
+    unassessed=_native_directed_projection(source,destination)[3] if native else ()
+    names=getattr(source,'sheet_names',())
+    def encoded(v):
+        if isinstance(v,Decimal):return str(v)
+        if isinstance(v,tuple):return [encoded(x) for x in v]
+        return v
+    dimensions=[]
+    for role,sig,kind in (('source',source,source_kind),('destination',destination,target_kind)):
+        order=getattr(sig,'sheet_names',()) or names
+        for item in getattr(sig,'native_geometry',()):
+            feature,scope,*payload=item
+            if scope not in order:refuse('dimension_scope_unsupported')
+            unit=('xlsx_character_width' if feature=='column_width' else 'EMU') if kind=='xlsx' else 'cm_rational'
+            dimensions.append({'side':role,'feature':feature,'sheet_index':order.index(scope)+1,'unit':unit,'data':encoded(tuple(payload))})
+        for feature,scope,payload in sig:
+            if feature!='print_setup':continue
+            if scope not in order:refuse('dimension_scope_unsupported')
+            dimensions.append({'side':role,'feature':'print_setup','sheet_index':order.index(scope)+1,'paper':encoded(payload[1]),'orientation':payload[0],'fit_height':payload[2],'fit_width':payload[3]})
+    return {'declared_losses':list(declared_losses(source,destination,source_kind=source_kind,target_kind=target_kind)),'unassessed':list(unassessed),'dimension_metadata':dimensions}
