+def _formula_namespace_bindings(raw):
+    """Validate original scoped formula QNames before lexical-only bindings die.
+
+    ElementTree preserves expanded element/attribute names but not prefixes used
+    inside formula attribute values. Preserve only bindings actually validated
+    at those attributes; a missing, foreign, or conflicting prefix is refused.
+    The real scalar parser still validates the complete formula dialect.
+    """
+    bindings={}; frames=[]; pending=[]; declarations=[]; required={}
+    for event,item in ET.iterparse(BytesIO(raw),events=('start-ns','start','end')):
+        if event=='start-ns':
+            pending.append(item); declarations.append(item)
+        elif event=='start':
+            frames.append(bindings); bindings=dict(bindings)
+            bindings.update(pending); pending=[]
+            for field in ('formula','condition'):
+                value=item.get(q(TB,field))
+                if value is None: continue
+                match=re.match(r'([A-Za-z_][A-Za-z0-9_.-]*):',value)
+                if not match or match[1]!='of' or bindings.get(match[1])!=OF:
+                    refuse('formula_namespace_unsupported')
+                required[match[1]]=OF
+        else:
+            bindings=frames.pop()
+    # A rewritten XML root cannot preserve conflicting lexical meanings for
+    # the same formula prefix. Refuse rather than silently hoist or repair it.
+    if any(prefix in required and uri!=required[prefix] for prefix,uri in declarations):
+        refuse('formula_namespace_shadow_conflict')
+    return required
+
