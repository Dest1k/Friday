+def declared_losses(source,destination=None,*,source_kind='',target_kind=''):
+    source_kind=source_kind or getattr(source,'source_kind','')
+    target_kind=target_kind or getattr(destination,'source_kind','')
+    losses=[]
+    if source_kind and target_kind and source_kind!=target_kind:
+        if any(row[0]=='table' for row in source): losses.append('vendor_builtin_table_style_identifier')
+        native=destination is not None and getattr(destination,'native_calc_profile',False) is True and (source_kind,target_kind)==('xlsx','ods')
+        if not native and any(row[0] in ('chart','column_width') for row in source): losses.append('physical_geometry_quantized_0.001cm')
+        if destination is not None and _missing_first_row_views(source,destination,source_kind,target_kind):
+            losses.append('frozen_first_row_view_not_serialized_xlsx_to_ods')
+        if native:
+            _,_,extra,_=_native_directed_projection(source,destination)
+            losses.extend(extra)
+    return tuple(losses)
+
