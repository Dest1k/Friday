+def _rich_digest_atom(value):
+    """Versioned typed atoms; Decimal scale never changes rich identity."""
+    budget = [0]
+    def encode(item, depth=0):
+        budget[0] += 1
+        if depth > 24 or budget[0] > 20000:
+            refuse('conversion_rich_digest_unsupported')
+        if item is None:
+            return ('null',)
+        if type(item) is bool:
+            return ('bool', item)
+        if type(item) is int:
+            # Exact finite ODS lengths may carry rational denominators larger
+            # than a machine integer. Bound work, not the host integer width.
+            if item.bit_length() > 4096:
+                refuse('conversion_rich_digest_unsupported')
+            return ('int', item)
+        if type(item) is str:
+            if len(item) > 100000:
+                refuse('conversion_rich_digest_unsupported')
+            return ('str', item)
+        if isinstance(item, Decimal):
+            if not item.is_finite():
+                refuse('conversion_rich_digest_nonfinite')
+            sign, digits, exponent = item.as_tuple()
+            if len(digits) > 4096:
+                refuse('conversion_rich_digest_unsupported')
+            if not any(digits):
+                return ('decimal', 0, '0', 0)
+            while digits[-1] == 0:
+                digits = digits[:-1]
+                exponent += 1
+            return ('decimal', sign, ''.join(str(digit) for digit in digits), exponent)
+        if isinstance(item, tuple):
+            return ('tuple', tuple(encode(child, depth + 1) for child in item))
+        refuse('conversion_rich_digest_unsupported')
+    return ('rich-v1', encode(value))
