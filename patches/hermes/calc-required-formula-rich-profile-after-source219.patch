+def _o_filter(node, area):
+    attrs(node,())
+    conditions=[]
+    if len(node)==1 and node[0].tag in (q(TB,'filter-or'),q(TB,'filter-and')):
+        parent=node[0]; attrs(parent,())
+        if parent.tag==q(TB,'filter-and') and len(parent)!=1:refuse('filter_unsupported')
+    else: parent=node
+    children(parent,(q(TB,'filter-condition'),))
+    grouped={}
+    for cond in parent:
+        attrs(cond,tuple(q(TB,n) for n in ('field-number','case-sensitive','data-type','value','operator')))
+        if cond.get(q(TB,'operator'))!='=' or cond.get(q(TB,'data-type'),'text')!='text' or boolean(cond.get(q(TB,'case-sensitive'))): refuse('filter_unsupported')
+        field=integer(cond.get(q(TB,'field-number')),0,area[4]-area[2])
+        value=cond.get(q(TB,'value'))
+        if value is None or len(value.encode())>4096: refuse('filter_unsupported')
+        if len(cond):
+            children(cond,(q(TB,'filter-set-item'),));values=[]
+            for item in cond:
+                attrs(item,(q(TB,'value'),));v=item.get(q(TB,'value'))
+                if len(item) or v is None or len(v.encode())>4096:refuse('filter_unsupported')
+                values.append(v)
+            if not values or value!=values[0]:refuse('filter_unsupported')
+        else:values=[value]
+        grouped.setdefault(field,[]).extend(values)
+    if len(grouped)>1 or any(len(v)!=len(set(v)) for v in grouped.values()): refuse('filter_unsupported')
+    for field,values in grouped.items(): conditions.append((field,tuple(sorted(values)),False))
+    return tuple(sorted(conditions))
