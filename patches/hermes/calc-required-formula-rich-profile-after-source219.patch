+def _check_area(area,names,scope=None):
+    if (not isinstance(area,tuple) or len(area)!=5 or area[0] not in names
+            or any(type(v) is not int for v in area[1:])
+            or not (1<=area[1]<=area[3]<=MAX_ROWS and 1<=area[2]<=area[4]<=MAX_COLS)
+            or (scope is not None and area[0]!=scope)):
+        refuse('reference_sheet_or_bounds')
+    return area
