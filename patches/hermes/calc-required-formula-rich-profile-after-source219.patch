+def compare_rich(source,destination,*,source_kind='',target_kind=''):
+    source_kind=source_kind or getattr(source,'source_kind','')
+    target_kind=target_kind or getattr(destination,'source_kind','')
+    missing=_missing_first_row_views(source,destination,source_kind,target_kind)
+    if (source_kind,target_kind)==('xlsx','ods') and getattr(destination,'native_calc_profile',False) is True:
+        left,right,_,_=_native_directed_projection(source,destination)
+    else:left,right=tuple(row for row in source if row not in missing),tuple(destination)
+    if left!=right: refuse('semantic_mismatch')
+    if source_kind==target_kind:
+        if getattr(source,'vendor_styles',())!=getattr(destination,'vendor_styles',()): refuse('vendor_style_mismatch')
+        if getattr(source,'native_geometry',())!=getattr(destination,'native_geometry',()): refuse('native_geometry_mismatch')
+    return True
+
+
+def _missing_first_row_views(source,destination,source_kind,target_kind):
+    # A directed declared loss for the observed first-row freeze only. Other
+    # freeze shapes, changed split positions, reverse and same-format remain
+    # exact. This never removes any destination structure from comparison.
+    if (source_kind,target_kind)!=('xlsx','ods') or getattr(destination,'native_calc_profile',False) is not True:return ()
+    return tuple(row for row in source if row[0]=='freeze' and row[2]==(1,0)
+                 and not any(d[0]=='freeze' and d[1]==row[1] for d in destination))
+
+
+def _native_directed_projection(source,destination):
+    left=[];right=[];losses=[];unassessed=[]
+    missing=_missing_first_row_views(source,destination,'xlsx','ods')
+    sw=[r for r in source if r[0]=='column_width'];dw=[r for r in destination if r[0]=='column_width']
+    def coverage(rows):
+        points=[]
+        for _,scope,(first,last,width) in rows:
+            if not 1<=first<=last<=MAX_COLS:refuse('column_unsupported')
+            points.extend((scope,c) for c in range(first,last+1))
+        if len(points)!=len(set(points)):refuse('column_unsupported')
+        return set(points)
+    if coverage(sw)!=coverage(dw):refuse('column_coverage_mismatch')
+    if sw:unassessed.append('column_width_physical_mapping_unassessed')
+    for row in source:
+        feature,scope,payload=row
+        if row in missing or feature=='column_width':continue
+        if feature=='table' and payload[-1] is True:
+            altered=(feature,scope,payload[:-1]+(False,))
+            if altered in destination:
+                losses.append('table_header_background_row_banding_not_serialized_xlsx_to_ods');left.append(altered);continue
+        if feature=='chart':
+            left.append((feature,scope,payload[:-1]));unassessed.append('chart_physical_size_unassessed');continue
+        if feature=='print_setup':
+            left.append((feature,scope,(payload[0],payload[2],payload[3])));unassessed.append('physical_pagination_unassessed');continue
+        left.append(row)
+    for row in destination:
+        feature,scope,payload=row
+        if feature=='native_hidden_mode':
+            if (payload[1] not in ('filter','collapse') or ('hidden_row',scope,payload[0]) not in source):refuse('hidden_row_semantics_mismatch')
+            if payload[1]=='filter':unassessed.append('hidden_row_provenance_and_filter_clear_behavior_unassessed')
+            continue
+        if feature=='column_width':continue
+        if feature=='chart':right.append((feature,scope,payload[:-1]));continue
+        if feature=='print_setup':
+            source_print=[r[2] for r in source if r[:2]==row[:2]]
+            if len(source_print)!=1 or source_print[0][1]!='A4':refuse('print_layout_unsupported')
+            if payload[1]!='A4':
+                if not isinstance(payload[1],tuple) or len(payload[1])!=2 or payload[1][0]!='physical_cm':refuse('print_layout_unsupported')
+                dims=payload[1][1];expected=(Decimal('29.700'),Decimal('21.000')) if source_print[0][0]=='landscape' else (Decimal('21.000'),Decimal('29.700'))
+                if (not isinstance(dims,tuple) or len(dims)!=2 or any(not isinstance(v,Decimal) or not v.is_finite() for v in dims)
+                        or any(abs(actual-want)>Decimal('.001') for actual,want in zip(dims,expected))):refuse('print_layout_unsupported')
+                losses.append('a4_page_dimension_serialization_discrepancy_xlsx_to_ods')
+            right.append((feature,scope,(payload[0],payload[2],payload[3])));continue
+        right.append(row)
+    return tuple(sorted(left,key=repr)),tuple(sorted(right,key=repr)),tuple(dict.fromkeys(losses)),tuple(dict.fromkeys(unassessed))
+
