+def validate_references(signature,inventory):
+    """Verify chart/table/merge bindings against actual scalar cells and values."""
+    if not signature: return True
+    from tools.scoped_spreadsheet_conversion import evaluate
+    cells={(name,r,c):cell for name,rows in inventory.sheets for r,c,cell in rows}
+    names={name for name,_ in inventory.sheets}
+    values=evaluate(inventory)
+    def linked(area,kind='any'):
+        name,r1,c1,r2,c2=area
+        if name not in names or (r2-r1+1)*(c2-c1+1)>MAX_POINTS: refuse('chart_reference_bounds')
+        result=[]
+        for r in range(r1,r2+1):
+            for c in range(c1,c2+1):
+                key=name,r,c; cell=cells.get(key)
+                if cell is None or cell.kind not in ('number','string') or kind!='any' and cell.kind!=kind: refuse('chart_reference_cell_unsupported')
+                result.append(values[key] if cell.kind=='number' else cell.value)
+        return result
+    for feature,scope,payload in signature:
+        if feature=='chart':
+            kind,title,ytitle,legend,visible,category,series,anchor,size=payload
+            cats=linked(category)
+            if len(cats)>MAX_POINTS: refuse('chart_points_limit')
+            for label,values_ref in series:
+                if len(linked(label,'string'))!=1 or len(linked(values_ref,'number'))!=len(cats): refuse('chart_series_dimensions')
+        elif feature=='table':
+            name,area,headings,stripe=payload
+            name,r,c,_,last=area
+            actual=tuple(cells.get((name,r,col)) for col in range(c,last+1))
+            if any(cell is None or cell.kind!='string' or cell.formula is not None for cell in actual) or tuple(cell.value for cell in actual)!=headings: refuse('table_header_mismatch')
+        elif feature=='merge':
+            name,r1,c1,r2,c2=payload
+            if any((name,r,c) in cells for r in range(r1,r2+1) for c in range(c1,c2+1) if (r,c)!=(r1,c1)): refuse('merge_hides_value')
+    for area,kind,cache in getattr(signature,'cache_checks',()):
+        actual=linked(area,kind)
+        try:
+            if any((decimal(raw)!=value if isinstance(value,Decimal) else raw!=value) for raw,value in zip(cache,actual)) or len(cache)!=len(actual): refuse('chart_cache_mismatch')
+        except ODSError: refuse('chart_cache_mismatch')
+    return True
