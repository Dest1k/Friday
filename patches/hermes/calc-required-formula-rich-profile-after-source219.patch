+def _validate_relations(signature,names):
+    for feature,scope,payload in signature:
+        if scope and scope not in names: refuse('sheet_missing')
+        if feature=='name':
+            _check_area(payload[1],names,scope or None)
+        elif feature in ('print_area','filter_database','merge'):
+            _check_area(payload,names,scope)
+        elif feature in ('filter','validation'):
+            _check_area(payload[0],names,scope)
+        elif feature=='table':
+            _check_area(payload[1],names,scope)
+        elif feature=='chart':
+            _check_area(payload[5],names)
+            for label,values in payload[6]:
+                _check_area(label,names); _check_area(values,names)
+        if feature=='filter_database':
+            filters=[v[2][0] for v in signature if v[0]=='filter' and v[1]==scope]
+            if payload not in filters: refuse('filter_database_unbound')
+    if len(set(signature))!=len(signature): refuse('duplicate_feature')
