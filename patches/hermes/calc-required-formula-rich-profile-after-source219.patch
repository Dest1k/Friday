+def _ods_freeze(book, records):
+    """The standard Calc per-table view map is the only admitted freeze source."""
+    root=book.xml.get('settings.xml')
+    if root is None: return False
+    changed=False
+    for tablemap in root.iter(q(CFG,'config-item-map-named')):
+        if tablemap.get(q(CFG,'name'))!='Tables': continue
+        for entry in tablemap:
+            if entry.tag!=q(CFG,'config-item-map-entry'): refuse('settings_unsupported')
+            scope=entry.get(q(CFG,'name'))
+            items={n.get(q(CFG,'name')):n for n in entry if n.tag==q(CFG,'config-item')}
+            if len(items)!=len(entry): refuse('settings_unsupported')
+            modes=[]; positions=[]
+            for axis in ('Horizontal','Vertical'):
+                mode=items.get(axis+'SplitMode'); pos=items.get(axis+'SplitPosition')
+                if mode is None:
+                    modes.append(0); positions.append(0); continue
+                attrs(mode,(q(CFG,'name'),q(CFG,'type')))
+                if mode.get(q(CFG,'type'))!='short' or len(mode): refuse('pane_unsupported')
+                m=integer(text(mode,(q(CFG,'name'),q(CFG,'type'))),0,2)
+                if m not in (0,2): refuse('pane_unsupported')
+                p=integer(text(pos,(q(CFG,'name'),q(CFG,'type'))),0,MAX_ROWS) if pos is not None else 0
+                if bool(m)!=bool(p): refuse('pane_unsupported')
+                modes.append(m); positions.append(p)
+            if any(modes):
+                cols,rows=positions
+                if cols>MAX_COLS: refuse('pane_unsupported')
+                records.append(('freeze',scope,(rows,cols)))
+                for axis in ('Horizontal','Vertical'):
+                    for suffix in ('SplitMode','SplitPosition'):
+                        if axis+suffix in items: items[axis+suffix].text='0'
+                changed=True
+    return changed
