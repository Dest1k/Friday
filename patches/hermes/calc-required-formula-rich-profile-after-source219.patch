+        if field.tag != q(S,'filterColumn'): refuse('filter_unsupported')
+        attrs(field, ('colId','hiddenButton','showButton'))
+        if boolean(field.get('hiddenButton')) or not boolean(field.get('showButton'),True): refuse('filter_buttons_unsupported')
+        index=integer(field.get('colId'),0,MAX_COLS-1)
+        if index>area[4]-area[2]: refuse('filter_bounds')
+        values=one(field,q(S,'filters'))
+        attrs(values,('blank',))
+        children(values,(q(S,'filter'),))
+        items=[]
+        for item in values:
+            attrs(item,('val',))
+            if len(item) or item.get('val') is None: refuse('filter_unsupported')
+            items.append(item.get('val'))
+        if not items or len(items)>128 or len(set(items))!=len(items): refuse('filter_unsupported')
+        predicates.append((index,tuple(sorted(items)),boolean(values.get('blank'))))
+    if len({p[0] for p in predicates})!=len(predicates): refuse('filter_unsupported')
+    return area,tuple(sorted(predicates))
