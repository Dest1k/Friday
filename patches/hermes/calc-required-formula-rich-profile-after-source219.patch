+def _rewrite(data, roots, removed=(), lexical_bindings=None):
+    out = BytesIO()
+    with zipfile.ZipFile(BytesIO(data)) as source, zipfile.ZipFile(out,'w') as dest:
+        dest.comment = source.comment
+        for info in source.infolist():
+            if info.filename in removed: continue
+            if info.filename in roots:
+                root=roots[info.filename]
+                for prefix,uri in (lexical_bindings or {}).get(info.filename,{}).items():
+                    root.set('xmlns:'+prefix,uri)
+                payload=ET.tostring(root,encoding='utf-8',xml_declaration=True)
+            else:
+                payload=source.read(info)
+            dest.writestr(info,payload)
+    result=out.getvalue()
+    if len(result)>1000000: refuse('output_limit')
+    return result
