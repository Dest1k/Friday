+def _ods_headers(book,scope,area):
+    sheet=next(s for s in book.sheets if s.get(q(TB,'name'))==scope)
+    cells={}
+    for r,c,h,w,cell,row in book.cells(sheet):
+        if r<=area[1]<r+h:
+            value=book.value(cell)
+            if value.get('type')!='string' or value.get('formula'): continue
+            for col in range(c,c+w): cells[col]=value.get('value')
