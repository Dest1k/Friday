+def _include_review_table_locations(package, review, view, checkpoint):
+    if package.format != 'docx' or not review.extraction_metadata['main_text_projections_complete']:
+        return view
+    parents = {child: parent for parent in package.body.iter() for child in parent}
+    locations = _body_table_locations(package.body, parents, checkpoint)
+    if not locations:
+        return view
+    paragraph_locations = {
+        number: locations[parent]
+        for number, paragraph in enumerate(package.body.iter(_q(W, 'p')), 1)
+        if (parent := parents.get(paragraph)) in locations
+    }
+    rows = review.split('\n')[1:]
+    located_rows = {}
+    for index, row in enumerate(rows):
+        label, _, raw = row.partition(' ')
+        if label in ('[FINAL', '[ORIGINAL'):
+            record = json.loads(raw[:-1])
+            location = paragraph_locations.get(record['number'])
+            if location is not None:
+                record['table_context'] = location
+                located_rows[index] = label + ' ' + _encoded(record) + ']'
+    return _include_body_table_locations(view, rows, located_rows)
