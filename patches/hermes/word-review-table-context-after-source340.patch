+        <w:document xmlns:w="{_NS_W}"><w:body>
+          <w:p><w:r><w:t>Body</w:t></w:r></w:p>
+          <w:tbl><w:tr><w:tc><w:p>
+            <w:del w:id="1"><w:r><w:delText>Previous</w:delText></w:r></w:del>
+            <w:ins w:id="2"><w:r><w:t>Current</w:t></w:r></w:ins>
+          </w:p></w:tc></w:tr></w:tbl>
+        </w:body></w:document>
+    """.strip().encode()
+    reviewed = _rewrite(document, {"word/document.xml": document_xml})
